<http://vocab.nerc.ac.uk/collection/B02/current/M000006/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:B02::M000006";
        dc:date                "2014-03-11 14:05:46.0";
        dc:identifier          "SDN:B02::M000006";
        pav:authoredOn         "2014-03-11 14:05:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/B02/current/M000006/1/>;
        pav:version            "1";
