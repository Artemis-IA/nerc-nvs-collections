        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The smallest detectable incremental change of an input parameter that can be detected in the output signal of a system or device."@en;
        skos:notation          "SDN:W04::CAPB0007";
        skos:note              "accepted"@en;
        skos:prefLabel         "Resolution"@en .

<http://vocab.nerc.ac.uk/collection/W04/current/CAPB0009/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:W04::CAPB0009";
