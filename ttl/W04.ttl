<http://vocab.nerc.ac.uk/collection/W04/current/CAPB0004/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:W04::CAPB0004";
        dc:date                "2016-07-20 14:59:59.0";
        dc:identifier          "SDN:W04::CAPB0004";
        pav:authoredOn         "2016-07-20 14:59:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/W04/current/CAPB0004/1/>;
        pav:version            "1";
