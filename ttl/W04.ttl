<http://vocab.nerc.ac.uk/collection/W04/current/CAPB0001/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:W04::CAPB0001";
        dc:date                "2016-07-20 14:59:52.0";
        dc:identifier          "SDN:W04::CAPB0001";
        pav:authoredOn         "2016-07-20 14:59:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/W04/current/CAPB0001/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/W01/current/007/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The maximum difference that exists between an actual value and an indicated value output from a sensor. The actual value is usually measured by a reference standard."@en;
        skos:notation          "SDN:W04::CAPB0001";
        skos:note              "accepted"@en;
        skos:prefLabel         "Accuracy"@en .

<http://vocab.nerc.ac.uk/collection/W04/current/CAPB0007/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:W04::CAPB0007";
        dc:date                "2016-07-20 15:00:02.0";
        dc:identifier          "SDN:W04::CAPB0007";
        pav:authoredOn         "2016-07-20 15:00:02.0";
