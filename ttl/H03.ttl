<http://vocab.nerc.ac.uk/collection/H03/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "A European project consortium aimed at the creation of data products using chemical data amassed through SeaDataNet. The governance is loosely defined as the scientific expertise within the consortium with no formal processes defined.";
        dc:alternative          "Micro and mesolitter size classes";
        dc:creator              "EMODnet Chemistry Lot";
        dc:date                 "2026-07-07 03:00:00.0";
        dc:description          "Controlled vocabulary defining the terms that may be used for micro- (<5 millimetres) and meso- (5-25 millimetres) litter particle size classes in the EMODnet Chemistry data reporting system. It includes classes defined by the Guidance on the monitoring of marine litter in Europeans Seas (https://dx.doi.org/10.2760/59137).";
        dc:license              <https://creativecommons.org/licenses/by/4.0/>;
        dc:publisher            "Natural Environment Research Council";
        dc:title                "EMODnet micro- and meso-litter size classes";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "EMODnet Chemistry Lot";
        owl:versionInfo         "12";
        skos:altLabel           "Micro and mesolitter size classes";
