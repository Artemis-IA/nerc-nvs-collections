        skos:note              "accepted"@en;
        skos:prefLabel         "100% of profile good"@en .

<http://vocab.nerc.ac.uk/collection/RP2/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the Argo data system, published and maintained by the Argo Data Management Team (ADMT) and hosted on the NERC Vocabulary Server.";
        rdfs:seeAlso            <https://github.com/OneArgo/ArgoVocabs>;
        dc:alternative          "PROF_QC_FLAG";
        dc:creator              "Argo Data Management Team";
        dc:date                 "2025-08-29 03:00:01.0";
        dc:description          "Quality control flag scale for whole profiles. Argo netCDF variables PROFILE_{param}_QC are populated by RP2 altLabel, with {param} consisting of R03 altLabels. Associated FillValue is an empty space in Argo NetCDF files. This case occurs when no QC is performed or no usable flag values are present.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Argo profile quality control flags";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Argo Data Management Team";
        owl:versionInfo         "1";
        skos:altLabel           "PROF_QC_FLAG";
        skos:member             <http://vocab.nerc.ac.uk/collection/RP2/current/C/> , <http://vocab.nerc.ac.uk/collection/RP2/current/E/> , <http://vocab.nerc.ac.uk/collection/RP2/current/D/> , <http://vocab.nerc.ac.uk/collection/RP2/current/F/> , <http://vocab.nerc.ac.uk/collection/RP2/current/N/> , <http://vocab.nerc.ac.uk/collection/RP2/current/A/> , <http://vocab.nerc.ac.uk/collection/RP2/current/B/>;
        skos:prefLabel          "Argo profile quality control flags" .
