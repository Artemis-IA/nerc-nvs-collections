<http://vocab.nerc.ac.uk/collection/B12/current/B1200001/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:B12::B1200001";
        dc:date                "2018-01-15 18:30:58.0";
        dc:identifier          "SDN:B12::B1200001";
        pav:authoredOn         "2018-01-15 18:30:58.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/B12/current/B1200001/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "LFM";
        skos:definition        "A BODC variable attribute commonly known as LFM (Logical Format element). It combines the number of places before (BEF) and after (AFT) the decimal point into a single numerical attribute as follows: LFM = 100*BEF + AFT. Space for a leading sign must be met by BEF."@en;
        skos:notation          "SDN:B12::B1200001";
        skos:note              "accepted"@en;
        skos:prefLabel         "Variable output format"@en .

<http://vocab.nerc.ac.uk/collection/B12/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used within the data centre";
        dc:alternative          "BODC measurement numeric attributes";
        dc:creator              "British Oceanographic Data Centre";
        dc:date                 "2018-01-16 02:00:02.0";
        dc:description          "Terms used by BODC to define measurement attributes described by numbers associated with data held in its repositories.";
        dc:license              <https://creativecommons.org/licenses/by/4.0/>;
        dc:publisher            "Natural Environment Research Council";
        dc:title                "BODC measurement numeric attribute types";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
