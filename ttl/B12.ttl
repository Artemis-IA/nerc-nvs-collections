        owl:versionInfo         "1";
        skos:altLabel           "BODC measurement numeric attributes";
        skos:member             <http://vocab.nerc.ac.uk/collection/B12/current/B1200001/>;
        skos:prefLabel          "BODC measurement numeric attribute types" .
