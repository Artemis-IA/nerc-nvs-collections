        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0112/>;
        skos:definition        "The range of values between +/- 1.96 standard deviations of the sampling distribution of means."@en , "Intervalle de valeurs ayant 95% de chance de contenir la vraie valeur du paramètre estimé. Intervalle centré autour de la moyenne et dont les extrémités correspondent à la moyenne +/- 1,96 * l'écart type."@fr;
        skos:notation          "SDN:S07::S0700001";
        skos:note              "accepted"@en;
        skos:prefLabel         "intervalle de confiance à 95%"@fr , "95 per cent confidence interval"@en .

