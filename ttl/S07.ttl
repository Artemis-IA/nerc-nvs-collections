<http://vocab.nerc.ac.uk/collection/S07/current/S0700027/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S07::S0700027";
        dc:date                "2018-07-05 14:59:19.0";
        dc:identifier          "SDN:S07::S0700027";
        pav:authoredOn         "2018-07-05 14:59:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S07/current/S0700027/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "avg_max";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0112/>;
        skos:definition        "A value representing the average maximum for a time interval provided elsewhere in the metadata. For example the average of the maximum values recorded on the same Day Of Year over a decade. The method for calculating means varies depending on the type of observations being made."@en;
        skos:notation          "SDN:S07::S0700027";
        skos:note              "accepted"@en;
        skos:prefLabel         "mean maximum"@en .

<http://vocab.nerc.ac.uk/collection/S07/current/S0700001/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S07::S0700001";
