<http://vocab.nerc.ac.uk/collection/OD1/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the ODATIS Ocean Data and Services Cluster of the French Data Terra Research Infrastructure and hosted on the NVS.";
        dc:alternative          "ODATIS APG and EV";
        dc:creator              "ODATIS vocabulary governance";
        dc:date                 "2026-02-03 02:00:01.0";
        dc:description          "Collection of terms used within the French Ocean Data and Services Cluster ODATIS for data discovery and product or dataset aggregation. Whenever applicable, Essential Variable terms are linked to the authoritative source of Essential Climate Ocean and Biodiversity Variable definitions maintained by the Global Observing System for Climate (GCOS), the Global Ocean Observing System (GOOS) and the Group on Earth Observations Biodiversity Observation Network (GEO BON).";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "ODATIS aggregation parameters and Essential Variable names";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "ODATIS vocabulary governance";
        owl:versionInfo         "9";
        skos:altLabel           "ODATIS APG and EV";
