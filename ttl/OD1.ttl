        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P03/current/D005/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P08/current/DS03/>;
        skos:definition        "Non displonible"@fr , "Scientific field of study pertaining to sound emission and propagation in the marine environment. This topic includes the measurement of sound characteristics and the information they provide in the fields of telluric and hydroclimatic risk, biodiversity inventory and evolution, and anthropic impact. It includes also acoustic backscatter in the water column."@en;
        skos:notation          "SDN:OD1::ACOUST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ocean Acoustics"@en , "Acoustique de l'océan"@fr .

