<http://vocab.nerc.ac.uk/collection/A02/current/Eelgrass/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Eelgrass";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Eelgrass";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Eelgrass/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A03/current/Flora/>;
        skos:definition        "Eelgrass is a common name for Zostera - a small genus of widely distributed seagrasses. Zostera is found on sandy substrates or in estuaries submerged or partially floating. Most Zostera are perennial. They have long, bright green, ribbon-like leaves, about 1 cm wide."@en;
        skos:definition        "La zostère marine est un nom commun pour Zostera - un petit genre d'herbiers largement répandus. Zostera se rencontre sur des substrats sableux ou dans les estuaires, submergée ou partiellement flottante. La plupart des Zostera sont vivaces. Elles ont de longues feuilles vert vif en ruban, d'environ 1 cm de large."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::Eelgrass";
        skos:note              "accepted"@en;
        skos:prefLabel         "Eelgrass"@en ;
        skos:prefLabel         "Zostère marine"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/RockyShore/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::RockyShore";
