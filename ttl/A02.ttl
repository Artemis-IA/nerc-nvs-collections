        skos:definition        "Ocean Floor Geology studies the composition, structure, physical properties, history, and the processes that shape the ocean floor"@en;
        skos:definition        "La géologie du plancher océanique étudie la composition, la structure, les propriétés physiques, l'histoire et les processus qui façonnent le plancher océanique"@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A04/current/Bedrock/>;
        skos:notation          "SDN:A02::OceanFloorGeology";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ocean Floor Geology"@en ;
        skos:prefLabel         "Géologie du plancher océanique"@fr .

