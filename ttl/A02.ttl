        skos:definition        "A Geologic Fault is a planar rock fracture which shows evidence of relative movement"@en;
        skos:definition        "Une faille géologique est une fracture rocheuse plane présentant des traces de mouvement relatif"@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
