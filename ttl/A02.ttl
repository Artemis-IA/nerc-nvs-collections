<http://vocab.nerc.ac.uk/collection/A02/current/Erosion/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Erosion";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Erosion";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Erosion/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A04/current/CoastalErosion/> , <http://vocab.nerc.ac.uk/collection/A03/current/Natural/> , <http://vocab.nerc.ac.uk/collection/A01/current/Shoreline_Erosion_Flooding_and_Submergence/> , <http://vocab.nerc.ac.uk/collection/A01/current/Natural_Processes/> , <http://vocab.nerc.ac.uk/collection/A01/current/Sediment_Budget/>;
        skos:definition        "Erosion is the carrying away or displacement of solids (sediment, soil, rock and other particles) usually by the agents of currents such as, wind, water, or ice by downward or down-slope movement in response to gravity. Erosion is an intrinsic natural process but in many places it is increased by human land use. Poor land use practices include deforestation, overgrazing, unmanaged construction activity and other activities that involve removal of vegetation."@en;
        skos:definition        "L'érosion est l'enlèvement ou le déplacement de solides (sédiments, sol, roches et autres particules), généralement par les agents comme le vent, l'eau ou la glace, par mouvement descendant ou en descente de pente sous l'effet de la gravité. L'érosion est un processus naturel intrinsèque mais, dans de nombreux endroits, elle est amplifiée par l'usage humain des sols. Les mauvaises pratiques d'usage des sols incluent la déforestation, le surpâturage, les activités de construction non maîtrisées et autres activités impliquant la suppression de la végétation."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A04/current/CoastalErosion/> , <http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Erosion/>;
        skos:notation          "SDN:A02::Erosion";
        skos:note              "accepted"@en;
        skos:prefLabel         "Erosion"@en ;
        skos:prefLabel         "Érosion"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/Reservations/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Reservations";
