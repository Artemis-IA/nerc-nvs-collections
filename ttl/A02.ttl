        skos:definition        "Fishing is the activity of hunting for fish by hooking (e.g. using trolls or longlines), trapping (e.g. using pots), or gathering (e.g. using trawls or seines)."@en;
        skos:definition        "La pêche est l'activité de chasse au poisson par hameçonnage (ex. trolling ou palangre), piégeage (ex. casiers) ou récolte (ex. chaluts ou sennes)."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
