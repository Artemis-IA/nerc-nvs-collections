        skos:prefLabel         "Bluff"@en ;
        skos:prefLabel         "Falaise"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/Dune/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Dune";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Dune";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Dune/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A04/current/NaturalCoastalFeatures/> , <http://vocab.nerc.ac.uk/collection/A03/current/PublicTrustResources/>;
        skos:definition        "A dune is a hill of sand built by aeolian processes. Coastal areas often have one or more sets of dunes running parallel to the shoreline directly inland from the beach. In most cases the dunes are important in protecting the land against potential ravages by storm waves from the sea."@en;
        skos:definition        "Une dune est une colline de sable construite par des processus éoliens. Les zones côtières ont souvent un ou plusieurs ensembles de dunes parallèles au rivage, directement à l'intérieur des terres depuis la plage. Dans la plupart des cas, les dunes sont importantes pour protéger la terre contre les ravages potentiels des vagues de tempête venues de la mer."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::Dune";
        skos:note              "accepted"@en;
        skos:prefLabel         "Dune"@en ;
        skos:prefLabel         "Dune"@fr .

