<http://vocab.nerc.ac.uk/collection/A02/current/Zoning/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Zoning";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Zoning";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Zoning/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Legislation_and_Policy/> , <http://vocab.nerc.ac.uk/collection/A03/current/ComprehensivePlans/>;
        skos:definition        "Zoning is a term used in urban planning for a system of land-use regulation. The word is derived from the practice of designating permitted uses of land based on mapped zones which separate one set of (potentially conflicting) land uses from another."@en;
        skos:definition        "Le zonage est un terme d'urbanisme désignant un système de réglementation de l'usage des sols. Le mot vient de la pratique consistant à désigner les usages permis des sols en fonction de zones cartographiées qui séparent un ensemble d'usages des sols (potentiellement conflictuels) d'un autre."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::Zoning";
        skos:note              "accepted"@en;
        skos:prefLabel         "Zoning"@en ;
        skos:prefLabel         "Zonage"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/RelativeErosionRiskZones/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::RelativeErosionRiskZones";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::RelativeErosionRiskZones";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/RelativeErosionRiskZones/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A03/current/LittoralCellManagementPlans/> , <http://vocab.nerc.ac.uk/collection/A04/current/ErosionRisk/>;
        skos:definition        "These erosion risk zone mapping focuses on identifying minimum and maximum potential erosion distances for bluffs and dune backed shorelines. For both bluff and dune backed beaches, four zones are defined, an active hazard zone characterized by existing, active erosion processes, and three zones of potential future erosion, high, moderate, and low risk zones that respectively depict decreasing risks of becoming active in the future."@en;
        skos:definition        "Cette cartographie des zones de risque d'érosion se concentre sur l'identification des distances d'érosion potentielles minimales et maximales pour les falaises et les rivages adossés aux dunes. Pour les plages adossées aux falaises comme aux dunes, quatre zones sont définies : une zone de danger active caractérisée par des processus d'érosion existants et actifs, et trois zones d'érosion future potentielle, zones à haut, moyen et faible risque représentant respectivement des risques décroissants de devenir actifs à l'avenir."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::RelativeErosionRiskZones";
        skos:note              "accepted"@en;
        skos:prefLabel         "Relative Erosion Risk Zones"@en ;
        skos:prefLabel         "Zones relatives de risque d'érosion"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/Lakes/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Lakes";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Lakes";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Lakes/1/>;
