        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A03/current/Hydrography/>;
        skos:definition        "A stream is a body of water with a current, confined within a bed and stream-banks. A river is a natural stream of water, usually freshwater, flowing toward an ocean, a lake, or another stream."@en;
        skos:definition        "Un cours d'eau est une masse d'eau avec un courant, confinée dans un lit et des berges. Une rivière est un cours d'eau naturel, généralement d'eau douce, coulant vers un océan, un lac ou un autre cours d'eau."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A04/current/Rivers/>;
        skos:notation          "SDN:A02::RiversStreams";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rivers and Streams"@en ;
        skos:prefLabel         "Rivières et cours d'eau"@fr .

