<http://vocab.nerc.ac.uk/collection/A02/current/Wastewater/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Wastewater";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Wastewater";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Wastewater/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
