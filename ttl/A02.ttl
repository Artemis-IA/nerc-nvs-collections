        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Human_Activity/> , <http://vocab.nerc.ac.uk/collection/A03/current/Pollution/>;
        skos:definition        "Wastewater is any water that has been adversely affected in quality by anthropogenic influence. It comprises liquid waste discharged by domestic residences, commercial properties, industry, and/or agriculture and can encompass a wide range of potential contaminants and concentrations."@en;
        skos:definition        "Les eaux usées sont toute eau dont la qualité a été défavorablement affectée par l'influence anthropique. Elles comprennent les déchets liquides rejetés par les résidences, les propriétés commerciales, l'industrie et/ou l'agriculture, et peuvent englober une large gamme de contaminants potentiels et de concentrations."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::Wastewater";
        skos:note              "accepted"@en;
        skos:prefLabel         "Wastewater"@en ;
        skos:prefLabel         "Eaux usées"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/Counties/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Counties";
        dc:date                "2011-08-15 11:58:51.0";
