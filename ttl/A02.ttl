<http://vocab.nerc.ac.uk/collection/A02/current/LIDARSurvey/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::LIDARSurvey";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::LIDARSurvey";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/LIDARSurvey/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Sediment_Budget/> , <http://vocab.nerc.ac.uk/collection/A03/current/FieldScience/> , <http://vocab.nerc.ac.uk/collection/A04/current/LIDAR/>;
        skos:definition        "LIDAR (Light Detection and Ranging) is an optical remote sensing technology that measures properties of scattered light to find range and/or other information of a distant target."@en;
        skos:definition        "Le LIDAR (Light Detection and Ranging) est une technologie de télédétection optique qui mesure les propriétés de la lumière diffusée pour déterminer la distance et/ou d'autres informations d'une cible lointaine."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::LIDARSurvey";
        skos:note              "accepted"@en;
        skos:prefLabel         "LIDAR Surveys"@en ;
        skos:prefLabel         "Levé(s) LIDAR"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/OceanStewardshipArea/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::OceanStewardshipArea";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::OceanStewardshipArea";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/OceanStewardshipArea/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Legislation_and_Policy/> , <http://vocab.nerc.ac.uk/collection/A03/current/Goal19/>;
        skos:definition        "The State of Oregon has interests in the conservation of ocean resources in an Ocean Stewardship Area, an ocean area where natural phenomena and human uses can affect uses and resources of Oregon's territorial sea. The Ocean Stewardship Area includes the state's territorial sea, the continental margin seaward to the toe of the continental slope, and adjacent ocean areas."@en;
        skos:definition        "L'État de l'Oregon a des intérêts dans la conservation des ressources océaniques dans une zone de gestion océanique, une zone océanique où les phénomènes naturels et les usages humains peuvent affecter les usages et les ressources de la mer territoriale de l'Oregon. La zone de gestion océanique comprend la mer territoriale de l'État, la marge continentale vers le large jusqu'au pied de la pente continentale, et les zones océaniques adjacentes."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::OceanStewardshipArea";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ocean Stewardship Area"@en ;
        skos:prefLabel         "Zone de gestion océanique"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructures/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::ShoreProtectiveStructures";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::ShoreProtectiveStructures";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructures/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A03/current/Structures/> , <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A04/current/CoastalDefenceStructures/>;
        skos:definition        "Structures built to \"armour\" the shoreline against erosion caused by wave attack."@en;
        skos:definition        "Structures construites pour « protéger » le rivage contre l'érosion causée par les attaques de vagues."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A04/current/CoastalDefenceStructures/>;
        skos:notation          "SDN:A02::ShoreProtectiveStructures";
        skos:note              "accepted"@en;
        skos:prefLabel         "Shoreline Protective Structures"@en ;
        skos:prefLabel         "Structures de protection du rivage"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/SedimentSink/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::SedimentSink";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::SedimentSink";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/SedimentSink/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Sediment_Budget/> , <http://vocab.nerc.ac.uk/collection/A03/current/LittoralCell/>;
        skos:definition        "A Sediment sink is a location to which sediment is \"lost\" from a littoral cell budget, in the sense that it is removed to such a depth or distance that is cannot return to the littoral system through natural contidions. Bays, dunes, the offshore, dredging and mining sites are potential examples of sediment sinks."@en;
        skos:definition        "Un piège à sédiments est un lieu où les sédiments sont « perdus » du budget d'une cellule littorale, en ce sens qu'ils sont transportés à une profondeur ou une distance telle qu'ils ne peuvent retourner au système littoral par les conditions naturelles. Les baies, dunes, le large, les sites de dragage et d'extraction sont des exemples potentiels de pièges à sédiments."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::SedimentSink";
        skos:note              "accepted"@en;
        skos:prefLabel         "Seawall"@en ;
        skos:prefLabel         "Digue de mer"@fr .

