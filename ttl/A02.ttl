<http://vocab.nerc.ac.uk/collection/A02/current/EstuaryManagementUnits/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::EstuaryManagementUnits";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::EstuaryManagementUnits";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/EstuaryManagementUnits/1/>;
