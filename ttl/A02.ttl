<http://vocab.nerc.ac.uk/collection/A02/current/Estuary/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Estuary";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Estuary";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Estuary/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
