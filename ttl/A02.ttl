        skos:definition        "A Lake is a considerable inland body of water, not part of the ocean, situated at the bottom of a topographic basin."@en;
        skos:definition        "Un lac est une étendue d'eau intérieure considérable, ne faisant pas partie de l'océan, située au fond d'un bassin topographique."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::Lakes";
        skos:note              "accepted"@en;
        skos:prefLabel         "Lake"@en ;
        skos:prefLabel         "Lac"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/RiversStreams/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::RiversStreams";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::RiversStreams";
