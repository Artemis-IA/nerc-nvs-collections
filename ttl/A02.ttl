<http://vocab.nerc.ac.uk/collection/A02/current/MediumCoarse/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::MediumCoarse";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::MediumCoarse";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/MediumCoarse/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A03/current/Beach/> , <http://vocab.nerc.ac.uk/collection/A04/current/SoilTypes/>;
        skos:definition        "Beach composed of meadium to coarse grained sand: In USA, sand is commonly divided into five sub-categories based on size: very fine sand (1/16 - 1/8 mm diameter), fine sand (1/8 mm - 1/4 mm), medium sand (1/4 mm - 1/2 mm), coarse sand (1/2 mm - 1 mm), and very coarse sand (1 mm - 2 mm)."@en;
        skos:definition        "Plage composée de sable à grains moyens à grossiers : aux États-Unis, le sable est communément divisé en cinq sous-catégories selon la taille : sable très fin (diamètre 1/16 - 1/8 mm), sable fin (1/8 - 1/4 mm), sable moyen (1/4 - 1/2 mm), sable grossier (1/2 - 1 mm) et sable très grossier (1 - 2 mm)."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::MediumCoarse";
        skos:note              "accepted"@en;
        skos:prefLabel         "Medium to Coarse-grained sandy beach"@en ;
        skos:prefLabel         "Plage de sable à grains moyens à grossiers"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/MixedSandGravel/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::MixedSandGravel";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::MixedSandGravel";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/MixedSandGravel/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A03/current/Beach/> , <http://vocab.nerc.ac.uk/collection/A04/current/SoilTypes/>;
        skos:definition        "Beach composed of mixed sand and gravel: In USA, sand is commonly divided into five sub-categories based on size: very fine sand (1/16 - 1/8 mm diameter), fine sand (1/8 mm - 1/4 mm), medium sand (1/4 mm - 1/2 mm), coarse sand (1/2 mm - 1 mm), and very coarse sand (1 mm - 2 mm). Gravel is typically loose rock that is larger than two millimeters (2mm) in its largest dimension (about 1/12 of an inch) and no more than 63 millimeters (about 2.5 inches)"@en;
        skos:definition        "Plage composée de sable et gravier mélangés : aux États-Unis, le sable est communément divisé en cinq sous-catégories selon la taille : sable très fin (diamètre 1/16 - 1/8 mm), sable fin (1/8 - 1/4 mm), sable moyen (1/4 - 1/2 mm), sable grossier (1/2 - 1 mm) et sable très grossier (1 - 2 mm). Le gravier est typiquement une roche meuble de plus de deux millimètres (2 mm) dans sa plus grande dimension (environ 1/12 de pouce) et au plus 63 millimètres (environ 2,5 pouces)"@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::MixedSandGravel";
        skos:note              "accepted"@en;
        skos:prefLabel         "Mixed sand and gravel beach"@en ;
        skos:prefLabel         "Plage de sable et gravier mélangés"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/CoastGuardStations/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::CoastGuardStations";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::CoastGuardStations";
