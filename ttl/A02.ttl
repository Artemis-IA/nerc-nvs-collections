        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/I03/current/Bedrock_Coast/> , <http://vocab.nerc.ac.uk/collection/A03/current/Shoreline/> , <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A04/current/NaturalCoastalFeatures/>;
        skos:definition        "Rocky shores are areas of bedrock exposed between the extreme high and extreme low tide levels on the seashore."@en;
        skos:definition        "Les côtes rocheuses sont des zones de roche affleurante exposées entre les niveaux de marée haute extrême et de marée basse extrême sur le bord de mer."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/I03/current/Bedrock_Coast/>;
        skos:notation          "SDN:A02::RockyShore";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rocky Shore"@en ;
        skos:prefLabel         "Rivage rocheux"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/Flat/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Flat";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::Flat";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/Flat/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A04/current/NaturalCoastalFeatures/> , <http://vocab.nerc.ac.uk/collection/A03/current/Shoreline/>;
        skos:definition        "Flats are coastal wetlands that form when mud and sand is deposited by the tides or rivers, sea and oceans. They are broad mud flats which are exposed to the air at low tide and flooded by a mix of salt and fresh waters at high tide, found in sheltered areas such as bays, lagoons, and estuaries."@en;
        skos:definition        "Les vasières sont des zones humides côtières qui se forment lorsque la vase et le sable sont déposés par les marées ou les rivières, la mer et les océans. Ce sont de vastes vasières exposées à l'air à marée basse et inondées par un mélange d'eaux salées et douces à marée haute, présentes dans des zones abritées comme les baies, lagunes et estuaires."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::Flat";
        skos:note              "accepted"@en;
        skos:prefLabel         "Flat"@en ;
        skos:prefLabel         "Vasière"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/IntertidalWetlands/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::IntertidalWetlands";
        dc:date                "2011-08-15 11:58:51.0";
        dc:identifier          "SDN:A02::IntertidalWetlands";
        pav:authoredOn         "2011-08-15 11:58:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A02/current/IntertidalWetlands/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A03/current/Habitat/> , <http://vocab.nerc.ac.uk/collection/A01/current/Mitigation_Strategies_and_Preparedness/> , <http://vocab.nerc.ac.uk/collection/A04/current/NaturalCoastalFeatures/> , <http://vocab.nerc.ac.uk/collection/I03/current/Wetland/>;
        skos:definition        "An intertidal wetland is an environment at the interface between truly terrestrial ecosystems and aquatic systems, in this case coastal tidal systems."@en;
        skos:definition        "Une zone humide intertidale est un environnement à l'interface entre les écosystèmes véritablement terrestres et les systèmes aquatiques, en l'occurrence les systèmes tidaux côtiers."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:notation          "SDN:A02::IntertidalWetlands";
        skos:note              "accepted"@en;
        skos:prefLabel         "Intertidal Wetlands"@en ;
        skos:prefLabel         "Zones humides intertidales"@fr .

<http://vocab.nerc.ac.uk/collection/A02/current/Bluff/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A02::Bluff";
