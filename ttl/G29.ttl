        dc:creator              "International Organization for Standardization";
        dc:date                 "2012-07-05 02:00:09.0";
        dc:description          "Extension of MD_ScopeCode for the needs of GMX application schemas and in the context of a transfer";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "MX_ScopeCode";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "International Organization for Standardization";
