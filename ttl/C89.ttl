<http://vocab.nerc.ac.uk/collection/C89/current/CI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C89::CI";
        dc:date                "2011-12-12 12:34:56.0";
        dc:identifier          "SDN:C89::CI";
        pav:authoredOn         "2011-12-12 12:34:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C89/current/CI/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Project Co-I";
        skos:definition        "The persons responsible for the planning, direction and management of a sub-component of a project.  Termed a work package leader in EU projects."@en;
        skos:notation          "SDN:C89::CI";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project co-investigator"@en .

<http://vocab.nerc.ac.uk/collection/C89/current/PM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C89::PM";
        dc:date                "2011-12-12 12:34:56.0";
        dc:identifier          "SDN:C89::PM";
