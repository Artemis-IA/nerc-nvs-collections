        skos:definition        "The release of waste matter such as faeces or dirty water from sewage treatment facilities"@en;
        skos:definition        "Le rejet de matières résiduaires telles que des excréments ou de l'eau sale depuis des installations de traitement des eaux usées"@fr ;
        skos:notation          "SDN:M13::005";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sewerage disposal"@en ;
        skos:prefLabel         "Évacuation des égouts"@fr .

<http://vocab.nerc.ac.uk/collection/M13/current/003/>
