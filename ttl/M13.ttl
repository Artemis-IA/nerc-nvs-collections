        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M12/current/3/>;
        skos:definition        "The targeted removal of fish species using portable traps that are left in place for a period of time before being recovered to retrieve the caught fish. Example gear types: traps (not specified) (FIX) and pots (FPO) (classifications from United Nations Food and Agriculture Organisation International Standard Statistical Classification of Fishing Gear (ISSCFG))"@en;
        skos:notation          "SDN:M13::011";
        skos:note              "accepted"@en;
        skos:prefLabel         "Fishing - traps (potting/creeling)"@en .

<http://vocab.nerc.ac.uk/collection/M13/current/016/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M13::016";
