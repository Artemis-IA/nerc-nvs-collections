<http://vocab.nerc.ac.uk/collection/GS3/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the EU Geo-Seas project implemented as consultation between BODC and a designated group of Geo-Seas project paticipants";
        dc:alternative          "Adjusted Folk classes";
        dc:creator              "Geo-Seas";
        dc:date                 "2010-10-15 02:00:11.0";
        dc:description          "Terms used to categorise sedimentary rocks and sediments in terms of the proportion of gravel, sand and mud.  Initial terms proposed by Folk (1954) but subsequently revised by BGS and Flemming (2000).";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Geo-Seas adjusted Folk sediment lithology classes";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Geo-Seas";
        owl:versionInfo         "1";
        skos:altLabel           "Adjusted Folk classes";
        skos:altLabel           "classes Folk ajustées"@fr ;
        skos:member             <http://vocab.nerc.ac.uk/collection/GS3/current/(m)S/> , <http://vocab.nerc.ac.uk/collection/GS3/current/(g)S/> , <http://vocab.nerc.ac.uk/collection/GS3/current/gmS/> , <http://vocab.nerc.ac.uk/collection/GS3/current/(g)mS/> , <http://vocab.nerc.ac.uk/collection/GS3/current/sM/> , <http://vocab.nerc.ac.uk/collection/GS3/current/(g)M/> , <http://vocab.nerc.ac.uk/collection/GS3/current/gM/> , <http://vocab.nerc.ac.uk/collection/GS3/current/msG/> , <http://vocab.nerc.ac.uk/collection/GS3/current/(s)M/> , <http://vocab.nerc.ac.uk/collection/GS3/current/M/> , <http://vocab.nerc.ac.uk/collection/GS3/current/(g)sM/> , <http://vocab.nerc.ac.uk/collection/GS3/current/G/> , <http://vocab.nerc.ac.uk/collection/GS3/current/mG/> , <http://vocab.nerc.ac.uk/collection/GS3/current/sG/> , <http://vocab.nerc.ac.uk/collection/GS3/current/mS/> , <http://vocab.nerc.ac.uk/collection/GS3/current/gS/> , <http://vocab.nerc.ac.uk/collection/GS3/current/S/>;
        skos:prefLabel          "Geo-Seas adjusted Folk sediment lithology classes" ;
        skos:prefLabel          "classes de lithologie sédimentaire Folk ajustées Geo-Seas"@fr .
