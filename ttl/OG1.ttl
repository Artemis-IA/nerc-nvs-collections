<http://vocab.nerc.ac.uk/collection/OG1/current/REDOX_POTENTIAL_CORR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:OG1::REDOX_POTENTIAL_CORR";
        dc:date                "2026-05-22 13:48:07.0";
        dc:identifier          "SDN:OG1::REDOX_POTENTIAL_CORR";
        pav:authoredOn         "2026-05-22 13:48:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/OG1/current/REDOX_POTENTIAL_CORR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P01/current/RPTWBHE1/>;
        owl:versionInfo        "1";
        skos:altLabel          "REDOX_CORR";
        skos:definition        "A measure of the tendency of the water body to either gain or lose electrons in a reaction. The redox measurement is referenced against a Standard Hydrogen Electrode and can be referred to as Eh."@en;
        skos:definition        "Mesure de la tendance de la masse d'eau à capter ou céder des électrons dans une réaction. La mesure redox est référencée à une électrode standard à hydrogène et peut être notée Eh."@fr ;
        skos:notation          "SDN:OG1::REDOX_POTENTIAL_CORR";
        skos:note              "accepted"@en;
        skos:prefLabel         "Redox potential relative to Standard Hydrogen Electrode (SHE)"@en;
        skos:prefLabel         "Potentiel redox par rapport à l'électrode standard à hydrogène (SHE)"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUMV/> .

