        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P01/current/ENLVZZ01/>;
        owl:versionInfo        "1";
        skos:altLabel          "ENERGYLEVEL_ALTIMETER";
        skos:definition        "Intensity of the echo return from an altimeter, ranging from 0 to 1. A value of 1 represents full saturation of the receiver. An energy level of 0.707 (square root of 2) is the theoretical perfect level as it represents the energy of a pure sine wave with an amplitude utilising the maximum dynamic range of the receiver."@en;
        skos:definition        "Intensité de l'écho retour d'un altimètre, comprise entre 0 et 1. Une valeur de 1 représente la saturation complète du récepteur. Un niveau d'énergie de 0,707 (racine carrée de 2) est le niveau théorique parfait car il représente l'énergie d'une sinusoïde pure d'amplitude utilisant la plage dynamique maximale du récepteur."@fr ;
        skos:notation          "SDN:OG1::ENLEVEL";
        skos:note              "accepted"@en;
        skos:prefLabel         "Energy level of acoustic signal by altimeter"@en;
        skos:prefLabel         "Niveau d'énergie du signal acoustique par altimètre"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

