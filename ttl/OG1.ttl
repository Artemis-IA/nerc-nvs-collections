<http://vocab.nerc.ac.uk/collection/OG1/current/FDOM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:OG1::FDOM";
        dc:date                "2024-09-09 11:33:13.0";
        dc:identifier          "SDN:OG1::FDOM";
        pav:authoredOn         "2024-09-09 11:33:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/OG1/current/FDOM/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P01/current/QSCDOMX1/>;
        owl:versionInfo        "1";
        skos:altLabel          "FDOM";
        skos:definition        "The quantity of the optically measurable component of coloured (chromophoric) dissolved organic matter (CDOM) that fluoresces when excited with near ultra-violet (UV) light, measured in a unit volume of salt water by calibration against a quinine sulphate proxy. Often referred to as fluorescent dissolved organic matter (FDOM) when expressed as quinine sulphate equivalent."@en;
        skos:definition        "Quantité de la fraction optiquement mesurable de la matière organique dissoute colorée (chromophore, CDOM) qui fluoresce sous excitation par une lumière ultraviolette proche (UV), mesurée par unité de volume d'eau salée par étalonnage sur un étalon de quinine sulfate. Souvent appelée matière organique dissoute fluorescente (FDOM) lorsqu'elle est exprimée en équivalent quinine sulfate."@fr ;
        skos:notation          "SDN:OG1::FDOM";
        skos:note              "accepted"@en;
        skos:prefLabel         "Concentration of coloured dissolved organic matter expressed as quinine sulphate equivalent (FDOM) in seawater"@en;
        skos:prefLabel         "Concentration en matière organique dissoute colorée exprimée en équivalent quinine sulfate (FDOM) dans l'eau de mer"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UPPB/> .

