        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "TKE_EPSILON";
        skos:definition        "The rate at which turbulent kinetic energy is converted into thermal internal energy as a result of viscosity in fluid flow."@en;
        skos:definition        "Taux auquel l'énergie cinétique turbulente est convertie en énergie interne thermique sous l'effet de la viscosité dans l'écoulement du fluide."@fr ;
        skos:notation          "SDN:OG1::TKE_EPSILON";
        skos:note              "accepted"@en;
        skos:prefLabel         "Log10 turbulent kinetic energy dissipation {epsilon}"@en ;
        skos:prefLabel         "Log10 de la dissipation d'énergie cinétique turbulente {epsilon}"@fr .

<http://vocab.nerc.ac.uk/collection/OG1/current/PROFILE_NUMBER/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:OG1::PROFILE_NUMBER";
        dc:date                "2026-10-13 10:13:48.0";
        dc:identifier          "SDN:OG1::PROFILE_NUMBER";
        pav:authoredOn         "2026-10-13 10:13:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/OG1/current/PROFILE_NUMBER/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PROFILE_NUMBER";
        skos:definition        "Uniquely identifies each ascending and descending profile of a glider dataset. PROFILE_NUMBER increments by 1 each time the glider starts an ascending or descending profile. PROFILE_NUMBER is 1 at the start of the first ascending or descending profile in the dataset. When the glider is not in one of these states, PROFILE_NUMBER is NaN."@en;
        skos:definition        "Identifie de manière unique chaque profil montant et descendant d'un jeu de données de planeur. PROFILE_NUMBER s'incrémente de 1 à chaque fois que le planeur entame un profil montant ou descendant. PROFILE_NUMBER vaut 1 au début du premier profil montant ou descendant du jeu de données. Lorsque le planeur n'est pas dans l'un de ces états, PROFILE_NUMBER est NaN."@fr ;
        skos:notation          "SDN:OG1::PROFILE_NUMBER";
        skos:note              "accepted"@en;
        skos:prefLabel         "Identifier of numbered profile"@en;
        skos:prefLabel         "Identifiant du profil numéroté"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/XXXX/> .

