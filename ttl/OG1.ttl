<http://vocab.nerc.ac.uk/collection/OG1/current/ENLEVEL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:OG1::ENLEVEL";
        dc:date                "2023-06-02 13:43:08.0";
        dc:identifier          "SDN:OG1::ENLEVEL";
