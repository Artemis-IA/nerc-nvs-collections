<http://vocab.nerc.ac.uk/collection/OG1/current/TKE_EPSILON/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:OG1::TKE_EPSILON";
        dc:date                "2026-10-22 10:59:55.0";
        dc:identifier          "SDN:OG1::TKE_EPSILON";
        pav:authoredOn         "2026-10-22 10:59:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/OG1/current/TKE_EPSILON/1/>;
