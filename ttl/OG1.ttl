        skos:altLabel          "OIL_VOL";
        skos:definition        "The volume of oil in the external reservoir of the platform. A positive change in OIL_VOL represents moving oil from the internal reservoir (within the pressure casing) to the external reservoir, increasing the total volume of the platform."@en;
        skos:definition        "Volume d'huile dans le réservoir externe de la plateforme. Une variation positive d'OIL_VOL représente un transfert d'huile du réservoir interne (dans le carter sous pression) vers le réservoir externe, augmentant le volume total de la plateforme."@fr ;
        skos:notation          "SDN:OG1::OIL_VOL";
        skos:note              "accepted"@en;
        skos:prefLabel         "Oil volume in the measurement platform"@en;
        skos:prefLabel         "Volume d'huile dans la plateforme de mesure"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/VVCC/> .

