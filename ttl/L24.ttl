        skos:prefLabel         "ESRI Shapefile Format"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/001/> .

<http://vocab.nerc.ac.uk/collection/L24/current/UKOAP190/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::UKOAP190";
        dc:date                "2010-06-16 15:07:31.0";
        dc:identifier          "SDN:L24::UKOAP190";
        pav:authoredOn         "2010-06-16 15:07:31.0";
