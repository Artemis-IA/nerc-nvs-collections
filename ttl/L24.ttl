<http://vocab.nerc.ac.uk/collection/L24/current/NETCDF-3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::NETCDF-3";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::NETCDF-3";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/NETCDF-3/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/NETCDF-3/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "NetCDF-3";
        skos:definition        "Network Common Data Form (netCDF) is a self-describing and machine-independent binary format. It bundles data arrays with metadata and is structured using dimensions, variables, and attributes. It is used for storing and sharing multidimensional scientific data. This version (3) can refer to the classic model (CDF-1), the CDF-2 which allows for more flexibility with variables and data sizes, or CDF-5 which allows for larger integer and unsigned integer data."@en;
        skos:notation          "SDN:L24::NETCDF-3";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Network Common Data Format Version 3"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/SHP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::SHP";
