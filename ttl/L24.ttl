<http://vocab.nerc.ac.uk/collection/L24/current/HDF5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::HDF5";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::HDF5";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/HDF5/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/HDF5/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "HDF5";
        skos:definition        "HDF5 is an open source file format which supports multidimensional arrays, raster images, tables, and documents (e.g. PDF). It is self-describing and machine-independent, and is used to store complex, heterogeneous data and metadata. It is built for fast I/O processing and storage."@en;
        skos:notation          "SDN:L24::HDF5";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Hierarchical Data Format Version 5"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/KML/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::KML";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::KML";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/KML/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/KML/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "KML";
        skos:definition        "KML is an open standard file format designed to display geographic data on 2D and 3D maps using XML notation. The files are human and machine readable, and can describe pinpoint locations, polygons, images, 3D models, and add image overlays. It also contains display information for software applications."@en;
        skos:notation          "SDN:L24::KML";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Keyhole Markup Language"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/PDF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::PDF";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::PDF";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/PDF/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/PDF/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "PDF";
        skos:definition        "PDF is an open standard file format (as of 2008) developed by Adobe to present documents, including text formatting and images, in a manner independent of application software, hardware, and operating systems. It is based on the PostScript language, where each file is self-contained, in that it contains all necessary elements such as text, fonts, vector graphics, raster images and other information needed to display it."@en;
        skos:notation          "SDN:L24::PDF";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Portable Document Format"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/HDF4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::HDF4";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::HDF4";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/HDF4/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/HDF4/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "HDF4";
        skos:definition        "HDF4 is an open source file format which supports multidimensional arrays, raster images, and tables. It is self-describing and machine-independent, and is used to store complex, heterogeneous data and metadata. It has a maximum file size of 2 GB. It is still supported and used, however it is not the recommended HDF format."@en;
        skos:notation          "SDN:L24::HDF4";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Hierarchical Data Format Version 4"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/ASCII/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::ASCII";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::ASCII";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/ASCII/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/ASCII/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "ASCII";
        skos:definition        "ASCII is a character encoding standard that uses unique binary codes to represent letters, numbers, punctuation, and other characters. ASCII codes represent text in a standardised way to minimise compatibility issues across different computers, telecommunications equipment, and other devices."@en;
        skos:notation          "SDN:L24::ASCII";
        skos:note              "deprecated"@en;
        skos:prefLabel         "American Standard Code for Information Interchange"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/EXCEL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::EXCEL";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::EXCEL";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/EXCEL/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/EXCEL/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "Excel";
        skos:definition        "Excel is a spreadsheet developed by Microsoft for Windows, macOS, Android and iOS. These spreadsheets can handle data, formulas, charts, pivot tables, macros (Excel uses visual basic for applications (VBA)), and images. Excel refers to various proprietary file formats that are produced exclusively by Microsoft Windows, such as xlsx, xlsm, xlsb, and xls. Some file formats are based on XML (e.g. xlsx), whilst others are binary formats (e.g. xls)."@en;
        skos:notation          "SDN:L24::EXCEL";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Microsoft Excel"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/JPEG-2000/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::JPEG-2000";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::JPEG-2000";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/JPEG-2000/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/JPEG-2000/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "JPEG_2000";
        skos:definition        "JPEG 2000 (JP2) is an image compression standard and coding system that is based on a discrete wavelet transform. It is not supported on web pages as of 2024."@en;
        skos:notation          "SDN:L24::JPEG-2000";
        skos:note              "deprecated"@en;
        skos:prefLabel         "JPEG 2000"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/TSV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::TSV";
        dc:date                "2026-03-19 11:16:00.0";
