        skos:altLabel          "MEDATLAS"@fr ;
        skos:definition        "SeaDataNet extension of the Mediterrannean community ASCII format with additional semantics embedded.  Designed for profiles and point time series."@en;
        skos:definition        "Extension SeaDataNet du format ASCII de la communauté méditerranéenne avec une sémantique supplémentaire intégrée. Conçu pour les profils et les séries temporelles ponctuelles."@fr ;
        skos:notation          "SDN:L24::MEDATLAS";
