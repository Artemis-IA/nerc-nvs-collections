<http://vocab.nerc.ac.uk/collection/L24/current/GEOTIFF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::GEOTIFF";
        dc:date                "2014-06-24 08:53:18.0";
        dc:identifier          "SDN:L24::GEOTIFF";
        pav:authoredOn         "2014-06-24 08:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/GEOTIFF/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GEOTIFF";
        skos:altLabel          "GEOTIFF"@fr ;
        skos:definition        "A public domain metadata standard which allows georeferencing information to be embedded within a TIFF file. The potential additional information includes map projection, coordinate systems, ellipsoids, datums, and other attributes to establish the exact spatial reference for the file."@en;
        skos:definition        "Un standard de métadonnées du domaine public qui permet d'intégrer des informations de géoréférencement dans un fichier TIFF. Les informations additionnelles potentielles incluent la projection cartographique, les systèmes de coordonnées, les ellipsoïdes, les repères et d'autres attributs pour établir la référence spatiale exacte du fichier."@fr ;
        skos:notation          "SDN:L24::GEOTIFF";
        skos:note              "accepted"@en;
        skos:prefLabel         "Georeferenced Tagged Image File Format"@en;
        skos:prefLabel         "Georeferenced Tagged Image File Format"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/002/> .

