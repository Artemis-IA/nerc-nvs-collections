        skos:notation          "SDN:L24::TSV";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Tab-separated values"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/KMZ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::KMZ";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::KMZ";
