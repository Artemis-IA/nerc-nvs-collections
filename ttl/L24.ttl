<http://vocab.nerc.ac.uk/collection/L24/current/JSON/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::JSON";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::JSON";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/JSON/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/JSON/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "JSON";
        skos:definition        "JSON, JavaScript Object Notation) is an open standard file format that is human-readable and used for exchanging data in text format. It stores and transmits key value pairs in objects and ordered lists in arrays which are human and machine readable. It is compatible across programming languages such as JavaScript, Python, and Java."@en;
        skos:notation          "SDN:L24::JSON";
        skos:note              "deprecated"@en;
        skos:prefLabel         "JavaScript Object Notation"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/NETCDF-4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::NETCDF-4";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::NETCDF-4";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/NETCDF-4/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/NETCDF-4/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "NetCDF-4";
        skos:definition        "Network Common Data Form (netCDF) is a self-describing and machine-independent binary format. It bundles data arrays with metadata and is structured using dimensions, variables, and attributes. It is used for storing and sharing multidimensional scientific data. This version (4) allows for larger file sizes, data compression, and nested groups."@en;
        skos:notation          "SDN:L24::NETCDF-4";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Network Common Data Format Version 4"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/GEODATABASE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::GEODATABASE";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::GEODATABASE";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/GEODATABASE/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/GEODATABASE/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "geodatabase";
        skos:definition        "Geodatabase is a proprietary GIS file format used by Esri ArcGIS. It physically stores geographic information using a database management system or file system. It has an information model, for representing and managing geographic information, software logic, for working with the geographic data and shapefiles, CAD files, TINs, grids, etc., and a transaction model, for managing GIS data workflows."@en;
        skos:notation          "SDN:L24::GEODATABASE";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Esri Geodatabase"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/GEOPACKAGE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::GEOPACKAGE";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::GEOPACKAGE";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/GEOPACKAGE/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/GEOPACKAGE/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "GPKG";
        skos:definition        "GeoPackage (GPKG) is an open, non-proprietary, platform-independent and standards-based data format for geographic information system. It is an SQLite database file with a specific database schema. It stores vector features, tile matrix sets of imagery and raster maps, schema and metadata."@en;
        skos:notation          "SDN:L24::GEOPACKAGE";
        skos:note              "deprecated"@en;
        skos:prefLabel         "GeoPackage"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/GEOJSON/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::GEOJSON";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::GEOJSON";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/GEOJSON/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/GEOJSON/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "GeoJSON";
        skos:definition        "GeoJSON is an open, non-proprietary standard format designed for representing simple geographical features, along with their non-spatial attributes. It is a dialect based on the JavaScript Object Notation (JSON). The features include points, line strings, polygons, and multiple collections of these types. GeoJSON features can also be used to define and describe conceptual or abstract features, such as mobile service coverage or urban planning data."@en;
        skos:notation          "SDN:L24::GEOJSON";
        skos:note              "deprecated"@en;
        skos:prefLabel         "JavaScript Object Notation for Geographical Features"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/GRID/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::GRID";
        dc:date                "2026-03-19 11:16:00.0";
        dc:identifier          "SDN:L24::GRID";
        pav:authoredOn         "2026-03-19 11:16:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/GRID/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/GRID/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "grid";
        skos:definition        "An Esri grid is a raster GIS file format developed by Esri. There are two file options, either a proprietary binary format, also known as an ARC/INFO GRID, ARC GRID and many other variations, or a non-proprietary ASCII format, also known as an ARC/INFO ASCII GRID."@en;
        skos:notation          "SDN:L24::GRID";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Esri Grid"@en .

<http://vocab.nerc.ac.uk/collection/L24/current/INAPP/>
