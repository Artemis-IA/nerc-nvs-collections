<http://vocab.nerc.ac.uk/collection/L24/current/ESFL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::ESFL";
        dc:date                "2018-09-05 14:35:25.0";
        dc:identifier          "SDN:L24::ESFL";
        pav:authoredOn         "2018-09-05 14:35:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/ESFL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sea_floor_litter";
        skos:altLabel          "Sea_floor_litter"@fr ;
        skos:definition        "A standard data format in excel formulated by EMODnet Chemistry in cooperation with TSG-ML and EU-JRC and derived from DATRAS- ICES Database of trawl surveys practices and guidelines for North and Western European seas and MEDITS practices and guidelines for the Mediterranean sea. It is used for reporting and classifying benthic litter monitoring data from fish trawl surveys. Excel variants are allowed."@en;
        skos:definition        "Un format de données standard dans Excel formulé par EMODnet Chemistry en coopération avec TSG-ML et EU-JRC et dérivé des pratiques et directives DATRAS - ICES Database of trawl surveys pour les mers du Nord et d'Europe occidentale et des pratiques et directives MEDITS pour la mer Méditerranée. Il est utilisé pour le rapport et la classification des données de surveillance des déchets benthiques issues des études par chalutages. Les variantes Excel sont autorisées."@fr ;
        skos:notation          "SDN:L24::ESFL";
        skos:note              "accepted"@en;
        skos:prefLabel         "EMODnet Sea-floor litter data format"@en;
        skos:prefLabel         "EMODnet Sea-floor litter data format"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/003/> .

<http://vocab.nerc.ac.uk/collection/L24/current/CFPOINT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::CFPOINT";
        dc:date                "2013-07-16 12:27:20.0";
        dc:identifier          "SDN:L24::CFPOINT";
