        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/001/> .

<http://vocab.nerc.ac.uk/collection/L24/current/SODV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::SODV";
        dc:date                "2021-03-04 21:48:55.0";
        dc:identifier          "SDN:L24::SODV";
        pav:authoredOn         "2021-03-04 21:48:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/SODV/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sediment_microlitter_ODV";
        skos:altLabel          "Sediment_microlitter_ODV"@fr ;
        skos:definition        "A variant of the ODV ASCII format to enable Data Centers to exchange microlitter in sediments data using the SeaDataNet infrastructure. It contains all the elements required to describe microlitter in sediments."@en;
        skos:definition        "Une variante du format ODV ASCII permettant aux centres de données d'échanger des données de micro-déchets dans les sédiments via l'infrastructure SeaDataNet. Il contient tous les éléments requis pour décrire les micro-déchets dans les sédiments."@fr ;
        skos:notation          "SDN:L24::SODV";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sediment micro-litter ODV format"@en;
        skos:prefLabel         "Sediment micro-litter ODV format"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/003/> .

<http://vocab.nerc.ac.uk/collection/L24/current/MODV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::MODV";
        dc:date                "2021-03-04 21:47:53.0";
        dc:identifier          "SDN:L24::MODV";
        pav:authoredOn         "2021-03-04 21:47:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/MODV/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/MODV/2/> , <http://vocab.nerc.ac.uk/collection/L24/current/MODV/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Floating_microlitter_ODV";
        skos:altLabel          "Floating_microlitter_ODV"@fr ;
        skos:definition        "A variant of the Biological ODV format to enable Data Centers to exchange floating microlitter data using the SeaDataNet infrastructure. It contains all the required elements to describe the floating microlitter observation."@en;
        skos:definition        "Une variante du format ODV biologique permettant aux centres de données d'échanger des données de micro-déchets flottants via l'infrastructure SeaDataNet. Il contient tous les éléments requis pour décrire l'observation de micro-déchets flottants."@fr ;
        skos:notation          "SDN:L24::MODV";
        skos:note              "accepted"@en;
        skos:prefLabel         "Floating micro-litter ODV format"@en;
        skos:prefLabel         "Floating micro-litter ODV format"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/003/> .

<http://vocab.nerc.ac.uk/collection/L24/current/EBL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::EBL";
        dc:date                "2018-09-05 14:35:25.0";
        dc:identifier          "SDN:L24::EBL";
        pav:authoredOn         "2018-09-05 14:35:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/EBL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Beach_litter";
        skos:altLabel          "Beach_litter"@fr ;
        skos:definition        "A standard data format in Excel formulated by EMODnet Chemistry in cooperation with TSG-ML and EU-JRC and derived from OSPAR/MCS guidelines and practices. It is used for reporting and classifying beach litter monitoring data. Excel variants are permitted."@en;
        skos:definition        "Un format de données standard dans Excel formulé par EMODnet Chemistry en coopération avec TSG-ML et EU-JRC et dérivé des directives et pratiques OSPAR/MCS. Il est utilisé pour le rapport et la classification des données de surveillance des déchets de plage. Les variantes Excel sont autorisées."@fr ;
        skos:notation          "SDN:L24::EBL";
        skos:note              "accepted"@en;
        skos:prefLabel         "EMODnet Beach litter data format"@en;
        skos:prefLabel         "EMODnet Beach litter data format"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/003/> .

<http://vocab.nerc.ac.uk/collection/L24/current/BODV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::BODV";
        dc:date                "2020-11-30 09:46:45.0";
        dc:identifier          "SDN:L24::BODV";
        pav:authoredOn         "2020-11-30 09:46:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/BODV/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Biological_ODV";
        skos:altLabel          "Biological_ODV"@fr ;
        skos:definition        "A variant of the ODV ASCII format to enable Data Centers to exchange biological (taxon-based) data using the SeaDataNet infrastructure. It contains all the elements required to allow conversion to the Darwin Core format and is therefore compatible with formats used by e.g. EMODNet Biology, (Eur)OBIS and GBIF."@en;
        skos:definition        "Une variante du format ODV ASCII permettant aux centres de données d'échanger des données biologiques (basées sur les taxons) via l'infrastructure SeaDataNet. Il contient tous les éléments requis pour permettre la conversion au format Darwin Core et est donc compatible avec les formats utilisés par ex. EMODNet Biology, (Eur)OBIS et GBIF."@fr ;
        skos:notation          "SDN:L24::BODV";
        skos:note              "accepted"@en;
        skos:prefLabel         "Biological ODV"@en;
        skos:prefLabel         "Biological ODV"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/G26/current/003/> .

<http://vocab.nerc.ac.uk/collection/L24/current/ODV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::ODV";
        dc:date                "2020-11-30 09:46:57.0";
        dc:identifier          "SDN:L24::ODV";
        pav:authoredOn         "2020-11-30 09:46:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L24/current/ODV/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L24/current/ODV/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "ODV";
        skos:altLabel          "ODV"@fr ;
        skos:definition        "SeaDataNet extension of the Ocean Data View ASCII upload format with additional semantics embedded. Designed for profiles and point time series. For taxon-based data and micro-litter data please use the specially designed ODV variants."@en;
        skos:definition        "Extension SeaDataNet du format de téléversement ASCII d'Ocean Data View avec une sémantique supplémentaire intégrée. Conçu pour les profils et les séries temporelles ponctuelles. Pour les données basées sur les taxons et les données de micro-déchets, veuillez utiliser les variantes ODV spécialement conçues."@fr ;
        skos:notation          "SDN:L24::ODV";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ocean Data View ASCII input"@en;
        skos:prefLabel         "Ocean Data View ASCII input"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/C10/current/TRAJ/> , <http://vocab.nerc.ac.uk/collection/G26/current/003/> , <http://vocab.nerc.ac.uk/collection/C10/current/SPTRAJ/> , <http://vocab.nerc.ac.uk/collection/C10/current/PPROF/> , <http://vocab.nerc.ac.uk/collection/C10/current/POLYSER/> , <http://vocab.nerc.ac.uk/collection/C10/current/POINT/> , <http://vocab.nerc.ac.uk/collection/C10/current/SPPOINT/> , <http://vocab.nerc.ac.uk/collection/C10/current/PDPROF/> , <http://vocab.nerc.ac.uk/collection/C10/current/PROFSER/> , <http://vocab.nerc.ac.uk/collection/C10/current/DPROF/> , <http://vocab.nerc.ac.uk/collection/C10/current/SPPPROF/> , <http://vocab.nerc.ac.uk/collection/C10/current/PROFCOLL/> , <http://vocab.nerc.ac.uk/collection/C10/current/TRAJ3D/> , <http://vocab.nerc.ac.uk/collection/C10/current/SPDPROF/> , <http://vocab.nerc.ac.uk/collection/C10/current/SPECSER/> , <http://vocab.nerc.ac.uk/collection/C10/current/SPPDPROF/> .

<http://vocab.nerc.ac.uk/collection/L24/current/MEDATLAS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L24::MEDATLAS";
        dc:date                "2007-09-14 14:33:19.0";
