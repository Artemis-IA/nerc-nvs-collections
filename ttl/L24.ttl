        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "UKOOA P1-90";
        skos:altLabel          "UKOOA P1-90"@fr ;
        skos:definition        "A standard format designed for raw marine positioning and ancillary data exchange widely used by industry especially for seismic surveys (http://www.epsg.org/Exchange/P1.pdf)."@en;
        skos:definition        "Un format standard conçu pour l'échange de données brutes de positionnement marine et de données annexes, largement utilisé par l'industrie en particulier pour les études sismiques (http://www.epsg.org/Exchange/P1.pdf)."@fr ;
        skos:notation          "SDN:L24::UKOAP190";
