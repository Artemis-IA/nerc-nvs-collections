        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/G28/current/002/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "1-dimensional topological complex --  commonly called  chain-node  topology"@en;
        skos:notation          "SDN:G28::002";
        skos:note              "accepted"@en;
        skos:prefLabel         "topology1D"@en .

<http://vocab.nerc.ac.uk/collection/G28/current/004/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:G28::004";
        dc:date                "2012-07-04 11:39:51.0";
        dc:identifier          "SDN:G28::004";
        pav:authoredOn         "2012-07-04 11:39:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/G28/current/004/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "2-dimensional topological complex that is planar. (A 2-dimensional topological complex is commonly called  full topology  in a cartographic 2D environment.)"@en;
        skos:notation          "SDN:G28::004";
        skos:note              "accepted"@en;
        skos:prefLabel         "fullPlanarGraph"@en .

<http://vocab.nerc.ac.uk/collection/G28/current/005/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:G28::005";
        dc:date                "2012-07-04 11:39:51.0";
        dc:identifier          "SDN:G28::005";
        pav:authoredOn         "2012-07-04 11:39:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/G28/current/005/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "1-dimensional topological complex that is isomorphic to a subset of a surface. (A geometric complex is isomorphic to a topological complex if their elements are in a one-to-one, dimensional-and boundry-preserving correspondence to one another.)"@en;
        skos:notation          "SDN:G28::005";
        skos:note              "accepted"@en;
        skos:prefLabel         "surfaceGraph"@en .

