<http://vocab.nerc.ac.uk/collection/C34/current/MRAT0013/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C34::MRAT0013";
        dc:date                "2007-06-29 16:19:24.0";
        dc:identifier          "SDN:C34::MRAT0013";
        pav:authoredOn         "2007-06-29 16:19:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C34/current/MRAT0013/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Climate change";
        skos:altLabel          "changement climatique"@fr ;
        skos:definition        "The variation in the Earth's global climate or in regional climates over time. It describes changes in the variability over time scales ranging from decades to millions of years. These changes may come from processes internal to the Earth, be driven by external forces (e.g. variations in sunlight intensity) or, most recently, be caused by human activities."@en;
        skos:definition        "La variation du climat global de la Terre ou des climats régionaux au cours du temps. Elle décrit les changements de la variabilité sur des échelles de temps allant de décennies à des millions d'années. Ces changements peuvent provenir de processus internes à la Terre, être entraînés par des forces externes (par ex. variations de l'intensité du rayonnement solaire) ou, plus récemment, être causés par des activités humaines."@fr ;
        skos:notation          "SDN:C34::MRAT0013";
        skos:note              "accepted"@en;
        skos:prefLabel         "Climate change"@en ;
        skos:prefLabel         "changement climatique"@fr .

