        skos:altLabel          "océanographie opérationnelle"@fr ;
        skos:definition        "Monitoring activities that are carried out to provide oceanographic forecasts and services to the public and scientific community. They do not provide information on a specific environmental pressure."@en;
        skos:definition        "Activités de surveillance menées pour fournir des prévisions et services océanographiques au public et à la communauté scientifique. Elles ne fournissent pas d'information sur une pression environnementale spécifique."@fr ;
        skos:notation          "SDN:C34::MRAT0022";
        skos:note              "accepted"@en;
        skos:prefLabel         "Operational oceanography"@en ;
        skos:prefLabel         "océanographie opérationnelle"@fr .

