        skos:definition        "The liquid content of solid precipitation that has accumulated on the ground (snow depth). The accumulation may consist of snow, ice formed by freezing precipitation, freezing liquid precipitation, or ice formed by the refreezing of melted snow. (Source: US National Weather Service Glossary)"@en;
        skos:notation          "SDN:S18::S1800131";
        skos:note              "accepted"@en;
        skos:prefLabel         "liquid water equivalent"@en .

<http://vocab.nerc.ac.uk/collection/S18/current/S1800096/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S18::S1800096";
        dc:date                "2021-08-03 17:05:35.0";
        dc:identifier          "SDN:S18::S1800096";
        pav:authoredOn         "2021-08-03 17:05:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S18/current/S1800096/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S18/current/S1800096/1/> , <http://vocab.nerc.ac.uk/collection/S18/current/S1800096/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "The uppermost layer of water bodies representing a thin boundary layer between the hydrosphere (mainly the ocean) and the atmosphere. It is nominally defined as the top 1000 micrometres (or 1 millimetre) of the water's surface. Some observation methods like e.g. radiometry, distinguish between the skin (upper 10 - 20 micrometres below the air-sea interface) and the subskin (a sub-layer that is at a depth of approximately 1 - 1.5 millimetres below the air-sea interface)."@en;
        skos:notation          "SDN:S18::S1800096";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface microlayer"@en .

