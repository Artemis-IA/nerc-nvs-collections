<http://vocab.nerc.ac.uk/collection/S18/current/S1800162/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S18::S1800162";
        dc:date                "2026-07-16 16:14:40.0";
        dc:identifier          "SDN:S18::S1800162";
        pav:authoredOn         "2026-07-16 16:14:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S18/current/S1800162/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S18/current/S1800162/1/> , <http://vocab.nerc.ac.uk/collection/S18/current/S1800162/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "An amount of water flowing over the crest of a coastal structure (such as a seawall, dike, breakwater etc) due to wave action. Wave overtopping events can be assessed by measuring individual occurences or counts, measuring the volume V per overtopping wave, or by measuring the mean discharge q over a certain time interval and per meter run."@en;
        skos:notation          "SDN:S18::S1800162";
        skos:note              "accepted"@en;
        skos:prefLabel         "wave overtopping events"@en .

<http://vocab.nerc.ac.uk/collection/S18/current/S1800107/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S18::S1800107";
