        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000167/5/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000167/2/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000167/1/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000167/4/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000167/3/>;
