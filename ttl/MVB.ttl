        skos:notation          "SDN:MVB::MVB000320";
        skos:note              "accepted"@en;
        skos:prefLabel         "sequence number"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000483/>
        rdf:type               skos:Concept;
