        skos:notation          "SDN:MVB::MVB000523";
        skos:note              "accepted"@en;
        skos:prefLabel         "animal length"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000078/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000078";
        dc:date                "2021-04-07 19:41:01.0";
        dc:identifier          "SDN:MVB::MVB000078";
        pav:authoredOn         "2021-04-07 19:41:01.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000078/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000078/2/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000078/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "The geographic latitude of the location where the animal was released. Intended primarily for cases in which the animal release location has higher accuracy than that derived from sensor data. Example: '27.3516'; Units: decimal degrees, WGS84 reference system; Entity described: deployment"@en;
        skos:notation          "SDN:MVB::MVB000078";
        skos:note              "accepted"@en;
        skos:prefLabel         "deploy on latitude"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000075/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000075";
        dc:date                "2021-04-07 19:41:01.0";
        dc:identifier          "SDN:MVB::MVB000075";
        pav:authoredOn         "2021-04-07 19:41:01.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000075/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000075/1/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000075/2/>;
