        dc:identifier          "SDN:MVB::MVB000033";
        pav:authoredOn         "2019-10-03 20:36:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000033/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000033/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Solution 2. platform latitude in degrees and thousandths of degrees, Argos diagnostic data (definition from Argos User's Manual 2011). Example: '14.773'; Units: decimal degrees, WGS84 reference system; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000033";
        skos:note              "accepted"@en;
        skos:prefLabel         "Argos lat2"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000423/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000423";
        dc:date                "2024-01-22 10:18:00.0";
        dc:identifier          "SDN:MVB::MVB000423";
        pav:authoredOn         "2024-01-22 10:18:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000423/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The Africa Wildlife Tracking current coverage alarm condition. TRUE indicates no service coverage. Allowed values are TRUE or FALSE (definition from the Africa Wildlife Tracking API User Manual, 2021). Units: none; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000423";
        skos:note              "accepted"@en;
        skos:prefLabel         "AWT alarms coverage"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000105/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000105";
        dc:date                "2022-08-15 10:20:18.0";
        dc:identifier          "SDN:MVB::MVB000105";
        pav:authoredOn         "2022-08-15 10:20:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000105/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000105/3/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000105/1/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000105/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:definition        "The 'switch' value provided by Fleetronic tags. Identifies the action carried out by the tag, relevant for logger performance testing and data filtering (definition from Kris Van Uffelen, Fleetronic, personal communication 2014). Allowed values are 0 = SV_LowestPositionSwitch; 6 = SV_PositionAcceleration; 48 = SV_PowerUp; 49 = SV_InternalStatus1; 64 = SV_Network; 69 = SV_ReceivedSMS; 72 = SV_SettingsAccepted; 77 = SV_TimeAlive; 112 =SV_LcdData1. Format: controlled list; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000105";
        skos:note              "accepted"@en;
        skos:prefLabel         "Flt switch"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000510/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000510";
        dc:date                "2024-10-14 10:18:30.0";
        dc:identifier          "SDN:MVB::MVB000510";
        pav:authoredOn         "2024-10-14 10:18:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000510/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The hourly vector of the dynamic body acceleration (VeDBA) recorded 15 hours before the timestamp. This is calculated as the sum of VeDBA values over 1-second acceleration bursts, recorded at 28 Hz, one time each minute. Example: '60554'; Units: m/s^2; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000510";
        skos:note              "accepted"@en;
        skos:prefLabel         "Tinyfox VeDBA 15h ago"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000320/>
