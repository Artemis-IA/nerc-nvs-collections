<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000327/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000327";
        dc:date                "2026-04-08 09:36:15.0";
        dc:identifier          "SDN:MVB::MVB000327";
        pav:authoredOn         "2026-04-08 09:36:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000327/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000327/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The integer value corresponding to the value in 'Sigfox LQI', the computed link quality based on the received signal strength indicator (RSSI), the number of stations that received a message (receiver redundancy) and the radio configuration (RC) zone, due to the difference between the RCs (definition from Sigfox Support, 2022). Allowed values are 0 = Limit; 1 = Average; 2 = Good; 3 = Excellent; 4 = NA. Format: controlled list; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000327";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sigfox link quality"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/XXXX/> .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000034/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000034";
        dc:date                "2022-08-15 10:20:18.0";
        dc:identifier          "SDN:MVB::MVB000034";
        pav:authoredOn         "2022-08-15 10:20:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000034/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000034/2/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000034/1/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000034/3/>;
