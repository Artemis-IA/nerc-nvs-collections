<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000515/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000515";
        dc:date                "2024-10-14 10:18:31.0";
        dc:identifier          "SDN:MVB::MVB000515";
        pav:authoredOn         "2024-10-14 10:18:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000515/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The hourly vector of the dynamic body acceleration (VeDBA) recorded 20 hours before the timestamp. This is calculated as the sum of VeDBA values over 1-second acceleration bursts, recorded at 28 Hz, one time each minute. Example: '5343'; Units: m/s^2; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000515";
        skos:note              "accepted"@en;
        skos:prefLabel         "Tinyfox VeDBA 20h ago"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000512/>
