        skos:notation          "SDN:MVB::MVB000512";
        skos:note              "accepted"@en;
        skos:prefLabel         "Tinyfox VeDBA 17h ago"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000158/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000158";
