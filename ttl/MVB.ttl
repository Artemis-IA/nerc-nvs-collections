        skos:prefLabel         "Sensolus fix type"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000312/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000312";
        dc:date                "2022-09-23 14:36:33.0";
        dc:identifier          "SDN:MVB::MVB000312";
        pav:authoredOn         "2022-09-23 14:36:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000312/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The text equivalent of 'GMatrix is moving' (definition from RAMAC CALLBACK Specification, v2.0.2, August 2021). Allowed values are MOVING or STATIC. Format: controlled list; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000312";
        skos:note              "accepted"@en;
        skos:prefLabel         "GMatrix is moving text"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000474/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000474";
        dc:date                "2024-10-14 10:18:31.0";
        dc:identifier          "SDN:MVB::MVB000474";
        pav:authoredOn         "2024-10-14 10:18:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000474/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The average current from or to the battery since the previous transmission (definition from Global Satellite Engineeering, 2024). Allowed values are Discharge = battery is discharging (<0 mA); ChargeSlow = low charging (0-8 mA); ChargeMedium = medium charging (8-16 mA); ChargeHigh = high charging (>16 mA). Format: controlled list; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000474";
        skos:note              "accepted"@en;
        skos:prefLabel         "GSAT charge mode"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000437/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000437";
        dc:date                "2024-01-22 10:18:00.0";
        dc:identifier          "SDN:MVB::MVB000437";
        pav:authoredOn         "2024-01-22 10:18:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000437/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The type of GNSS fix as provided by the tag. Common values are 1D = no fix; 2D = altitude typically not valid; 3D = altitude typically valid. Other values might be present. Where possible, use 'GNSS fix type'. Example: '3D'; Units: none; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000437";
        skos:note              "accepted"@en;
        skos:prefLabel         "GNSS fix type raw"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000556/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000556";
        dc:date                "2026-04-08 09:36:14.0";
        dc:identifier          "SDN:MVB::MVB000556";
        pav:authoredOn         "2026-04-08 09:36:14.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000556/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The minimum temperature measured during the measurement interval. Values are stored as raw text values because non-numeric characters are used. Example: '>10'; Units: degrees Celsius; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000556";
        skos:note              "accepted"@en;
        skos:prefLabel         "temperature min text"@en .

<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000028";
        dc:date                "2026-04-08 09:36:15.0";
        dc:identifier          "SDN:MVB::MVB000028";
        pav:authoredOn         "2026-04-08 09:36:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/3/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/1/> , <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:definition        "Calculated frequency, Argos diagnostic data. It should be between 401.620 and 401.680 MHz (definition from Argos User's Manual 2011). The '401.' is sometimes missing from the source data and should be added to the values for correct interpretation. Example: '401.6732709'; Units: MHz; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000028";
        skos:note              "accepted"@en;
        skos:prefLabel         "Argos calcul freq"@en;
        skos:related           <http://qudt.org/vocab/unit/MegaHZ> .

