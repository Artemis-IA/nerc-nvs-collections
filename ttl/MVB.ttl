<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000328/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:MVB::MVB000328";
        dc:date                "2022-09-23 14:36:33.0";
        dc:identifier          "SDN:MVB::MVB000328";
        pav:authoredOn         "2022-09-23 14:36:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000328/1/>;
        pav:version            "1";
