        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The hourly vector of the dynamic body acceleration (VeDBA) recorded 4 hours before the timestamp. This is calculated as the sum of VeDBA values over 1-second acceleration bursts, recorded at 28 Hz, one time each minute. Example: '5343'; Units: m/s^2; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000499";
        skos:note              "accepted"@en;
        skos:prefLabel         "Tinyfox VeDBA 04h ago"@en .

