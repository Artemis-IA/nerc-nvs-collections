        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:definition        "The location class retrieved from Argos, Argos diagnostic data. Classes are based on the type of location (Argos Doppler Shift or GPS) and the number of messages received during the satellite pass. Location classes in order of decreasing accuracy are G (GPS), 3, 2, 1, 0, A, B and Z (definition from Argos User's Manual V1.6.6, 2016). Format: controlled list; Entity described: event"@en;
        skos:notation          "SDN:MVB::MVB000034";
        skos:note              "accepted"@en;
        skos:prefLabel         "Argos LC"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/XXXX/> .

