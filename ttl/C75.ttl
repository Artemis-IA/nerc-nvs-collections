<http://vocab.nerc.ac.uk/collection/C75/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used within the data centre";
        dc:alternative          "Organisations";
        dc:creator              "British Oceanographic Data Centre";
        dc:date                 "2026-08-27 03:00:01.0";
        dc:description          "Concepts used to populate 'organisation' fields in BODC metadata schemas. When used in conjunction with the C75PK group of functions (NMNOW, NMTHEN, NMALL)they provide access to past organisation names. For example, the C75 code 'ISB' translates to 'Proudman Oceanographic Laboratory' for a date in 1995, but to 'National Oceanography Centre, Liverpool' for a date in 2015.";
        dc:license              <https://creativecommons.org/licenses/by/4.0/>;
        dc:publisher            "Natural Environment Research Council";
        dc:title                "BODC Organisation Histories";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "British Oceanographic Data Centre";
