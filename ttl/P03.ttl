        skos:altLabel          "";
        skos:definition        "This APG includes all geochemical and parameters for igneous rocks, metamorphic rocks and high-temperature mineral deposits. Age parameters include parameters relating to both geochemical and stratigraphic techniques."@en;
        skos:notation          "SDN:P03::G025";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Igneous and metamorphic rock geochemistry and geochronology"@en;
