        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P08/current/DS01/> , <http://vocab.nerc.ac.uk/collection/P23/current/MD002/>;
        skos:definition        "This group incorporates all state variables pertaining to microzooplankton, defined as heterotrophic organisms smaller than 200 microns in length. The term covers organisms sometimes referred to as picozooplankton or nanozooplankton.  Most parameters express the abundance, either as cell counts or biomass, of various types of microzooplankton, but may include other properties such as cell volume. Rates (including grazing parameters) and fluxes are not included here (see Rates and Fluxes APGs)."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P02/current/MATC/> , <http://vocab.nerc.ac.uk/collection/P02/current/MZBC/> , <http://vocab.nerc.ac.uk/collection/P02/current/MZBN/> , <http://vocab.nerc.ac.uk/collection/P02/current/MATX/> , <http://vocab.nerc.ac.uk/collection/P02/current/MZCT/> , <http://vocab.nerc.ac.uk/collection/P02/current/A999/> , <http://vocab.nerc.ac.uk/collection/P02/current/V999/>;
        skos:notation          "SDN:P03::B025";
        skos:note              "accepted"@en;
        skos:prefLabel         "Microzooplankton"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P02/current/CYEU/> , <http://vocab.nerc.ac.uk/collection/P02/current/PYTT/> .

