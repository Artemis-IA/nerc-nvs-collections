        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/OD1/current/PIGM/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P08/current/DS01/>;
        skos:definition        "This group incorporates plant pigment concentration parameters and uncalibrated readings from instruments that make in-situ pigment measurements, such as fluorometer voltages.  The grouping includes measurements on pigments in the particulate phase of the water column (expressed as pigment mass per unit volume/mass of water), pigments in sediment (expressed as pigment mass per unit mass or volume of sediment) and zooplankton gut pigment contents (expressed as pigment mass per individual)."@en;
        skos:definition        "Ce groupe incorpore les paramètres de concentration de pigments végétaux et les lectures non calibrées d'instruments faisant des mesures de pigments in-situ, comme les tensions de fluorimètre. Le regroupement inclut les mesures de pigments dans la phase particulaire de la colonne d'eau (exprimées en masse de pigment par unité de volume/masse d'eau), les pigments dans les sédiments (exprimés en masse de pigment par unité de masse ou volume de sédiment) et les teneurs en pigments intestinaux du zooplancton (exprimées en masse de pigment par individu)."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/> , <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P02/current/STGC/> , <http://vocab.nerc.ac.uk/collection/P02/current/PHSD/> , <http://vocab.nerc.ac.uk/collection/P02/current/OPWC/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPCN/> , <http://vocab.nerc.ac.uk/collection/P02/current/PHWC/> , <http://vocab.nerc.ac.uk/collection/P02/current/PHYC/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPSD/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPWC/> , <http://vocab.nerc.ac.uk/collection/P02/current/AXFX/> , <http://vocab.nerc.ac.uk/collection/P02/current/CARO/> , <http://vocab.nerc.ac.uk/collection/P02/current/GPIG/> , <http://vocab.nerc.ac.uk/collection/P02/current/FVLT/> , <http://vocab.nerc.ac.uk/collection/P02/current/CARS/>;
        skos:notation          "SDN:P03::B035";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pigments"@en;
        skos:prefLabel         "Pigments"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P02/current/CMFL/> , <http://vocab.nerc.ac.uk/collection/P23/current/MD002/> .

