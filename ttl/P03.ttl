        skos:definition        "This group contains all parameters relating to the composition of organisms or their constituent parts. It may include any analytical measurements on biological material, but is specifically designed for heavy metal and organic contaminant biota pollution monitoring data."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P02/current/GP013/> , <http://vocab.nerc.ac.uk/collection/P02/current/INVD/> , <http://vocab.nerc.ac.uk/collection/OD1/current/BIOTOX/> , <http://vocab.nerc.ac.uk/collection/P02/current/BCPB/> , <http://vocab.nerc.ac.uk/collection/P02/current/BCMT/> , <http://vocab.nerc.ac.uk/collection/P02/current/PTOX/> , <http://vocab.nerc.ac.uk/collection/P02/current/BCOS/> , <http://vocab.nerc.ac.uk/collection/P02/current/BABI/> , <http://vocab.nerc.ac.uk/collection/P02/current/LIBI/> , <http://vocab.nerc.ac.uk/collection/P02/current/BCOC/> , <http://vocab.nerc.ac.uk/collection/P02/current/PHBI/> , <http://vocab.nerc.ac.uk/collection/P02/current/IRBO/> , <http://vocab.nerc.ac.uk/collection/P02/current/PEBI/> , <http://vocab.nerc.ac.uk/collection/P02/current/OMBI/> , <http://vocab.nerc.ac.uk/collection/P02/current/BRAD/> , <http://vocab.nerc.ac.uk/collection/P02/current/MDBO/> , <http://vocab.nerc.ac.uk/collection/P02/current/BCAH/>;
