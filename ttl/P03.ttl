        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P08/current/DS08/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "This APG contains parameters related to the characterisation of the land surface. These are usually, but not exclusively, determined by remote sensing techniques. Data types falling within the scope of the group are:   Land surface temperature  Land vegetation  Vertical currents  Terrestrial water content  Terrestrial mapping and the geo-location of features such as coastlines"@en;
        skos:definition        "Cet APG contient les paramètres relatifs à la caractérisation de la surface terrestre. Ils sont généralement, mais pas exclusivement, déterminés par des techniques de télédétection. Les types de données relevant de ce groupe sont : température de surface terrestre ; végétation terrestre ; courants verticaux ; teneur en eau terrestre ; cartographie terrestre et géolocalisation de caractéristiques comme les littoraux"@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/> , <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P02/current/GWAM/> , <http://vocab.nerc.ac.uk/collection/P02/current/COAS/> , <http://vocab.nerc.ac.uk/collection/P02/current/LSST/> , <http://vocab.nerc.ac.uk/collection/P02/current/LWET/> , <http://vocab.nerc.ac.uk/collection/P02/current/LVEG/> , <http://vocab.nerc.ac.uk/collection/P02/current/GWCH/> , <http://vocab.nerc.ac.uk/collection/P02/current/COGE/>;
        skos:notation          "SDN:P03::T001";
        skos:note              "accepted"@en;
        skos:prefLabel         "Terrestrial"@en;
        skos:prefLabel         "terrestre"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P02/current/MBAN/> , <http://vocab.nerc.ac.uk/collection/P23/current/MD001/> .

