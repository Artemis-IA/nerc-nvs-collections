<http://vocab.nerc.ac.uk/collection/P03/current/D010/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P03::D010";
        dc:date                "2006-06-28 08:15:00.0";
        dc:identifier          "SDN:P03::D010";
        pav:authoredOn         "2006-06-28 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P03/current/D010/1/>;
