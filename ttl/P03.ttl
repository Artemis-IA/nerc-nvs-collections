        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "This APG contains all parameters pertaining to the measurement of:   Eulerian currents  Lagrangian currents (except drifter position)  Vertical currents  River flow velocity  Wave height  Wave period  Wave direction  Wave energy spectra  Sea level relative to a terrestrial datum  Water column height at a fixed location"@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P03/current/D030/> , <http://vocab.nerc.ac.uk/collection/P03/current/D034/> , <http://vocab.nerc.ac.uk/collection/P03/current/D032/>;
        skos:notation          "SDN:P03::D010";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Currents, sea level and waves"@en .

<http://vocab.nerc.ac.uk/collection/P03/current/G020/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P03::G020";
        dc:date                "2007-09-24 10:49:24.0";
        dc:identifier          "SDN:P03::G020";
        pav:authoredOn         "2007-09-24 10:49:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P03/current/G020/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "This APG covers geochemical and age data collected from fully lithified sediments (i.e. sedimentary rocks), water-deposited minerals (e.g. tufa and speleothems) and hard biological deposits (e.g. coral reefs). The group includes both geochemical and stratigraphic geochronological parameters"@en;
        skos:notation          "SDN:P03::G020";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Sedimentary rock geochemistry and geochronology"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P03/current/G035/> , <http://vocab.nerc.ac.uk/collection/P03/current/G030/> .

<http://vocab.nerc.ac.uk/collection/P03/current/B040/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P03::B040";
        dc:date                "2007-09-24 10:49:24.0";
        dc:identifier          "SDN:P03::B040";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P03/current/G055/>;
        pav:authoredOn         "2007-09-24 10:49:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P03/current/B040/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "This group contains state variables for animals, other than fish, that live on the sea floor or in the sediment.  Most parameters pertain to the abundance, expressed as numbers or biomass per unit area of sea floor, of species, genera or less rigorous groupings of animals. However any other properties of these entities that are  not rates or fluxes  could be included."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P02/current/STGC/>;
        skos:notation          "SDN:P03::B040";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Zoobenthos"@en .

<http://vocab.nerc.ac.uk/collection/P03/current/G010/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P03::G010";
        dc:date                "2007-09-24 10:49:24.0";
        dc:identifier          "SDN:P03::G010";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P03/current/G040/>;
        pav:authoredOn         "2007-09-24 10:49:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P03/current/G010/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "This group includes parameters pertaining to the physical properties of sediment. 'Sediment' can include both bottom and suspended particulate material if the property is equally applicable whether or not the sediment is in suspension.  This category will inevitably end up as a 'catch all' for sediment parameters that cannot be mapped to other APGs, and consequently its composition should be periodically reviewed. The BODC Parameter Dictionary currently (May 2003) includes the following types of parameter in this grouping:   Sediment cohesive strength (e.g. erosion stress and shear velocity).  Mineralogy (including organic matter content).  Dating and accumulation rate.  Porosity and water content  Grain size and density.  Magnetic susceptibility and resistivity."@en;
        skos:notation          "SDN:P03::G010";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Sediment properties"@en .

<http://vocab.nerc.ac.uk/collection/P03/current/G025/>
        rdf:type               skos:Concept;
