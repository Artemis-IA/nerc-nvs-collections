<http://vocab.nerc.ac.uk/collection/P03/current/B025/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P03::B025";
        dc:date                "2003-06-10 15:23:21.0";
        dc:identifier          "SDN:P03::B025";
        pav:authoredOn         "2003-06-10 15:23:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P03/current/B025/1/>;
