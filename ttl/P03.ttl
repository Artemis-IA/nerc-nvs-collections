        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P08/current/DS03/> , <http://vocab.nerc.ac.uk/collection/P23/current/MD005/>;
        skos:definition        "This APG includes the parameters associated with the in-situ measurement of water column temperature (including potential temperature) and salinity (including conductivity).  Parameters derived from either temperature or salinity (but not temperature AND salinity), such as temperature gradient or temperature variance, are also included."@en;
        skos:definition        "Cet APG inclut les paramètres associés à la mesure in-situ de la température (incluant la température potentielle) et de la salinité (incluant la conductivité) de la colonne d'eau. Les paramètres dérivés soit de la température soit de la salinité (mais pas de température ET salinité), comme le gradient de température ou la variance de température, sont aussi inclus."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/> , <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P02/current/PSAL/> , <http://vocab.nerc.ac.uk/collection/P02/current/PTDZ/> , <http://vocab.nerc.ac.uk/collection/P02/current/TEMP/> , <http://vocab.nerc.ac.uk/collection/P02/current/PSST/> , <http://vocab.nerc.ac.uk/collection/P02/current/CNDC/> , <http://vocab.nerc.ac.uk/collection/P02/current/TCNT/> , <http://vocab.nerc.ac.uk/collection/OD1/current/SEATEMP/> , <http://vocab.nerc.ac.uk/collection/OD1/current/SAL/>;
        skos:notation          "SDN:P03::D025";
        skos:note              "accepted"@en;
        skos:prefLabel         "Water column temperature and salinity"@en ;
        skos:prefLabel         "Température et salinité de la colonne d'eau"@fr .

