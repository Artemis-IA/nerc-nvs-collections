<http://vocab.nerc.ac.uk/collection/C41/current/PEST06/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C41::PEST06";
        dc:date                "2009-09-29 11:44:57.0";
        dc:identifier          "SDN:C41::PEST06";
        pav:authoredOn         "2009-09-29 11:44:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C41/current/PEST06/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A discharge from temporary structure from land into the sea (e.g. oil washed into the sea from a jetty or promenade)"@en;
        skos:notation          "SDN:C41::PEST06";
        skos:note              "accepted"@en;
        skos:prefLabel         "Temporary Coastal Discharge"@en .

