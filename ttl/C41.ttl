<http://vocab.nerc.ac.uk/collection/C41/current/PEST07/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C41::PEST07";
        dc:date                "2009-09-29 11:44:57.0";
        dc:identifier          "SDN:C41::PEST07";
        pav:authoredOn         "2009-09-29 11:44:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C41/current/PEST07/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A discharge from a fixed structure permanently connected to land into the sea (e.g. a sewage outfall or industrial pipe discharge)"@en;
        skos:definition        "Un rejet depuis une structure fixe définitivement connectée au continent vers la mer (par ex. un émissaire d'eaux usées ou un rejet de canalisation industrielle)."@fr ;
        skos:notation          "SDN:C41::PEST07";
        skos:note              "accepted"@en;
        skos:prefLabel         "Fixed Coastal Discharge"@en ;
        skos:prefLabel         "rejet côtier fixe"@fr .

