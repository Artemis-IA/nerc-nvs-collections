<http://vocab.nerc.ac.uk/collection/C41/current/PEST02/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C41::PEST02";
        dc:date                "2009-09-29 11:44:57.0";
        dc:identifier          "SDN:C41::PEST02";
        pav:authoredOn         "2009-09-29 11:44:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C41/current/PEST02/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A large platform operating on the surface of the water column. Objective definitions for guidelines: >50m length (EU),"@en;
        skos:definition        "Une grande plateforme opérant à la surface de la colonne d'eau. Définitions objectives pour les directives : longueur >50 m (UE)."@fr ;
        skos:notation          "SDN:C41::PEST02";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ship"@en ;
        skos:prefLabel         "navire"@fr .

<http://vocab.nerc.ac.uk/collection/C41/current/PEST03/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C41::PEST03";
        dc:date                "2009-09-29 11:44:57.0";
        dc:identifier          "SDN:C41::PEST03";
        pav:authoredOn         "2009-09-29 11:44:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C41/current/PEST03/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A platform operating on the surface of the water column whose primary purpose is the commercial harevsting of fish or shellfish but may be engaged in scientific activities such as fish stock surveys or mooring deployments and recoveries"@en;
        skos:definition        "Une plateforme opérant à la surface de la colonne d'eau dont l'objectif principal est la pêche commerciale de poissons ou de crustacés, mais qui peut être engagée dans des activités scientifiques telles que des campagnes d'évaluation des stocks de poissons ou des déploiements et récupérations de mouillages."@fr ;
        skos:notation          "SDN:C41::PEST03";
        skos:note              "accepted"@en;
        skos:prefLabel         "Fishing Vessel"@en ;
        skos:prefLabel         "navire de pêche"@fr .

