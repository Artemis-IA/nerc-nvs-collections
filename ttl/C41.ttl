        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The correct value is not known to, and not computable by, the creator of this information. However, a correct value probably exists."@en;
        skos:definition        "La valeur correcte n'est pas connue du, et pas calculable par, le créateur de cette information. Cependant, une valeur correcte existe probablement."@fr ;
        skos:notation          "SDN:C41::PESTUK";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unknown"@en ;
        skos:prefLabel         "inconnu"@fr .

