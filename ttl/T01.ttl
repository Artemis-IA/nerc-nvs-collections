<http://vocab.nerc.ac.uk/collection/T01/current/422b2d9b-ad7f-4bf0-a24f-6902c59476e6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:T01::422b2d9b-ad7f-4bf0-a24f-6902c59476e6";
        dc:date                "2020-05-05 18:24:43.0";
        dc:identifier          "SDN:T01::422b2d9b-ad7f-4bf0-a24f-6902c59476e6";
        pav:authoredOn         "2020-05-05 18:24:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/T01/current/422b2d9b-ad7f-4bf0-a24f-6902c59476e6/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Exploring the climate history and the geological structure and evolution of the rocks and mountains of Antarctica\uFFFDs continental interior provides clues to past, present and future environmental change. Under-ice lakes, mountain chains buried by up to 4km ice, and sea bed sediments surrounding the frozen continent provide an unparalleled record of how the Earth\uFFFDs climate has changed over millions of years.\""@en;
        skos:definition        "Explorer l'histoire climatique et la structure géologique et l'évolution des roches et montagnes de l'intérieur continental de l'Antarctique fournit des indices sur les changements environnementaux passés, présents et futurs. Les lacs sous-glaciaires, les chaînes de montagnes enfouies sous jusqu'à 4 km de glace et les sédiments du fond marin entourant le continent gelé fournissent un record sans équivalent de la façon dont le climat de la Terre a changé au cours de millions d'années."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/T01/current/4699a644-d301-4a19-8905-1ec7ed5d9f2a/> , <http://vocab.nerc.ac.uk/collection/T01/current/e9787b4f-5f02-43fd-b7df-6c42f56c73b8/> , <http://vocab.nerc.ac.uk/collection/T01/current/fdc34522-8acd-465b-ba29-a274ccf8387f/> , <http://vocab.nerc.ac.uk/collection/T01/current/941b094d-7ac1-427f-b036-7e3d84bc18ad/> , <http://vocab.nerc.ac.uk/collection/T01/current/819c734d-0a8b-482b-9a75-626b37d47a30/> , <http://vocab.nerc.ac.uk/collection/T01/current/32f79e96-7ff6-43ca-b190-830e6883c720/> , <http://vocab.nerc.ac.uk/collection/T01/current/90c2f761-3f77-4824-b0d2-e287d8f07b71/> , <http://vocab.nerc.ac.uk/collection/T01/current/83bb7454-a57c-4007-8b51-512d26e61e1a/> , <http://vocab.nerc.ac.uk/collection/T01/current/d7ca6194-fb70-4e3d-b7e9-35b046e49b12/>;
        skos:notation          "SDN:T01::422b2d9b-ad7f-4bf0-a24f-6902c59476e6";
        skos:note              "accepted"@en;
        skos:prefLabel         "Geosciences"@en ;
        skos:prefLabel         "géosciences"@fr .

