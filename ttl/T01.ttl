<http://vocab.nerc.ac.uk/collection/T01/current/d71ecb83-959c-4703-a70a-a2ff6b07b424/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:T01::d71ecb83-959c-4703-a70a-a2ff6b07b424";
        dc:date                "2020-05-05 18:24:43.0";
        dc:identifier          "SDN:T01::d71ecb83-959c-4703-a70a-a2ff6b07b424";
        pav:authoredOn         "2020-05-05 18:24:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/T01/current/d71ecb83-959c-4703-a70a-a2ff6b07b424/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Antarctica is a natural laboratory for studying the small number of plant and animal species that live in communities. Microbial life, invisible to the naked eye, plays a vital role in Antarctic ecosystems. State-of-the-art genetic methods to study the DNA of these microbes may lead to discoveries that could help in the production of new antibiotics and other compounds.\""@en;
        skos:definition        "L'Antarctique est un laboratoire naturel pour étudier le petit nombre d'espèces animales et végétales qui vivent en communautés. La vie microbienne, invisible à l'œil nu, joue un rôle vital dans les écosystèmes antarctiques. Des méthodes génétiques de pointe pour étudier l'ADN de ces microbes peuvent mener à des découvertes qui pourraient aider à la production de nouveaux antibiotiques et autres composés."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/T01/current/2fcb6256-cf93-41a9-ab48-eee253218835/> , <http://vocab.nerc.ac.uk/collection/T01/current/e92c10de-b259-4e29-91ac-ffa94734495a/> , <http://vocab.nerc.ac.uk/collection/T01/current/fc65299b-a133-4310-98d3-634b3169df77/> , <http://vocab.nerc.ac.uk/collection/T01/current/d13eb78f-2e2f-4cd6-89c3-ea7a44474405/> , <http://vocab.nerc.ac.uk/collection/T01/current/b2b73853-8f45-4ca6-9cd4-a12801a45251/> , <http://vocab.nerc.ac.uk/collection/T01/current/a8cab4d1-89a7-4fdf-817a-a62d56934ae7/> , <http://vocab.nerc.ac.uk/collection/T01/current/bebe7930-81e5-4110-a618-c9fe049c02af/> , <http://vocab.nerc.ac.uk/collection/T01/current/cd819959-57eb-4542-bf4a-1cd1de4dbd78/> , <http://vocab.nerc.ac.uk/collection/T01/current/b7c659fc-be17-4942-bb6b-b3d661d4949e/> , <http://vocab.nerc.ac.uk/collection/T01/current/04704e3e-136d-4d8e-9068-7d323ac71a2f/>;
        skos:notation          "SDN:T01::d71ecb83-959c-4703-a70a-a2ff6b07b424";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ecology & biodiversity"@en ;
        skos:prefLabel         "écologie et biodiversité"@fr .

