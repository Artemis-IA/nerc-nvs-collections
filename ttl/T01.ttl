<http://vocab.nerc.ac.uk/collection/T01/current/966ecbc2-2c6f-4a77-bc74-8feef073592b/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:T01::966ecbc2-2c6f-4a77-bc74-8feef073592b";
        dc:date                "2020-05-05 18:24:43.0";
        dc:identifier          "SDN:T01::966ecbc2-2c6f-4a77-bc74-8feef073592b";
        pav:authoredOn         "2020-05-05 18:24:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/T01/current/966ecbc2-2c6f-4a77-bc74-8feef073592b/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Understanding Antarctic and Arctic marine ecosystems by exploring biodiversity and resilience to environmental change is critical for making policy decisions that will lead to effective stewardship and sustainable management of marine resources. This strand of research combines existing long-term data with new field-based and experimental observations to explore the impact of environmental change on marine ecosystems."@en;
        skos:definition        "Comprendre les écosystèmes marins antarctiques et arctiques en explorant la biodiversité et la résilience au changement environnemental est essentiel pour prendre des décisions politiques qui mèneront à une gestion efficace et durable des ressources marines. Ce domaine de recherche combine les données à long terme existantes avec de nouvelles observations de terrain et expérimentales pour explorer l'impact du changement environnemental sur les écosystèmes marins."@fr ;
        skos:notation          "SDN:T01::966ecbc2-2c6f-4a77-bc74-8feef073592b";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marine ecosystems"@en ;
        skos:prefLabel         "écosystèmes marins"@fr .

