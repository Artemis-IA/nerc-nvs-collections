        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The scientific evidence that the world's climate is changing is extensive and clear. Understanding the role of the Polar Regions in climate change is not only a huge scientific challenge but also an urgent priority for society."@en;
        skos:definition        "Les preuves scientifiques que le climat mondial change sont abondantes et claires. Comprendre le rôle des régions polaires dans le changement climatique n'est pas seulement un immense défi scientifique mais aussi une priorité urgente pour la société."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/T01/current/df2715b7-ddb0-4972-b69a-90a564ce9fc1/> , <http://vocab.nerc.ac.uk/collection/T01/current/d015a980-7491-4fba-b21c-d840ab724c48/> , <http://vocab.nerc.ac.uk/collection/T01/current/c309f4f6-f8f3-4975-9704-93f820507e08/> , <http://vocab.nerc.ac.uk/collection/T01/current/78ce8379-392a-4722-9f4f-3f3a775eed05/>;
        skos:notation          "SDN:T01::3fee104a-1601-49bf-92db-75b521960307";
        skos:note              "accepted"@en;
        skos:prefLabel         "Climate & climate change"@en ;
        skos:prefLabel         "climat et changement climatique"@fr .

