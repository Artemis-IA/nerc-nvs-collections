<http://vocab.nerc.ac.uk/collection/T01/current/12254fa9-710f-4b6b-b7dd-f834d11e60a1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:T01::12254fa9-710f-4b6b-b7dd-f834d11e60a1";
        dc:date                "2020-05-05 18:24:43.0";
        dc:identifier          "SDN:T01::12254fa9-710f-4b6b-b7dd-f834d11e60a1";
        pav:authoredOn         "2020-05-05 18:24:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/T01/current/12254fa9-710f-4b6b-b7dd-f834d11e60a1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Polar oceans influence the entire Earth System in all areas, including the seas around the UK. The polar oceans have an enormous capacity to store and redistribute fresh water, heat, carbon dioxide and other climatically-important substances. Oceanographic studies help make more accurate predictions about global impacts.\""@en;
        skos:definition        "Les océans polaires influencent l'ensemble du système Terre dans tous les domaines, y compris les mers autour du Royaume-Uni. Les océans polaires ont une capacité énorme de stocker et de redistribuer l'eau douce, la chaleur, le dioxyde de carbone et d'autres substances climatiquement importantes. Les études océanographiques aident à faire des prévisions plus précises sur les impacts mondiaux."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/T01/current/852cee3f-42ed-45f1-875a-15b0f7170ff9/> , <http://vocab.nerc.ac.uk/collection/T01/current/b6ef5628-8959-4053-825b-452110abad6d/> , <http://vocab.nerc.ac.uk/collection/T01/current/c5ddf381-aa4b-4538-baf4-f47be392a8d8/> , <http://vocab.nerc.ac.uk/collection/T01/current/7a7193f4-7826-4abf-b8d2-c56ff209fb2b/> , <http://vocab.nerc.ac.uk/collection/T01/current/1ca730cc-753e-4fed-b7dd-b23ec0f8930d/>;
        skos:notation          "SDN:T01::12254fa9-710f-4b6b-b7dd-f834d11e60a1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Oceanography"@en ;
        skos:prefLabel         "océanographie"@fr .

