<http://vocab.nerc.ac.uk/collection/R27/current/ISUS_V3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::ISUS_V3";
        dc:date                "2021-08-09 12:23:38.0";
        dc:identifier          "SDN:R27::ISUS_V3";
        pav:authoredOn         "2021-08-09 12:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/ISUS_V3/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ISUS_V3";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SATLANTIC/>;
        skos:definition        "A sensor using ultraviolet absorption spectroscopy to measure in-situ nitrate (NO3) concentration in real time. A deuterium lamp provides a light source of 1 cm path length in the 200 nm - 400 nm wavelength range. Measurement accuracy: +/- 2 umol/l; detection range: 0.5 umol/l to 2000 umol/l. The instrument is depth-rated to 1000 m; it is based on the MBARI-ISUS-X v.2, and was manufactured at Satlantic."@en;
        skos:definition        "Un capteur utilisant la spectroscopie d'absorption ultraviolette pour mesurer en temps réel la concentration en nitrate (NO3) in situ. Une lampe à deutérium fournit une source lumineuse d'une longueur de trajet de 1 cm dans la gamme de longueurs d'onde 200 nm - 400 nm. Précision de mesure : +/- 2 µmol/l ; plage de détection : 0,5 µmol/l à 2000 µmol/l. L'instrument est classé pour 1000 m ; il est basé sur le MBARI-ISUS-X v.2 et a été fabriqué par Satlantic."@fr ;
        skos:notation          "SDN:R27::ISUS_V3";
        skos:note              "accepted"@en;
        skos:prefLabel         "Satlantic In Situ Ultraviolet Spectrophotometer (ISUS) V3 nitrate sensor"@en;
        skos:prefLabel         "Capteur de nitrate Satlantic In Situ Ultraviolet Spectrophotometer (ISUS) V3"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/SPECTROPHOTOMETER_NITRATE/> .

