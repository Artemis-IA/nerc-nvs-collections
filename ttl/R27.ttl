<http://vocab.nerc.ac.uk/collection/R27/current/AANDERAA_OPTODE_4330/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::AANDERAA_OPTODE_4330";
        dc:date                "2021-05-26 09:01:46.0";
        dc:identifier          "SDN:R27::AANDERAA_OPTODE_4330";
        pav:authoredOn         "2021-05-26 09:01:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/AANDERAA_OPTODE_4330/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "AANDERAA_OPTODE_4330";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/AANDERAA/>;
        skos:definition        "A stand-alone oxygen optode with integrated temperature sensor, manufactured by Aanderaa. This instrument exploits the physio-chemical principle of dynamic fluorescence quenching to measure absolute oxygen concentration and percent saturation. Depth rating: 300 m, 3000 m, 6000 m or 12000 m; oxygen concentration accuracy of < 2 uM or 1.5 %, and resolution of < 0.1 uM; air saturation accuracy of < 1.5 %, and resolution of 0.05 %; response time (63 %): < 25 s."@en;
        skos:definition        "Optode à oxygène autonome avec capteur de température intégré, fabriqué par Aanderaa. Cet instrument exploite le principe physico-chimique de l'extinction dynamique de fluorescence pour mesurer la concentration absolue en oxygène et le pourcentage de saturation. Profondeur nominale : 300 m, 3000 m, 6000 m or 12000 m ; précision de concentration en oxygène de < 2 uM or 1.5 %, et résolution de < 0.1 uM ; précision de saturation en air de < 1.5 %, et résolution de 0.05 % ; temps de réponse (63 %) : < 25 s."@fr ;
        skos:notation          "SDN:R27::AANDERAA_OPTODE_4330";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa 4330 oxygen optode"@en;
        skos:prefLabel         "Optode à oxygène Aanderaa 4330"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/OPTODE_DOXY/> .

<http://vocab.nerc.ac.uk/collection/R27/current/AANDERAA_OPTODE_4831F/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::AANDERAA_OPTODE_4831F";
        dc:date                "2021-05-26 09:01:46.0";
        dc:identifier          "SDN:R27::AANDERAA_OPTODE_4831F";
        pav:authoredOn         "2021-05-26 09:01:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/AANDERAA_OPTODE_4831F/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "AANDERAA_OPTODE_4831F";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/AANDERAA/>;
        skos:definition        "A stand-alone oxygen optode with integrated temperature sensor, manufactured by Aanderaa. This instrument exploits the physio-chemical principle of dynamic fluorescence quenching to measure absolute oxygen concentration and percent saturation. Depth rating: 300 m, 3000 m or 6000 m; oxygen concentration accuracy of < 8 uM or 5 %, and resolution of < 1 uM; air saturation accuracy of < 5 %, and resolution of 0.4 %; response time (63 %): < 8 s."@en;
        skos:definition        "Optode à oxygène autonome avec capteur de température intégré, fabriqué par Aanderaa. Cet instrument exploite le principe physico-chimique de l'extinction dynamique de fluorescence pour mesurer la concentration absolue en oxygène et le pourcentage de saturation. Profondeur nominale : 300 m, 3000 m or 6000 m ; précision de concentration en oxygène de < 8 uM or 5 %, et résolution de < 1 uM ; précision de saturation en air de < 5 %, et résolution de 0.4 % ; temps de réponse (63 %) : < 8 s."@fr ;
