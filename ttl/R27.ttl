        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/MCOMS_FLBBCD/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MCOMS_FLBBCD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/> , <http://vocab.nerc.ac.uk/collection/R26/current/WETLABS/>;
        skos:definition        "A three-channel optical sensor fitted with two single-wavelength fluorometers and a single-angle scattering meter. The two fluorometers are configured to detect chlorophyll-a fluorescence at 470 nm (excitation) / 695 nm (emission) wavelengths and Fluorescent Dissolved Organic Matter (FDOM) at 370 nm (excitation) / 460 nm (emission) wavelengths respectively, whereas the scattering meter (in-water centroid angle of 150 deg) is configured to measure backscattering at 700 nm wavelength. The instrument is part of the Environmental Characterization Optics (ECO) series tools, originally developed and manufactured at WET Labs and rebranded as a Sea-Bird Scientific product following the company's acquisition by Danaher in 2010."@en;
        skos:definition        "Un capteur optique trois canaux équipé de deux fluorimètres monochromatiques et d'un diffusimètre à angle unique. Les deux fluorimètres sont configurés pour détecter respectivement la fluorescence de la chlorophylle-a aux longueurs d'onde 470 nm (excitation) / 695 nm (émission) et la matière organique dissoute fluorescente (FDOM) aux longueurs d'onde 370 nm (excitation) / 460 nm (émission), tandis que le diffusimètre (angle centroïde dans l'eau de 150 deg) est configuré pour mesurer la rétrodiffusion à la longueur d'onde 700 nm. L'instrument fait partie de la série d'outils Environmental Characterization Optics (ECO), développé à l'origine et fabriqué par WET Labs, puis rebaptisé produit Sea-Bird Scientific suite à l'acquisition de l'entreprise par Danaher en 2010."@fr ;
        skos:notation          "SDN:R27::MCOMS_FLBBCD";
        skos:note              "accepted"@en;
        skos:prefLabel         "MCOMS FLBBCD sensor package with two fluorometers and one scattering meter"@en;
        skos:prefLabel         "Ensemble de capteurs MCOMS FLBBCD avec deux fluorimètres et un diffusimètre"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/FLUOROMETER_CDOM/> , <http://vocab.nerc.ac.uk/collection/R25/current/BACKSCATTERINGMETER_BBP700/> , <http://vocab.nerc.ac.uk/collection/R25/current/FLUOROMETER_CHLA/> .

<http://vocab.nerc.ac.uk/collection/R27/current/ECO_FLBB_AP2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::ECO_FLBB_AP2";
        dc:date                "2026-10-23 10:41:15.0";
        dc:identifier          "SDN:R27::ECO_FLBB_AP2";
        pav:authoredOn         "2026-10-23 10:41:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/ECO_FLBB_AP2/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R27/current/ECO_FLBB_AP2/1/> , <http://vocab.nerc.ac.uk/collection/R27/current/ECO_FLBB_AP2/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "ECO_FLBB_AP2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/> , <http://vocab.nerc.ac.uk/collection/R26/current/WETLABS/>;
        skos:definition        "A dual-channel optical sensor fitted with a single-wavelength fluorometer and a scattering meter calibrated to determine backscattering, depth-rated to 2000 m and designed for float applications. The sensor operates by flashing blue (470 nm) and red (700 nm) beams in alternation from two light-emitting diodes (LEDs), to respectively stimulate chlorophyll fluorescence and illuminate the total particle field. The scattering sensor has an in-water centroid angle of 142 deg. The instrument is part of the Environmental Characterization Optics (ECO) series tools, originally developed and manufactured at WET Labs and rebranded as a Sea-Bird Scientific product following the company's acquisition by Danaher in 2010. The sensor is fitted on an APEX float. This sensor has no instrumental differences (filters, LEDs, geometry, etc.) compared to the ECO_FLBB version."@en;
        skos:definition        "Un capteur optique deux canaux équipé d'un fluorimètre monochromatique et d'un diffusimètre calibré pour déterminer la rétrodiffusion, classé pour 2000 m et conçu pour les applications sur flotteurs. Le capteur fonctionne en émettant alternativement des faisceaux bleus (470 nm) et rouges (700 nm) depuis deux diodes électroluminescentes (LED), pour stimuler respectivement la fluorescence de la chlorophylle et éclairer le champ particulaire total. Le capteur de diffusion a un angle centroïde dans l'eau de 142 deg. L'instrument fait partie de la série d'outils Environmental Characterization Optics (ECO), développé à l'origine et fabriqué par WET Labs, puis rebaptisé produit Sea-Bird Scientific suite à l'acquisition de l'entreprise par Danaher en 2010. Le capteur est monté sur un flotteur APEX. Ce capteur ne présente aucune différence instrumentale (filtres, LED, géométrie, etc.) par rapport à la version ECO_FLBB."@fr ;
        skos:notation          "SDN:R27::ECO_FLBB_AP2";
        skos:note              "accepted"@en;
        skos:prefLabel         "ECO FLbb-AP2 sensor package with fluorometer and scattering meter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/R27/current/ECO_FLBB/> , <http://vocab.nerc.ac.uk/collection/R25/current/BACKSCATTERINGMETER_BBP700/> , <http://vocab.nerc.ac.uk/collection/R25/current/FLUOROMETER_CHLA/> .

<http://vocab.nerc.ac.uk/collection/R27/current/ECO_FLBB2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::ECO_FLBB2";
        dc:date                "2021-08-09 12:23:38.0";
        dc:identifier          "SDN:R27::ECO_FLBB2";
        pav:authoredOn         "2021-08-09 12:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/ECO_FLBB2/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ECO_FLBB2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/WETLABS/> , <http://vocab.nerc.ac.uk/collection/R26/current/SBE/>;
        skos:definition        "A three optical-sensor instrument fitted with one fluorometer and two scattering meters, depth-rated to 600 m. The fluorometer is configured to detect chlorophyll-a fluorescence at 470 nm (excitation) / 695 nm (emission) wavelengths, whereas the two scattering meters (in-water centroid angle of 124 deg) can be configured to measure backscattering at a user-defined choice of 470 nm, 532 nm, 650 nm or 700 nm each. The instrument is part of the Environmental Characterization Optics (ECO) series tools, originally developed and manufactured at WET Labs and rebranded as a Sea-Bird Scientific product following the company's acquisition by Danaher in 2010."@en;
        skos:definition        "Un instrument à trois capteurs optiques équipé d'un fluorimètre et de deux diffusimètres, classé pour 600 m. Le fluorimètre est configuré pour détecter la fluorescence de la chlorophylle-a aux longueurs d'onde 470 nm (excitation) / 695 nm (émission), tandis que les deux diffusimètres (angle centroïde dans l'eau de 124 deg) peuvent être configurés pour mesurer la rétrodiffusion à 470 nm, 532 nm, 650 nm ou 700 nm au choix de l'utilisateur. L'instrument fait partie de la série d'outils Environmental Characterization Optics (ECO), développé à l'origine et fabriqué par WET Labs, puis rebaptisé produit Sea-Bird Scientific suite à l'acquisition de l'entreprise par Danaher en 2010."@fr ;
        skos:notation          "SDN:R27::ECO_FLBB2";
        skos:note              "accepted"@en;
        skos:prefLabel         "ECO FLBB2 sensor package with one fluorometer and two scattering meters"@en;
        skos:prefLabel         "Ensemble de capteurs ECO FLBB2 avec un fluorimètre et deux diffusimètres"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/BACKSCATTERINGMETER_BBP532/> , <http://vocab.nerc.ac.uk/collection/R25/current/BACKSCATTERINGMETER_BBP700/> , <http://vocab.nerc.ac.uk/collection/R25/current/BACKSCATTERINGMETER_BBP470/> , <http://vocab.nerc.ac.uk/collection/R25/current/FLUOROMETER_CHLA/> .

<http://vocab.nerc.ac.uk/collection/R27/current/SUNA_V2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::SUNA_V2";
        dc:date                "2021-08-19 11:48:30.0";
        dc:identifier          "SDN:R27::SUNA_V2";
        pav:authoredOn         "2021-08-19 11:48:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/SUNA_V2/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R27/current/SUNA_V2/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "SUNA_V2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/> , <http://vocab.nerc.ac.uk/collection/R26/current/SATLANTIC/>;
        skos:definition        "A sensor using ultraviolet absorption spectroscopy to measure in-situ nitrate (NO3) concentration in real time and over clear to high turbidity/suspended sedimentation waters, depth-rated to 500 m. A deuterium lamp provides a light source of 10 mm path length (or 5 mm for high turbidity conditions); the measured spectrum falls within the Ultraviolet (UV) 190 nm - 370 nm wavelength range. The instrument is based on the MBARI-ISUS technology; it was originally developed and manufactured at Satlantic, and was rebranded as a Sea-Bird Scientific product following the company's acquisition by Danaher in 2011."@en;
        skos:definition        "Un capteur utilisant la spectroscopie d'absorption ultraviolette pour mesurer en temps réel la concentration en nitrate (NO3) in situ dans des eaux claires à fortement turbides/chargées en sédiments en suspension, classé pour 500 m. Une lampe à deutérium fournit une source lumineuse d'une longueur de trajet de 10 mm (ou 5 mm en conditions de forte turbidité) ; le spectre mesuré se situe dans la gamme ultraviolette (UV) 190 nm - 370 nm. L'instrument est basé sur la technologie MBARI-ISUS ; il a été développé à l'origine et fabriqué par Satlantic, puis rebaptisé produit Sea-Bird Scientific suite à l'acquisition de l'entreprise par Danaher en 2011."@fr ;
        skos:notation          "SDN:R27::SUNA_V2";
        skos:note              "accepted"@en;
        skos:prefLabel         "Submersible Ultraviolet Nitrate Analyser (SUNA) V2 nitrate sensor"@en;
        skos:prefLabel         "Capteur de nitrate Submersible Ultraviolet Nitrate Analyser (SUNA) V2"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/SPECTROPHOTOMETER_NITRATE/> , <http://vocab.nerc.ac.uk/collection/R25/current/SPECTROPHOTOMETER_BISULFIDE/> .

<http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP_V2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::SBE41CP_V2";
        dc:date                "2025-04-03 11:54:29.0";
        dc:identifier          "SDN:R27::SBE41CP_V2";
        pav:authoredOn         "2025-04-03 11:54:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP_V2/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP_V2/2/> , <http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP_V2/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "3";
        skos:altLabel          "SBE41CP_V2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/>;
        skos:definition        "A system comprising temperature, conductivity and pressure sensors with pump-controlled, T-C ducted flow. This CTD operates in continuous profiling (CP) mode, thus sampling at 1 Hz during float ascent, logging the data in internal memory and transmitting to the float controller when the float reaches the surface. This SBE41CP model has firmware version 2."@en;
        skos:definition        "Système comprenant des capteurs de température, de conductivité et de pression à flux canalisé T-C contrôlé par pompe. Ce CTD fonctionne en mode de profilage continu (CP), échantillonnant à 1 Hz pendant la montée du flotteur, enregistrant les données en mémoire interne et les transmettant au contrôleur du flotteur lorsqu'il atteint la surface. Ce modèle SBE41CP a le firmware version 2.."@fr ;
        skos:notation          "SDN:R27::SBE41CP_V2";
        skos:note              "deprecated"@en;
        skos:prefLabel         "Sea-Bird Scientific SBE 41CP CTD V2"@en;
        skos:prefLabel         "CTD Sea-Bird Scientific SBE 41CP V2"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP/> , <http://vocab.nerc.ac.uk/collection/R25/current/CTD_PRES/> , <http://vocab.nerc.ac.uk/collection/R25/current/CTD_TEMP/> , <http://vocab.nerc.ac.uk/collection/R25/current/CTD_CNDC/> .

<http://vocab.nerc.ac.uk/collection/R27/current/SEAFET/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::SEAFET";
        dc:date                "2021-08-09 12:23:38.0";
        dc:identifier          "SDN:R27::SEAFET";
        pav:authoredOn         "2021-08-09 12:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/SEAFET/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SEAFET";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/>;
        skos:definition        "An ion sensitive field effect transistor (ISFET) pH sensor with an AglCl reference electrode and a titanium counter electrode, housed in a pressure tolerant package. The sensor is manufactured at Sea-Bird Scientific, and was developed collaboratively by Monterey Bay Aquarium Research Institute (MBARI), Scripps Institution of Oceanography (SIO), and Honeywell International. Depth rating: 2000 dbar; Accuracy: +/- 0.05 pH; stability: 0.036 pH/year."@en;
        skos:definition        "Un capteur pH à transistor à effet de champ sensible aux ions (ISFET) avec électrode de référence en AglCl et contre-électrode en titane, logé dans un boîtier résistant à la pression. Le capteur est fabriqué par Sea-Bird Scientific, et a été développé en collaboration par le Monterey Bay Aquarium Research Institute (MBARI), la Scripps Institution of Oceanography (SIO) et Honeywell International. Profondeur nominale : 2000 dbar ; précision : +/- 0,05 pH ; stabilité : 0,036 pH/an."@fr ;
        skos:notation          "SDN:R27::SEAFET";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird Scientific Deep SeaFET pH sensor"@en;
        skos:prefLabel         "Capteur pH Deep SeaFET"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/TRANSISTOR_PH/> .

<http://vocab.nerc.ac.uk/collection/R27/current/SATLANTIC_PAR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::SATLANTIC_PAR";
        dc:date                "2021-07-01 16:48:21.0";
        dc:identifier          "SDN:R27::SATLANTIC_PAR";
        pav:authoredOn         "2021-07-01 16:48:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/SATLANTIC_PAR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SATLANTIC_PAR";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/> , <http://vocab.nerc.ac.uk/collection/R26/current/SATLANTIC/>;
        skos:definition        "A Photosynthetically Active Radiation (PAR) sensor that measures quantum irradiance with near flat spectral response and cosine spatial response. Spectrum: 400 nm - 700 nm; PAR range: 0 umol - 5000 umol photons m^-2 s^-1; cosine error: < 3% (0 deg - 60 deg) and < 10% (60 deg - 85 deg); sample rate up to 100 Hz. The instrument was originally developed and manufactured at Satlantic, and was rebranded as a Sea-Bird Scientific product following the company's acquisition by Danaher in 2011."@en;
        skos:definition        "Un capteur de rayonnement photosynthétiquement actif (PAR) qui mesure l'irradiance quantique avec une réponse spectrale quasi plate et une réponse spatiale cosinus. Spectre : 400 nm - 700 nm ; gamme PAR : 0 µmol - 5000 µmol photons m^-2 s^-1 ; erreur cosinus : < 3 % (0 deg - 60 deg) et < 10 % (60 deg - 85 deg) ; fréquence d'échantillonnage jusqu'à 100 Hz. L'instrument a été développé à l'origine et fabriqué par Satlantic, puis rebaptisé produit Sea-Bird Scientific suite à l'acquisition de l'entreprise par Danaher en 2011."@fr ;
        skos:notation          "SDN:R27::SATLANTIC_PAR";
        skos:note              "accepted"@en;
        skos:prefLabel         "Satlantic Photosynthetically Active Radiation (PAR) sensor"@en;
        skos:prefLabel         "Capteur de rayonnement photosynthétiquement actif (PAR) Satlantic"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_PAR/> .

<http://vocab.nerc.ac.uk/collection/R27/current/C_ROVER/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::C_ROVER";
        dc:date                "2021-08-09 12:23:38.0";
        dc:identifier          "SDN:R27::C_ROVER";
        pav:authoredOn         "2021-08-09 12:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/C_ROVER/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "C_ROVER";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/> , <http://vocab.nerc.ac.uk/collection/R26/current/WETLABS/>;
        skos:definition        "A neutrally buoyant optical transmissometer, designed for profiling floats applications. Depth rating: 2000 m; available wavelengths: 465 nm, 520 nm and 650 nm; optical pathlength: 25 cm; acceptance angle: 0.9 deg. The instrument was originally developed and manufactured at WET Labs, and was rebranded as a Sea-Bird Scientific product following the company's acquisition by Danaher in 2010."@en;
        skos:definition        "Un transmissomètre optique à flottabilité neutre, conçu pour les applications sur flotteurs profilants. Profondeur nominale : 2000 m ; longueurs d'onde disponibles : 465 nm, 520 nm et 650 nm ; longueur de trajet optique : 25 cm ; angle d'acceptation : 0,9 deg. L'instrument a été développé à l'origine et fabriqué par WET Labs, puis rebaptisé produit Sea-Bird Scientific suite à l'acquisition de l'entreprise par Danaher en 2010."@fr ;
        skos:notation          "SDN:R27::C_ROVER";
        skos:note              "accepted"@en;
        skos:prefLabel         "c-Rover Transmissometer"@en;
        skos:prefLabel         "Transmissomètre c-Rover"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/TRANSMISSOMETER_CP660/> .

<http://vocab.nerc.ac.uk/collection/R27/current/CYCLOPS_7_FLUOROMETER/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::CYCLOPS_7_FLUOROMETER";
        dc:date                "2021-08-09 12:23:38.0";
        dc:identifier          "SDN:R27::CYCLOPS_7_FLUOROMETER";
        pav:authoredOn         "2021-08-09 12:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/CYCLOPS_7_FLUOROMETER/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "CYCLOPS_7_FLUOROMETER";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/TURNER_DESIGN/>;
        skos:definition        "A single-channel optical sensor configurable to detect a wide range of parameters within a 260 nm - 900 nm optical range, including chlorophyll-a, Fluorescent Dissolved Organic Matter (FDOM), and turbidity. The instrument is depth-rated to 600m, and was developed and manufactured by Turner Designs."@en;
        skos:definition        "Un capteur optique monocanal configurable pour détecter une large gamme de paramètres dans une plage optique de 260 nm - 900 nm, incluant la chlorophylle-a, la matière organique dissoute fluorescente (FDOM) et la turbidité. L'instrument est classé pour 600 m, et a été développé et fabriqué par Turner Designs."@fr ;
        skos:notation          "SDN:R27::CYCLOPS_7_FLUOROMETER";
        skos:note              "accepted"@en;
        skos:prefLabel         "Turner Designs Cyclops-7 fluorometer"@en;
        skos:prefLabel         "Fluorimètre Turner Designs Cyclops-7"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/BACKSCATTERINGMETER_TURBIDITY/> , <http://vocab.nerc.ac.uk/collection/R25/current/FLUOROMETER_CHLA/> .

<http://vocab.nerc.ac.uk/collection/R27/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the Argo data system, published and maintained by the Argo Data Management Team (ADMT) and hosted on the NERC Vocabulary Server.";
