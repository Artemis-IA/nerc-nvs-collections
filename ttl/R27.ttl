<http://vocab.nerc.ac.uk/collection/R27/current/SBE43_IDO/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::SBE43_IDO";
        dc:date                "2021-05-26 09:01:46.0";
        dc:identifier          "SDN:R27::SBE43_IDO";
        pav:authoredOn         "2021-05-26 09:01:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/SBE43_IDO/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SBE43_IDO";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SBE/>;
        skos:definition        "A through-flow, Clark polarographic membrane dissolved oxygen sensor, manufactured by Sea-Bir Scientific and designed to be integrated into a pumped CTD system. Depth rating: 600 m (plastic housing) or 7000 m (titanium housing); oxygen concentration initial accuracy: 2 % saturation; response time (63 %): 2 s - 5 s for 0.5 mil membrane (profiling applications), or 8 s - 20 s for 1.0 mil membrane (moored applications); output signal: 0-5 VDC."@en;
        skos:definition        "Un capteur d'oxygène dissous à flux traversant, à membrane polarographique Clark, fabriqué par Sea-Bir Scientific et conçu pour être intégré à un système CTD pompé. Profondeur nominale : 600 m (boîtier plastique) ou 7000 m (boîtier titane) ; précision initiale de concentration en oxygène : 2 % de saturation ; temps de réponse (63 %) : 2 s - 5 s pour 0.5 mil membrane (applications de profilage), ou 8 s - 20 s pour 1.0 mil membrane (applications de mouillage) ; signal de sortie : 0-5 VDC."@fr ;
        skos:notation          "SDN:R27::SBE43_IDO";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird Scientific SBE 43 Integrated Dissolved Oxygen (IDO) sensor"@en;
        skos:prefLabel         "Capteur d'oxygène dissous intégré (IDO) Sea-Bird Scientific SBE 43"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/IDO_DOXY/> .

