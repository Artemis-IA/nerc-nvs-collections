<http://vocab.nerc.ac.uk/collection/R27/current/SATLANTIC_OCR504_ICSW/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::SATLANTIC_OCR504_ICSW";
        dc:date                "2025-08-28 11:45:52.0";
        dc:identifier          "SDN:R27::SATLANTIC_OCR504_ICSW";
        pav:authoredOn         "2025-08-28 11:45:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/SATLANTIC_OCR504_ICSW/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R27/current/SATLANTIC_OCR504_ICSW/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "SATLANTIC_OCR504_ICSW";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SATLANTIC/> , <http://vocab.nerc.ac.uk/collection/R26/current/SBE/>;
        skos:definition        "A cosine-response, multispectral radiometer configured to measure downwelling irradiance in water. Number of channels: 4; bandwidth range: 400 nm to 865 nm (standard), or 305 nm, 325 nm, 340 nm, 380 nm (UV); sampling rate: 7 Hz – 24 Hz; spectral bandwidth: 10 nm or 20 nm. The instrument was originally developed and manufactured at Satlantic, and was rebranded as a Sea-Bird Scientific product following the company's acquisition by Danaher in 2011."@en;
        skos:definition        "Un radiomètre multispectral à réponse cosinus configuré pour mesurer l'irradiance descendante dans l'eau. Nombre de canaux : 4 ; plage de bande passante : 400 nm à 865 nm (standard), ou 305 nm, 325 nm, 340 nm, 380 nm (UV) ; fréquence d'échantillonnage : 7 Hz – 24 Hz ; bande passante spectrale : 10 nm ou 20 nm. L'instrument a été développé à l'origine et fabriqué par Satlantic, puis rebaptisé produit Sea-Bird Scientific suite à l'acquisition de l'entreprise par Danaher en 2011."@fr ;
        skos:notation          "SDN:R27::SATLANTIC_OCR504_ICSW";
        skos:note              "deprecated"@en;
        skos:prefLabel         "OCR-504 multispectral radiometer (downwelling irradiance)"@en;
        skos:prefLabel         "Radiomètre multispectral OCR-504 (irradiance descendante)"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_DOWN_IRR380/> , <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_DOWN_IRR555/> , <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_DOWN_IRR665/> , <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_DOWN_IRR412/> , <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_PAR/> , <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_DOWN_IRR443/> , <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_DOWN_IRR490/> , <http://vocab.nerc.ac.uk/collection/R25/current/RADIOMETER_DOWN_IRR670/> .

