<http://vocab.nerc.ac.uk/collection/R27/current/SEAPOINT_TURBIDITY_METER/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R27::SEAPOINT_TURBIDITY_METER";
        dc:date                "2021-08-09 12:23:38.0";
        dc:identifier          "SDN:R27::SEAPOINT_TURBIDITY_METER";
        pav:authoredOn         "2021-08-09 12:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R27/current/SEAPOINT_TURBIDITY_METER/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SEAPOINT_TURBIDITY_METER";
        skos:broader           <http://vocab.nerc.ac.uk/collection/R26/current/SEAPOINT/>;
        skos:definition        "A single-channel optical meter measuring scattering at 880 nm to determine turbidity, depth-rated to 6000 m. The sensor has four programmable sensitivity options: 2 mV/FTU, 10 mV/FTU, 40 mV/FTU and 200 mV/FTU, each corresponding to a gain of 1x, 5x, 20x and 100x respectively, and range of non-linear, 500 FTU, 125 FTU and 25 FTU respectively. The instrument was developed and manufactured by Seapoint Sensors, inc."@en;
        skos:definition        "Un photomètre optique monocanal mesurant la diffusion à 880 nm pour déterminer la turbidité, classé pour 6000 m. Le capteur dispose de quatre options de sensibilité programmables : 2 mV/FTU, 10 mV/FTU, 40 mV/FTU et 200 mV/FTU, correspondant respectivement à un gain de 1x, 5x, 20x et 100x, et des plages non linéaires, 500 FTU, 125 FTU et 25 FTU respectivement. L'instrument a été développé et fabriqué par Seapoint Sensors, inc."@fr ;
        skos:notation          "SDN:R27::SEAPOINT_TURBIDITY_METER";
        skos:note              "accepted"@en;
        skos:prefLabel         "Seapoint Turbidity Meter"@en;
        skos:prefLabel         "Turbitimètre Seapoint"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/R25/current/BACKSCATTERINGMETER_TURBIDITY/> .

