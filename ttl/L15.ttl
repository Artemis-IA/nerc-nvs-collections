<http://vocab.nerc.ac.uk/collection/L15/current/COMBINE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L15::COMBINE";
        dc:date                "2010-02-08 16:48:34.0";
        dc:identifier          "SDN:L15::COMBINE";
        pav:authoredOn         "2010-02-08 16:48:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L15/current/COMBINE/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L15/current/COMBINE/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "HELCOM COMBINE manual";
        skos:definition        "A manual specifying field observation, sample collection, analytical and data quality procedures for environmental monitoring studies in the Baltic Sea (http://www.helcom.fi/groups/monas/CombineManual/en_GB/main/)."@en;
        skos:notation          "SDN:L15::COMBINE";
        skos:note              "accepted"@en;
        skos:prefLabel         "Helsinki Commission Cooperative Monitoring in the Baltic Marine Environment manual of measurement protocols"@en .

