<http://vocab.nerc.ac.uk/collection/I15/current/restrictedZonesAroundContaminatedSites/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::restrictedZonesAroundContaminatedSites";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::restrictedZonesAroundContaminatedSites";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/restrictedZonesAroundContaminatedSites/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Zones established to protect human, plant and animal health and control movement and development within a contaminated site.\", \"Example\": \"Chernobyl Nuclear Power Plant Exclusion Zone which was established to evacuate the local population and to prevent people from entering the heavily contaminated territory.\", \"Example\": \"Zone established around an area suffering from soil contamination to restrict development and protect human health.\"}"@en;
        skos:definition        "{\"Definition\": \"Zones établies pour protéger la santé humaine, végétale et animale et contrôler les mouvements et le développement au sein d'un site contaminé.\",\"Example\": \"Zone d'exclusion de la centrale nucléaire de Tchernobyl, établie pour évacuer la population locale et empêcher les gens d'entrer sur le territoire fortement contaminé.\",\"Example\": \"Zone établie autour d'une zone souffrant de contamination des sols pour restreindre le développement et protéger la santé humaine.\"}"@fr ;
        skos:notation          "SDN:I15::restrictedZonesAroundContaminatedSites";
        skos:note              "accepted"@en;
        skos:prefLabel         "Restricted zones around contaminated sites"@en ;
        skos:prefLabel         "zones réglementées autour de sites contaminés"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/bathingWaters/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::bathingWaters";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::bathingWaters";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/bathingWaters/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Coastal waters or inland waters (rivers, lakes) explicitly authorised, or not prohibited for recreational bathing by large numbers of people.\", \"Note\": \"Bathing waters are set limits for physical, chemical and microbiological parameters to ensuring clean bathing waters to protect public health and the environment.\"}"@en;
        skos:definition        "{\"Definition\": \"Eaux côtières ou eaux intérieures (rivières, lacs) explicitement autorisées, ou non interdites, pour la baignade récréative par un grand nombre de personnes.\",\"Note\": \"Des limites sont fixées pour les eaux de baignade sur les paramètres physiques, chimiques et microbiologiques afin de garantir des eaux de baignade propres pour protéger la santé publique et l'environnement.\"}"@fr ;
        skos:notation          "SDN:I15::bathingWaters";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bathing waters"@en ;
        skos:prefLabel         "eaux de baignade"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/designatedWaters/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::designatedWaters";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::designatedWaters";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/designatedWaters/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Marine, coastal or surface waters designated by Member States as needing protection or improvement in order to support fish life. Member States are required to define designated waters to protect freshwater fish and shellfish by the Fisheries Directive (2006/44/EC) and  Shellfish Waters Directive (2006/113/EEC).\"}"@en;
        skos:definition        "{\"Definition\": \"Eaux marines, côtières ou de surface désignées par les États membres comme nécessitant une protection ou une amélioration afin de soutenir la vie des poissons. Les États membres sont tenus de définir les eaux désignées pour protéger les poissons d'eau douce et les coquillages par la directive « Fisheries » (2006/44/CE) et la directive « Shellfish Waters » (2006/113/CE).\"}"@fr ;
        skos:notation          "SDN:I15::designatedWaters";
        skos:note              "accepted"@en;
        skos:prefLabel         "Designated waters"@en ;
        skos:prefLabel         "eaux désignées"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/plantHealthProtectionZone/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::plantHealthProtectionZone";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::plantHealthProtectionZone";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/plantHealthProtectionZone/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Protection zone within which protective measures are established against the introduction of organisms harmful to plants or plant products and against their spread.\", \"Source\": \"Commission Regulation (EC) No. 690/2008\"}"@en;
        skos:definition        "{\"Definition\": \"Zone de protection à l'intérieur de laquelle des mesures de protection sont établies contre l'introduction d'organismes nuisibles aux végétaux ou aux produits végétaux et contre leur propagation.\",\"Source\": \"Commission Regulation (EC) No. 690/2008\"}"@fr ;
        skos:notation          "SDN:I15::plantHealthProtectionZone";
        skos:note              "accepted"@en;
        skos:prefLabel         "Plant health protection zone"@en ;
        skos:prefLabel         "zone de protection de la santé des végétaux"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/sensitiveArea/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::sensitiveArea";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::sensitiveArea";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/sensitiveArea/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Sensitive areas are surface waters (freshwater, estuaries and coastal waters) that require protection against eutrophication.\", \"Source\": \"Urban Waste Water Treatment Directive (91/271/EEC)\"}"@en;
        skos:definition        "{\"Definition\": \"Les zones sensibles sont des eaux de surface (eaux douces, estuaires et eaux côtières) qui nécessitent une protection contre l'eutrophisation.\",\"Source\": \"Urban Waste Water Treatment Directive (91/271/EEC)\"}"@fr ;
        skos:notation          "SDN:I15::sensitiveArea";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sensitive area"@en ;
        skos:prefLabel         "zone sensible"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/airQualityManagementZone/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::airQualityManagementZone";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::airQualityManagementZone";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/airQualityManagementZone/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Part of the territory of a Member State, as delimited by that Member State for the purposes of air quality assessment and management.\", \"Source\": \"CAFE Directive (2008/50/EC)\"}"@en;
        skos:definition        "{\"Definition\": \"Partie du territoire d'un État membre, telle que délimitée par cet État membre aux fins d'évaluation et de gestion de la qualité de l'air.\",\"Source\": \"CAFE Directive (2008/50/EC)\"}"@fr ;
        skos:notation          "SDN:I15::airQualityManagementZone";
        skos:note              "accepted"@en;
        skos:prefLabel         "Air quality management zone"@en ;
        skos:prefLabel         "zone de gestion de la qualité de l'air"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/regulatedFairwayAtSeaOrLargeInlandWater/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::regulatedFairwayAtSeaOrLargeInlandWater";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::regulatedFairwayAtSeaOrLargeInlandWater";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/regulatedFairwayAtSeaOrLargeInlandWater/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Regulated navigation areas port-to-port established in accordance with Decision 884/2004/EC of the European Parliament and Council of 29 April 2004 amending Decision No 1692/96/EC on Community guidelines for the development of the trans - European transport network to organise sailing traffic, prevent accident and pollution.\"}"@en;
        skos:definition        "{\"Definition\": \"Zones de navigation réglementées port à port établies conformément à la décision 884/2004/CE du Parlement européen et du Conseil du 29 avril 2004 modifiant la décision n° 1692/96/CE relative aux orientations communautaires pour le développement du réseau transeuropéen de transport afin d'organiser la circulation maritime, prévenir les accidents et la pollution.\"}"@fr ;
        skos:notation          "SDN:I15::regulatedFairwayAtSeaOrLargeInlandWater";
        skos:note              "accepted"@en;
        skos:prefLabel         "Regulated fairway at sea or large inland water"@en ;
        skos:prefLabel         "voie d'eau réglementée en mer ou grande eau intérieure"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/nitrateVulnerableZone/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::nitrateVulnerableZone";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::nitrateVulnerableZone";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/nitrateVulnerableZone/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Areas of land which drain into polluted or threatened waters and which contribute to nitrate pollution.\", \"Source\": \"Art 3 of Council Directive 91/676/EEC of 12 December 1991 concerning the protection of waters against pollution caused by nitrates from agricultural sources.\"}"@en;
        skos:definition        "{\"Definition\": \"Zones de terre qui s'écoulent vers des eaux polluées ou menacées et qui contribuent à la pollution par les nitrates.\",\"Source\": \"Art 3 de la directive 91/676/CEE du Conseil du 12 décembre 1991 concernant la protection des eaux contre la pollution causada par les nitrates d'origine agricole.\"}"@fr ;
        skos:notation          "SDN:I15::nitrateVulnerableZone";
        skos:note              "accepted"@en;
        skos:prefLabel         "Nitrate vulnerable zone"@en ;
        skos:prefLabel         "zone vulnérable aux nitrates"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/prospectingAndMiningPermitArea/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::prospectingAndMiningPermitArea";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::prospectingAndMiningPermitArea";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/prospectingAndMiningPermitArea/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"The area on which the prospection or extraction of any mineral has been authorised and for which that right or permit is granted.\", \"Example\": \"Directive 94/22/EC on conditions for granting and using authorisations for the prospection, exploration and production of hydrocarbons, stipulates that the limits of the geographical areas covered by an authorisation and the duration of that authorisation must be determined in proportion to what is justified in terms of the best possible exercise of the activities from an economic and technical point of view.\"}"@en;
        skos:definition        "{\"Definition\": \"La zone sur laquelle la prospection ou l'extraction de tout minéral a été autorisée et pour laquelle ce droit ou permis est accordé.\",\"Example\": \"La directive 94/22/CE relative aux conditions d'octroi et d'utilisation des autorisations de prospection, d'exploration et de production d'hydrocarbures stipule que les limites des zones géographiques couvertes par une autorisation et la durée de cette autorisation doivent être déterminées proportionnellement à ce qui est justifié en termes d'exercice optimal des activités d'un point de vue économique et technique.\"}"@fr ;
        skos:notation          "SDN:I15::prospectingAndMiningPermitArea";
        skos:note              "accepted"@en;
        skos:prefLabel         "Prospecting and mining permit area"@en ;
        skos:prefLabel         "zone de permis de prospection et d'exploitation minière"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/areaForDumpingOfWaste/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::areaForDumpingOfWaste";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::areaForDumpingOfWaste";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/areaForDumpingOfWaste/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Area affected by uncontrolled disposal of waste as defined in Waste Framework Directive (2006/12/EC) Art 4.\"}"@en;
        skos:definition        "{\"Definition\": \"Zone affectée par le dépôt non contrôlé de déchets tel que défini dans la directive-cadre sur les déchets (2006/12/CE) Art 4.\"}"@fr ;
        skos:notation          "SDN:I15::areaForDumpingOfWaste";
        skos:note              "accepted"@en;
        skos:prefLabel         "Area for dumping of waste"@en ;
        skos:prefLabel         "zone de dépôt de déchets"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/noiseManagementZone/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::noiseManagementZone";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::noiseManagementZone";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/noiseManagementZone/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"An area where measures have been established to mitigate noise pollution.\", \"Note\": \"Noise Management Areas or Zones may encompass areas surrounding airports, roads or entertainment venues.\"}"@en;
        skos:definition        "{\"Definition\": \"Une zone où des mesures ont été établies pour atténuer la pollution sonore.\",\"Note\": \"Les zones de gestion du bruit peuvent englober des zones entourant les aéroports, les routes ou les lieux de divertissement.\"}"@fr ;
        skos:notation          "SDN:I15::noiseManagementZone";
        skos:note              "accepted"@en;
        skos:prefLabel         "Noise management zone"@en ;
        skos:prefLabel         "zone de gestion du bruit"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/riverBasinDistrict/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::riverBasinDistrict";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::riverBasinDistrict";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/riverBasinDistrict/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Area of land and sea, made up of one or more neighbouring river basins together with their associated groundwaters and coastal waters, identified under Article 3(1) as the main unit for management of river basins.\", \"Source\": \"Article 2(15) of directive 2000/60/EC of the European Parliament and of the Council of 23 October 2000 establishing a framework for Community action in the field of water policy.\"}"@en;
        skos:definition        "{\"Definition\": \"Zone de terre et de mer, composée d'un ou plusieurs bassins fluviaux voisins ainsi que leurs eaux souterraines et eaux côtières associées, identifiée en vertu de l'article 3, paragraphe 1, comme unité principale de gestion des bassins fluviaux.\",\"Source\": \"Article 2, paragraphe 15, de la directive 2000/60/CE du Parlement européen et du Conseil du 23 octobre 2000 établissant un cadre pour l'action communautaire dans le domaine de la politique de l'eau.\"}"@fr ;
        skos:notation          "SDN:I15::riverBasinDistrict";
        skos:note              "accepted"@en;
        skos:prefLabel         "River basin district"@en ;
        skos:prefLabel         "district hydrographique"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/animalHealthRestrictionZone/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::animalHealthRestrictionZone";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::animalHealthRestrictionZone";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/animalHealthRestrictionZone/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Restriction zones established for the control and eradiation of notifiable animal diseases.\", \"Example\": \"Bluetongue Restriction Zones (Council Directive 2000/75/EC)\", \"Example\": \"Avian Influenze Restriction Zones (Council Directive 2005/94/EC)\", \"Example\": \"African Horse Sickness (Council Directive 92/35/EEC)\"}"@en;
        skos:definition        "{\"Definition\": \"Zones de restriction établies pour le contrôle et l'éradication des maladies animales à déclaration obligatoire.\",\"Example\": \"Zones de restriction de la fièvre catarrhale ovine (directive 2000/75/CE)\",\"Example\": \"Zones de restriction de la grippe aviaire (directive 2005/94/CE)\",\"Example\": \"Peste équine africaine (directive 92/35/CEE)\"}"@fr ;
        skos:notation          "SDN:I15::animalHealthRestrictionZone";
        skos:note              "accepted"@en;
        skos:prefLabel         "Animal health restriction zone"@en ;
        skos:prefLabel         "zone de restriction sanitaire animale"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/coastalZoneManagementArea/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::coastalZoneManagementArea";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::coastalZoneManagementArea";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/coastalZoneManagementArea/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Area in which integrated coastal zone management takes place. Integrated coastal zone management is defined as a dynamic process for the sustainable management and use of coastal zones, taking into account at the same time the fragility of coastal ecosystems and landscapes, the diversity of activities and uses, their interactions, the maritime orientation of certain activities and uses and their impact on both the marine and land parts.\", \"Source\": \"Protocol on Integrated Coastal Zone Management in the Mediterranean - signed in Madrid on 20-21 January 2008\"}"@en;
        skos:definition        "{\"Definition\": \"Zone dans laquelle la gestion intégrée des zones côtières a lieu. La gestion intégrée des zones côtières est définie comme un processus dynamique de gestion et d'utilisation durable des zones côtières, tenant compte en même temps de la fragilité des écosystèmes et des paysages côtiers, de la diversité des activités et des utilisations, de leurs interactions, de l'orientation maritime de certaines activités et utilisations et de leur impact sur les parties marine et terrestre.\",\"Source\": \"Protocole sur la gestion intégrée des zones côtières en Méditerranée - signé à Madrid le 20-21 janvier 2008\"}"@fr ;
        skos:notation          "SDN:I15::coastalZoneManagementArea";
        skos:note              "accepted"@en;
        skos:prefLabel         "Coastal zone management area"@en ;
        skos:prefLabel         "zone de gestion du littoral"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/floodRiskManagementZone/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::floodRiskManagementZone";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::floodRiskManagementZone";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/floodRiskManagementZone/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Coastal areas or individual river basins assigned as the unit of management established for the assessment and management of flood risk, different from those assigned pursuant to Article 3(1) of Directive 2000/60/EC.\", \"Source\": \"2007/60/EC Art 3(2)b\"}"@en;
        skos:definition        "{\"Definition\": \"Zones côtières ou bassins fluviaux individuels attribués comme unité de gestion établie pour l'évaluation et la gestion du risque d'inondation, différents de ceux attribués en vertu de l'article 3, paragraphe 1, de la directive 2000/60/CE.\",\"Source\": \"2007/60/CE Art 3(2)b\"}"@fr ;
        skos:notation          "SDN:I15::floodRiskManagementZone";
        skos:note              "accepted"@en;
        skos:prefLabel         "Flood risk management zone"@en ;
        skos:prefLabel         "zone de gestion du risque d'inondation"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/drinkingWaterProtectionArea/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::drinkingWaterProtectionArea";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::drinkingWaterProtectionArea";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/drinkingWaterProtectionArea/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Area in which waste water leakage, use of fertilizer or pesticides, or establishment of waste disposal sites are prohibited.\", \"Example\": \"From Directive 80/778, relating to the quality of water intended for human consumption. According to the article 8 providing that Member States shall take all the necessary measures to ensure that any substances used in the preparation of water for human consumption do not remain in concentrations higher than the maximum admissible.\"}"@en;
        skos:definition        "{\"Definition\": \"Zone dans laquelle les fuites d'eaux usées, l'utilisation d'engrais ou de pesticides, ou l'établissement de sites d'élimination de déchets sont interdits.\",\"Example\": \"Extrait de la directive 80/778 relative à la qualité des eaux destinées à la consommation humaine. Selon l'article 8, les États membres prennent toutes les mesures nécessaires pour garantir que toute substance utilisée dans la préparation de l'eau potable ne subsiste pas à des concentrations supérieures à la concentration maximale admissible.\"}"@fr ;
        skos:notation          "SDN:I15::drinkingWaterProtectionArea";
        skos:note              "accepted"@en;
        skos:prefLabel         "Drinking water protection area"@en ;
        skos:prefLabel         "zone de protection des eaux potables"@fr .

<http://vocab.nerc.ac.uk/collection/I15/current/marineRegion/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I15::marineRegion";
        dc:date                "2012-05-03 14:57:28.0";
        dc:identifier          "SDN:I15::marineRegion";
        pav:authoredOn         "2012-05-03 14:57:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I15/current/marineRegion/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"Definition\": \"Marine regions and their subregions are sea regions designated for the purpose of assessment, management and regulation. For each Marine Region a marine strategy shall be developed and implemented to maintain and improve good environmental status.\", \"Source\": \"Marine Strategy Framework Directive (2008/56/EC)\"}"@en;
        skos:definition        "{\"Definition\": \"Les régions marines et leurs sous-régions sont des régions maritimes désignées aux fins d'évaluation, de gestion et de réglementation. Pour chaque région marine, une stratégie marine doit être développée et mise en œuvre pour maintenir et améliorer le bon état environnemental.\",\"Source\": \"Marine Strategy Framework Directive (2008/56/EC)\"}"@fr ;
        skos:notation          "SDN:I15::marineRegion";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marine region"@en ;
        skos:prefLabel         "région marine"@fr .

