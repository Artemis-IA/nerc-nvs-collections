        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "megalopae+adult";
        skos:altLabel          "mégalopes+adulte"@fr ;
        skos:definition        "Megalopae (Organisms at the final larval development stage of decapod crustaceans (e.g. crabs) following the zoea and preceding the adult stage) and adults (An animal that has reached sexual maturity) have either been grouped together or cannot be reliably distinguished."@en;
        skos:definition        "Les mégalopes (organismes au dernier stade de développement larvaire des crustacés décapodes, ex. crabes, suivant la zoé et précédant le stade adulte) et les adultes (animal ayant atteint la maturité sexuelle) ont été soit regroupés, soit ne peuvent être distingués de façon fiable."@fr ;
        skos:notation          "SDN:S11::S1198";
        skos:note              "accepted"@en;
        skos:prefLabel         "megalopa+adult"@en ;
        skos:prefLabel         "mégalope+adulte"@fr .

