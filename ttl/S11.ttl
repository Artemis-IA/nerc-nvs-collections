        owl:deprecated         "false";
        owl:sameAs             <http://purl.obolibrary.org/obo/UBERON_0007221>;
        owl:versionInfo        "2";
        skos:altLabel          "neonatus";
        skos:altLabel          "néonat"@fr ;
        skos:definition        "A newly born vertebrate (fishes, amphibians, reptiles, birds, mammals). The term 'hatchling' is used for newborn emerged from an egg."@en;
        skos:definition        "Un vertébré nouveau-né (poissons, amphibiens, reptiles, oiseaux, mammifères). Le terme « oisillon/nouveau-né » s'applique aux nouveau-nés sortis d'un œuf."@fr ;
        skos:notation          "SDN:S11::S1172";
        skos:note              "accepted"@en;
        skos:prefLabel         "newborn"@en ;
        skos:prefLabel         "nouveau-né"@fr .

