<http://vocab.nerc.ac.uk/collection/S11/current/S1190/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1190";
        dc:date                "2025-06-27 15:45:59.0";
        dc:identifier          "SDN:S11::S1190";
