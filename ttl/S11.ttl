<http://vocab.nerc.ac.uk/collection/S11/current/S1182/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1182";
        dc:date                "2021-03-23 14:41:41.0";
        dc:identifier          "SDN:S11::S1182";
        pav:authoredOn         "2021-03-23 14:41:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1182/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S11/current/S1182/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The life stages of parasitic copepod species marked by their secure attachment to a host by a frontal filament. The chalimus stages follow the free-swimming copepodid stage and precede the pre-adult stages (sometimes referred to as 'sub-adult') where the organism is capable of detaching from its filament to move across the surface of its host."@en;
        skos:definition        "Les stades de vie des espèces de copépodes parasites marqués par leur attachement ferme à un hôte par un filament frontal. Les stades chalimus suivent le stade copépodite nage libre et précèdent les stades pré-adultes (parfois appelés « sub-adultes »), où l'organisme peut se détacher de son filament pour se déplacer à la surface de son hôte."@fr ;
        skos:notation          "SDN:S11::S1182";
        skos:note              "accepted"@en;
        skos:prefLabel         "chalimus"@en ;
        skos:prefLabel         "chalimus"@fr .

