<http://vocab.nerc.ac.uk/collection/S11/current/S1102/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1102";
        dc:date                "2025-06-27 15:45:59.0";
        dc:identifier          "SDN:S11::S1102";
        pav:authoredOn         "2025-06-27 15:45:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1102/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S11/current/S1102/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "pilidium larvae";
        skos:altLabel          "larves pilidium"@fr ;
        skos:definition        "Larval stage of both Nemertea and Spiralia in which the developing juvenile has a gut which lies across the larva's body, and usually eats the remains of the larva when it emerges."@en;
        skos:definition        "Stade larvaire des Nemertea et des Spiralia où le juvénile en développement possède un tube digestif traversant le corps de la larve, et mange généralement les restes de la larve à son émergence."@fr ;
        skos:notation          "SDN:S11::S1102";
        skos:note              "accepted"@en;
        skos:prefLabel         "pilidium larva"@en ;
        skos:prefLabel         "larve pilidium"@fr .

<http://vocab.nerc.ac.uk/collection/S11/current/S1196/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1196";
        dc:date                "2021-08-24 12:13:11.0";
        dc:identifier          "SDN:S11::S1196";
        pav:authoredOn         "2021-08-24 12:13:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1196/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A developmental stage in the life cycle of doliolids (Order Doliolida). The nurse stage is the terminal life stage for doliolids, often characterized by a conspicuous tail (cadophore) sprouting small trophozooids (i.e. 'nutrition zooids') also called 'gastrozooids' (i.e., feeding buds) [[Paffenhofer and Koster, 2011](https://doi.org/10.1093/plankt/fbr001); [Greer et al 2020](https://doi.org/10.1002/lno.11450)]."@en;
        skos:definition        "Stade de développement du cycle de vie des doliolidés (ordre Doliolida). Le stade nourrice est le stade terminal des doliolidés, souvent caractérisé par une queue visible (cadophore) d'où bourgeonnent de petits trophozooïdes (aussi appelés « zooïdes nutritifs » ou « gastrozoïdes », c.-à-d. bourgeons nourriciers) [[Paffenhofer and Koster, 2011](https://doi.org/10.1093/plankt/fbr001); [Greer et al 2020](https://doi.org/10.1002/lno.11450)]."@fr ;
        skos:notation          "SDN:S11::S1196";
        skos:note              "accepted"@en;
        skos:prefLabel         "nurse"@en ;
        skos:prefLabel         "nourrice"@fr .

