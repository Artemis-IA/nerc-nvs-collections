        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "paralarvae";
        skos:altLabel          "paralarves"@fr ;
        skos:definition        "Planktonic stage of young cephalopods between hatching and sub-adult."@en;
        skos:definition        "Stade planctonique des jeunes céphalopodes entre l'éclosion et le stade sub-adulte."@fr ;
        skos:notation          "SDN:S11::S1194";
        skos:note              "accepted"@en;
        skos:prefLabel         "paralarva"@en ;
        skos:prefLabel         "paralarve"@fr .

<http://vocab.nerc.ac.uk/collection/S11/current/S1184/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1184";
        dc:date                "2025-06-27 15:45:59.0";
        dc:identifier          "SDN:S11::S1184";
        pav:authoredOn         "2025-06-27 15:45:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1184/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S11/current/S1184/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "An embryonic development stage from extrusion of the egg to the formation of an advanced blastodisc (also known as the germinal disc or blastoderm), encompassing the zygote, morula and blastula stages of egg development."@en;
        skos:definition        "Stade de développement embryonnaire de l'extrusion de l'œuf à la formation d'un disque blastodermique avancé (aussi appelé disque germinal ou blastoderme), comprenant les stades zygote, morula et blastula du développement de l'œuf."@fr ;
        skos:notation          "SDN:S11::S1184";
        skos:note              "accepted"@en;
        skos:prefLabel         "early stage egg"@en ;
        skos:prefLabel         "œuf stade précoce"@fr .

