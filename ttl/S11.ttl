<http://vocab.nerc.ac.uk/collection/S11/current/S1191/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1191";
        dc:date                "2021-08-23 21:51:36.0";
        dc:identifier          "SDN:S11::S1191";
        pav:authoredOn         "2021-08-23 21:51:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1191/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The juvenile form of a family of marine isopod crustaceans known as Gnathiidae. The adults are associated with sponges and occur in a wide range of depths. The praniza 'larva' is a temporary parasite of marine fishes."@en;
        skos:definition        "La forme juvénile d'une famille de crustacés isopodes marins appelés Gnathiidae. Les adultes sont associés aux éponges et se rencontrent sur une large gamme de profondeurs. La « larve » praniza est un parasite temporaire des poissons marins."@fr ;
        skos:notation          "SDN:S11::S1191";
        skos:note              "accepted"@en;
        skos:prefLabel         "praniza"@en ;
        skos:prefLabel         "praniza"@fr .

<http://vocab.nerc.ac.uk/collection/S11/current/S1187/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1187";
        dc:date                "2025-06-27 15:45:59.0";
        dc:identifier          "SDN:S11::S1187";
        pav:authoredOn         "2025-06-27 15:45:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1187/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S11/current/S1187/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "A fish life stage between hatching and until complete absorption of yolk-sac."@en;
        skos:definition        "Stade de vie d'un poisson entre l'éclosion et la résorption complète de la vésicule vitelline."@fr ;
        skos:notation          "SDN:S11::S1187";
        skos:note              "accepted"@en;
        skos:prefLabel         "yolk-sac larva"@en ;
        skos:prefLabel         "larve à vésicule vitelline"@fr .

<http://vocab.nerc.ac.uk/collection/S11/current/S1197/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1197";
        dc:date                "2021-08-24 12:20:09.0";
        dc:identifier          "SDN:S11::S1197";
        pav:authoredOn         "2021-08-24 12:20:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1197/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "nectochaetae";
        skos:altLabel          "nectochaetae"@fr ;
        skos:definition        "A developmental stage found in Polychaeta species, it is a planktonic stage bearing functioning parapodia serving locomotion [Plate and Huseman 1994](https://hmr.biomedcentral.com/track/pdf/10.1007/BF02366201.pdf)."@en;
        skos:definition        "Stade de développement présent chez les espèces de Polychaeta, stade planctonique portant des parapodes fonctionnels assurant la locomotion [Plate and Huseman 1994](https://hmr.biomedcentral.com/track/pdf/10.1007/BF02366201.pdf)."@fr ;
        skos:notation          "SDN:S11::S1197";
        skos:note              "accepted"@en;
        skos:prefLabel         "nectochaeta"@en ;
        skos:prefLabel         "nectochaeta"@fr .

<http://vocab.nerc.ac.uk/collection/S11/current/S1177/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1177";
        dc:date                "2019-08-23 13:20:27.0";
        dc:identifier          "SDN:S11::S1177";
        pav:authoredOn         "2019-08-23 13:20:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1177/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://purl.obolibrary.org/obo/OPL_0000098>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A term used for a development stage in the lifecycle of Apicomplexa parasites and trematode flatworm parasites (flukes). In the trematodes lifecycle it is an elongated sac-like structure that is formed in the initial stage of infection of an intermediate host (typically a snail). It develops from a miracidium and evolve into a redia."@en;
        skos:definition        "Terme désignant un stade de développement dans le cycle de vie des parasites Apicomplexa et des parasites plats trématodes (douves). Dans le cycle des trématodes, c'est une structure allongée en forme de sac formée au stade initial d'infection d'un hôte intermédiaire (généralement un escargot). Elle se développe à partir d'un miracidium et évolue en rédie."@fr ;
        skos:notation          "SDN:S11::S1177";
        skos:note              "accepted"@en;
        skos:prefLabel         "sporocyst"@en ;
        skos:prefLabel         "sporocyste"@fr .

<http://vocab.nerc.ac.uk/collection/S11/current/S1104/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1104";
        dc:date                "2023-08-10 15:21:34.0";
        dc:identifier          "SDN:S11::S1104";
        pav:authoredOn         "2023-08-10 15:21:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1104/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "tornaria";
        skos:altLabel          "tornaria"@fr ;
        skos:definition        "The larval stage of some species of Hemichordata such as acorn worms."@en;
        skos:definition        "Le stade larvaire de certaines espèces d'Hemichordata comme les vers à glands."@fr ;
        skos:notation          "SDN:S11::S1104";
        skos:note              "accepted"@en;
        skos:prefLabel         "tornaria"@en ;
        skos:prefLabel         "tornaria"@fr .

<http://vocab.nerc.ac.uk/collection/S11/current/S1181/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S11::S1181";
        dc:date                "2019-11-25 15:28:56.0";
        dc:identifier          "SDN:S11::S1181";
        pav:authoredOn         "2019-11-25 15:28:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S11/current/S1181/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A life stage of aquatic polychaete worms whose life cycle include a process known as \"epitoky\". Epitoky is the metamorphosis of a sexually immature worm (the atoke) into a sexually mature form (the epitoke) adapted for a brief free-swimming near-surface phase."@en;
        skos:definition        "Stade de vie de vers polychètes aquatiques dont le cycle de vie comprend un processus appelé « épitokie ». L'épitokie est la métamorphose d'un ver sexuellement immature (l'atoke) en une forme sexuellement mature (l'épitoke) adaptée à une brève phase pélagique de nage libre près de la surface."@fr ;
        skos:notation          "SDN:S11::S1181";
        skos:note              "accepted"@en;
        skos:prefLabel         "epitoke"@en ;
        skos:prefLabel         "épitoque"@fr .

