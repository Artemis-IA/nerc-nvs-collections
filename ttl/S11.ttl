        skos:altLabel          "";
        skos:definition        "A developmental stage in the life cycle of doliolids (Order Doliolida). The nurse stage is the terminal life stage for doliolids, often characterized by a conspicuous tail (cadophore) sprouting small trophozooids (i.e. 'nutrition zooids') also called 'gastrozooids' (i.e., feeding buds) [[Paffenhofer and Koster, 2011](https://doi.org/10.1093/plankt/fbr001); [Greer et al 2020](https://doi.org/10.1002/lno.11450)]."@en;
        skos:notation          "SDN:S11::S1196";
        skos:note              "accepted"@en;
        skos:prefLabel         "nurse"@en .

