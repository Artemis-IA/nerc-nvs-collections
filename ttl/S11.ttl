        skos:altLabel          "";
        skos:definition        "An organism at the pupal stage. A life stage of some insects undergoing a complete metamorphosis between immature (larva) and mature (adult or imago) stages."@en;
        skos:definition        "Un organisme au stade nymphal. Stade de vie de certains insectes subissant une métamorphose complète entre les stades immature (larve) et mature (adulte ou imago)."@fr ;
        skos:notation          "SDN:S11::S1180";
        skos:note              "accepted"@en;
