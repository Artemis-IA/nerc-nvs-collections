        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Level 1B";
        skos:definition        "Level 1A data that have been processed to sensor units (not all instruments have Level 1B data products)."@en;
        skos:notation          "SDN:E02::1B";
        skos:note              "accepted"@en;
        skos:prefLabel         "Level 1B"@en .

<http://vocab.nerc.ac.uk/collection/E02/current/2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:E02::2";
        dc:date                "2016-02-01 09:33:06.0";
