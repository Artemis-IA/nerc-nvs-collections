<http://vocab.nerc.ac.uk/collection/M29/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies associated with the Ramsar Classification System for Wetland Type.";
        dc:alternative          "Ramsar classification";
        dc:creator              "Ramsar Convention on Wetlands vocabulary governance";
        dc:date                 "2022-08-19 03:00:01.0";
        dc:description          "A collection of terms used to classify wetland habitat types, as specified by the Ramsar Convention's (Ramsar, Iran, 1971) Classification System for Wetland Type, approved by Recommendation 4.7 and amended by Resolutions VI.5 and VII.11 of the Conference of the Contracting Parties.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Ramsar Classification System for Wetland Type";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Ramsar Convention on Wetlands vocabulary governance";
