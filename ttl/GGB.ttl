<http://vocab.nerc.ac.uk/collection/GGB/current/GGB23/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GGB::GGB23";
        dc:date                "2019-03-26 20:08:00.0";
        dc:identifier          "SDN:GGB::GGB23";
        pav:authoredOn         "2019-03-26 20:08:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GGB/current/GGB23/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Pre-generated grid - depth value is based on the GEBCO_08 Grid. This data set is a global grid at 30 arc-seconds. It was largely generated from a data base of ship-track soundings with interpolation between soundings guided by satellite-derived gravity data."@en;
        skos:definition        "Grille pré-générée — la valeur de profondeur est basée sur la grille GEBCO_08. Ce jeu de données est une grille globale à 30 secondes d'arc. Elle a été générée en grande partie à partir d'une base de données de sonages de routes de navires avec interpolation entre les sonages guidée par des données de gravité dérivées de satellites."@fr ;
        skos:notation          "SDN:GGB::GGB23";
        skos:note              "accepted"@en;
        skos:prefLabel         "GEBCO_2019_source_data_type_23"@en ;
        skos:prefLabel         "GEBCO_2019_source_data_type_23 (grille pré-générée GEBCO_08)"@fr .

<http://vocab.nerc.ac.uk/collection/GGB/current/GGB0/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GGB::GGB0";
