        dc:identifier          "SDN:C59::CONMEM";
        pav:authoredOn         "2009-05-07 10:20:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/5/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/1/> , <http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/2/> , <http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/4/> , <http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/3/>;
        pav:version            "5";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "5";
        skos:altLabel          "";
        skos:definition        "An organisation which forms part of a project consortium . A  project consortium is an association of two or more organisations with the objective of participating in a common activity or pooling their resources for achieving a common goal."@en;
        skos:notation          "SDN:C59::CONMEM";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project Member"@en .

