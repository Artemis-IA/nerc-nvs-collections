<http://vocab.nerc.ac.uk/collection/H05/current/H0500011/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500011";
        dc:date                "2026-03-18 13:46:55.0";
        dc:identifier          "SDN:H05::H0500011";
        pav:authoredOn         "2026-03-18 13:46:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500011/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H05/current/H0500011/1/> , <http://vocab.nerc.ac.uk/collection/H05/current/H0500011/3/> , <http://vocab.nerc.ac.uk/collection/H05/current/H0500011/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "PET";
        skos:altLabel          "PET"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/H05/current/H0500005/>;
        skos:definition        "The litter item is made of polyethylene terephthalate, a thermoplastic polymer resin of the polyester family used in fibres for clothing and containers for liquids and foods. It is used in thermoforming in manufacturing, and can be combined with glass fibre for engineering resins."@en;
        skos:definition        "L'objet du déchet est fait de polytéréphtalate d'éthylène, un polymère thermoplastique de la famille des polyesters utilisé dans les fibres pour l'habillement et les contenants pour liquides et aliments. Il est utilisé en thermoformage dans la fabrication et peut être combiné avec de la fibre de verre pour les résines d'ingénierie."@fr ;
        skos:notation          "SDN:H05::H0500011";
        skos:note              "accepted"@en;
        skos:prefLabel         "polyethylene terephthalate"@en;
        skos:prefLabel         "polytéréphtalate d'éthylène"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLS/> .

<http://vocab.nerc.ac.uk/collection/H05/current/H0500020/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500020";
        dc:date                "2022-10-25 12:24:48.0";
        dc:identifier          "SDN:H05::H0500020";
        pav:authoredOn         "2022-10-25 12:24:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500020/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The litter material consists of weathered oil conglomerations originating from natural or anthropogenic oil released in the environment."@en;
        skos:definition        "Le matériau du déchet consiste en des conglomérats de pétrole altérés, originaires de pétrole naturel ou anthropique libéré dans l'environnement."@fr ;
        skos:notation          "SDN:H05::H0500020";
        skos:note              "accepted"@en;
        skos:prefLabel         "tar residue"@en;
        skos:prefLabel         "résidu de goudron"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLS/> .

<http://vocab.nerc.ac.uk/collection/H05/current/H0500021/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500021";
        dc:date                "2022-10-25 12:25:36.0";
        dc:identifier          "SDN:H05::H0500021";
        pav:authoredOn         "2022-10-25 12:25:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500021/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The litter material consists of rubber from natural sources of polymers of the organic compound isoprene, with minor impurities of other organic compound; also called India rubber, latex, Amazonian rubber, caucho, or caoutchouc. Adapted from Wikipedia entry retrieved 18 October 2022."@en;
        skos:definition        "Le matériau du déchet consiste en du caoutchouc de sources naturelles de polymères du composé organique isoprène, avec des impuretés mineures d'autres composés organiques ; aussi appelé caoutchouc naturel, latex, caoutchouc amazonien, caucho ou caoutchouc. Adapté de l'entrée Wikipédia consultée le 18 octobre 2022."@fr ;
        skos:notation          "SDN:H05::H0500021";
        skos:note              "accepted"@en;
        skos:prefLabel         "natural rubber"@en;
        skos:prefLabel         "caoutchouc naturel"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLS/> .

