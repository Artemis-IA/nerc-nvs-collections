<http://vocab.nerc.ac.uk/collection/H05/current/H0500023/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500023";
        dc:date                "2022-10-25 12:27:48.0";
        dc:identifier          "SDN:H05::H0500023";
        pav:authoredOn         "2022-10-25 12:27:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500023/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The litter material consists of hard, transparent material made from the melting of sand (silica), soda ash (sodium carbonate) and limestone (calcium carbonate)."@en;
        skos:definition        "Le matériau du déchet consiste en un matériau dur et transparent obtenu par fusion de sable (silice), de carbonate de sodium (cendre de soude) et de calcaire (carbonate de calcium)."@fr ;
        skos:notation          "SDN:H05::H0500023";
        skos:note              "accepted"@en;
        skos:prefLabel         "glass"@en;
        skos:prefLabel         "verre"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLS/> .

<http://vocab.nerc.ac.uk/collection/H05/current/H0500024/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500024";
        dc:date                "2022-10-25 12:29:41.0";
        dc:identifier          "SDN:H05::H0500024";
        pav:authoredOn         "2022-10-25 12:29:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500024/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The litter material is metallic, i.e. a matter that, when freshly prepared, polished, or fractured, shows a lustrous appearance, and conducts electricity and heat relatively well. Adapted from Wikipedia entry retrieved 19 October 2022."@en;
        skos:definition        "Le matériau du déchet est métallique, c.-à-d. une matière qui, fraîchement préparée, polie ou brisée, présente un aspect lustré et conduit relativement bien l'électricité et la chaleur. Adapté de l'entrée Wikipédia consultée le 19 octobre 2022."@fr ;
        skos:notation          "SDN:H05::H0500024";
        skos:note              "accepted"@en;
        skos:prefLabel         "metal"@en;
        skos:prefLabel         "métal"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLS/> .

<http://vocab.nerc.ac.uk/collection/H05/current/H0500008/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500008";
        dc:date                "2026-03-18 11:58:08.0";
        dc:identifier          "SDN:H05::H0500008";
        pav:authoredOn         "2026-03-18 11:58:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500008/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H05/current/H0500008/2/> , <http://vocab.nerc.ac.uk/collection/H05/current/H0500008/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "PVAL";
        skos:altLabel          "PVAL"@fr ;
        skos:definition        "The litter item is made of polyvinyl alcohol,a water-soluble biocompatible synthetic polymer used in medical applications and the manufacturing of e.g. contact lenses, laundry detergent pods, Vinylon fiber, photographic film, etc."@en;
        skos:definition        "L'objet du déchet est fait d'alcool polyvinylique, un polymère synthétique biocompatible hydrosoluble utilisé dans les applications médicales et la fabrication de lentilles de contact, capsules de lessive, fibres Vinylon, films photographiques etc."@fr ;
        skos:notation          "SDN:H05::H0500008";
        skos:note              "accepted"@en;
        skos:prefLabel         "polyvinyl alcohol"@en;
        skos:prefLabel         "alcool polyvinylique"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLS/> .

<http://vocab.nerc.ac.uk/collection/H05/current/H0500007/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500007";
        dc:date                "2026-03-18 11:51:57.0";
        dc:identifier          "SDN:H05::H0500007";
        pav:authoredOn         "2026-03-18 11:51:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500007/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H05/current/H0500007/1/> , <http://vocab.nerc.ac.uk/collection/H05/current/H0500007/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "POM";
        skos:altLabel          "POM"@fr ;
        skos:definition        "The litter item is made of polyoxymethylene (also known as acetal, polyacetal and polyformaldehyde), a hard and strong thermoplastic used in high-performance components such as small gear wheels, eyeglass frames, ball bearings, fasteners, etc. The material is widely used in the automotive and consumer electronics industry."@en;
        skos:definition        "L'objet du déchet est fait de polyoxyméthylène (aussi appelé acétal, polyacétal et polyformaldéhyde), un thermoplastique dur et résistant utilisé dans les composants haute performance tels que petits engrenages, montures de lunettes, roulements à billes, fixations etc. Le matériau est largement utilisé dans l'industrie automobile et de l'électronique grand public."@fr ;
        skos:notation          "SDN:H05::H0500007";
        skos:note              "accepted"@en;
        skos:prefLabel         "polyoxymethylene"@en;
        skos:prefLabel         "polyoxyméthylène"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITPOLS/> .

