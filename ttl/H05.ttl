<http://vocab.nerc.ac.uk/collection/H05/current/H0500029/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H05::H0500029";
        dc:date                "2026-03-20 09:30:16.0";
        dc:identifier          "SDN:H05::H0500029";
        pav:authoredOn         "2026-03-20 09:30:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H05/current/H0500029/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PVC";
        skos:altLabel          "PVC"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/H05/current/H0500009/>;
        skos:definition        "The litter material is made of polyvinyl chloride, a widely used synthetic thermoplastic polymer derived from chlorine (salt) and carbon (from oil or gas) that exists in rigid and flexible forms (with the addition of plasticizers). It is used in a wide range of applications."@en;
        skos:definition        "Le matériau du déchet est fait de polychlorure de vinyle, un polymère thermoplastique synthétique largement utilisé, dérivé du chlore (sel) et du carbone (pétrole ou gaz), qui existe sous formes rigide et souple (avec ajout de plastifiants). Il est utilisé dans une large gamme d'applications."@fr ;
        skos:notation          "SDN:H05::H0500029";
        skos:note              "accepted"@en;
        skos:prefLabel         "polyvinyl chloride"@en ;
        skos:prefLabel         "polychlorure de vinyle"@fr .

