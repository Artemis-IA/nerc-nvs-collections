<http://vocab.nerc.ac.uk/collection/L13/current/AY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::AY";
        dc:date                "2013-02-05 12:39:17.0";
        dc:identifier          "SDN:L13::AY";
        pav:authoredOn         "2013-02-05 12:39:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/AY/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "abyssobenthic";
        skos:altLabel          "abyssobenthic"@fr ;
        skos:definition        "The zone of the seabed comprising the ocean floor with a bathymetric depth greater than  approximately 2700 metres where the bathyal fauna are replaced by more primitive abyssal fauna."@en;
        skos:definition        "La zone du fond marin comprenant le plancher océanique avec une profondeur bathymétrique supérieure à environ 2700 mètres où la faune bathyale est remplacée par une faune abyssale plus primitive."@fr ;
        skos:notation          "SDN:L13::AY";
        skos:note              "accepted"@en;
        skos:prefLabel         "abyssobenthic"@en ;
        skos:prefLabel         "abyssobenthic"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/BB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::BB";
        dc:date                "2020-05-20 21:09:54.0";
        dc:identifier          "SDN:L13::BB";
        pav:authoredOn         "2020-05-20 21:09:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/BB/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L13/current/BB/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "bathybenthic";
        skos:altLabel          "bathybenthic"@fr ;
        skos:definition        "The zone of the seabed between the permanent thermocline in the overlying water body and the limit of colonisation by bathyal fauna. It incorporates the lower part of the slope and the ocean floor to around 2700 metres bathymetric depth. It includes several faunal discontinuities."@en;
        skos:definition        "La zone du fond marin entre la thermocline permanente dans la masse d'eau sus-jacente et la limite de colonisation par la faune bathyale. Elle incorpore la partie inférieure de la pente et le plancher océanique jusqu'à environ 2700 mètres de profondeur bathymétrique. Elle comprend plusieurs discontinuités faunistiques."@fr ;
        skos:notation          "SDN:L13::BB";
        skos:note              "accepted"@en;
        skos:prefLabel         "bathybenthic"@en ;
        skos:prefLabel         "bathybenthic"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/DC/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::DC";
        dc:date                "2013-02-05 12:39:17.0";
        dc:identifier          "SDN:L13::DC";
        pav:authoredOn         "2013-02-05 12:39:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/DC/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "offshore_circalittoral";
        skos:altLabel          "offshore_circalittoral"@fr ;
        skos:definition        "The zone of the seabed between the depth to which storms and waves still influence the seabed (wave-base) and the marked break of slope that characterises the offshore limit of the shelf (shelf-break)."@en;
        skos:definition        "La zone du fond marin entre la profondeur jusqu'à laquelle les tempêtes et les vagues influencent encore le fond (base des vagues) et la rupture marquée de pente qui caractérise la limite au large du plateau continental (rupture du plateau)."@fr ;
        skos:notation          "SDN:L13::DC";
        skos:note              "accepted"@en;
        skos:prefLabel         "deep circalittoral"@en ;
        skos:prefLabel         "circalittoral profond"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/CL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::CL";
        dc:date                "2013-02-05 12:39:17.0";
        dc:identifier          "SDN:L13::CL";
        pav:authoredOn         "2013-02-05 12:39:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/CL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "circalittoral";
        skos:altLabel          "circalittoral"@fr ;
        skos:definition        "The zone of the seabed dominated by animals. On open coastline this is from bottom of the infralittoral zone to the depth to which storms and waves still influence the seabed (wave-base)."@en;
        skos:definition        "La zone du fond marin dominée par les animaux. Sur les côtes ouvertes, elle s'étend du bas de la zone infralittorale jusqu'à la profondeur où les tempêtes et les vagues influencent encore le fond (base des vagues)."@fr ;
        skos:notation          "SDN:L13::CL";
        skos:note              "accepted"@en;
        skos:prefLabel         "circalittoral"@en ;
        skos:prefLabel         "circalittoral"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/US/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::US";
        dc:date                "2013-02-05 12:39:17.0";
        dc:identifier          "SDN:L13::US";
        pav:authoredOn         "2013-02-05 12:39:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/US/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "upper_slope";
        skos:altLabel          "upper_slope"@fr ;
        skos:definition        "The zone of steeply-sloping seabed between the shelf-break and the permanent thermocline in the overlying water body."@en;
        skos:definition        "La zone de fond marin en forte pente entre la rupture du plateau continental et la thermocline permanente dans la masse d'eau sus-jacente."@fr ;
        skos:notation          "SDN:L13::US";
        skos:note              "accepted"@en;
        skos:prefLabel         "upper slope"@en ;
        skos:prefLabel         "pente supérieure"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/LI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::LI";
        dc:date                "2013-02-05 12:39:17.0";
        dc:identifier          "SDN:L13::LI";
        pav:authoredOn         "2013-02-05 12:39:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/LI/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "littoral";
        skos:altLabel          "littoral"@fr ;
        skos:definition        "That part of the shore (the fringe of a body of water that has been geologically modified by the action of that body of water past and present) above the low water mark and therefore exposed to the atmosphere at low tide."@en;
        skos:definition        "Cette partie du rivage (la frange d'une masse d'eau qui a été géologiquement modifiée par l'action de cette masse d'eau passée et présente) au-dessus de la ligne de basse mer et donc exposée à l'atmosphère à marée basse."@fr ;
        skos:notation          "SDN:L13::LI";
        skos:note              "accepted"@en;
        skos:prefLabel         "littoral"@en ;
        skos:prefLabel         "littoral"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/IL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::IL";
        dc:date                "2013-02-05 12:39:17.0";
        dc:identifier          "SDN:L13::IL";
        pav:authoredOn         "2013-02-05 12:39:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/IL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "infralittoral";
        skos:altLabel          "infralittoral"@fr ;
        skos:definition        "The zone of the seabed dominated by macroalgae below the low water mark. It extends to a depth where 1% of the surface illumination reaches the seabed, which varies according to turbidity."@en;
        skos:definition        "La zone du fond marin dominée par les macroalgues sous la ligne de basse mer. Elle s'étend jusqu'à une profondeur où 1 % de l'illumination de surface atteint le fond, ce qui varie selon la turbidité."@fr ;
        skos:notation          "SDN:L13::IL";
        skos:note              "accepted"@en;
        skos:prefLabel         "infralittoral"@en ;
        skos:prefLabel         "infralittoral"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/TH/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::TH";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::TH";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/TH/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "troposphere";
        skos:altLabel          "troposphere"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The  lowest broad layer of the atmosphere characterised by decreasing avearage temperature with height.  Typically from the surface to between 10 and 15 km."@en;
        skos:definition        "La couche atmosphérique la plus basse et la plus épaisse, caractérisée par une température moyenne décroissante avec l'altitude. Typiquement de la surface jusqu'à 10-15 km."@fr ;
        skos:notation          "SDN:L13::TH";
        skos:note              "accepted"@en;
        skos:prefLabel         "troposphere"@en;
        skos:prefLabel         "troposphere"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/SD/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::SD";
        dc:date                "2010-05-17 15:26:07.0";
        dc:identifier          "SDN:L13::SD";
        pav:authoredOn         "2010-05-17 15:26:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/SD/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L13/current/SD/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "sediment";
        skos:altLabel          "sédiment"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The unlithified sediments (of any grain size from silt to boulders) that form a layer between the solid crust and either the atmosphere or the water column."@en;
        skos:definition        "Les sédiments non lithifiés (de toute taille de grain, du silt aux blocs) qui forment une couche entre la croûte solide et soit l'atmosphère, soit la colonne d'eau."@fr ;
        skos:notation          "SDN:L13::SD";
        skos:note              "accepted"@en;
        skos:prefLabel         "soil and sediment"@en ;
        skos:prefLabel         "sol et sédiment"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/TP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::TP";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::TP";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/TP/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "tropopause";
        skos:altLabel          "tropopause"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The boundary between the troposphere and stratosphere, characterized by change in temperature gradient with height from decreasing below to increasing above. May extend over a few km in height. Typically lies somewhere between 10 and 15 km."@en;
        skos:definition        "La frontière entre la troposphère et la stratosphère, caractérisée par un changement du gradient de température avec l'altitude, décroissant en dessous et croissant au-dessus. Peut s'étendre sur quelques km de hauteur. Se situe typiquement quelque part entre 10 et 15 km."@fr ;
        skos:notation          "SDN:L13::TP";
        skos:note              "accepted"@en;
        skos:prefLabel         "tropopause"@en;
        skos:prefLabel         "tropopause"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/CO/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::CO";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::CO";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/CO/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "core";
        skos:altLabel          "noyau"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The central zone of the earth largely composed of solid or molten metal alloys, typically from the centre of the Earth to approximately 2900 km below the surface.."@en;
        skos:definition        "La zone centrale de la Terre, largement composée d'alliages métalliques solides ou en fusion, typiquement du centre de la Terre jusqu'à environ 2900 km sous la surface."@fr ;
        skos:notation          "SDN:L13::CO";
        skos:note              "accepted"@en;
        skos:prefLabel         "core"@en ;
        skos:prefLabel         "noyau"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/UK/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::UK";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::UK";
