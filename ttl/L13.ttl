        skos:altLabel          "thermopause"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The boundary between the thermosphere and the exosphere. Typically at about 400 km."@en;
        skos:definition        "La frontière entre la thermosphère et l'exosphère. Typiquement à environ 400 km."@fr ;
        skos:notation          "SDN:L13::TZ";
        skos:note              "accepted"@en;
        skos:prefLabel         "thermopause"@en;
        skos:prefLabel         "thermopause"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/CR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::CR";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::CR";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/CR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "crust";
        skos:altLabel          "croûte"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The layer of lithified rock between the unconsolidated sediment and the Moho seismic discontinuity. Typically 5-10 km thick beneath oceans and 60-70 km thick beneath continents."@en;
        skos:definition        "La couche de roche lithifiée entre le sédiment non consolidé et la discontinuité sismique de Moho. Typiquement de 5-10 km d'épaisseur sous les océans et de 60-70 km sous les continents."@fr ;
        skos:notation          "SDN:L13::CR";
        skos:note              "accepted"@en;
        skos:prefLabel         "crust"@en ;
        skos:prefLabel         "croûte"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/MP/>
        rdf:type               skos:Concept;
