        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The boundary between the mesosphere and the thermosphere characterised by a temperature minimum.  Typically lies somewhere between 80 and 90 km."@en;
        skos:definition        "La frontière entre la mésosphère et la thermosphère, caractérisée par un minimum de température. Se situe typiquement quelque part entre 80 et 90 km."@fr ;
        skos:notation          "SDN:L13::MP";
        skos:note              "accepted"@en;
        skos:prefLabel         "mesopause"@en;
        skos:prefLabel         "mésopause"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

