        skos:altLabel          "water_column_skin"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The zone a few microns thick at the extreme surface of the water column that is sampled by radiometers."@en;
        skos:definition        "La zone d'une épaisseur de quelques microns à la surface extrême de la colonne d'eau, échantillonnée par les radiomètres."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/> , <http://vocab.nerc.ac.uk/scheme/NETOC_VCOV/current/>;
        skos:notation          "SDN:L13::WS";
        skos:note              "accepted"@en;
        skos:prefLabel         "water column skin"@en;
        skos:prefLabel         "peau de la colonne d'eau"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/WTEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/SB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::SB";
        dc:date                "2010-05-17 15:28:38.0";
        dc:identifier          "SDN:L13::SB";
        pav:authoredOn         "2010-05-17 15:28:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/SB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "sediment_boundary";
        skos:altLabel          "sediment_boundary"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The upper surface (interface plus surficial substrate) of the layer of unlithified sediments (of any grain size from silt to boulders) that form a layer between the solid crust and either the atmosphere or the water column."@en;
        skos:definition        "La surface supérieure (interface plus substrat superficiel) de la couche de sédiments non lithifiés (de toute taille de grain, du silt aux blocs) qui forment une couche entre la croûte solide et soit l'atmosphère, soit la colonne d'eau."@fr ;
        skos:notation          "SDN:L13::SB";
        skos:note              "accepted"@en;
        skos:prefLabel         "soil and sediment boundary layer"@en ;
        skos:prefLabel         "couche limite sol et sédiment"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/HS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::HS";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::HS";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/HS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "homosphere";
        skos:altLabel          "homosphère"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The region of the atmosphere where gases are fully mixed by diffusion and turbulence. Lies between the surface (0 km) and the base of the heterosphere (at about 100 km)."@en;
        skos:definition        "La région de l'atmosphère où les gaz sont pleinement mélangés par diffusion et turbulence. Située entre la surface (0 km) et la base de l'hétérosphère (à environ 100 km)."@fr ;
        skos:notation          "SDN:L13::HS";
        skos:note              "accepted"@en;
        skos:prefLabel         "homosphere"@en;
        skos:prefLabel         "homosphère"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/ES/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::ES";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::ES";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/ES/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "exosphere";
        skos:altLabel          "exosphère"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The outermost layer of the atmosphere from which atoms can escape into outer space. Lies above the thermosphere from about 400 km in altitude."@en;
        skos:definition        "La couche la plus externe de l'atmosphère, d'où les atomes peuvent s'échapper vers l'espace. Située au-dessus de la thermosphère, à partir d'environ 400 km d'altitude."@fr ;
        skos:notation          "SDN:L13::ES";
        skos:note              "accepted"@en;
        skos:prefLabel         "exosphere"@en ;
        skos:prefLabel         "exosphère"@fr .

<http://vocab.nerc.ac.uk/collection/L13/current/SS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::SS";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::SS";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/SS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "stratosphere";
        skos:altLabel          "stratosphere"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The layer of the atmosphere from the tropopause to a height of approximately 50 km, characterised by increasing temperature with height."@en;
        skos:definition        "La couche de l'atmosphère de la tropopause jusqu'à une hauteur d'environ 50 km, caractérisée par une température croissante avec l'altitude."@fr ;
        skos:notation          "SDN:L13::SS";
        skos:note              "accepted"@en;
        skos:prefLabel         "stratosphere"@en;
        skos:prefLabel         "stratosphere"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/TS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::TS";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::TS";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/TS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "thermosphere";
        skos:altLabel          "thermosphère"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The atmospheric layer extending between heights of approximately 80 km to approximately 400 km characterised by rising temperature with height and phenomena associated with ionisation.  Part of the thermosphere is sometimes termed the ionosphere."@en;
        skos:definition        "La couche atmosphérique s'étendant entre environ 80 km et environ 400 km de hauteur, caractérisée par une température croissante avec l'altitude et des phénomènes associés à l'ionisation. Une partie de la thermosphère est parfois appelée ionosphère."@fr ;
        skos:notation          "SDN:L13::TS";
        skos:note              "accepted"@en;
        skos:prefLabel         "thermosphere"@en;
        skos:prefLabel         "thermosphère"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/TZ/>
        rdf:type               skos:Concept;
