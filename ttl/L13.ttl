<http://vocab.nerc.ac.uk/collection/L13/current/NB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::NB";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::NB";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/NB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "benthic_boundary";
        skos:altLabel          "benthic_boundary"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The water column that is significantly influenced by the seabed, which is broader in deep ocean than in shelf seas.  Guideline approximation is bottom 10m of oceans and bottom 5% of shelf (<200m) seas."@en;
        skos:definition        "La colonne d'eau significativement influencée par le fond marin, plus large en océan profond qu'en mer de plateau. L'approximation indicatrice est les 10 m inférieurs des océans et les 5 % inférieurs des mers de plateau (<200 m)."@fr ;
        skos:notation          "SDN:L13::NB";
        skos:note              "accepted"@en;
        skos:prefLabel         "benthic boundary layer"@en;
        skos:prefLabel         "couche limite benthique"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/SLCA/> , <http://vocab.nerc.ac.uk/collection/P25/current/NO3NO2/> , <http://vocab.nerc.ac.uk/collection/P25/current/SALIN/> , <http://vocab.nerc.ac.uk/collection/P25/current/NO3/> , <http://vocab.nerc.ac.uk/collection/P25/current/NO2/> , <http://vocab.nerc.ac.uk/collection/P25/current/WTEMP/> , <http://vocab.nerc.ac.uk/collection/P25/current/PO4/> .

