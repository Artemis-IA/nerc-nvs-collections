<http://vocab.nerc.ac.uk/collection/L13/current/HX/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::HX";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::HX";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/HX/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "heterosphere";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The region of the atmosphere where the mixing ratio of gases is differentiated by gravity. Lies above the homosphere, from about 100 km in altitude."@en;
        skos:notation          "SDN:L13::HX";
        skos:note              "accepted"@en;
        skos:prefLabel         "heterosphere"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/SP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::SP";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::SP";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/SP/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "stratopause";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The boundary between the stratosphere and the mesosphere characterised by a temperature maximum. Typically at about 50 km."@en;
        skos:notation          "SDN:L13::SP";
        skos:note              "accepted"@en;
        skos:prefLabel         "stratopause"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/MS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::MS";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::MS";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/MS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "mesosphere";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The layer of atmosphere overlying the stratospause characterised by decreasing temperature with height, typically from about 50 to about 80 km"@en;
        skos:notation          "SDN:L13::MS";
        skos:note              "accepted"@en;
        skos:prefLabel         "mesosphere"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/WS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::WS";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::WS";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/WS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "water_column_skin";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The zone a few microns thick at the extreme surface of the water column that is sampled by radiometers."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/> , <http://vocab.nerc.ac.uk/scheme/NETOC_VCOV/current/>;
        skos:notation          "SDN:L13::WS";
        skos:note              "accepted"@en;
        skos:prefLabel         "water column skin"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/WTEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/SB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::SB";
        dc:date                "2010-05-17 15:28:38.0";
        dc:identifier          "SDN:L13::SB";
        pav:authoredOn         "2010-05-17 15:28:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/SB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "sediment_boundary";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The upper surface (interface plus surficial substrate) of the layer of unlithified sediments (of any grain size from silt to boulders) that form a layer between the solid crust and either the atmosphere or the water column."@en;
        skos:notation          "SDN:L13::SB";
        skos:note              "accepted"@en;
        skos:prefLabel         "soil and sediment boundary layer"@en .

<http://vocab.nerc.ac.uk/collection/L13/current/HS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::HS";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::HS";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/HS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "homosphere";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The region of the atmosphere where gases are fully mixed by diffusion and turbulence. Lies between the surface (0 km) and the base of the heterosphere (at about 100 km)."@en;
        skos:notation          "SDN:L13::HS";
        skos:note              "accepted"@en;
        skos:prefLabel         "homosphere"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/ATEMP/> .

<http://vocab.nerc.ac.uk/collection/L13/current/ES/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L13::ES";
        dc:date                "2006-11-15 08:15:00.0";
        dc:identifier          "SDN:L13::ES";
        pav:authoredOn         "2006-11-15 08:15:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L13/current/ES/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "exosphere";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The outermost layer of the atmosphere from which atoms can escape into outer space. Lies above the thermosphere from about 400 km in altitude."@en;
        skos:notation          "SDN:L13::ES";
        skos:note              "accepted"@en;
        skos:prefLabel         "exosphere"@en .

