        skos:altLabel          "atmosphere_boundary"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The region of the atmosphere close enough to the Earth's surface for frictional effects of that surface to be significant. Typically not more than 1 km thick."@en;
        skos:definition        "La région de l'atmosphère suffisamment proche de la surface terrestre pour que les effets de friction de cette surface soient significatifs. Typiquement pas plus de 1 km d'épaisseur."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETOC_VCOV/current/> , <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/>;
        skos:notation          "SDN:L13::AB";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmospheric boundary layer"@en;
        skos:prefLabel         "couche limite atmosphérique"@fr ;
