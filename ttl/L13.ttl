        skos:altLabel          "epipelagic"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The water column zone in which for clear water there is adequate light for photosynthesis. Typically from  the surface down to a depth of approximately 200 metres."@en;
        skos:definition        "La zone de la colonne d'eau où, pour une eau claire, il y a une lumière adéquate pour la photosynthèse. Typiquement de la surface jusqu'à environ 200 mètres de profondeur."@fr ;
        skos:notation          "SDN:L13::U2";
        skos:note              "accepted"@en;
        skos:prefLabel         "epipelagic water column"@en;
        skos:prefLabel         "colonne d'eau épipélagique"@fr ;
