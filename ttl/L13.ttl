        skos:definition        "The water column zone penetrated by light, but in insufficient quantities for photosynthesis. Typically between depths of approximately 200 metres and 1000 metres."@en;
        skos:definition        "La zone de la colonne d'eau pénétrée par la lumière, mais en quantités insuffisantes pour la photosynthèse. Typiquement entre environ 200 et 1000 mètres de profondeur."@fr ;
        skos:notation          "SDN:L13::MW";
        skos:note              "accepted"@en;
        skos:prefLabel         "mesopelagic water column"@en;
