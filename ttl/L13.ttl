        skos:altLabel          "upper_epipelagic"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG16/>;
        skos:definition        "The strongly illuminated upper half of the epipelagic zone. Typically from the surface down to a depth of approximately 100 metres."@en;
        skos:definition        "La moitié supérieure fortement éclairée de la zone épipélagique. Typiquement de la surface jusqu'à environ 100 mètres de profondeur."@fr ;
        skos:notation          "SDN:L13::U1";
        skos:note              "accepted"@en;
        skos:prefLabel         "upper epipelagic water column"@en;
        skos:prefLabel         "colonne d'eau épipélagique supérieure"@fr ;
