        skos:notation          "SDN:M18::CONT_AMBER";
        skos:note              "accepted"@en;
        skos:prefLabel         "Amber jar"@en .

<http://vocab.nerc.ac.uk/collection/M18/current/CONT_WAX/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M18::CONT_WAX";
        dc:date                "2016-05-31 12:39:36.0";
        dc:identifier          "SDN:M18::CONT_WAX";
