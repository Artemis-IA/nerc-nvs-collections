<http://vocab.nerc.ac.uk/collection/M18/current/CONT_LINER/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M18::CONT_LINER";
        dc:date                "2016-05-31 12:39:36.0";
        dc:identifier          "SDN:M18::CONT_LINER";
        pav:authoredOn         "2016-05-31 12:39:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M18/current/CONT_LINER/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Liner";
        skos:definition        "Sample is stored within the hollow hard plastic liner which forms a boundary between the sample and the sampling apparatus, in which it was recovered."@en;
        skos:notation          "SDN:M18::CONT_LINER";
        skos:note              "accepted"@en;
        skos:prefLabel         "Plastic liner"@en .

<http://vocab.nerc.ac.uk/collection/M18/current/CONT_VIAL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M18::CONT_VIAL";
        dc:date                "2016-05-31 12:39:36.0";
        dc:identifier          "SDN:M18::CONT_VIAL";
        pav:authoredOn         "2016-05-31 12:39:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M18/current/CONT_VIAL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Vial";
        skos:definition        "The sample has been removed from the container that it was held in when it was sampled and has been transferred into a glass vial of undefined size."@en;
        skos:notation          "SDN:M18::CONT_VIAL";
        skos:note              "accepted"@en;
        skos:prefLabel         "Glass vial"@en .

<http://vocab.nerc.ac.uk/collection/M18/current/CONT_TUB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M18::CONT_TUB";
        dc:date                "2016-05-31 12:39:36.0";
        dc:identifier          "SDN:M18::CONT_TUB";
        pav:authoredOn         "2016-05-31 12:39:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M18/current/CONT_TUB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Tub";
        skos:definition        "The sample has been removed from the container that it was held in when it was sampled and has been transferred into a plastic tub of undefined size, being disturbed in the transfer."@en;
        skos:notation          "SDN:M18::CONT_TUB";
        skos:note              "accepted"@en;
        skos:prefLabel         "Plastic tub"@en .

<http://vocab.nerc.ac.uk/collection/M18/current/CONT_UNDIST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M18::CONT_UNDIST";
        dc:date                "2016-05-31 12:39:36.0";
        dc:identifier          "SDN:M18::CONT_UNDIST";
        pav:authoredOn         "2016-05-31 12:39:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M18/current/CONT_UNDIST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Undisturbed";
        skos:definition        "Sample remains in the sampling device that it was recovered by and has been set aside for offshore testing."@en;
        skos:notation          "SDN:M18::CONT_UNDIST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Undisturbed"@en .

<http://vocab.nerc.ac.uk/collection/M18/current/CONT_BAG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M18::CONT_BAG";
        dc:date                "2016-05-31 12:39:36.0";
        dc:identifier          "SDN:M18::CONT_BAG";
        pav:authoredOn         "2016-05-31 12:39:36.0";
