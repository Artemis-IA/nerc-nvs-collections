        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Wax";
        skos:definition        "The sample is wrapped in cling film, or foil or both and the ends are sealed with melted wax."@en;
        skos:notation          "SDN:M18::CONT_WAX";
        skos:note              "accepted"@en;
        skos:prefLabel         "Wax"@en .

