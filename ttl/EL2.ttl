        dc:publisher            "Natural Environment Research Council";
        dc:title                "SeaVoX Sampling and Observation Platform Event Processes";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "SeaDataNet and MarineXML Vocabulary Content Governance Group";
        owl:versionInfo         "1";
        skos:altLabel           "Platform Event Processes";
