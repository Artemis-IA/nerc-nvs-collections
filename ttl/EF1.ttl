<http://vocab.nerc.ac.uk/collection/EF1/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "A European project consortium aimed at the creation of broad-scale seabed habitat data products (EUSeaMap) using data amassed through SeaDataNet from surveys across Europe. The governance is loosely defined as the scientific expertise within the consortium with no formal processes defined.";
        dc:alternative          "EMODnet SeaHab Essential Fish Habitat";
        dc:creator              "EMODnet Seabed Habitats Lot";
        dc:date                 "2023-09-06 03:00:04.0";
        dc:description          "Terms used by the EMODnet Seabed Habitats Lot to define a list of habitats identified as essential to the ecological and biological requirements for critical life history stages of exploited fish species.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "EMODnet Seabed Habitats Essential Fish Habitat (EFH) vocabulary";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "EMODnet Seabed Habitats Lot";
        owl:versionInfo         "1";
        skos:altLabel           "EMODnet SeaHab Essential Fish Habitat";
        skos:member             <http://vocab.nerc.ac.uk/collection/EF1/current/SwG/> , <http://vocab.nerc.ac.uk/collection/EF1/current/NuG/> , <http://vocab.nerc.ac.uk/collection/EF1/current/FeeG/> , <http://vocab.nerc.ac.uk/collection/EF1/current/MiC/>;
        skos:prefLabel          "EMODnet Seabed Habitats Essential Fish Habitat (EFH) vocabulary" .
