        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Areas where there is clear evidence of spawning activity, including areas of known spawning aggregations or with high concentration of eggs."@en;
        skos:notation          "SDN:EF1::SwG";
        skos:note              "accepted"@en;
        skos:prefLabel         "Spawning grounds"@en .

