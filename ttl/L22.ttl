        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0002/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0611/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0611";
        dc:date                "2013-04-10 17:01:43.0";
        dc:identifier          "SDN:L22::TOOL0611";
        pav:authoredOn         "2013-04-10 17:01:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0611/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Suber SLS21 VACM";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/114/>;
        skos:definition        "A current meter fitted with a Savonius rotor magnetically coupled to a reed switch counter, a vane on tungsten carbide bearings magnetically coupled to a compass and solid-state crystal clock. Current vectors were continuously measured and then averaged after a specified time interval (generally 10 minutes) by an on-board minicomputer to produce the logged data values. Accuracy was 2 per cent for speed, 4 degrees for direction and 2 seconds per day for the clock. Casings were available for operating depths of 1000m, 3000m and 6000m.More information may be found in http://www.bodc.ac.uk/data/documents/nodb/19202/"@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0611";
        skos:note              "accepted"@en;
        skos:prefLabel         "Suber SLS21 vector-averaging current meter"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1759/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1759";
        dc:date                "2021-12-16 11:17:50.0";
        dc:identifier          "SDN:L22::TOOL1759";
        pav:authoredOn         "2021-12-16 11:17:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1759/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Isoprime Vision";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB48/>;
        skos:definition        "A laboratory instrument. It is used for mesauring the ratios of stable isotopes in a variety of applications such as in honey, ecology, geology and petroleum applications. It can aid in the measurement of 2H, 13C, 15N, 18O and 34S stable isotopes. It uses a thorium coated filament, stainless steel vacuum chamber, 100 V amplification and purge and trap chromatography for the separation of gases. It is also capable of headspace analysis. It is able to perform bulk and compound specific analysis through combination with other Elementar and Agilent technologies such as gas chromatography and elemental analysis."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1759";
        skos:note              "accepted"@en;
        skos:prefLabel         "Elementar Isoprime Vision {IRMS} isotopic ratio mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0197/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01860/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2310/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2310";
        dc:date                "2026-06-09 12:20:16.0";
        dc:identifier          "SDN:L22::TOOL2310";
        pav:authoredOn         "2026-06-09 12:20:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2310/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Mirion Germanium Well series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB22/>;
        skos:definition        "A series of germanium detectors for ionising radiation, particularly x rays and gamma rays, with a well-shaped detector geometry. The blind well shape improves absolute efficiency for small samples as the sample is virtually surrounded by active detector material with the counting geometry approaching 4 pi. These instruments are semiconductor diodes with an intrinsic (i) region that is sensitive to ionising radiation as well as a p electrode and an n electrode. When the diode operates under reverse bias an electric field extends over the intrinsic or depleted region. When photons interact with the material within the depleted volume of the detector, charge carriers are produced and are swept by the electric field to the p and n electrodes. This charge is in proportion to the energy deposited in the detector by the incoming photon. The charge is converted to a voltage pulse by an integral charge sensitive preamplifier. The Intelligent Preamplifier (iPA) unit included in these detectors employs dynamic charge restoration (RC feedback) and provides excellent resolution and count rate performance. The preamplifier can be set up and tuned using digital controls. The thin, ion-implanted contact on the detector element inside the well allows spectroscopy from 20 keV up to 10 MeV. Models differ in detector size and well diameters. These detectors must be cooled to maintain the energy resolution of the detector, so instruments are available to suit a range of associated cryostat configurations."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2310";
        skos:note              "accepted"@en;
        skos:prefLabel         "Mirion {Canberra} High-Purity Germanium (HPGE) Well Detector series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02110/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0392/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1778/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1778";
        dc:date                "2022-02-22 17:09:18.0";
        dc:identifier          "SDN:L22::TOOL1778";
        pav:authoredOn         "2022-02-22 17:09:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1778/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Aanderaa 3590";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A sensor for measuring average wind direction, designed for use with the Aanderaa SmartGuard and the Aanderaa Automatic Weather Station 2700. It can be mounted directly on the sensor arm of the Automatic Weather Station 2700, and can also be deployed on a Data Buoy Sensor Ring. This sensor consists of a wind vane on top of a magnetically-coupled compass. The compass consists of a sensing element mounted on an electronic card. In the sensing element is a follower magnet which follows the magnet on the wind vane. Four Hall elements measure the direction every second and a micro controller on the electronic card calculates the average direction in the measuring period. When direction is to be read, the compass will read out the average reading since the last reading was taken. The housing bearing the compass must be orientated towards North or to a reference point like a ship's centre-line for an ordinary degree indication. A non-averaging version (3590B) is also available. The 3590 has a measurement range of 0 to 360 degrees magnetic and requires a threshold wind speed of 0.3 m/s. It has an accuracy +/- 5 degrees and an operating temperature from -40 to +65 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1778";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa 3590 wind direction sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0007/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0204/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0204";
        dc:date                "2023-12-15 10:14:05.0";
        dc:identifier          "SDN:L22::NETT0204";
