<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1170/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1170";
        dc:date                "2017-11-23 13:03:21.0";
        dc:identifier          "SDN:L22::TOOL1170";
