        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Motoda cod-end sampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "Construction is a 15.5 cm diameter mouth opening and 35.5 cm long body attached to 57 cm diameter net 200 cm long with bolting cloth 42.5 meshes per inch in upper 120 cm and 56.5 meshes per inch in lower 80 cm [Wiebe and Benfield 2003 Plate 25 A]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0024";
        skos:note              "accepted"@en;
        skos:prefLabel         "Cod-end sampler - Motoda (1953)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0043/>
        rdf:type               skos:Concept;
