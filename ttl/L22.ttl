<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1903/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1903";
        dc:date                "2023-02-28 13:24:26.0";
        dc:identifier          "SDN:L22::TOOL1903";
        pav:authoredOn         "2023-02-28 13:24:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1903/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "WET Labs CST-10-DR";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/124/>;
        skos:definition        "An underwater optical beam transmissometer capable of free-space measurements or mounting in a flow tube with a pump, with underway, moored or profiling applications. The instrument outputs calculated beam attenuation, with 14-bit digital or analog output. Sample rate is up to 8 Hz and spectral bandwidth is ~20 nm. This model has a path length of 10 cm, wavelength of 650 nm (red) and is depth rated to 6000 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1903";
        skos:note              "accepted"@en;
        skos:prefLabel         "WET Labs {Sea-Bird WETLabs} C-Star CST-10-DR transmissometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0026/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0441/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0441";
        dc:date                "2024-08-19 16:42:13.0";
        dc:identifier          "SDN:L22::TOOL0441";
        pav:authoredOn         "2024-08-19 16:42:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0441/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0441/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "LISST-100-B";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/124/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "The Sequoia Laser In-Situ Scattering and Transmissometry (LISST)-100-B is a self-contained unit which measures the scattering of LASER light at a number of angles. This primary measurement is mathematically inverted to give a grain size distribution, and also scaled to obtain the volume scattering function. The size distribution is presented as concentration in each of the grain-size class bins. The instrument has an optical path length of 5 cm as standard (2.5 cm optional) and measures particles over the size range 1.2 - 250 um in 32 log-spaced size classes. The standard maximum sampling speed is 4 size distributions per second and the instrument has a depth rating of 300 m. Optical transmission, water depth and temperature are recorded as supporting measurements."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0441";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sequoia LISST-100-B particle size analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00275/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0834/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0834";
        dc:date                "2023-02-07 17:08:15.0";
        dc:identifier          "SDN:L22::TOOL0834";
        pav:authoredOn         "2023-02-07 17:08:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0834/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0834/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "WET Labs ac-s";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/124/>;
        skos:definition        "The WET Labs ac-s in-situ spectrophotometer is based on the ac-9 flow through sensor offering increased spectral resolution of in-situ absorption and beam attenuation. The ac-s can have 80 (+/- 5) wavelength outputs with a range of 400-730 nm. The ac-s consists of a 10 or 25 cm  pathlength, a 4nm resolution, an accuracy of 0.001 - 10 m-1, an operational temperature range of  0 - 30  deg C and an operational depth rating of 500 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0834";
        skos:note              "accepted"@en;
        skos:prefLabel         "WET Labs {Sea-Bird WETLabs} ac-s in-situ spectrophotometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0026/> .

