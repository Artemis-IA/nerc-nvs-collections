        skos:notation          "SDN:L22::TOOL0931";
        skos:note              "accepted"@en;
        skos:prefLabel         "Paroscientific Digiquartz depth sensors"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00525/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0475/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0475";
        dc:date                "2012-02-29 16:34:45.0";
        dc:identifier          "SDN:L22::TOOL0475";
        pav:authoredOn         "2012-02-29 16:34:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0475/1/>;
