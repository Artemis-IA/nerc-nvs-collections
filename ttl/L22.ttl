<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1814/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1814";
        dc:date                "2022-06-28 09:52:51.0";
        dc:identifier          "SDN:L22::TOOL1814";
