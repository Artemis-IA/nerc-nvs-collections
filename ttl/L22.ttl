<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2255/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2255";
        dc:date                "2026-01-22 11:17:35.0";
        dc:identifier          "SDN:L22::TOOL2255";
        pav:authoredOn         "2026-01-22 11:17:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2255/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Idronaut OS 310 CTD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/355/> , <http://vocab.nerc.ac.uk/collection/L05/current/130/> , <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "A fast response, multi-parameter conductivity, temperature, depth (pressure), oxygen, pH, and redox probe. The OS310 does not require any pumps or external devices to flush the sensors, minimising power consumption, allowing it to be integrated/adapted into third-party platforms such as floating profilers, moorings, ROVs, and AUVs. It can be interfaced with other instruments. The OS310 can sample at rates between 1 to 28 Hz (samples per second). It features a platinum resistance thermometer with a response time of 50 ms. The conductivity cell is a high accuracy seven-platinum-ring quartz cell. The dimensions are designed to guarantee self-flushing and no clogging after long-term deployment. An optional 280 nm UV LED is available for integration into the conductivity cell to sterilise the sample under measurement, and prevent the early growth of biofouling inside the quartz measuring cell. Data memory is 4 GB. Ranges are 0 to 7000 dbar (pressure), -5 to 50 degC (temperature), 0 to 70 mS/cm (salt water conductivity), 0 to 7000 microS/cm (fresh water conductivity), 0 to 50 ppm (polarographic determination of oxygen), 0 to 500 %sat (polarographic determination of oxygen saturation), 0 to 44 mg/l (optical determination of oxygen), 0 to 500 %sat (optical determination of oxygen), 1 to 13 pH (pH), -1000 to 1000 mV (redox). Initial accuracies are 0.05% FS (pressure), 0.0015 degC (temperature), 0.003 mS/cm (salt water conductivity), 5 microS/cm (fresh water conductivity), 0.1 ppm (polarographic determination of oxygen), 1 %sat (polarographic determination of oxygen saturation), 0.1 mg/l (optical determination of oxygen), 1 %sat (optical determination of oxygen), 0.01 pH (pH), 1 mV (redox). Resolutions 0.002% FS (pressure), 0.0001 degC (temperature), 0.0001 mS/cm (salt water conductivity), 0.1 microS/cm (fresh water conductivity), 0.01 ppm (polarographic determination of oxygen), 0.1 %sat (polarographic determination of oxygen saturation), 0.025 mg/l (optical determination of oxygen), 0.25 %sat (optical determination of oxygen), 0.0001 pH (pH), 0.1 mV (redox)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2255";
        skos:note              "accepted"@en;
        skos:prefLabel         "IDRONAUT Ocean Seven 310 CTD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0330/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00410/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1144/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1144";
        dc:date                "2017-07-26 11:43:10.0";
        dc:identifier          "SDN:L22::TOOL1144";
        pav:authoredOn         "2017-07-26 11:43:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1144/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PreSens OXY-10 Mini";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "The OXY-10 mini is a precise multi-channel oxygen meter for up to 10 'in-house' sensors, simultaneously controlling and reading them. The meter is used with oxygen sensors based on a 2mm optical fibre. The meter is compatible with sensors that are type PSt3 which has a detection limit 15 ppb, 0 - 100% oxygen."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1144";
        skos:note              "accepted"@en;
        skos:prefLabel         "PreSens OXY-10 Mini oxygen meter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01086/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0805/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0805";
        dc:date                "2025-04-30 15:31:55.0";
        dc:identifier          "SDN:L22::TOOL0805";
        pav:authoredOn         "2025-04-30 15:31:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0805/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0805/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "AA optode";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "A generic label for a range of dissolved oxygen sensors produced by Aanderaa covering various mounting options. Each has a specific model number but in this case it is not known. All make measurements based on the ability of selected substances to act as dynamic fluorescence quenchers. The fluorescent indicator is a special platinum porphyrin complex embedded in a gas permeable foil that is exposed to the surrounding water. A black optical isolation coating protects the complex from sunlight and fluorescent particles in the water. This sensing foil is attached to a window providing optical access for the measuring system from inside a watertight titanium housing.The foil is excited by modulated blue light, and the phase of a returned red light is measured. By linearizing and temperature compensating, with an incorporated temperature sensor, the absolute O2 concentration can be determined."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0805";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa optode"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0007/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2094/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2094";
        dc:date                "2024-09-05 12:02:35.0";
        dc:identifier          "SDN:L22::TOOL2094";
        pav:authoredOn         "2024-09-05 12:02:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2094/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GO 8060 pCO2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "An autonomous analytical system for measuring carbon dioxide in oceanic surface water. The system is an enhanced redesign of the previous 8050 model, necessitated by the discontinuation of the LI-7000 gas analyser. The model 8060 uses the LI-7815 gas analyser and consists of a headspace equilibrator, an infrared CO2 analyser, a network of valves and pumps, a barometer enclosure plus integrated computer and software. The following optional interface kits can be integrated: Seapoint Turbidity Meter, Seapoint Chlorophyll Fluorometer, Anderaa 4835 Oxygen Optode, Seabird SBE45 Thermosalinograph, Picarro G2301 analser and the Adam PPC-3120H touchscreen computer. It measures: pressure (flow) from 0 to 1 bar at 0.05 percent accuracy and of 0.0015 percent resolution; temperature from -3 to +50 degC; conductivity from 0 to 90 mS/cm at 0.0015 mS/cm accuracy; oxygen from 0 to 45 mg/l at 0.1 mg/l accuracy (250 percent saturation); pH from 0 to 14 pH at 0.01 pH accuracy; redox from -1000 to +1000 mV at 1 mV accuracy and 0.1 mV resolution."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2094";
        skos:note              "accepted"@en;
        skos:prefLabel         "General Oceanics model 8060 pCO2 measuring system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00617/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0306/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1421/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1421";
        dc:date                "2024-07-22 10:34:38.0";
        dc:identifier          "SDN:L22::TOOL1421";
        pav:authoredOn         "2024-07-22 10:34:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1421/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1421/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "AA optode 3930";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "A dissolved oxygen sensor which can be connected via cable to AADI SR10/VR22 Data logger. Measurement based on the ability of selected substances to act as dynamic fluorescence quenchers. The fluorescent indicator is a special platinum porphyrin complex embedded in a gas permeable foil that is exposed to the surrounding water. A black optical isolation coating protects the complex from sunlight and fluorescent particles in the water. This sensing foil is attached to a window providing optical access for the measuring system from inside a watertight titanium housing (depth rating 6000m). The foil is excited by modulated blue light, and the phase of a returned red light is measured. By linearizing and temperature compensating, with an incorporated temperature sensor, the absolute O2 concentration can be determined. Accuracy < 8uM or 5% (whichever is greater)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1421";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa 3930 oxygen optode"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0007/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1233/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1233";
        dc:date                "2018-04-26 15:12:13.0";
        dc:identifier          "SDN:L22::TOOL1233";
        pav:authoredOn         "2018-04-26 15:12:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1233/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SBE 43I DO";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "High performance through-flow Clark polarographic membrane sensor designed to be interfaced to a SBE 41 or 41CP Argo float CTD. Designed specifically to give rapid temperature response and minimal pressure hysteresis. Signal output is frequency based and sensor power and signal conditioning circuits are relocated to the CTD electronics board. Measurement range: 0-120 % of saturation (minimum). Initial accuracy: 1 % of saturation. Observed stability: less than 1 micro-molar/year. Depth rating: 2000 dbar."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1233";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird SBE 43 I (integral) dissolved oxygen sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> .

