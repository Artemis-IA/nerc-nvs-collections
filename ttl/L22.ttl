<http://vocab.nerc.ac.uk/collection/L22/current/NETT0199/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0199";
        dc:date                "2021-11-16 09:18:10.0";
        dc:identifier          "SDN:L22::NETT0199";
        pav:authoredOn         "2021-11-16 09:18:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0199/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "AMT 18 plankton net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "Construction is 3 conical nets with mesh sizes 180, 100 and 40 um. Each net comprises an 18 cm mouth opening using a plastic inverted cone to reduce the diameter from approx. 40 cm to 18 cm. The nets were conical with an outer diameter of approx. 40 cm and a closed cod-end design."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0199";
        skos:note              "accepted"@en;
        skos:prefLabel         "Custom 3 x 18 cm mouth opening x 40 cm diameter conical nets plankton net - AMT 18 (2008)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0002/> .

