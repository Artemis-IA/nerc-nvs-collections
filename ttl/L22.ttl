<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2239/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2239";
        dc:date                "2025-11-10 16:36:53.0";
        dc:identifier          "SDN:L22::TOOL2239";
        pav:authoredOn         "2025-11-10 16:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2239/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Neil Brown 100 series CT";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/130/>;
        skos:definition        "A series of conductivity-temperature sensors designed to integrate with mobile platforms. CT 100 series sensors consist of an externally mounted CT cell and an internally mounted precision electronics board. Available models come in rectangular and cylindrical form to suit application. Temperature standard range: 0 to 30 degrees C (-5 to 60 degrees C extended range); Initial accuracy: 0.002 degrees C; Resolution: 0.0001 degrees C. Conductivity standard range: 0 to 60 mS/cm; Initial accuracy: 0.01 mS/cm; Resolution: 0.0001 mS/cm. Suitable for use up to 6750 dbar pressure."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2239";
        skos:note              "accepted"@en;
        skos:prefLabel         "Neil Brown 100 series CT sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0367/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02145/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2012/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2012";
        dc:date                "2024-02-07 12:00:02.0";
        dc:identifier          "SDN:L22::TOOL2012";
        pav:authoredOn         "2024-02-07 12:00:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2012/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RBR argo3 CTD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/130/>;
        skos:definition        "An instrument comprising conductivity, temperature, and pressure sensors, specifically designed for the Argo program. It is suitable for integration with profiling floats and can withstand air deployments. Derived channels for salinity, sound speed and density are built in. Atmospheric measurements can also be obtained and used to estimate sensor drift. The RBR argo3 CTD uses an inductive conductivity sensor, which does not require a pump and is accurate to within 10 cm of the air-ocean interface. The instrument's streamlined design minimises salinity spiking; it is built out of organic solderability preservative (OSP) and titanium. Features include a power consumption of approximately 24 mJ per sample, sampling rate of up to 8 Hz, and storage capacity of approximately 120 million readings. The depth rating can be configured to either 2000 dbar or 4000 dbar. A range of biogeochemical (BGC) sensors are available, including dissolved oxygen, fluorescence, PAR, and pH. Other specifications include: conductivity range between 0 and 85 mS/cm, accuracy of +/- 0.003 mS/cm, and resolution of 0.001 mS/cm; temperature range between -5 and 35 degC, accuracy of +/- 0.002 degC, and resolution of 0.00005 degC; depth accuracy of +/- 0.05% full scale, and resolution of 0.001% full scale."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2012";
        skos:note              "accepted"@en;
        skos:prefLabel         "RBR argo3 CTD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00299/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0049/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1422/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1422";
        dc:date                "2020-04-29 10:03:09.0";
        dc:identifier          "SDN:L22::TOOL1422";
        pav:authoredOn         "2020-04-29 10:03:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1422/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "AML Minos X CTD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/130/>;
        skos:definition        "A compact combined CTD/SVP. Minos X is the mid-size logger of the X Series family. It is designed primarily for small boat and hand deployed operations. It provides all the capabilities and accuracy of the larger Plus X instruments, but trades off battery capacity and additional sensor channels in favour of reduced weight and size. The instrument can measure conductivity, temperature, pressure, turbidity and sound velocity depending on the configuration of optional sensors. Minos X is capable of logging continuously for 38 hours with a full battery charge. The actual life varies somewhat depending on the sensors installed. Sampling rates are programmable by time (25 Hz to every 24 hours), by pressure (0.1 dbar or greater increments), or by sound speed (0.1 m/s or greater increments). When logging at time intervals of 25 seconds or more, Minos X powers down between samples to conserve the batteries. Also available as an SVPT. For those surveying beyond 1000 m, deep water Minos X in titanium housing will withstand the harshest of environments. Available with Data Xchange to enable WiFi communication, automatic data transfer, and integrated GPS positioning."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1422";
        skos:note              "accepted"@en;
        skos:prefLabel         "AML Oceanographic Minos X CTD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0032/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01192/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0034/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0034";
        dc:date                "2009-11-30 11:56:35.0";
        dc:identifier          "SDN:L22::TOOL0034";
        pav:authoredOn         "2009-11-30 11:56:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0034/1/>;
        pav:version            "1";
