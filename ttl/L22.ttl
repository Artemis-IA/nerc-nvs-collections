<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1141/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1141";
        dc:date                "2023-02-07 17:08:15.0";
        dc:identifier          "SDN:L22::TOOL1141";
        pav:authoredOn         "2023-02-07 17:08:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1141/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1141/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "WET Labs ECO FLBBCD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/123/> , <http://vocab.nerc.ac.uk/collection/L05/current/113/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "A combined three channel ECO back scatter sensor for floats. It measures proxies of phytoplankton abundance (chlorophyll fluorescence), total particle concentration (backscattering, 700 nm), and dissolved organic matter (CDOM fluorescence) in a single data stream. It has an in-water centroid angle of 124 degrees and is housed in aluminium. The sensor can be fitted with optional temperature and pressure sensor. It has an operating temperature range of 0-30 degrees Celsius and operating depth range of 2000 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1141";
        skos:note              "accepted"@en;
        skos:prefLabel         "WET Labs {Sea-Bird WETLabs} ECO FLBBCD scattering fluorescence sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0026/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1309/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1309";
        dc:date                "2023-02-07 17:08:16.0";
        dc:identifier          "SDN:L22::TOOL1309";
