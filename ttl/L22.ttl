        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB20/>;
        skos:definition        "The Lambda spectrophotometer provides UV-Visibility (UV-Vis) capability over a spectral range of 190 - 1100 nm. Variable  bandwidth of 0.5 - 4 nm, contains a pre-monochromator (unlike the LAMBDA 25 and 35) and has an absorbance range of 3.5 A."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0948";
