<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2243/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2243";
        dc:date                "2025-12-03 15:40:33.0";
        dc:identifier          "SDN:L22::TOOL2243";
        pav:authoredOn         "2025-12-03 15:40:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2243/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Airmar 220WX";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "Airmar Ultrasonic WeatherStation 220WX is a compact meteorological station designed to provide real-time, site-specific weather information on moving platforms. The instrument can measure wind speed and direction, barometric pressure, temperature, relative humidity, GPS, speed and course over ground, and pitch and roll. The device operates at a temperature range of -25 degC to 55 degC and measures: a barometric pressure range of 300 to 1100 hPa (accuracy of +/- 0.5 hPa at 25 degC); wind speeds of up to 40 m/s (with an accuracy of 5% at 10 m/s); and an air temperature range of -40 to 80 degC (with an accuracy of +/- 1.1 degC at 20 degC). Output options include NMEA 0183 and NMEA 2000."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2243";
        skos:note              "accepted"@en;
        skos:prefLabel         "Airmar Ultrasonic WeatherStation 220WX"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01046/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0319/> .

