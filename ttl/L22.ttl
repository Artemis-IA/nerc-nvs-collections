        skos:altLabel          "CS 50Y Temperature and Relative Humidity Probe";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A meteorological probe that uses a 1000 ohm platinum resistance thermometer to measure temperature and a Vaisala (INTERCAP) capacitive humidity sensor to measure relative humidity. The instrument has a total operating range of -40 degC to +60 degC for temperature and a range of 0 to 100 percent for relative humidity."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0646";
        skos:note              "accepted"@en;
        skos:prefLabel         "Campbell Scientific 50Y Temperature and Relative Humidity Probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00414/> , <http://vocab.nerc.ac.uk/collection/P01/current/CTMPZZ01/> , <http://vocab.nerc.ac.uk/collection/P01/current/CRELZZ01/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2326/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2326";
        dc:date                "2026-08-11 08:56:23.0";
