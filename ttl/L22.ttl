        skos:definition        "A marine positioning system which comprises a MX200 Control and Display Unit (CDU) of unknown sub-model, fitted to an unknown GPS receiver model. The navigation system has since been replaced by the MX512."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0933";
