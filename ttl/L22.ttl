        skos:altLabel          "Cassie high-speed net model I";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/67/>;
        skos:definition        "A brass cylinder 6 cm diameter and 6 cm long with bridle attachment lugs that had a 180 cm bolting cloth net (16 or 30 meshes per cm) attached to the back [Wiebe and Benfield 2003 Plate 18 A ]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0059";
        skos:note              "accepted"@en;
