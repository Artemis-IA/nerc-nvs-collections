        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/>;
        skos:definition        "A 4-beam 150 kHz instrument designed for moored instrument applications at depths down to 1500 m as standard or 3000 m and 600 m as options. Effective measurement range is 300 m with up to 255 bins each 2 - 24 m deep. Velocity accuracy is the greater of 1 % or 0.5 cm/s.  More information is available at http://www.rdinstruments.com/datasheets/quartermaster_ds.pdf."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0732";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Quartermaster 150 kHz ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0866/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0866";
        dc:date                "2022-06-08 17:11:26.0";
        dc:identifier          "SDN:L22::TOOL0866";
        pav:authoredOn         "2022-06-08 17:11:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0866/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0866/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Ultra Electronics Fluxgate";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/159/>;
        skos:definition        "Instrument measures shifts in the magnetic patterns on the sea floor. A typical fluxgate magnetometer consists of a secondary coil surrounding a primary coil that is wound around permeable core material. An alternating current is applied which drives the core into plus and minus saturation to assist detecting the external magnetic field"@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0866";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ultra Electronics 3-axis Fluxgate magnetometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00957/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1849/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1849";
        dc:date                "2022-09-27 10:57:36.0";
        dc:identifier          "SDN:L22::TOOL1849";
        pav:authoredOn         "2022-09-27 10:57:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1849/1/>;
