        skos:definition        "A 55 cm net opening diameter 34 cm long made of canvas; 25 cm diameter conical section 68 cm long made of silk netting (no size given).  [Wiebe and Benfield 2003 Plate 10 B]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0167";
