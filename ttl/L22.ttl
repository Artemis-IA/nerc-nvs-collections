        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/101/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "An anemometer with a four blade helicoid propeller and lightweight direction vane. Vane angle is sensed by a precision potentiometer. The instrument body is UV stabilised plastic with stainless steel and anodised aluminium fittings. The instrument mounts on standard 1 inch pipe. Windspeed accuracy is +/- 0.3 m/s and wind direction accuracy is 3 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0260";
