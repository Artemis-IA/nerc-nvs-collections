<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0663/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0663";
        dc:date                "2014-02-06 10:11:22.0";
        dc:identifier          "SDN:L22::TOOL0663";
        pav:authoredOn         "2014-02-06 10:11:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0663/1/>;
