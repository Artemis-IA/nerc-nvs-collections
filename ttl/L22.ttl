        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HEADCM01/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0101/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0101";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0101";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0101/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sameto MPS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/68/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/23/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "A 100 cm x 100 cm mouth opening with 10 nets (0.243 mm mesh ).  Net length not given.  Non-rigid mouth opening with net bars similar in design to MOCNESS that slide down cables.  A depressor is mounted below the bottom net bar.  System powered electrically on conducting wire and controlled from surface deck unit. Data logging included depth, roll, pitch, and temperature. A non-telemetering flowmeter was mounted in each net [Wiebe and Benfield 2003 Plate 30 A]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0101";
        skos:note              "accepted"@en;
        skos:prefLabel         "Multiple Plankton Sampler based on MOCNESS and NIO nets - Sameoto et al. (1977)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0378/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0378";
        dc:date                "2024-08-23 15:47:12.0";
        dc:identifier          "SDN:L22::TOOL0378";
        pav:authoredOn         "2024-08-23 15:47:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0378/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0378/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0378/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "RDI WN 300 kHz DVL CP PS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/379/>;
        skos:definition        "A Doppler velocity log (DVL) measuring bottom track and water track velocities, altitude, heading, tilt, temperature, echo intensity, pressure and current velocities. 300 kHz Broadband signal processing gives high data resolution and a four-beam solution gives an independent error velocity measurement as an indicator of data quality. It has a bottom track range of 200 m and velocity accuracy for both bottom and water track modes is 0.4 % of the velocity, +/- 0.2 cm/s. The instrument operates effectively over a temperature range of -5 to 45 degC and with a tilt of up to +/- 15 deg."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0378";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Navigator 300 kHz Doppler velocity log, current profiler and pressure sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0377/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0377";
        dc:date                "2024-08-23 15:47:12.0";
        dc:identifier          "SDN:L22::TOOL0377";
        pav:authoredOn         "2024-08-23 15:47:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0377/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0377/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0377/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "RDI WN 300 kHz DVL";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/379/>;
        skos:definition        "A Doppler velocity log (DVL) measuring bottom track and water track velocities, altitude, heading, tilt, temperature and echo intensity. 300 kHz Broadband signal processing gives high data resolution and a four-beam solution gives an independent error velocity measurement as an indicator of data quality. It has a bottom track range of 200 m and velocity accuracy for both bottom and water track modes is 0.4 % of the velocity, +/- 0.2 cm/s. The instrument operates effectively over a temperature range of -5 to 45 degC and with a tilt of up to +/- 15 deg."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0377";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Navigator 300 kHz Doppler velocity log"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1608/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1608";
        dc:date                "2021-02-03 09:56:26.0";
        dc:identifier          "SDN:L22::TOOL1608";
        pav:authoredOn         "2021-02-03 09:56:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1608/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sperry NAVIGAT 3000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A fibre-optic gyrocompass and attitude system. Designed for Mega Yachts, Cargo Vessels and Cruise Liners. Solid state sensor that has no moving parts and does not require a gimbal. Includes 12 serial interfaces for heading repeaters plus 6 serial interfaces for heading receivers and analogue outputs. Also includes 2 dependent 6 steps/degree heading outputs. Heading accuracy is <= 0.4 degrees secant latitude RMS. Roll/pitch angle accuracy is <= 0.1 degrees (for angles <= 45 degrees RMS). Rate of turn accuracy is < = 0.018 degrees/min. x/y rate accuracy is <= 0.4 degrees/min. Heave accuracy is 0.1 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1608";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sperry Marine NAVIGAT 3000 gyrocompass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00586/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0138/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0902/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0902";
        dc:date                "2015-09-07 16:08:43.0";
        dc:identifier          "SDN:L22::TOOL0902";
        pav:authoredOn         "2015-09-07 16:08:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0902/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0902/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Yokogawa CMZ700B gyro";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A gyrocompass system for use on small high-speed turning vessels. It detects the direction of true north by means of a fast-spinning rotor, which is suspended with no friction and is influenced by gravity and rotation of the Earth. The system comprises a master compass unit which drives the repeaters directly without the need for a control box. The compass container mass reduces the burden to the compass motor (stepping motor) which results in a follow-up speed of 30 degrees/s. The accuracy is +/-0.25 degrees for static errors and +/-0.75 degrees for dynamic errors."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0902";
        skos:note              "accepted"@en;
        skos:prefLabel         "Yokogawa CMZ700B gyrocompass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00966/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2119/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2119";
        dc:date                "2024-11-11 15:49:56.0";
        dc:identifier          "SDN:L22::TOOL2119";
        pav:authoredOn         "2024-11-11 15:49:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2119/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MTi-320";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "The MTi-320 is a compact, high-performance Active Heading Tracker (AHT) designed for embedded applications that require precise motion tracking. It fuses data from a gyroscope, accelerometer, and magnetometer to deliver accurate orientation and heading measurements. The instrument utilises Xsens' optimised strapdown algorithm (AttitudeEngine), the sensor is capable of high-speed, real-time dead-reckoning calculations at 1 kHz, accurately capturing high-frequency motions. The device is IP51-rated and supports a wide operating temperature range from -40°C to 85°C. It is supported by a graphical user interface (GUI) and is compatible with the MT Software Suite, providing tools for integration and development across various platforms, including ROS. The MTi-320 offers 0.5 degrees RMS roll/pitch accuracy, a 1 kHz update rate, a 2000 deg/S gyroscope range, 16 g accelerometer range, and a +/- 8 G magnetometer range, with 0.2% linearity, 0.25 mG resolution, and 0.5 mG total RMS noise."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2119";
        skos:note              "accepted"@en;
        skos:prefLabel         "Movella Xsens MTi-320 active heading tracker"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02077/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0315/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1816/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1816";
        dc:date                "2022-07-05 12:25:39.0";
        dc:identifier          "SDN:L22::TOOL1816";
        pav:authoredOn         "2022-07-05 12:25:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1816/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Valeport 106 CM";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/114/>;
        skos:definition        "The Valeport model 106 current meter is an impeller current meter, designed for real time underwater current measurements or short to medium term autonomous deployments. The instrument outputs the current velocity and flow heading. It is made with a styrene impeller and an in-built flux gate compass. Impeller counts and heading are read on a 1-second cycle. In Direct Reading Mode, where cable lengths are in excess of 50 m, communication is via Digital Current Loop. The Model 106 is fitted with a data acquisition micro-controller, operating at 12-bit resolution. It has the ability to run autonomously, using an internal battery, or via cabled network. The instrument itself is made from titanium and polymers. Optional additions to the current meter include temperature and pressure sensors. The velocity range is between 0.03 and 5 m/s, and the compass reads 360 degrees, with 2.5 degree accuracy. The depth rating is 500 m. Power supply can be from a D type battery or 12-20 volt DC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1816";
        skos:note              "accepted"@en;
        skos:prefLabel         "Valeport model 106 current meter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00430/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0014/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0661/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0661";
        dc:date                "2015-06-16 16:49:46.0";
        dc:identifier          "SDN:L22::TOOL0661";
        pav:authoredOn         "2015-06-16 16:49:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0661/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0661/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Sperry Marine MK37 gyro";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A family of instruments that contains a controlled gyroscope which seeks and aligns itself with the meridian and points to true north. They use the properties of the gyroscope in combination with the rotation of the earth and the effect of gravity. The effects of varying speed and latitude are compensated for by the use of manually operated controls. Models MOD I, MOD O, MOD D, MOD D/E are all with an analog output Step or/and Syncro. MOD VT is the latest model with NMEA Data output as well."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0661";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sperry Marine MK37 series gyrocompasses"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00586/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1829/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1829";
        dc:date                "2022-08-04 16:50:53.0";
        dc:identifier          "SDN:L22::TOOL1829";
        pav:authoredOn         "2022-08-04 16:50:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1829/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Raytheon MF 30";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A maintenance-free gyrocompass and attitude reference system, designed for use as a navigation aid on board ships. It utilises Hemispherical Resonator Gyroscope (HRG) technology, whereby a single angular rate vibrating resonator is located inside a miniature hemisphere with the electronics for vibration sensing, decoupled from outside equipment. The MF 30 can be used standalone or as part as a heading management system, which would allow integration of up to four compasses (up to three gyrocompasses, or two gyrocompasses and a GNSS THD, plus a magnetic compass). It is capable of automatic correction of magnetic heading by deviation and variation. It has a heading accuracy of 0.25 degrees secLat RMS, and a roll and pitch accuracy of 0.2 degrees RMS. It can operate in temperatures from -20 to +60 degC. Permissible roll and pitch angle for full accuracy is +/- 60 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1829";
        skos:note              "accepted"@en;
        skos:prefLabel         "Raytheon Standard MF 30 gyrocompass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00901/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0133/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0813/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0813";
        dc:date                "2014-12-09 16:36:40.0";
        dc:identifier          "SDN:L22::TOOL0813";
        pav:authoredOn         "2014-12-09 16:36:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0813/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sperry Marine MK-27F";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "Fibre optic gyrocompass for heading and attitude. It is designed for millitary applications. Sensor can be either deck or pedestal mounted in sheltered or non-sheltered environment.  Heading accuracy is 0.35 degree secant latitude. Pitch and roll accuracy is 0.1 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0813";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sperry Marine MK-27F Gyrocompass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00586/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1669/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1669";
        dc:date                "2021-03-26 16:38:52.0";
        dc:identifier          "SDN:L22::TOOL1669";
        pav:authoredOn         "2021-03-26 16:38:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1669/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Consilium SAL T2+";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A docking and dual-axis vessel speed logger designed to measure simultaneous two-axis true vessel speed over ground (SOG) and relative speed through water (STW). It requires only a single hull penetration, and is approved for use on vessels up to 50,000 GT. The transducer uses a correlation principle to measure SOG and STW vertically, eliminating the effects of temperature and salinity on the speed of sound. It measures STW at +/- 50 knots with a speed inaccuracy of 0.1 knot, or 0.5% whichever is greater, and a distance inaccuracy < +/- 0.5 % of travelled distance in water. It can be used in minimum waters depths of 3 m below the transducer. It measures SOG at +/- 40 knots with a minimum depth range of 2-250 m below transducer. The SOG speed inaccuracy is 0.1 knot, or 0.5% whichever is greater."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1669";
        skos:note              "accepted"@en;
        skos:prefLabel         "Consilium SAL T2+ acoustic correlation dual speed log"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0173/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01795/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1619/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1619";
        dc:date                "2021-02-03 09:56:26.0";
        dc:identifier          "SDN:L22::TOOL1619";
        pav:authoredOn         "2021-02-03 09:56:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1619/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Simrad GC80";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "GC80 approved according to IMO A.424(XI) performance standards for gyro-compasses It is designed for vessels with speed up to 30 knots. The system complies with IMO A.424 (11) and Wheel Mark Specifications. The compass uses a sealed sensitive element to detect heading and contains no liquid. In the GC80 series, the GC80 differs from the GC85 by the sensitive element used. Can be configured in a dual or triple gyrocompass system. Is used in conjuction with a compact, dual or expanded control unit. Settling time accuracy: within 3 h. Settle point error accuracy: <+/-0.1 degrees. Repeatability of settle point error accuracy: <+/-0.1 degrees. Roll and pitch error accuracy: <+/-0.4 degrees. Range of speed correction: 0-50 knots/latitude (0-70 degrees)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1619";
        skos:note              "accepted"@en;
        skos:prefLabel         "Simrad GC80 {gyro} gyrocompass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0154/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1225/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1225";
        dc:date                "2018-04-20 17:20:46.0";
        dc:identifier          "SDN:L22::TOOL1225";
        pav:authoredOn         "2018-04-20 17:20:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1225/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Airmar CS4500";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A speed sensor that is used on all types and sizes of sailboats and powerboats It measures boat speed using ultrasonic pulses to collect echoes from small particles in the water as they pass under two transducers embeded in the sensor. The time taken for particles to travel between transducers is used to calculate vessel speed. It has a transmit frequency of 4.5 MHz and pulse repetetion frequency of 5.5 kHz. Low-profile, plastic, or bronze housings available. Speed range: 0.1-40 knots. Speed accuracy: 0.1 knots."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1225";
        skos:note              "accepted"@en;
        skos:prefLabel         "Airmar CS4500 (ultrasonic) water speed sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01046/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0089/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0089";
        dc:date                "2016-04-05 11:49:20.0";
        dc:identifier          "SDN:L22::NETT0089";
        pav:authoredOn         "2016-04-05 11:49:20.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0089/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/NETT0089/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/NETT0089/3/> , <http://vocab.nerc.ac.uk/collection/L22/current/NETT0089/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "MARMAP Bongo";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "Plankton net described as MARMAP Bongo Net [Posgay and Marak (1980),  Wiebe & Benfield (2003)]; designed with double cylindrical (hoop) mouth piece with measurements: diameter (metre)=0.61, length (metre)=0.3; with opening area (square metre)=0.292; with total filtering net length (metre)=3; with filtering net shape cylindrical-conical; with additional features: cylinder section length=1.47 m, conical section length=1.53 m; with mesh size (millimetre)=0.1 to 0.5 but usually 0.333; and equipped with NO closing mechanism and flowmeter in each hoop."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0089";
        skos:note              "accepted"@en;
        skos:prefLabel         "MARMAP Bongo net - Posgay and Marak (1980)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1846/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1846";
        dc:date                "2024-08-19 10:03:25.0";
        dc:identifier          "SDN:L22::TOOL1846";
        pav:authoredOn         "2024-08-19 10:03:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1846/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1846/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1846/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "PerkinElmer Tri-Carb 3180TR/SL";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB21/>;
        skos:definition        "A benchtop liquid scintillation analyser for detecting small amounts of alpha, beta, and gamma radioactivity. The instrument is designed for laboratory life science research. It is based on the interaction between a beta-emitting radionuclide and a scintillator, a component of the scintillation cocktail. The scintillator converts ionising radiation from the radionuclide into photons of light (scintillation). The intensity of the light produced during scintillation is proportional to the initial energy of the beta particle. It uses time resolved liquid scintillation counting. Bismuth Germanium Oxide (BGO) detector guard. The sample loader can hold up to 408 standard 20 mL vials, or 720 small 4 or 7 mL vials. Efficiency: 3H 0 - 18.6 keV, 14C 0 - 156 keV."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1846";
        skos:note              "accepted"@en;
        skos:prefLabel         "PerkinElmer Tri-Carb 3180TR/SL liquid scintillation counter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00578/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0227/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1865/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1865";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL1865";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1865/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1865/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1865/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Kongsberg Simrad SC90";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/FFES/>;
        skos:definition        "The Simrad SC90 is a 360 degree omnidirectional fish finding sonar with an operational range of 50 to 2000 metres, a selectable frequency of 82.5 to 85 kHz in steps of 0.5 kHz, a vertical beam width of 8 degrees, and 480 receiver channels. The cylindrical multi-element transducer allows the omnidirectional sonar beam to be tilted electronically from +10 to -60 degrees in 1 degree steps. The SC90 is equipped with Simrad's signal processing software. It includes linear frequency modulation transmissions (chirp) to ensure a clutter free picture with very high resolution in range, and automatic roll and pitch stabilisation of +/- 20 degrees. The instrument is available with two hull configurations differentiated by how far the transducer can be lowered below the hull and the resulting maximum operational speed. The SC90 can be lowered 1 metre limiting speed to 20 knots and the SC94 can be lowered 2.1 metres limiting speed to 19 knots. The SC90 hull unit can be supplied with a 4.6 or 7 m transducer cable. The SC94 is only supplied with a 4.6 m transducer cable."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1865";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg Simrad SC90 fish finding sonar"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0154/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1884/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1884";
        dc:date                "2022-12-21 16:50:36.0";
        dc:identifier          "SDN:L22::TOOL1884";
        pav:authoredOn         "2022-12-21 16:50:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1884/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Turner fluorometer 111";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "A filter fluorometer with typical applications in either discrete or underway fluorescence monitoring depending on the type of analysis door used. Operates as a balanced light bridge based on the concept of an optical bridge that senses the differences between the emission of the fluorescing sample and a calibrated light source originating from the same bulb (via a rear light path) that is used to excite the sample. Features variable sensitivity by way of a range selector between the lamp and the primary filter, with four settings/apertures for relative sensitivity (30, 10, 3 and 1x). Relies on a mechanical servo motor arrangement and operates at 117 volts A.C., 2 amperes, 60 cycles."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1884";
        skos:note              "accepted"@en;
        skos:prefLabel         "Turner Designs 111 fluorometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00400/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0080/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0293/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0293";
        dc:date                "2024-08-23 15:47:12.0";
        dc:identifier          "SDN:L22::TOOL0293";
        pav:authoredOn         "2024-08-23 15:47:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0293/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0293/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0293/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "RDI WS 1200 kHz ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://mmisw.org/ont/trdi/models/Sentinel>;
        skos:definition        "An ADCP designed for self-contained use on moorings or vessel mounting. It has a patented 1200 kHz broadband signal and a standard depth rating of 200 metres. It operates effectively between temperatures of -5 to 45 degC and a range of up to 20 m with a depth cell size of 2 m. Velocity accuracy is +/- 0.3 % or 0.3 cm/sec."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0293";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Sentinel 1200 kHz ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1605/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1605";
        dc:date                "2021-02-03 09:56:26.0";
        dc:identifier          "SDN:L22::TOOL1605";
        pav:authoredOn         "2021-02-03 09:56:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1605/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Rotronic MP101A";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A combined humidity and temperature probe with linear voltage output. For use in meteorology and similar demanding applications, for example in tunnels, on motorways and airports. It consists of a Hygromer IN-1 humidity sensor and a Pt100 Class A temperature sensor that are fixed. Output signal: 0...1 VDC (RH), -0.4..+0.6 VDC (T). Supply voltage: 4.8...30 VDC. Accuracy: +/-1 %RH (5...95 %RH) +/- 2% RH < 5 %, > 95 % RH), +/- 0.3 deg C (T)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1605";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rotronic Hygromer MP101 A temperature and humidity probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00524/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0038/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1662/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1662";
        dc:date                "2021-03-23 17:29:08.0";
        dc:identifier          "SDN:L22::TOOL1662";
        pav:authoredOn         "2021-03-23 17:29:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1662/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Honeywell HMR3300";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A solid-state, circuit board-type magnetic compass. It is used to measure heading, tilt and magnetic flux density. It is based on magnetic sensing of the earth's field. It comprises 3 magnetic sensors (single and two-axis) to provide the horizontal components (X and Y), and the vertical (Z) axis component. It also includes a MEMS accelerometer to provide 2-axis tilt (pitch and roll) sensing relative to the board's horizontal (flat) position. Heading accuracy: 1 deg RMS (Level), 3 deg RMS (0 to +/-30 deg), 4 deg RMS (+/-30 to 60 deg). Pitch and roll accuracy: typically 0.4 deg (0 to +/-30 deg), 1.0 deg (+/-30 to 60 deg). Magnetic field resolution: typically +/- 2 gauss."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1662";
        skos:note              "accepted"@en;
        skos:prefLabel         "Honeywell Aerospace HMR 3300 (3-axis tilt-compensated) electronic compass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01779/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0161/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1681/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1681";
        dc:date                "2021-04-29 15:48:58.0";
        dc:identifier          "SDN:L22::TOOL1681";
        pav:authoredOn         "2021-04-29 15:48:58.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1681/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sercel MicrOBS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/368/>;
        skos:definition        "An ocean bottom seismometer designed for deep water refraction seismic surveys. It records and monitors earthquakes and natural seismicity to determine epicentre and associated mechanisms in active tectonic areas. With 4C multi-component recording (3 geophones, 1 hydrophone), MicrOBS allows accurate characterization of P and S velocities in deep crustal layers. MicrOBS dives autonomously to the seafloor, and can be deployed for up to 24 days before being recalled to the surface via acoustic signal release. It contains rechargeable Li-Ion 15V/40Ah batteries and an 8 Gb compact flash card (optional 16 Gb). MicrOBS has a low frequency cut-off of 2 Hz (-3 db), a natural frequency of 4.5 - 10 Hz, and a sensitivity range from 32 V/m/s to 22.8 V/m/s. It is depth-rated to 6000 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1681";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sercel MicrOBS ocean bottom seismometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01805/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0176/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0090/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0090";
        dc:date                "2024-07-22 10:20:56.0";
        dc:identifier          "SDN:L22::TOOL0090";
        pav:authoredOn         "2024-07-22 10:20:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0090/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0090/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "SonTek Argonaut-MD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/114/>;
        skos:definition        "The Argonaut-MD is a single-point doppler 3D vector averaging current meter designed for mooring deploymen for up to 2 years. It does not require calibration, has no moving parts, no threshold velocity and can be fitted with optional pressure and temperature sensors, Sea-Bird SeaCAT CTD or an inductive modem. It uses a fixed measurement volume centered 1.25 m from the instrument for 3 MHz systems (2.0 m for 1.5 MHz systems) and is housed in a single Deltrin or Titanium canister with internal memory and batteries. It can be clamped to the mooring line or mounted within a mooring cage."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0090";
        skos:note              "accepted"@en;
        skos:prefLabel         "SonTek Argonaut moored 3D Doppler current meter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00334/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1402/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1402";
        dc:date                "2020-02-14 10:25:04.0";
        dc:identifier          "SDN:L22::TOOL1402";
        pav:authoredOn         "2020-02-14 10:25:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1402/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1402/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Metek uSonic-3 Scientific";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A high precision 3D sonic anemometer. Typical applications for this device include: meteorological systems, meteorological networks, measuring dispersion parameters for pollution modelling, research stations, industrial sites, air quality forecasts, eddy correlation fluxes, marine and offshore platforms, wind shear detection, wind energy, and wake vortex monitoring. This device takes accurate measurement of 3 wind components and turbulence. Constructed with stainless steel. Optional extensions are sensor head heating, analogue data output, analogue data input, separation of sensor head and electronic, online turbulence calculation. Measuring range 0 to 60 m/s , - 40 to + 70 deg C. Resolution = 0.01 m/s, 0.1 deg ,0.01 K."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1402";
        skos:note              "accepted"@en;
        skos:prefLabel         "Metek uSonic-3 Scientific {formerly: USA-1} ultrasonic anemometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01221/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0059/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1440/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1440";
        dc:date                "2023-02-07 17:08:15.0";
        dc:identifier          "SDN:L22::TOOL1440";
        pav:authoredOn         "2023-02-07 17:08:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1440/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1440/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "WET Labs ECO FLB";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "A single-channel fluorometer used to measure fluorescence from chlorophyll-a, CDOM, uranine, rhodamine, phycocyanin and phycoerythrin in marine environments. The (B) in the designation signifies a standard FL model with internal memory and internal batteries for autonomous operation. The fluorometer can measure phytoplankton chlorophyll-a concentrations in the range 0-125 ug/l, with a sensitivity of 0.02 ug/l. The instrument can operate over the temperature range 0-30 degC and with internal batteries is depth rated to 300 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1440";
        skos:note              "accepted"@en;
        skos:prefLabel         "WET Labs {Sea-Bird WETLabs} ECO FLB fluorometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0026/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2225/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2225";
        dc:date                "2026-08-06 08:15:03.0";
        dc:identifier          "SDN:L22::TOOL2225";
        pav:authoredOn         "2026-08-06 08:15:03.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2225/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2225/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "P-ONE_P-CAL";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/399/>;
        skos:definition        "A pair of glass hemispheres containing photomultiplier tubes as well as optical and acoustic calibration systems that acts as a hybrid module for detection and calibration within the Pacific Ocean Neutrino Experiment (P-ONE) large-volume neutrino telescope. Multiple Calibration Modules (P-CALs) will be deployed on instrumented mooring strings as integrated calibration instruments but also to avoid blind spots along the detector string. Data provided by P-CALs are used to measure the real-time relative positions of modules within the moorings, help to monitor the efficiency of the modules, and provide information on the optical properties of the seawater. Each 17 inch borosilicate glass hemisphere contains 4 photomultiplier tubes (PMTs) and a plastic shroud that acts as a mounting platform for calibration components and shields the PMTs from diffuse light flashes . A diffusing PTFE sphere allows the creation of isotropic flashes and is used for optical calibration. Five high-power nanosecond light pulsers positioned below the diffuser provide a choice of wavelength and pulse properties of the flash. The PTFE diffuser is optically coupled to the glass of the hemisphere using a fill of optical gel to minimise unwanted refractions at the glass interface. Ten beamed sub-nanosecond light flashers are also integrated into each module to measure time synchronisation between instruments, light scattering, and spectral dispersion. The acoustic positioning system uses piezo-based acoustic receivers acoustically coupled to the glass hemispheres to detect signals from acoustic transceivers distributed on the seafloor. This allows precise monitoring of the mooring string and module positions. A photodiode and silicon photomultiplier are present in each module for self-monitoring of module efficiency and flash timing. The module also hosts a CMOS camera, such as The Imaging Source DFM 37UX265-ML, to monitor sedimentation and biofouling levels on the instrument and to monitor bioluminescence events. Each module has several temperature, pressure, humidity, acceleration, and magnetic field sensors for continuous system monitoring."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2225";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pacific Ocean Neutrino Experiment Calibration Module"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0357/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02131/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2244/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2244";
        dc:date                "2025-12-04 12:34:18.0";
        dc:identifier          "SDN:L22::TOOL2244";
        pav:authoredOn         "2025-12-04 12:34:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2244/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Unspecified streamers";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "An array of hydrophones towed on one or more cables behind a vessel that is used to detect sound waves in aquatic environments. Applications include seismic exploration, passive acoustic monitoring of marine mammals, monitoring of underwater noise, and military surveillance. Each streamer typically has multiple hydrophones placed at set intervals along the cables and streamers can be deployed at the same depth or at different depths depending upon the application. A separate data logger and specialised software may be used to record and process the acoustic signals detected by the deployed hydrophones. This term should only be used where the application of the streamers is unknown and where the streamers are not a part of a larger seismic reflection system."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2244";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified (towed) hydrophone streamers"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0001/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2282/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2282";
        dc:date                "2026-03-26 11:07:25.0";
        dc:identifier          "SDN:L22::TOOL2282";
        pav:authoredOn         "2026-03-26 11:07:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2282/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PNI TCM 2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A sensor module which combines a three-axis magnetometer and a two-axis tilt sensor to determine orientation. The TCM 2 is suitable for a range of applications including GPS systems requiring backup azimuth data; automobile and marine navigation systems; aircraft compasses and avionics systems; oceanographic buoys and data stations; and tracking animal migration patterns. It measures heading, pitch, roll, temperature and magnetic direction and transmits data across the RS232 interface in response to input commands. Analogue output is available on all TCM models; however, analogue output modes do not provide full resolution, error flags, tilt data, or magnetic field information. It uses an inclinometer to mathematically correct for tilt in order to eliminate moving parts and provide more information about the environment than would be available with the use of a mechanical gimbal. The TCM 2 may have tilt compensation of +/- 20 degrees (TCM 2-20) or +/- 50 degrees (TCM 2-50). TCM 2-20 - Heading accuracy when level: 0.5 degrees RMS; heading accuracy when tilted: 1.0 degree RMS; heading resolution: 0.1 degree. Tilt accuracy: +/- 0.2 degrees; tilt resolution: 0.1 degree; tilt range: +/- 20 degrees. TCM 2-50 - Heading accuracy when level: 1.0 degree RMS; heading accuracy when tilted: 1.5 degrees RMS; heading resolution: 0.1 degree. Tilt accuracy: +/- 0.4 degrees; tilt resolution: 0.3 degrees; tilt range: +/- 50 degrees. Magnetic field - absolute accuracy: +/- 1 micro-T (0 - 70 micro-T), +/- 5 micro-T (70 - 80 micro-T); resolution: 0.01 micro-T; range: +/- 80 micro-T. Temperature measurements from -20 to 70 degrees at +/- 1 degC accuracy (after calibration) and +/- 1 degC resolution. TCM 2-20 and 2-50: 1 - 30 Hz sampling rate available, operating temperature: -20 to 70 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2282";
        skos:note              "accepted"@en;
        skos:prefLabel         "PNI TCM 2 electronic compass module"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0162/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01047/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2309/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2309";
        dc:date                "2026-06-05 10:15:23.0";
        dc:identifier          "SDN:L22::TOOL2309";
        pav:authoredOn         "2026-06-05 10:15:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2309/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Nanometrics Atlantis COBSO";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/368/>;
        skos:definition        "A compact ocean-bottom seismic observatory system designed for deployment on the seabed to acquire high-quality broadband seismic and environmental data. This system integrates either the Trillium 120 or the 360 OBS seismometer, the Titan accelerometer, and the Centaur Gen5 data logger, into a single, cabled system. Designed for permanent deployments collecting real-time data, the system is typically used in ocean-bottom seismology studies, including earthquake monitoring, crustal structure investigations, and offshore geophysical surveys. It is housed in a purpose-built titanium pressure vessel proven for deployments up to 6,000 meters and offers footings for optimal ground coupling."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2309";
        skos:note              "accepted"@en;
        skos:prefLabel         "Nanometrics Atlantis (Cabled) Ocean Bottom Seismic Observatory system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0048/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01193/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2041/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2041";
        dc:date                "2024-05-30 13:54:18.0";
        dc:identifier          "SDN:L22::TOOL2041";
        pav:authoredOn         "2024-05-30 13:54:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2041/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NORBIT Base-X2 profiler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/185/>;
        skos:definition        "A sound velocity profiling instrument used to measure the speed of sound in water. Outputs measurements of sound velocity (m/s) (SV) and pressure (dbar) (P). Standard option depth rated to 100 m. Optional 500 m pressure rated housing P-Xchange sensor (0 - 500 dBar). SV measurement range 1375 to 1625 m/s, precision 0.006 m/s, accuracy 0.025 m/s, resolution 0.001 m/s. P measurement range 0 to 100 dbar, precision 0.03 percent, accuracy 0.05 percent, resolution 0.02 percent."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2041";
        skos:note              "accepted"@en;
        skos:prefLabel         "NORBIT Base-X2 profiler sound velocity probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0215/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01967/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0719/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0719";
        dc:date                "2014-07-09 12:07:44.0";
        dc:identifier          "SDN:L22::TOOL0719";
        pav:authoredOn         "2014-07-09 12:07:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0719/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SMRU Ltd SRDL 9000x";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS17/>;
        skos:definition        "A depth and temperature sensor package combined with an RF unit and antenna suitable for transmission of data via the Argos satellite system. The unit contains an internal battery and a microprocessor that logs data and schedules the transfer of data. The package is designed for attachment to marine mammals and has an operational depth range of down to 2000 m. It is built and calibrated at Valeport Ltd, while SMRU Ltd, the commercial arm of the Sea Mammal Research Unit of the University of St Andrews, is responsible for its distribution, and for streaming and processing the data. More information is available at http://www.smru.st-and.ac.uk/Instrumentation/SRDL/."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0719";
        skos:note              "accepted"@en;
        skos:prefLabel         "SMRU Ltd Satellite Relay Data Logger 9000x"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00541/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0445/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0445";
        dc:date                "2024-08-23 15:47:11.0";
        dc:identifier          "SDN:L22::TOOL0445";
        pav:authoredOn         "2024-08-23 15:47:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0445/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0445/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "RDI 150 kHz BB ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://mmisw.org/ont/trdi/models/WorkhorseADCP>;
        skos:definition        "The RDI Broadband ADCP is designed for mooring deployment and has an operating frequency of 150 kHz. The instrument uses Doppler-technology to achieve accurate and non-intrusive measurements and it can come with pressure and temperature sensors. It can be used in real time measurement situations or can log to an internal recorder powered by internal batteries."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0445";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI 150 kHz broadband ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0464/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0464";
        dc:date                "2012-02-21 16:06:42.0";
        dc:identifier          "SDN:L22::TOOL0464";
        pav:authoredOn         "2012-02-21 16:06:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0464/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Agilent 7500ce ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "A laboratory benchtop inductively coupled plasma mass spectrometer (ICP-MS) for metal analysis. The instrument comprises a sample introduction system (micromist glass concentric nebuliser, quartz Scott-type spray chamber, peristaltic pump), an interface of nickel cones and dual on-axis extraction lenses, a vacuum system, mass flow controllers (plasma, auxiliary, makeup, and carrier gas and two Octopole Reaction System (ORS) reaction gas lines), a shieldtorch system (STS), an all-solid state digitally-driven 27 MHz RF generator and an off-axis Omega lens. The octopole cell of the ORS can be used with no gas, operated in collision mode using pure He cell gas or used in H2 reaction mode for ultra-trace Se analysis and semiconductor applications. All three of these modes come as standard in the 7500ce model. The instrument has been discontinued."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0464";
        skos:note              "accepted"@en;
        skos:prefLabel         "Agilent 7500ce inductively coupled plasma mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> .

