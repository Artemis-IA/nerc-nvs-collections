        skos:definition        "The Workhorse Rio Grande WRG-600 is a 600 kHz rapid sampling, vessel mounted ADCP designed for use in a range of river conditions, from streams as shallow as 70 cm, to large rivers and tidal estuaries. It measures water velocity in the range +/- 5 m/s to +/- 20 m/s, and temperature in the range -5 to 40 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0750";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Rio Grande 600 kHz ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

