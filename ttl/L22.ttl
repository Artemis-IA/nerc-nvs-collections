        skos:notation          "SDN:L22::TOOL0914";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne Reson TC1037 directional telephone transducer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00976/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0952/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0952";
        dc:date                "2015-12-01 14:39:08.0";
        dc:identifier          "SDN:L22::TOOL0952";
        pav:authoredOn         "2015-12-01 14:39:08.0";
