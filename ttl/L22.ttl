<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1806/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1806";
        dc:date                "2022-05-31 15:14:18.0";
        dc:identifier          "SDN:L22::TOOL1806";
        pav:authoredOn         "2022-05-31 15:14:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1806/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Systea MicroMac 1000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB01/>;
        skos:definition        "A portable elemental analyser that combines colorimetric and fluorimetric analytical methods to detect various elements in marine or fresh water samples. These include ammonia, boron, calcium, chloride, copper, nickel, nitrate plus nitrite, silicates, sulfide, phosphorous, zinc and more. It is a fully automated system in terms of sample analysis and calibration. It uses a multi-beam colorimeter with silicon detector, and it can store up to 400 measurements using internal storage. It has a measuring time of 4 - 8 mins per sample, and can measure up to 4 parameters per sample. It has an operating temperature from 4 - 30 degC. Sample volumes can be either 20 or 30 ml."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1806";
        skos:note              "accepted"@en;
        skos:prefLabel         "Systea MicroMac 1000 portable analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0211/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01964/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1665/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1665";
        dc:date                "2021-03-23 17:29:08.0";
        dc:identifier          "SDN:L22::TOOL1665";
        pav:authoredOn         "2021-03-23 17:29:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1665/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Ifremer CHEMINI Fe";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/383/>;
        skos:definition        "An in-situ wet chemistry analyser. It is used for deep-sea surveys using, for example, Remotely Operated Vehicles (ROVs) and deep-sea observatory rigs. It measures iron. It uses flow injection analysis with colorimetry detection. It consists of a hydraulic module with pumps used for the circulation of reagents, standards and samples, and a detection module that holds the colorimeter and optical cell. It uses a measurement wavelength of 570 nm (810 nm reference wavelength). Sample rate is 4 min. Accuracy is 6 uM Fe and sensitivity is 0.3 uM Fe. It is depth rated to 6000 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1665";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ifremer Chemical Miniaturised Analyser deep sea version Fe {CHEMINI} iron analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00702/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0152/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0068/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0068";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0068";
        pav:authoredOn         "2011-10-21 14:18:49.0";
