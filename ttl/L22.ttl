        owl:versionInfo        "1";
        skos:altLabel          "Duncan Ass. Box";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/51/>;
        skos:definition        "A Duncan and Associates box corer where the model is unknown. It is fitted with a 300 mm X 300 mm X 955-975 mm high cabinet box. It is capable of collecting oceanographic sediments up to 5000 m."@en;
