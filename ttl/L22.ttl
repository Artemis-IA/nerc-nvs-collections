        skos:altLabel          "Thies Clima 4.3120.22.012";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A wind direction measurement device used to measure the direction of the horizontal air flow, with potentiometer output. this instrument is equipped with a sliding potentiometer which offers a theoretically unlimited resolution. Wind direction measurement range: 0 to 360 degrees. Accuracy: +/- 2 degrees. Ambient temperature: -35 to 80 degrees C. Resolution: 1 degree."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2188";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thies Clima 4.3120.22.012 Wind Direction Transmitter Classic"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0234/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01990/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1105/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1105";
        dc:date                "2017-02-03 12:19:30.0";
        dc:identifier          "SDN:L22::TOOL1105";
        pav:authoredOn         "2017-02-03 12:19:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1105/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Knudsen CHIRP RACK";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/CHRP/> , <http://vocab.nerc.ac.uk/collection/L05/current/367/>;
        skos:definition        "A series of sub-bottom profiler echosoundersfor use on survey vesselsIt is a blackbox system that has a pulse length up to 64ms and uses frequencies between 3.5kHz - 210kHz. It is available in a 2 or 4 channel configuration (two 2kW ouput power channels and two 1kW ouput power channels) It has a resolution of 1cm (0-99.99), 1dm (100-999.9), 1m (greater than 1000) and a sound velocity of  1300 - 1800 m/s (Resolution 1m/s)"@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1105";
        skos:note              "accepted"@en;
        skos:prefLabel         "Knudsen Chirp Rack sub-bottom profiling echosounder series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00967/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0225/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1181/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1181";
        dc:date                "2026-02-19 13:01:10.0";
        dc:identifier          "SDN:L22::TOOL1181";
        pav:authoredOn         "2026-02-19 13:01:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1181/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1181/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "BAS MUDL net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "A motion-compensated upwards and downwards looking Bongo net - one facing upwards, one downwards. The instrument is designed for capturing zooplankton moving up and down the water column. It uses a spring mechanism to compensate for the platform's movements, maintaining the net's upward and downward velocity close to steady-state. The system uses sealed cod ends and a time-controlled open/close mechanism. The cod ends need to be pre-filled with water before deployment to avoid implosion."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1181";
        skos:note              "accepted"@en;
        skos:prefLabel         "British Antarctic Survey MUDL Bongo net"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2226/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2226";
        dc:date                "2025-10-09 11:48:19.0";
        dc:identifier          "SDN:L22::TOOL2226";
        pav:authoredOn         "2025-10-09 11:48:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2226/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sensoid_Deepod_V1";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/>;
        skos:definition        "A small logger with WiFi connectivity that can be attached to fishing lines to measure temperature, depth, and light down to a depth of 50 m. The Deepod V1 can be used to measure the depth of a paravane/lure combination, and can also be attached to divers, buoys, or submerged chains. Data can be read from the built-in OLED display or from a smartphone, tablet, or laptop using the Deepod Web tool. Light, temperature, and pressure sensors are all positioned on the front side of the logger and are potted with epoxy resin for reliable operation. A joystick and white power LED are also present on the front of the logger. The OLED display and magnetic power switch are positioned on the back of the logger. Depth sensor range is 0 to 300 m which is beyond the working depth rating of 50 m. Temperature range is 0 to 30 deg C and light level range is 0 to 1800 Lux. Crush depth is rated at >100 m. The logger weighs 34 g in air, and the shape has been optimised to work well with trollling (length 87 mm, width 32 mm, thickness 19 mm). A rechargeable lithium polymer (LiPo) battery provides approximately 8 hours of use. USB charging is possible with a standard microUSB connector. This charge port is plugged during deployment in water. Wave height monitoring is possible with a min and max depth high speed logging function that can estimate wave height (0.1 to 10.0 m)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2226";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sensoid Technologies Deepod V1 depth, temperature, and light logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02135/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0362/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1657/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1657";
        dc:date                "2021-03-23 16:02:18.0";
        dc:identifier          "SDN:L22::TOOL1657";
        pav:authoredOn         "2021-03-23 16:02:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1657/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Keithley M1000/M2000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/>;
        skos:definition        "The M1000/M2000 series of data logging modules are designed as analogue-to-digital interfaces or converters between a connected sensor (such as water temperature or pressure) and a computer. The modules in the series may be programmed using built-in commands to create custom transfer functions to interface to non-standard sensors. Outputs can also be scaled to the engineering units desired. The modules contain an internal microprocessor which performs all scaling functions. All scaling and non-linear function data is stored in a table contained in EEPROM non-volatile memory. The modules operate via +/-100 mV inputs and communicate via RS-232C."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1657";
        skos:note              "accepted"@en;
        skos:prefLabel         "Keithley Instruments M1000/M2000 data logger series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0167/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01773/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1430/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1430";
        dc:date                "2020-05-06 08:59:45.0";
        dc:identifier          "SDN:L22::TOOL1430";
        pav:authoredOn         "2020-05-06 08:59:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1430/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RBR Virtuoso3";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/>;
        skos:definition        "A self-contained, single-channel data logger for long deployments. The instrument uses 8 x AA cells and standard sampling up to 2Hz (240M readings). It uses a twist activation and USB-C, RS-232/485 communication. Optional features include Wi-Fi connectivity, sampling up to 32 Hz and external data and power. It uses either plastic or titanium housing. Clock drift is +/-60 seconds/year. Depth is rated to 750m (plastic) or 10,000m (titanium)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1430";
        skos:note              "accepted"@en;
        skos:prefLabel         "RBR Virtuoso 3 (submersible) data logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00299/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0049/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1746/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1746";
        dc:date                "2021-11-12 14:09:54.0";
        dc:identifier          "SDN:L22::TOOL1746";
        pav:authoredOn         "2021-11-12 14:09:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1746/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Slocum G3S Nav logger";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/>;
        skos:definition        "A navigation and engineering logging system located within the Slocum G3S model ocean glider. Sensors integrated can include GPS position, pressure transducer, platform altimeter and an internal clock. In addition to sensor data, engineering and inferred data are logged such as glider inferred currents and subsurface displacements. Data are output as proprietary binary format with .sbd (real time transmitted data) or .dbd (internally logged high resolution version stored on the glider memory card) files."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/OG_SENSORS/current/>;
        skos:notation          "SDN:L22::TOOL1746";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne Webb Research Slocum G3S Glider Navigation data logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01077/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0020/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1448/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1448";
        dc:date                "2020-05-26 10:03:47.0";
        dc:identifier          "SDN:L22::TOOL1448";
        pav:authoredOn         "2020-05-26 10:03:47.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1448/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GEOMAR TP DL";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/>;
        skos:definition        "A self-constructed data logger compatible with temperature and pressure sensors designed for deployment on moorings up to 6000m depth. The logger is designed by GEOMAR Helmholtz Centre for Ocean Research Kiel, Germany. Clock drift is in the range of about +/- minutes per year."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1448";
        skos:note              "accepted"@en;
        skos:prefLabel         "GEOMAR TP data logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00297/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0081/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1341/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1341";
        dc:date                "2019-08-06 08:31:15.0";
        dc:identifier          "SDN:L22::TOOL1341";
        pav:authoredOn         "2019-08-06 08:31:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1341/2/>;
