        skos:broader           <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0931/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "An absolute pressure transducer with a Digiquartz pressure sensor and precision thermometer. Operates over a temperature range of 0-125 degC and a pressure range of 0-10000 psia with a typical accuracy of 0.01% and a resolution of 0.0001%."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0403";
        skos:note              "accepted"@en;
        skos:prefLabel         "Paroscientific 410K Pressure Transducer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/PRESPR01/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00525/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0950/>
        rdf:type               skos:Concept;
