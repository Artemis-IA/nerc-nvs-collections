        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1198/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1198/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1198/1/>;
