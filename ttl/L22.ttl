        owl:versionInfo        "1";
        skos:altLabel          "CMST-DSTO USR";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "Instrument that contains a hydrophone plus a data logger in a deep-water housing designed for long-term monitoring of underwater noise. It can be deployed for periods of up to two years. Sampling frequency and schedule (including burst recording) may be programmed. More information at http://cmst.curtin.edu.au/products/usr.cfm."@en;
