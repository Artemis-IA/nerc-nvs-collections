        owl:versionInfo        "1";
        skos:altLabel          "MORS MC3";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/114/>;
        skos:definition        "A rotor current meter used to measure the speed and direction of water currents. It can optionally be equipped with temperature, pressure, and conductivity sensors. The instrument can measure speeds between 2.5 and 250 cm/s, with an accuracy of 2% of speed (or 2cm/s)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
