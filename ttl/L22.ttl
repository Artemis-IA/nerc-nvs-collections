        skos:notation          "SDN:L22::NETT0062";
        skos:note              "accepted"@en;
        skos:prefLabel         "High-speed net - Cassie (1956)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1709/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1709";
        dc:date                "2021-06-23 15:58:21.0";
        dc:identifier          "SDN:L22::TOOL1709";
        pav:authoredOn         "2021-06-23 15:58:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1709/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Applied Acoustics Dura-Spark 410";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/SPRK/>;
        skos:definition        "A variable tow-depth sparker for use in sub-bottom geophysical surveys. It is mounted on a stainless steel catamaran with flotation for towing behind a vessel. The Dura-Spark 410 consists of 5 arrays of 80 tips allowing the operator to tune the source from the vessel to its application. The typical operational bandwidth of the Dura-Spark 410 is 300Hz to 1.2KHz. When coupled with the CSP-Nv Seismic Power Supply the system offers 2000J/s peak discharge rate."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1709";
        skos:note              "accepted"@en;
        skos:prefLabel         "Applied Acoustics Dura-Spark 410 Sparker System"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01822/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0183/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1196/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1196";
        dc:date                "2018-01-30 16:59:47.0";
        dc:identifier          "SDN:L22::TOOL1196";
