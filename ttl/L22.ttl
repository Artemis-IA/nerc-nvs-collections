        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/TEMPPR01/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00395/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0890/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0890";
        dc:date                "2015-06-18 14:42:56.0";
        dc:identifier          "SDN:L22::TOOL0890";
        pav:authoredOn         "2015-06-18 14:42:56.0";
