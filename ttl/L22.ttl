        skos:prefLabel         "Navico Simrad Yachting MX200 global positioning system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0122/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00900/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1860/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1860";
        dc:date                "2022-10-12 12:35:50.0";
        dc:identifier          "SDN:L22::TOOL1860";
        pav:authoredOn         "2022-10-12 12:35:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1860/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Magnavox MX100";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "A Global Positioning System (GPS) receiver designed for use on non-commercial vessels. The device has three settings, Navigate, Plotter, and Sailplan, which include outputs such as position, speed, speed over ground, course over ground, bearing, distance and cross-track error, as well as over 200 waypoints and 20 routes. This instrument has six channels for continuous tracking. It has a back-lit LCD screen, which allows for day and nighttime navigation. The Sailplan setting allows the user to plan routes, whilst the Plotter setting graphically shows the chosen course. The instrument can be removed from the vessel and copies can be made via audio cassette recorder. Position updates every 0.6 seconds. This instrument was commercialised in 1991 and is no longer in production."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1860";
        skos:note              "accepted"@en;
        skos:prefLabel         "Magnavox MX100 GPS Navigator"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0237/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1899/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1899";
        dc:date                "2023-02-27 14:59:29.0";
        dc:identifier          "SDN:L22::TOOL1899";
        pav:authoredOn         "2023-02-27 14:59:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1899/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Pacific Gyre Globeacon";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "The Globeacon is a GPS receiver and satellite telemetry instrument designed to monitor and track platforms such as buoys, vessels, and oil platforms. The tracking feature uses Iridium Short Burst Data (SBD) with Iridum Modem and Globalstar Modem. The housing is made of PVC and the instrument is battery operated. The instrument can include air temperature, air pressure, and wind velocity sensors, and is waterproof to 5 meters."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1899";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pacific Gyre Globeacon GPS receiver"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0247/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01998/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0800/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0800";
        dc:date                "2014-09-18 15:18:31.0";
