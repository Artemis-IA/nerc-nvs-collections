        skos:definition        "The workhorse mariner WM-1200 provides short-range current profiling (typical range 12 m, or 19 m in long-range mode). This model operates at a 1200 kHz frequency providing precision bottom-track reference for direct vessel speed measurement."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
