        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0099/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
