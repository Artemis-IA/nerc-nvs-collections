        skos:altLabel          "Kongsberg EM 300";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "The Kongsberg EM300 is a 30 kHz multibeam echosounder designed for use in water depths between 10 and 5000 m. The maximum swath width is greater than 5 km, and the system allows up to 135 simultaneous beams with a range sampling interval of 17 cm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0745";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 300 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0756/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0756";
        dc:date                "2017-08-10 12:37:04.0";
        dc:identifier          "SDN:L22::TOOL0756";
        pav:authoredOn         "2017-08-10 12:37:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0756/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0756/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "SeaBeam 2112";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "SeaBeam sensors are now manufactured by L-3 Communications Elac Nautik GmbH. The Seabeam 2112 is a 12kHz multi-beam echo sounder of which a single swath covers an angular range of up to 120 degrees using 121 beams. The instrument's pulse length is between 3ms and 20 ms. This instrument was developed in the 1980s, and has now been discontinued."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0756";
        skos:note              "accepted"@en;
        skos:prefLabel         "SeaBeam 2112 multibeam echo sounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00899/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1798/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1798";
        dc:date                "2022-04-21 18:40:50.0";
        dc:identifier          "SDN:L22::TOOL1798";
        pav:authoredOn         "2022-04-21 18:40:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1798/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SeaBeam 1050D";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/>;
        skos:definition        "A dual frequency multibeam echosounder with 126 available beams at 1.5 degrees resolution. The SeaBeam 1050D combines the shallow water 180 kHz SeaBeam 1180 and medium water depth 50 kHz SeaBeam 1050. The 50 kHz component of the 1050D has a maximum swath width of 153 degrees at 500 metres depth, or 41 degrees at 3000 metres depth, and the 180 kHz component has a maximum swath width of 153 degrees at 110 metres depth, or 63 degrees at 580 metres depth. Selectable pulse length ranges from 0.15 to 10 ms, at survey speeds up to 16 knots for continuous seafloor coverage to collect bathymetric and sidescan data."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1798";
        skos:note              "accepted"@en;
        skos:prefLabel         "L-3 Communications SeaBeam 1050D multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00899/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0209/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0744/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0744";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL0744";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0744/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0744/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Kongsberg EM 302";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "The Kongsberg EM302 is a 30 kHz multibeam echosounder designed for use in water depths between 10 and 7000 m. The swath width is up to 5.5 times water depth/8km, and the system allows up to 864 soundings per ping. The projector array is available as 0.5, 1, 2, or 4 degree resolution, and receive array is available as 1, 2, or 4 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0744";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 302 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0910/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0910";
        dc:date                "2026-04-16 11:46:50.0";
        dc:identifier          "SDN:L22::TOOL0910";
        pav:authoredOn         "2026-04-16 11:46:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0910/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0910/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0910/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Atlas Hydrosweep DS 2 echo sounder";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A deep water multi-beam echo sounder which uses an operating frequency of 15.5 kHz to determine bathymetric depth. As a special feature, it contains extended coverage of 2x 60 degrees (with 1 or 2 x 59 sound beams, each with approximately 2, 3 degree beam width). Available transducers are T-type arrays. The system has a depth range of 10 to 11,000 m. This is the 2nd generation of the Hydrosweep DS. Atlas Hydrographic is now part of the Teledyne Reson group."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0910";
        skos:note              "accepted"@en;
        skos:prefLabel         "Atlas Hydrographic {Teledyne Reson} Hydrosweep DS 2 multibeam echo sounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00976/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1601/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1601";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL1601";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1601/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1601/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Kongsberg EM 712";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "The Kongsberg EM712 is a high to very high resolution multibeam echosounder. It operates at frequencies from 40 to 100 kHz, with a maximum ping rate of 30 Hz. The EM712 features a depth range of 3m below the transducer to 3600 m (1800 m for the EM712S model, and 600 m for the EM712RD model). Across track coverage (swath width) is up to 5.5 times water depth, with a maximum of more than 3500 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1601";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 712 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1682/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1682";
        dc:date                "2021-04-30 11:18:24.0";
        dc:identifier          "SDN:L22::TOOL1682";
        pav:authoredOn         "2021-04-30 11:18:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1682/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Wärtsilä ELAC 3030";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A multi-ping multibeam echosounder designed to measure seafloor depth. It is particularly suited to mapping the continental rise. As well as real-time bathymetric depth, the SeaBeam 3030 measures bottom amplitudes, side scan data and Water Column Imaging (WCI) data in medium water depths and deep waters. The system uses the Wärtsilä ELAC HydroStar operator software which provides all sonar control functions, data recording and real-time displays for quality control. It also supports third-party software such as HYPACK, EIVA and QINSy. It operates in the 26 kHz frequency band (nominally 30 kHz) in water depths up to 7000 m. It has an across-ship swath width up to 5.5 times the water depth, and 918 beams per multi-ping. It has an along-ship beam width from 1 - 3 degrees and an across-ship beam width from 1 - 2 degrees. Its pulse length ranges from 0.4 - 10 ms."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1682";
        skos:note              "accepted"@en;
        skos:prefLabel         "Wärtsilä ELAC SeaBeam 3030 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0118/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01743/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1346/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1346";
        dc:date                "2019-08-01 11:26:28.0";
        dc:identifier          "SDN:L22::TOOL1346";
        pav:authoredOn         "2019-08-01 11:26:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1346/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "DeltaT 837B 300m";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A multibeam (swath) echosounder with video-imaging capability that operates to 300 m. The Delta T is designed for low power consumption without a surface control box enabling it to be integrated into ROV and AUV systems. The sensor uses a 260 kHz acoustic frequency and 120 x 3 degrees field of view to measure the depth and nature of the sea floor. Operates with 120, 240 or 480 beams (3, 1.5 or 0.75 degree beam widths). Sensor is fitted with stainless steel housing as standard; or an optional 675 kHz acoustic frequency. Resolution is 0.02% of the range. Can be combined with an azimuth drive to obtain readings from direction."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1346";
        skos:note              "accepted"@en;
        skos:prefLabel         "Imagenex Delta T 837B 300 m (profiling) multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0046/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00956/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0757/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0757";
        dc:date                "2017-08-10 12:37:04.0";
        dc:identifier          "SDN:L22::TOOL0757";
        pav:authoredOn         "2017-08-10 12:37:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0757/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0757/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "SeaBeam 3012";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "SeaBeam sensors are now manufactured by L-3 Communications Elac Nautik GmbH. The Seabeam 3012 is a 12kHz multi-beam echo sounder designed for use in water depths between 50m and 11000m of which a single swath covers and angular range of up to 140 degrees. The instrument's pulse length is between 2ms to 20ms"@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0757";
        skos:note              "accepted"@en;
        skos:prefLabel         "SeaBeam 3012 multibeam echo sounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00899/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0492/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0492";
        dc:date                "2012-05-21 10:02:44.0";
        dc:identifier          "SDN:L22::TOOL0492";
        pav:authoredOn         "2012-05-21 10:02:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0492/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kongsberg EM 122";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A multibeam 12 kHz echsounder designed for high resolution seabed mapping. It uses both Continuous Wave (CW) and Frequency Modulated (FM) sweep pulses with pulse compression on reception in order to increase the maximum used swath width. This system has up to 288 beams/432 soundings per swath with pointing angles which are automatically adjusted according to achievable coverage or operator defined limits. The transducers are modular linear arrays in a Mills cross configuration with separate units for transmit and receive. It has a depth range of 20 to 11000 m and a depth resolution of 1 cm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0492";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 122 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0909/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0909";
        dc:date                "2026-04-16 11:46:09.0";
        dc:identifier          "SDN:L22::TOOL0909";
        pav:authoredOn         "2026-04-16 11:46:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0909/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0909/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0909/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Atlas Hydrosweep DS 3 echo sounder";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "Also known as a DS 3G. A deep water multi-beam echo sounder which uses operating frequencies between 14 - 16 kHz to determine bathymetric depth. It can generate 320 receive beams per ping which can be modulated using beamforming into 960 soundings per swath. It also generates 2 swaths simultaneously per ping. The third generation uses not only continuous wave (CW) pulses, but also frequency-modulated (chirped) pulses and Barker coded pulses which result in 20 - 50% more swath width. Available transducers are planar  arrays with beam resolutions of  0.5x1, 1x1, 1x2 and 2x2 degrees. The system has a depth range of 10 - 11,000 m. This is the 3rd generation of the Hydrosweep DS. Atlas Hydrographic is now part of the Teledyne Reson group."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0909";
        skos:note              "accepted"@en;
        skos:prefLabel         "Atlas Hydrographic {Teledyne Reson} Hydrosweep DS 3 multibeam echo sounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00976/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0858/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0858";
        dc:date                "2015-05-27 15:47:59.0";
        dc:identifier          "SDN:L22::TOOL0858";
        pav:authoredOn         "2015-05-27 15:47:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0858/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SM2000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A 200 kHz multibeam echosounder which can operate in depths between 500 to 2500m. It has known to be installed on Remotely Operated Vehicles (ROVs) such as ISIS to conduct bathymetry surveys."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0858";
        skos:note              "accepted"@en;
        skos:prefLabel         "Simrad SM2000 FR Multibeam Echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0384/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0384";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL0384";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0384/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0384/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Kongsberg Simrad EM 1002";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A 95 kHz multibeam echosounder designed for use in water depths of up to 1000 m. The transducer array includes 111 beams with a 2 deg beam width. Across-track coverage is up to 1500 m and angular coverage is adjustable up to 190 deg. The instrument has pulse lengths of 0.2, 0.7, and 2 ms and a depth resolution of 1, 4, or 8 cm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0384";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg Simrad EM 1002 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1347/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1347";
        dc:date                "2019-08-01 11:26:28.0";
        dc:identifier          "SDN:L22::TOOL1347";
        pav:authoredOn         "2019-08-01 11:26:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1347/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "DeltaT 837B 120x20";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A multibeam (swath) echosounder with video-imaging capability that operates with a 120 x 20 degrees field of view. The Delta T is designed for low power consumption without a surface control box enabling it to be integrated into ROV and AUV systems. The sensor uses a 260 kHz acoustic frequency to measure the depth and nature of the sea floor. Operates with 120, 240 or 480 beams (3, 1.5 or 0.75 degree beam widths). Sensor is fitted with stainless steel housing as standard; or an optional 675 kHz acoustic frequency. Resolution is 0.02% of the range. Operting depth is 300 m. Can be combined with an azimuth drive to obtain readings from direction."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1347";
        skos:note              "accepted"@en;
        skos:prefLabel         "Imagenex Delta T 837B 120 x 20 degrees (profiling) multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0046/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00956/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2095/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2095";
        dc:date                "2024-09-06 08:13:05.0";
        dc:identifier          "SDN:L22::TOOL2095";
        pav:authoredOn         "2024-09-06 08:13:05.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2095/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kongsberg EM2040C MKII";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/>;
        skos:definition        "A shallow water multibeam echosounder ideal for high resolution mapping and inspection applications. Sonar head pressure rated to 50 m depth. The MKII series has upgraded hardware and software to increase the swath and improve the data quality. Utilises both CW and FM chirp pulses for long range capability. Operating frequency range from 200 to 400 kHz with frequency selection in steps of 10 kHz. Output sample rate up to 60 kHz. Angular coverage for 200 to 320 kHz modes are 140 degrees with one sonar head allowing coverage of 5.5. times water depth. Full roll and pitch stabilisation techniques in real time as well as nearfield focussing both on transmit and receive. Available as single or dual head models. Can be delivered with dual swath capability or with 700 kHz mode. Easy to install and convenient for small boats."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2095";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 2040C MKII multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0916/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0916";
        dc:date                "2019-08-01 11:40:34.0";
        dc:identifier          "SDN:L22::TOOL0916";
        pav:authoredOn         "2019-08-01 11:40:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0916/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0916/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "DeltaT 837B 1000m";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A multibeam (swath) echosounder with video-imaging capability that operates to 1000 m. The Delta T is designed for low power consumption without a surface control box enabling it to be integrated into ROV and AUV systems. The sensor uses a 260 kHz acoustic frequency and 120 x 3 degrees field of view to measure the depth and nature of the sea floor. Operates with 120, 240 or 480 beams (3, 1.5 or 0.75 degree beam widths). Sensor can be fitted with either stainless steel or aluminium housing as standard; or an optional 675 kHz acoustic frequency. Resolution is 0.02% of the range. Can be combined with an azimuth drive to obtain readings from direction which may limit depth."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0916";
        skos:note              "accepted"@en;
        skos:prefLabel         "Imagenex Delta T 837B 1000 m (profiling) multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0046/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00956/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1637/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1637";
