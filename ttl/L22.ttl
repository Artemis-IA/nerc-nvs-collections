<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0621/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0621";
        dc:date                "2013-06-04 16:11:11.0";
        dc:identifier          "SDN:L22::TOOL0621";
        pav:authoredOn         "2013-06-04 16:11:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0621/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Teleost BPR";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/111/>;
        skos:definition        "A pressure recorder developed by the Institute of Oceanographic Sciences Bidston Laboratory in the late 1970s to measure sea level at offshore locations. It comprised a Bell and Howell strain gauge or a Digiquartz pressure transducer with an optional platinum resistance thermometer. Data were logged by an adapted Aanderaa current meter logger. More information is available at http://www.bodc.ac.uk/data/documents/nodb/27840/."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0621";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teleost Pressure Recorder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00003/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1118/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1118";
        dc:date                "2017-03-08 14:06:54.0";
        dc:identifier          "SDN:L22::TOOL1118";
        pav:authoredOn         "2017-03-08 14:06:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1118/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Agilent 5973N MSD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB19/>;
        skos:definition        "A mass selective detector (MSD) designed to be used with the 6890 Plus Series Gas Chromatograph. This transmission quadrupole mass spectrometer is used for qualitative and quantitative analysis by electron ionization (EI), positive chemical ionization (PCI), and negative chemical ionization (NCI). The system comes in five different models: G2577A (diffusion pump EI MSD), G2578A (standard turbo EI MSD), G2579A (Performance turbo EI MSD), G2588A (standard turbo EI/PCI MSD), and G2589A (performance turbo EI/PCI/NCI MSD)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1118";
        skos:note              "accepted"@en;
        skos:prefLabel         "Agilent 5973Network Mass Selective Detector"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0560/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0560";
        dc:date                "2012-10-04 12:03:09.0";
        dc:identifier          "SDN:L22::TOOL0560";
        pav:authoredOn         "2012-10-04 12:03:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0560/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GV IsoPrime IRMS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB19/>;
        skos:definition        "A laboratory benchtop isotope ratio mass spectrometer (IRMS), which operates in dual inlet or continuous flow modes. It forms part of the IsoPrime system which has a range of sample preparation and purification modules that can be coupled with the IsoPrime IRMS. The modules can analyse a range of samples (solids, liquids or gases) and each prepares the sample to be introduced into the IRMS as purified gases. The resultant prepared gases such as H2, CO2, CO, N2, SO2 or N2O are then ionised and analysed for their isotopic content by the IRMS. The instrument was originally manufactured GV instruments as part of the IsoPrime series, but this part of the business was sold to Isoprime Ltd (a group member of Elementar Analysensysteme GmbH) and this instrument has been superseded by more recent models."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0560";
        skos:note              "accepted"@en;
        skos:prefLabel         "GV Instruments IsoPrime Isotope Ratio Mass Spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00650/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1149/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1149";
        dc:date                "2017-09-07 09:23:08.0";
        dc:identifier          "SDN:L22::TOOL1149";
        pav:authoredOn         "2017-09-07 09:23:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1149/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Agilent 5975C Series GC/MSD System";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB19/>;
        skos:definition        "A Mass Selective Detector (MSD) with an inert Triple-Axis detector designed to be used with the following Gas Chromotagraphy (GC) units: 7890A, 6850, and 6890N. The system is used to carry out qualitative and quantitative analysis of substances by electron ionization (EI), positive chemical ionization (PCI), and negative chemical ionization (NCI). Optional configurations include the addition of Liquid Autosamplers such as G2880A, 7683, CombiPAL or G1888A."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1149";
        skos:note              "accepted"@en;
        skos:prefLabel         "Agilent 5975C Series Gas Chromatograph/Mass Selective Detector System"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2301/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2301";
        dc:date                "2026-04-29 11:03:25.0";
        dc:identifier          "SDN:L22::TOOL2301";
        pav:authoredOn         "2026-04-29 11:03:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2301/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Campbell CR1000X";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/>;
        skos:definition        "The Campbell CR1000X data logger is designed to measure sensors, drive direct communications and telecommunications, analyse data, control external devices, and store data and programmes in on-board, non-volatile storage. The data logger operates with a 32-bit Renesas RX63N processor that runs at 100 MHz and has a total onboard flash memory of 128 Mb plus 4 Mb of battery-backed Static Random-Access Memory (SRAM). An additional 16 Gb of flash memory can be added via a removable microSD. The electronics are RF shielded and glitch protected by a sealed, stainless-steel canister. Standard operating temperature range spans -40 to 70 degC which can be extended to -55 to 85 degC. The wiring panel has 2 switchable 12 V terminals, an unpluggable terminal block, and analog grounds dispersed among 16 analog terminals meaning the CR1000X is compatible with nearly every available sensor. Communication between a PC and the data logger can be operated via a direct USB port, a 10/100baseT Ethernet port, multidrop modems, short-haul modems, phone modems (land line, digital cellular, and voice-synthesized), RF telemetry, and satellite transmitters (HDR GOES, Argos, Meteosat, Iridium, and Inmarsat)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2301";
        skos:note              "accepted"@en;
        skos:prefLabel         "Campbell Scientific CR1000X data logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00414/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0089/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0640/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0640";
        dc:date                "2014-11-12 11:29:50.0";
        dc:identifier          "SDN:L22::TOOL0640";
        pav:authoredOn         "2014-11-12 11:29:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0640/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0640/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "SBE 3F temperature sensor";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "Water temperature sensor primarily designed for use on the SBE 25 and 25plus Sealogger CTD systems but can be used as a component in custom oceanographic profiling systems or high-accuracy temperature-monitoring applications. The sensor operates over the range -5 to +35 degC and has an initial accuracy of +/-0.001 degC. The sensor has a depth rating of 6800 m (aluminium housing) or 10500 m (titanium housing). The SBE 3F is an enhanced version of the SBE 3 temperature sensor."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0640";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird SBE 3F temperature sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0517/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0517";
        dc:date                "2024-07-22 10:54:29.0";
        dc:identifier          "SDN:L22::TOOL0517";
        pav:authoredOn         "2024-07-22 10:54:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0517/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0517/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Picarro L2130-I Water Analyzer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB38/>;
        skos:definition        "A portable analyser designed for laboratories or field based isotope analysis. It uses Cavity Ring-Down Spectroscopy (CRDS) to measure the spectral signature of the molecule of interest. The instrument includes a closed-loop temperature and pressure control. The L2130-i can be used in all aspects of the water cycle: water vapor, liquid water, or water trapped in solids. It has a typical precision of 0.25 per mil for d18O and 1.20 per mil for dD in solid samples. Corresponding typical values for liquid samples are 0.011 per mil for d18O and 0.038 per mil for dD."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0517";
        skos:note              "accepted"@en;
        skos:prefLabel         "Picarro L2130-I deltaD/delta18O Isotopic Water analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00622/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1769/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1769";
        dc:date                "2022-02-16 10:20:25.0";
        dc:identifier          "SDN:L22::TOOL1769";
        pav:authoredOn         "2022-02-16 10:20:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1769/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Geonica STH-S331";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A temperature and relative humidity probe designed to provide highly accurate and stable measurements in air. The STH-S331 temperature and relative humidity sensor is normally connected to METEODATA/HYDRODATA 2000/3000 data acquisition systems. The two sensing elements (Temperature and Relative Humidity) come up bound to a nylon plastic casing, which, on the one hand, allows an easy installation thanks to its direct coupling to solar radiation shields both with natural and forced cooling and, on the other hand, makes easier the connection to the measuring and/or acquisition system using a single 7-pin IP66 connector. The factory default temperature measurement range is -40 to +60 degrees Celsius, with an accuracy of +/-0.1 degrees Celsius and resolution of 0.01 degree Celsius; Other ranges are available. The relative humidity measurement range: 0-100% RH. The maximum humidity at the sensor is 100% RH up to 80 degrees Celsius, 75% RH at 100 degrees Celsius, 45% RH at 125 degrees Celsius, and 15% RH at 150 degrees Celsius. The accuracy of the relative humidity sensor is +/-0.8% RH at 23 degrees Celsius, and 3.3 VDC (volts of direct current), and its resolution is 0.1%."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1769";
        skos:note              "accepted"@en;
        skos:prefLabel         "Geonica STH-S331 {STH-5031} air temperature and relative humidity sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01863/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0199/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0197/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0197";
        dc:date                "2024-08-15 14:00:21.0";
        dc:identifier          "SDN:L22::TOOL0197";
        pav:authoredOn         "2024-08-15 14:00:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0197/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0197/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0197/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Gill Windsonic anemometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A 2-axis sonic anemometer measuring horizontal wind speed and direction that is suitable for land-based and marine environments. Available in four options, providing a number of different digital and analogue outputs."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0197";
        skos:note              "accepted"@en;
        skos:prefLabel         "Gill Instruments Windsonic anemometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00326/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1528/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1528";
        dc:date                "2020-08-24 11:07:49.0";
        dc:identifier          "SDN:L22::TOOL1528";
        pav:authoredOn         "2020-08-24 11:07:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1528/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kongsberg EM 2040";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A high-resolution multibeam echosounder designed to measure seafloor depth for use in mapping and inspection surveys. The EM 2040 is ideally suited for use on remotely operated vehicles (ROVs) and autonomous underwater vehicles (AUVs) due to its 6000 m depth capability. The system consists of a transmit transducer, a receive transducer, a processing unit (PU) and an operator station (HWS). The EM 2040 transducers consist of separate linear arrays for transmit and receive in a Mills cross configuration. The transmit array is electronically steerable alongtrack while the receive array is steerable athwartship. Both arrays contain analog electronics and digital control units with Ethernet interfaces to the PU. The EM 2040 can be made available with an additional receive transducer for dual swath capability (EM 2040D), enabling surveying to the surface or up to 10x the water depth. The EM 2040 operates within a frequency range of 200-400 kHz and is depth-rated to 6000 m. Predicted system depth errors are in the order of 0.1 % of depth. This instrument has been superseded by the EM 2040 MK II, which offers a wider frequency bandwidth of 200-700 kHz."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1528";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 2040 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1547/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1547";
        dc:date                "2020-10-27 10:29:53.0";
        dc:identifier          "SDN:L22::TOOL1547";
        pav:authoredOn         "2020-10-27 10:29:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1547/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Furuno GP-330B";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS04/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "A high-performance CAN bus GPS receiver antenna designed for use on marine vessels. It features a 14-channel all-in-view receiver with 12 dedicated GPS channels and 2 dedicated SBAS (WAAS/EGNOS/MSAS) channels. It has a receiving frequency of 1575.42 MHz (L1). The GP-330B is capable of data output in CAN bus/NMEA2000 format, so can be used with NavNet 3D systems. Its unique 'Pin-Enabled' termination resistor allows simple NMEA2000 backbone or drop wiring configurations. The GP-330B can be supplied with various optional 10 m NMEA cable assemblies, extensions, terminators and mounting base configurations. It is capable of 60 second cold start time-to-first-fix, and position is updated every second. Its GPS accuracy is 10m, MSAS accuracy is 7m and WAAS accuracy is 3m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1547";
        skos:note              "accepted"@en;
        skos:prefLabel         "Furuno GP-330B GPS/WAAS receiver antenna"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00571/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0115/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1566/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1566";
        dc:date                "2024-07-22 10:53:03.0";
        dc:identifier          "SDN:L22::TOOL1566";
        pav:authoredOn         "2024-07-22 10:53:03.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1566/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1566/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1566/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Microtrac Bluewave";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB27/>;
        skos:definition        "A tri-laser diffraction particle size and shape analyser designed to measure particle size from nanometre to millimetre range. It is available for both wet and dry dispersions of particles. It is a tri-laser, blue/red, multi-detector, multi-angle optical system using true blue lasers (not LEDs). It uses algorithms that utilize Mie compensation and Modified Mie calculations for spherical and non-spherical materials. It features two fixed photo-electric detectors with logarithmically spaced segments placed at correct angles for optimal scattered light detection from 0.02 to 165 degrees using 151 detector segments. It has a measurement range of 10 nm - 2.8 mm. It has 1x red laser at 780 nm and 2x blue laser at 405 nm. It has a measuring time of 10 to 30 seconds and can operate between 5 and 40 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1566";
        skos:note              "accepted"@en;
        skos:prefLabel         "Microtrac Bluewave particle size analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01748/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0128/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1585/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1585";
        dc:date                "2024-08-19 16:42:13.0";
        dc:identifier          "SDN:L22::TOOL1585";
        pav:authoredOn         "2024-08-19 16:42:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1585/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1585/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1585/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "LISST-Holo2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "The Sequoia Laser In-Situ Scattering and Transmissometry (LISST)-Holo2 is a submersible digital holographic particle imaging system for measurement of large, complex flocs, plankton, and other particles in water. It takes images at very short shutter times, scanning for a relatively large volume. The LISST-HOLO contains a red (658 nm) laser that emits collimated light into the sample volume. The light is scattered by suspended particles. The scattered light then interferes with the unscattered portion of the beam. The resulting interference pattern is captured by an onboard camera. The image captured by the camera is known as a hologram. The hologram can be digitally reconstructed to produce an in-focus picture of all the particles in the sample volume. Information about the particles size, shape, and position can all be extracted from the hologram. Holograms are captured at 20 Hz. The system has 237 GB of data memory."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1585";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sequoia LISST-Holo2 digital holographic particle imaging system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00275/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0057/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0011/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0011";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0011";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0011/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Bongo opening-closing net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "A pair of circular hoops (70 cm diameter  joined by a central axial which was clamped to a cable. A dacron cloth door covered each mouth opening which when released by a messenger, folded into the net mouth.  The nets were 71 cm in diameter, had a non-filtering collar section 84 cm long and a conical net 420 cm long with 0.505 mm mesh.  A flowmeter was present and after a set number of revolutions, caused the nets to be released from the hoops; choke ropes closed them [Wiebe and Benfield 2003 Plate 9 D]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0011";
        skos:note              "accepted"@en;
        skos:prefLabel         "Opening-closing Bongo net - McGowan and Brown (1966)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0030/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0030";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0030";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0030/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Wishner Deep-Tow net system";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/> , <http://vocab.nerc.ac.uk/collection/L05/current/68/>;
        skos:definition        "Three rectangular mouth opening nets ~30 cm wide x 44 cm tall and 130 cm long mounted on a metal framework attached to the bottom of the Deep-Tow Instrument . The unobstructed nets were opened/closed by surface command transmitted via conducting cable to a release mechanism [Wiebe and Benfield 2003 Plate 24 A]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0030";
        skos:note              "accepted"@en;
        skos:prefLabel         "Deep-Tow net system - Wishner (1980)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1344/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1344";
        dc:date                "2019-08-01 11:26:28.0";
        dc:identifier          "SDN:L22::TOOL1344";
        pav:authoredOn         "2019-08-01 11:26:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1344/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "DeltaT 837B 6000m";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A multibeam (swath) echosounder with video-imaging capability that operates to 6000 m. The Delta T is designed for low power consumption without a surface control box enabling it to be integrated into ROV and AUV systems. The sensor uses a 260 kHz acoustic frequency and 120 x 3 degrees field of view to measure the depth and nature of the sea floor. Operates with 120, 240 or 480 beams (3, 1.5 or 0.75 degree beam widths). Sensor is fitted with titanium housing as standard. Resolution is 0.02% of the range. Can be combined with an azimuth drive to obtain readings from direction which may limit depth."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1344";
        skos:note              "accepted"@en;
        skos:prefLabel         "Imagenex Delta T 837B 6000 m (profiling) multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0046/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00956/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1363/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1363";
        dc:date                "2024-08-15 14:30:41.0";
        dc:identifier          "SDN:L22::TOOL1363";
        pav:authoredOn         "2024-08-15 14:30:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1363/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1363/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Imagenex 881A Profiling";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/MPIS/> , <http://vocab.nerc.ac.uk/collection/L05/current/156/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A programmable multi-frequency digital scanning profiling single-beam echosounder. It is used for a variety of applications including surveying, dam face inspection, pipeline inspection, underwater archaeology and scientific research. It can be mounted on small vessels or on ROV, AUV and UUVs. Profiling sonar is primarily used for quantitative measurements where a narrow, conically shaped beam generates a single point per ping. The 881A Profiling has a default operating frequency of 675 kHz, but other frequencies are tunable from 600 kHz to 1 MHz in 5 kHz steps via programmable software configurations. The beam width varies from 0.9 x 10 degrees to 4 x 20 degrees depending on the frequency specified. The aluminium-housed instrument can operate up to 1000 m depth; a titanium-housed version is also available which operates up to 3000 m depth. At a range of 1 m to 4 m, it has a resolution of 2mm. At a range of 5 m or greater, it has a resolution of 10 mm. The minimum detectable range is 150 mm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1363";
        skos:note              "accepted"@en;
        skos:prefLabel         "Imagenex 881A Digital Multi-Frequency (profiling) singlebeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0046/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00956/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2186/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2186";
        dc:date                "2025-07-21 12:01:56.0";
        dc:identifier          "SDN:L22::TOOL2186";
        pav:authoredOn         "2025-07-21 12:01:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2186/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Silixa XT-DTS M";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A ruggedised distributed temperature sensor suitable for use in remote and hostile environments, ideal for shorter-distance, higher-resolution deployments. The XT-DTS M works under the principle of Raman based temperature measurement combined with Optical Time-Domain Reflectometry (OTDR). The XT-DTS M can be configured and controlled remotely, via a wireless or satellite link. Low power consumption enables operation with solar or wind power. This instrument can be configured to produce both single-ended and double-ended measurements. Measuring range: 10 km; Sampling and temperature resolution: 25/50 cm, 0.01 degrees celsius; Temperature range: -40 to 65 degrees celsius; Humidity: 10 - 85 percent non-condensing."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2186";
        skos:note              "accepted"@en;
        skos:prefLabel         "Silixa XT-DTS M Distributed Temperature Sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0346/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02119/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1103/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1103";
        dc:date                "2026-02-02 15:04:48.0";
        dc:identifier          "SDN:L22::TOOL1103";
        pav:authoredOn         "2026-02-02 15:04:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1103/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1103/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1103/3/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1103/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "NOC NO3+NO2 LOC v3.2c";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "A stand-alone microfluidic wet-chemical (colourimetric) nitrate and nitrite lab-on-chip (LOC) system designed to perform automated in-situ chemical analysis using the Griess assay. The instrument detects nitrate and nitrite (up to 350 µM, 21.7 mg/L as NO3-) with a limit of detection (LOD) of 0.025 µM for nitrate (0.0016 mg/L as NO3-) and 0.02 µM for nitrite (0.00092 mg/L as NO2-). This performance is suitable for all natural waters except for the oligotrophic open ocean. Beaton et al. (2012) has a full description of the technology."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/OG_SENSORS/current/>;
        skos:notation          "SDN:L22::TOOL1103";
        skos:note              "accepted"@en;
        skos:prefLabel         "National Oceanography Centre (NOC) Nitrate and Nitrite v3.2c Lab-On-Chip (LOC) sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00009/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1122/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1122";
        dc:date                "2017-04-04 10:06:11.0";
        dc:identifier          "SDN:L22::TOOL1122";
        pav:authoredOn         "2017-04-04 10:06:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1122/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SBE 39plus";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "A water body temperature sensor. It is designed for moorings or other long-duration, fixed-site deployments, as well as deployments on nets, towed vehicles, or ROVs. It uses an aged and pressure-protected thermistor that is available in two configurations: embedded in titanium endcap (25-sec time constant) for rugged conditions, or external thermistor in pressure-protected sheath (0.5-sec time constant) for fast sampling. It can be fitted with an optional strain-gauge pressure sensor with temperature compensation available in eight ranges (maximum depth 7000 m). Sensor housing is either PET plastic or titanium. The temperature sensor has a measurement range of -5 to +45 deg C, an accuracy of +/- 0.002 (-5 to +35 deg C) or +/- 0.01 (+35 to +45 deg C) and a depth rating of 600 m (plastic) or 10,500 m (titanium)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1122";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird SBE 39plus temperature sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1160/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1160";
        dc:date                "2017-10-16 12:08:03.0";
        dc:identifier          "SDN:L22::TOOL1160";
        pav:authoredOn         "2017-10-16 12:08:03.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1160/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Vemco VR2W";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "A single channel acoustic receiver comprising hydrophone, receiver, ID detector, data logging memory and battery all within submersible housing. It is used to remotely retrieve ID numbers and time stamps from all Vemco 69 and 180 kHz acoustic transmitter tags deployed on marine fauna travelling within the VR2W's receiver range. The VR2W is ideal for use in river monitoring or freshwater lake studies, as well as large tracking operations in oceanic systems. Depth, temperature and other data can also be downloaded, and uploaded to a PC via Bluetooth wireless technology at a rate of approximately 8 seconds per 10000 detections. The VR2W features 16 MB internal storage, enabling storage of approximately 1.6 million detections."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1160";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vemco VR2W Single Channel Receiver"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00348/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0830/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0830";
        dc:date                "2015-02-19 10:36:40.0";
        dc:identifier          "SDN:L22::TOOL0830";
        pav:authoredOn         "2015-02-19 10:36:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0830/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "AML Smart SV+P SVP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/111/> , <http://vocab.nerc.ac.uk/collection/L05/current/185/>;
        skos:definition        "A sound velocity probe for use in shallow water applications, multi-beam systems and can also be integrated in AUV and ROV systems. The probe directly measures sound velocity by the time-of flight of an acoustic ping. It also measures pressure using a temperature-compensated strain gauge. It has a range of 1400 m/s - 1600 m/s and an accuracy of +/-0.05 m/s. It has a pressure range up to 6000 m (accuracy +/-0.05% FS)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0830";
        skos:note              "accepted"@en;
        skos:prefLabel         "AML Oceanographic Smart SV and P sound velocity probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG0236/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1959/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1959";
        dc:date                "2023-06-16 12:12:22.0";
        dc:identifier          "SDN:L22::TOOL1959";
        pav:authoredOn         "2023-06-16 12:12:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1959/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Canon PowerShot G16";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A compact multi-purpose handheld digital camera featuring a 1/1.7 back-illuminated CMOS image sensor, with 12.1M pixels. It features a DIGIC 6 image processor with iSAPS technology. The lens has a 6.1 - 30.5 mm focal length (35 mm equivalent: 28 - 140 mm: f/1.8-2.8) and 5x optical zoom (10x ZoomPlus). It has a 1 - 1/4000 sec. default shutter speed, up to 250 - 1/4000 sec. total range depending on the shooting mode. The LCD screen is a 7.5 cm (3.0\") PureColor II G LCD (TFT). Image compression is available in RAW, Superfine or Fine. Video is available in full HD 1920 x 1080, 60 fps/30fps (HD) 1280 x 720, 30 fps, (L) 640 x 480, 30 fps."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1959";
        skos:note              "accepted"@en;
        skos:prefLabel         "Canon PowerShot G16 digital camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02011/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0260/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1978/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1978";
        dc:date                "2023-08-01 08:47:26.0";
        dc:identifier          "SDN:L22::TOOL1978";
        pav:authoredOn         "2023-08-01 08:47:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1978/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Shimadzu TOC-500";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB01/>;
        skos:definition        "A total organic carbon (TOC) analyser designed to measure organic carbon concentrations. Used by chemical and pharmaceutical manufacturers and petrochemical production companies. The first TOC to use the 680 deg. C combustion method, using a high-performance platinum catalyst. The method is called the high temperature catalytic oxidation (HTCO) method. This instrument uses an improved analyser layout and simplified catalyst replacement method. Data processing allows for the automatic integration of peaks. The system compares the peak area, instead of height to calibration, to be much more selective for carbon, regardless of how easy or hard a compound is to oxidize. The TOC-500 can be programmed for various methods via keyboard, and after analysis a report can be printed on thermal paper, including result and statistical parameters necessary for quality control. The TOC-500 was first produced in 1983, and was the first Shimadzu TOC instrument to be launched globally in 1987."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1978";
        skos:note              "accepted"@en;
        skos:prefLabel         "Shimadzu TOC 500 Total Organic Carbon Analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00919/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0045/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1997/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1997";
        dc:date                "2023-12-19 12:20:35.0";
        dc:identifier          "SDN:L22::TOOL1997";
        pav:authoredOn         "2023-12-19 12:20:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1997/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "USC 06000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/51/>;
        skos:definition        "A gravity corer designed to sample the top 3 m of the surface layer of any sediment. The corer can sample in standing or flowing waters at up to 300 m depth. It can be deployed from shore or waterborne platforms and vessels. The USC 06000 model has a volume of approximately 1.6 litres, and weighs 6.13 kg. The corer has numerous expansion and fixture options."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1997";
        skos:note              "accepted"@en;
        skos:prefLabel         "UWITEC Single Corer (USC) 06000 gravity corer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0271/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02028/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0349/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0349";
        dc:date                "2024-08-14 15:25:42.0";
        dc:identifier          "SDN:L22::TOOL0349";
        pav:authoredOn         "2024-08-14 15:25:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0349/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0349/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "C-Nav3050";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS04/>;
        skos:definition        "A 66-channel \"all-in-view\" parallel tracking combined GPS/GNSS/L-band receiver providing high accuracy positional information worldwide between 72N and 72S. The C-Nav3050 tracks GPS, GLONASS, Galileo, C-Nav and other SBAS signals, producing positional fixes with a horizontal accuracy of <10 cm and a vertical accuracy of <15 cm. The instrument has a range of user-programmable output rates (1, 5, 10, 25, 50, and 100 Hz)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0349";
        skos:note              "accepted"@en;
        skos:prefLabel         "C & C Technologies C-Nav3050 satellite positioning system receiver"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00486/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0368/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0368";
        dc:date                "2011-01-28 12:46:19.0";
        dc:identifier          "SDN:L22::TOOL0368";
        pav:authoredOn         "2011-01-28 12:46:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0368/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Cyclops-7 CDOM fluorometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "A high performance, in-situ fluorometer with 365 nm excitation filter and 470 nm emission filter which detects coloured dissolved organic matter (CDOM). Tests with quinine sulphate have shown the instrument to have a minimum detection limit of 0.4 ppb and a dynamic range of 0-2500 ppb. The instrument can be used at depths of up to 600 m and in water temperatures of -2 to 50 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0368";
        skos:note              "accepted"@en;
        skos:prefLabel         "Turner Designs Cyclops-7 coloured dissolved organic matter fluorometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00400/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0387/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0387";
        dc:date                "2011-04-08 07:51:17.0";
        dc:identifier          "SDN:L22::TOOL0387";
        pav:authoredOn         "2011-04-08 07:51:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0387/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RBR TGR-1050P";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/111/>;
        skos:definition        "A pressure recorder designed to measure tides. Possible ranges are 10, 20 50 and 100 dbar, with an accuracy of ± 0.05% full scale, resolution of <0.001% full scale and a time constant of <10 msec. Pressure data are sampled at 4Hz. The sample period and the length of the averaging burst are fully programmable. It has a built-in averaging function to eliminate wave action."@en;
