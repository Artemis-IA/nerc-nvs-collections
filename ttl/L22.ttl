<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0780/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0780";
        dc:date                "2024-08-22 15:12:06.0";
        dc:identifier          "SDN:L22::TOOL0780";
        pav:authoredOn         "2024-08-22 15:12:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0780/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0780/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Vaisala PA11";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "An aviation quality digital barometer providing accurate and reliable pressure measurement over the range of 800 to 1050 mb. It had a unique construction consisting of three independently operating sensors controlled by a microprocessor. Triple redundancy ensured excellent long-term stability and measurement accuracy. Short term accuracy was determined by WMO as about 0.2 hPa and long-term accuracy (over approximately a year) was determined as approximately 0.35 hPa or 0.45 hPa if subjected to temperature variations in excess of 20 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0780";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala PA11 digital barometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0299/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0299";
        dc:date                "2011-07-01 10:20:53.0";
        dc:identifier          "SDN:L22::TOOL0299";
        pav:authoredOn         "2011-07-01 10:20:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0299/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0299/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0299/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "GRIMM 1.108 aerosol spec";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/386/>;
        skos:definition        "An instrument that measures size-resolved aerosol abundances in the atmosphere. The ambient air sample is size-classified by a Differential Mobility Analyser, then counted by an Optical Particle Counter. The sample exits the OPC and is deposited on a PTFE filter. The filter may be removed for subsequent, bulk gravimetric or chemical analysis."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0299";
        skos:note              "accepted"@en;
        skos:prefLabel         "GRIMM 1.108 aerosol spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00456/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1649/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1649";
        dc:date                "2023-04-13 09:19:28.0";
        dc:identifier          "SDN:L22::TOOL1649";
        pav:authoredOn         "2023-04-13 09:19:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1649/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1649/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "4-Deep HoloSea S7";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB51/>;
        skos:definition        "A submersible holographic microscope for use in water profiling and monitoring applications, as well as particle, phytoplankton and zooplankton imaging for counts and morphological analysis. It outputs up to 22 images per second in real-time. It uses the principle of digital inline holography (DIH) to produce enlarged images of an object and its 3D structure. A laser is directed into a pinhole from which a spherical wave emanates. The wave illuminates the object and forms a geometrically magnified diffraction pattern on a charged couple device (CCD) screen. The interference pattern produced is displayed as a hologram stored as a digital image. The 3D structure of the object from the 2D hologram is reconstructed using a numerical algorithm (Kirchhoff-Helmholtz transform). The HoloSea S7 can be towed at 8 knots. The laser light source has a wavelength of 405 nm. It is pressure rated to 500 m with a cable depth of 100 m, but custom 6000 m rated models are also available."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1649";
        skos:note              "accepted"@en;
        skos:prefLabel         "4-Deep Inwater Imaging HoloSea S7 submersible holographic microscope"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01770/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0147/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1668/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1668";
        dc:date                "2021-03-23 17:29:08.0";
        dc:identifier          "SDN:L22::TOOL1668";
        pav:authoredOn         "2021-03-23 17:29:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1668/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Technicap PPS 3-3 24S";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/33/>;
        skos:definition        "A mooring sediment trap designed for long-term continuous deployments. It is used for the determine the flux of settling particles in-situ. It uses a funnel to collect passing settled particles into one of a set of bottles mounted on a carousel. The bottles are changed after a set period of time. It consists of a cylindro-conical funnel (collecting area of 0.125 m2) with a phenolic composite baffle (cell dia. 9.5 mm) to prevent large objects clogging the system. The trap is fitted with 24 x 250 ml or 24 x 500 ml polypropylen sampling bottles. It is capable of 18 month deployments (24 months with Lithium batteries) and has a sampling interval of 1 minute. It has a maximum operating depth of 1000 m (PETP) or 5000m (Aluminium) or 6000m (Titanium)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1668";
        skos:note              "accepted"@en;
        skos:prefLabel         "Technicap PPS 3-3 24S sediment trap series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01178/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0172/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1687/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1687";
        dc:date                "2024-08-22 15:12:06.0";
        dc:identifier          "SDN:L22::TOOL1687";
        pav:authoredOn         "2024-08-22 15:12:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1687/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1687/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1687/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1687/3/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "Vaisala HMP155 180R";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A humidity and temperature sensor which utilises the Vaisala HUMICAP 180R sensor designed for long term stability in high-humidity environments. The sensor head is warmed to ensure the humidity level inside stays below the ambient level, to reduce the risk of condensation forming on the probe and corrupting the measurements. The instrument is also capable of measuring dew point, frost point temperature, wet bulb temperature, and mixing ratio. The instrument features a membrane filter to speed up the relative humidity measurement, for use in environments with fast changing temperatures. The HMP155 measures humidity between 0 and 100 % relative humidity, at an accuracy of +/- 1 % for measurements between 0 and 90% relative humidity, and +/- 1.7 % for measurements between 90 and 100 % relative humidity, at ambient temperatures of 15 to 25 degC. At temperatures outside this range, humidity measurement accuracy ranges from 1.8 to 4.6 % relative humidity. The HMP155 measures temperature within an observational range of -80 to 60 degC, at an accuracy of between +/- 0.12 and 0.45 degC depending on the ambient temperature and output setting."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1687";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala HUMICAP 180R HMP155 humidity and temperature probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0025/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0132/>
        rdf:type               skos:Concept;
