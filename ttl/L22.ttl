<http://vocab.nerc.ac.uk/collection/L22/current/NETT0173/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0173";
        dc:date                "2012-10-12 14:13:09.0";
        dc:identifier          "SDN:L22::NETT0173";
        pav:authoredOn         "2012-10-12 14:13:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0173/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Plankton pump sampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "An in situ pump and net system for collecting plankton samples. Water is pumped at approximately 1.2 m^3 per minute through a mesh, and samples are collected in the net cod end. The device was used on research cruises in the late 1990s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0173";
        skos:note              "accepted"@en;
        skos:prefLabel         "Plankton pump sampler"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0098/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0098";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0098";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0098/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Weikert modified MPS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/> , <http://vocab.nerc.ac.uk/collection/L05/current/68/>;
        skos:definition        "A modified version of the Be MPS net with a rectangular sampler box 50 cm x 50 cm on a side and 60 cm deep equipped with 5 nets (0.3 mm mesh) each 250 cm long.  Nets are opened and closed electronically through conducting cable and pressure is monitored. No flowmeter used [Wiebe and Benfield 2003 Plate 31 A, B]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0098";
        skos:note              "accepted"@en;
        skos:prefLabel         "Modified Multiple Plankton Sampler - Weikert and John (1981)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0135/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0135";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0135";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0135/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Parachute net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "This has a 275 cm diameter parachute opening tapering over a distance of 350 cm to a 100 cm diameter mosquito netting net.  Free fall to bottom with concrete weights, released by salt block dissolution, and floated backwards to surface with gasoline float [Wiebe and Benfield 2003 Plate 11 B]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0135";
        skos:note              "accepted"@en;
        skos:prefLabel         "Parachute net - Wheeler (1941)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0992/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0992";
        dc:date                "2016-04-04 14:47:13.0";
        dc:identifier          "SDN:L22::TOOL0992";
        pav:authoredOn         "2016-04-04 14:47:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0992/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "F-Net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "The foredeck (also fore-deck) net was designed by Doug Bone (Gear Development, British Antarctic Survey) in 1980. It has a square net mouth of 1 square metre area and is fitted with a 5 millimetre mesh tapering over 3 metre to a solid conical cod end. The foredeck net is towed from the hydrolic crane at a depth near to the sea surface."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0992";
        skos:note              "accepted"@en;
        skos:prefLabel         "British Antarctic Survey Foredeck Net"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0129/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0129";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0129";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0129/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Bigelow opening-closing net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "A hinged ring to which a net with 75 cm diameter mouth was attached. System sent down with ring closed and opened with a messenger. A second messenger released the ring and a draw-string closed the net off."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0129";
        skos:note              "accepted"@en;
        skos:prefLabel         "Horizontal opening-closing net - Bigelow (1913)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0833/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0833";
        dc:date                "2015-02-19 10:36:40.0";
        dc:identifier          "SDN:L22::TOOL0833";
        pav:authoredOn         "2015-02-19 10:36:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0833/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "IXBlue Hydrins";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS19/>;
        skos:definition        "An inertial navigation system for use in multibeam echo sounder systems. It uses fibre optic gyros and accelorometers to determine heading, attitude and position (via dead reckoning). The unit can accept positional aiding from Global Positioning Systems (GPS) and Doppler Velocity Logs (DVL). There has been more than one generation of the unit, however, the heading accuracy is typically better than 0.02 deg and the roll or pitch accuracy is better than 0.01 deg. The navigation system was first manufactured by IXSea which is now part of IXBlue."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0833";
        skos:note              "accepted"@en;
        skos:prefLabel         "IXBlue Hydrins inertial navigation system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00459/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1854/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1854";
        dc:date                "2022-10-10 14:39:24.0";
