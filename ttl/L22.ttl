<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0685/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0685";
        dc:date                "2024-08-14 10:00:16.0";
        dc:identifier          "SDN:L22::TOOL0685";
        pav:authoredOn         "2024-08-14 10:00:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0685/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0685/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "AQUAlogger 520PT";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/111/>;
        skos:definition        "A miniature (200 mm long, 32 mm diameter) self-contained data logger incorporating a thermistor temperature sensor (resolution better that 0.007 degC, accuracy 0.05 degC) and a pressure sensor in a housing designed to operate at depths down to 1000 m.  The type of pressure sensor fitted depends upon the maximum operating depth required with resolution and accuracy a function of the full-scale reading. The logger may be programmed to provide a wide variety of sampling regimes, including burst recording. More information may be found in http://www.aquatecgroup.com/images/manual_guides/bg%20-%20520.pdf."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0685";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aquatec AQUAlogger 520PT mini temperature and pressure logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00798/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0013/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0013";
        dc:date                "2008-11-28 07:54:41.0";
        dc:identifier          "SDN:L22::TOOL0013";
        pav:authoredOn         "2008-11-28 07:54:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0013/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Pressure point";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/111/>;
        skos:definition        "The Dataring pressure point comprises differential transducers contained in a watertight housing. The reference port is vented to atmosphere via the power supply and signal cable tube, while the measuring port of the transducer is connected to a copper outlet nozzle on the top of the transducer housing. The copper nozzle, transducer measuring port and connecting tube are filled with oil so the pressure is transmitted to the crystal element via the oil, thus keeping the transducer components free from the effects of the saltwater."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0013";
        skos:note              "accepted"@en;
        skos:prefLabel         "Dataring pressure point transducer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00003/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0809/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0809";
        dc:date                "2014-11-19 14:11:16.0";
        dc:identifier          "SDN:L22::TOOL0809";
        pav:authoredOn         "2014-11-19 14:11:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0809/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0809/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "RBR TGR-2050 TG";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/111/>;
        skos:definition        "A small (265mm x 38mm OD) self-contained, submersible temperature and pressure logger designed to monitor tide levels without interference from wave action by averaging pressure data sampled at 4 Hz. This operating mode differentiates it from the similar TDR-2050. Temperature channel is calibrated to ±0.002C. Depth channel is calibrated to an accuracy of ±0.05% full scale."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0809";
        skos:note              "accepted"@en;
        skos:prefLabel         "RBR TGR-2050 submersible tide gauge"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00299/> .

