<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1796/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1796";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL1796";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1796/5/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1796/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1796/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1796/3/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1796/4/>;
        pav:version            "5";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "5";
        skos:altLabel          "Kongsberg Simrad SU90";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/FFES/>;
        skos:definition        "The Simrad SU90 is a 360 degree omnidirectional fish finding sonar with an operational range of 150 to 4500 metres (standard) or 150 to 8000 metres (optional), and a selectable frequency of 20 to 30 kHz. The SU90 processor unit includes Simrad signal processing software to ensure a clutter free picture with very high resolution in range. The instrument features narrow beams with an opening angle of 4.9 degrees at 30 kHz, automatic roll and pitch stabilisation of +/- 20 degrees and a source level of 3 dB to enable low frequency, high resolution sounding. The instrument is available with three hull configurations differentiated by how far the transducer can be lowered below the hull and the resulting maximum operational speed. The SU92 (standard) can be lowered 1.2 metres limiting speed to 21 knots, the SU93 can be lowered 1.6 metres limiting speed to 18 knots and the SU94 can be lowered 2.1 metres limiting speed to 11 knots. Each hull unit (except the SU94) can be supplied with a 4.6 or 7 m transducer cable. The SU94 is only supplied with a 4.6 m transducer cable."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1796";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg Simrad SU90 fish finding sonar"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0154/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0783/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0783";
        dc:date                "2014-08-26 15:43:04.0";
        dc:identifier          "SDN:L22::TOOL0783";
        pav:authoredOn         "2014-08-26 15:43:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0783/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Forel-Ule Vials";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/COLCMP/>;
        skos:definition        "A set of 21 glass vials in a frame containing standard solutions made with differing proportions of distilled water, ammonia, copper sulphate, potassium chromate and cobalt sulphate. The formulations result in a colour palette that covers naturally occurring water bodies, which are visually compared in-situ with the vials and assigned the number (1-21) of the nearest colour match."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0783";
        skos:note              "accepted"@en;
        skos:prefLabel         "Liquid Vial Forel-Ule Colour Comparator"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00239/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0782/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0782";
        dc:date                "2014-08-26 15:37:47.0";
        dc:identifier          "SDN:L22::TOOL0782";
        pav:authoredOn         "2014-08-26 15:37:47.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0782/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Atelier VIX Forel-Ule filters";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/COLCMP/>;
        skos:definition        "A set of 21 plastic filters that match the colours of the standard Forel-Ule vials. Natural water bodies are colour matched in-situ by visual comparison with the filters and assigned the number (1-21) of the nearest match. The filters were designed by scientists at NIOZ and are manufactured by  Altelier VIX.  More information is available at DOI: http://dx.doi.org/10.2971/jeos.2014.14025."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0782";
        skos:note              "accepted"@en;
        skos:prefLabel         "Atelier VIX plastic Forel-Ule colour comparator"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00902/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1517/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1517";
        dc:date                "2024-08-19 14:03:58.0";
        dc:identifier          "SDN:L22::TOOL1517";
        pav:authoredOn         "2024-08-19 14:03:58.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1517/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1517/1/>;
        pav:version            "2";
