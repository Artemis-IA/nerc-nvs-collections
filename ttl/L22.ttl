<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2150/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2150";
        dc:date                "2025-04-24 13:01:00.0";
        dc:identifier          "SDN:L22::TOOL2150";
        pav:authoredOn         "2025-04-24 13:01:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2150/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ClearWater Phosphate Sensor";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "A miniaturised microfluidic phosphate sensor based on advanced lab-on-chip (LOC) technology. Designed to perform an automated in-situ wet-chemical analysis in any liquid water environment. Can be deployed in time-series mode for fixed-location deployments or in profiling mode for autonomous vehicles or profilers. The sensor draws in a water sample which passes through a 0.45 um pore-size filter membrane to prevent blockages. The sample is mixed with chemical reagents and the resulting colour change is measured using LEDs and photodiodes. The sensors carry onboard reference standards which are analysed frequently to correct for instrumental drift. All chemical waste is stored within waste bags inside the instrument. Data can be accessed in real time via the RS232 interface or post deployment via USB download. Sample volume is 0.6 mL and measurement interval is 27 mins with calibration or 9 mins in profiling mode (no calibration during profile measurement). Measurement range is 0 - 10uM phosphate (0 - 20 uM is available upon request). Limit of detection is 0.05 uM and typical precision is 2%. Temperature range 0 - 35 degrees C. Depth rating 6000 m. Sensor can be configured for use within an autonomous vehicle or any other application where reagent housing might not easily fit upon request."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2150";
        skos:note              "accepted"@en;
        skos:prefLabel         "ClearWater Phosphate Lab-On-Chip (LOC) sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01993/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0246/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0370/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0370";
        dc:date                "2011-02-09 11:25:51.0";
        dc:identifier          "SDN:L22::TOOL0370";
        pav:authoredOn         "2011-02-09 11:25:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0370/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NOC Nitrate Sensor SUV6";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "An in situ UV absorption spectrophotometer that measures nitrate concentrations in the ocean. The sensor is rated to either 500 m or 6000 m. It uses a Xenon flash lamp as a light source and has a path length of either 70 mm or 200 mm, permitting nitrate detection up to 400 uM or 100 uM, respectively. The minimum nitrate detection limit is 0.2 uM and accuracy is +/- 0.2 uM. Nitrate concentrations are determined from the ratio of the absorption at 220 nm and 280 nm. The sensor was developed by NOC in association with Valeport Ltd."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0370";
        skos:note              "accepted"@en;
        skos:prefLabel         "National Oceanography Centre Nitrate Sensor SUV6"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00009/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1898/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1898";
        dc:date                "2023-02-20 13:04:51.0";
        dc:identifier          "SDN:L22::TOOL1898";
        pav:authoredOn         "2023-02-20 13:04:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1898/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sea-Bird HydroCycle-PO4";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "An in-situ wet chemical sensor. It is used for continuous or real-time measurement in submersible fresh or saltwater environments. It is designed to observe dissolved phosphate. It uses fluidics and optics for nutrient monitoring. It uses a wavelength of 870 nm and path length of 5 cm. It features a NIST traceable on-board standard and both SDI-12 and RS232 telemetry. It uses an ultra-high-molecular-weight polyethylene filter with 5-10 uM (7.5 uM average) pore size. It has a detection limit of less than or equal to 0.075 uM or less than or equal to 0.0023 mg/L PO4-P. It has an operational measurement range of 0-10 uM or 0-0.03 mg/L PO4-P. It is depth rated to 200 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1898";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird HydroCycle-PO4 phosphate sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1896/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1896";
        dc:date                "2023-02-03 10:05:19.0";
        dc:identifier          "SDN:L22::TOOL1896";
        pav:authoredOn         "2023-02-03 10:05:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1896/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ClearWater NO3+NO2 Sensor";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "A stand-alone microfluidic wet-chemical (colourimetric) nitrate and nitrite lab-on-chip (LOC) system. Designed to perform automated in-situ chemical analyses, in multiple scenarios from salt to fresh water and profiles to moorings. The instrument outputs the Nitrate+Nitrite concentration in &micro;mol/L. It is designed to filter a water sample through a 0.45 &micro;m filter, mix it with chemical reagents, and measure the resulting colour change using LEDs and photodiodes. The sensors carry onboard reference standards which are analysed frequently to correct for instrumental drift. The instrument can be used fully submerged or at the surface. Data can be accessed in real time via the RS232 interface or post deployment via USB download. Without calibration it samples every 5 min., with calibration every 15 min. The sample volume is 0.6 mL. It measures Nitrate+Nitrite in a range of 0-1000 &micro;mol/L with a detection limit of 0.025 &micro;mol/L. Depth rating 6000 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1896";
        skos:note              "accepted"@en;
        skos:prefLabel         "ClearWater Nitrate + Nitrate Lab-On-Chip (LOC) sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01993/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0246/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0489/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0489";
        dc:date                "2024-08-12 16:30:39.0";
        dc:identifier          "SDN:L22::TOOL0489";
        pav:authoredOn         "2024-08-12 16:30:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0489/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0489/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Satlantic SUNA NO3 analyser";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "The Submersible Ultraviolet Nitrate Analyser (SUNA) uses ultraviolet absorption spectroscopy to measure in-situ dissolved nitrate. It is a chemical-free method that allows real-time and continuous nitrate concentration measurements in a variety of environments. It has a 1 cm path length, 190 - 370 nm wavelength range and a depth rating of 100 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0489";
        skos:note              "accepted"@en;
        skos:prefLabel         "Satlantic Submersible Ultraviolet Nitrate Analyser (SUNA)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00365/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0528/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0528";
        dc:date                "2024-08-12 16:32:09.0";
        dc:identifier          "SDN:L22::TOOL0528";
        pav:authoredOn         "2024-08-12 16:32:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0528/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0528/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0528/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Satlantic ISUS V3 NO3 sensor";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "An active optical instrument with an internal UV light source and spectrometer used to measure in-situ dissolved nitrate. It is a chemical-free method that allows real-time and continuous nitrate concentration measurements in a variety of environments. It uses a Deuterium lamp as a light source and has a 1cm path length and 200-400 nm wavelength range. It has a depth rating of 1000 m and a detection range of  0.5 to 2000 uM *(0.007 to 28 mg/l-N)  and accuracy of +/- 0.2 uM (0.028 mg/l) or ± 10% of reading, whichever is greater. The V3 has USB data transfer ability and window based software."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0528";
        skos:note              "accepted"@en;
        skos:prefLabel         "Satlantic {Sea-Bird} ISUS V3 Nitrate Sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00365/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0135/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0135";
        dc:date                "2024-08-01 14:12:23.0";
        dc:identifier          "SDN:L22::TOOL0135";
