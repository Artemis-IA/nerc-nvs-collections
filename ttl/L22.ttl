<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0462/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0462";
        dc:date                "2024-08-21 16:29:33.0";
        dc:identifier          "SDN:L22::TOOL0462";
        pav:authoredOn         "2024-08-21 16:29:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0462/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0462/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0462/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "ThermoF Neptune ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "A laboratory high mass resolution inductively coupled plasma mass spectrometer (ICP-MS) designed for elemental and isotopic analysis. The instrument is based on a multicollector platform, comprising eight moveable collector supports and one fixed centre channel equipped with a Faraday cup and, optionally, an ion counter with or without a retardation lens. The Faraday cup is connected to a current amplifier, whose signal is digitised by a high linearity voltage to frequency converter. The instrument was originally manufactured by Thermo Finnigan, which was acquired by Thermo Electron and later Thermo Scientific (part of Thermo Fisher Scientific)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0462";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Finnigan {Thermo Fisher Scientific} Neptune inductively coupled plasma mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0017/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0017";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0017";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0017/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Bary Catcher HSS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/> , <http://vocab.nerc.ac.uk/collection/L05/current/67/>;
        skos:definition        "Has a 22.9 cm diameter mouth opening behind a closing valve. The tube chamber is 19.5 cm diameter.  The overall length of the outer fiberglass shell is 213 cm. Two metal nets can be used, one with 15.70 meshes per cm and one with 3.9 meshes per cm. Has depth-flowmeter (like that of Currie and Foxton, 1957) in the tail. Towed up to 10 knots. More than one unit can be attached to the wire. Can be used for vertical or horizontal towing [Wiebe and Benfield 2003 Plate 18 B, C]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0017";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bary Catcher high-speed plankton sampler - Bary et al. (1958)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0481/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0481";
        dc:date                "2012-03-19 13:44:14.0";
        dc:identifier          "SDN:L22::TOOL0481";
        pav:authoredOn         "2012-03-19 13:44:14.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0481/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "VINDTA 3C TIC and TA analyser";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB12/>;
        skos:definition        "The Versatile INstrument for the Determination of Total inorganic carbon and titration Alkalinity (VINDTA) 3C is a laboratory alkalinity titration system combined with an extraction unit for coulometric titration, which simultaneously determines the alkalinity and dissolved inorganic carbon content of a sample. The sample transport is performed with peristaltic pumps and acid is added to the sample using a membrane pump. No pressurizing system is required and only one gas supply (nitrogen or dry and CO2-free air) is necessary. The system uses a Metrohm Titrino 719S, an ORION-Ross pH electrode and a Metrohm reference electrode. The burette, the pipette and the analysis cell have a water jacket around them. Precision is typically ± 1 umol/kg for TA and/or DIC in open ocean water."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0481";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marianda VINDTA 3C total inorganic carbon and titration alkalinity analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00584/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1119/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1119";
        dc:date                "2024-08-19 12:01:15.0";
        dc:identifier          "SDN:L22::TOOL1119";
        pav:authoredOn         "2024-08-19 12:01:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1119/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1119/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1119/3/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1119/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "Pro-Oceanus CO2-Pro";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "An in-situ dissolved gas sensor measuring the partial pressure of CO2 (pCO2) gas dissolved in water using infrared detection. It is designed for shallow water applications. An internal zeroing feature provides a stable long-term baseline for ensuring accurate and stable measurements. The CO2-Pro can also be modified to measure both water and air pCO2. Standard range: 0 - 600 ppm to 0 - 2000 ppm. Accuracy: +/- 0.5 %. Resolution: 0.01 ppm. Depth: 50 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1119";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pro-Oceanus CO2-Pro submersible pCO2 sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00774/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0036/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0036";
        dc:date                "2009-11-30 11:56:35.0";
        dc:identifier          "SDN:L22::TOOL0036";
        pav:authoredOn         "2009-11-30 11:56:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0036/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SBE 43 DO";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/351/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "High performance through-flow Clark polarographic membrane sensor designed to be plumbed in to a Sea-Bird underwater unit pumped water supply on a profiling CTD package. Designed specifically to give rapid temperature response and minimal pressure hysteresis. Signal output is voltage based to interface to a CTD deck unit."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0036";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird SBE 43 Dissolved Oxygen Sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> , <http://vocab.nerc.ac.uk/collection/P01/current/DOXYSU01/> , <http://vocab.nerc.ac.uk/collection/P01/current/OXYSSU01/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1674/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1674";
        dc:date                "2021-03-30 14:15:43.0";
        dc:identifier          "SDN:L22::TOOL1674";
        pav:authoredOn         "2021-03-30 14:15:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1674/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Apollo SciTech AS-P3";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/351/>;
        skos:definition        "A continuous measurement pCO2 system. It is designed for land or ship-board laboratory use. Water sample is forced into the equilibrator by a shipboard pump. Equilibrated air is drawn from the equilibrator and dried with an electronic cooling system and a Nafion dry tube. It is then quantified with a CRDS CO2 analyser (Picarro G-2301) and/or an infrared CO2 analyser (LI-7000) before returning to the equilibrator. Optional sensors can be integrated. It measures at <100 -3000 uatm. Response time is 2 minutes. Repeatability is <1 ppm. Accuracy is +/- 1 to 2 ppm for pCO2. The detector can be replaced with a LI-850 analyser (pCO2 ranges 0-20,000 uatm) or LI-7815."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1674";
        skos:note              "accepted"@en;
        skos:prefLabel         "Apollo SciTech AS-P3 combined pCO2 analyser and underway system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0174/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01043/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0277/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0277";
        dc:date                "2010-05-18 16:10:58.0";
