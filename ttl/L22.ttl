<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0295/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0295";
        dc:date                "2024-08-23 15:47:12.0";
        dc:identifier          "SDN:L22::TOOL0295";
        pav:authoredOn         "2024-08-23 15:47:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0295/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0295/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0295/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "RDI WS 300 kHz ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://mmisw.org/ont/trdi/models/Sentinel>;
        skos:definition        "An ADCP designed for self-contained use on moorings or vessel mounting. It has a patented 300 kHz broadband signal and a standard depth rating of 200 metres. It operates effectively between temperatures of -5 to 45 degC and a range of up to 165 m with a depth cell size of 8 m. Velocity accuracy is +/- 0.5 % or 0.5 cm/sec."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0295";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Sentinel 300 kHz ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2279/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2279";
        dc:date                "2026-03-11 09:15:07.0";
        dc:identifier          "SDN:L22::TOOL2279";
        pav:authoredOn         "2026-03-11 09:15:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2279/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2279/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Rockland Scientific FloatRider";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/184/>;
        skos:definition        "A sensor package designed to integrate onto profiling floats, providing persistent direct measurements of micro-scale turbulence autonomously. The FloatRider is suitable for studying ocean mixing, ocean-atmosphere interactions, heat transfer, and fluxes of energy, oxygen, and nutrients. It delivers near-real-time band averaged spectra data. This instrument measures small-scale fluctuations in temperature in order to determine turbulence. This sensor includes two microstructure micro-temperature sensors as standard. A shear probe configuration is available. Micro-temperature range: -5 to 35 degC; accuracy: 0.005 degC; resolution: 0.00001 degC. Sampling rate: 256 Hz (optional 512 Hz sampling available). Depth rating: 2000 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2279";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rockland Scientific FloatRider turbulence sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00677/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0022/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0054/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0054";
        dc:date                "2009-11-30 11:56:35.0";
        dc:identifier          "SDN:L22::TOOL0054";
        pav:authoredOn         "2009-11-30 11:56:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0054/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RBR TDR-2050";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "The TDR-2050 is a small (235mm x 38mm OD), self-contained, submersible temperature and depth recorder (sensors and data logger). It can be deployed for a period of up to three years and can collect more than 1,200,000 sets of samples. Data can be retained in memory for 20 years (even without batteries). Available in two casings, plastic and titanium, with depth ratings of 740m and 6600m respectively. The temperature channel of the TDR-2050 is calibrated to an accuracy of ± 0.002°C (ITS-90) over the range -5 to +35°C.  Typical drift has been measured to be 0.002°C per year. The thermistor may be external (<3sec time constant) or internal (<20sec time constant). A fast thermistor probe (0.095sec) is also available. The depth channel is calibrated to an accuracy of 0.05%fs  Ranges from 10m to 6,600m are available."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0054";
        skos:note              "accepted"@en;
        skos:prefLabel         "RBR TDR-2050 underwater temperature logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00299/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0688/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0688";
        dc:date                "2014-04-15 15:48:27.0";
        dc:identifier          "SDN:L22::TOOL0688";
        pav:authoredOn         "2014-04-15 15:48:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0688/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SBE 39-IM TR";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A high-accuracy temperature recorder (pressure optional) with internal battery and a built-in inductive modem intended for moorings with either real-time telemetry or a surface data logger.  Data are also stored in internal non-volatile memory as insurance against data loss.  Calibration coefficients stored in EEPROM allow the SBE 39 to transmit data in engineering units. The SBE 39 thermistor has a long history of exceptional initial accuracy (0.002C) and stability (typical drift is 0.0002C per month).  The standard plastic housing is for depths down to 600m, but an optional titanium housing can withstand depths of 10500m.  For more information see http://www.seabird.com/products/spec_sheets/39imdata.htm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0688";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird SBE 39-IM temperature recorder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2043/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2043";
        dc:date                "2024-05-30 13:54:18.0";
        dc:identifier          "SDN:L22::TOOL2043";
        pav:authoredOn         "2024-05-30 13:54:18.0";
