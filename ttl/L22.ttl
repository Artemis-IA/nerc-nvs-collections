<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1408/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1408";
        dc:date                "2020-03-19 11:51:55.0";
        dc:identifier          "SDN:L22::TOOL1408";
        pav:authoredOn         "2020-03-19 11:51:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1408/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "BioSonics DT-X";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/FFES/> , <http://vocab.nerc.ac.uk/collection/L05/current/156/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A digital echosounder designed for underwater acoustic assessment and monitoring of physical and biological features. The instrument may be used in either marine or freshwater environments, for mobile or autonomous fixed location surveys. The BioSonics DT-X echosounder consists of a surface unit with LINUX-based embedded processor, a digital transducer with cable, a Global Positioning System (GPS) receiver, and a notebook computer for communication, real-time display and data storage. The instrument can operate single-beam or split-beam transducers, allowing for the network of up to four separate transducers at four different frequencies. Operating frequencies include 38 kHz, 70 kHz, 120 kHz, 200 kHz, 420 kHz and 1000 kHz. Standard DT-X transducers may be deployed at a maximum of 100 m depth; the recommended maximum range depends on the transducer configuration: 995 m (single-beam), 497 m (dual-beam) or 248 m (split-beam)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1408";
        skos:note              "accepted"@en;
        skos:prefLabel         "BioSonics DT-X digital echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01331/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0067/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2251/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2251";
        dc:date                "2026-01-06 10:55:51.0";
        dc:identifier          "SDN:L22::TOOL2251";
        pav:authoredOn         "2026-01-06 10:55:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2251/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Airmar SS510 EchoRange Smart Sensor";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/156/>;
        skos:definition        "A portable 200 kHz seafloor depth sensor designed for deployment on survey vessels for hydrographic surveying of harbours, waterways and other shallow coastal areas, via fixed mount for scour monitoring, or other mobile field work. The Smart Sensor features embedded microelectronics that process depth and temperature, which can be displayed on any device that accepts NMEA data. EchoRange transfers NMEA 0183 data in real time to a computer via RS422. It has a 500 W RMS, with minimal sidelobes for concentrated energy on the target. Accurate water depth measurements from 0.4 - 200 m. Stainless steel housing is depth rated to 10 m. 9 degrees beam angle. Operating temperature from -5 to +60 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2251";
        skos:note              "accepted"@en;
        skos:prefLabel         "Airmar SS510 EchoRange Smart Sensor - 200 kHZ Portable Survey depth sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01046/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0319/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0319/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0319";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL0319";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0319/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0319/1/>;
        pav:version            "2";
