<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1028/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1028";
        dc:date                "2016-10-24 14:25:31.0";
        dc:identifier          "SDN:L22::TOOL1028";
        pav:authoredOn         "2016-10-24 14:25:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1028/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Airmar WX series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "Airmar Ultrasonic WeatherStation WX series instruments (100WX, 110WX, 150WX and 200WX) are compact meteorological stations designed to provide real-time, site-specific weather information. The instruments combine up to seven sensors to measure apparent wind speed and direction, barometric pressure, air temperature, relative humidity, dew point and wind chill temperature. Ultrasonic wind readings are taken for wind speeds up to 40 m/s. Apparent wind models (100WX and 110WX) are designed for fixed platforms; apparent and true wind models (150WX and 200WX) are designed for moving platforms."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1028";
        skos:note              "accepted"@en;
        skos:prefLabel         "Airmar Ultrasonic WeatherStation WX series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01046/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0736/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0736";
        dc:date                "2014-07-16 17:05:28.0";
        dc:identifier          "SDN:L22::TOOL0736";
        pav:authoredOn         "2014-07-16 17:05:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0736/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Omega KFH strain gauge";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/PERMON/>;
        skos:definition        "Pre-wired, miniature strain gauges. The series contains linear pattern precision gauges (0.3 mm to 20 mm grids), planar XY pattern (Tee Rosette) (0 / 90 degrees) gauges (0.6 to 6 mm grids) and planar rosette pattern (0 / 45 / 90 degrees) gauges (0.6 to 6 mm grids). All models are available with 1 or 3 meter leads, 120 or 350 nominal resistance (ohms). Resistance tolerance, +/- 0.35 % (+/- 1 %, with 0.6 mm and 1.5 mm grid length). Gauge factor, ~2. Gauge factor tolerance, +/- 1 % (+/- 1.5 %, with 0.6 mm and 1.5 mm grid length)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0736";
        skos:note              "accepted"@en;
        skos:prefLabel         "Omega KFH series strain gauge"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00860/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0755/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0755";
        dc:date                "2014-08-14 16:07:38.0";
        dc:identifier          "SDN:L22::TOOL0755";
        pav:authoredOn         "2014-08-14 16:07:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0755/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SeaBeam 2000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "SeaBeam sensors are now manufactured by L-3 Communications Elac Nautik GmbH. The Seabeam 2000 is a multi-beam echo sounder of which a single swath covers an angular range of -60 degrees to 60 degrees from the vertical direction with 121 beams. This instrument was developed in the 1980s, and has now been discontinued."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0755";
        skos:note              "accepted"@en;
        skos:prefLabel         "SeaBeam 2000 multibeam echo sounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00899/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0793/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0793";
        dc:date                "2014-09-17 10:29:32.0";
        dc:identifier          "SDN:L22::TOOL0793";
        pav:authoredOn         "2014-09-17 10:29:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0793/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Furuno DS 50 speed log";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/114/>;
        skos:definition        "The Furuno DS-50 is a 3-beam Doppler speed log providing display of speed over a wide range from -10.0 to 40kt. Speeds are detected relative to ground or water both fore/aft and athwartship. This model operates at 440kHz, and has speed accuracy of 0.1kt. The DS 50T is supplied with an additional transceiver unit."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0793";
        skos:note              "accepted"@en;
        skos:prefLabel         "Furuno DS 50 and DS 50T Doppler speed log"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00571/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0514/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0514";
        dc:date                "2016-10-21 09:37:45.0";
        dc:identifier          "SDN:L22::TOOL0514";
        pav:authoredOn         "2016-10-21 09:37:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0514/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0514/3/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0514/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0514/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "Metrohm microAutolab";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB35/>;
        skos:definition        "A computer-controlled compact potentiostat/galvanostat for electrochemical research and electroanalysis. It has a potentiostat bandwidth of 500 kHz, an input impedance of >100 GOhm and features an analog integrator. The instrument can supply a maximum current of 80 mA with an accuracy of 0.2% and a resolution of 0.0003%. Potential accuracy is 0.2% and potential resolution is 3 uV.  The instrument can perform almost all elelctrochemical techniques including voltammetry, fuel cell, battery, biosensors, electroplating, coatings and corrosion. The NOVA software controls the microAutolab II version, which has an external USB interface, and the microAutolab III version, which features an integrated USB interface inside the instrument. microAutolab I is not supported in NOVA."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0514";
        skos:note              "accepted"@en;
        skos:prefLabel         "Metrohm microAutolab potentiostat/galvanostat"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00620/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0533/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0533";
        dc:date                "2012-08-21 12:05:06.0";
        dc:identifier          "SDN:L22::TOOL0533";
        pav:authoredOn         "2012-08-21 12:05:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0533/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "DTU Nutech GM-25-5A";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB39/>;
        skos:definition        "A laboratory instrument designed to count beta particles emitted by a sample using the Geiger-Muller principle. A steady gas stream of argon (99%) and isobutene or propane (1%) becomes ionised due to beta particle emission from the sample, and the ionised gas particles are collected within a high voltage field, detected as an electric current pulse and recorded as a counting event. A guard counter allows the removal of the cosmic background radiation signal. The instrument is typically placed inside a lead shielding to reduce the ambient background radiation."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0533";
        skos:note              "accepted"@en;
        skos:prefLabel         "DTU Nutech GM-25-5A beta Multicounter system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00629/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0107/>
