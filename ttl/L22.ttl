        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/159/>;
        skos:definition        "A towed magnetometer designed for the detection of buried objects, cables and pipework, shipwrecks and salvage items. It uses Dynamic Nuclear Polarization technology with closed loop processing. The fish can be coupled to acquisition systems for real-time mapping and has a maximum tow speed of 12 kts. Depth rating/sensitivity: 300 m/0.0035 nT/(Hz)^0.5 (MAGIS 300), 2000 m/0.0035 nT/(Hz)^0.5 (MAGIS 2000)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0874";
        skos:note              "accepted"@en;
        skos:prefLabel         "IXSea Magis magnetometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00459/> .

