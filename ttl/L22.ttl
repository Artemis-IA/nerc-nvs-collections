        skos:prefLabel         "BGS Waverley Sonar 3000 side scan sonar"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00086/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1613/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1613";
        dc:date                "2021-02-03 09:56:26.0";
        dc:identifier          "SDN:L22::TOOL1613";
        pav:authoredOn         "2021-02-03 09:56:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1613/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SAMI-pH series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/355/>;
        skos:definition        "A series of in situ total hydrogen scale pH sensors used to measure freshwater or seawater pH. They are designed to provide autonomous pH time-series data for scientific research. The sensors operate by mixing sample with an indicator dye and measuring pH by absorbance. Typical dyes are cresol red for freshwater or m-cresol purple for seawater samples. Light sources and path lengths vary between versions (tungsten, LEDs) Accuracy ranges between -0.003 to + 0.0004 pH units. Precision ranges from +/-0.004 to +/-0.0007 pH units. This code is used where it is not known which version of SAMI-pH model is used."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1613";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sunburst Sensors Submersible Autonomous Moored Instrument pH {SAMI-pH} seawater and freshwater pH sensor series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00366/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0097/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0002/>
