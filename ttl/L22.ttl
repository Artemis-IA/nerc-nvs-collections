<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0294/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0294";
        dc:date                "2024-08-23 15:47:12.0";
        dc:identifier          "SDN:L22::TOOL0294";
        pav:authoredOn         "2024-08-23 15:47:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0294/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0294/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0294/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "RDI WS 600 kHz ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://mmisw.org/ont/trdi/models/Sentinel>;
        skos:definition        "An ADCP designed for self-contained use on moorings or vessel mounting. It has a patented 600 kHz broadband signal and a standard depth rating of 200 metres. It operates effectively between temperatures of -5 to 45 degC and a range of up to 70 m with a depth cell size of 4 m. Velocity accuracy is +/- 0.3 % or 0.3 cm/sec."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0294";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Sentinel 600 kHz ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0091/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0091";
        dc:date                "2024-08-23 15:47:11.0";
        dc:identifier          "SDN:L22::TOOL0091";
        pav:authoredOn         "2024-08-23 15:47:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0091/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0091/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "RDI 150 kHz NB ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/>;
        skos:definition        "A narrowband ADCP designed for mooring deployment operating at 150 kHz with a measurement range of 300 m in the water column. The instrument uses Doppler-technology to achieve accurate and non-intrusive measurements and it can come with pressure and temperature sensors. It can be used in real time measurement situations or can log to an internal recorder powered by internal batteries."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0091";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI 150 kHz narrowband ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2245/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2245";
        dc:date                "2025-12-04 13:02:27.0";
        dc:identifier          "SDN:L22::TOOL2245";
        pav:authoredOn         "2025-12-04 13:02:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2245/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kongsberg OE1324 SIT";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "An underwater video camera with enhanced low-light performance and long-range viewing capabilities designed for ROV navigation, turbid water inspections, ambient light operations, scientific research, and defence applications. The camera combines the Silicon Intensifier Target (SIT) image-intensifier with new video processing circuitry developed from military technology. Other features include adaptive contrast enhancement, automatic tube protection circuits, over-voltage protection, and special high-frequency amplifier circuits for operating on long cable lengths. The standard lens is 6.5 mm f/1.8, the focus control is fixed (150 mm to infinity), and the angle of view is 86 degrees diagonal (nominal) in water. The horizontal resolution is 700 television (TV) Lines, the full video light sensitivity is 1 x 10-3 Lux and the limiting light sensitivity is 2 x 10-4 Lux. A corrosion-resistant titanium alloy housing provides a depth rating of 3000 m as standard, but deeper options are available. Operating temperature range is -5 to 40 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2245";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg OE1324 enhanced SIT camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0649/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0649";
        dc:date                "2013-10-14 14:10:43.0";
        dc:identifier          "SDN:L22::TOOL0649";
        pav:authoredOn         "2013-10-14 14:10:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0649/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Agilent 6890N GC";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB02/>;
        skos:definition        "A networked gas chromatograph that separates and analyses gas mixtures in water or air. The instrument includes a dual channel design supporting two inlets and two detectors. An automatic liquid sampling system is integrated into the mainframe control. Atmospheric pressure and temperature compensation is standard. The instrument supports 6 column oven ramps with 7 plateaus. The 6890N is customisable depending on the application, with choices of inlets, columns, detectors and sampling systems. All detectors include electronic pneumatics control and electronic on/off for all detector gases. Carrier and makeup gas settings are selectable for He, H2, N2, and argon/methane. The instrument has a 7683 ALS interface and incorporates local area network technology as standard. The Agilent 6890N replaced the HP Agilent 5890, and is no longer in production having itself been replaced by the 7890."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0649";
        skos:note              "accepted"@en;
        skos:prefLabel         "Agilent 6890 networked gas chromatograph"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1200/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1200";
        dc:date                "2018-01-30 16:59:47.0";
        dc:identifier          "SDN:L22::TOOL1200";
        pav:authoredOn         "2018-01-30 16:59:47.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1200/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GEOMAR OBH-System";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "An observation and registration system designed to monitor acoustic and seismic events. The OBH is composed of a buoyant body, a flasher, a radio beacon, a data logger with batteries, and a hydrophone mounted between an acoustic release (iXSea or KUMQUAT) and a pressure cylinder. All metal parts are made from titanium, whilst the buoyant bodies are made of syntactic foam. The system is designed to float at approximately 1 m above the sea floor, and can operate down to 6000 m water depth.  The descent and ascent speeds are approximately 1 m/s to 1.2 m/s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1200";
        skos:note              "accepted"@en;
        skos:prefLabel         "GEOMAR Ocean Bottom Hydrophone System"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00297/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0687/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0687";
        dc:date                "2014-04-15 11:23:19.0";
        dc:identifier          "SDN:L22::TOOL0687";
        pav:authoredOn         "2014-04-15 11:23:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0687/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SBE 56 TR";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "This is a small (30cm by 2.54cm diameter) high-accuracy battery-powered temperature and time logger capable of sampling intervals from 0.5 seconds to 9 hours. Battery life with a sampling rate of 15 seconds is almost two years and the memory can store over 15 million samples. Temperature is measured by a pressure-protected (1500m depth) thermistor. Initial accuracy is 0.002C and drift is typically less than 0.002C per year. More information may be found at http://www.seabird.com/products/spec_sheets/39imdata.htm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0687";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird SBE 56 temperature recorder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2023/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2023";
        dc:date                "2024-04-08 10:49:23.0";
        dc:identifier          "SDN:L22::TOOL2023";
        pav:authoredOn         "2024-04-08 10:49:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2023/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "CORAS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "The Acoustic Scintillation Flow Meter (ASFM) is a specialised acoustic instrument that uses forward scatter acoustic propagation methods to estimate the velocity of the medium between transducers positioned in the direction perpendicular to parallel transducer placement. The Cabled Observatory Reciprocal Acoustic Scintillation (CORAS) instrument allows for real-time output over Ethernet cable. The instrument has particular applications in real time monitoring of vertical velocity of deep sea hydrothermal vents and natural methane and oil seeps by transmitting sound through the plume. The instrument measures coherent turbulent flow patterns to quantify the contributions that the fluids make to the chemical and thermal budget of the global ocean, or upwelling velocities. Vertical velocity and turbulent characteristics are measured over time to quantify temporal variability. Sound is transmitted at a carrier frequency of 307 kHz using a toroidal transducer, with a path length of 80 m. Beam pattern is 10 degrees in the vertical plane, and omnidirectional in the horizontal plane."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2023";
        skos:note              "accepted"@en;
        skos:prefLabel         "Cabled Observatory Reciprocal Acoustic Scintillation System (CORAS)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0072/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01938/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0279/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0280/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2042/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2042";
        dc:date                "2024-05-30 13:54:18.0";
        dc:identifier          "SDN:L22::TOOL2042";
        pav:authoredOn         "2024-05-30 13:54:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2042/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Starfish 452F";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/152/>;
        skos:definition        "A compact sidescan sonar system. It is used typically for shallow water survey work. It has a tow depth up to 8 m from a 20 m towing cable. Acoustic frequency of 450 kHz (nominal). Depth rating up to 50 m. 0.8 degree horizontal beam with up to 100 acoustic range per channel. 200 m total swathe coverage."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2042";
        skos:note              "accepted"@en;
        skos:prefLabel         "Tritech Starfish 452F sidescan sonar"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0017/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00304/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0465/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0465";
        dc:date                "2024-08-21 16:29:33.0";
        dc:identifier          "SDN:L22::TOOL0465";
        pav:authoredOn         "2024-08-21 16:29:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0465/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0465/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0465/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "ThermoQ Finnigan Trace 2000 GC";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB02/>;
        skos:definition        "A gas chromatograph that separates mixtures of chemical species on the basis of their relative affinities for a mobile gaseous phase and a stationary liquid phase. The instrument includes a split/splitless injector, capillary or wide bore columns and a detector. Possible detector types are flame ionisation, flame photometric, photo-ionisation and photo-multiplier. It is usually coupled with a ThermoQuest mass spectrometer, which identifies and quantifies the compounds. The instrument was originally manufactured by ThermoQuest which has since been replaced by Thermo Scientific (part of Thermo Fisher Scientific). This model is no longer in production."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0465";
        skos:note              "accepted"@en;
        skos:prefLabel         "ThermoQuest Finnigan Trace 2000 gas chromatograph"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> .

