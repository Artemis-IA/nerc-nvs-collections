<http://vocab.nerc.ac.uk/collection/L22/current/NETT0009/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0009";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0009";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0009/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Bongo-style net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "An open pair of 50 cm diameter circular net hoops were mounted on each end of a 150 cm wide cross-strut which was attached to a towing cable.  Nets were attached to the bottom of the hoops and their cod-ends were attached to a spreader bar which was also attached to the wire. The nets were lowered to a maximum depth to haul and then during the haul back to the surface, a messenger was used to close the nets either by releasing the hoops so that they turned 90 degrees or by releasing the nets which fell back and were pursed by throttling lines attached to the cross-strut. A non-opening/closing variant of this net is known as the CalVET net [Wiebe and Benfield 2003 Plate 10 A]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0009";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bongo-style vertical closing net  - Brown (1975)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0079/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0079";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0079";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0079/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Clayton modified Juday net.";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "A net designed to avoid surface contamination of the sample. Construction is a 75 cm diameter cylinder (120 cm length) and cone (290 cm length), net (Nitex mesh size not given) with a cylinder skirt 380 cm long to enclose the net mesh.  The net ring and netting are enclosed in nylon utility cloth and tied with a release line that is pulled free after the net is underwater.  A messenger used to close net [Wiebe and Benfield 2003 Plate 7 B, C]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0079";
        skos:note              "accepted"@en;
        skos:prefLabel         "Modified Juday net  - Clayton and Pavlou (1978)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0078/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0078";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0078";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0078/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Juday net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "Net has a 25 cm diameter mouth opening with 33 cm long canvas cone expanding to 30 cm diameter, followed by a conical net 70 cm long made of No 20 silk bolting cloth [Wiebe and Benfield 2003 Plate 1 C]. A closing net with simple messenger release is also described: this has a 12 cm diameter mouth opening with 40 cm long canvas cone expanding to 17 cm, followed by a 47 cm long conical net with the same mesh."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0078";
        skos:note              "accepted"@en;
        skos:prefLabel         "Juday net - Juday (1916)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0034/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0034";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0034";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0034/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "DSRV Alvin Net-1";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "A pair of nets were mounted onto the front of DSRV Alvin for collecting planktobenthos at great depths. The mouth openings were D-shaped and hinged so that on descent and ascent of the submersible, the nets could be turned back away from the flow and would not filter. The Alvin arm was used by the pilot to open and close the net.  The nets had 0.233 mm mesh [Wiebe and Benfield 2003 Plate 23 D]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0034";
        skos:note              "accepted"@en;
        skos:prefLabel         "Deep Submergence Rescue Vehicle Alvin Net-1 - Grice and Huelsemann (1970)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0021/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0021";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0021";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0021/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Clarke-Bumpus plankton sampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "Construction is a 12.7 cm diameter mouth opening with cylindrical tube 16.0 cm long. The tube is equipped with flat plate which pivots to open or close the flow through the tube and a flowmeter. A 61 cm long conical net is attached to the rear of the tube [Wiebe and Benfield 2003 Plate 8 A]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0021";
        skos:note              "accepted"@en;
        skos:prefLabel         "Clarke-Bumpus plankton sampler - Clarke and Bumpus (1939, 1950)"@en .

