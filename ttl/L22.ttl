<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1985/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1985";
        dc:date                "2023-08-24 16:55:34.0";
        dc:identifier          "SDN:L22::TOOL1985";
        pav:authoredOn         "2023-08-24 16:55:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1985/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "UnSpec LSS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/123/>;
        skos:definition        "An optical sensor designed to estimate particle abundance in seawater. This relatively simple and inexpensive instrument is best suited for use in high turbidity waters, as well as for the detection of deep-sea hydrothermal plumes. Its raw output is in volts, which can be converted into nephelometric turbidity units (NTU). The light scattering sensor consists of a light source and a detector mounted side by side. It operates by detecting the light scattered backwards by particles suspended in the water."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1985";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified light scattering sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0002/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0879/>
        rdf:type               skos:Concept;
