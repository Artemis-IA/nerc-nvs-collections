        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00578/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1967/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1967";
        dc:date                "2023-07-03 09:13:15.0";
        dc:identifier          "SDN:L22::TOOL1967";
        pav:authoredOn         "2023-07-03 09:13:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1967/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Shimadzu UV 240";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB20/>;
        skos:definition        "A double-beam spectrophotometer used for marine chemical analysis to determine spectral information of water samples. It operates in the ultraviolet (UV) and visible (VIS) spectral ranges (190 nm - 1100 nm). The control unit features a graphic recorder that could print spectra, measurement conditions, quantitative analysis calculation results etc., on chart paper. It also features a holographic grating as the device used to disperse light."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1967";
        skos:note              "accepted"@en;
        skos:prefLabel         "Shimadzu UV 240 spectrophotometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00919/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0045/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0972/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0972";
        dc:date                "2016-02-29 14:00:40.0";
        dc:identifier          "SDN:L22::TOOL0972";
        pav:authoredOn         "2016-02-29 14:00:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0972/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Hitachi U-1800";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB20/>;
        skos:definition        "A bench-top, scanning spectrophotometer which operates in the UV and visible wavelength range (190-1100 nm) and is used for time dependent measurements of absorption such as enzyme kinetics. Features include a Good Laboratory Practise (GLP) routine for QC applications and a validation function. A scanning mode allows multiple wavelength measurements to be made. Bandwidth: 4 nm. Wavelength accuracy: +/- 0.55 nm. Wavelength precision: +/- 0.3 nm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0972";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hitachi U1800 UV-Visible Spectrophotometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00570/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2200/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2200";
        dc:date                "2025-08-06 12:58:42.0";
        dc:identifier          "SDN:L22::TOOL2200";
        pav:authoredOn         "2025-08-06 12:58:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2200/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "BioTek Uvikon 923 UV-VIS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB20/>;
        skos:definition        "A double beam UV/VIS spectrophotometer designed for measuring the absorption, transmission or reflection of ultraviolet and visible light by a sample. Applications span pharmaceuticals, environmental monitoring, biotechnology, and materials science, with techniques ranging from absorbance-based quantification to thermal melt analysis and reflectance measurements. Double beam UV-Vis spectrophotometers use two beams of light, one that passes through the sample and one that serves as a reference. The ratio of the intensities of the two beams is used to calculate a highly accurate measurement. This ratio corrects any instrument fluctuations in real-time."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2200";
        skos:note              "accepted"@en;
        skos:prefLabel         "BioTek Kontron Uvikon 923 Double Beam UV-VIS Spectrophotometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0344/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02113/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1885/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1885";
        dc:date                "2022-12-21 16:50:36.0";
        dc:identifier          "SDN:L22::TOOL1885";
        pav:authoredOn         "2022-12-21 16:50:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1885/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Unspecified quanta meter";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB20/>;
        skos:definition        "A quanta and energy meter with applications in primary production studies. The instrument is used to measure the amount of light available for photosynthesis. As this is a photoelectric process, light is described in terms of quanta per second per surface unit for unit wavelength for the specific wavelength range 350 - 700 nm. This provides a complete spectral analysis of the energy available for photosynthesis."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1885";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified quanta spectrophotometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0001/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1751/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1751";
        dc:date                "2024-08-21 16:29:32.0";
        dc:identifier          "SDN:L22::TOOL1751";
        pav:authoredOn         "2024-08-21 16:29:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1751/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1751/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Thermo Scientific iCAP PRO ICP-OES Duo";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "A benchtop inductively coupled plasma-optical emission mass spectrometer designed for trace element analysis. It features a 3-channel peristaltic pump and a solid-state, free-running 27.12 MHz RF generator. A random-access CID imager provides full wavelength coverage from 167.021 nm to 852.145 nm. It also features a vertical quick-release torch and a corrosion-resistant inner-torch box. It features Thermo Scientific Qtegra ISDS software for data display, analysis and processing. It has a purge gas flow rate of 3.4 l/min and a spectral bandpass of 7 pm at 200 nm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1751";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Fisher Scientific iCAP PRO ICP-OES Duo inductively coupled plasma-optical emission mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0035/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0959/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0959";
        dc:date                "2024-08-21 16:29:33.0";
        dc:identifier          "SDN:L22::TOOL0959";
        pav:authoredOn         "2024-08-21 16:29:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0959/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0959/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Thermo Scientific Neptune Plus ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "A laboratory high mass resolution inductively coupled plasma mass spectrometer (ICP-MS) designed for elemental and isotopic analysis. The instrument is based on a multicollector platform and combines the features of high mass resolution, variable multicollection and multiple ion counting (MIC). The Neptune Plus includes a Jet interface for increased sensitivity, a dual RPQ option and multiple discrete dynode electron multipliers for higher dynamic ranges, linearity and stability."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0959";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Fisher Scientific Neptune Plus inductively coupled plasma mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1510/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1510";
        dc:date                "2020-08-03 09:52:36.0";
        dc:identifier          "SDN:L22::TOOL1510";
        pav:authoredOn         "2020-08-03 09:52:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1510/1/>;
