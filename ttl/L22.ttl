        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Aq BioTech plankton net 100 um mesh, 40 cm mouth";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "A cylindrical-conical plankton net with 40 cm diameter mouth opening and 100 um mesh size, with cod end adapted to fit Aquatic BioTechnology CP3-110 collectors. The net is designed to be dragged by a boat, and includes a stainless steel cable with an anti-twist shackle for connecting to the main line. The net structure comprises a hoop, clamp, triple-point bridle, and a rod for attaching a flow meter."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0210";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aquatic BioTechnology simple plankton net with 100 um mesh size, 40 cm diameter mouth opening, CP3-110 collector"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02035/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0282/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0155/>
