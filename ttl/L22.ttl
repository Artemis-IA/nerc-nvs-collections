<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2194/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2194";
        dc:date                "2025-08-01 14:40:21.0";
        dc:identifier          "SDN:L22::TOOL2194";
        pav:authoredOn         "2025-08-01 14:40:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2194/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ThermoF Element I ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "The Thermo Finnigan Element I is a double focusing, sector field inductively coupled plasma mass spectrometer. It uses a demountable Meinhard nebulizer for sample introduction and a magnetic sector as a mass filter. It has a scanning rate at full mass range of under 60 ms. Short term precision is 2 %. Its sensitivity is 20 Mcps/ppm at R=300 and 1 Mcps/ppm at R=3000, with a detection limit under 0.1 ng/L for In at R=300."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2194";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Finnigan {Thermo Fisher Scientific} Element I inductively coupled plasma mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0035/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1111/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1111";
        dc:date                "2017-02-09 17:19:44.0";
        dc:identifier          "SDN:L22::TOOL1111";
        pav:authoredOn         "2017-02-09 17:19:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1111/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sonardyne Ranger 2 USBL";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS26/>;
        skos:definition        "An acoustic positioning system for deep water, long range tracking of underwater targets and position referencing for dynamically positioned (DP) vessels. It calculates the position of a subsea target, for example an ROV, by measuring the range and bearing from a vessel-mounted transceiver to an acoustic transponder fitted to the target. It supports 6G acoustic systems and inverted USBL (iUSBL) tracking. It is available in two versions. In standard configuration, Ranger 2 allows up to 10 subsea targets to be simultaneously tracked from a surface vessel. In Ranger 2 Pro configuration, any number of subsea targets can be tracked. The positioning accuracy obtainable from either configuration can be improved by interfacing the system directly into Sonardyne Lodestar attitude and heading reference system (Optimised Ranger 2). It has an operating range of over 6000 m. It has a system accuracy of 0.2% of Slant Range (0.1% of Slant Range for optimised system)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1111";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sonardyne Ranger 2 Ultra Short BaseLine acoustic positioning system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01062/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0598/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0598";
        dc:date                "2013-02-07 15:46:03.0";
        dc:identifier          "SDN:L22::TOOL0598";
        pav:authoredOn         "2013-02-07 15:46:03.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0598/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "POL 75kHz ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/>;
        skos:definition        "An ADCP designed to use low-frequency sound (actually 79-80 kHz) for optimum performance in water depths between 500 and 1000 m. The instrument was originally built with two orthogonal beams, but following the initial, 2-week deployment, it was modified to include a third beam."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0598";
        skos:note              "accepted"@en;
        skos:prefLabel         "Proudman Oceanographic Laboratory 75kHz ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00003/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1929/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1929";
        dc:date                "2023-05-30 14:55:33.0";
        dc:identifier          "SDN:L22::TOOL1929";
        pav:authoredOn         "2023-05-30 14:55:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1929/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Axis P1355";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "An indoor fixed network camera suitable for a range of video surveillance applications, including government and industrial buildings, retail environments, airports, railway stations, and schools. Also available in an \"-E\" outdoor version. The P1355 model is distinguished as having a HDTV 1080p camera and day and night capabilities. Features P-Iris control, allowing the camera to precisely control the iris position to optimise depth of field and lens resolution for optimal image sharpness, in addition to digital pan/tilt/zoom (PTZ), which allows a selected area of interest to be cropped from the full view for viewing or recording, thereby minimising the bit rate and storage needs. The camera is equipped with a serial port for communication with auxiliary equipment such as pan/tilt head in order to remotely change the camera direction. The H.264 compression capability reduces bandwidth and storage needs without compromising image quality. Supports multi-view streaming for up to eight individually cropped out view areas. The remote back focus function enables the focus to be fine-tuned from a computer. Resolution is 1920 x 1080 (HDTV) to 160 x 90, and shutter time is 1/28000 to 2 s (50 Hz) or 1/33500 to 2 s (60 Hz). The lens is a varifocal F1.2, 2.8 to 8 mm with 80 to 39deg view."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1929";
        skos:note              "accepted"@en;
        skos:prefLabel         "Axis Communications P1355 network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01991/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0244/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1948/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1948";
        dc:date                "2023-06-08 15:58:37.0";
        dc:identifier          "SDN:L22::TOOL1948";
        pav:authoredOn         "2023-06-08 15:58:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1948/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Panasonic AK-HC1500G";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A compact multi-purpose high definition (HD) box camera. Features a 2/3\" 2.2-megapixel IT-3 charge-coupled device (CCD) comprising three CCDs with each one receiving filtered red, green or blue colour ranges, and an F1.4 optical prism. Features variable frame rates (4 to 60 fps in single-frame increments), a CineGamma curve to produce film-like images and spatial offset processing technologies. Capable of outputting in 1080 or 720p. Sensitivity is F10.0 at 2000 lux, with a white reflection rate of 89.9%. Minimum illumination is 0.015 lx (F1.4 / 68 dB)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1948";
        skos:note              "accepted"@en;
        skos:prefLabel         "Panasonic AK-HC1500G camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0258/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01154/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0851/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0851";
        dc:date                "2015-04-28 12:36:02.0";
        dc:identifier          "SDN:L22::TOOL0851";
        pav:authoredOn         "2015-04-28 12:36:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0851/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Varian Vista-PRO";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB14/>;
        skos:definition        "The Varian Vista-PRO is a simultaneous inductively coupled plasma optical emission spectrometry (ICP-OES) analyser. The patented VistaChip CCD is capable of measuring 73 elements in 35 seconds. The detector provides wavelength coverage from 167 to 785 nm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0851";
        skos:note              "accepted"@en;
        skos:prefLabel         "Varian Vista-PRO (ICP-OES analysis)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2195/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2195";
        dc:date                "2025-08-04 17:05:14.0";
        dc:identifier          "SDN:L22::TOOL2195";
        pav:authoredOn         "2025-08-04 17:05:14.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2195/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2195/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "PerkinElmer 3300 XL ICP-OES";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB14/>;
        skos:definition        "An axially viewed (XL) dual-detector Inductively Coupled Plasma Optical Emission Spectrometer (ICP-OES). It uses a high-energy echelle-based polychromator, which utilizes a dual-detector, and a Segmented-array Charge-coupled-device Detector (SCD). This instrument is capable of measuring over 70 elements at multiple wavelengths in less than one minute; it features a 40 MHz free-running RF generator which provides a robust plasma and instantly compensates for changes in sample types or solvents. Plasma ignition is computer-controlled and totally automated. Wavelength range: 165 - 782 nm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2195";
        skos:note              "accepted"@en;
        skos:prefLabel         "PerkinElmer Optima 3300 XL ICP-OES"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00578/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0227/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0484/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0484";
        dc:date                "2012-03-29 16:25:41.0";
        dc:identifier          "SDN:L22::TOOL0484";
        pav:authoredOn         "2012-03-29 16:25:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0484/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PerkinElmer 4300 DV ICP-OES";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB14/>;
        skos:definition        "An optical emission spectrometer (OES) that determines elemental composition of a sample through the amount of light emitted from atoms or ions at specific wavelengths. The atomization source is an inductively coupled plasma (ICP) which is maintained by the interaction of Radio Frequency (RF) energy, generated by a solid-state RF generator, a horizontally mounted quartz torch and ionized argon gas. Standards and samples are acquired with the aid of an autosampler. The sample solution is injected as an aerosol into the plasma via a nebuliser and spray chamber using the integral peristaltic pump. Light from the plasma and the various atomic emissions therein pass through duel view (DV) windows into the thermally stabilised, argon-purged optical compartment housing an Echelle polychromator to separate the light into its component wavelengths. The polychromator comprises diffraction gratings, mirrors, lenses and visible and ultra-violet detector sets, each comprising arrays of segmented-array charge-coupled device (SCD) detectors and allows simultaneous quantification of atomic emissions in the plasma."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0484";
        skos:note              "accepted"@en;
        skos:prefLabel         "PerkinElmer Optima 4300 DV inductively coupled plasma optical emission spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00578/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2324/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2324";
        dc:date                "2026-08-11 08:56:23.0";
        dc:identifier          "SDN:L22::TOOL2324";
        pav:authoredOn         "2026-08-11 08:56:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2324/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Agilent 5800 ICP-OES";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB14/>;
        skos:definition        "A benchtop inductively coupled plasma optical emission spectrometer (ICP-OES) for the simultaneous analysis of multiple elements with high precision. The 5800 ICP-OES can be used in two configurations - vertical dual view (VDV) and radial view (RV). An innovative freeform optical design enables simultaneous measurements and full wavelength coverage from 167 to 785 nm. The echelle polychromator used produces a single echelle image of the entire spectrum and this image is focussed onto a single Vista Chip III charge-coupled device (CCD) detector using a freeform collimating mirror, grating, a prism, and a focus mirror. The result is sharper focus and higher light intensity at the detector, an improved detection limit, and improved optical resolution even when using 99.99% purity bottled argon as a purge gas. A range of embedded sensors provide diagnostic tools and proactive maintenance alerts, and smart algorithms for background correction and curve fitting combined with the IntelliQuant software function assist with troubleshooting, sample screening, and method development. A range of optional accessories include autosamplers, an autodilutor, and a switching valve to increase sample throughput. Optimised torches and sample introduction kits for organic solvents, high salt or high matrix samples, and samples containing hydrofluoric acid are available."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2324";
        skos:note              "accepted"@en;
        skos:prefLabel         "Agilent 5800 inductively coupled plasma optical emission spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0042/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0485/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0485";
        dc:date                "2012-03-29 16:25:41.0";
        dc:identifier          "SDN:L22::TOOL0485";
        pav:authoredOn         "2012-03-29 16:25:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0485/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PerkinElmer AS 93plus autosampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB33/>;
        skos:definition        "A laboratory random-access autosampler which is a computer-controlled, multi-purpose sampling system for flame and flow-injection atomic absorption, ICP-OES and ICP-MS. The instrument automates standard and sample introductions via software commands. Random-access programming gives broad flexibility in the placement of samples and standards. The sample probe, including the sample transport capillary tubing is made of acid and solvent-resistant materials. The AS 93plus model is compatible with commonly used sample trays from other manufacturers.  The instrument includes an integrated power supply and control electronics, and also has automatic rinsing."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0485";
        skos:note              "accepted"@en;
        skos:prefLabel         "PerkinElmer AS 93plus autosampler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00578/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0478/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0478";
        dc:date                "2012-03-06 15:57:11.0";
        dc:identifier          "SDN:L22::TOOL0478";
        pav:authoredOn         "2012-03-06 15:57:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0478/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Agilent I-AS autosampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB33/>;
        skos:definition        "A laboratory autosampler for low volume and ultra-trace analyses. The instrument features a peristaltic pump and continuously flowing rinse port so that the probe is always rinsed with fresh wash solution, eliminating the risk of cross contamination during a long sample sequence. It uses non-metal materials to minimise the risk of trace metal contamination. The autosampler was designed for use with the Agilent 7500 series ICP-MS but can also be used with the Agilent 4500 series ICP-MS."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0478";
        skos:note              "accepted"@en;
        skos:prefLabel         "Agilent Integrated Autosampler I-AS"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0154/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0154";
        dc:date                "2010-05-18 16:10:58.0";
