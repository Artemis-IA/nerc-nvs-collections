<http://vocab.nerc.ac.uk/collection/L22/current/NETT0053/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0053";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0053";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0053/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Miller modified Hardy Plankton Sampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/67/>;
        skos:definition        "This is a small high-speed sampler (modified from that described by Glover) with 10.1cm diameter aperture opening on a body tube 14 cm internal diameter and a 61cm overall length. Attached to the back of the tube is a 91 cm long nylon net of three meshes (0.947 mm, 0.526 mm, and 0.264 mm). Multiple units used on the towing wire at speeds of 7 to 8 knots with a multiplane kit otter depressor on bottom of wire [Wiebe and Benfield 2003 Plate 14 B]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0053";
        skos:note              "accepted"@en;
        skos:prefLabel         "Modified small Hardy Plankton Sampler - Miller (1961)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0154/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0154";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0154";
