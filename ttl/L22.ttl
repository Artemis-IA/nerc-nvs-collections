        skos:prefLabel         "Vemco Minilog II T 16-bit Temperature Logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00348/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0725/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0725";
        dc:date                "2015-06-16 16:37:40.0";
        dc:identifier          "SDN:L22::TOOL0725";
        pav:authoredOn         "2015-06-16 16:37:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0725/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0725/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "OSi ORG-815";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/381/>;
        skos:definition        "A series of optical scintillation rain gauges that measure rain rate in the range 0.1 to 500 mm/hr; rain accumulation in the range 0.001 to 999.999 mm with accuracy of 5% accumulation. They operate in temperatures from -40 to 50 degrees C. Versions differ by their electrical outputs , output connections and detection capablities. Digital output versions include - ORG-815-DR, ORG-815-DS, ORG-815-DC which are capable of distinguishing precipitation by rain or snow. Analog output versions include - ORG-815-DA which does not distinguish precipitation type."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0725";
        skos:note              "accepted"@en;
        skos:prefLabel         "OSi ORG-815 series optical rain gauges"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00836/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0522/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0522";
        dc:date                "2012-07-05 15:53:41.0";
        dc:identifier          "SDN:L22::TOOL0522";
        pav:authoredOn         "2012-07-05 15:53:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0522/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Nu Plasma I MC-ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "A double focusing multi-collector inductively coupled plasma mass spectrometer (MC-ICP-MS) featuring unique variable dispersion optics. The instrument includes: a double focusing system, vacuum system, zoom optics, Faraday detector system, multiplier detector system, water cooling and computer systems. Twelve Faraday detectors are fitted to the instrument as standard and up to three ion-counting multiplier channels can be specified for the standard collector housing. Deflection with a magnet and second electrostatic anaylser compensates for any energy spread of the ion beam."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0522";
        skos:note              "accepted"@en;
        skos:prefLabel         "Nu Instruments Plasma I (HR) Multi-Collector Inductively Coupled Plasma Mass Spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00621/> .

