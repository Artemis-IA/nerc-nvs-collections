        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0230/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1639/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1639";
        dc:date                "2021-02-11 16:32:18.0";
        dc:identifier          "SDN:L22::TOOL1639";
        pav:authoredOn         "2021-02-11 16:32:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1639/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "TidbiT V2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A temperature logger that measures temperatures over a wide temperature range. It is designed for outdoor and underwater environments and is waterproof to 300 m. A solar radiation shield is required to obtain accurate air temperature measurements in sunlight (RS1 or M-RSA Solar Radiation Shield). With an operational temperature range between -20 degrees Celsius and +70 degrees Celsius, the TidbiT v2 has an accuracy of +/-0.21 and a resolution of 0.02 degrees Celsius."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1639";
        skos:note              "accepted"@en;
        skos:prefLabel         "Onset HOBO TidbiT V2 {UTBI-001} temperature logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01790/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0157/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1658/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1658";
        dc:date                "2021-03-23 16:02:18.0";
        dc:identifier          "SDN:L22::TOOL1658";
        pav:authoredOn         "2021-03-23 16:02:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1658/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GeoSpectrum M8";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "A high-frequency omni-directional hydrophone and sound projector for use in the marine environment. It can be purchased with or without a pre-amplifier, and can be packaged in various ways tailored to the users' application. It has a diameter of 22 mm and length of 110 mm (single package). It is depth-rated to 3500 m and can operate at temperatures between -40 and +70 degC. Its acoustic sensitivity (1 kHz) is -200 dBV re 1uPa (unamplified). It has a frequency range from 1 Hz - 150 kHz, (+/- 5 dBV) and an electro-acoustic efficiency of 80 % at resonance. It's bandwidth (-3 dB) is 30 kHz."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1658";
        skos:note              "accepted"@en;
        skos:prefLabel         "GeoSpectrum M8 hydrophone"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01774/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0166/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0160/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0160";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0160";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0160/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sameoto modified Tucker Trawl";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/23/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "A 100 cm x 100 cm and a 400 cm x 400 cm rectangular mouth opening Tucker trawl with a double messenger activated release mechanism. Net is made from coarse mesh.  Flow measured with a digital flowmeter.  A depressor plate is mounted on bottom net bar.  Tow speeds generally are between 2 and 4 knots [Wiebe and Benfield 2003 Plate 6 D]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0160";
        skos:note              "accepted"@en;
        skos:prefLabel         "Messenger-operated Tucker Trawl - Sameoto and Jaroszynski (1976)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1436/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1436";
        dc:date                "2020-05-11 15:24:40.0";
        dc:identifier          "SDN:L22::TOOL1436";
        pav:authoredOn         "2020-05-11 15:24:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1436/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Vaisala CS106";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A Vaisala barometer compatible with Campbell Scientific data loggers. It uses a silicon capacitive sensor to measure barometric pressure. The CS106 has an attached 76.2 cm (30 in.) cable. It is encased in a plastic shell (ABS/PC blend) fitted with an intake valve for pressure equilibration. The instrument measures barometric pressure from 500 to 1100 mb and has an accuracy <+/-1.5 mb."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1436";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala CS106 barometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0025/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1252/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1252";
        dc:date                "2018-08-02 15:26:57.0";
        dc:identifier          "SDN:L22::TOOL1252";
        pav:authoredOn         "2018-08-02 15:26:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1252/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "UnSpec Agassiz";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/61/>;
        skos:definition        "A sledge composed of a metal frame with a net attached, designed to be towed along the seabed at a maximum of approximately 4000 m depth. Mouth width can vary."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1252";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified Agassiz trawl"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2056/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2056";
        dc:date                "2024-08-23 15:47:11.0";
        dc:identifier          "SDN:L22::TOOL2056";
        pav:authoredOn         "2024-08-23 15:47:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2056/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2056/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2056/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Benthos Chirp III";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/394/>;
        skos:definition        "A high resolution sub-bottom profiler system. The Chirp III is suitable for a range of applications, including offshore hazard surveys, pipeline and small object surveys, bridge piling scour and environmental surveys, mining and dredging, and wind farm site survey. It includes a kevlar electrical umbilical cable. System configurations include: TTV-170 Series Towfish; AUV configuration; hull mount configuration with echosounder mode. Beam angle: 100 degrees conical for TTV-170 configuration; 25 degrees for hull mount (4 x 4) array. It is operational in depths up to 200 m. Maximum ping rate of 15 pings per second."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2056";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne Benthos Chirp III sub-bottom profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0291/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02054/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1107/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1107";
        dc:date                "2017-02-13 10:52:07.0";
        dc:identifier          "SDN:L22::TOOL1107";
        pav:authoredOn         "2017-02-13 10:52:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1107/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1107/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "LDEO Standard OBS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/368/>;
        skos:definition        "The LDEO standard seismometer design has been in use for nearly 10 years. The seismometer sensor is a L4C 1 Hz geophone, with a low-noise amplifier, giving useful response down to 100 s, and a differential pressure gauge. This instrument has been used in both year-long passive-source and shorter-term active-source experiments.  The design includes dual redundancy with two transponders and two dropweights. It can be deployed to a depth of 5000 m and for a maximum duration of 400 days."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1107";
        skos:note              "accepted"@en;
        skos:prefLabel         "Lamont-Doherty Earth Observatory Standard ocean bottom seismometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00129/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1595/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1595";
        dc:date                "2021-01-19 13:12:27.0";
        dc:identifier          "SDN:L22::TOOL1595";
        pav:authoredOn         "2021-01-19 13:12:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1595/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Silicon Audio optical seismometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/368/>;
        skos:definition        "An optical broadband seismometer designed for ocean bottom exploration. The seismometer uses optical interferometry to detect ground movements. This is involves splitting a laser beam along two paths; one reflects off a motion-responsive mirror, and the other a fixed mirror. The difference in distance travelled by each beam is detected by photo-diodes, and ground movements are inferred via different light intensities from the difference in distance travelled by each beam. The system is suited to low-noise applications, and can be used in any orientation due to the stiff springs used. The seismometer can be configured in high-sensitivity, high dynamic range or high velocity modes, with sensitivities of 60 V/g, 15 V/g and 750 V/m/s respectively. The seismometer can detect ground motion as small as 1 femtometre (10^-15 m). Its operating temperature range is from -35 to +75 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1595";
        skos:note              "accepted"@en;
        skos:prefLabel         "Silicon Audio Low-Noise optical seismometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0146/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01769/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2202/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2202";
        dc:date                "2025-08-07 14:10:02.0";
        dc:identifier          "SDN:L22::TOOL2202";
        pav:authoredOn         "2025-08-07 14:10:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2202/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Subsea ONC SMART Cable system";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/368/>;
        skos:definition        "A prototype SMART (Science Monitoring And Reliable Telecommunications) Cable system manufactured by Subsea Data Systems and deployed by Ocean Networks Canada in a pilot project as part of the NEPTUNE cabled observatory . The system consists of a Sea-Bird SBE 3S temperature sensor, a Paroscientific 410K-101 pressure sensor, and a Silicon Audio Low-Noise optical seismic sensor. These sensors are deployed conventionally and are connected by cables to a subsea junction box. The seismic sensor is housed by a SMART sensor housing, and the temperature and pressure sensors are each connected to this housing by a 3 m Falmat cable. The SMART sensor housing is connected to a junction box connector port on the NEPTUNE observatory by a 15 m Falmat cable. Power and communications to shore are provided by this connector port. Temperature and pressure data are obtained as channels of the seismic data acquisition system. This pilot project is contributing to the development of SMART Cable systems with the objective being to integrate temperature, pressure, and seismic acceleration sensors into future telecommunications cables. These SMART systems will contribute towards tsunami and earthquake early warning monitoring, global climate monitoring, and telecommunication network integrity monitoring."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2202";
        skos:note              "accepted"@en;
        skos:prefLabel         "Subsea Data Systems Ocean Networks Canada prototype SMART Cable system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01938/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0351/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1589/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1589";
        dc:date                "2021-01-18 12:15:06.0";
        dc:identifier          "SDN:L22::TOOL1589";
        pav:authoredOn         "2021-01-18 12:15:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1589/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Guralp CMG-1T OBS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/368/>;
        skos:definition        "A broadband ocean bottom seismometer designed to destect movements in the Earth's crust such as earthquake activity. It primarily outputs ground accelteration and velocity. It features a unique mass locking system which reduces the possibility of damage to the sensor pivots and springs. It is housed in a titanium sphere and depth-rated to 3000 m. It features 360 s velocity feedback and an operating frequency of 50 Hz."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1589";
        skos:note              "accepted"@en;
        skos:prefLabel         "Guralp Systems CMG-1T ocean bottom seismometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01765/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0141/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0333/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0333";
        dc:date                "2010-09-06 12:45:22.0";
        dc:identifier          "SDN:L22::TOOL0333";
        pav:authoredOn         "2010-09-06 12:45:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0333/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Magee AE1 Aethalometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/387/>;
        skos:definition        "The Magee Scientific AE1 Aethalometer determines concentration of light absorbing aerosol particles from measurements of light transmission through a sample. Air is filtered through a quartz fibre filter tape that traps particulate matter. Measurements are taken at user-specified time intervals ranging from one second to several minutes and the instrument outputs a voltage that is indicative of the amount of light absorbed by the sample."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0333";
        skos:note              "accepted"@en;
        skos:prefLabel         "Magee Scientific AE1 Aethalometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00482/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1886/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1886";
        dc:date                "2022-12-21 16:50:36.0";
        dc:identifier          "SDN:L22::TOOL1886";
