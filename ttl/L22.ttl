<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1372/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1372";
        dc:date                "2019-12-10 10:47:35.0";
        dc:identifier          "SDN:L22::TOOL1372";
        pav:authoredOn         "2019-12-10 10:47:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1372/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "diver suction pump - Rostron 1983";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/391/>;
        skos:definition        "A manually operated instrument that is used to collect sediment via suction. The sampler consists of a closed chamber with a detachable lid and screw threads on the inside to facilitate the attachment and detachment of mesh sampling bags. Air is supplied from a compressed air cylinder, fitted with a pressure-reducing valve and connected to the sampler via a short length of reinforced tubing. The sampler is operated underwater by divers."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1372";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unknown diver-operated sediment suction sampler - Rostron 1983"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0002/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0076/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0076";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0076";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0076/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Isaacs HSS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/> , <http://vocab.nerc.ac.uk/collection/L05/current/67/>;
        skos:definition        "Construction comprises a 2.5 cm mouth opening expanding to a diameter of 7.6 cm; overall length of 130 cm. The plankton filter is a cylinder of Monel metal mesh (23 mesh per cm) ~5.2 cm in diameter and 36 cm long.  System equipped with a flowmeter and depth sensor (from bathythermograph) and a recording unit utilizing clear 35 mm acetate film.  Can be towed up 10 knots. Can be put anywhere on cable and multiple units can be towed simultaneously [Wiebe and Benfield 2003 Plate 15 B]"@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0076";
        skos:note              "accepted"@en;
        skos:prefLabel         "Isaacs high-speed sampler - Ahlstrom (1958)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1833/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1833";
        dc:date                "2022-08-04 16:50:53.0";
        dc:identifier          "SDN:L22::TOOL1833";
        pav:authoredOn         "2022-08-04 16:50:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1833/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Observator OMC-116M";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "An ultrasonic wind speed and direction sensor based on the time of flight theory. It is designed for use in marine environments due to its marine-grade aluminium housing. The unit offers the industrial standard NMEA0183 output and also offers optional 4 - 20 mA outputs. It features a standard mounting bracket and integrated junction box for ease of installation. The sensor can be configured to enable or disable the onboard heater, allowing it to be used in environments from -40 to +60 degC. It has a wind speed range from 0 - 90 m/s, an accuracy of +/- 0.2 m/s. It has a wind direction range from 0 - 359.9 degrees and an accuracy of +/- 2 degrees RMSE > 1 m/s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1833";
        skos:note              "accepted"@en;
        skos:prefLabel         "Observator OMC-116M ultrasonic wind sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0220/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00476/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0095/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0095";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0095";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0095/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Fowler midwater net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "A 11.4 cm x 11.4 cm rectangular net mouth frame which was hinged at the central axis.  It was equipped with a silk net ( 9.8 or 15.7 meshes per cm) which was enclosed by a similar net made from mosquito netting. This net was sent down closed, opened by a messenger and closed by a second one.  Designed for vertical towing."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0095";
        skos:note              "accepted"@en;
        skos:prefLabel         "Midwater net - Fowler (1898)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1852/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1852";
        dc:date                "2022-10-04 10:44:37.0";
        dc:identifier          "SDN:L22::TOOL1852";
        pav:authoredOn         "2022-10-04 10:44:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1852/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Magee AE33 Aethalometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/387/>;
        skos:definition        "An instrument that collects and analyses aerosol particles continuously. It can be used for air quality monitoring; real-time source apportionment; emissions testing; climate change research; health effects research; and combustion research. Air is drawn through a spot on a filter tape at a measured flow rate. The tape is illuminated by light while sensitive detectors measure the intensities of light transmitted through the collecting spot and an un-exposed portion of the tape, acting as a reference. As optically absorbing material accumulates on the spot, the intensity of light transmitted through it gradually decreases. The decrease in light intensity from one measurement to the next is interpreted as an increase in collected material. This increased amount is divided by the known air-flow volume to calculate the concentration. In this model two sample spots are collected from the same input air stream with different accumulation rates and analysed simultaneously. The two results are combined mathematically to eliminate the \"Filter Loading Effect\" nonlinearity and accurately measure the aerosol concentration. Additionally, the analysis is made at 7 optical wavelengths spanning the spectrum from 370 nm to 950 nm. Increases in optical absorption at shorter wavelengths may be interpreted in terms of the presence of so-called \"Brown\" carbonaceous material, usually an indicator of emissions from biomass combustion. This instrument can be integrated with other instruments including: Total Carbon Analyzer TCA08 for OC/EC analysis; CO2 and meteorological sensors for additional data; and external pump for high altitude BC monitoring. The measurement wavelengths are: 370, 470, 520, 590, 660, 880 and 950 nm. The air flow set-points are: 2, 3, 4 and 5 LPM. The instrument can function up to 3000m altitude, and temperatures between 10 and 40 degrees Celsius."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1852";
        skos:note              "accepted"@en;
        skos:prefLabel         "Magee Scientific AE33 Aethalometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0231/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00482/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1871/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1871";
        dc:date                "2022-11-01 13:43:27.0";
        dc:identifier          "SDN:L22::TOOL1871";
        pav:authoredOn         "2022-11-01 13:43:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1871/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "TF anemometer 4034.1000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A 3-cup anemometer that electrically measures values of wind speed. Designed for applications in meteorology and environmental protection, it can be mounted on various platforms such as automatic weather stations, research vessels, industrial sites, airports and more. The 4034.1000 provides analogue outputs in addition to those of the 4034.0000. The assembly comprises three polypropylene cups and a plated aluminium reflecting wheel divided into 15 segments. During rotation these segments pass the light barrier and create a sequence of reflection and absorption pulses, in a frequency proportional to the wind speed. It features in-built heating by a power transistor controlled by a temperature sensor, enabling use in cold climates. Operating temperature: -35 to +80 degC. Measurement range: 0-60 m/s. Accuracy: +/- 0.3 m/s. Frequency output: 0-600 Hz, as well as analogue 0-1 V, 0-20 mA, 4-20 mA."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1871";
        skos:note              "accepted"@en;
        skos:prefLabel         "Theodor Friedrichs 4034.1000 anemometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0239/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01221/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1890/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1890";
        dc:date                "2023-01-03 16:53:32.0";
        dc:identifier          "SDN:L22::TOOL1890";
        pav:authoredOn         "2023-01-03 16:53:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1890/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Axis 214";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A network camera with pan, tilt, zoom (PTZ), and audio for professional surveillance and remote monitoring applications. It has automatic day and night functionality and provides perfect colour images in lowlight conditions as well as sharp black and white images in extremely poor lighting conditions. The camera has built-in motion detection and powerful event management. It has built-in two-way audio which enables remote users to listen-in on an area and communicate through the camera. It has an 18x optical motorized lens with auto-focus. The image resolution can be set at 160x120 to 704x576."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1890";
        skos:note              "accepted"@en;
        skos:prefLabel         "Axis Communications 214 (PTZ) network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01991/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0244/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1130/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1130";
        dc:date                "2017-05-10 10:47:50.0";
        dc:identifier          "SDN:L22::TOOL1130";
        pav:authoredOn         "2017-05-10 10:47:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1130/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sea Data IES";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/112/>;
        skos:definition        "The Sea Data IES was based on the earlier designs of the URI-GSO IES dating back to the late 1970s to early 1980s. It is an ocean bottom-moored instrument that measures the time taken for an acoustic pulse to travel from the instrument on the seafloor to the sea surface and return. The IES can be equipped with an optional bottom pressure sensor."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1130";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea Data Inverted Echo Sounder (IES)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01066/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1847/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1847";
        dc:date                "2024-08-23 15:47:11.0";
        dc:identifier          "SDN:L22::TOOL1847";
        pav:authoredOn         "2024-08-23 15:47:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1847/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1847/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Oceanscience Underway CTD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/131/>;
        skos:definition        "A low-drag, high-accuracy, retrievable Sea-Bird CTD probe used to collect measurements of conductivity, salinity, temperature and depth while a ship is underway. It can be used for static profiles (while the ship is stationary), tow-yo casts, or free casts. The probe samples conductivity, temperature, and depth at a sampling rate of 16 Hz while descending vertically through the water column. The data are stored internally and downloaded wirelessly via Bluetooth to a host computer after deployment. The sensor is connected to a tail spool via a simple turn-and-lock mechanism, which in turn is attached to the line on the winch. The UCTD system comes equipped with a universal power supply that accepts 90 - 264 VAC (47 - 63 Hz). It supplies the winch and rewinder with the required 24 V DC voltage. The receptacles have different form factors to prevent connection errors by the operator. This instrument is depth rated to 2000 m. The conductivity (S/m) range is 0 - 0 with a resolution of 0.0005 and accuracy of 0.002 - 0.005; the depth (dbar) range is 0 - 2000 with a resolution of 0.5 and accuracy of 1; The temperature range is -5 - 43 degC with a resolution of 0.002 and accuracy of 0.004; The salinity range is 0 - 42 PSU with a resolution of 0.005 and accuracy of 0.02 - 0.05. It can be operated at ship speeds up to 20 knots. The profiling depth capability depends on the vessel speed and type of cast, at 0, 2, 4, 6, 8, and 10 kts respectively the depth capability of freecasts is 1500, 1100, 900, 700, 650, and 600 metres. For tow-yo (no line on tail) deployments the capabilities are 1000, 700, 550, 450, 400, and 350 metres."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1847";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne Oceanscience underway CTD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01988/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0280/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0280";
        dc:date                "2010-05-18 16:10:58.0";
        dc:identifier          "SDN:L22::TOOL0280";
        pav:authoredOn         "2010-05-18 16:10:58.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0280/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Cup and vane anemometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A generic term for a device that measures windspeed by determining the speed of rotation of 3 cups mounted on horizontal arms with a central pivot and wind direction by determining the orientation of a separate pivot-mounted sail. The term is for use where the measurement principle is known, but details of the make and model number are not known."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0280";
        skos:note              "accepted"@en;
        skos:prefLabel         "Cup and vane anemometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2206/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2206";
        dc:date                "2025-08-15 09:42:13.0";
        dc:identifier          "SDN:L22::TOOL2206";
        pav:authoredOn         "2025-08-15 09:42:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2206/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2206/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "SINTEF Ocean Silcam";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "A telecentric in-situ particle imaging system designed to quantify high concentrations of suspended particulates in seawater, such as zooplankton, large phytoplankton, mineral grains, marine snow and pollutants such as oil droplets and gas bubbles. SilCam can characterise particle types based on optical properties. It is a restricted path length telecentric system, using backlighting to create quasi-silhouettes of particles suspended between the light and the camera. Background illumination consists of a white LED array, and its beam is expanded and diffused using a holographic diffuser immediately prior to the housing window. The incident light passes through the sample volume, through the housing window and into the telecentric receiving optics, which is attached to a colour CCD (Charge-Coupled Device) camera. It produces 15 images per second which are recorded onto solid-state disk to enable continuous operation at 15 Hz, with a path length that is adjusted according to the concentration of particles. The optical configuration is mounted into two underwater housings (one for the illumination and one for the receiving optics and camera), which are rated to 3000 m depth. Three different magnifications (x0.5, x0.25, and x0.125) are available, each resulting in pixel sizes of 7.2 um, 14.4 um and 27.5 um. It provides particle size distribution and concentrations ranging from 50 um to several cm in length."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2206";
        skos:note              "accepted"@en;
        skos:prefLabel         "SINTEF Ocean SilCam telecentric particle imaging system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02124/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0356/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2227/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2227";
        dc:date                "2025-10-09 12:07:04.0";
        dc:identifier          "SDN:L22::TOOL2227";
        pav:authoredOn         "2025-10-09 12:07:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2227/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "FAU-HBOI AUTOHOLO";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "An autonomous submersible holographic imaging system developed by Florida Atlantic University - Harbor Branch Oceanographic Institute (FAU-HBOI) for long-term in situ marine studies. It is used for in situ holographic imaging of marine particles, plankton, bubbles, and detritus. The instrument comprises dual cylindrical housings - one containing laser optics and the other housing a high-resolution 16 MP Imperx camera, power supply, and control electronics. It supports both lens-less and microscopic objective configurations, enabling particle resolution down to 2.3 um/pixel. Sampling volumes range from 12.4 mL to 71.4 mL per hologram. Data acquisition is programmable in continuous or burst modes, with onboard storage via 4 TB solid-state drives. Integrated GPU-based processing routines allow rapid hologram reconstruction and 3D particle analysis."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2227";
        skos:note              "accepted"@en;
        skos:prefLabel         "Florida Atlantic University - Harbor Branch Oceanographic Institute AUTOHOLO (autonomous) holographic imaging system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0358/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00477/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1808/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1808";
        dc:date                "2022-05-31 15:14:18.0";
        dc:identifier          "SDN:L22::TOOL1808";
        pav:authoredOn         "2022-05-31 15:14:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1808/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Endress and Hauser TurbiMax W CUS 41";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "An optical in-situ particle sizer designed for suspended solids measurement in sewage treatment and water monitoring activities. It uses the nephelometric 90 degree scattered light method with frequencies in the near infra-red (NIR) range (880 nm). The excitation radiation of the IR transmitter strikes the medium at a defined beam angle. The different refractive indices of the entrance window and the measuring medium (water) are taken into account. Particles in the medium scatter the radiation, which strikes the receiver at a defined angle. The measurement in the medium is constantly adjusted with the values of a reference receiver. A temperature measurement signal is also detected and transmitted. It has an operational wavelength of 880 nm, and measurement ranges from 0 - 9999 FNU, 0.00 - 9999 ppm, 0 - 300 g/l, 0 - 200 percent (depending on the type of sample). It has an operating temperature range from -5 to +50 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1808";
        skos:note              "accepted"@en;
        skos:prefLabel         "Endress and Hauser TurbiMax W CUS 41 in-situ particle sizer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0210/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01963/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1582/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1582";
        dc:date                "2021-01-26 14:26:43.0";
        dc:identifier          "SDN:L22::TOOL1582";
        pav:authoredOn         "2021-01-26 14:26:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1582/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1582/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "CPICS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "The Continuous Particle Imaging and Classification Sensor (CPICS) provides in situ aquatic microscopy of seawater, freshwater and laboratory samples. The CPICS-1000-e is a stand-alone package that may be deployed on a CTD rosette or autonomous vehicle. It uses darkfield illumination to capture high-resolution colour images, showing features as small as 0.04 mm and as large as 12 mm. Because of its open-flow approach to water sampling, delicate structures of plankton and particles remain intact, as do predator-prey interactions. It has a colour resolution of 24-bits, an image resolution of 6 Megapixels (2736 x 2192) and a maximum frame rate of 10fps. The instrument has a depth rating of 1000m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1582";
        skos:note              "accepted"@en;
        skos:prefLabel         "CoastalOceanVision CPICS-1000-e imaging sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0148/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01781/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0509/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0509";
        dc:date                "2012-06-22 15:36:10.0";
        dc:identifier          "SDN:L22::TOOL0509";
        pav:authoredOn         "2012-06-22 15:36:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0509/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Partec 100 FBRM";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "An in situ particle sizer that uses the principal of focused beam reflectance measurement (FBRM) to measure particle sizes in the range 2-1000 um in a liquid. The probe tip includes an optic filter, beam splitter, laser beam and sapphire window, through which laser light is passed into the liquid. The light is diffracted by particles suspended in the liquid and the FBRM measures the chord length distribution (CLD), which is a function of the number, size and shape of the particles. Typically, many thousands of chords are measured per second, providing a robust measurement sensitive to the change in the size or number of particles. The instrument can be deployed on a hydrographic wire and lowered to the required depth, where is is held steady while a particle spectrum is collected. The instrument was developed by Lasentec (also known as Lasentech), which has since been taken over by Mettler Toledo. The Partec 100 is no longer in production."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0509";
        skos:note              "accepted"@en;
        skos:prefLabel         "Lasentec Partec 100 focused beam reflectance measurement particle sizer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1588/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1588";
        dc:date                "2021-01-06 14:16:37.0";
        dc:identifier          "SDN:L22::TOOL1588";
        pav:authoredOn         "2021-01-06 14:16:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1588/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1588/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "McLane IFCB";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "An in-situ automated submersible imaging flow cytometer that generates images of particles in-flow taken from the aquatic environment. It can be used for bench top analysis as well as for pier and other wired deployments. Extended unattended deployments (6 to 9 months) are possible. The IFCB uses a combination of flow cytometric and video technology to capture high resolution images of suspended particles. Laser induced fluorescence and light scattering from individual particles are measured and used to trigger targeted image acquisition. Collected images during continuous monitoring can be processed externally with automated image classification software. Images can be classified to the genus or even species level. IFCB generates high resolution (~3.4 pixels/micron) images of suspended particles in the size range <10 to 150 &micro;m. The instrument continuously samples at a rate of 15ml of sea water per hour. Depending on the target population the IFCB can generate on the order of 30 000 high resolution images per hour.It is depth rated to 40m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1588";
        skos:note              "accepted"@en;
        skos:prefLabel         "McLane Research Laboratories Imaging FlowCytobot imaging sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00996/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0036/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1611/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1611";
        dc:date                "2024-08-22 15:12:06.0";
        dc:identifier          "SDN:L22::TOOL1611";
        pav:authoredOn         "2024-08-22 15:12:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1611/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1611/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Vaisala PTB101B";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "An analogue barometer. It uses a silicon capacitive absolute pressure sensor (BARCAP). The (B) barometer is supplied from the factory in the shut-down mode. In the shut-down operating mode the barometer is turned on/off using an external TTL level trigger. The (B) barometer has a measurement range between 600 - 1060 hPa and an accuracy of +/- 0.5 hPa (at 20 degC)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1611";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala PTB101B barometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0025/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1630/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1630";
        dc:date                "2021-02-10 18:43:00.0";
        dc:identifier          "SDN:L22::TOOL1630";
        pav:authoredOn         "2021-02-10 18:43:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1630/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SKIPPER EML224";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A dual-axis electromagnetic log system comprising a sensor (transducer), display (operator) unit and an electronic interconnection unit. The instrument operates under the principle of measuring changes in the electromagnetic field generated by the transducer to determine ship speed for navigational purposes. The electromagnetic sensor measures longitudinal and transversal speeds, drift angle and sea temperature. The instrument has a speed measurement accuracy of +/- 0.2 knots or 2% of reading, and distance travelled accuracy of +/- 0.2 nm or 2%, whichever is greater. Roll and pitch accuracy is >10 and >5 degrees respectively, and temperature accuracy is <1 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1630";
        skos:note              "accepted"@en;
        skos:prefLabel         "Skipper Electronics EML224 electromagnetic speed log"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00801/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0134/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1168/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1168";
        dc:date                "2017-11-21 15:04:18.0";
        dc:identifier          "SDN:L22::TOOL1168";
        pav:authoredOn         "2017-11-21 15:04:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1168/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "IsoPrime100";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB48/>;
        skos:definition        "A gas-source laboratory benchtop isotope ratio mass spectrometer (IRMS), which operates in dual inlet or continuous flow modes. It forms part of the IsoPrime system which has a range of sample preparation and purification modules that can be coupled with the IsoPrime100 IRMS. The modules can analyse a range of samples (solids, liquids or gases) and each prepares the sample to be introduced into the IRMS as purified gases. The resultant prepared gases are then ionised and analysed for their isotopic content by the IRMS. The IsoPrime100 offers standard analysis of d13C, d18O, d15N and d34S using the IsoPrime Universal triple Collector (UTC), featuring patented high-performance Faraday buckets and automatic gain-switching. Due to its capacity to detect and measure up to ten ion beams simultaneously, the IsoPrime100 can also be used for multi-collector applications such as bromine isotopes, N2O isopromers, SO2-SO fractions and CO2 clumped isotopes, as well as other bespoke configurations. It has a sensitivity of 850 molecules per ion in dual inlet mode and 1200 molecules per ion in continuous flow mode."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1168";
        skos:note              "accepted"@en;
        skos:prefLabel         "IsoPrime100 Stable Isotope Ratio Mass Spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00650/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0819/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0819";
        dc:date                "2015-01-09 14:18:23.0";
        dc:identifier          "SDN:L22::TOOL0819";
        pav:authoredOn         "2015-01-09 14:18:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0819/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Gridded quadrat";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/59/>;
        skos:definition        "A square or rectangular rigid frame of known area, often home-made, with the total area divided into sub-areas by a graticule made up of threads or wires connecting opposite sides of the quadrat spaced at equal intervals. It is placed on the substrate to mark a fixed area for sampling flora or fauna. The subdivision by the graticule increases the accuracy of coverage estimates."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0819";
        skos:note              "accepted"@en;
        skos:prefLabel         "Gridded quadrat"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1259/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1259";
        dc:date                "2018-08-02 15:26:57.0";
        dc:identifier          "SDN:L22::TOOL1259";
        pav:authoredOn         "2018-08-02 15:26:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1259/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "UnSpec trammel net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/65/>;
        skos:definition        "A net consisting of a sheet of fine-meshed net sandwiched between two outer sheets of large-meshed nets. All three net walls are attached to a weighted foot rope and a floating headline, so that they hang vertically in the water. The height of the inner net is double that of the outer nets, so that fish swim through the larger outer net wall and become entangled in the loose pockets of the inner net."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1259";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified trammel net"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0857/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0857";
        dc:date                "2015-05-27 15:47:59.0";
        dc:identifier          "SDN:L22::TOOL0857";
        pav:authoredOn         "2015-05-27 15:47:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0857/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "EK500";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/FFES/>;
        skos:definition        "The EK500 is a modular triple frequency scientific echo sounder with a high performance and very accurate receiving system and with independent parallel processing within each of the frequency channels.  Furthermore, the Simrad EK500 is the only sounder system which in one compact unit provides: a high performance scientific sounder; an advanced echo integrator, and a target strength analyser (split -beam method)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0857";
        skos:note              "accepted"@en;
        skos:prefLabel         "Simrad EK500 Fishery Research Echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0420/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0420";
        dc:date                "2011-09-03 16:28:15.0";
        dc:identifier          "SDN:L22::TOOL0420";
        pav:authoredOn         "2011-09-03 16:28:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0420/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Pall AcroPak 200";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/84/>;
        skos:definition        "A filter cartridge designed for small- to medium-volume sterile filtration. It incorporates a Supor [hydrophilic polyethersulfone (PES)] membrane, which allows high flow rates and throughputs (up to 20 litres), and is ideal for solutions where low protein binding is required. Pore sizes range from 0.2 to 0.8 um and the effective filtration area is 200 cm^2. A built-in prefilter extends filter life when particulate-laden solutions, such as serum-containing media, are processed. The filter is manufactured without the use of adhesives to minimize extractables, sterilized by gamma irradiation and individually packaged."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0420";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pall AcroPak 200 filter cartridge"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00549/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0876/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0876";
        dc:date                "2015-06-08 15:32:54.0";
        dc:identifier          "SDN:L22::TOOL0876";
        pav:authoredOn         "2015-06-08 15:32:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0876/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "L and R S33";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/158/>;
        skos:definition        "A stabilized-platform sensor which measures the Earth's gravitational field. It is used for operations in the air and at sea. The system comprises a gravity meter mounted on a gyro-stabilized platform. The system consists of fixed aluminium air-dampers and a 96 TPI (threads per inch) measuring screw. The accuracy of sensor is about 2mGal."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0876";
        skos:note              "accepted"@en;
        skos:prefLabel         "LaCoste and Romberg S33 gravity meter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00882/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2212/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2212";
        dc:date                "2025-08-28 09:32:55.0";
        dc:identifier          "SDN:L22::TOOL2212";
        pav:authoredOn         "2025-08-28 09:32:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2212/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2212/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Metrohm 858";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB40/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB33/> , <http://vocab.nerc.ac.uk/collection/L05/current/84/>;
        skos:definition        "The Metrohm 858 sample processor prepares samples from 500 ul to 500 mL by performing filtration, dialysis, dilution, inline calibration, and eluent production in an automated fashion for ion chromatography analysis. The sample processor can be integrated with other Metrohm instruments (e.g. with an Eco IC) to produce an automated ion chromatography system. The instrument comprises an interchangeable sample rack, a lift, three Metrohm Serial Bus (MSB) connectors, two USB connectors, a stirrer connector, and can optionally be fitted with a two-channel peristaltic pump and a returnable injection valve. The maximum lift load is approximately 30 N with an adjustable speed of 5 - 25 mm/s. The two-channel peristaltic pump operates at a rate of 6 - 90 rpm, has a typical flow rate of 0.3 mL/min at 18 rpm (with Metrohm 6.1826.320 standard pump tubing), and a maximum pressure of 4 bar. The stirring rates range from 180 - 3000 rpm (for the 722/802 propeller stirrer) and 180 - 2600 rpm (for the 741 magnetic stirrer). The Metrohm 858 should be stored and operated at ambient temperatures in the range of 5 to 45 degC, at a maximum humidity of 80%."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2212";
        skos:note              "accepted"@en;
        skos:prefLabel         "Metrohm 858 sample processor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0043/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00620/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0662/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0662";
        dc:date                "2024-08-14 17:10:08.0";
        dc:identifier          "SDN:L22::TOOL0662";
        pav:authoredOn         "2024-08-14 17:10:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0662/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0662/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0662/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "CTG GLOWtracka";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/BLUMS/>;
        skos:definition        "The GLOWtracka is designed to measure visible emissions from bioluminescent organisms in the marine environment. It can be moored, used in profiles, or deployed in towed vehicles. It's precision flow meter stimulates bioluminescent organisms and measures the light flashes as the organisms pass the photodiode. The sensor can be deployed to depths up to 1000 m and has an irradiance detectivity of 10 picowatt at 560 nm over z.f. -50 Hz (-3 db)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0662";
        skos:note              "accepted"@en;
        skos:prefLabel         "Chelsea Technologies Group GLOWtracka bioluminescence"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG0237/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0616/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0616";
        dc:date                "2024-08-15 14:00:21.0";
        dc:identifier          "SDN:L22::TOOL0616";
        pav:authoredOn         "2024-08-15 14:00:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0616/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0616/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Gill WindMaster";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "Three axis ultrasonic anemometer offers sonic temperature, speed of sound and wind vector outputs at 20 Hz (32 Hz option). The instrument measures the time taken for an ultrasonic pulse of sound to travel from an upper transducer to the opposite lower transducer, and compares it with the time for a pulse to travel from lower to upper transducer. It has an aluminium/carbon fibre construction and will monitor either 0 - 60 m/s (0 - 134 mph) or 0 - 45 m/s (0 - 100 mph) wind speed depending upon the model. The units of wind speed, output rate, and formats are all user selectable. There are several optional analogue outputs and inputs depending on the model. Windspeed accuracy is 1.5 percent root mean squared (0 - 20 m/s) and wind direction accuracy is 2 degrees at less than 25 m/s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0616";
        skos:note              "accepted"@en;
        skos:prefLabel         "Gill Instruments Ltd WindMaster ultrasonic anemometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00326/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2315/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2315";
        dc:date                "2026-07-02 12:22:36.0";
        dc:identifier          "SDN:L22::TOOL2315";
        pav:authoredOn         "2026-07-02 12:22:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2315/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Axis M0565";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A mini-HDTV dome camera with pan, tilt, zoom (PTZ) for remote indoor monitoring. The ceiling-mount camera enables flexible coverage over a 500 square meter area, with a +/-180 degree pan, 90 degree tilt and 5x digital zoom. It provides full frame rate video in HDTV 1080p resolution. It supports multiple H.264 and Motion JPEG video streams. The maximum video resolution is 1920x1080 (16:9), and maximum frame rate is 25/30 frames per second. It has video motion detection. It supports wireless input/output connectivity and can communicate wirelessly with connected Z-Wave Plus devices. The IP51 rating ensures protection against dust and dripping water. It has a two-way audio and also supports audio detection."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2315";
        skos:note              "accepted"@en;
        skos:prefLabel         "Axis Communications M5065 (PTZ mini dome) network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01991/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0244/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2334/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2334";
        dc:date                "2026-08-19 12:02:42.0";
        dc:identifier          "SDN:L22::TOOL2334";
        pav:authoredOn         "2026-08-19 12:02:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2334/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sonardyne Syrinx DVL";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/379/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/>;
        skos:definition        "A Doppler velocity log (DVL) to measure the velocity of an underwater vehicle, such as a remotely operated vehicle (ROV) or autonomous underwater vehicle (AUV), relative to the sea floor. 4 transducers are used to calculate the velocity of the vehicle in 3 dimensions. An integrated Acoustic Doppler Current Profiler (ADCP) provides the option for current profiling, and the instrument can be operated in standalone modes for the DVL or the ADCP, or in combination mode. Available in two frequencies: 600 kHZ or 400 kHz. The array configuration is a 4-beam array at 30 degree beam angles. Individual transducers can be replaced. Minimum altitude is 0.4 m and maximum altitude is 175 m (600kHz) or 230 m (400 kHz). Bottom velocity - single ping precision is +/- 0.22 cm/s (600 kHz) or +/- 0.28 cm/s (400 kHz). DVL velocity range is > 10 m/s and DVL velocity resolution is 0.01 cm/s. ADCP profiling range is 0.4 m to 80 m (600kHz) or 0.4 m to 120 m (400 kHz). Maximum ping rate in ADCP standalone mode is 4 Hz and 2.5 Hz in DVL + ADCP mode. Depth rating is 4000 m or 6000 m (both in titanium housing), and an Original Equipment Manufacturer (OEM) version with no housing is also available. A temperature sensor is included, and the operating range of the instrument is -5 to 55 deg C."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2334";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sonardyne Syrinx Doppler velocity log"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01062/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0011/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0209/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0209";
        dc:date                "2024-04-19 15:58:01.0";
        dc:identifier          "SDN:L22::NETT0209";
        pav:authoredOn         "2024-04-19 15:58:01.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0209/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Aq BioTech plankton net 200 um mesh, 40 cm mouth";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "A cylindrical-conical plankton net with 40 cm diameter mouth opening and 200 um mesh size, with cod end adapted to fit Aquatic BioTechnology CP3-110 collectors. The net is designed to be dragged by a boat, and includes a stainless steel cable with an anti-twist shackle for connecting to the main line. The net structure comprises a hoop, clamp, triple-point bridle, and a rod for attaching a flow meter."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0209";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aquatic BioTechnology simple plankton net with 200 um mesh size, 40 cm diameter mouth opening, CP3-110 collector"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02035/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0282/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0692/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0692";
        dc:date                "2014-05-01 15:08:06.0";
        dc:identifier          "SDN:L22::TOOL0692";
