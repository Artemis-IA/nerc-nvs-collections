<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2321/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2321";
        dc:date                "2026-08-06 07:47:51.0";
        dc:identifier          "SDN:L22::TOOL2321";
        pav:authoredOn         "2026-08-06 07:47:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2321/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "TIS DFM 37UX265-ML";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A colour board-level camera with a USB 3.1 interface and flexible design that can be used in a range of space-limited applications. A 1/18 inch Sony CMOS Pregius IMX265 sensor delivers 60 frames per second (fps) with a resolution of 2,048×1,536 (3.1 Megapixels). Dynamic range is 12 bit and supported pixel formats are 8-Bit Bayer (RG) and 16-Bit Bayer (RG). Board dimensions are height 36 mm, width 36 mm, and length 15 mm with a mass of 7 g. Shutter speed is adjustable with a range from 1 us to 4 s, and gain is also adjustable with a range of 0 dB to 40 dB. Operating temperature ranges from -5 deg C to 45 deg c, and operating humidity ranges from 20 % to 80 % (non-condensing). An M12x0.5 lens mount and compatible lenses can be used with this board camera."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2321";
        skos:note              "accepted"@en;
        skos:prefLabel         "The Imaging Source DFM 37UX265-ML video camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0397/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02225/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1789/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1789";
        dc:date                "2024-08-14 16:12:06.0";
        dc:identifier          "SDN:L22::TOOL1789";
        pav:authoredOn         "2024-08-14 16:12:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1789/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1789/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Carlo Erba NA 2500";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB01/>;
        skos:definition        "A laboratory elemental analyser part of the EA 1110 series of analysers. It measures total nitrogen (N), carbon (C) and sulphur (S) in organic and inorganic samples. Analysis operates with dynamic flash combustion of the sample with oxygen. After combustion the resulted gases are carried by a helium flow to a layer containing copper, they are swept through a water trap, and then through a GC column, which provides the separation of the combustion gases. Finally, they are detected by a Thermal Conductivity Detector (TCD). The instrument can determine N individually or NC or NCS simultaneously depending on the analytical configuration. Combustion is at 900-1000 degC. Reduction is at 680-780 degC. Helium gas flow is 140 ml/min (150 kPa). Oxygen flow is 40-60 ml/min (150 kPa) and oxygen loop is 25 cc. Cycle time is 240 seconds and oxygen injection time is 60 secondss."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1789";
        skos:note              "accepted"@en;
        skos:prefLabel         "Carlo Erba NA 2500 (NCS) elemental analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0208/> .

