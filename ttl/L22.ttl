        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/>;
        skos:definition        "The workhorse mariner WM-600 provides short-range current profiling (typical range 50 m, or 66 m in long-range mode). This model operates at a 300 kHz frequency providing precision bottom-track reference for direct vessel speed measurement."@en;
