<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0712/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0712";
        dc:date                "2014-06-30 14:51:49.0";
        dc:identifier          "SDN:L22::TOOL0712";
        pav:authoredOn         "2014-06-30 14:51:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0712/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Aanderaa 4050";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A compact fully integrated sensor for measuring the water temperature. The sensor is designed to be mounted on Aanderaa recording instruments (e.g. RCM 9/11 doppler current meter) and data loggers. The sensor can also be used as stand alone, and is easily integrated in other measurement systems with third party data loggers. Resolution is 0.001 C and accuracy is 0.03 C. Further development of the 4050 has been suspended in favour of the replacement 4060 model. More information may be found in http://www.aanderaa.com/productsdetail.php?Temperature-Sensor-12."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0712";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa temperature sensor 4050"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0007/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0750/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0750";
        dc:date                "2024-08-23 15:47:12.0";
