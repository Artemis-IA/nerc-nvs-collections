        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00777/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0682/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0682";
        dc:date                "2022-04-27 16:55:15.0";
        dc:identifier          "SDN:L22::TOOL0682";
        pav:authoredOn         "2022-04-27 16:55:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0682/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0682/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Vaisala WXT510";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "This is a a self-contained weather station measuring wind speed and direction, precipitation , air temperature, humidity and barometric pressure. The station has the following sensors:Vaisala WINDCAP ultrasonic wind sensor measuring average, maximum and minimum windspeed  accurate to the greater of 0.3 m/s or 3% (0-35 m/s range) or 5% (36-60 m/s) range and average, maximum and minimum wind direction to an accuracy of 3 degrees. Default averaging interval is 60 minutes.Vaisala RAINCAP sensor-2 - a piezoelectrical sensor that measures rainfall amount and intensity (rate) to an accuracy of 5% by counting raindrop impacts. Capacitive silicon BAROCAP air pressure sensorCapacitive ceramic THERMOCAP air temperature sensorCapacitive thin film polymer HUMICAP 180 humidity sensorThe precipitation and wind sensors may be optionally heated to keep them free from snow and ice. Output is via an RS232 connection. More information may be found at http://www.vaisala.com/Vaisala%20Documents/User%20Guides%20and%20Quick%20Ref%20Guides/WXT510_User_Guide_in_English.pdf."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0682";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala WXT510 weather transmitter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2044/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2044";
        dc:date                "2024-05-30 15:33:02.0";
        dc:identifier          "SDN:L22::TOOL2044";
        pav:authoredOn         "2024-05-30 15:33:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2044/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2044/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "GoPro Hero4 session";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A compact waterproof one-button design camera. Photo mode, video mode, and multi-shot mode available. Ultra sharp image quality with all-glass lens. Ultra wide-angle field of view with reduced distortion. Video mode: video resolution options ranges from WVGA to 1440p; frames per second options range from 120, 100 to 30, 25; field of view can be adjusted between medium and ultra wide depending on resolution; screen resolution options ranges from 848 X 480 to 1920 X 1440. Photo mode: photo resolution 8 MP with wide field of view and 3264 X 2448 screen resolution; or photo resolution 5 MP with medium field of view and 2720 X 2040 screen resolution. Multi-shot mode captures up to 10 photos in 1 second with alternative options available, or can be set to time-lapse."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2044";
        skos:note              "accepted"@en;
        skos:prefLabel         "GoPro Hero4 Session camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01122/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0262/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2285/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2285";
        dc:date                "2026-04-01 15:00:27.0";
        dc:identifier          "SDN:L22::TOOL2285";
        pav:authoredOn         "2026-04-01 15:00:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2285/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "D-Link DCS-7010L";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A high definition (HD) Cloud-enabled IP video camera suitable for outdoor surveillance. This camera is built with a megapixel image sensor which provides up to 720p HD resolution images and videos. An infrared cut removable (ICR) filter is built into the DCS-7010L, which blocks infrared light during the day for improved image quality. At night this filter moves out of the way to use all available light for low-light surveillance, and the camera is equipped with an IR LED illuminator with 10 m range. The DCS-7010L also comes with zoom and panning capability. A solid metal IP-66 weatherproof housing protects this camera from dirt and rain, making it suitable for outdoor use. A wire-in bracket protects the power cable from damage. Built in motion detection allows this camera to automatically record video and notify the user when motion is detected. Audio connectors may be used with a microphone, enabling two-way communication via the DCS-7010L. Configurable features of this camera include image size, frame rate, shutter speed, brightness, saturation, contrast, and sharpness. HD resolution: 1280 x 720) and up to 1 Megapixel (1280 x 800). Focal length: 4.3 mm; aperture: F2.0; angle of view: 73.5 degrees (H) 42.5 degrees (V) 83.3 degrees (D). Operating humidity: 20 percent to 80 percent non-condensing. Operating temperature: -25 to 50 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2285";
        skos:note              "accepted"@en;
        skos:prefLabel         "D-link DCS-7010L HD mini bullet outdoor network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0381/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02192/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2247/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2247";
        dc:date                "2025-12-17 17:03:55.0";
        dc:identifier          "SDN:L22::TOOL2247";
        pav:authoredOn         "2025-12-17 17:03:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2247/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SubC Rayfin Mk2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A high definition (HD) underwater camera which provides Ethernet 4K and HD video and communication, and high resolution stills. It features a built in tilt and roll sensor, with optional depth and temperature sensors. The camera is depth rated to 6000 metres, with an optional 11,000 metre rating available. The camera features a grade 5 titanium and sapphire construction. It has ROV and autonomous applications, for deep-sea research, and live inspections and surveys, in addition to battery powered systems or observatories. Voltage is 16.5 - 32.5 VdC at 13.5 Watts. Angle of view in water is 81 degrees diagonal, with less than 3.4% distortion. The image sensor is 12.3 megapixels, 4056 x 3040 pixels, 12-bit complementary metal-oxide-semiconductor (CMOS). Focus range is 15 cm to infinity. Operating temperature in water is -20 to 30 degC. Zoom is 10x (digital)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2247";
        skos:note              "accepted"@en;
        skos:prefLabel         "SubC Imaging Rayfin Mk2 Benthic camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0259/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02010/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2050/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2050";
        dc:date                "2024-06-17 12:09:53.0";
        dc:identifier          "SDN:L22::TOOL2050";
        pav:authoredOn         "2024-06-17 12:09:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2050/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2050/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "NatureScot Custom SeaGIS Stereo-BRUV";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A custom-built Stereo Baited Remote Underwater Video System (BRUVS) based on guidance from the Australian manufacturer SeaGIS. The system is calibrated using SeaGIS calibration cubes. The frame is made of stainless steel and the camera housing is made of plastic. It is depth rated to 300m. They are fitted with lights. The camera used is a GoPro Hero 10 in HD mode (1080) x 30fps."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2050";
        skos:note              "accepted"@en;
        skos:prefLabel         "NatureScot [custom] Stereo Baited Remote Underwater Video System"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02003/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0350/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2240/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2240";
        dc:date                "2025-11-11 16:49:28.0";
        dc:identifier          "SDN:L22::TOOL2240";
        pav:authoredOn         "2025-11-11 16:49:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2240/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Bruker SkyScan 1172";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A desktop micro-CT scanner used for non-destructive 3D imaging of a sample's internal structure. Used in the fields of tissue biology and materials science because it offers the ability to obtain in-depth quantitative data on the 3D structure of bone, teeth, cartilage, lung, microvasculature and other soft tissues, as well as composite materials, fuel cells, rocks, etc. It generates a complete 3D representation by taking multiple X-ray transmission images from different angles and using algorithms to construct a 3D model. This allows for detailed, quantitative analysis of samples like bone, soft tissues, and materials without physical slicing. This instrument has a fully distortion corrected 11 Mp X-ray camera that is a 12-bit cooled charge-coupled device (CCD) fibre-optically camera coupled to scintillator. The X-ray source is 20-100 kV, 10 W, with a <5 um spot size. The detail detectability is 1 um at highest resolution to 25 um."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2240";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bruker SkyScan 1172 (desktop) micro-CT scanner"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02146/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0368/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1164/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1164";
        dc:date                "2022-04-27 16:55:15.0";
        dc:identifier          "SDN:L22::TOOL1164";
        pav:authoredOn         "2022-04-27 16:55:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1164/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1164/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Vemco VR2";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "An acoustic receiver comprising hydrophone, receiver, ID detector, data logging memory and battery housed within a submersible corrosion-resistant case. It is used to remotely retrieve ID numbers and time stamps from VEMCO coded transmitter tags deployed on marine fauna travelling within the VR2's receiver range. The VR2 is ideal for use in river monitoring or freshwater lake studies, as well as large tracking operations in oceanic systems. It features a Smart LED (light emitting diode), two megabytes of data storage (approx. 300000 detections), a resume study feature, and a replaceable battery (single Lithium cell). Detections are stored in the VR2's memory for later retrieval using a VR PC interface and a PC computer running VUEsoftware. The VR2 is now discontinued and has been replaced by the Vemco VR2W receivers."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1164";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vemco VR2 Receiver"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00348/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0085/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0085";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0085";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0085/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Lowestoft frame trawl";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/23/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "A 142 cm x 142 cm rectangular mouth opening trawl with a rigid mouth frame and  nets 747.5 cm long of 5.0 cm mesh. Uses a TSK flowmeter converted to a digital counter unit and conducting cable to power  depth and temperature sensors.  Data recorded on a surface chart recorder.  Normally towed at 3 knots.  A 100 cm x 100 cm mouth opening trawl with a net length of 475 cm also described.  Mainly for small pelagic fish capture.  Not opening/closing [Wiebe and Benfield 2003 Plate 4 F]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0085";
        skos:note              "accepted"@en;
        skos:prefLabel         "Lowestoft frame trawl - Walker and Davies (1986)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0072/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0072";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0072";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0072/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Pearcy modified IKMT";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/23/> , <http://vocab.nerc.ac.uk/collection/L05/current/68/>;
        skos:definition        "A 1.8 m IKMT fitted with a scaled down version of the Be MPS with 3 nets attached to the back of the trawl.  A pressure-release system controls the opening/closing of the cod-end nets [Wiebe and Benfield 2003 Plate 26 B]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0072";
        skos:note              "accepted"@en;
        skos:prefLabel         "Modified Isaacs-Kidd Midwater Trawl with MPS cod-end - Pearcy and Hubbard (1964)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2311/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2311";
        dc:date                "2026-06-10 10:24:55.0";
        dc:identifier          "SDN:L22::TOOL2311";
        pav:authoredOn         "2026-06-10 10:24:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2311/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sony α7S III";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A video and still image interchangeable lens camera capable of 4K recording with 120 fps. The camera uses a rechargeable battery that lasts for a continuous recording time of up to 135 minutes as well as a USB power delivery mechanism for longer continuous recording. The α7S III uses a CMOS sensor with 12.1 effective megapixels allowing for fast readout speeds and high sensitivity. The standard ISO range is 80-102400, which is further expandable to 40-409600 (80-409600 for movies). Still images can be outputted in JPEG, HEIF, and RAW formats; video in MPEG-4 or MPEG-H; and audio in LPCM or MPEG-4. Multiple assisted focus modes can be selected, including eye and subject recognition as well as image stabilisation for ease of recording. The in-built LCD screen is touch sensitive and Bluetooth and FTP functions can be used for video/image transfer."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2311";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sony Alpha 7S III (ILCE-7SM3) camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0267/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02014/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2330/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2330";
        dc:date                "2026-08-12 12:33:09.0";
        dc:identifier          "SDN:L22::TOOL2330";
        pav:authoredOn         "2026-08-12 12:33:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2330/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "OS icListen SB60L-ETH";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "A high-frequency broadband smart digital hydrophone. The instrument processes, streams and records HD acoustic data in real time. The icListen can be used as a digital hydrophone, acoustic recorder, or both simultaneously. It features ultra-low-noise and wide dynamic range for high-quality signal quality and stability. The ETH model uses an ethernet connection and is depth rated to 6000 m. It has a frequency range between 10 Hz and 200 kHz. This model is part of the icListen HF hydrophone series."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2330";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ocean Sonics icListen SB60L-ETH smart hydrophone"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0100/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01004/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1779/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1779";
        dc:date                "2022-02-22 17:09:18.0";
        dc:identifier          "SDN:L22::TOOL1779";
        pav:authoredOn         "2022-02-22 17:09:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1779/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Aanderaa 2810";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A barometric pressure sensor designed for use with the Aanderaa Automatic Weather Stations and Display Units. The 2810 utilizes a 4x4 mm silicon chip as a sensing element. A thin membrane is exposed to atmospheric pressure on one side and to a vacuum on the other. The membrane is furnished with 4 diffused resistors that form a Wheatstone bridge. The output signal is proportional to the atmospheric pressure. The chip acts as an absolute pressure-sensing device. A temperature sensing resistor and 4 heating resistors are also diffused onto the chip. In conjunction with an external control circuit, these resistors allow the chip to be held at a constant temperature of 47 degC during the measurement. It has a measurement range of 920 to 1080 hPa, an accuracy of +/- 0.2 hPa, a resolution of 0.2 hPa, and an operating temperature range of -40 to +47 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1779";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa 2810 air pressure sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0007/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0821/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0821";
        dc:date                "2015-01-26 17:03:56.0";
        dc:identifier          "SDN:L22::TOOL0821";
        pav:authoredOn         "2015-01-26 17:03:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0821/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "AML Micro SV SVP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/185/>;
        skos:definition        "A single sensor, sound velocity probe for multi-beam systems. It can also be integrated into AUV and ROV systems. The probe directly measures sound velocity by the time-of-flight of an acoustic ping. It has a range of 1400 m/s - 1600 m/s and an accuracy of +/-0.05 m/s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0821";
        skos:note              "accepted"@en;
        skos:prefLabel         "AML Oceanographic Micro SV sound velocity probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG0236/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1969/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1969";
        dc:date                "2023-07-12 14:57:42.0";
        dc:identifier          "SDN:L22::TOOL1969";
        pav:authoredOn         "2023-07-12 14:57:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1969/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Panasonic WV-SC384";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A high definition (HD) PTZ (pan-tilt-zoom) network camera designed for real time monitoring and high resolution recording. It produces 720p video, using a 1/3 type MOS sensor, Wide Dynamic Range (WDR) and Adaptive Black Stretch (ABS) technology and Video Motion Detector (VMD). The WV-SC384 comes with day/night functionality, pan/tilt capacity, digital noise reduction, and face detection function. It uses power over Ethernet (PoE). The image sensor size is 1/3, minimum colour lux 0.038, minimum b/w lux 0.031. Maximum video resolution 1280X960 with 30 frames per second. The lens has a focal length of 4.7 - 84.6 mm, with horizontal view between 3.2 and 55.2 deg., and a vertical view between 2.4 and 42.1 deg."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1969";
        skos:note              "accepted"@en;
        skos:prefLabel         "Panasonic WV-SC384 (HD dome) network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0258/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01154/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0397/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0397";
        dc:date                "2024-08-22 15:12:06.0";
        dc:identifier          "SDN:L22::TOOL0397";
        pav:authoredOn         "2024-08-22 15:12:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0397/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0397/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Vaisala PTB210";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "Digital barometer using a silicon capacitive absolute pressure sensor. The instrument can operate over a pressure range of 50 to 1100 hPa and a temperature range of -40 to 60 degC. Two basic configurations are available: serial output for 500 - 1100 hPa and 50 - 1100 hPa, and analogue output with different scalings between 500 and 1100 hPa. It is designed for a variety of applications, such as weather stations, data buoys and ships."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0397";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala PTB210 digital barometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2215/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2215";
        dc:date                "2025-09-11 09:57:45.0";
        dc:identifier          "SDN:L22::TOOL2215";
        pav:authoredOn         "2025-09-11 09:57:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2215/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Thermo Finnigan MAT 252 IRMS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB48/>;
        skos:definition        "An isotope ratio mass spectrometer designed to determine stable isotope ratios of H/D, 13C/12C, 15N/14N, 18O/16O, 34S/32S (from SO2 to SF6) as well as Kr and Xe. It is a high-performance analytical instrument used for a variety of applications in various fields, including environmental science, geology, and biomedical research. It has a dual micro-volume inlet system, electromagnet, 24X multiport manifold interfaced with a Pentium PC using ISODAT software. The mass range is 1 - 150 Dalton at 10 kV. The resolution (m/delta m) for Carbon (C), Nitrogen (N), Oxygen (O), and Sulphur (S) is 200 (10 % valley), and for Hydrogen (H) and Deuterium (D) it is 25 (10 % valley). The absolute sensitivity is 1000 molecules CO2 per mass 44 ion at the collector (1000 molecules/ion). The contribution of the mass 44 intensity to the intensity of mass 45 is less than 2 x 10e-6."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2215";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Finnigan {Thermo Fisher Scientific} MAT 252 isotope ratio mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0035/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1785/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1785";
        dc:date                "2022-04-08 11:56:57.0";
        dc:identifier          "SDN:L22::TOOL1785";
        pav:authoredOn         "2022-04-08 11:56:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1785/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Elementar VG Prism III IRMS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB48/>;
        skos:definition        "A modular benchtop isotope ratio mass spectrometer which can operate in dual inlet or continuous flow modes. It is designed to measure stable isotope ratios of N2, CO2, H2, SO2, SF6 and O2 and C. It has a Multi-collector with four Faraday buckets, featuring integral suppressers. The central bucket is fixed, and the others are externally moveable using precision adjusters. The ion optics have a horizontal geometry, and the design allows individual access to the source and collectors through the lids of the housings. A manifold option, HD option and Differential Pumping option are available depending on user requirements. Its precision is better than 0.05 permille. Sample size can range from 100 ul to 150 ul."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1785";
        skos:note              "accepted"@en;
        skos:prefLabel         "VG PRISM III Isotope Ratio Mass Spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0197/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01860/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1525/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1525";
        dc:date                "2020-08-17 15:22:41.0";
        dc:identifier          "SDN:L22::TOOL1525";
        pav:authoredOn         "2020-08-17 15:22:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1525/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1525/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1525/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "FloCat C-ES45";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "An impeller flow meter in 3/8 Inch nominal pipe size. The body material for the ES45-B002 is polypropylene, with transparent acrylic covers for visual flow indication. Optional Acrylic or Polypropylene covers available. Optional Nickel tungsten carbide, and zirconia ceramic shafts. range: 0.27 - 18.9 LPM. Accuracy: +/- 1.0% FS."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1525";
        skos:note              "accepted"@en;
        skos:prefLabel         "FloCat C-ES45 B002 flow meters"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0106/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1544/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1544";
        dc:date                "2020-09-15 13:16:40.0";
        dc:identifier          "SDN:L22::TOOL1544";
        pav:authoredOn         "2020-09-15 13:16:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1544/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Blue Robotics HD camera";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A high-definition (HD), wide-angle, low-light video camera designed for use on the Blue Robotics BlueROV2 remotely operated vehicle (ROV). It enables a live HD video feed for shallow water inspections and operations. The camera is mounted to a Hitec HS-5055MG tilt servo mechanism, enabling the pilot to tilt the camera up or down. The camera operates via USB at 1080p, 30fps, and has an 80 degrees horizontal field of view. It has a camera tilt range of +/- 90 degrees (180 degrees total range)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1544";
        skos:note              "accepted"@en;
        skos:prefLabel         "Blue Robotics high definition video camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0113/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01736/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1100/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1100";
        dc:date                "2024-08-22 15:12:07.0";
        dc:identifier          "SDN:L22::TOOL1100";
        pav:authoredOn         "2024-08-22 15:12:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1100/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1100/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Vaisala HMT367";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "The Vaisala HMT367 is a humidity and temperature transmitter. This sensor is based on a probe containing a patented (HUMICAP) capacitive thin polymer film humidity sensor and a PT100 platinum resistance thermometer. HMT367 was designed for high humidities. The sensor was designed to measure data in hazardous areas, including potentially explosive environments (containing gases or dust). It measures temperatures ranging from -70 to 180 degC. It has a probe diameter of 12 mm."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1100";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala HMT367 humidity and temperature transmitter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1937/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1937";
        dc:date                "2023-06-05 13:58:31.0";
        dc:identifier          "SDN:L22::TOOL1937";
        pav:authoredOn         "2023-06-05 13:58:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1937/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Nikon D700";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A digital single-lens reflex (DSLR) handheld camera with an FX-format image sensor enabling full frame image capture. The D700 has a wide range of applications that require high quality images. Picture angle is equivalent to angle produced by lens focal length (1.5 times when DX format is selected). Lens is interchangeable. Effective pixels is 12.1 million, total pixels is 12.87 million. Features a complementary metal oxide semiconductor (CMOS) 36.0 x 23.9 mm sensor. Can output in NEF, TIFF and JPEG."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1937";
        skos:note              "accepted"@en;
        skos:prefLabel         "Nikon D700 camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02008/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0256/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1956/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1956";
        dc:date                "2023-06-16 10:14:05.0";
        dc:identifier          "SDN:L22::TOOL1956";
        pav:authoredOn         "2023-06-16 10:14:05.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1956/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Axis Q6045";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "An indoor pan-tilt zoom network camera designed for wide area coverage and detailed surveillance at great distances, such as at airports, train stations, arenas, shopping malls and warehouses. It produces HDTV 1080p video using a progressive scan CMOS image sensor, with day/night functionality, autofocus and pan/tilt capacity. AXIS Q6045 comes with built-in video analytics such as motion detection, highlight compensation, object removal, fence detector, object counter, enter/exit detection, autotracking and Active Gatekeeper. It is encased in IP52-rated aluminium casing with an acrylic clear dome. It uses Power over Ethernet (PoE) and local memory storage. Two models available as either a 50 Hz or 60 Hz. Image sensor size is 1/3 inches, minimum colour lux 0.6, minimum b/w lux 0.04. Maximum video resolution 1920x1080 at 25/30 frames per second (50/60 Hz). Lens focal length 4.45 - 89 mm with horizontal view between 62.98 - 3.49 deg, 20x optical zoom and 12x digital zoom. This instrument is no longer in production."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1956";
        skos:note              "accepted"@en;
        skos:prefLabel         "Axis Communications Q6045 (PTZ dome) network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01991/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0244/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1975/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1975";
        dc:date                "2023-07-16 00:12:09.0";
        dc:identifier          "SDN:L22::TOOL1975";
        pav:authoredOn         "2023-07-16 00:12:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1975/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SubC Dragonfish";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A high definition (HD) 5-megapixel (MP) underwater camera which provides live video at 12 frames-per-second and HDTV at 1080p at full framerate. Transmission is over four-wire Ethernet with dynamic text and image overlay. Digital pan-tilt-zoom enables live zoom in on the 5 MP image feed. The Dragonfish can store all media to Network Attached Storage (NAS) or an internal 128 GB drive. The camera is fully configurable with options for frame, bitrate and resolution (0.3 - 5 MP) to maximise available bandwidth. The camera is compatible with LED or lasers. Resolution is 2560 x 1920 to 160 x 90, framerate is up to 30/25 fps (60/50 Hz), sensitivity is colour-0.5 or mono-0.08 Lux. Maximum image capture is 30 images per second. Viewing angle in water is 65 degrees, depth rating is up to 6500 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1975";
        skos:note              "accepted"@en;
        skos:prefLabel         "SubC Imaging Dragonfish camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0259/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02010/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1753/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1753";
        dc:date                "2021-12-01 16:25:55.0";
        dc:identifier          "SDN:L22::TOOL1753";
        pav:authoredOn         "2021-12-01 16:25:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1753/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "IIS Psychro-Dyne Celsius psychrometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A portable instrument designed to measure air temperature, relative humidity (RH) and dew point by the wet and dry bulb method. Users wet the wick on the wet bulb, turn the instrument on, and allow the constant aspiration rate to cause the depression in wet bulb temperature. Users then subtract wet bulb reading from dry bulb reading, and use the included slide rule and tables to calculate RH. It uses 3 D cell batteries as a power source which can produce 1000 readings. Steady aspiration allows readings in 1 to 2 minutes. It has greater than 1 percent accuracy for RH and greater than 0.25 percent accuracy on the thermometers temperature determination. It measures from -10 to +60 degC for RH and dewpoint, and from -15 to +45 degC for temperature."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1753";
        skos:note              "accepted"@en;
        skos:prefLabel         "Industrial Instruments and Supplies Psychro-Dyne Celsius Black Organic psychrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01857/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0195/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0105/>
