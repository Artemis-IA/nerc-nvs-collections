        skos:definition        "Construction comprises a 130 cm diameter mouth opening with 450 cm long net. There were a series of variants MCA-MCE."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0090";
        skos:note              "accepted"@en;
