        skos:altLabel          "manual corer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/51/>;
        skos:definition        "A hand-held sediment corer. Consists of a tube that is inserted into the sediment manually by a human operator (e.g. through manual force, hammering, rotating etc.)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1376";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified manual sediment corer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0001/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2003/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2003";
        dc:date                "2024-01-26 15:50:28.0";
        dc:identifier          "SDN:L22::TOOL2003";
        pav:authoredOn         "2024-01-26 15:50:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2003/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Eijkelkamp Edelman auger";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/51/>;
        skos:definition        "The Edelman auger a conical instrument for obtaining sediment samples. The auger comprises two blades joined in a cone. The top of the blades is welded to a bracket, which is connected to the auger rod. The blades are vaulted and when entering the soil the sample is dug up and evenly guided into the inside of the auger body. The vaulting of the blades promotes digging up and also ensures a firm grip of the sample while permitting easy emptying of the auger body. The diagonal diameter of the auger between the blades at the broadest part of the auger body is 10 cm. The blades measure 5.5 cm. Typically used for coheisve or moderately cohesive soils."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2003";
        skos:note              "accepted"@en;
        skos:prefLabel         "Eijkelkamp 04.09 Edelman auger sediment corer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0270/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02027/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2047/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2047";
        dc:date                "2024-06-07 10:18:07.0";
        dc:identifier          "SDN:L22::TOOL2047";
        pav:authoredOn         "2024-06-07 10:18:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2047/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NIOZ custom trigger corer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/51/>;
        skos:definition        "A custom sediment corer system designed and manufacturered for the British Antarctic Survey in 2014 by P. Smit BV, NIOZ (Royal Netherlands Institute for Sea Research). It consists of both a gravity corer and piston corer. The gravity (trigger) corer consists of a core bomb fitted with a 0.75 m length steel core barrel lined with a 63 mm diameter PVC liner. It is lowered on a wire to the seabed and the core barrel penetrates the seabed under its own weight. The release of the associated piston corer is subsequently triggered when the gravity (trigger) corer makes contact with the seabed."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2047";
        skos:note              "accepted"@en;
        skos:prefLabel         "NIOZ custom trigger corer system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00239/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0286/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1177/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1177";
        dc:date                "2017-11-23 13:03:21.0";
        dc:identifier          "SDN:L22::TOOL1177";
        pav:authoredOn         "2017-11-23 13:03:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1177/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "UnSpec Box";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/51/>;
        skos:definition        "A marine geological tool that recovers undisturbed soft surface sediments. It is designed for minimum disturbance of the sediment surface by bow wave effects. Traditionally, it consists of a weighted stem fitted to a square sampling box. The corer is lowered vertically until it impacts with the seabed. At this point the instrument is triggered by a trip as the main coring stem passes through its frame. While pulling the corer out of the sediment a spade swings underneath the sample to prevent loss. When hauled back on board, the spade is under the box."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1177";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified box corer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1173/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1173";
        dc:date                "2017-11-23 13:03:21.0";
        dc:identifier          "SDN:L22::TOOL1173";
        pav:authoredOn         "2017-11-23 13:03:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1173/1/>;
        pav:version            "1";
