        skos:altLabel          "Plessey 4310";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/185/>;
        skos:definition        "The Plessey 4310 is a sound velocity profiling instrument used to measure the speed of sound in water. Plessey was bought by Grundy in 1980, so the Plessey 4310 could also be referred to as a Grundy 4310."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
