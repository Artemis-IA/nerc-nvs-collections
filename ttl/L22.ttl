        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/156/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "The EA600 single beam echosounder operates up to four high power transceivers simultaneously. Available frequencies span from 12 to 710 kHz with a variable power output of up to 2 kW and a 160 dB dynamic range. The EA600 replaced the EA500 in 2000."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0319";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg Simrad EA600 echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0889/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0889";
        dc:date                "2015-06-18 14:42:56.0";
        dc:identifier          "SDN:L22::TOOL0889";
