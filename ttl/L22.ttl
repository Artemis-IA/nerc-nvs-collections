<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1606/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1606";
        dc:date                "2021-02-03 09:56:26.0";
        dc:identifier          "SDN:L22::TOOL1606";
        pav:authoredOn         "2021-02-03 09:56:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1606/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MX Marine MX421";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS04/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "A series of GPS sensors that may be configured to use differential corrections (DGPS). They are designed for the marine environment. The sensors determine position using the US Navstar satellite system. Differential corrections (RTCM) may be applied using an internal beacon receiver (MX421B-10) or via an external receiver and control and display unit (MX421-10). The GPS receiver uses 12 channels for tracking of L1 C/A signals (1.575 GHz Frequency) and a position update rate of 1 Hz. The differential beacon (MX421B-10) uses 2 channels for tracking (283.5 to 325 kHz). MX 421B-10 can be optionally upgraded to output 5Hz position update. Horizontal Accuracy: <1 m RMS (DGPS) <3m RMS (GPS no S/A)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1606";
        skos:note              "accepted"@en;
        skos:prefLabel         "Navico Simrad MX421 {MX Marine MX421} GPS series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0122/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00900/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0802/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0802";
        dc:date                "2014-09-18 15:18:31.0";
        dc:identifier          "SDN:L22::TOOL0802";
        pav:authoredOn         "2014-09-18 15:18:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0802/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Furuno GP90 and GP90D GPS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS04/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "The Furuno GP-90 is a 12-parallel channel, all-in-view GPS receiver designed for SOLAS ships. It has a 6 inch monochrome LCD display. It is equipped with WAAS (Wide Area Augmentation System). The GP-90 is a DGPS-ready receiver that can be linked with an external differential beacon receiver. The GP-90D has a built-in DGPS receiver. Accuracy is GPS: 10 m approx. (95 % of the time SA off), DGPS: approx. 5 m (95% of the time), WAAS: 3 m (95% of the time)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0802";
        skos:note              "accepted"@en;
        skos:prefLabel         "Furuno Navigator GP90 and GP90D Global Positioning System receivers"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00571/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0078/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0078";
        dc:date                "2010-09-08 11:18:07.0";
        dc:identifier          "SDN:L22::TOOL0078";
        pav:authoredOn         "2010-09-08 11:18:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0078/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GPS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "A location system of unspecified make or model that determines location on the Earth's surface using the Global Positioning Satellite Network. Angular co-ordinates are given relative to WGS84 CRS. Other parameters such as platform velocity may be derived from this."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0078";
        skos:note              "accepted"@en;
        skos:prefLabel         "Global Positioning Satellite System"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/P01/current/ALATGP01/> , <http://vocab.nerc.ac.uk/collection/P01/current/ALONGP01/> , <http://vocab.nerc.ac.uk/collection/P01/current/APEWGP01/> , <http://vocab.nerc.ac.uk/collection/P01/current/APNSGP01/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1620/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1620";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL1620";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1620/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1620/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Kongsberg Simrad HS50";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS03/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS04/>;
        skos:definition        "A compass that determines heading using two separate GPS sensors. For use on boats. The sensor unit contains two, 12-channel GPS sensors, electronic board with I/O and an inertial rate element. Heading is derived from the fixed-distance dual GPS antenna arrangement. GPS position and speed are calculated from both antennas. The inertial rate element provides yaw/ROT information. DGPS signals may be input to the HS50 to improve position and velocity accuracy (RTCM, SAPOS). Heading accuracy: 0.3 degrees RMS (static), 0.5 degrees RMS (dynamic). ROT accuracy: 0.5 deg/s + 5 %. Position accuracy: 5 m 95 % CEP. Velocity accuracy: 0.1 m/s 95 % CEP."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1620";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg Simrad HS50 GPS gyrocompass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0154/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0390/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0390";
        dc:date                "2022-03-18 14:28:15.0";
        dc:identifier          "SDN:L22::TOOL0390";
        pav:authoredOn         "2022-03-18 14:28:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0390/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0390/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Ashtech ADU2 GPS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "A GPS receiver providing three-dimensional position, velocity and attitude information at a rate of up to 2 Hz. The ADU2 uses four antennas and a 48-channel receiver for Position Dilution of Precision (PDOP)-based satellite tracking. Real-time horizontal position accuracy is ≥ 5 m in autonomous mode and ≥ 1 m in differential mode."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0390";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ashtech ADU2 Global Positioning System receiver"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/ALATGP01/> , <http://vocab.nerc.ac.uk/collection/P01/current/ALONGP01/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00522/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0457/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0457";
        dc:date                "2012-02-07 12:32:54.0";
        dc:identifier          "SDN:L22::TOOL0457";
        pav:authoredOn         "2012-02-07 12:32:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0457/1/>;
        pav:version            "1";
