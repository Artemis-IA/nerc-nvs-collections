<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2208/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2208";
        dc:date                "2025-08-21 15:23:32.0";
        dc:identifier          "SDN:L22::TOOL2208";
        pav:authoredOn         "2025-08-21 15:23:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2208/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Thies Clima 4.383x";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A series of ultrasonic anemometers designed to measure horizontal and vertical components of wind velocity, wind direction, and acoustic virtual temperature. This instrument series measures the propagation of sound, as this velocity is superposed by the velocity component of an air flow. The propagation velocity resulting from superposition leads to different propagation times of sound at different wind velocities and directions. It consists of six ultrasonic transformers which function both as acoustic transmitters and receivers, in pairs facing each other, resulting in three measurement paths which are vertical in relation to each other. Virtual temperature is determined via measurement of sound propagation, the thermodynamic interrelationship between the propagation velocity of sound and the absolute temperature of air is defined by a root function. The influence of temperature on the measurement result is ruled out as the propagation time of sound is measured on each of the three measurement paths in both directions. The ultrasonic measurement principle this instrument series uses allows for the inertia-free measurement of running variable dimensions with high precision and accuracy. Cold Climate models are available with heated housing, for use in sites where frequent icing may be expected. Wind speed - Measuring range: 0 - 85 m/s; Resolution: 0.1 m/s (standard), 0.01 m/s (user defined); Accuracy: +/- 0.1 m/s + 1 percent rms (0 - 35 m/s), +/- 2 percent rms (35 - 65 m/s), +/- 3 percent rms (65 - 85 m/s). Wind direction - Measuring range: 0 - 360,540,720 degrees; Resolution: 1 degree (standard), < 1 degree (user defined); Accuracy: +/- 1 degree (1 - 35 m/s), +/- 2 degrees (35 - 65 m/s), +/- 4 degrees (65 - 85 m/s). Virtual temperature - Measuring range: -50 - 80 degrees Celsius; Resolution: 0.1 Kelvin; Accuracy: +/- 0.5 Kelvin."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2208";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thies Clima 4.383x Ultrasonic Anemometer 3D series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0234/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01990/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1031/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1031";
        dc:date                "2016-10-24 14:25:31.0";
        dc:identifier          "SDN:L22::TOOL1031";
        pav:authoredOn         "2016-10-24 14:25:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1031/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Airmar 150WX";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "Airmar Ultrasonic WeatherStation 150WX is a compact meteorological station designed to provide real-time, site-specific weather information on moving platforms. The instrument combines up to seven sensors to measure apparent and true wind speed and direction, barometric pressure, air temperature, relative humidity, dew point and wind chill temperature. Ultrasonic readings of true and apparent wind speed and direction are taken for wind speeds up to 40 m/s. This model includes: optional heater and upper ring; field-serviceable relative humidity calculated dew point and heat index; a 10 Hz GPS; a two-axis solid-state compass; a three-axis accelerometer. Output options include RS422/CAN BUS and RS232/CAN BUS."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1031";
        skos:note              "accepted"@en;
        skos:prefLabel         "Airmar Ultrasonic WeatherStation 150WX"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01046/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1519/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1519";
        dc:date                "2024-08-19 14:03:59.0";
        dc:identifier          "SDN:L22::TOOL1519";
        pav:authoredOn         "2024-08-19 14:03:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1519/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1519/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Young 85106";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A 2-axis, no-moving-parts wind sensor with special features for use in the marine environment. As supplied, the sensor is set up to deliver NMEA serial output, compatible with many marine devices. Other serial outputs are also available including ASCII text, RMYT (for Young displays) and SDI-12. Analog voltage outputs are also available from the standard sensor. The sensor features durable, corrosion-resistant construction with opposing pairs of ultrasonic transducers secured in a streamlined moulded frame. Accessory bird spikes discourage perching on the anemometer frame. The sensor installs on readily available 1 inch (IPS) pipe. Wiring connections are made in a convenient weatherproof junction box; special mounting adapters, connectors and cables are not required. Operating Temperature: -50 to 50 degC. Wind Speed; Range: 0 to 70 m/s (0 to 156 mph), Resolution: 0.1 m/s, Accuracy: (30 m/s) +/- 2 % or 0.1 m/s, (70 m/s) +/- 3 %. Wind Direction; Range: 0 to 360 degrees, Resolution: 1 degree, Accuracy: +/- 2 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1519";
        skos:note              "accepted"@en;
        skos:prefLabel         "R.M. Young 85106 ultrasonic anemometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00402/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0037/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1030/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1030";
        dc:date                "2016-10-24 14:25:31.0";
