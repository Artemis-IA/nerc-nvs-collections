        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0001/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1373/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1373";
        dc:date                "2019-12-10 10:47:35.0";
        dc:identifier          "SDN:L22::TOOL1373";
