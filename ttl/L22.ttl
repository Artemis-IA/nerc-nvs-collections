        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1820/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sercel NR103";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS04/>;
        skos:definition        "A 10-channel Differential Global Positioning System (DGPS) in use from the early 1990s, for use in hydrographic and oceanographic vessel positioning. It receives L1 C/A (1575 MHz) frequencies and has an accuracy of 3-5 metres."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1820";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sercel NR103 Differential Global Positioning System"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01805/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0176/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0082/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0082";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0082";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0082/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "LHPR";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/> , <http://vocab.nerc.ac.uk/collection/L05/current/21/>;
        skos:definition        "A 50 cm diameter net mounted in a towing frame. Attached to the cod end of the net was a plankton recorder box with two rolls of gauze that were spooled onto a single spool after cutting across a tunnel through which water and plankton flowed out of the back of the net. The take-up spool with the plankton sandwiched between the two strips of gauze was advanced in discrete steps (15 seconds to 60 seconds) by an electronics package on the tow frame. Data on pressure and temperature and flow counts were logged on an internal recorder in the pressure case.  Normally towed at 1.5 to 2.5 knots and collected ~ 100 samples [Wiebe and Benfield 2003 Plate 26 C]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0082";
        skos:note              "accepted"@en;
        skos:prefLabel         "Longhurst-Hardy Plankton recorder - Longhurst et al (1966)"@en .

