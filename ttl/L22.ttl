        skos:definition        "Has a 45 cm mouth diameter with a conical net length of 180 cm (mesh 0.33 mm - GG54) [Wiebe and Benfield 2003 Plate 1 F]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0122";
        skos:note              "accepted"@en;
