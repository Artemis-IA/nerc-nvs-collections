<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1506/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1506";
        dc:date                "2020-07-31 11:51:39.0";
        dc:identifier          "SDN:L22::TOOL1506";
        pav:authoredOn         "2020-07-31 11:51:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1506/1/>;
        pav:version            "1";
