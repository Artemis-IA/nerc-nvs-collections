        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/156/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "The Knudsen Chirp 3260 is a deep water system capable of reaching depths up to 10,000m plus. This instrument is available in a 2 or 4 channel configuration with frequencies ranging from 3.5kHz to 210kHz. The Chirp 3260 is designed for full ocean depth requirements where high power output is required"@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0890";
