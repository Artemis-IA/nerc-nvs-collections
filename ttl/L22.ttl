<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0402/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0402";
        dc:date                "2023-02-07 17:08:03.0";
        dc:identifier          "SDN:L22::TOOL0402";
        pav:authoredOn         "2023-02-07 17:08:03.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0402/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0402/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0402/2/>;
