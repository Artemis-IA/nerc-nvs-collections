<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1475/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1475";
        dc:date                "2020-06-02 15:19:19.0";
        dc:identifier          "SDN:L22::TOOL1475";
        pav:authoredOn         "2020-06-02 15:19:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1475/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Star-Oddi Starmon-TD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "A small submersible temperature and depth data logger designed for ocean (titanium housing) or freshwater (aluminium housing) research. Depth range is 50 m - 500 m (aluminium) and 50 m - 2000 m (titanium). Temperature resolution is 0.002C, with an accuracy of +/-0.025C over a range -2C to 40C. Depth resolution is 0.005% of selected range, with an accuracy of +/-0.3% of selected range for 50 m to 2000 m range."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1475";
        skos:note              "accepted"@en;
        skos:prefLabel         "Star-Oddi Starmon TD temperature depth logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00395/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0088/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2181/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2181";
        dc:date                "2025-07-02 11:32:21.0";
        dc:identifier          "SDN:L22::TOOL2181";
        pav:authoredOn         "2025-07-02 11:32:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2181/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kistler 4260A";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "A piezoresistive pressure sensor suitable for use in harsh test environments with high levels of temperature and vibration, and the presence of shock levels. The 4260A outputs electrical signals in millivolts, volts, or milliamps. This instrument uses a silicon sensing element, mounted within a high-integrity seal assembly isolated from the pressure media, which produces an electrical charge proportional to the pressure applied. Surface mount electronics condition the output from the silicon sensing element and provide temperature compensation. Additional electronic circuit boards can be added to configure the electrical output to suit a variety of data acquisition systems. The pressure sensing assembly features a unique sealing method which enables the sensor to withstand multiple cycles without fatigue. Pressure range 15 to 5000 psi; operating temperature: -65 to 250 degrees Fahrenheit (mV or V), -65 to 175 degrees Fahrenheit (mA)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2181";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kistler 4260A Piezoresistive absolute pressure transmitter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0142/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01766/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0852/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0852";
        dc:date                "2015-05-21 15:32:27.0";
        dc:identifier          "SDN:L22::TOOL0852";
        pav:authoredOn         "2015-05-21 15:32:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0852/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kistler 603B";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/WPS/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A miniature quartz piezoelectric pressure sensor with acceleration compensation, capable of measuring high frequency pressure. The pressure range is from vacuum to 200 bar (2900 PSIA) at temperatures up to 200 C. The natural frequency is beyond 300 kHz. The measured pressure acts through the diaphragm on the quartz crystal measuring element, which transforms the pressure into an electrostatic charge. The stainless steel diaphragm is hermetically welded flush to the stainless ssteel sensor body. As the ceramic insulator of the connector is also hermetically welded the entire sensor is hermetically sealed. The quartz disks are assembled together with a seismic mass in a way to compensate for the acceleration sensitivity. Further information may be found at http://www.kistler.com/us/en/products/components/pressure-sensors/."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0852";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kistler 603B pressure sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01766/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1010/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1010";
        dc:date                "2016-07-15 13:23:34.0";
        dc:identifier          "SDN:L22::TOOL1010";
        pav:authoredOn         "2016-07-15 13:23:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1010/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Nortek Signature500 ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "An Acoustic Doppler Current Profiler (ADCP) for use in turbulence studies. It consists of five acoustic transducers, four slanted at 25 degrees from vertical, and a fifth vertical beam. All beams operate at the same frequency of 500 kHz. The instrument has integrated pressure and temperature sensors."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1010";
        skos:note              "accepted"@en;
        skos:prefLabel         "Nortek Signature500 Acoustic Doppler Current Profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00333/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0977/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0977";
        dc:date                "2016-03-31 11:32:55.0";
        dc:identifier          "SDN:L22::TOOL0977";
        pav:authoredOn         "2016-03-31 11:32:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0977/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
