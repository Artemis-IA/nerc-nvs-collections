<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1790/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1790";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL1790";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1790/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1790/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Kongsberg HiPAP 502 USBL";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS26/>;
        skos:definition        "A high accuracy omnidirectional acoustic positioning system with an operating range of 1 - 5000 metres. The HiPAP 502 makes use of a spherical transducer containing an array of 241 computer controlled elements for accurate underwater positioning of submerged structures or underwater vehicles deployed with transponders. The spherical transducer enables an operating area of 200 degrees, and allows the system to form narrow listening beams of 10 degrees for reception of signals from the transponder. Beams can be pointed in any direction below the vessel, including horizontally and upwards toward the surface. The instrument operates in a frequency band of 21 - 31 kHz and has a range detection accuracy of 0.02 metres."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1790";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg HiPAP 502 Ultra Short BaseLine acoustic positioning system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0979/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0979";
        dc:date                "2016-04-04 14:47:13.0";
        dc:identifier          "SDN:L22::TOOL0979";
