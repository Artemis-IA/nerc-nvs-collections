<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2207/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2207";
        dc:date                "2025-08-19 10:12:07.0";
        dc:identifier          "SDN:L22::TOOL2207";
        pav:authoredOn         "2025-08-19 10:12:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2207/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2207/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2207/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "DGSI VW piezometer series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/360/>;
        skos:definition        "A series of pluck-type vibrating wire (VW) piezometers manufactured by Durham Geo Slope Indicator (DGSI) for in-situ pore water pressure measurements. Seven versions of the VW piezometer are available - all of which have the same instrument specifications but vary in size, weight, and material making them suited to different applications. The seven variations are: standard, corrosion-resistant, heavy-duty, low-pressure, push-in, vented, and multi-level and are available in varying standard pressure ranges from 0.7 bar (for the low-pressure model) to 35 bar (for the standard, push-in, and heavy-duty models) as well as custom pressure ranges. The instruments operate at a resolution of 0.025 % FS, an accuracy of +/- 0.1 % FS for 0.7 - 7 bar sensors and +/- 0.3 % FS for 17 - 35 bar sensors, and a temperature coefficient of < 0.04 % FS / degC. Signal cables for the instruments also come in standard and armoured versions with varying lengths. Readings are stored on the data logger in Hz."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2207";
        skos:note              "accepted"@en;
        skos:prefLabel         "Durham Geo Slope Indicator VW piezometer series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02125/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0355/> .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0045/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0045";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0045";
        pav:authoredOn         "2011-10-21 14:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0045/1/>;
