<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1834/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1834";
        dc:date                "2022-08-12 17:01:37.0";
        dc:identifier          "SDN:L22::TOOL1834";
        pav:authoredOn         "2022-08-12 17:01:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1834/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "FT702LT-V22 anemometer series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/101/>;
        skos:definition        "A series of ultrasonic anemometers designed to measure wind speed and direction in a wide range of environments. The instrument outputs wind speeds in m/s and direction in degrees by using Acoustic Resonance Technology. Three transducers transmit an ultrasonic signal and measure the signal's phase changes. The sensor adjusts the signal frequency to compensate for changes in the air's temperature, pressure or humidity. The instrument is a solid-state device suitable for marine environments as it is made up of a hard, anodised alloy body, three heaters, and surge protection electronics. Instruments in the series include the FT702LT-V22-FF, FT702LT-V22-PM, FT702LT/D-V22-FF, FT702LT/D-V22-PM. Where LT, has a digital display, LT/D, has an analogue display, FF is a Flat Front, to be installed on a bar, and PM is for a Pipe Mount. Wind speed range is 0-50 m/s with 0.1 m/s resolution. Wind direction range is 0-360 deg. with 1 deg. resolution. The instrument has no data logging capacity and requires a power source. It works in temperatures between -40 and 85 deg. C and up to 4000 m altitude."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1834";
        skos:note              "accepted"@en;
        skos:prefLabel         "FT Technologies FT702LT-V22 anemometer series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0221/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01980/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1853/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1853";
        dc:date                "2022-10-10 14:39:24.0";
        dc:identifier          "SDN:L22::TOOL1853";
        pav:authoredOn         "2022-10-10 14:39:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1853/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Unspecified Dredge";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/60/>;
        skos:definition        "A type of sampler designed for collecting a sample of bottom substrate, usually by towing it through the substrate. It can be suitable for mud, sand, shell, and gravel substrates. Samples can be used to study benthic macroinvertebrates and algae as well as the chemistry and structure of the sediments themselves."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1853";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified Dredge"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0001/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1872/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1872";
        dc:date                "2022-11-01 13:43:27.0";
        dc:identifier          "SDN:L22::TOOL1872";
        pav:authoredOn         "2022-11-01 13:43:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1872/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "TF temperature sensor 2015.0000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A temperature sensor designed for use in various meteorological packages. It is equipped with an encased hard glass platinum resistance Pt-100 sensor. It is mainly used as a spare sensor for the Theodor Friedrichs 2010, 2012, 2014, 2017 and 3010 sensors. The sensor is delivered with plastic shaft, screw cap and 5 m measuring cable. Measuring resistance: Pt-100 according to DIN 60751 B. Nominal resistance: 100 ohm at 0 degC. Response time in air: (T 0.5) 23 s, (T 0.9) 80 s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1872";
        skos:note              "accepted"@en;
        skos:prefLabel         "Theodor Friedrichs 2015.0000 temperature sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0239/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01221/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1891/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1891";
        dc:date                "2023-01-03 16:53:32.0";
        dc:identifier          "SDN:L22::TOOL1891";
        pav:authoredOn         "2023-01-03 16:53:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1891/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Axis M3068-P";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A 12-megapixel mini dome camera with 360 degree panoramic view. It has forensic Wide Dynamic Range (WDR) and day/night functionality. It's resolution depends on the mode selected and can be: Overview: 2880x2880 to 160x160 (1:1); Panorama: 3840x2160 to 192x72 (8:3, 16:9 or 32:9); Double panorama: 3584x2688 to 384x288 (4:3 or 16:9); Quad view: 3584x2688 to 384x288 (4:3 or 16:9); View area 1-4: 2048x1536 to 256x144 (4:3 or 16:9); Corner left/right: 3200x1600 to 192x72 (2:1 or 8:3); Double corner: 2880x2880 to 384x288 (1:1 or 4:3); Corridor: 2560x1920 to 256x144 (4:3 or 16:9). It's frame rate in 360 degree overview up to 2880x2880 without WDR is 25/30 frames per second at 50/60 Hz, or in 360 degree overview and 4 de-warped views with WDR is up to 12.5/15 frames per second at 50/60 Hz."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1891";
        skos:note              "accepted"@en;
        skos:prefLabel         "Axis Communications M3068-P (mini dome) network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01991/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0244/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0243/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0243";
        dc:date                "2010-11-18 12:39:41.0";
        dc:identifier          "SDN:L22::TOOL0243";
        pav:authoredOn         "2010-11-18 12:39:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0243/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0243/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Spekker colorimeter";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB03/>;
        skos:definition        "A photoelectric absorbsiometer developed in 1936 and manufactered by Adam Hilger Ltd, London. A light source with a photocell on each side provides a basic means of operation. The instrument is set up with a solution to be measured in the sample light beam and then balance the EMF of the photocells to zero on a galvanometer. It can be used to measure nutrient concentrations in seawater."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0243";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hilger Spekker colorimeter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2233/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2233";
        dc:date                "2025-10-31 14:37:02.0";
        dc:identifier          "SDN:L22::TOOL2233";
        pav:authoredOn         "2025-10-31 14:37:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2233/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "C-FLUOR CDOM/FDOM fluorometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "A compact, factory-calibrated, single wavelength in-situ fluorescence sensor with low power consumption, suitable for long term real-time monitoring deployments. This instrument uses a 325/120 nm excitation filter and 470/60 nm emission filter to measure coloured dissolved organic matter (CDOM)/ Fluorescent dissolved organic matter (FDOM). Analogue and digital output options available. 2000 m depth rating. Ambient temperature range: 0 to 50 degrees C; water temperature range: -2 to 50 degrees C."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2233";
        skos:note              "accepted"@en;
        skos:prefLabel         "Turner Designs C-FLUOR 2120-000-U fluorometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00400/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0080/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1904/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1904";
        dc:date                "2023-03-08 12:44:46.0";
        dc:identifier          "SDN:L22::TOOL1904";
        pav:authoredOn         "2023-03-08 12:44:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1904/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "WET Labs ECO FLBBPC";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "A variant of the ECO Puck Triplet (http://vocab.nerc.ac.uk/collection/L22/current/TOOL0673/). It is a three-optical-sensor, user-defined instrument that carries 2 fluorometers and a scattering meter. ECO Pucks are real‐time only sensors as they are integrated onto the OEM platform that provides power and data handling. This instrument is designed to be integrated with autonomous platforms, (e.g. an Alseamar Seaexplorer glider) and data are transmitted in real time. This variant is configured to measure optical scattering over 124 degrees at a single wavelength from 470, 532 or 650 nm, phycocyanin, and one of chl-a, CDOM, phycoerythrin, uranine or rhodamine. Standard depth rating is 600 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1904";
        skos:note              "accepted"@en;
        skos:prefLabel         "WET Labs {Sea-Bird WETLabs} ECO Puck Triplet FLBBPC scattering fluorescence sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0026/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2234/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2234";
        dc:date                "2025-10-31 14:37:02.0";
        dc:identifier          "SDN:L22::TOOL2234";
        pav:authoredOn         "2025-10-31 14:37:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2234/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "C-FLUOR chlorophyll (blue excitation) fluorometer";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "A compact, factory-calibrated, single wavelength in-situ fluorescence sensor with low power consumption, suitable for long term real-time monitoring deployments. This instrument uses a 470/60 nm excitation filter and 696/44 nm emission filter to measure chlorophyll in vivo (blue excitation). Analogue and digital output options available. 2000 m depth rating. Ambient temperature range: 0 to 50 degrees C; water temperature range: -2 to 50 degrees C."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2234";
        skos:note              "accepted"@en;
        skos:prefLabel         "Turner Designs C-FLUOR 2120-000-C fluorometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00400/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0080/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2284/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2284";
        dc:date                "2026-03-31 17:11:56.0";
        dc:identifier          "SDN:L22::TOOL2284";
        pav:authoredOn         "2026-03-31 17:11:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2284/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2284/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "TriOS nanoFlu";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "The TriOS nanoFlu fluorometer is a submersible, miniature fluorometer that can be configured to make precise and selective measurements of CDOM (Coloured Dissolved Organic Matter), chlorophyll a, phycocyanin in cyanobacteria, and rhodamine or fluorescein dependent on the LED excitation wavelength. The instrument can be used in commercial and research applications for monitoring seawater, river water, drinking water, or waste water. An environmentally neutral coating on the instrument's optical windows prevents biofouling and the sensor can be housed in stainless steel, titanium, or POM (Polyoxymethylene). Dependent on the parameter being detected, the sensor operates at measurement ranges of 0 to 200 ug/L or 0 to 500 ug/L and an accuracy of +/- 5%. Operating temperature ranges from 2 to 40 degC and measurements are taken at 3 second intervals, with a 6 second response time. With either a SubConn (pressure rated to 30 bar) or fixed cable connection (pressure rated to 3 bar) the nanoFlu can be configured with 3 different serial interfaces: ethernet, RS-232, or RS-485."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2284";
        skos:note              "accepted"@en;
        skos:prefLabel         "TriOS nanoFlu fluorometer series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00579/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0212/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0187/>
        rdf:type               skos:Concept;
