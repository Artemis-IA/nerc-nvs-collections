        skos:definition        "The WindObserver II is a solid state ultrasonic anemometer, with a stainless steel housing suitable for marine and offshore applications. It measures wind speed and direction over ranges of 0 - 65 m/s and 0 - 359 degrees respectively."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0704";
        skos:note              "accepted"@en;
        skos:prefLabel         "Gill Instruments WindObserver II anemometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00326/> .

