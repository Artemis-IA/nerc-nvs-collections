<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0865/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0865";
        dc:date                "2015-05-27 15:47:59.0";
        dc:identifier          "SDN:L22::TOOL0865";
