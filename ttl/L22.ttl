        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0038/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Paquette enlarged Clarke-Bumpus Sampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "Construction is a 25.4 cm diameter mouth opening with cylindrical tube 12.7 cm long. The tube is equipped with flat plate which pivots to open or close the flow through the tube and a TSK flowmeter. A 107 cm long conical net is attached to the rear of the tube. (No mesh size given)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0038";
        skos:note              "accepted"@en;
        skos:prefLabel         "Enlarged Clarke-Bumpus sampler - Paquette et al. (1961)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0057/>
