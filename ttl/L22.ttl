<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2259/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2259";
        dc:date                "2026-02-04 15:59:14.0";
        dc:identifier          "SDN:L22::TOOL2259";
        pav:authoredOn         "2026-02-04 15:59:14.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2259/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Apollo SciTech AS-C5";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/86/>;
        skos:definition        "A Dissolved Inorganic Carbon (DIC) analyser, for total dissolved inorganic carbon analysis in a variety of aquatic conditions such as in river and lake waters, coastal and open ocean waters, sediment porewater, and groundwater. The system can work in both land and shipboard laboratories. The AS-C5 DIC analyser is comprised of a solid state infrared CO2 detector (LI-850, by LI-COR, USA), a digital syringe pump for precise delivery of reagent and sample solutions (Kloehn, USA), a mass flow controller to accurately regulate the carrier gas flow rate, a specifically designed CO2 stripping reactor that allows for an efficient and smooth stripping of CO2 from the water sample, an electronic cooling system for removing moisture, and a computer communication assembly (USB to RS232 converter with a data acquisition unit; included) The analyser can handle sample volumes from 0.1 - 1.8 millilitres and takes approximately 3 minutes per analysis. The system has an analytical range of 0.2 - 20 mM and maintains a minimum precision of +/- 0.15% or +/-3 uM for seawater."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2259";
        skos:note              "accepted"@en;
        skos:prefLabel         "Apollo SciTech AS-C5 Dissolved Inorganic Carbon (DIC) analyser"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0174/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01043/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2271/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2271";
        dc:date                "2026-03-05 14:04:37.0";
        dc:identifier          "SDN:L22::TOOL2271";
        pav:authoredOn         "2026-03-05 14:04:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2271/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "DeepSea OSC-2080-IP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A 4K ultra high-definition video camera designed to fit almost any platform from medium inspection class vehicles to large manned submersibles for subsea operations. Video footage can be live streamed over an Ethernet network or captured on internal memory (up to 1 TB). Housed in 6Al-4V titanium it comes in versions depth rated to 6000 or 11,000 m. The wide angle lens offers a 78-degree horizontal field of view and can focus from 50 mm to infinity. The OSC-2080-IP has a 15.5x optical zoom, a 5.7 mm to 88.4 mm, F/2.0 to F/3.8 lens, and a 1/2.5\" CMOS progressive scan image sensor."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2271";
        skos:note              "accepted"@en;
        skos:prefLabel         "DeepSea Power and Light Optim SeaCam 2080-IP (4K Ultra HD) camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0263/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2317/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2317";
        dc:date                "2026-07-16 11:04:34.0";
        dc:identifier          "SDN:L22::TOOL2317";
        pav:authoredOn         "2026-07-16 11:04:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2317/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "P-ONE Acoustic Receiver";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "A piezo-based acoustic receiver used within the Pacific Ocean Neutrino Experiment (P‑ONE) large-volume neutrino telescope acoustic positioning system. The receiver is acoustically coupled to the glass hemisphere of a P‑ONE module and detects acoustic signals transmitted by seafloor acoustic transceivers. These measurements are used to determine the real-time positions of instrumented mooring strings and individual detector modules, enabling precise geometry reconstruction of the neutrino telescope. The receiver converts incident acoustic pressure waves into electrical signals for timing and positioning analysis and operates under deep-ocean pressure conditions as part of the long-term P‑ONE observatory infrastructure. These show absolute sensitivities of approximately -165dBreV2/μPa2 and -125dBreV2/μPa2 at the lowest and highest possible gain setting in a frequency range of 10-40 kHz. high accuracy in the tracking of relative ranging times at approximately 230-280 us at distances of up to 1600 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2317";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pacific Ocean Neutrino Explorer {P-ONE} Acoustic Receiver"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0357/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02131/> .

