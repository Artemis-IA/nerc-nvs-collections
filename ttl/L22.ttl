<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2230/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2230";
        dc:date                "2025-10-31 12:57:25.0";
        dc:identifier          "SDN:L22::TOOL2230";
