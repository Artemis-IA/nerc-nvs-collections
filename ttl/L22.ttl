<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0856/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0856";
        dc:date                "2024-08-23 16:01:31.0";
        dc:identifier          "SDN:L22::TOOL0856";
        pav:authoredOn         "2024-08-23 16:01:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0856/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0856/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "RBR Concerto";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/130/>;
        skos:definition        "Conductivity, temperature depth recorder with fluorometer and turbidity loggers. Self-contained, autonomous CTD logger that can be deployed for a period of up to 5 years with 1 minute sampling intervals. High accuracy measurements, holds measurements internally even without battery and fast sampling options for profiling. Temperature sensor calibrated to accuracy of +/- 0.002 degC over range -5 to 35 degC. Conductivity measured with inductive sensor with no exposed contacts. Pressure measured with piezo-resistive transducer with accuracy of 0.05 % of full scale rating and achievable resolution of 0.001 %."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0856";
        skos:note              "accepted"@en;
        skos:prefLabel         "RBR Concerto CTD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00299/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0875/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0875";
        dc:date                "2015-06-08 15:32:54.0";
        dc:identifier          "SDN:L22::TOOL0875";
        pav:authoredOn         "2015-06-08 15:32:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0875/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Simrad GC80 and GC85";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/>;
        skos:definition        "A gyrocompass for use in autopilot and dynamic positioning systems. The compass uses a sealed sensitive element to detect heading and contains no liquid. The GC85 and GC80 are fully IMO approved for standard and High Speed Craft (GC85). Dynamic error (x secant latitude) is less than +/- 0.4 degrees. Settle point error and static error (x secant latitude) is less than +/- 0.1 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0875";
        skos:note              "accepted"@en;
        skos:prefLabel         "Simrad GC80 and GC85 gyrocompass"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2211/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2211";
        dc:date                "2025-08-27 12:28:23.0";
        dc:identifier          "SDN:L22::TOOL2211";
        pav:authoredOn         "2025-08-27 12:28:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2211/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Thies Clima 1.1005.54";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A series of instruments designed for the measurement of temperature and air humidity. Data are output as electrical analogue signals. The transmitter consists of a capacitive humidity element and a pt100 resistance thermometer. Multiple models are available with varying temperature and humidity measuring range, accuracy, and output. Temperature - Measuring range: -30 to 70 degrees Celsius (-40 to 60 degrees Celsius for 1.1005.54.461); Accuracy: 0.1 K (1.1005.54.000), 0.2 K (1.1005.54.160; 1.1005.54.173; 1.1005.54.461; 1.1005.54.161), 0.3 K (1.1005.54.241; 1.1005.54.441). Relative humidity - Measuring range: 0 - 100 percent relative humidity; Accuracy: +/- 2 percent relative humidity (at 5 - 95 percent relative humidity and 10 - 40 degrees Celsius)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2211";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thies Clima 1.1005.54 Hygro-Thermo Transmitter compact series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0234/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01990/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0894/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0894";
