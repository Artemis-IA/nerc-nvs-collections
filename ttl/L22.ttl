        skos:altLabel          "NOC Phosphate LOC v5";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "A developmental microfluidic phosphate sensor designed for autonomous in-situ measurements. The NOC v5 phosphate Lab-On-Chip (LOC) sensor autonomously performs laboratory-style wet chemical analysis using the molybdenum blue assay. This instrument is rated to 6000 m depth."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2268";
        skos:note              "accepted"@en;
        skos:prefLabel         "National Oceanography Centre (NOC) Phosphate v5 Lab-On-Chip (LOC) sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0003/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00009/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1204/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1204";
        dc:date                "2018-01-30 16:59:47.0";
        dc:identifier          "SDN:L22::TOOL1204";
