        skos:altLabel          "AQUAlogger 520T";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A miniature (200 mm long, 32 mm diameter) self-contained data logger incorporating a thermistor temperature sensor (resolution better that 0.007 degC, accuracy 0.05 degC) in a housing designed to operate at depths down to 1000 m.  The logger may be programmed to provide a wide variety of sampling regimes, including burst recording. More information may be found in http://www.aquatecgroup.com/images/manual_guides/bg%20-%20520.pdf."@en;
