        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Guildline 8770 CTD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/130/>;
        skos:definition        "CTD with conductivity electrode mounted in pyrex glass, copper resistance element in a stainless steel tube for temperature and a pressure sensor comprising a strain gauge element in a 4-arm resistance bridge network"@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0034";
        skos:note              "accepted"@en;
        skos:prefLabel         "Guildline Model 8770 Digital CTD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00231/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0730/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0730";
        dc:date                "2014-07-09 16:23:06.0";
        dc:identifier          "SDN:L22::TOOL0730";
        pav:authoredOn         "2014-07-09 16:23:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0730/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RBR XR-620";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/130/>;
        skos:definition        "A small profiling data logger designed to monitor conductivity, temperature and depth. Conductivity (accuracy ± 0.003 mS/cm) is measured using a 3-coil closed loop feedback inductive cell for superior temperature compensation. The thermistor (Themometrics) used to record temperature (accuracy ± 0.002°C) is aged and hermetically sealed in the tip of a shock resistant solid glass rod. Pressure (accuracy 0.05% full scale) sensors use reliable semiconductor technology and 316 stainless steel housing developed for long-term stability in harsh environments. The XR-620 is a profiling version of the XR-420."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0730";
        skos:note              "accepted"@en;
        skos:prefLabel         "RBR XR-620 CTD Profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00299/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1883/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1883";
        dc:date                "2022-11-30 16:54:29.0";
        dc:identifier          "SDN:L22::TOOL1883";
        pav:authoredOn         "2022-11-30 16:54:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1883/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Valeport MIDAS CTD";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/130/>;
        skos:definition        "A conductivity, temperature, and pressure sensor designed for rapid profiling work and deployment on moorings. It measures conductivity (mS/cm), temperature (ITS90,deg C), and pressure (bar), using a high stability conductivity sensor, a fast response platinum resistance thermometer (PRT) temperature sensor, and a temperature compensated piezo-resistive pressure transducer. The sensors are all synchronised to sample at the same time. The CTD sensors are encased in titanium. The instrument can be powered by cable or battery, allowing for real-time or autonomous sampling. There are 5 sampling modes: continuous, burst, trip/profile, conditional, and delay. The instrument is also fitted with 16 MB of solid-state non-volatile FLASH memory. The CTD has a depth rating of 6000 m, however the pressure sensor ranges are 10, 50, 100, 300 or 600 bar with 0.001 % resolution and 0.01 % accuracy. The conductivity sensor has a range of 0 - 80 mS/cm, resolution of 0.002 mS/cm, and accuracy of 0.01 mS/cm. The temperature sensor range is -5 to 35 degC, with resolution 0.005 degC, and accuracy 0.01 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1883";
        skos:note              "accepted"@en;
        skos:prefLabel         "Valeport MIDAS 606 CTD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00430/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0014/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0292/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0292";
        dc:date                "2010-11-18 12:39:41.0";
        dc:identifier          "SDN:L22::TOOL0292";
        pav:authoredOn         "2010-11-18 12:39:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0292/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0292/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "ASL IPS4 ice profiler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/ICEP/>;
        skos:definition        "The ASL Environmental Sciences ISP4 is an upward looking sonar device for measuring ice keel drafts. Distance between the instrument and ice keel is measured by sonar at an operating frequency of 420 kHz with a beam width of 1.8 degrees and sampling rate of up to 2Hz. Water depth is measured by a pressure sensor and ice draft is calculated by difference. It has a depth range of 175 metres in ice or 225 metres in water and a precision of 0.05 metres."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0292";
        skos:note              "accepted"@en;
        skos:prefLabel         "ASL Environmental Sciences IPS4 Ice Profiler Sonar"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00454/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1250/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1250";
        dc:date                "2018-07-31 10:42:08.0";
        dc:identifier          "SDN:L22::TOOL1250";
        pav:authoredOn         "2018-07-31 10:42:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1250/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ASL SWIP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/ICEP/>;
        skos:definition        "An upward-looking sonar device which can be mounted on lake, river or ocean floors to measure ice draft for monitoring of ice dynamics in shallow water environments. Ice thickness is measured in real-time using an acoustic transducer, tilt sensor, high-precision pressure sensor and temperature sensor, all providing suitably high resolution for shallow water measurements. The instrument can be operated in an internal recording mode with a connection to an underwater battery pack for power, or with RS-422 serial output for real-time operation using an underwater cable which also allows for external power. The SWIP has a storage capacity up to 16 Gb, an operating frequency of either 542 kHz (standard) or 235 kHz (optional), a half-beam width of 3 degrees (standard) or 5.5 degrees (optional), a sampling rate of up to 2 Hz, and a maximum range of 20 metres. The tilt sensor has a range -20 to +20 degrees, an accuracy -0.5 to +0.5 and a precision of 0.01 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1250";
        skos:note              "accepted"@en;
        skos:prefLabel         "ASL Environmental Sciences Shallow Water Ice Profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00454/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1610/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1610";
        dc:date                "2021-02-03 09:56:26.0";
        dc:identifier          "SDN:L22::TOOL1610";
        pav:authoredOn         "2021-02-03 09:56:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1610/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Optiflux 5000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "An electromagnetic flow sensor. It is designed for use in aggressive and abraisive media. It use Faraday's law of induction to measure the flow velocity in electrically conductive fluids. It consists of a ceramic zirconium oxide flow tube with fused in-place Cermet or Platinum electrodes. The sensor is typically used in a system with an external signal converter. It is available in a sandwich (SW) or flanged (FL) version. Maximum measuring error: down to 0.3 - 0.15% of the measured value +/- 1 mm/s. Repeatability: +/- 0.1% of MV, minimum 1 mm/s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1610";
        skos:note              "accepted"@en;
        skos:prefLabel         "Krohne Optiflux 5000 flow sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01784/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0155/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1129/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1129";
        dc:date                "2026-01-29 10:41:26.0";
        dc:identifier          "SDN:L22::TOOL1129";
        pav:authoredOn         "2026-01-29 10:41:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1129/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1129/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1129/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "UoS NOC pH sensor";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/355/>;
        skos:definition        "A National Oceanography Centre custom designed sensor for shipboard autonomous seawater pH measurements, developed in collaboration with the University of Southampton. The seawater sample and thymol blue indicator solution are pumped by two syringe pumps and mixed in the flow cell in a static mixer before entering the absorption cell. The fluid distribution is controlled by four micro-inert valves. A three-wavelength LED light source transmits light through the absorption cell which is detected by a HR4000 spectrometer. The measurements are made close to in situ temperature (plus 0.2 degrees celsius) by placement of the microfluidic flow cell in the sampling chamber which has continuous access to the ship's underway seawater supply. The LED's wavelengths are 435 nm (25 nm full width half maximum (FWHM)), 596 nm (15 nm FWHM) and 750 nm (30 nm FWHM)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1129";
        skos:note              "accepted"@en;
        skos:prefLabel         "National Oceanography Centre Colorimetric Microfluidic pH sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00009/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1167/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1167";
        dc:date                "2017-11-07 16:01:10.0";
        dc:identifier          "SDN:L22::TOOL1167";
        pav:authoredOn         "2017-11-07 16:01:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1167/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NOC NO3+NO2 LOC v3.3c";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/181/>;
        skos:definition        "A developmental microfluidic sensor that can be used in freshwater, estuarine, coastal and open ocean environment. It performs colourimetric nitrate analysis using the Griess assay on a microfluidic chip. Nitrate is reduced to nitrite using a cadmium tube. Weighing 4 kg (H = 19 cm, Dia. = 15 cm), it is housed in PVC and capable of deployments to 6000 m It uses a wavelength of 525 nm and pathlengths of 91.6, 10.16 and 1.16 mm. It has a detection limit of 25 nM and measurement range of 0.05 uM - 1000 uM."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/OG_SENSORS/current/>;
        skos:notation          "SDN:L22::TOOL1167";
        skos:note              "accepted"@en;
        skos:prefLabel         "National Oceanography Centre (NOC) Nitrate and Nitrite v3.3c Lab-On-Chip (LOC) sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00009/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0818/>
        rdf:type               skos:Concept;
