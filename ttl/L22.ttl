        skos:altLabel          "PerkinElmer LAMBDA 25";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB20/>;
        skos:definition        "The Lambda spectrophotometer provides UV-Visibility (UV-Vis) capability over a spectral range of 190 - 1100 nm. Fixed bandwidth of 1 nm, does not contain a pre-monochromator and has an absorbance range of 3.2 A. Not capable of regulatory tests requiring variable bandwidths unlike LAMBDA series 35 and 45."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0946";
        skos:note              "accepted"@en;
        skos:prefLabel         "PerkinElmer Model LAMBDA series 25 spectrophotometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00578/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0984/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0984";
        dc:date                "2016-04-04 14:47:13.0";
        dc:identifier          "SDN:L22::TOOL0984";
        pav:authoredOn         "2016-04-04 14:47:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0984/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Bongo 95+200-um";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/>;
        skos:definition        "Plankton net described as University of Aberdeen 95+200 micron size-resolving Bongo net; designed with double circular (drum) mouth piece with measurements: diameter (metre)=0.30; with opening area (square metre)=0.071; with total filtering net length (metre)=2; with filtering net shape cylindrical-conical; with additional features: net collar length=0.25 m, cylinder section length=1 m, conical section length=1 m, cod-end diameter=0.080 m; with mesh size (millimetre)=0.095 and 0.200; and equipped with NO closing mechanism."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0984";
        skos:note              "accepted"@en;
