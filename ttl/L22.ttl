        skos:altLabel          "Carlo Erba 5160 HRGC";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB02/>;
        skos:definition        "A high-resolution gas chromatograph (HRGC) that separates and analyses gas mixtures in water or air. Can be installed with a cold on-column injector, fused silica capillary column, and a flame ionization detector (FID). This model is no longer in production."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
