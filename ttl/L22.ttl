        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Mar Elec 3D SRPLS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/152/> , <http://vocab.nerc.ac.uk/collection/L05/current/MPIS/>;
        skos:definition        "A dual axis mechanically scanning sonar unit with a built in hard disk drive and associated controlling computer, powered by an external battery pack but is self-contained. The sonar has an oil-filled hemi-spherical plastic \"boot\" providing protection for its acoustic transducer which operates with a narrow conical beam pattern. Typically the sonar is mounted vertically, looking down at the sea-bed, and captures a sequence of profiles of the sea-bed over a pre-programmed sector and range. The sonar gathers a single swath of data in the horizontal plane and then rotates the transducer through a pre-programmed angle around the vertical axis and repeats the process until a circular area underneath the sonar has been scanned in a sequence of radial spokes. The raw data represents the signal amplitude of the envelope of the returned echoes. A suite of sensors to measure conductivity, temperature, depth, pitch and roll are also mounted on the instrument."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0045";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marine Electronics 3D Sand Ripple Profiling Logging Sonar"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00276/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1414/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1414";
        dc:date                "2020-04-07 16:24:48.0";
        dc:identifier          "SDN:L22::TOOL1414";
        pav:authoredOn         "2020-04-07 16:24:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1414/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Grooved PVC half-pipe substrate";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/392/>;
        skos:definition        "An artificial colonisation substrate made from PVC pipe cut length-wise and engraved with lines to roughen its surface. It is used to determine the extent of colonisation and/or the diversity of settled organisms in a marine or artificial environment."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1414";
        skos:note              "accepted"@en;
        skos:prefLabel         "Custom-made grooved polyvinyl chloride half-pipe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0069/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1433/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1433";
        dc:date                "2020-05-06 08:59:45.0";
        dc:identifier          "SDN:L22::TOOL1433";
        pav:authoredOn         "2020-05-06 08:59:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1433/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Trimble NetR8 GNSS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS04/>;
        skos:definition        "A 76-channel, multiple-frequency GNSS receiver that serves as a reference station for positional corrections. It can track all GPS signals (L1/L2/L2C/L5) as well as GLONASS (L1/L2). It has 4 GB on-board memory, integrated battery providing up to 12 hours operation and has tracking and storage rates of up to 50 Hz. WAAS/EGNOS, MSAS, and L-band (OmniSTAR) Satellite Based Augmentation (SBAS) compatibility. It can also be used as a temporary base station to broadcast RTK corrections. Code phase differential GPS accuracy is +/-0.25m + 1 ppm RMS."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1433";
        skos:note              "accepted"@en;
        skos:prefLabel         "Trimble NetR8 GNSS reference station"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00357/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0077/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2218/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2218";
        dc:date                "2025-09-26 14:29:25.0";
        dc:identifier          "SDN:L22::TOOL2218";
        pav:authoredOn         "2025-09-26 14:29:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2218/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Metrohm Autolab PG101";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB35/>;
        skos:definition        "The Metrohm Autolab PG101 potentiostat/galvanostat is a computer-controlled voltammetry analyser that, when used as part of a larger electrochemical system (e.g. with a Metrohm 663 VA Stand mercury electrode), obtains information about an analyte by applying a potential and measuring the current produced in the analyte. The potentiostat operates at an applied potential range of -10 to 10 V (accuracy: +/- 0.2%; resolution: 150 uV), a maximum bandwidth of 1 MHz, and an input impedance of 100 GOhm. The instrument can supply and measure currents of up to 100 mA with a +/- 0.2% accuracy and a resolution of up to 0.015%. All operations for the Metrohm Autolab PG101 are conducted with NOVA software."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2218";
        skos:note              "accepted"@en;
        skos:prefLabel         "Metrohm Autolab PG101 potentiostat"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0043/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00620/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1471/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1471";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL1471";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1471/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1471/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Kongsberg EA400";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/156/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A singlebeam echosounder system used for determining seafloor depth. It is designed for use with Windows XP software, producing depth soundings with positional data and echograms which can be stored internally. Up to four transceivers can operate simultaneously and it offers a high-resolution sidescan option, where one or two 120 kHz or 200 kHz side-looking transducers can be used for shallow structure surveys. It has a frequency range from 38 to 710 kHz and a resolution of 1 cm. It has a dynamic range of 160 dB. It offers up to 30 GB of internal storage."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1471";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EA400 singlebeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2256/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2256";
        dc:date                "2026-01-22 11:22:20.0";
        dc:identifier          "SDN:L22::TOOL2256";
        pav:authoredOn         "2026-01-22 11:22:20.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2256/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "settlement collector cage";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/392/>;
        skos:definition        "A postlarval settlement collector cage built to the specifications described by: Wahle, R.A., Wilson, C., Parkhurst, M. and Bergeron, C. (2009). A vessel‐deployed passive postlarval collector to assess settlement of the American lobster Homarus americanus. New Zealand Journal of Marine and Freshwater Research, 43(1), pp.465-474. doi:https://doi.org/10.1080/00288330909510015. It is designed for monitoring benthic recruitment of lobsters, crabs, and other taxa. The cage is constructed from 10-gauge wire mesh with 37 mm openings and overall dimensions of approximately 61 cm x 91.5 cm x 15 cm, providing a floor area of about 0.55 m^2. The interior is lined with a 2 mm plastic mesh to retain newly settled organisms, overlaid with a 5 mm plastic mesh to prevent chafing. The cage is typically filled with clean, rounded cobbles to create suitable settlement substrate."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2256";
        skos:note              "accepted"@en;
        skos:prefLabel         "Custom-made (passive) postlarval settlement collector cage - Wahle et al. (2009)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0001/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1490/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1490";
        dc:date                "2020-07-03 14:00:59.0";
        dc:identifier          "SDN:L22::TOOL1490";
        pav:authoredOn         "2020-07-03 14:00:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1490/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SEA SWATHplus-H";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A multibeam echosounder for use in very shallow water, suitable for portable or fixed hull installation. Operates at a frequency of 468 kHz, providing coverage between 0 and 50 metres sea floor depth. Can be mounted on the side for side scan applications. Swath coverage of up to 100 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1490";
        skos:note              "accepted"@en;
        skos:prefLabel         "SEA SWATHplus-H multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01611/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0096/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2294/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2294";
        dc:date                "2026-04-23 17:12:54.0";
        dc:identifier          "SDN:L22::TOOL2294";
        pav:authoredOn         "2026-04-23 17:12:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2294/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Sony SNC-RZ25N-P camera";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "A network camera offering both JPEG or MPEG4 compression, designed for a range of web casting and remote monitoring applications. Two versions of the instrument are available (SNC-RZ25P and SNC-RZ25N), the only difference being the regional output format; the SNC-RZ25P outputs in European PAL format, and the SNC-RZ25N outputs in NTSC North American format. It is equipped with a 100BaseTX/10Base-T network interface and a built-in web server. Once the network connection is established, images from the camera can be efficiently streamed over the network. It features a 1/4 type CCD imager (Exwave HAD Technology) and has Pan/Tilt/Zoom (PTZ) capability. This allows camera movements and the 18x optical zoom to be controlled from a PC using a standard web browser. Additional features include 'Day/Night' functions, audio monitoring and alarm functions. It can handle up to 20 simultaneous users in JPEG mode, or 8 users in MPEG4 mode. Its built-in multicasting capability allows efficient streaming of video and audio to a large number of users. The following image sizes are selectable: 640x480, 480x360, 384x288, 320x240, 256x192, and 160x120. Optional accessories include the SNCA-CFW1 Wireless Card and the SNCA-AN1 Wireless LAN Antenna (for use with SNCA-CFW1 Wireless Card. It has a pan range of 340 degrees and a tilt range of 120 degrees. Maximum frame rate is 30 fps for the SNC-RZ25N, 25 fps for the SNC-RZ25P."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2294";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sony SNC-RZ25N/P network camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0267/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02014/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1211/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1211";
        dc:date                "2018-02-02 14:35:00.0";
        dc:identifier          "SDN:L22::TOOL1211";
        pav:authoredOn         "2018-02-02 14:35:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1211/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SeaFAST S2 Pico";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "An automated sample introduction system for the analysis of trace elements in seawater and other high matrix samples by ICPMS (Inductively Coupled Plasma Mass Spectrometry). Three modes of operation are available: fully-automated Direct Mode where the sample is diluted inline; Preconcentration Mode where a chelation column binds rare earth elements and transition metals but allows matrix ions to be rinsed out; and Offline mode. Both Direct and Preconcentration modes reduce procedural blanks associated with offline sample preparation, and Preconcentration mode dramatically improves detection limits by eliminating matrix effects and increasing sensitivity. The system offers detection limits better than 1ppt  and operates in less than 8 minutes inline."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1211";
        skos:note              "accepted"@en;
        skos:prefLabel         "SeaFAST S2 Pico Automated Preconcentration System"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01126/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1230/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1230";
        dc:date                "2018-04-24 12:57:00.0";
        dc:identifier          "SDN:L22::TOOL1230";
        pav:authoredOn         "2018-04-24 12:57:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1230/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1230/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Oregon OMG ChiPod";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/184/>;
        skos:definition        "A self-contained device designed to measure small-scale temperature variability using fast response FP07 thermistors connected to a small pressure case with a cable. The sensing unit is continuously recording as long as the thermistor cable is connected."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1230";
        skos:note              "accepted"@en;
        skos:prefLabel         "Oregon State University Ocean Mixing Group ChiPod temperature microstructure profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00320/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2015/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2015";
        dc:date                "2024-02-14 10:19:41.0";
        dc:identifier          "SDN:L22::TOOL2015";
        pav:authoredOn         "2024-02-14 10:19:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2015/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "E+E Elektronik EE060 probe";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "An analogue relative humidity and temperature probe with voltage output, designed to maintain optimal measurement performance in corrosive, dusty or oily atmospheric environments. The probe's electronics are completely encapsulated, and its HCT01 sensing element is coated by an E+E proprietary protective layer. Electrical connection is provided through either a cable of 1.5 m to 5 m length, or a 4 pole M12 connector plug. The probe can be fitted with either a membrane or a metal grid filter. The humidity and temperature output range can be configured to (0 - 1) V, (0 - 5) V or (0 - 10) V. The measuring range is 0% - 100% (+/- 2.5% accuracy) for relative humidity, and -40 degC to either 60 degC or 80 degC (+/- 0.3 degC accuracy) for temperature."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2015";
        skos:note              "accepted"@en;
        skos:prefLabel         "E+E Elektronik EE060 humidity and temperature probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG02033/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0276/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2053/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2053";
        dc:date                "2024-06-27 13:41:19.0";
        dc:identifier          "SDN:L22::TOOL2053";
