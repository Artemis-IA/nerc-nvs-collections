<http://vocab.nerc.ac.uk/collection/L22/current/NETT0091/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0091";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0091";
