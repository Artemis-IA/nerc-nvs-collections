        skos:prefLabel         "Ashtech 3DF Global Positioning System receiver"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00522/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0881/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0881";
        dc:date                "2024-08-23 15:47:11.0";
        dc:identifier          "SDN:L22::TOOL0881";
        pav:authoredOn         "2024-08-23 15:47:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0881/2/>;
