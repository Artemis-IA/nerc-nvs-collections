        skos:definition        "A rectangular net 200 cm on a side and 300 cm long made from 0.22 mm nylon mesh is designed to fit through a hole in an ice flow closed, and open once underneath. A messenger is used to close the mouth opening at a specific depth prior to retrieval though the ice [Wiebe and Benfield 2003 Plate 11 C]."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0036";
        skos:note              "accepted"@en;
        skos:prefLabel         "English umbrella net - Macaulay and Daly (1987)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/NETT0055/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0055";
        dc:date                "2011-10-21 14:18:49.0";
        dc:identifier          "SDN:L22::NETT0055";
        pav:authoredOn         "2011-10-21 14:18:49.0";
