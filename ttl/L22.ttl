        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/>;
        skos:definition        "A stand-alone datalogger. It is designed for use in harsh and remote environments. It operates using 12 VDC power sources such as batteries recharged with solar panels or wall sockets. It contains a custom ASIC chip and supports PakBus, Modbus, DNP3, SDI-12, SDM communication protocols. It has a real-time clock accuracy of +/-3 min per year."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1510";
        skos:note              "accepted"@en;
