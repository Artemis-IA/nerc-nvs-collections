<http://vocab.nerc.ac.uk/collection/L22/current/NETT0170/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::NETT0170";
        dc:date                "2011-12-05 11:41:22.0";
        dc:identifier          "SDN:L22::NETT0170";
        pav:authoredOn         "2011-12-05 11:41:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/NETT0170/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "WP3 net";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/22/> , <http://vocab.nerc.ac.uk/collection/L05/current/388/>;
        skos:definition        "A non-closing net with a 1.13 m diameter mouth opening (1 m^2). The cylinder is 57 cm long and the cone is 200 cm long. It uses 1 mm nylon mesh as standard, although others may be used (e.g. 300 um).  The cod-end is a non-filtering canvas cylinder 12 cm in diameter by 12 cm in length. A flowmeter is mounted offset in the mouth."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::NETT0170";
        skos:note              "accepted"@en;
        skos:prefLabel         "WP3 net - UNESCO Working Party 3 (1968)"@en .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1427/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1427";
        dc:date                "2020-05-05 15:37:37.0";
        dc:identifier          "SDN:L22::TOOL1427";
        pav:authoredOn         "2020-05-05 15:37:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1427/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Thermalox TOC and TNb series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB01/>;
        skos:definition        "A series of bench-top, thermal oxidation systems. The instruments are designed for use in aqueous systems and solids. They primarily measure Total Organic Carbon (TOC) and Total Nitrogen (TN). Analysers use catalytic thermal oxidation to convert carbon or nitrogen species to either carbon dioxide (CO2) or NOx gases. CO2 is analysed using non-dispersive infrared detectors. The influence of total inorganic carbon (TIC) can be determined by introducing an aliquot of sample into a heated TIC reactor containing phosphoric acid that reacts with carbonate to form CO2. NOx is analysed using vacuum chemiluminescence detectors that utilize the chemiluminescent reaction between NO and O3 to determine the NO concentration. Because NO2 is also present as an oxidant, this is reduced in a special reduction furnace to NO. Analysers are available as separate stand-alone instruments that analyse TOC and TNb, or as a combined TOC/TNb system. The standard deviation is 20ppb for carbon and 10ppb for nitrogen."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1427";
        skos:note              "accepted"@en;
        skos:prefLabel         "Analytical Sciences Thermalox TOC and TNb (thermal oxidation) elemental analyser series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0076/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01170/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1484/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1484";
        dc:date                "2024-08-21 17:17:30.0";
        dc:identifier          "SDN:L22::TOOL1484";
        pav:authoredOn         "2024-08-21 17:17:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1484/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1484/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Kongsberg EM 2040P series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A shallow water multibeam echo sounder for high resolution mapping and inspection applications. As an option the EM 2040P can be delivered with the dual swath capability, allowing a sufficient sounding density along track at a high vessel speed. Also optionally, the sonar head can be delivered with mounts for motion sensor and sound speed sensor, factory aligned for ease of mounting. The operating frequency range is from 200 to 400 kHz. The operator can choose the best operating frequency for the application: 300 kHz for near bottom, 200 kHz for deeper waters and 400 kHz for very high resolution inspection. The system has an output sample rate up to 60 kHz. The system can effectively operate with very short pulse lengths - the shortest pulse is 14 microseconds, which gives a raw range resolution of 10.5 mm. The angular coverage for the 200 and 300 kHz is 140 degrees, allowing coverage of 5.5 times water depth. For the 400 kHz mode the angular coverage is 120 degrees."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1484";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 2040P multibeam echosounder series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2269/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2269";
        dc:date                "2026-02-17 15:28:10.0";
        dc:identifier          "SDN:L22::TOOL2269";
        pav:authoredOn         "2026-02-17 15:28:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2269/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Linovision IPC608UW-10";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/311/>;
        skos:definition        "An industrial 4K POE underwater camera designed for underwater inspection and aquaculture applications. This camera features white LEDs with on/off light control, a remote access web GUI and mobile app, and a 2.8 mm lens (horizontal FOC: 102 degrees, vertical FOV: 55 degrees, diagonal FOV: 120 degrees). Stainless steel anti-corrosion casing makes this camera suitable for long-term underwater deployment. Optional add-ons include an NVR recorder with 10 TB to 80 TB storage capacity; a solar power system; and a 4G router. Maximum resolution: 3840 x 2160. Maximum depth rating: 50 m. Operating conditions: temperature range -30 to 60 degC, Humidity 95% or less within the casing (con-condensing). Shutter speed 1/3 s to 1/100,000 s."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2269";
        skos:note              "accepted"@en;
        skos:prefLabel         "Linovision IPC608UW-10 underwater camera"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0378/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02181/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0553/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0553";
        dc:date                "2012-11-15 10:40:15.0";
        dc:identifier          "SDN:L22::TOOL0553";
        pav:authoredOn         "2012-11-15 10:40:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0553/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0553/1/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0553/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "DGT trace metal sampler";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/TFSAMP/>;
        skos:definition        "A device designed to measure concentrations of dissolved metal species in water. It comprises a plastic casing that contains a Chelex resin impregnated in a hydrogel to accumulate metals. The resin layer is overlain by a diffusive layer of hydrogel and a filter. Ions diffuse through the filter and diffusive layer to reach the resin layer, thereby establishing a constant concentration gradient in the diffusive layer that allows the quantitative measurement of labile species in solution through laboratory analysis."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0553";
        skos:note              "accepted"@en;
        skos:prefLabel         "DGT Research Diffusive Gradients in Thin Films trace metal sampler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00634/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2009/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2009";
        dc:date                "2024-01-31 16:43:09.0";
        dc:identifier          "SDN:L22::TOOL2009";
        pav:authoredOn         "2024-01-31 16:43:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2009/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kongsberg EM 3000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/>;
        skos:definition        "A 40 kHz ping-rate multibeam echosounder designed for high resolution seabed mapping and inspection. The EM 3000 can be configured to use single (3000S) or dual (3000D) transducers. The dual transducer system increases the shallow-water coverage up to 10-x the water depth, and increases the number of measurements per ping from 120 to 220. The system features a Processing Unit (PU) which performs the beamforming and bottom detection, and further controls the gain, ping rate and pitch compensation of the transmit beam. The PU is available as two versions; one for surface use and one for subsea use. It has an operating depth from 1 to 150 m below its transducers. It allows use on survey launches and subsea vehicles to 1500 m water depth. It features a 1.5 degrees beam width and an operating frequency of 300 kHz. It has a maximum swath width 200 m in deep water, while for shorter ranges the swath width maybe up to about four times water depth."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2009";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 3000 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1243/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1243";
        dc:date                "2018-06-13 11:40:45.0";
        dc:identifier          "SDN:L22::TOOL1243";
        pav:authoredOn         "2018-06-13 11:40:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1243/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RaDeCC";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB21/>;
        skos:definition        "A delayed coincidence counting system originally developed by Giffin et al. (1963), and modified by Moore and Arnold (1996). Measures radium isotopes (224Ra, 223Ra and 226Ra) in water samples. The system records decay events in three different channels, depending on the time elapsed between two subsequent signals, which reflect the half-lives of decay products in radium decay chains. It consists of a scintillation cell connected to a photomultiplier to detect radioactive decay events, an electronic gateway system, which registers counts and splits the registered events into different channels, depending on the time elapsed until the next event happens, and a pump, which continuously pumps helium through the sample (on an acrylic fibre coated with manganese dioxide, Mn fibre), and subsequently through the scintillation chamber. Further description can be found in https://doi.org/10.4319/lom.2013.11.594."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1243";
        skos:note              "accepted"@en;
        skos:prefLabel         "Scientific Computer Instruments RaDeCC delayed coincidence counting system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01137/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1262/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1262";
        dc:date                "2018-08-02 15:26:57.0";
        dc:identifier          "SDN:L22::TOOL1262";
        pav:authoredOn         "2018-08-02 15:26:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1262/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "BGS DTB";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/153/> , <http://vocab.nerc.ac.uk/collection/L05/current/BOMR/>;
        skos:definition        "A British Geological Survey-built seismic tool, designed to be towed behind a ship within a water depth range of 100m - 2000m. The DTB has a vertical resolution of 1m, and acoustic penetrations of up to 150m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1262";
        skos:note              "accepted"@en;
        skos:prefLabel         "British Geological Survey Deep Tow Boomer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORS00076/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1281/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1281";
        dc:date                "2024-11-04 11:56:34.0";
        dc:identifier          "SDN:L22::TOOL1281";
        pav:authoredOn         "2024-11-04 11:56:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1281/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1281/2/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1281/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "R2Sonic SONIC 2024";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A broadband - wideband high resolution shallow water multibeam echosounder. It is particularly suited to small survey vessel, ROV and AUV operations in the hydrographic,  dredging, defence and research sectors. It primarily measures bathymetry elevation and consists of a projector, receiver and dry-side Sonar Interface Module (SIM). Sonar operation is controlled via  graphical user interface on a PC or laptop. Commands are transmitted via Ethernet interface to the SIM, which supplies power to the sonar heads, synchronizes multiple heads, time tags sensor data,  relays data to the workstation and relays commands to the sonar head. The receiver head decodes the sonar commands, triggers the transmit pulse, then receives, amplifies, beamforms, bottom detects,  packages and transmits the data through the SIM via Ethernet to the control PC. Key characteristics of the SONIC 2024 include user selectable operating frequencies, with flexibility to trade off  resolution, range and controlling interference from other active acoustic systems. It has variable swath coverage selections from 10 to 160 degrees, the ability to rotate the swath sector, as well  as roll stabilisation. The frequency and swath coverage may also be selected in real-time. Frequency ranges from 170 kHz - 450 kHz at 1 Hz resolution (optional 700 kHz). Number of soundings up to  1024 per swath, per head. The pulse length is 15 to 1115 micro-seconds, ping rate is up to 60 Hz and depth rating is 100m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1281";
        skos:note              "accepted"@en;
        skos:prefLabel         "R2Sonic SONIC 2024 wideband multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01160/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0970/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0970";
        dc:date                "2016-02-29 14:00:40.0";
        dc:identifier          "SDN:L22::TOOL0970";
        pav:authoredOn         "2016-02-29 14:00:40.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0970/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Varian 3800 GC";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB02/>;
        skos:definition        "A laboratory instrument that separates and analyses gas mixtures in water or air using gas chromatography. In a standard configuration, the instrument accommodates up to three injectors, an autosampler, a column oven with three or more capillary columns and up to three detectors running simulaneously. The sample is vapourised then transported along the column within an inert gas flow. The carrier gas may be air, helium, hydrogen, nitrogen or argon-methane depending on the type of detector used. The system interfaces with traditional liquid autosamplers as well as a wide range of automated sample preparation devices. The column oven accepts packed or fused silica capillary columns and a range of injectors may be used including Split/Splitless, Programmable Temperature Vaporising, Septum-Equipped, On-Column,/Packed and Flash injectors. The system can be fitted with a variety of detectors  including Flame Ionization (FID), Thermal Conductivity (TCD), Electron Capture (ECD), Thermionic Specific (TSD) and Pulsed Flame Photometric (PFPD). The PFPD provides selective detection for sulfur, phosphorus, nitrogen, and 25 additional elements. A time-gated electrometer and optical filters eliminate background signal from hydrocarbon interferences. The platform supports a wide range of GC analyzers from a single Gas Sampling Valve with packed column for permanent gas analysis to an advanced four-valve, three-channel system with multiple columns for Refinery Gas Analysis. The instrument was originally manufactured by Varian, Inc., which was bought by Agilent Technologies in 2010."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0970";
        skos:note              "accepted"@en;
        skos:prefLabel         "Varian 3800 gas chromatograph"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00548/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1002/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1002";
        dc:date                "2024-08-21 16:29:32.0";
        dc:identifier          "SDN:L22::TOOL1002";
        pav:authoredOn         "2024-08-21 16:29:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1002/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1002/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Thermo Scientific XSeries 2 ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "The Thermo Scientific XSeries 2 is a benchtop inductively coupled plasma mass spectrometer (ICP-MS) which is designed for the concentration determination of a wide variety of different metals with sub ppb detection limits. The quadrupole analyser is pumped by a split flow turbo pump backed by a single rotary. The high capacity pumping system enables the use of diluted reactive gases such as 7 % H2 in He or 1 % NH3 in He to be used in CCT mode rather than undiluted H2 or NH3 thereby eliminating potential corrosion problems and enhancing instrument reliability and operator safety. The instrument can be coupled with additional systems to increase the measuring capability (such as laser ablation, liquid chromatography and gas chromatography. The XSeries 2 is an update to the X Series ICP-MS."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1002";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Fisher Scientific XSeries 2 quadrupole inductively coupled plasma mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1021/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1021";
        dc:date                "2024-08-21 16:29:32.0";
        dc:identifier          "SDN:L22::TOOL1021";
        pav:authoredOn         "2024-08-21 16:29:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1021/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1021/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Thermo Scientific DELTA V Plus";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB48/>;
        skos:definition        "The Thermo Scientific DELTA V Plus is an isotope ratio mass spectrometer designed to measure isotopic, elemental and molecular ratios of organic and inorganic compounds. The DELTA V Plus is an enhanced model of the DELTA V series of isotope ratio mass spectrometers, which can be upgraded from the DELTA V Advantage. The DELTA V Plus can be operated in Continuous Flow or Dual Inlet mode and can accommodate up to 10 collectors, ensuring flexibility to cover many applications. The DELTA V Plus is controlled by an automated, integrated Isodat software suite. A magnet, whose pole faces determine the free flight space for the ions, eliminates the traditional flight tube. The magnet is designed for fast mass switching which is further supported by a fast jump control between consecutive measurements of multiple gases within one run. The sample gas is introduced at ground potential, eliminating the need for insulation of the flow path, ensuring 100 percent transfer into the ion source. The amplifiers register ion beams up to 50 V. The DELTA V Plus has refined optics, enabling greater ion transmission than the DELTA V Advantage. It has a sensitivity of 800 molecules per ion (M/I) in Dual Inlet mode and 1100 M/I in Continuous Flow mode. It has a system stability of < 10 ppm and an effective magnetic detection radius of 191 nm. It has a mass range of 1 - 96 Dalton at 3 kV."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1021";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Fisher Scientific DELTA V Plus isotope ratio mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1961/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1961";
        dc:date                "2023-06-26 11:18:49.0";
        dc:identifier          "SDN:L22::TOOL1961";
        pav:authoredOn         "2023-06-26 11:18:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1961/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Folsom splitter";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/397/>;
        skos:definition        "A device for sub-sampling of plankton and ichthyoplankton samples by splitting, developed by Dr. Folsom of the Scripps Institute of Oceanography. Ideally suited for splitting plankton samples with minimal debris. A measured volume of plankton sample is placed in the undivided section of the drum. This is rotated 120 degrees to divide the stirred sample with a separating blade. Standard Methods suggests splitting until a subsample of 200-500 individuals is obtained."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1961";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unspecified Folsom Plankton sample splitter - McEwen et al. 1954"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/UNSPEC/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0001/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1839/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1839";
        dc:date                "2022-09-05 15:09:28.0";
        dc:identifier          "SDN:L22::TOOL1839";
        pav:authoredOn         "2022-09-05 15:09:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1839/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Onset HOBO UA-001-08";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "An in-situ instrument for wet or underwater applications. It supports soil temperature, temperature and water temperature. A one-channel logger with 10-bit resolution that records up to approximately 6,500 measurements with 8K bytes memory. It has a polypropylene housing case. Uses an optical USB to transmit data. A solar radiation shield is used for measurement in sunlight. Measurement range: -20 deg C to 70 deg C. Accuracy: +/- 0.53 deg C from 0 deg C to 50 deg C. Water depth rating: 30 m."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1839";
        skos:note              "accepted"@en;
        skos:prefLabel         "Onset HOBO Pendant UA-001-08 temperature logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01790/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0157/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1877/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1877";
        dc:date                "2022-11-15 11:48:38.0";
        dc:identifier          "SDN:L22::TOOL1877";
        pav:authoredOn         "2022-11-15 11:48:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1877/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Furuno CH12 series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/FFES/>;
        skos:definition        "Furuno CH12 sector scan sonar systems (CH12-60, CH12-88, and CH12-150) are designed for the detection of fish schools both vertically and horizontally. Depending on the version, the transceiver emits at a frequency of 60, 88, or 150 kHz. The returning echoes are represented on a 12-inch colour cathode-ray tube (CRT) display. Detection ranges are 800, 1200, and 1400 m for the 150 kHz, 88 kHz, and 60 kHz instruments, respectively. This product was discontinued in 1992."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1877";
        skos:note              "accepted"@en;
        skos:prefLabel         "Furuno CH12 sector scan sonar system series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00571/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0115/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0267/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0267";
        dc:date                "2017-04-03 10:40:29.0";
        dc:identifier          "SDN:L22::TOOL0267";
