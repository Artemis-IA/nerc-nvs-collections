        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "RDI WMariner 300 kHz ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/115/>;
        skos:definition        "The workhorse mariner WM-300 provides short-range current profiling (typical range 110 m, or 154 m in long-range mode). This model operates at a 300 kHz frequency providing precision bottom-track reference for direct vessel speed measurement."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0749";
        skos:note              "accepted"@en;
        skos:prefLabel         "Teledyne RDI Workhorse Mariner 300 kHz ADCP"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00298/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0787/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0787";
        dc:date                "2014-09-01 08:09:10.0";
        dc:identifier          "SDN:L22::TOOL0787";
        pav:authoredOn         "2014-09-01 08:09:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0787/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PARFLUX Mark8-13";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/33/>;
        skos:definition        "A sediment trap designed for mid-water mooring deployment (maximum depth 6500m) with a conical collector passing settled particles into one of a set of bottles mounted in a carousel. The bottles are changed after a user-selected period of time.  An optional wet sample particle divider may be fitted to divide wet specimens into 5-10 equal parts. Compass/tilt and pressure sensors may also be fitted. This model carries 13 bottles (250 or 500 ml) and is 1.16m tall and 0.66m diameter. The reduced size eases handling at sea."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0787";
        skos:note              "accepted"@en;
        skos:prefLabel         "McLane PARFLUX Mark8-13"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00996/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2142/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2142";
        dc:date                "2025-03-26 11:59:15.0";
        dc:identifier          "SDN:L22::TOOL2142";
        pav:authoredOn         "2025-03-26 11:59:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2142/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2142/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Thermo Scientific MAT 253 IRMS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB48/>;
        skos:definition        "The Thermo Scientific MAT 253 stable isotope ratio mass spectrometer is designed to determine isotopic ratios of D/H, 13C/12C, 15N/14N, 34S/32S, 28Si/29Si, Ar, Kr, and Xe. It can be used in dual inlet mode or continuous flow mode. The instrument includes amplifiers up to 50 V, hydrogen continuous flow capability, up to eight simultaneous acquisition channels, and the integration of Isodat software. Its analytical performance and ruggedness are due to the geometry with stigmatic focus and large dispersion. The magnetic sector field is generated by an electromagnet. Collectors are located at the focal plane of the full deflection radius, and they use individually shielded Faraday cups. The MAT 253 has a mass range of 1-150 Dalton at 10 kV, a sensitivity of 600 molecules CO2 per mass 44 ion in the dual inlet mode, and 900 molecules/ion in the continuous flow mode. For this instrument, the ambient temperature must be 18 - 28 deg C, with a relative humidity of 20 - 70 %. It requires power 230 V. and compressed air 350 - 500 Kpa (50 - 75 psi)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2142";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Fisher Scientific MAT 253 isotope ratio mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0035/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2161/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2161";
        dc:date                "2025-05-08 12:41:28.0";
        dc:identifier          "SDN:L22::TOOL2161";
        pav:authoredOn         "2025-05-08 12:41:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2161/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Garmin GPSMAP 78 series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS04/>;
        skos:definition        "A series of handheld battery-powered global positioning system (GPS) devices that includes the GPSMAP 78, 78s and 78sc models. They have an IPX7 waterproof rating, colour mapping, a high-sensitivity receiver, moulded rubber side grips, plus a microSD card slot. The 78s and 78sc also feature a 3-axis tilt-compensated compass and barometric altimeter. The 78sc also comes pre-loaded with BlueChart g2 coastal charts and a worldwide basemap. All three models float in water. 20 hour battery life, 1.43\" x 2.15\" (3.6 x 5.5 cm); 2.6\" diag (6.6 cm) display size. 1.7 GB internal memory."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2161";
        skos:note              "accepted"@en;
        skos:prefLabel         "Garmin GPSMAP 78 handheld marine Global Positioning System receiver series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00911/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0337/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2180/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2180";
        dc:date                "2025-07-01 14:35:59.0";
        dc:identifier          "SDN:L22::TOOL2180";
        pav:authoredOn         "2025-07-01 14:35:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2180/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PerkinElmer NexION 5000 ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "A benchtop multi-quadrupole inductively coupled plasma mass spectrometer designed for the determination trace elements in a range of sample types. It features a triple cone interface with OmniRing which can operate in extraction or focusing modes. It is available in two configurations, either non-cleanroom or cleanroom. The plasma is generated by the unique LumiCoil RF load coil, which is air cooled (does not require water or gas cooling), so maintenance-free. The first quadrupole Q0 (Ion Deflector) directs ions to the entrance of the first mass filter. The second quadrupole Q1 (Transmission Analyser 1) acts as a mass filter or as an ion guide to direct ions to the Quadrupole Universal Cell. The third quadrupole Q2 (Universal Cell), empowered by dynamic bandpass tuning, prevents side reactions with residual reaction gases in the cell. The fourth quadrupole Q3 (Transmission Analyser 2) acts as a mass filter or as an ion guide to direct ions to the detector. Transmission Analyser quadrupoles exhibit <0.7 amu mass resolution, driven by a 2.5 MHz power supply."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2180";
        skos:note              "accepted"@en;
        skos:prefLabel         "PerkinElmer NexION 5000 multi-quadrupole inductively coupled plasma mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00578/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0227/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0565/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0565";
        dc:date                "2024-08-21 16:29:33.0";
        dc:identifier          "SDN:L22::TOOL0565";
        pav:authoredOn         "2024-08-21 16:29:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0565/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0565/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Thermo Scientific VG PQ ExCell ICP-MS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB15/>;
        skos:definition        "A quadrupole-based inductively coupled plasma mass spectrometer (ICP-MS) designed for the determination of trace elements in a range of sample types. The instrument comprises a sample introduction system including a peristaltic pump, a Peltier cooled pneumatic nebulisation system, a one-piece quartz torch, mass flow controllers and a solid-state RF generator. There is an interface of two cones which sample the ions created in the plasma and provide an ion skimming function. Cylindrical electrodes are then used to extract and focus ions from the interface into the mass spectrometer. The instrument includes a vacuum pumping system, argon backfill system and an autorange standard detector system. There is a high efficiency ion guide and chicane deflector coupled to an off-axis quadrupole mass analyser known as the Infinity Lens System which reduces background noise. The ICP-MS is fully automated and is operated using PlasmaLab software. Optional extras include collision cell technology, choice of detectors, 4th gas supply with mass flow controller, organic matrix sample option, S-Option interface technology and a range of sampling accessories. This model was released in 1999 and was replaced by the XSERIES in 2001."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0565";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Fisher Scientific VG PQ ExCell inductively coupled plasma mass spectrometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0584/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0584";
        dc:date                "2013-01-10 09:56:58.0";
