<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1744/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1744";
        dc:date                "2021-11-02 16:30:34.0";
        dc:identifier          "SDN:L22::TOOL1744";
        pav:authoredOn         "2021-11-02 16:30:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1744/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Thermco ACC091CBLS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/>;
        skos:definition        "A liquid-in-glass thermometer filled with blue spirit designed for use in identifying solidification point of liquids in a laboratory setting. Conforms to or exceeds American Society for Testing and Materials (ASTM) standards. ASTM class S91C. Operates within a temperature range of 20 to 50 degC, designed for partial immersion up to a depth of 76 mm, with has a length of 375 mm and a precision of 0.1 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1744";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermco Blue Spirit Liquid Thermometer ACC091CBLS"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0193/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01852/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1763/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1763";
        dc:date                "2022-01-12 21:02:37.0";
        dc:identifier          "SDN:L22::TOOL1763";
        pav:authoredOn         "2022-01-12 21:02:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1763/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Kongsberg EM 304";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/>;
        skos:definition        "A modular high-resolution multibeam echosounder designed for seabed mapping in shallow to deep waters between 10 and 8000 metres. It operates at frequencies of 26 - 34 kHz, with a nominal operating frequency of 30 kHz. The instrument has a swath width of 5.5 times the water depth, and provides two swaths per ping. The instrument features separate transmit and receive transducers. The transmit fan is divided up into 16 individual sectors in dual swath mode, allowing for unique control of the transmit fan, and enabling active stabilisation in real time to correct for any yaw and pitch movement of the vessel, while roll stabilisation is applied on the receiving beams. The result is real-time motion stabilisation of +/- 15 degrees roll, +/- 10 degrees pitch, and/or +/- 10 degrees yaw."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1763";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kongsberg EM 304 multibeam echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00360/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0134/>
