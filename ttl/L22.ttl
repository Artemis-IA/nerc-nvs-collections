        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "Compact single channel temperature logger designed for application in moorings, bore holes, profiling or towed arrays. It can provide up to 25 million readings, on a single battery, with an accuracy of +/- 0.002 degC. It has a depth rating of 1700 meters and a temperature range from -5 degC to 35 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1024";
        skos:note              "accepted"@en;
        skos:prefLabel         "RBR Solo T Temperature logger"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00299/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0732/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0732";
        dc:date                "2024-08-23 15:47:12.0";
        dc:identifier          "SDN:L22::TOOL0732";
        pav:authoredOn         "2024-08-23 15:47:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0732/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0732/1/>;
