<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2149/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2149";
        dc:date                "2025-04-11 12:02:07.0";
        dc:identifier          "SDN:L22::TOOL2149";
        pav:authoredOn         "2025-04-11 12:02:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2149/1/>;
