        dc:date                "2015-08-06 10:53:28.0";
        dc:identifier          "SDN:L22::TOOL0931";
        pav:authoredOn         "2015-08-06 10:53:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0931/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
