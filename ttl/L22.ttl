<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1574/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1574";
        dc:date                "2020-11-23 08:44:55.0";
        dc:identifier          "SDN:L22::TOOL1574";
        pav:authoredOn         "2020-11-23 08:44:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1574/1/>;
