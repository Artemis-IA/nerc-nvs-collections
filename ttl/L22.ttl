        skos:altLabel          "Centurion P(Y)";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/POS03/>;
        skos:definition        "The Trimble Centurion P(Y) GPS receiver utilizes the P(Y)-code broadcast on the L2 carrier frequency for positioning. This device can use Asset surveyor software and TDC1 data logger to collect data with accuracy of 1-4m. This device has been discontinued, and is no longer supported by Trimble."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0758";
        skos:note              "accepted"@en;
        skos:prefLabel         "Trimble Centurion P(Y)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00357/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0769/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0769";
        dc:date                "2014-08-15 11:24:21.0";
