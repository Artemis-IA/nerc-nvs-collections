        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "PerkinElmer LAMBDA 35";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB20/>;
        skos:definition        "The Lambda spectrophotometer provides UV-Visibility (UV-Vis) capability over a spectral range of 190 - 1100 nm. Variable  bandwidth of 0.5 - 4 nm, does not contain a pre-monochromator and has an absorbance range of 3.2 A. Not capable of analysis on highly absorbing samples unlike the LAMBDA series 45."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0947";
