        skos:altLabel          "Marsh McBirney 585 EMCM";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/114/>;
        skos:definition        "A rugged solid-state electromagnetic current sensor designed to measure horizontal currents with minimal interference from vertical flow. Manufactured between 1976 and 1992 by Marsh McBirney, now part of Hashflow. The OEM 585 was a dual-axis unit with a 4-inch sensor able to measure currents up to 3 ms-1 with 2% accuracy and a resolution of 0.0018 ms-1. It was supplied as a sensor plus associated electronic unit rather than packaged into a self-contained current meter."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0057";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marsh McBirney 585 OEM electromagnetic flowmeter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00300/> .

