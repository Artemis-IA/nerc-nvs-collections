        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "V4970";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/159/>;
        skos:definition        "A proton magnetometer used to measure the earth's magnetic field strength and detect variations in this field caused by the presence of ferrous objects. Applications include detection of underground pipes, unexploded ordnance, archaeological artefacts, and wrecks on the seafloor, among other things."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1849";
        skos:note              "accepted"@en;
