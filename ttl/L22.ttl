<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1407/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1407";
        dc:date                "2024-08-20 13:30:09.0";
        dc:identifier          "SDN:L22::TOOL1407";
        pav:authoredOn         "2024-08-20 13:30:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1407/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1407/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "ZEISS Axioplan II";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/LAB06/>;
        skos:definition        "The Axioplan 2 is a general-purpose motorised upright microscope with high-quality optics for both fixed-sample fluorescence and transmitted light microscopy. Features include: DAPI, GFP, FITC, Luciferase yellow, TRITC and Cy5 filter sets; DIC, Phase contrast; Photometrics Retiga monochrome CCD; Micromanager acquisition software; Metamorph image acquisition and analysis software; Motorised stage. Flexible fluorophore choices, 4 simultaneous fluorescence channels are possible. The upright configuration of the microscope makes it more suitable for fixed-sample imaging, however dipping objectives are available for live cell applications. It is also capable of producing high-quality transmitted light images using phase, DIC and brightfield."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1407";
        skos:note              "accepted"@en;
        skos:prefLabel         "ZEISS Axioplan II motorised fluorescence microscope"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG01123/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0073/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2249/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2249";
        dc:date                "2025-12-18 15:13:29.0";
        dc:identifier          "SDN:L22::TOOL2249";
        pav:authoredOn         "2025-12-18 15:13:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2249/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Aanderaa In-line ZPulse DCS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/384/>;
        skos:definition        "The Aanderaa In-line ZPulse DCS series are single-point acoustic doppler velocimeters based on a modified version of the ZPulse DCS 4520. The 5 models within this series include: 5800, 5800R, 5800RR, 5810, and 5810E. All of the models have a maximum depth rating of 2000 m and the in-line design facilitates the connection of up to 4 In-line DCS in a string (max. length of 300 m). The 5810(R) versions have the option to directly connect additional sensors as an integrated package, including: temperature, conductivity, wave and tides, pressure, and oxygen. Output interfaces for the sensors are AiCaP (5800/5810/5810E), RS-232 (5800RR/5810E), and RS-422 (5800R/5810E). Vector Averaged Current Speed Range: 0 to 300 cm/s; Resolution: 0.1 mm/s; Mean Accuracy: +/- 0.15 cm/s; Statistic Precision (std): 0.3 cm/s (ZPulse mode). Current Direction Range: 0 to 360 deg; Resolution: 0.01 deg; Accuracy: +/- 5 deg for 0 to 15 deg tilt, +/- 7.5 deg for 15 to 35 deg tilt."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2249";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa In-line ZPulse Doppler Current Sensor (DCS) series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0007/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2268/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2268";
        dc:date                "2026-02-11 16:03:43.0";
        dc:identifier          "SDN:L22::TOOL2268";
