        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0879";
        skos:note              "accepted"@en;
        skos:prefLabel         "WET Labs {Sea-Bird WETLabs} ECO NTU turbidity sensor"@en;
