<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2048/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2048";
        dc:date                "2024-08-21 16:29:33.0";
        dc:identifier          "SDN:L22::TOOL2048";
        pav:authoredOn         "2024-08-21 16:29:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2048/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2048/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Thermo Scientific Partisol 2025i";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/58/>;
        skos:definition        "Federal Reference Method sequential ambient sampler featuring enhanced communication capabilities and long-term unattended operation. It is designed to meet the regulatory monitoring requirements for PM-2.5, PM-10 and PM-Coarse sampling methods. The Partisol 2025i sampler accommodates 47 mm filter in the single-flow and dual-flow configurations. It exchanges 47 mm diameter sample filters automatically, which can be preset to a user-defined time interval. It has the capacity to store 16 filter cassettes, allowing for two weeks of unattended daily sampling of particulate matter."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2048";
        skos:note              "accepted"@en;
        skos:prefLabel         "Thermo Fisher Scientific Partisol 2025i sequential air sampler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00458/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0035/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1401/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1401";
        dc:date                "2021-03-09 12:18:43.0";
        dc:identifier          "SDN:L22::TOOL1401";
        pav:authoredOn         "2021-03-09 12:18:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1401/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1401/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "ASIMet LOGR53";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/DLOG/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A modular logging system designed to house sensors on moored buoys for observing climatic conditions at the sea surface. It combines individual sensor modules with front end boards that connects to a central data processor. The LOGR53 CPU board is based on a Dallas Semiconductor DS87C530 microcontroller. DS87C530 internal peripherals include a real time clock and 2 uarts; 2 additional uarts are included on the CPU board as well. Also present on the CPU board is a memory card interface included with the system; at a 1-minute logging interval, there is enough storage for over 400 days of data. A standard CR2032 lithium coin cell provides battery-backup for the realtime clock. Operating parameters are stored in EEPROM. It communicates with the outside world using communication protocols in RS232. A normally unused RS485 protocol is also present."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1401";
        skos:note              "accepted"@en;
        skos:prefLabel         "WHOI and Star Engineering ASIMet {LOGR53 buoy} data logging system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00135/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0065/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01231/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1420/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1420";
        dc:date                "2020-04-17 09:50:17.0";
        dc:identifier          "SDN:L22::TOOL1420";
        pav:authoredOn         "2020-04-17 09:50:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1420/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ASL ZAP (WCP) 200kHz";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/112/>;
        skos:definition        "A cable tethered instrument designed to measure and record the Water Column moving through its field of view from the seabed during long, unattended, deployments. It transmits an acoustic pulse of programmable duration, then listens for the echo from targets in the water column. It returns a value of the acoustic intensity for every 12.5 cm. It can be deployed up to 150 m beneath the surface, looking upward, or from the surface looking downward."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1420";
        skos:note              "accepted"@en;
        skos:prefLabel         "ASL Environmental Sciences Zooplankton Acoustic Profiler (ZAP) 200 kHz {Water Column Profiler (WCP)} echosounder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0072/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00454/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2205/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2205";
        dc:date                "2025-08-14 11:11:25.0";
        dc:identifier          "SDN:L22::TOOL2205";
        pav:authoredOn         "2025-08-14 11:11:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2205/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2205/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "IOS hydrophone array";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "A system comprised of a custom array of hydrophones, designed by the Institute of Ocean Sciences, Canada. The system typically employs three hydrophones to facilitate the determination of directionality. Three hydrophone models have been used for the hydrophone arrays over time, the Burns Electronics CR-100-27 hydrophone (TOOL2204), the High Tech Inc HTI-99-HF hydrophone (TOOL1498), and the Teledyne Reson TC4032 hydrophone (TOOL1731)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2205";
        skos:note              "accepted"@en;
        skos:prefLabel         "Institute of Ocean Sciences hydrophone array system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0353/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00845/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2224/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2224";
        dc:date                "2025-10-09 09:47:39.0";
        dc:identifier          "SDN:L22::TOOL2224";
        pav:authoredOn         "2025-10-09 09:47:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2224/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "P-ONE_P-OM";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/399/>;
        skos:definition        "A pair of glass hemispheres containing photomultiplier tubes that utilises Cherenkov radiation to detect high-energy neutrinos. Multiple Optical Modules (P-OMs) will be deployed on instrumented mooring strings as part of the Pacific Ocean Neutrino Experiment (P-ONE) large-volume neutrino telescope. Each 17 inch borosilicate glass hemisphere contains 8 photomultiplier tubes (PMTs) each with a diameter of 3.1 inches. These PMTs detect the emission of light (Cherenkov radiation) from secondary particles produced in neutrino interactions within the water. The arrangement of the PMTs within the Optical Module ensure that photons with low incident angles that miss the primary PMT can be collected by adjacent PMTs. The PMTs are mounted in a spring-loaded configuration to accommodate temperature gradients, hydrostatic compression, and shock and vibrational loads during deployment or transportation. Silicon-based optical gel pads molded to the photosensitive area provide optical coupling to the glass hemispheres and increase the effective photocathode area by utilising total internal reflection. The mounting scheme and the easily removable gel pads allow for the safe removal and replacement of PMTs during production and testing. A custom high-voltage subsystem provides each PMT with a self-regulated programmable high-voltage supply, and the analog output signals from the PMTs are fed to a mainboard. Openings between PMTs will be used to mount additional devices for calibration purposes, including light beacons, axicons for light collimation, and acoustic receivers. Each module has several temperature, pressure, humidity, acceleration, and magnetic field sensors for continuous system monitoring."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2224";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pacific Ocean Neutrino Experiment Optical Module"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0357/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02131/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0628/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0628";
        dc:date                "2013-07-02 16:03:17.0";
        dc:identifier          "SDN:L22::TOOL0628";
        pav:authoredOn         "2013-07-02 16:03:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0628/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Focal Technologies OPC";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/150/>;
        skos:definition        "An in-situ instrument with a sampling tunnel that causes particles (presumed to be plankton) to pass through a collimated light beam that measures their effective spherical diameters. Counts are produced over the sampling interval (typically 30 seconds) of the number of particles in each of 128 equal size classes within a size range of 0-5500 microns. More information may be found in http://www.bodc.ac.uk/data/documents/nodb/104842/."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0628";
        skos:note              "accepted"@en;
        skos:prefLabel         "Focal Technologies Corporation optical plankton counter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00739/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2308/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2308";
        dc:date                "2026-06-04 08:12:27.0";
        dc:identifier          "SDN:L22::TOOL2308";
        pav:authoredOn         "2026-06-04 08:12:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2308/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2308/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "OS icListen HF series";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "A series of compact high frequency smart digital hydrophones that can process, stream, and record acoustic data in real-time. Applications include marine mammal monitoring, pile driving and marine construction, passive acoustic monitoring, shipping noise, earthquake and tsunamis, and pipeline leak detection. A low frequency model (HF-L e.g. SJ9L) and a model for high-intensity sounds (HF-X2 e.g. SJ9-X2) are also available alongside the standard HF (e.g. SJ9) model. The standard frequency range is 10 Hz to 200 kHz (+/- 3 dB bandwidth) with a low frequency cutoff of 1 Hz for the HF-L and HF-X2 models. Dynamic range is 147 dB. Peak Sound Pressure Level (SPL) is 179 dB re uPa for standard HF and HF-L models, and 215 dB re uPa for the HF-X2 model. Instruments have rechargeable batteries, a large internal memory (maximum 1 TB data storage), and a built-in event detector. They use an ethernet communication interface. Different depth ratings are available. Products in the icListen HF range include the SB and SC ranges (no longer commercially available) and the SJ range."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2308";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ocean Sonics icListen HF hydrophone series"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0100/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01004/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0647/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0647";
        dc:date                "2013-09-30 14:21:04.0";
        dc:identifier          "SDN:L22::TOOL0647";
        pav:authoredOn         "2013-09-30 14:21:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0647/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "CS215 Temperature and Relative Humidity Probe";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/102/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A meteorological sensor that uses the Sensirion SHT75 combined temperature and relative humidity element based on Sensiria combined temperature and humidity element called the Sensirion's CMOSens technology. This sensor comes pre-calibrated, is field-replacable and outputs an SDI-12 signal that can be measured by most Campbell Scientific dataloggers."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0647";
        skos:note              "accepted"@en;
        skos:prefLabel         "Campbell Scientific 215 Temperature and Relative Humidity Probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00414/> , <http://vocab.nerc.ac.uk/collection/P01/current/CTMPZZ01/> , <http://vocab.nerc.ac.uk/collection/P01/current/CRELZZ01/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2002/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2002";
        dc:date                "2024-01-26 15:10:13.0";
        dc:identifier          "SDN:L22::TOOL2002";
        pav:authoredOn         "2024-01-26 15:10:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2002/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Metrohm Aquatrode plus with Pt1000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/355/>;
        skos:definition        "Combined pH electrode with integrated Pt1000 temperature sensor for pH measurements/titrations in ion-deficient aqueous media (e.g., drinking water, process water). This electrode shows a very short response time in these samples. The fixed ground-joint diaphragm is insensitive to contamination. When c(KCl) = 3 mol/L is used as bridge electrolyte, storage in storage solution is recommended. The bridge electrolyte can be easily replaced with a chloride-free electrolyte (e.g., potassium nitrate c(KNO3) = 1 mol/L (6.2310.010)), storage in the used bridge electrolyte. Temperature range: 0 - 60 degC. pH range: 0 - 13."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2002";
        skos:note              "accepted"@en;
        skos:prefLabel         "Metrohm Aquatrode Plus with Pt1000 Combined pH electrode"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0043/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00620/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2040/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2040";
        dc:date                "2024-05-30 13:54:18.0";
        dc:identifier          "SDN:L22::TOOL2040";
        pav:authoredOn         "2024-05-30 13:54:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2040/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NORBIT iWBMS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/157/>;
        skos:definition        "A multibeam sonar for high resolution curved array bathymetry. It can be used for the following applications: shallow water bathymetry; pipeline surveys; pond, river, and estuary surveys; harbour and lake surveys; umanned surface applications (AUV and ASV); and coastal surveys. It outputs roll-stabilized bathymetric data and backscatter outputs. 80 kHz bandwidth. Standard resolution (ACROSS X ALONG) is 0.9 X 1.9 degrees at 400 kHz and 0.5 X 1.0 degrees at 700 kHz; or the narrow option is 0.9 X 0.9 degrees at 400 kHz and 0.5 X 0.5 degrees at 700 kHz. Ping rate is up to 60 Hz and is adaptive. Depth range 0.2 to 275 m (>300 m with 400 kHz narrow option). Operating temperature -4 to 40 degrees C (topside -20 to 55 degrees C)."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2040";
        skos:note              "accepted"@en;
        skos:prefLabel         "NORBIT iWBMS multibeam echosounder system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0215/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG01967/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2265/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2265";
        dc:date                "2026-02-10 15:33:15.0";
        dc:identifier          "SDN:L22::TOOL2265";
        pav:authoredOn         "2026-02-10 15:33:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2265/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Rockland MicroRider-1000G";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/184/> , <http://vocab.nerc.ac.uk/collection/L05/current/385/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "The Rockland Scientific MicroRider-100G turbulence microstructure profiler is a self-contained device designed to integrate into the nose of autonomous vehicles and measure velocity shear and dissipation of turbulent kinetic energy (TKE). The device contains 2x SPM-6000 turbulence shear probes, 2x FP07-1000 fast thermistors, 1x pressure sensor, 2x accelerometers and 1x tilt sensor as standard. An optional FP07 micro-temperature sensor can be added. The turbulence microstructure is pressure rated to 1000 dbar or 6000 dbar and has a sampling rate of 512 Hz with optional rates of up to 2048 Hz. Velocity shear accuracy is +/- 5%."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2265";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rockland Scientific MicroRider-1000G turbulence microstructure profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00677/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0022/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1124/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1124";
        dc:date                "2017-04-04 10:06:11.0";
        dc:identifier          "SDN:L22::TOOL1124";
        pav:authoredOn         "2017-04-04 10:06:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1124/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Campbell Scientific CS456";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/WPS/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A submersible pressure transducer. Its applications are for long-term deployments such as water-level measurements in canals, wells, ponds, harbours, lakes, streams and tanks. It has a titanium case and outputs either a digital SDI-12 or RS-232 signal to indicate observed pressure and temperature. The CS456 replaces the CS455 transducer. It has a smaller gap between the water ports and the diaphragm so that less air is trapped that the user must remove during deployment. It is available in 6  pressure depth range options (0-2.9, 0-7.25, 0-14.5, 0-29, 0-72.5, 0-145 psig) and two accuracy options. The standard accuracy option provides +/-0.1% full-scale range TEB over the 0 - 60 degrees C temperature range. The high accuracy option provides +/-0.05% full scale range TEB over the 0 - 60 degrees C temperature range."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1124";
        skos:note              "accepted"@en;
        skos:prefLabel         "Campbell Scientific CS456 pressure transducer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00414/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2329/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2329";
        dc:date                "2026-08-12 12:15:21.0";
        dc:identifier          "SDN:L22::TOOL2329";
        pav:authoredOn         "2026-08-12 12:15:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2329/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SBE 54 Tsunameter";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "A high-resolution pressure sensor that continuously measures, records, and outputs pressure at user-programmable periods. It is designed primarily for deep-ocean tsunami detection. It combines a Paroscientific Digiquartz pressure transducer, microcontroller, real-time clock with temperature-compensated crystal oscillator, precision temperature-compensated reference frequency, two high-resolution frequency acquisition circuits, EEPROM, 128 MB FLASH memory, and an RS-232 interface. The reference frequency used to acquire pressure, and pressure temperature outputs from the pressure sensor, is accurate to 1 part per million, and temperature is calibrated to 50 parts per billion. It features titanium housing and is therefore depth-rated to 7000 m. Overall pressure resolution is better than 1 mm at full ocean depth (7000 meters) at the default 15-second sample period."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2329";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-Bird SBE 54 Tsunami pressure sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00226/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0013/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1474/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1474";
        dc:date                "2024-07-22 10:20:56.0";
        dc:identifier          "SDN:L22::TOOL1474";
        pav:authoredOn         "2024-07-22 10:20:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1474/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1474/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Nortek Signature250 ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/>;
        skos:definition        "An Acoustic Doppler Current Profiler (ADCP) for use in: currents; waves; tidal; and ice drift and draft studies. It consists of up to five acoustic transducers, four standard beams slanted at 20 degrees from vertical, and a fifth optional vertical beam. All beams operate at the same frequency of 250kHz. The instrument has integrated pressure and temperature sensors."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1474";
        skos:note              "accepted"@en;
        skos:prefLabel         "Nortek Signature 250 acoustic Doppler current profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00333/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0068/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1009/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1009";
        dc:date                "2016-07-15 13:23:34.0";
        dc:identifier          "SDN:L22::TOOL1009";
        pav:authoredOn         "2016-07-15 13:23:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1009/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Nortek Signature1000 ADCP";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/115/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L05/current/WPS/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "An Acoustic Doppler Current Profiler (ADCP) for use in turbulence studies. It consists of five acoustic transducers, four slanted at 25 degrees from vertical, and a fifth vertical beam. All beams operate at the same frequency of 1 MHz. The instrument has integrated pressure and temperature sensors."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1009";
        skos:note              "accepted"@en;
        skos:prefLabel         "Nortek Signature1000 Acoustic Doppler Current Profiler"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00333/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1397/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1397";
        dc:date                "2024-08-23 16:01:31.0";
        dc:identifier          "SDN:L22::TOOL1397";
        pav:authoredOn         "2024-08-23 16:01:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1397/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1397/1/>;
