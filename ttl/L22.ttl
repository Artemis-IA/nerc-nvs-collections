        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/111/> , <http://vocab.nerc.ac.uk/collection/L05/current/134/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/>;
        skos:definition        "A bottom pressure recorder for measuring sea level in shallow waters with optional Fenwall thermistor temperature sensor logging to an internal solid-state data storage unit. More information is available in http://www.bodc.ac.uk/data/documents/nodb/225584/."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0031";
        skos:note              "accepted"@en;
        skos:prefLabel         "Aanderaa WLR 7 Water Level Recorder"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0007/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG00228/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1179/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1179";
        dc:date                "2017-11-23 13:03:21.0";
        dc:identifier          "SDN:L22::TOOL1179";
        pav:authoredOn         "2017-11-23 13:03:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1179/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "BAS Grav";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/51/>;
        skos:definition        "Gravity corer built in 2010 by P.Smit, Netherland. It was primarily used in the Paleo - Ice Sheets and Quaternary Sediments Work packages at BAS. The corer uses the pull of gravity to penetrate the seabed with a core barrel to collect samples. Corer can configure 3m, 6m, 9m, and 12m barrels."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1179";
        skos:note              "accepted"@en;
        skos:prefLabel         "British Antarctic Survey gravity corer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1198/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1198";
