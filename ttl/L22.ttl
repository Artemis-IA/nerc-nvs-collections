        skos:prefLabel         "British Antarctic Survey rock chipper"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG0015/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0864/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL0864";
        dc:date                "2018-04-23 16:44:14.0";
        dc:identifier          "SDN:L22::TOOL0864";
        pav:authoredOn         "2018-04-23 16:44:14.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0864/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0864/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Rockland VMP 2000";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/184/>;
        skos:definition        "A deep sea tethered microstructure profiler for the measurement of dissipation-scale turbulence in coastal and continental shelf regions in depths of 2000m (note a VMP 750 model is also available). The profiler is equipped with 2x microstructure velocity shear probe, high-resolution temperature sensors (2x FP07 fast thermistors) and an optional Seabird CTD sensors."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL0864";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rockland Scientific Vertical Microstructure Profiler (VMP) 2000"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00677/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2303/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2303";
        dc:date                "2026-04-30 15:37:45.0";
        dc:identifier          "SDN:L22::TOOL2303";
        pav:authoredOn         "2026-04-30 15:37:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2303/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Applied Ocean Sciences BOREALIS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/369/>;
        skos:definition        "A passive acoustic monitoring recorder and edge-processing unit featuring a single-channel Sensor Tech SQ-17 hydrophone, designed for deployment on Sofar Spotter platform buoys in either moored or drifting configurations. It can be used for a range of applications including marine mammal monitoring, EIA's, and for maritime domain awareness such as IUU fishing. It can be used with optional temperature, pressure and conductivity sensors. The system conforms to the open Bristlemouth ecosystem, a standard interface to allow plug-and-play and open source interfaces. Low power consumption (~39 mW) allows for 1TB internal storage (up to ~60 days). Frequency band from 18 Hz to 16 kHz, depth-rated to 100 m, hydrophone sensitivity is -203 dB re 1V/μPa at 20 degC. Sample frequency: 31.25 ksps, pre-amp gain: 30.9 dB."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2303";
        skos:note              "accepted"@en;
        skos:prefLabel         "Applied Ocean Sciences BOREALIS hydrophone"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L35/current/MAN0389/> , <http://vocab.nerc.ac.uk/collection/B75/current/ORG02201/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL2322/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL2322";
        dc:date                "2026-08-06 15:47:41.0";
        dc:identifier          "SDN:L22::TOOL2322";
        pav:authoredOn         "2026-08-06 15:47:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2322/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "JFE HAI";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/113/>;
        skos:definition        "A harmful algal detector designed to identify the presence of two phytoplankton species known to cause harmful algal blooms: Karenia mikimotoi/serifolmis/brevis and Chattonella antiqua/marina. This instrument is designed for monitoring water bodies for the presence of harmful algal blooms; applications include the fisheries industry, coastal management, and use by public health agencies. The HAI sensor outputs measurements of chlorophyll concentration, depth, and temperature, with a derived FSI (Fluorescence Spectral Shift Index) value and estimated cell density. The instrument measures fluorescence intensity at wavelengths 670 nm and 690 nm which it uses to derive the Fluorescence spectral Shift Index (FSI) as the ratio of the two intensities, where a higher FSI indicates peak fluorescence at longer wavelengths. The FSI value quantifies the shift in peak intensity of the fluorescence spectrum; used to indicate the presence of harmful algal blooms. The HAI uses a proprietary algorithm to estimate cell density. It utilizes a Handy Terminal which makes measurements immediately available to the user, connected to the HAI by a 30 m cable. FSI accuracy: Reproducibility +/- 0.05 (0 to 200 ppb). Chlorophyll range: 0 - 400ppb; accuracy: Non-linearity +/- 1 percent FS (0 to 200 ppb). Pressure range: 0 to 0.5 MPa; accuracy: Non-linearity +/- 0.1 percent FS, Reproducibility +/- 0.3 percent FS. Temperature range: -3 to 45 degC; accuracy: +/- 0.02 degC (within range 3 to 31 degC). Pressure resistance is equivalent to 50 m depth."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL2322";
        skos:note              "accepted"@en;
        skos:prefLabel         "JFE Advantech HAI (Harmful Algal Indication) sensor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00979/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0053/> .

<http://vocab.nerc.ac.uk/collection/L22/current/TOOL1549/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L22::TOOL1549";
        dc:date                "2023-02-06 15:36:06.0";
        dc:identifier          "SDN:L22::TOOL1549";
        pav:authoredOn         "2023-02-06 15:36:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1549/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1549/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Vaisala HMP110";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG17/> , <http://vocab.nerc.ac.uk/collection/L05/current/102/>;
        skos:definition        "A humidity and temperature sensor which also measures dew point temperature, wet bulb capacity and ethalpy. It is designed for battery-powered spot-checking applications such as in greenhouses, fermentation and stability chambers. The HMP110 probe features a patented HUMICAP 180 capacitive thin film polymer humidity sensor and a Pt1000 platinum resistance thermometer. It features a rugged polyurethane-filled stainless steel body which can survive rough conditions. An optional RS-485 output with Modbus support is also available. The HMP110 measures humidity from 0-100 percent RH at an accuracy of +/- 1.5 percent RH at 40 degC. It measures temperature from -40 to +80 degC at an accuracy of +/- 0.2 degC."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L22::TOOL1549";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vaisala HMP110 humidity and temperature probe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B75/current/ORG00323/> , <http://vocab.nerc.ac.uk/collection/L35/current/MAN0025/> .

