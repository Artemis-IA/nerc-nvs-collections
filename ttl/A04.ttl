        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A04/current/Landscape/>;
        skos:definition        "Features along the coastline whose form and composition has been determined by natural processes, and are not man-made in origin."@en , "Características a lo largo de la costa que han sido formadas por procesos naturales, y por lo tanto no tienen su origen en procesos antrópicos."@es;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/MIDA/current/> , <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/I03/current/Wetland/> , <http://vocab.nerc.ac.uk/collection/A02/current/RockyShore/> , <http://vocab.nerc.ac.uk/collection/A02/current/Flat/> , <http://vocab.nerc.ac.uk/collection/A02/current/IntertidalWetlands/> , <http://vocab.nerc.ac.uk/collection/A04/current/CoastalTypology/> , <http://vocab.nerc.ac.uk/collection/A04/current/Cliffs/> , <http://vocab.nerc.ac.uk/collection/A04/current/CoastalLagoons/> , <http://vocab.nerc.ac.uk/collection/A02/current/Dune/> , <http://vocab.nerc.ac.uk/collection/A04/current/Saltmarshes/> , <http://vocab.nerc.ac.uk/collection/A02/current/Bluff/>;
        skos:notation          "SDN:A04::NaturalCoastalFeatures";
