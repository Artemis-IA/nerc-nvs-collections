<http://vocab.nerc.ac.uk/collection/A04/current/Soils/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A04::Soils";
        dc:date                "2012-06-27 12:15:46.0";
        dc:identifier          "SDN:A04::Soils";
        pav:authoredOn         "2012-06-27 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A04/current/Soils/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P22/current/16/> , <http://vocab.nerc.ac.uk/collection/A02/current/Soil/> , <http://vocab.nerc.ac.uk/collection/A04/current/TerrestrialGeology/>;
        skos:definition        "The upper layer of the Earth's surface in which plants grow. This typically black or dark brown material, consists of varyiable mixtures of rock particles and fragments, clay, and organic remains and materials. Air spaces and water can often also be considered as constituents."@en , "Se denomina suelo a la parte superficial de la corteza terrestre, biológicamente activa, que tiende a desarrollarse en la superficie de las rocasemergidas por la influencia de la intemperie y de los seres vivos (meteorización).Los suelos son sistemas complejos donde ocurren una vasta gama de procesos químicos, físicos y biológicos que se ven reflejados en la gran variedad de suelos existentes en la tierra. Son muchos los procesos que pueden contribuir a crear un suelo particular, algunos de estos son la deposición eólica, sedimentación en cursos de agua, meteorización, y deposición de material orgánico."@es;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/MIDA/current/> , <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A04/current/SoilTypes/> , <http://vocab.nerc.ac.uk/collection/A02/current/Soil/> , <http://vocab.nerc.ac.uk/collection/P22/current/16/>;
        skos:notation          "SDN:A04::Soils";
        skos:note              "accepted"@en;
        skos:prefLabel         "Soils"@en , "Suelos"@es .

