        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A04/current/Landscape/>;
        skos:definition        "Un área que exhibe un patrón distintivo, reconocible y coherente de los elementos, ya sea natural (suelo, relieve) o humano (por ejemplo, un asentamiento) en el paisaje que hace que un paisaje sea diferente de otro."@es , "An area which exhibits a distinct, recognisable and consistent pattern of elements, be it natural (soil, landform) and/or human (for example settlement and development) in the landscape that makes one landscape different from another, rather than better or worse."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/MIDA/current/>;
        skos:notation          "SDN:A04::LandscapeCharacterAreas";
        skos:note              "accepted"@en;
        skos:prefLabel         "Landscape Character Areas"@en , "Áreas paisajísticas"@es .

<http://vocab.nerc.ac.uk/collection/A04/current/Bedrock/>
