<http://vocab.nerc.ac.uk/collection/A04/current/Marinas/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A04::Marinas";
        dc:date                "2012-06-27 12:15:46.0";
        dc:identifier          "SDN:A04::Marinas";
        pav:authoredOn         "2012-06-27 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A04/current/Marinas/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A04/current/WaterBasedRecreation/> , <http://vocab.nerc.ac.uk/collection/A02/current/Ports/> , <http://vocab.nerc.ac.uk/collection/I03/current/Artificial_Structure/> , <http://vocab.nerc.ac.uk/collection/A01/current/Human_Activity/>;
        skos:definition        "A marina (from Sp. or It. \"marina\", coast or shore) is a specially designed dock or basin with moorings and supplies for pleasure craft, yachts and small boats. A marina differs from a port in that a marina does not handle large passenger ships or cargo from freighters. In the United Kingdom the word marina is also used for inland wharves on rivers and canals that are used exclusively by non-industrial pleasure craft such as canal narrowboats."@en , "Un puerto deportivo es un muelle especialmente diseñado, o cuenca con amarres y suministros para embarcaciones de recreo, yates y pequeñas embarcaciones. Un puerto deportivo difiere de un puerto convencional en que no permite el amarre de cruceros con muchos pasajeros, o barcos de carga. En el Reino Unido la palabra 'marina' (Puerto deportivo en inglés) es también utilizada para embarcaderos marinos, en ríos, canales y lagos, que son utilizados exclusivamente por embarcaciones no industriales, estrictamente de uso recreativo."@es;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/MIDA/current/>;
        skos:notation          "SDN:A04::Marinas";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marinas"@en , "Puertos deportivos"@es .

<http://vocab.nerc.ac.uk/collection/A04/current/Shipwrecks/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A04::Shipwrecks";
