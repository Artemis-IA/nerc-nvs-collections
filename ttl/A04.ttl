<http://vocab.nerc.ac.uk/collection/A04/current/ClimatologicalStations/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A04::ClimatologicalStations";
        dc:date                "2012-06-27 12:15:46.0";
