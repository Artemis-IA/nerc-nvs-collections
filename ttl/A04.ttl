<http://vocab.nerc.ac.uk/collection/A04/current/ErosionTrends/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A04::ErosionTrends";
        dc:date                "2012-06-27 12:15:46.0";
        dc:identifier          "SDN:A04::ErosionTrends";
        pav:authoredOn         "2012-06-27 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A04/current/ErosionTrends/1/>;
        pav:version            "1";
