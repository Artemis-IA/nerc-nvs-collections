<http://vocab.nerc.ac.uk/collection/A04/current/SwellGeneratedWaves/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A04::SwellGeneratedWaves";
        dc:date                "2012-06-27 12:15:46.0";
        dc:identifier          "SDN:A04::SwellGeneratedWaves";
        pav:authoredOn         "2012-06-27 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A04/current/SwellGeneratedWaves/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Swell Waves";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A04/current/WaveHeights/>;
        skos:definition        "Swell waves are long waves or a succession of waves without crests, generated in the open sea by a meteorological event (e.g. gale) and often continue beyond their source. Swell patterns are superimposed on regular wave activity and can significantly increase wave height."@en , "El oleaje de mar de fondo son una sucesión de olas sin crestas, generadas en mar abierto por un evento meteorológico (ej. Vendaval) y suelen continuar más allá de su origen. Los patrones de oleaje están superpuestos a la actividad regular del oleaje y pueden incrementar de manera significativa la medida de las olas."@es;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/MIDA/current/>;
        skos:notation          "SDN:A04::SwellGeneratedWaves";
        skos:note              "accepted"@en;
        skos:prefLabel         "Olas generadas en mar de fondo"@es , "Swell Generated Waves"@en .

