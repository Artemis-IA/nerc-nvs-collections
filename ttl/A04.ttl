        skos:prefLabel         "Local Ferry Ports"@en , "Puertos locales de ferries"@es .

<http://vocab.nerc.ac.uk/collection/A04/current/LandscapeCharacterAreas/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A04::LandscapeCharacterAreas";
