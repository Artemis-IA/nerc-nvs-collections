<http://vocab.nerc.ac.uk/collection/R21/current/7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R21::7";
        dc:date                "2020-05-03 20:29:43.0";
        dc:identifier          "SDN:R21::7";
