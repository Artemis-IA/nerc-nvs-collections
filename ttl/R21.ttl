<http://vocab.nerc.ac.uk/collection/R21/current/5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R21::5";
        dc:date                "2020-05-03 20:29:43.0";
        dc:identifier          "SDN:R21::5";
        pav:authoredOn         "2020-05-03 20:29:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R21/current/5/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "5";
        skos:altLabel          "5"@fr ;
        skos:definition        "Value is the average of the min and max pressure measurements sampled during the drift phase (the precision is 1 bar)"@en;
        skos:definition        "La valeur est la moyenne des mesures de pression min et max échantillonnées pendant la phase de dérive (précision de 1 bar)."@fr ;
        skos:notation          "SDN:R21::5";
        skos:note              "accepted"@en;
        skos:prefLabel         "Value is the average of the min and max pressure measurements sampled during the drift phase (the precision is 1 bar)"@en ;
        skos:prefLabel         "La valeur est la moyenne des mesures de pression min et max échantillonnées pendant la phase de dérive (précision de 1 bar)."@fr .

<http://vocab.nerc.ac.uk/collection/R21/current/6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R21::6";
        dc:date                "2020-05-03 20:29:43.0";
        dc:identifier          "SDN:R21::6";
        pav:authoredOn         "2020-05-03 20:29:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R21/current/6/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "6";
        skos:altLabel          "6"@fr ;
        skos:definition        "Value is the PARKING_PRESSURE meta-data but the float is programmed to sample measurements during the drift phase (i.e. drift measurement is missing)"@en;
        skos:definition        "La valeur est la méta-donnée PARKING_PRESSURE mais le flotteur est programmé pour échantillonner des mesures pendant la phase de dérive (c.-à-d. la mesure de dérive est manquante)."@fr ;
        skos:notation          "SDN:R21::6";
        skos:note              "accepted"@en;
        skos:prefLabel         "Value is the PARKING_PRESSURE meta-data but the float is programmed to sample measurements during the drift phase (i.e. drift measurement is missing)"@en ;
        skos:prefLabel         "La valeur est la méta-donnée PARKING_PRESSURE mais le flotteur est programmé pour échantillonner des mesures pendant la phase de dérive (c.-à-d. la mesure de dérive est manquante)."@fr .

<http://vocab.nerc.ac.uk/collection/R21/current/3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R21::3";
        dc:date                "2020-05-03 20:29:43.0";
        dc:identifier          "SDN:R21::3";
        pav:authoredOn         "2020-05-03 20:29:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R21/current/3/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "3";
        skos:altLabel          "3"@fr ;
        skos:definition        "Value is the median value, directly provided by the float, of the pressure measurements regularly sampled during the drift phase"@en;
        skos:definition        "La valeur est la valeur médiane, fournie directement par le flotteur, des mesures de pression échantillonnées régulièrement pendant la phase de dérive."@fr ;
        skos:notation          "SDN:R21::3";
        skos:note              "accepted"@en;
        skos:prefLabel         "Value is the median value, directly provided by the float, of the pressure measurements regularly sampled during the drift phase"@en ;
        skos:prefLabel         "La valeur est la valeur médiane, fournie directement par le flotteur, des mesures de pression échantillonnées régulièrement pendant la phase de dérive."@fr .

<http://vocab.nerc.ac.uk/collection/R21/current/1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R21::1";
        dc:date                "2020-05-03 20:29:43.0";
        dc:identifier          "SDN:R21::1";
        pav:authoredOn         "2020-05-03 20:29:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R21/current/1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "1";
        skos:altLabel          "1"@fr ;
        skos:definition        "Value is the weighted average of pressure measurements regularly sampled during the drift phase and provided by the float"@en;
        skos:definition        "La valeur est la moyenne pondérée des mesures de pression échantillonnées régulièrement pendant la phase de dérive et fournies par le flotteur."@fr ;
        skos:notation          "SDN:R21::1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Value is the weighted average of pressure measurements regularly sampled during the drift phase and provided by the float"@en ;
        skos:prefLabel         "La valeur est la moyenne pondérée des mesures de pression échantillonnées régulièrement pendant la phase de dérive et fournies par le flotteur."@fr .

