<http://vocab.nerc.ac.uk/collection/R28/current/CB0016/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R28::CB0016";
        dc:date                "2026-09-21 09:56:33.0";
        dc:identifier          "SDN:R28::CB0016";
        pav:authoredOn         "2026-09-21 09:56:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R28/current/CB0016/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "APF8";
        skos:definition        "The APF8 controller board manufactured by Teledyne Webb was used in APEX floats between around 1990-2008. Early APF8 controller board firmware was programmed to truncate all negative surface pressure values to zero."@en;
        skos:notation          "SDN:R28::CB0016";
        skos:note              "accepted"@en;
        skos:prefLabel         "APF8"@en .

<http://vocab.nerc.ac.uk/collection/R28/current/CB0014/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R28::CB0014";
        dc:date                "2026-09-21 09:56:33.0";
        dc:identifier          "SDN:R28::CB0014";
        pav:authoredOn         "2026-09-21 09:56:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R28/current/CB0014/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "APF11";
        skos:definition        "The APF11 controller board manufactured by Teledyne Webb for APEX floats controls the air and buoyancy pumps and interfaces with the GPS receiver, the Iridium modem, the CTD, and any additionally installed science sensors. It also includes the float's microcomputer, an internal clock, operational firmware and program and data memory, and it inputs and processes signals from a leak detector and internal temperature, pressure and humidity sensors. APF11 accommodates up to eight sensors, in addition to the conductivity, temperature and depth (CTD) sensors http://www.teledynemarine.com/news/enabling-apex-to-do-more-teledyne-webb-research-releases-apf-11-controller-and-firmware."@en;
        skos:notation          "SDN:R28::CB0014";
        skos:note              "accepted"@en;
        skos:prefLabel         "APF11"@en .

