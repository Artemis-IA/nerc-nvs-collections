<http://vocab.nerc.ac.uk/collection/R28/current/CB0017/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R28::CB0017";
        dc:date                "2026-09-21 09:56:33.0";
        dc:identifier          "SDN:R28::CB0017";
        pav:authoredOn         "2026-09-21 09:56:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R28/current/CB0017/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "APF7";
        skos:definition        "The APF7 controller board manufactured by Teledyne Webb is a legacy board found in older APEX floats to manage data logging and transmissions through the ARGOS satellite network.  Surface pressure from APF7 controller boards was truncated to zero."@en;
        skos:notation          "SDN:R28::CB0017";
        skos:note              "accepted"@en;
        skos:prefLabel         "APF7"@en .

<http://vocab.nerc.ac.uk/collection/R28/current/CB0015/>
