<http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Flooding/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I03::Coastal_Flooding";
        dc:date                "2013-06-18 09:32:07.0";
        dc:identifier          "SDN:I03::Coastal_Flooding";
        pav:authoredOn         "2013-06-18 09:32:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Flooding/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Coastal Flood";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A02/current/Flood/> , <http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Hazard/> , <http://vocab.nerc.ac.uk/collection/A04/current/Flooding/> , <http://vocab.nerc.ac.uk/collection/A01/current/Shoreline_Erosion_Flooding_and_Submergence/>;
        skos:definition        "Elevation du niveau d'eau dans les zones cotieres due a des flux forts et prolonges de vent, d'eau ou de vagues."@fr , "Prolonged strong onshore flow of wind, water, or waves causing a rise in water level that floods coastal areas"@en , "Un prolongado viento fuerte desde el interior, mayor aportacion de agua o un oleaje alto causan un aumento en el nivel del agua que puede inundar las zonas costeras.  "@es;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/WCATHES/current/>;
        skos:notation          "SDN:I03::Coastal_Flooding";
        skos:note              "accepted"@en;
        skos:prefLabel         "Inondation Cotiere"@fr , "Inundacion Costera"@es , "Coastal Flooding"@en .

<http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Erosion/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I03::Coastal_Erosion";
        dc:date                "2013-06-18 09:32:07.0";
        dc:identifier          "SDN:I03::Coastal_Erosion";
        pav:authoredOn         "2013-06-18 09:32:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Erosion/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A02/current/Erosion/> , <http://vocab.nerc.ac.uk/collection/A04/current/CoastalErosion/> , <http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Hazard/> , <http://vocab.nerc.ac.uk/collection/A01/current/Shoreline_Erosion_Flooding_and_Submergence/>;
        skos:definition        "La erosion costera es la perdida de superficie, playa o sedimentos de dunas por la accion del oleaje, de las mareas, de las corrientes o el drenaje."@es , "Coastal erosion is the wearing away of land or the removal of beach or dune sediments by wave action, tidal currents, wave currents, or drainage"@en , "L'erosion cotiere est l'enlevement ou deplacement des sediments des plages ou des dunes, cause par l'action combinee de la mer et des facteurs climatiques tels que les niveaux d'eau, les glaces, les tempetes les precipitations et le gel-degel."@fr;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/WCATHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A04/current/CoastalErosion/>;
        skos:notation          "SDN:I03::Coastal_Erosion";
        skos:note              "accepted"@en;
        skos:prefLabel         "Erosion Costera"@es , "Coastal Erosion"@en , "Erosion Cotiere"@fr .

<http://vocab.nerc.ac.uk/collection/I03/current/Coastal_Hazard/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I03::Coastal_Hazard";
