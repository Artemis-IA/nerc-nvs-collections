<http://vocab.nerc.ac.uk/collection/I03/current/Shore_Geomorphology/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I03::Shore_Geomorphology";
        dc:date                "2013-06-18 09:32:07.0";
        dc:identifier          "SDN:I03::Shore_Geomorphology";
        pav:authoredOn         "2013-06-18 09:32:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I03/current/Shore_Geomorphology/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Shoreline Geomorphology";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A04/current/CoastalGeomorphology/> , <http://vocab.nerc.ac.uk/collection/A03/current/ShorelineGeomorphology/> , <http://vocab.nerc.ac.uk/collection/A01/current/Natural_Processes/>;
        skos:definition        "The study of the morphological development and evolution of the shore of a coast as it acts under the influence of winds, waves, currents, and water level changes"@en , "Etude du developpement et de l'evolution morphologique (forme, relief) de la ligne de cote sous l'effet du vent, des vagues, des courents et de changements du niveau d'eau."@fr , "El estudio del desarrollo morfologico y la evolucion de la costa bajo la influencia del viento, olas, corrientes, y nivel del agua."@es;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/I03/current/Bedrock_Coast/> , <http://vocab.nerc.ac.uk/collection/I03/current/Low_Bank/> , <http://vocab.nerc.ac.uk/collection/I03/current/Beach/> , <http://vocab.nerc.ac.uk/collection/I03/current/Unclassified/> , <http://vocab.nerc.ac.uk/collection/A04/current/CoastalGeomorphology/> , <http://vocab.nerc.ac.uk/collection/I03/current/Bluff/> , <http://vocab.nerc.ac.uk/collection/I03/current/Wetland/> , <http://vocab.nerc.ac.uk/collection/A03/current/ShorelineGeomorphology/> , <http://vocab.nerc.ac.uk/collection/I03/current/Artificial_Structure/>;
        skos:notation          "SDN:I03::Shore_Geomorphology";
        skos:note              "accepted"@en;
        skos:prefLabel         "Geomorphologie de la cote"@fr , "Shore Geomorphology"@en , "Geomorfologia Costera"@es;
        skos:topConceptOf      <http://vocab.nerc.ac.uk/scheme/WCATHES/current/> .

