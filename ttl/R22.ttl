<http://vocab.nerc.ac.uk/collection/R22/current/POLAR_OCEAN_PROFILING_SYSTEM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R22::POLAR_OCEAN_PROFILING_SYSTEM";
        dc:date                "2020-05-03 20:29:53.0";
        dc:identifier          "SDN:R22::POLAR_OCEAN_PROFILING_SYSTEM";
        pav:authoredOn         "2020-05-03 20:29:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R22/current/POLAR_OCEAN_PROFILING_SYSTEM/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "POLAR_OCEAN_PROFILING_SYSTEM";
        skos:definition        "Ice platform that provides meteorological data is paired with a subsurface platform, either a PROVOR or NEMO float tethered along a cable that uses buoyancy to go up and down."@en;
        skos:notation          "SDN:R22::POLAR_OCEAN_PROFILING_SYSTEM";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ice platform providing meteorological data paired with tethered subsurface platform using buoyancy to go up and down"@en .

<http://vocab.nerc.ac.uk/collection/R22/current/ICE_TETHERED_PROFILER/>
        rdf:type               skos:Concept;
