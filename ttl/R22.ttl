        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ICE_TETHERED_PROFILER";
        skos:definition        "Surface ice-mounted platform that provides meteorological data and subsurface profiler tethered to a cable that uses a motor to go up and down."@en;
        skos:notation          "SDN:R22::ICE_TETHERED_PROFILER";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ice platform providing meteorological data paired with tethered subsurface profiler using motor to go up and down"@en .

