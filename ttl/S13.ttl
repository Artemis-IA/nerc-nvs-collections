        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Term to be used when the property reported is said to be the characteristic of a bloom. An algal bloom is defined as a rapid increase and accumulation of algal biomass in water bodies including, for macroalgal blooms, intertidal areas. For more information see: https://en.wikipedia.org/wiki/Algal_bloom."@en;
        skos:notation          "SDN:S13::S1366";
        skos:note              "accepted"@en;
        skos:prefLabel         "bloom"@en .

