<http://vocab.nerc.ac.uk/collection/S13/current/S1367/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S13::S1367";
        dc:date                "2023-02-22 23:34:55.0";
        dc:identifier          "SDN:S13::S1367";
        pav:authoredOn         "2023-02-22 23:34:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S13/current/S1367/1/>;
