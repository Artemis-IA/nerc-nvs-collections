        skos:definition        "In the marine environment, epiphytes may be any organism (e.g. algae, fungi, sponges, bryozoans, ascidians, crustaceans, molluscs and any other sessile organism) that grow on the surface of seagrasses or macroalgae."@en;
        skos:notation          "SDN:S13::S1356";
        skos:note              "accepted"@en;
        skos:prefLabel         "epiphytes"@en .

