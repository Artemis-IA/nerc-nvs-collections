        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Term to be used when the property reported is said to be the characteristic of a stranding. The term applies to marine organisms (animals or seaweeds) found washed up on the shore in a dead, dying or abnormal state."@en;
        skos:notation          "SDN:S13::S1367";
        skos:note              "accepted"@en;
        skos:prefLabel         "stranding"@en .

<http://vocab.nerc.ac.uk/collection/S13/current/S1366/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S13::S1366";
        dc:date                "2023-02-22 23:34:04.0";
        dc:identifier          "SDN:S13::S1366";
