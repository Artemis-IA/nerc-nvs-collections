<http://vocab.nerc.ac.uk/collection/GGS/current/SID1300/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GGS::SID1300";
        dc:date                "2016-03-14 10:38:30.0";
        dc:identifier          "SDN:GGS::SID1300";
        pav:authoredOn         "2016-03-14 10:38:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GGS/current/SID1300/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GGS/current/SID1300/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P01/current/GEBCOSRC/>;
        skos:definition        "{\"node\": {\n    \"references_and_links\": \"Schenke, Hans Werner; Hinze, Heinrich; Dijkstra, Semme J; Hoppmann, Bernd; Niederjasper, Fred; Schöne, Tilo (1997): AWI Bathymetric Chart of the Weddell Sea, Antarctica (BCWS). Alfred Wegener Institute, Helmholtz Center for Polar and Marine Research, Bremerhaven, doi:10.1594/PANGAEA.708081\",\n    \"definition\": \"The grid value at this location is taken from the GEBCO_08 Grid. In this area the GEBCO_08 Grid is based on a gridded data set for the Weddell Sea area. This grid has been generated from a data set of bathymetric contours based largely on multibeam and single-beam bathymetric surveys. The grid cell at this location is 'crossed' by trackline control information, i.e. survey track or isolated sounding, from the Weddell Sea source data set. For the Weddell Sea grid, cells that do not contain trackline control are coded as '130'.\"\n}}"@en;
        skos:notation          "SDN:GGS::SID1300";
        skos:note              "accepted"@en;
        skos:prefLabel         "GEBCO_data_source_ID_1300"@en .

