        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "3DSeisRefl";
        skos:definition        "The elucidation of structure beneath sea-bed determined by the reflection of seismic energy along multiple parallel tracks."@en;
        skos:notation          "SDN:GS9::SR3D";
        skos:note              "accepted"@en;
        skos:prefLabel         "Three-dimensional seismic reflection"@en .

