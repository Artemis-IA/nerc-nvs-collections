<http://vocab.nerc.ac.uk/collection/GS9/current/SR2D/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS9::SR2D";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS9::SR2D";
        pav:authoredOn         "2011-01-28 12:26:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS9/current/SR2D/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "2DSeisRefl";
        skos:definition        "The elucidation of structure beneath sea-bed determined by the reflection of seismic energy along a single track."@en;
        skos:notation          "SDN:GS9::SR2D";
        skos:note              "accepted"@en;
        skos:prefLabel         "Two-dimensional seismic reflection"@en .

<http://vocab.nerc.ac.uk/collection/GS9/current/SR4D/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS9::SR4D";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS9::SR4D";
        pav:authoredOn         "2011-01-28 12:26:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS9/current/SR4D/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "4DSeisImag";
        skos:definition        "The elucidation of structure beneath sea-bed determined by the reflection of seismic energy acquired in multiple surveys at different times but with the aim of comparing and amalgamating them."@en;
        skos:notation          "SDN:GS9::SR4D";
        skos:note              "accepted"@en;
        skos:prefLabel         "Four-dimensional seismic imaging"@en .

<http://vocab.nerc.ac.uk/collection/GS9/current/SR3D/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS9::SR3D";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS9::SR3D";
        pav:authoredOn         "2011-01-28 12:26:26.0";
