        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The surface of the water body has undulations corresponding to a significant wave height of 0 - 0.10 metres"@en;
        skos:notation          "SDN:C39::1";
        skos:note              "accepted"@en;
        skos:prefLabel         "calm (rippled)"@en .

