<http://vocab.nerc.ac.uk/collection/L12/current/U/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L12::U";
        dc:date                "2010-02-12 15:53:48.0";
        dc:identifier          "SDN:L12::U";
        pav:authoredOn         "2010-02-12 15:53:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L12/current/U/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Unknown";
        skos:definition        "The correct value is not known to, or not computable by, the sender of this data. However, the correct value probably exists."@en;
        skos:notation          "SDN:L12::U";
        skos:note              "accepted"@en;
        skos:prefLabel         "Unknown"@en .

<http://vocab.nerc.ac.uk/collection/L12/current/R/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L12::R";
        dc:date                "2008-11-24 15:36:58.0";
        dc:identifier          "SDN:L12::R";
        pav:authoredOn         "2008-11-24 15:36:58.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L12/current/R/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Real-time QC";
        skos:definition        "Automatic validation checks have been applied to the data as they were collected prior to their initial publication"@en;
        skos:notation          "SDN:L12::R";
        skos:note              "accepted"@en;
        skos:prefLabel         "Real-time validation on the data"@en .

<http://vocab.nerc.ac.uk/collection/L12/current/A/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L12::A";
        dc:date                "2008-11-24 15:38:03.0";
        dc:identifier          "SDN:L12::A";
        pav:authoredOn         "2008-11-24 15:38:03.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L12/current/A/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Real-time + delayed mode QC";
        skos:definition        "Automatic validation checks were applied to the data as they were collected prior to their initial publication.Validation checks, including both algorithms and manual examination, were applied to the data subsequent to their initial publication."@en;
        skos:notation          "SDN:L12::A";
        skos:note              "accepted"@en;
        skos:prefLabel         "Real-time plus delayed mode validation on the data"@en .

