        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "3";
        skos:definition        "These measurements are not to be used without scientific adjustment, e.g. data affected by sensor drift but may be adjusted in delayed-mode."@en;
        skos:notation          "SDN:RR2::3";
        skos:note              "accepted"@en;
        skos:prefLabel         "Probably bad data that are potentially adjustable"@en .

<http://vocab.nerc.ac.uk/collection/RR2/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the Argo data system, published and maintained by the Argo Data Management Team (ADMT) and hosted on the NERC Vocabulary Server.";
        rdfs:seeAlso            <https://github.com/OneArgo/ArgoVocabs>;
        dc:alternative          "RT_QC_FLAG";
        dc:creator              "Argo Data Management Team";
        dc:date                 "2024-04-19 03:00:08.0";
        dc:description          "Quality flag scale for real-time measurements. Argo netCDF {param}_QC when data_mode='R' and {param}_ADJUSTED_QC when data_mode='A' are populated by RR2 altLabel, with {param} consisting of R03 altLabels. Associated FillValue is an empty space in Argo NetCDF file. This case can occur, e.g., in Argo multi-cycle files when the maximum number of vertical levels is not reached by a cycle, or for levels not concerning a specific sensor, or for sampling schemes not concerning a sensor.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Argo real-time quality control measurement flags";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Argo Data Management Team";
        owl:versionInfo         "1";
        skos:altLabel           "RT_QC_FLAG";
        skos:member             <http://vocab.nerc.ac.uk/collection/RR2/current/0/> , <http://vocab.nerc.ac.uk/collection/RR2/current/8/> , <http://vocab.nerc.ac.uk/collection/RR2/current/2/> , <http://vocab.nerc.ac.uk/collection/RR2/current/1/> , <http://vocab.nerc.ac.uk/collection/RR2/current/5/> , <http://vocab.nerc.ac.uk/collection/RR2/current/9/> , <http://vocab.nerc.ac.uk/collection/RR2/current/3/> , <http://vocab.nerc.ac.uk/collection/RR2/current/4/>;
        skos:prefLabel          "Argo real-time quality control measurement flags" .
