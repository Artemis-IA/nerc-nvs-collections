<http://vocab.nerc.ac.uk/collection/RR2/current/4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RR2::4";
        dc:date                "2024-04-18 10:15:35.0";
        dc:identifier          "SDN:RR2::4";
        pav:authoredOn         "2024-04-18 10:15:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RR2/current/4/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/RR2/current/4/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "4";
        skos:definition        "These measurements are not to be used. A flag '4' indicates that a relevant real-time quality control test has failed. A flag '4' may also be assigned for bad measurements that are known to be not adjustable, e.g. due to sensor failure."@en;
        skos:notation          "SDN:RR2::4";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bad data"@en .

<http://vocab.nerc.ac.uk/collection/RR2/current/3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RR2::3";
