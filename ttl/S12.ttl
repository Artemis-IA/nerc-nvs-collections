        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Stem of a siphonophore colony to which feeding, reproductive, defensive and buoyant zooid units are attached."@en;
        skos:definition        "Tige d'une colonie de siphonophores à laquelle sont attachées les unités de zooïdes d'alimentation, de reproduction, de défense et de sustentation."@fr ;
        skos:notation          "SDN:S12::S1285";
        skos:note              "accepted"@en;
        skos:prefLabel         "siphosome"@en ;
        skos:prefLabel         "siphosome"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1273/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1273";
        dc:date                "2021-07-07 09:41:18.0";
        dc:identifier          "SDN:S12::S1273";
        pav:authoredOn         "2021-07-07 09:41:18.0";
