        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The fused head and thorax region of certain arthropods, primarily arachnids."@en;
        skos:definition        "La région fusionnée tête-thorax de certains arthropodes, principalement les arachnides."@fr ;
        skos:notation          "SDN:S12::S1291";
        skos:note              "accepted"@en;
        skos:prefLabel         "prosoma"@en ;
        skos:prefLabel         "prosoma"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1276/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1276";
        dc:date                "2021-09-20 15:35:31.0";
        dc:identifier          "SDN:S12::S1276";
