        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "An appendage, usually paired, under the abdomen of male cartilaginous fishes like sharks or rays, or at the end of the abdomen of a male insect, used to hold the female during copulation."@en;
        skos:definition        "Appendice, généralement pair, sous l'abdomen des poissons cartilagineux mâles comme les requins ou les raies, ou à l'extrémité de l'abdomen d'un insecte mâle, utilisé pour maintenir la femelle pendant l'accouplement."@fr ;
        skos:notation          "SDN:S12::S1267";
        skos:note              "accepted"@en;
        skos:prefLabel         "clasper"@en ;
        skos:prefLabel         "pédipalp griffeur"@fr .

