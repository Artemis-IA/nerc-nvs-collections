<http://vocab.nerc.ac.uk/collection/S12/current/S1247/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1247";
        dc:date                "2016-04-06 08:35:27.0";
        dc:identifier          "SDN:S12::S1247";
        pav:authoredOn         "2016-04-06 08:35:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1247/1/>;
