        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The lungs are the primary organs of respiration in humans and many other animals including a few fish and some snails. In mammals and most other vertebrates, two lungs are located near the backbone on either side of the heart. Their function in the respiratory system is to extract oxygen from the atmosphere and transfer it into the bloodstream, and to release carbon dioxide from the bloodstream into the atmosphere, in a process of gas exchange."@en;
        skos:notation          "SDN:S12::S1247";
        skos:note              "accepted"@en;
        skos:prefLabel         "lung"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/S25/current/BE007880/> , <http://vocab.nerc.ac.uk/collection/S25/current/BE007895/> , <http://vocab.nerc.ac.uk/collection/S25/current/BE007896/> , <http://vocab.nerc.ac.uk/collection/S25/current/BE007879/> , <http://vocab.nerc.ac.uk/collection/S25/current/BE007903/> .

