        skos:definition        "La partie tubulaire basale d'une feuille de graminée qui entoure la tige."@fr ;
        skos:notation          "SDN:S12::S1287";
        skos:note              "accepted"@en;
        skos:prefLabel         "leaf sheath"@en ;
        skos:prefLabel         "gaine foliaire"@fr .

