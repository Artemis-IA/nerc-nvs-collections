        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The umbrella-shaped body part of a medusozoan Cnidaria (jellyfish). It can pulsate to provide propulsion."@en;
        skos:definition        "Partie du corps en forme de cloche d'un cnidaria médusozoaire (méduse). Elle peut pulser pour assurer la propulsion."@fr ;
        skos:notation          "SDN:S12::S1263";
        skos:note              "accepted"@en;
        skos:prefLabel         "bell"@en ;
        skos:prefLabel         "ombrelle"@fr .

