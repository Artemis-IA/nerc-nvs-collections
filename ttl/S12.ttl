        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The posterior of the two or three main divisions of the body of certain invertebrates."@en;
        skos:definition        "La partie postérieure des deux ou trois divisions principales du corps de certains invertébrés."@fr ;
        skos:notation          "SDN:S12::S1272";
        skos:note              "accepted"@en;
        skos:prefLabel         "metasome"@en ;
        skos:prefLabel         "métasome"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1296/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1296";
        dc:date                "2025-12-12 10:26:24.0";
        dc:identifier          "SDN:S12::S1296";
        pav:authoredOn         "2025-12-12 10:26:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1296/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A muscular, tubular structure located posterior to the mouth and anterior to the esophagus, functioning as a conduit for food, liquids, and in some taxa, air."@en;
        skos:definition        "Structure musculaire tubulaire située en arrière de la bouche et en avant de l'œsophage, servant de conduit pour les aliments, les liquides et, chez certains taxons, l'air."@fr ;
        skos:notation          "SDN:S12::S1296";
        skos:note              "accepted"@en;
        skos:prefLabel         "pharyngeal region"@en ;
        skos:prefLabel         "région pharyngée"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1265/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1265";
        dc:date                "2021-07-07 09:41:04.0";
        dc:identifier          "SDN:S12::S1265";
        pav:authoredOn         "2021-07-07 09:41:04.0";
