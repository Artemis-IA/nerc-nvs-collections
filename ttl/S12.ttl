        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The bones or cartilages of the part of the foot between the metatarsus and the leg; also the foot of an insect or a crustacean, usually consisting of two to five joints."@en;
        skos:definition        "Les os ou cartilages de la partie du pied entre le métatarse et la jambe ; aussi le pied d'un insecte ou d'un crustacé, généralement composé de deux à cinq articles."@fr ;
        skos:notation          "SDN:S12::S1273";
        skos:note              "accepted"@en;
        skos:prefLabel         "tarsus"@en ;
        skos:prefLabel         "tarse"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1261/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1261";
        dc:date                "2021-06-24 13:02:19.0";
        dc:identifier          "SDN:S12::S1261";
        pav:authoredOn         "2021-06-24 13:02:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1261/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.ices.dk/services/rdf/collection/MATRX/BA>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A series of fringed keratin plates located in the upper jaw of certain whale species' mouths. Baleen is used as a filter-feeding mechanism whereby food sources such as krill, copepods and small fish are filtered from seawater entering a whale's mouth."@en;
        skos:definition        "Une série de plaques de kératine frangées situées dans la mâchoire supérieure de la bouche de certaines espèces de baleines. Les fanons servent de mécanisme de filtration par lequel les sources de nourriture comme le krill, les copépodes et les petits poissons sont filtrés de l'eau de mer entrant dans la bouche de la baleine."@fr ;
        skos:notation          "SDN:S12::S1261";
        skos:note              "accepted"@en;
        skos:prefLabel         "baleen"@en ;
        skos:prefLabel         "fanons"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1291/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1291";
        dc:date                "2025-08-07 14:12:49.0";
