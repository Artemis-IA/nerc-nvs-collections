<http://vocab.nerc.ac.uk/collection/S12/current/S1294/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1294";
        dc:date                "2025-12-08 15:27:09.0";
        dc:identifier          "SDN:S12::S1294";
