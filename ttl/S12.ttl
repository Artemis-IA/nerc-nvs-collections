        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The cephalic part of an organism, usually located at one end of the body, which contains the highest density of neurons, and often other sense organs."@en;
        skos:definition        "La partie céphalique d'un organisme, généralement située à une extrémité du corps, qui contient la plus forte densité de neurones et souvent d'autres organes sensoriels."@fr ;
        skos:notation          "SDN:S12::S1270";
        skos:note              "accepted"@en;
        skos:prefLabel         "head"@en ;
        skos:prefLabel         "tête"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1278/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1278";
        dc:date                "2022-05-13 10:07:39.0";
        dc:identifier          "SDN:S12::S1278";
        pav:authoredOn         "2022-05-13 10:07:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1278/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The part of a plant which attaches it to the ground or to a support, typically underground, conveying water and nourishment to the rest of the plant via numerous branches and fibres."@en;
        skos:definition        "La partie d'une plante qui l'ancre au sol ou à un support, généralement sous terre, et qui conduit eau et nutriments au reste de la plante via de nombreuses ramifications et fibres."@fr ;
        skos:notation          "SDN:S12::S1278";
        skos:note              "accepted"@en;
        skos:prefLabel         "roots"@en ;
        skos:prefLabel         "racines"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S12103/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S12103";
        dc:date                "2026-03-31 15:47:32.0";
        dc:identifier          "SDN:S12::S12103";
