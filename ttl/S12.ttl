        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The anterior of the two or three main divisions of the body of certain invertebrates."@en;
        skos:notation          "SDN:S12::S1271";
        skos:note              "accepted"@en;
        skos:prefLabel         "prosome"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1279/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1279";
        dc:date                "2022-05-13 10:09:32.0";
        dc:identifier          "SDN:S12::S1279";
        pav:authoredOn         "2022-05-13 10:09:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1279/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The underground structures of a plant including the rhizomes which are subterranean horizontal stems from which roots and shoots can grow; and roots which are the parts of a plant which attach it to the ground or to a support, typically underground, conveying water and nourishment to the rest of the plant via numerous branches and fibres."@en;
        skos:notation          "SDN:S12::S1279";
        skos:note              "accepted"@en;
        skos:prefLabel         "roots+rhizomes"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1268/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1268";
        dc:date                "2021-07-07 09:41:10.0";
        dc:identifier          "SDN:S12::S1268";
        pav:authoredOn         "2021-07-07 09:41:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1268/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The lower part of an organism's two-part beak or beak-like projecting structure. The term is used in reference to cetaceans, crustaceans, cephalopods and some fishes."@en;
        skos:notation          "SDN:S12::S1268";
        skos:note              "accepted"@en;
        skos:prefLabel         "lower rostrum"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1262/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1262";
        dc:date                "2021-07-07 09:54:22.0";
        dc:identifier          "SDN:S12::S1262";
        pav:authoredOn         "2021-07-07 09:54:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1262/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S12/current/S1262/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Also called pallium, plural pallia, or palliums, in biology, a soft covering, formed from the body wall, of brachiopods and molluscs; also, the fleshy outer covering, sometimes strengthened by calcified plates, of barnacles. (www.britannica.com)"@en;
        skos:notation          "SDN:S12::S1262";
        skos:note              "accepted"@en;
        skos:prefLabel         "mantle"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1286/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1286";
