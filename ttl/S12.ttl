        skos:definition        "The sum of substances (nutrients, neurotransmitters) which are present within a biological cell in a storage capacity."@en;
        skos:definition        "Somme des substances (nutriments, neurotransmetteurs) présentes dans une cellule biologique à titre de réserve."@fr ;
        skos:notation          "SDN:S12::S1283";
        skos:note              "accepted"@en;
        skos:prefLabel         "intracellular reserve pool"@en ;
        skos:prefLabel         "réserve intracellulaire"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1263/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1263";
