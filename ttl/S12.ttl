        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Bony or chitinous case or shield covering the back or part of the back of some animals like turtles or crabs."@en;
        skos:definition        "Carapace ou bouclier osseux ou chitineux couvrant le dos ou une partie du dos de certains animaux comme les tortues ou les crabes."@fr ;
        skos:notation          "SDN:S12::S1265";
        skos:note              "accepted"@en;
        skos:prefLabel         "carapace"@en ;
        skos:prefLabel         "carapace"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1280/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1280";
