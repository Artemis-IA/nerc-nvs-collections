        skos:altLabel          "capsule à œufs"@fr ;
        skos:definition        "Casing that surrounds the eggs of oviparous sharks, skates, and chimaeras (cartilaginous fishes, members of the Chondrichthyes class)."@en;
        skos:definition        "Enveloppe qui entoure les œufs des requins ovipares, raies et chimères (poissons cartilagineux, membres de la classe des Chondrichthyes)."@fr ;
        skos:notation          "SDN:S12::S1259";
        skos:note              "accepted"@en;
        skos:prefLabel         "egg case"@en ;
        skos:prefLabel         "capsule à œufs"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1292/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1292";
        dc:date                "2025-08-07 16:23:43.0";
        dc:identifier          "SDN:S12::S1292";
        pav:authoredOn         "2025-08-07 16:23:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1292/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The posterior part of an animal's body, typically extending beyond the main trunk. In vertebrates, it may include vertebrae, musculature, and skin. In invertebrates, the tail may refer to a terminal body region or appendage with species-specific structure and function."@en;
        skos:definition        "La partie postérieure du corps d'un animal, s'étendant généralement au-delà du tronc principal. Chez les vertébrés, elle peut comprendre vertèbres, musculature et peau. Chez les invertébrés, la queue peut désigner une région corporelle terminale ou un appendice à structure et fonction spécifiques de l'espèce."@fr ;
        skos:notation          "SDN:S12::S1292";
        skos:note              "accepted"@en;
        skos:prefLabel         "tail"@en ;
        skos:prefLabel         "queue"@fr .

