        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The stalk or stem of plants (including macroalgae) and fungi."@en;
        skos:notation          "SDN:S12::S1286";
        skos:note              "accepted"@en;
        skos:prefLabel         "stipe"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1295/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1295";
        dc:date                "2025-12-12 10:25:37.0";
        dc:identifier          "SDN:S12::S1295";
        pav:authoredOn         "2025-12-12 10:25:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1295/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The main section of the body of an animal, excluding the head, neck, and limbs/tail. In Sipuncula this is the larger, unsegmented, and typically bulbous posterior portion of the worm's body into which its narrower anterior section, the introvert, can be fully retracted."@en;
        skos:notation          "SDN:S12::S1295";
        skos:note              "accepted"@en;
        skos:prefLabel         "trunk region"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1275/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1275";
        dc:date                "2021-08-25 08:28:39.0";
        dc:identifier          "SDN:S12::S1275";
        pav:authoredOn         "2021-08-25 08:28:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1275/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The central body part of a starfish (Asteroidea) also known as sea star, containing the internal organs, and the mouth and anus, and from which arms arms radiate. The radius of the central disc is used as a standard biometric measurement in starfish studies."@en;
        skos:notation          "SDN:S12::S1275";
        skos:note              "accepted"@en;
        skos:prefLabel         "central disc"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1288/>
        rdf:type               skos:Concept;
