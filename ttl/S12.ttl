        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The space on the top or front of the head located between the inner edges of two compound eyes, in entomology this is also known as the vertex."@en;
        skos:definition        "L'espace situé en haut ou à l'avant de la tête entre les bords internes de deux yeux composés ; en entomologie, on l'appelle aussi le vertex."@fr ;
        skos:notation          "SDN:S12::S12103";
        skos:note              "accepted"@en;
        skos:prefLabel         "interocular space"@en ;
        skos:prefLabel         "espace interoculaire"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1299/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1299";
        dc:date                "2025-12-12 10:31:35.0";
        dc:identifier          "SDN:S12::S1299";
        pav:authoredOn         "2025-12-12 10:31:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1299/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "VRM";
        skos:altLabel          "VRM"@fr ;
        skos:definition        "A retractable, tubular anterior body region found in several invertebrate phyla, typically bearing the mouth and associated feeding or sensory structures. The introvert can be extended for feeding or interaction with the environment and retracted into the main body for protection."@en;
        skos:definition        "Une région corporelle antérieure tubulaire rétractile présente dans plusieurs embranchements d'invertébrés, portant généralement la bouche et les structures d'alimentation ou sensorielles associées. L'introvert peut être déployé pour l'alimentation ou l'interaction avec l'environnement et rétracté dans le corps principal pour se protéger."@fr ;
        skos:notation          "SDN:S12::S1299";
        skos:note              "accepted"@en;
        skos:prefLabel         "introvert"@en ;
        skos:prefLabel         "introvert"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1285/>
