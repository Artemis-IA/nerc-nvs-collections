        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "One of generally five (but, in some species, more) appendages of a starfish (also known as sea stars) that radiate from the central disc."@en;
        skos:definition        "L'un des cinq appendices en général (mais plus chez certaines espèces) d'une étoile de mer, radiants à partir du disque central."@fr ;
        skos:notation          "SDN:S12::S1276";
        skos:note              "accepted"@en;
        skos:prefLabel         "starfish arm"@en ;
        skos:prefLabel         "bras d'étoile de mer"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1264/>
        rdf:type               skos:Concept;
