        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A term used to refer to the flesh of crabs extracted from the main body cavity and consisting of the hepatopancreas (digestive gland) and reproductive organs."@en;
        skos:definition        "Terme désignant la chair des crabes extraite de la cavité corporelle principale et composée de l'hépatopancréas (glande digestive) et des organes reproducteurs."@fr ;
        skos:notation          "SDN:S12::S1281";
        skos:note              "accepted"@en;
        skos:prefLabel         "brown meat"@en ;
        skos:prefLabel         "chair brune"@fr .

<http://vocab.nerc.ac.uk/collection/S12/current/S1270/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1270";
        dc:date                "2021-07-07 09:41:13.0";
        dc:identifier          "SDN:S12::S1270";
