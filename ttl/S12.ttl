        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The body region formed by the fusion of one or more thoracic segments with the head."@en;
        skos:definition        "La région du corps formée par la fusion d'un ou plusieurs segments thoraciques avec la tête."@fr ;
        skos:notation          "SDN:S12::S1288";
        skos:note              "accepted"@en;
        skos:prefLabel         "cephalothorax"@en ;
        skos:prefLabel         "céphalothorax"@fr .

