        skos:notation          "SDN:S12::S1272";
        skos:note              "accepted"@en;
        skos:prefLabel         "metasome"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1296/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1296";
        dc:date                "2025-12-12 10:26:24.0";
        dc:identifier          "SDN:S12::S1296";
