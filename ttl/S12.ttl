        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "jaw elements";
        skos:definition        "A combination of hardened, articulated mouthparts typically used for grasping or manipulating food. Jaw configurations are found in varying complexities both in vertebrates and invertebrates and can include paired maxillae and mandibles, grasping fangs or stylets, and assorted teeth."@en;
        skos:notation          "SDN:S12::S1294";
        skos:note              "accepted"@en;
        skos:prefLabel         "jaw apparatus"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S1297/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S1297";
        dc:date                "2025-12-12 10:27:28.0";
        dc:identifier          "SDN:S12::S1297";
        pav:authoredOn         "2025-12-12 10:27:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S1297/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "DRM";
        skos:definition        "A paired or singular longitudinal muscle located dorsally in the body cavity of various invertebrates, responsible for retracting anterior structures such as the introvert, proboscis, or feeding appendages toward the dorsal body wall. It typically originates on the dorsal internal body wall and inserts on the anterior organ or structure it retracts."@en;
        skos:notation          "SDN:S12::S1297";
        skos:note              "accepted"@en;
        skos:prefLabel         "dorsal retractor muscle"@en .

<http://vocab.nerc.ac.uk/collection/S12/current/S12101/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S12::S12101";
        dc:date                "2025-12-19 11:46:04.0";
        dc:identifier          "SDN:S12::S12101";
        pav:authoredOn         "2025-12-19 11:46:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S12/current/S12101/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "An elongated appendage from the head or mouth region of an organism. In invertebrates the proboscis is typically a tubular feeding or sucking organ but it can also be involved in the capture of prey or locomotion. In some invertebrates such as the Class Enteropneusta (acorn worms) the proboscis is the anteriormost of three body regions. In vertebrates the term typically refers to an elongated nose, snout, or trunk. This term refers specifically to observations made at the middle of the proboscis."@en;
        skos:notation          "SDN:S12::S12101";
        skos:note              "accepted"@en;
        skos:prefLabel         "proboscis mid-section"@en .

