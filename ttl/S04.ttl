<http://vocab.nerc.ac.uk/collection/S04/current/S04119/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04119";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04119";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://purl.obolibrary.org/obo/CHMO_0000234>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "An analytical technique in which the sample is volatilised, usually by an oxy-acetylene flame, and the resultant vapour illuminated by a light source having an emission spectrum matched to the analyte of interest. The radiation absorbed by chemically unbound atoms is determined by analysing the transmitted energy relative to the incident energy at each frequency, which is proportional to the elemental concentrations."@en , "Technique analytique par laquelle l'échantillon est vaporisé grâce à une flamme issue d'un mélange de gaz. La vapeur résultante est éclairée par une lumière dont le spectre d'émission correspond à l'analyte d'intérêt. La radiation absorbée par les atomes à l'état fondamental est déterminée par comparaison de l'énergie transmise par rapport à l'énergie incidente pour chaque fréquence. La quantité de radiation absorbée est proportionnelle à la concentration de l'élément."@fr;
        skos:notation          "SDN:S04::S04119";
        skos:note              "accepted"@en;
