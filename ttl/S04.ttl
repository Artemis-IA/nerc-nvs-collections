<http://vocab.nerc.ac.uk/collection/S04/current/S0448/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S0448";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S0448";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S0448/1/>;
        pav:version            "1";
