<http://vocab.nerc.ac.uk/collection/S04/current/S0484/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S0484";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S0484";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S0484/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "An instrument incorporating a thermometer to measure temperature, an electrical conductivity sensor and a pressure sensor. Salinity (from conductivity and temperature) and depth (from pressure) were output directly after transformation by internal analogue circuitry."@en;
        skos:notation          "SDN:S04::S0484";
        skos:note              "accepted"@en;
        skos:prefLabel         "STD"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/SSALSL01/> .

<http://vocab.nerc.ac.uk/collection/S04/current/S04200/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04200";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04200";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04200/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "A temperature measuring device comprising a mercury-filled glass bulb leading to a mercury thread in a glass capillary. Temperature values are obtained by determining the position of the mercury meniscus against a calibrated scale."@en , "Instrument de mesure de température constitué d'une ampoule en verre remplie de mercure reliée à un mince filet de mercure dans un tube capillaire."@fr;
        skos:notation          "SDN:S04::S04200";
        skos:note              "accepted"@en;
        skos:prefLabel         "thermomètre à mercure"@fr , "hand-held mercury thermometer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/TEMPHGNX/> .

<http://vocab.nerc.ac.uk/collection/S04/current/S04204/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04204";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04204";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04204/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Technique chromatographique visant à séparer et analyser des mélanges de substances en utilisant une colonne garnie contenant des microsphères enrobées d'une phase stationnaire. La phase mobile est pompée au travers de la colonne à l'aide d'une pompe à haute pression. L'émergence de chacune des composantes de l'échantillon est examinée à l'aide d'un ou plusieurs détecteurs."@fr , "A chromatographic technique for separating and analysing mixtures of substances, using a packed column containing microspheres coated with the stationary phase and where the mobile phase is pumped through the column with a high pressure pump. The emergence of each component of the sample under analysis from the column is monitored using one of a number of different detectors."@en;
        skos:notation          "SDN:S04::S04204";
