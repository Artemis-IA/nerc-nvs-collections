        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "A type of current meter capable of simultaneous measurement of current velocity at a number of different depths based on determining Doppler shift of transmitted sound. Instrument understood to have been mounted in a fixed location such that the signal is transmitted towards the sea surface."@en;
        skos:notation          "SDN:S04::S04264";
        skos:note              "accepted"@en;
        skos:prefLabel         "moored acoustic doppler current profiler (ADCP)"@en;
