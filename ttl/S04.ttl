        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Instrument permettant de déterminer la quantité de chlorophylle présente dans le milieu en mesurant la quantité de lumière rouge (vers 685nm) émise par le volume d'eau ciblé lorsque celui-ci est excité par des impulsions de lumière bleue (460-470nm)."@fr , "An instrument that determines the amount of chlorophyll in place in the field by measuring the quantity of red light (around 685nm) emitted by the target water volume following excitation by pulses of blue light (around 460-470nm)."@en;
        skos:notation          "SDN:S04::S04134";
        skos:note              "accepted"@en;
        skos:prefLabel         "in-situ chlorophyll fluorometer"@en , "fluorescence par capteur optique in situ"@fr;
