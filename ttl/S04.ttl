<http://vocab.nerc.ac.uk/collection/S04/current/S04135/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04135";
        dc:date                "2019-06-16 15:46:35.0";
        dc:identifier          "SDN:S04::S04135";
        pav:authoredOn         "2019-06-16 15:46:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04135/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S04/current/S04135/2/> , <http://vocab.nerc.ac.uk/collection/S04/current/S04135/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://purl.obolibrary.org/obo/CHMO_0000280>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "This is an analytical technique for volatile heavy metals such as mercury in which vaporised metal atoms in an argon carrier at room temperature are irradiated by ultra-violet light causing them to fluoresce. The level of emitted radiation at designated wavelengths is used to quantify the amount of metal present."@en , "Technique analytique, destinée à des métaux lourds volatiles tels que le mercure, par laquelle les atomes de métal sont vaporisés puis transportés par un gaz vecteur inerte (e.g. argon) à température ambiante. L'échantillon est ensuite irradié par une lumière ultra-violette, ce qui lui fait emettre une radiation fluorescente. La quantité de radiation émise à des longueurs d'ondes spécifiques permet de connaitre la quantité de métal présent."@fr;
        skos:notation          "SDN:S04::S04135";
        skos:note              "accepted"@en;
        skos:prefLabel         "spectroscopie de fluorescence atomique par vapeur froide (CVAFS)"@fr , "cold vapour atomic fluorescence spectroscopy"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MTHGM005/> , <http://vocab.nerc.ac.uk/collection/P01/current/MSPMM001/> , <http://vocab.nerc.ac.uk/collection/P01/current/MSPMM002/> , <http://vocab.nerc.ac.uk/collection/P01/current/HGCNAAWF/> .

