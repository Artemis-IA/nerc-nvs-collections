<http://vocab.nerc.ac.uk/collection/S04/current/S04116/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04116";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04116";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04116/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "The AVHRR is a multiband (4 wavelength on AVHRR/1, 5 on AVHRR/2 and 6 on AVHRR/2) scanning radiometer mounted on aircraft or more usually satellites. Main oceanographic application is the measurement of sea surface temperature using a wavelength between 11.5 and 12.5 microns, but the instrument can also map clouds, snow/ice fields and land/sea boundaries. Resolution of the AVHRR/3 is 1.09km at Nadir."@en;
        skos:notation          "SDN:S04::S04116";
        skos:note              "accepted"@en;
        skos:prefLabel         "advanced very high resolution radiometer (AVHRR)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/TEMPAV01/> .

