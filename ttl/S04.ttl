        skos:altLabel          "TIMS";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "A highly sensitive isotope mass spectrometry characterization technique in which a chemically purified sample is heated to cause ionization of the atoms of the sample. The resulting ions are focused into a beam by an electromagnet, then separated into individual beams based on the mass/charge ratio of the ions."@en;
        skos:notation          "SDN:S04::S041073";
