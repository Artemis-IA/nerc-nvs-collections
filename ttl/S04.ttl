        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Position location using ARGOS, an operational satellite data collection and positioning system developed by CLS, CNES and in the USA since 1978. It is primarily used for location and data telemetry of drifting buoys, floats and instrumented animals."@en;
        skos:notation          "SDN:S04::S0448";
        skos:note              "accepted"@en;
        skos:prefLabel         "ARGOS satellite positioning system"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/ALONAG01/> , <http://vocab.nerc.ac.uk/collection/P01/current/ALATAG01/> .

<http://vocab.nerc.ac.uk/collection/S04/current/S04321/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04321";
        dc:date                "2016-03-10 12:26:34.0";
        dc:identifier          "SDN:S04::S04321";
        pav:authoredOn         "2016-03-10 12:26:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04321/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S04/current/S04321/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "sieve and pipette method";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Coarse (generally >63 microns) size fraction determination by passing the sample/water suspension through progressively finer sieves and weighing the fraction retained on each. The finest fraction is suspended with a dispersion agent in water and transferred to a vertical tube and left to settle for a pre-determined period. A pipette is used to extract sub-samples for particle weight determination from various depths mapped to particle size using settling rate data."@en , "L'échantillon est subdivisé en fractions granulométriques grossières (>63 microns) par passage dans une série de tamis de plus en plus fins, puis en pesant la fraction retenue dans chaque tamis. Les fractions plus fines sont mises en suspension dans l'eau grâce à un agent de dispersion et placées dans un tube vertical dans lequel elles pourront se déposer pendant une durée pré-définie.  Une pipette est ensuite utilisée pour extraire des sous-échantillon à différentes profondeurs afin de déterminer le poids des particules prélevées et d'en déduire leur taille grâce à des informations sur la vitesse de dépot."@fr;
        skos:notation          "SDN:S04::S04321";
        skos:note              "accepted"@en;
        skos:prefLabel         "sieving and settling tube method"@en , "tamisage et méthode à la pipette"@fr;
