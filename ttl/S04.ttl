        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "AgNO3 titration";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Ajouts successifs d'une certaine quantité d'une solution de nitrate d'argent pour extraire tous les anions halogénures de l'échantillon. Le point de fin du titrage est indiqué par un changement de couleur de l'échantillon (du jaune vers le rouge, dû au chromate de potassium)."@fr , "Quantitative incremental addition of silver nitrate solution to extract all halide anions from the sample as indicated by an indicator colour change (usually potassium chromate from yellow to red). Often referred to as 'Knudsen titration' after Knudsen, M., 1901. Hydrographical Tables Copenhagen, G.E.C. Gad, 63 pp."@en;
        skos:notation          "SDN:S04::S041023";
        skos:note              "accepted"@en;
        skos:prefLabel         "titrage au nitrage d'argent (méthode de Mohr)"@fr , "titration against silver nitrate (AgNO3)"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/SSALAGT1/> , <http://vocab.nerc.ac.uk/collection/P01/current/PSALKT01/> .

