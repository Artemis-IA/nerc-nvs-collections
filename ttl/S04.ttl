<http://vocab.nerc.ac.uk/collection/S04/current/S0501/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S0501";
        dc:date                "2017-08-30 12:17:42.0";
        dc:identifier          "SDN:S04::S0501";
        pav:authoredOn         "2017-08-30 12:17:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S0501/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "A method in analytical chemistry for the quantitative determination of nitrogen contained in organic substances plus the nitrogen in inorganic ammonia and ammonium (NH3/NH4+). It consists of three basic steps: 1) digestion of the sample in sulphuric acid with a catalyst, which results in conversion of nitrogen to ammonia; 2) distillation of the ammonia into a trapping solution; and 3) quantification of the ammonia by titration with a standard solution."@en , "Méthode de chimie analytique permettant de quantifier l'azote contenu dans des substances organiques, dans l'ammoniac inorganique et l'ammonium (NH3/NH4+). La méthode consiste en 3 étapes : 1) digestion de l'échantillon dans de l'acide sulphurique avec un catalyseur, ce qui converti l'azote en ammoniac; 2) distillation de l'ammoniac dans une solution de piégeage; et 3) quantification de l'ammoniac par titrage avec une solution standard."@fr;
        skos:notation          "SDN:S04::S0501";
        skos:note              "accepted"@en;
        skos:prefLabel         "méthode Kjeldahl"@fr , "Kjeldahl method"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MAKJ0051/> , <http://vocab.nerc.ac.uk/collection/P01/current/MAEABU51/> , <http://vocab.nerc.ac.uk/collection/P01/current/NTOTKJDX/> , <http://vocab.nerc.ac.uk/collection/P01/current/NTOTKJM1/> .

<http://vocab.nerc.ac.uk/collection/S04/current/S041210/>
