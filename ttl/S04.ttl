<http://vocab.nerc.ac.uk/collection/S04/current/S04196/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04196";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04196";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04196/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "The sample is volatilised on a graphite platform contained within a graphite tube and its temperature is systematically raised according to a predetermined programme. The resultant vapour is illuminated by a light source with an emission spectrum matched to the analyte of interest. Radiation absorbed by chemically unbound atoms is determined by analysing the transmitted energy relative to the incident energy at each frequency, which is proportional to the elemental concentrations."@en , "L'échantillon est vaporisé sur une plate-forme graphite placée à l'intérieur d'un tube en graphite dont la température augmente progressivement selon un programme pré-défini. La vapeur résultante est ensuite irradié par une lumière dont le spectre d'émission correspond à l'analyte d'intérêt. La radiation absorbée par les atomes à l'état fondamental est déterminée par comparaison de l'énergie transmise par rapport à l'énergie incidente pour chaque fréquence. La quantité de radiation absorbée est proportionnelle à la concentration de l'élément."@fr;
        skos:notation          "SDN:S04::S04196";
        skos:note              "accepted"@en;
        skos:prefLabel         "spectrométrie d'absorption atomique avec four en graphite (GFAAS)"@fr , "graphite furnace atomic absorption spectroscopy"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/ZNVGFAAS/> , <http://vocab.nerc.ac.uk/collection/P01/current/ODSDM010/> , <http://vocab.nerc.ac.uk/collection/P01/current/ZNKGFAAS/> , <http://vocab.nerc.ac.uk/collection/P01/current/XMETAL14/> , <http://vocab.nerc.ac.uk/collection/P01/current/XMETAL16/> , <http://vocab.nerc.ac.uk/collection/P01/current/XMETAL01/> , <http://vocab.nerc.ac.uk/collection/P01/current/XMETAL39/> , <http://vocab.nerc.ac.uk/collection/P01/current/XMETAL24/> , <http://vocab.nerc.ac.uk/collection/P01/current/ODSDM011/> , <http://vocab.nerc.ac.uk/collection/P01/current/FEXXASPW/> , <http://vocab.nerc.ac.uk/collection/P01/current/ODSDM009/> , <http://vocab.nerc.ac.uk/collection/P01/current/ODSDM012/> , <http://vocab.nerc.ac.uk/collection/P01/current/CUKGFAAS/> , <http://vocab.nerc.ac.uk/collection/P01/current/ODSDM008/> .

<http://vocab.nerc.ac.uk/collection/S04/current/S041055/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S041055";
        dc:date                "2011-01-15 16:18:07.0";
        dc:identifier          "SDN:S04::S041055";
        pav:authoredOn         "2011-01-15 16:18:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S041055/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MPN method";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Cell counting technique where sample is serially diluted and numbers estimated from proportion of aliquots in which there is a presence of the organism"@en , "Technique de comptage des cellules (ou micro-organismes) dans laquelle un échantillon subit une série de dillution. Le nombre d'organismes est estimé à partir de la proportion d'aliquots dans lesquels l'organisme est présent."@fr;
        skos:notation          "SDN:S04::S041055";
        skos:note              "accepted"@en;
        skos:prefLabel         "most probable number method"@en , "nombre le plus probable (NPP)"@fr;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/AECX87X1/> , <http://vocab.nerc.ac.uk/collection/P01/current/APSAMPN1/> , <http://vocab.nerc.ac.uk/collection/P01/current/ABUNU005/> , <http://vocab.nerc.ac.uk/collection/P01/current/ABND0001/> , <http://vocab.nerc.ac.uk/collection/P01/current/ABND0002/> , <http://vocab.nerc.ac.uk/collection/P01/current/ASTFMPN1/> , <http://vocab.nerc.ac.uk/collection/P01/current/AFAX87X1/> , <http://vocab.nerc.ac.uk/collection/P01/current/AFSX87X1/> , <http://vocab.nerc.ac.uk/collection/P01/current/AFA08701/> , <http://vocab.nerc.ac.uk/collection/P01/current/STCX87X2/> , <http://vocab.nerc.ac.uk/collection/P01/current/SFSX87X2/> , <http://vocab.nerc.ac.uk/collection/P01/current/AFAX88X1/> , <http://vocab.nerc.ac.uk/collection/P01/current/ATCX87X1/> .

