        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Analytical technique where sample solution is sprayed as a fine mist into a flame causing vaporisation and atomic excitation resulting in emission of light energy at characteristic wavelengths. A detector quantifies the strength of the emissions."@en , "Technique analytique dans laquelle une flamme est aspergée par de fines goutelettes de la solution d'intérêt. La solution est alors vaporisée et les atomes excités. Ceci entraine une émission de lumière à des longueurs d'ondes caractéristiques. L'intensité de ces émissions est mesurée par un détecteur."@fr;
        skos:notation          "SDN:S04::S04173";
        skos:note              "accepted"@en;
        skos:prefLabel         "photométrie de flamme"@fr , "flame photometry"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/ODSDM013/> , <http://vocab.nerc.ac.uk/collection/P01/current/ACTVM011/> .

