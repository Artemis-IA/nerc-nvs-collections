        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04192";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04192";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d'une colonne garnie d'un sorbant. Les composantes de l'échantillon, une fois séparées, sont exposées à un détecteur. Celui-ci ionise une partie du gaz porteur pour produire un courant entre une paire d'électrodes. Les composés hautement electronégatifs (e.g. les halogènes, le groupe nitro) capturent des électrons. La baisse de courant mesurée entre les électrodes permet alors de quantifier ces composés."@fr , "Separation of gases, volatile substances or substances dissolved in a volatile solvent by inert gas transport through a sorbent-packed column. Separated components exposed to a detector that ionizes some carrier gas to produce a current between a biased pair of electrodes. Organic molecules with electronegative functional groups, such as halogens, phosphorous, and nitro groups capture electrons and are quantified by measuring the reduction of the current measured between the electrodes."@en;
        skos:notation          "SDN:S04::S04192";
        skos:note              "accepted"@en;
        skos:prefLabel         "gas chromatography-electron capture detection"@en , "Chromatographie en phase gazeuse/ détecteur capture d'électrons (GC/ECD)"@fr;
