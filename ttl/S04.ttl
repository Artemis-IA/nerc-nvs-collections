<http://vocab.nerc.ac.uk/collection/S04/current/S04262/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04262";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04262";
