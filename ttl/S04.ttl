        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "A type of current meter that determines current velocity in the water column in place in the field based on determining Doppler shift of transmitted sound."@en;
        skos:notation          "SDN:S04::S04214";
        skos:note              "accepted"@en;
        skos:prefLabel         "in-situ acoustic current meter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/LCVSAC01/> , <http://vocab.nerc.ac.uk/collection/P01/current/LRZASP01/> .

<http://vocab.nerc.ac.uk/collection/S04/current/S04264/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04264";
