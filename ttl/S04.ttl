<http://vocab.nerc.ac.uk/collection/S04/current/S04182/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S04182";
        dc:date                "2006-10-02 18:26:59.0";
        dc:identifier          "SDN:S04::S04182";
        pav:authoredOn         "2006-10-02 18:26:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Technique chromatographique visant à séparer et analyser des mélanges de substances en utilisant une colonne garnie contenant des microsphères enrobées d'une phase stationnaire. La phase mobile est pompée au travers de la colonne à l'aide d'une pompe à haute pression. L'émergence de chacune des composantes de l'échantillon est examinée à l'aide d'un détecteur de fluorescence."@fr , "A chromatographic technique for separating and analysing mixtures of substances, using a packed column containing microspheres coated with the stationary phase and where the mobile phase is pumped through the column with a high pressure pump. The emergence of each component of the sample under analysis from the column is monitored using a fluorescence detector."@en;
        skos:notation          "SDN:S04::S04182";
        skos:note              "accepted"@en;
        skos:prefLabel         "fluorescence high performance liquid chromatography (HPLC)"@en , "chromatographie liquide haute performance (HPLC) - spectrométrie de fluorescence moléculaire"@fr;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/HDCCCHOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBBOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBBFL/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBKOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBAPC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCAN01/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCANOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBAPY/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCINPY/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCCHRY/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCDBAA/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBAAN/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBKFL/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCDBOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBAOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCINOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBEOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCPHOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCPHAN/> , <http://vocab.nerc.ac.uk/collection/P01/current/PAHSM024/> , <http://vocab.nerc.ac.uk/collection/P01/current/PAHSM018/> , <http://vocab.nerc.ac.uk/collection/P01/current/PAHSM025/> , <http://vocab.nerc.ac.uk/collection/P01/current/PAHSM017/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBGOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCBGPE/> , <http://vocab.nerc.ac.uk/collection/P01/current/PAHSM019/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCPYRN/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCPYOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/PAHSM026/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCFLOC/> , <http://vocab.nerc.ac.uk/collection/P01/current/HDCCFLAN/> , <http://vocab.nerc.ac.uk/collection/P01/current/PAHSM022/> , <http://vocab.ner