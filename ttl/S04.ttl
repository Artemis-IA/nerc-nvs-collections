<http://vocab.nerc.ac.uk/collection/S04/current/S041158/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S041158";
        dc:date                "2019-01-17 11:27:38.0";
        dc:identifier          "SDN:S04::S041158";
        pav:authoredOn         "2019-01-17 11:27:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S041158/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "GC/NCI-MS";
        skos:definition        "Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d'une colonne garnie d'un sorbant. Les composantes de l'échantillon, une fois séparées, sont passées dans un spectromètre de masse avec ionisation chimique négative permettant d'identifier et de quantifier les groupes électro-négatifs ou acides."@fr , "A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. The separated components are then passed to a Negative Chemical Ionization Mass Spectrometer for identification and quantification of electro-negative or acidic groups."@en;
        skos:notation          "SDN:S04::S041158";
        skos:note              "accepted"@en;
        skos:prefLabel         "gas chromatography-negative chemical ionisation mass spectrometry"@en , "Chromatographie en phase gazeuse / spectrométrie de masse avec ionisation chimique négative (GC/NCI-MS)"@fr;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/C1013963/> .

