<http://vocab.nerc.ac.uk/collection/S04/current/S046/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S04::S046";
        dc:date                "2018-01-11 16:21:42.0";
        dc:identifier          "SDN:S04::S046";
        pav:authoredOn         "2018-01-11 16:21:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S04/current/S046/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S04/current/S046/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0110/>;
        skos:definition        "Flow cytometry is the analysis of biological material by detection of the light-absorbing or fluorescing properties of cells or sub-cellular fractions such as chromosomes passing in a narrow stream through a laser beam. It is automated to sort successive droplets of the stream into different fractions depending on the fluorescence emitted by each droplet. Protein fluorescence is a technique to quantify protein biomass."@en;
        skos:notation          "SDN:S04::S046";
        skos:note              "accepted"@en;
        skos:prefLabel         "flow cytometry and protein fluorescence"@en .

