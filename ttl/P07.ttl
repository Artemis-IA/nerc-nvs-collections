        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/sea_surface_wave_significant_height> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSNA015/> , <http://vocab.nerc.ac.uk/standard_name/sea_surface_wave_significant_height/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G967/> , <http://vocab.nerc.ac.uk/collection/P04/current/G967/> , <http://vocab.nerc.ac.uk/collection/P04/current/G965/> , <http://vocab.nerc.ac.uk/collection/A05/current/EV_WAVES/> , <http://vocab.nerc.ac.uk/collection/P02/current/WVST/> , <http://vocab.nerc.ac.uk/collection/P64/current/G965/>;
        skos:definition        "Significant wave height is a statistic computed from wave measurements and corresponds to the average height of the highest one third of the waves, where the height is defined as the vertical distance from a wave trough to the following wave crest."@en;
        skos:notation          "SDN:P07::CFSN0385";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_wave_significant_height"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

