        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/SIGT/>;
        skos:definition        "Sea water density is the in-situ density (not the potential density). If 1000 kg m-3 is subtracted, the standard name sea_water_sigma_t should be chosen instead."@en;
        skos:notation          "SDN:P07::CFSN0393";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_water_density"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/7XZLO2SJ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::7XZLO2SJ";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::7XZLO2SJ";
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/7XZLO2SJ/1/>;
