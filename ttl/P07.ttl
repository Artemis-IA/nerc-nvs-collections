        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Nd\" means the element \"neodymium\" and \"147Nd\" is the isotope \"neodymium-147\" with a half-life of 1.10e+01 days."@en;
        skos:notation          "SDN:P07::HGUX3KLT";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_147Nd"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N35/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV8N35";
        dc:date                "2008-04-15 14:00:00.0";
        dc:identifier          "SDN:P07::CFV8N35";
        pav:authoredOn         "2008-04-15 14:00:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N35/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
