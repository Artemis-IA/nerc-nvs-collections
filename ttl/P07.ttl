        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G288/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G285/> , <http://vocab.nerc.ac.uk/collection/P64/current/G285/> , <http://vocab.nerc.ac.uk/collection/P04/current/G288/>;
