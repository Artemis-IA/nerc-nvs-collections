        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"U\" means the element \"uranium\" and \"236U\" is the isotope \"uranium-236\" with a half-life of 8.73e+09 days."@en;
        skos:notation          "SDN:P07::F3JQPSP4";
