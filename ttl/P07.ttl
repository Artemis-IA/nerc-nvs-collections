        skos:definition        "Sea ice freeboard is the height of the sea-ice upper surface above the water surface. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/> , <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/>;
        skos:notation          "SDN:P07::CFSN0365";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_ice_freeboard"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N718/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N718";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N718";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N718/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_moles_of_hypochlorous_acid/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_moles_of_hypochlorous_acid>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G152/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for hypochlorous acid is HOCl."@en;
        skos:notation          "SDN:P07::CF12N718";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_moles_of_hypochlorous_acid"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/MRLV12DF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::MRLV12DF";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::MRLV12DF";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/MRLV12DF/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_243Am/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_243Am>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Am\" means the element \"americium\" and \"243Am\" is the isotope \"americium-243\" with a half-life of 2.91e+06 days."@en;
        skos:notation          "SDN:P07::MRLV12DF";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_243Am"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/XQNX4ZZ3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::XQNX4ZZ3";
        dc:date                "2019-04-08 18:14:12.0";
        dc:identifier          "SDN:P07::XQNX4ZZ3";
        pav:authoredOn         "2019-04-08 18:14:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/XQNX4ZZ3/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_fraction_of_hfc23_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_fraction_of_hfc23_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mole fraction\" is used in the construction \"mole_fraction_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for hfc23 is CF3H. The IUPAC name for hfc23 is trifluoromethane."@en;
        skos:notation          "SDN:P07::XQNX4ZZ3";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_hfc23_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/B5891AKR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::B5891AKR";
        dc:date                "2019-02-04 14:52:10.0";
        dc:identifier          "SDN:P07::B5891AKR";
        pav:authoredOn         "2019-02-04 14:52:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/B5891AKR/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/B5891AKR/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/net_primary_production_of_biomass_expressed_as_carbon_per_unit_volume_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/net_primary_production_of_biomass_expressed_as_carbon_per_unit_volume_in_sea_water>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Net primary production is the excess of gross primary production (rate of synthesis of biomass from inorganic precursors) by autotrophs (\"producers\"), for example, photosynthesis in plants or phytoplankton, over the rate at which the autotrophs themselves respire some of this biomass. In the oceans, carbon production per unit volume is often found at a number of depths at a given horizontal location. That quantity can then be integrated to calculate production per unit area at the location. Standard names for production per unit area use the term \"productivity\". The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A."@en;
        skos:notation          "SDN:P07::B5891AKR";
        skos:note              "accepted"@en;
        skos:prefLabel         "net_primary_production_of_biomass_expressed_as_carbon_per_unit_volume_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/F2R0BSKD/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::F2R0BSKD";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::F2R0BSKD";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/F2R0BSKD/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_131I_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_131I_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"I\" means the element \"iodine\" and \"131I\" is the isotope \"iodine-131\" with a half-life of 8.07e+00 days."@en;
        skos:notation          "SDN:P07::F2R0BSKD";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_131I_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/L3JS2L1M/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::L3JS2L1M";
        dc:date                "2017-07-24 14:36:59.0";
        dc:identifier          "SDN:P07::L3JS2L1M";
        pav:authoredOn         "2017-07-24 14:36:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/L3JS2L1M/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/height_above_geopotential_datum/> , <http://mmisw.org/ont/cf/parameter/height_above_geopotential_datum>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Height_above_X\" means the vertical distance above the named surface X. The \"geopotential datum\" is any estimated surface of constant geopotential used as a datum i.e. a reference level; for the geoid as a datum, specific standard names are available. To specify which geoid or geopotential datum is being used as a reference level, a grid_mapping variable should be attached to the data variable as described in Chapter 5.6 of the CF Convention."@en;
        skos:notation          "SDN:P07::L3JS2L1M";
        skos:note              "accepted"@en;
        skos:prefLabel         "height_above_geopotential_datum"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1SPU7PRB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1SPU7PRB";
        dc:date                "2025-05-13 08:28:41.0";
        dc:identifier          "SDN:P07::1SPU7PRB";
        pav:authoredOn         "2025-05-13 08:28:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1SPU7PRB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/convective_solid_precipitation_flux/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Convective precipitation is that produced by the convection schemes in an atmosphere model. Solid precipitation refers to the precipitation of water in the solid phase. Water in the atmosphere exists in one of three phases: solid, liquid or vapor. The solid phase can exist as snow, hail, graupel, cloud ice, or as a component of aerosol. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::1SPU7PRB";
        skos:note              "accepted"@en;
        skos:prefLabel         "convective_solid_precipitation_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/JAU07CMQ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::JAU07CMQ";
        dc:date                "2018-10-15 12:56:49.0";
        dc:identifier          "SDN:P07::JAU07CMQ";
        pav:authoredOn         "2018-10-15 12:56:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/JAU07CMQ/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/platform_sway_port/> , <http://mmisw.org/ont/cf/parameter/platform_sway_port>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Sway is a displacement along an axis that is perpendicular to both the local vertical axis and the nominal forward motion direction of the platform. Sway is relative to the \"at rest\" position of the platform with respect to the axis of displacement. The \"at rest\" position of the platform may change over time. \"Port\" indicates that positive values of sway represent the platform moving left as viewed by an observer on top of the platform facing forward. The standard name platform_sway_starboard should be used for data having the opposite sign convention. The standard name platform_sway should be chosen only if the sign convention of the data is unknown. A \"platform\" is a structure or vehicle that serves as a base for mounting sensors. Platforms include, but are not limited to, satellites, aeroplanes, ships, buoys, instruments, ground stations, and masts."@en;
        skos:notation          "SDN:P07::JAU07CMQ";
        skos:note              "accepted"@en;
        skos:prefLabel         "platform_sway_port"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N67/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N67";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N67";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N67/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N67/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_inorganic_chlorine/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_inorganic_chlorine>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/H321/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. \"Inorganic chlorine\", sometimes referred to as Cly, describes a family of chemical species which result from the degradation of source gases containing chlorine (CFCs, HCFCs, VSLS) and natural inorganic chlorine sources such as sea salt and other aerosols. \"Inorganic chlorine\" is the term used in standard names for all species belonging to the family that are represented within a given model. The list of individual species that are included in a quantity having a group chemical standard name can vary between models. Where possible, the data variable should be accompanied by a complete description of the species represented, for example, by using a comment attribute. Standard names that use the term \"clox\" are used for quantities that contain all inorganic chlorine species except HCl and ClONO2."@en;
        skos:notation          "SDN:P07::CF12N67";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_inorganic_chlorine"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N60/>
        rdf:type               skos:Concept;
