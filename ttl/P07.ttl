<http://vocab.nerc.ac.uk/collection/P07/current/3PKZOLSP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::3PKZOLSP";
        dc:date                "2019-12-09 17:20:23.0";
        dc:identifier          "SDN:P07::3PKZOLSP";
