<http://vocab.nerc.ac.uk/collection/P07/current/NAWZYUBK/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::NAWZYUBK";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::NAWZYUBK";
        pav:authoredOn         "2018-02-12 16:53:18.0";
