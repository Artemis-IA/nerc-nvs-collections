<http://vocab.nerc.ac.uk/collection/P07/current/8O7ZSO1W/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::8O7ZSO1W";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::8O7ZSO1W";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CF12N78/>;
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/8O7ZSO1W/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/8O7ZSO1W/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_nitrate_dry_aerosol_particles/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_nitrate_dry_aerosol_particles>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The mass is the total mass of the particles. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The chemical formula for the nitrate anion is NO3-."@en;
        skos:notation          "SDN:P07::8O7ZSO1W";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_nitrate_dry_aerosol_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N78/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N78";
        dc:date                "2015-01-07 15:23:07.0";
        dc:identifier          "SDN:P07::CF12N78";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/8O7ZSO1W/>;
        pav:authoredOn         "2015-01-07 15:23:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N78/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N78/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_nitrate_dry_aerosol> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_nitrate_dry_aerosol/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P64/current/G108/> , <http://vocab.nerc.ac.uk/collection/P04/current/G108/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  \"Aerosol\" means the suspended liquid or solid particles in air (except cloud droplets).  Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. \"Dry aerosol\" means aerosol without water. The chemical formula for the nitrate anion is NO3-."@en;
        skos:notation          "SDN:P07::CF12N78";
        skos:note              "deprecated"@en;
