        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_cloud_liquid_water_content> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_cloud_liquid_water_content/> , <http://vocab.nerc.ac.uk/collection/P07/current/BBAD2159/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P64/current/G269/> , <http://vocab.nerc.ac.uk/collection/P04/current/G269/>;
        skos:definition        "'Content' indicates a quantity per unit area. The 'atmosphere content' of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used."@en;
        skos:notation          "SDN:P07::CFSN0007";
        skos:note              "deprecated"@en;
        skos:prefLabel         "atmosphere_cloud_liquid_water_content"@en;
