        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for molecular hydrogen is H2."@en;
        skos:notation          "SDN:P07::CF12N77";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_molecular_hydrogen"@en;
