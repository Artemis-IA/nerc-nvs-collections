        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/YPOBDE6L/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/downward_component_of_unit_vector_away_from_instrument/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The vertical component of the unit vector describing the direction from the sensor to a point of interest, relative to the sensor. \"downward\" indicates a vector component which is positive when directed downward (negative upward)."@en;
        skos:notation          "SDN:P07::YPOBDE6L";
        skos:note              "accepted"@en;
        skos:prefLabel         "downward_component_of_unit_vector_away_from_instrument"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/HV4LHVJ1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::HV4LHVJ1";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::HV4LHVJ1";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/HV4LHVJ1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_219Rn_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_219Rn_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Rn\" means the element \"radon\" and \"219Rn\" is the isotope \"radon-219\" with a half-life of 4.64e-05 days."@en;
        skos:notation          "SDN:P07::HV4LHVJ1";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_219Rn_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0564/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0564";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0564";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0564/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/lwe_thickness_of_convective_snowfall_amount> , <http://vocab.nerc.ac.uk/standard_name/lwe_thickness_of_convective_snowfall_amount/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G284/> , <http://vocab.nerc.ac.uk/collection/P64/current/G290/> , <http://vocab.nerc.ac.uk/collection/P04/current/G290/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G285/> , <http://vocab.nerc.ac.uk/collection/P64/current/G285/> , <http://vocab.nerc.ac.uk/collection/P04/current/G284/>;
        skos:definition        "'lwe' means liquid water equivalent. 'Amount' means mass per unit area. The construction lwe_thickness_of_X_amount or _content means the vertical extent of a layer of liquid water having the same mass per unit area."@en;
        skos:notation          "SDN:P07::CFSN0564";
        skos:note              "accepted"@en;
        skos:prefLabel         "lwe_thickness_of_convective_snowfall_amount"@en;
