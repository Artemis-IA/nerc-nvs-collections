        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Bi\" means the element \"bismuth\" and \"212Bi\" is the isotope \"bismuth-212\" with a half-life of 4.20e-02 days."@en;
        skos:notation          "SDN:P07::46FK28K9";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_212Bi_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N359/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N359";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N359";
