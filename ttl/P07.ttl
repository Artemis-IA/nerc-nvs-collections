        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_144Pr_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_144Pr_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pr\" means the element \"praseodymium\" and \"144Pr\" is the isotope \"praseodymium-144\" with a half-life of 1.20e-02 days."@en;
        skos:notation          "SDN:P07::05T0D2U6";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_144Pr_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

