        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ru\" means the element \"ruthenium\" and \"103Ru\" is the isotope \"ruthenium-103\" with a half-life of 3.95e+01 days."@en;
        skos:notation          "SDN:P07::QU91NLO7";
