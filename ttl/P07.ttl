        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P04/current/G161/> , <http://vocab.nerc.ac.uk/collection/P04/current/G158/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for nitrogen monoxide is NO."@en;
        skos:notation          "SDN:P07::CF12N493";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_nitrogen_monoxide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

