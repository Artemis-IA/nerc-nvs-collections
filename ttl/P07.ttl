        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G239/> , <http://vocab.nerc.ac.uk/collection/P04/current/G239/>;
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. 'tendency_of_X' means derivative of X with respect to time. 'condensed_water' means liquid and ice. Mass fraction is used in the construction mass_fraction_of_X_in_Y, where X is a material constituent of Y. It means the ratio of the mass of Y to the mass of X (including Y)."@en;
        skos:notation          "SDN:P07::CFSN0166";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_mass_fraction_of_cloud_condensed_water_in_air_due_to_advection"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> , <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0494/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0494";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0494";
