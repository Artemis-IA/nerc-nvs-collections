        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A velocity is a vector quantity. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward). \"Geostrophic\" indicates that geostrophic balance is assumed, i.e. that the pressure gradient force and the Coriolis force are balanced and the large scale fluid flow is parallel to the isobars."@en;
        skos:notation          "SDN:P07::PL2XA37D";
        skos:note              "accepted"@en;
        skos:prefLabel         "geostrophic_eastward_sea_water_velocity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N397/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N397";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N397";
