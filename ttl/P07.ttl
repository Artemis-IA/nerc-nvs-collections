        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_horizontal_velocity_potential/> , <http://mmisw.org/ont/cf/parameter/atmosphere_horizontal_velocity_potential>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/EWSB/>;
        skos:definition        "A velocity is a vector quantity. 'Horizontal' indicates that the velocity potential applies to a horizontal velocity field on a particular vertical level."@en;
        skos:notation          "SDN:P07::CFSN0753";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_horizontal_velocity_potential"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/SQMS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N311/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N311";
        dc:date                "2018-12-17 17:17:12.0";
        dc:identifier          "SDN:P07::CF12N311";
        pav:authoredOn         "2018-12-17 17:17:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N311/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N311/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N311/3/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N311/1/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mass_concentration_of_phytoplankton_expressed_as_chlorophyll_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_phytoplankton_expressed_as_chlorophyll_in_sea_water/>;
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G676/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPWC/> , <http://vocab.nerc.ac.uk/collection/P04/current/G885/> , <http://vocab.nerc.ac.uk/collection/P64/current/G885/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Phytoplankton are algae that grow where there is sufficient light to support photosynthesis. Standard names also exist for the mass concentration of a number of components that make up the total phytoplankton population, such as diatoms, diazotrophs, calcareous phytoplankton, picophytoplankton and miscellaneous phytoplankton. Chlorophylls are the green pigments found in most plants, algae and cyanobacteria; their presence is essential for photosynthesis to take place. There are several different forms of chlorophyll that occur naturally. All contain a chlorin ring (chemical formula C20H16N4) which gives the green pigment and a side chain whose structure varies. The naturally occurring forms of chlorophyll contain between 35 and 55 carbon atoms."@en;
        skos:notation          "SDN:P07::CF12N311";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_phytoplankton_expressed_as_chlorophyll_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/HEWYK2XY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::HEWYK2XY";
        dc:date                "2023-02-06 17:17:13.0";
        dc:identifier          "SDN:P07::HEWYK2XY";
        pav:authoredOn         "2023-02-06 17:17:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/HEWYK2XY/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_fraction_of_dibromochloromethane_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_fraction_of_dibromochloromethane_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mole fraction\" is used in the construction \"mole_fraction_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for dibromochloromethane is CHBr2Cl. The IUPAC name is dibromochloromethane."@en;
        skos:notation          "SDN:P07::HEWYK2XY";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_dibromochloromethane_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MPMX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/DZQMR3O4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::DZQMR3O4";
        dc:date                "2025-03-19 08:31:35.0";
        dc:identifier          "SDN:P07::DZQMR3O4";
        pav:authoredOn         "2025-03-19 08:31:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/DZQMR3O4/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/carbon_mass_content_of_geological_storage/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The carbon mass per unit area that has been intentionally removed from the environment by e.g., biomass energy with carbon capture and storage (BECCS), and stored indefinitely long-term (i.e., geologic storage). \"Content\" indicates a quantity per unit area."@en;
        skos:notation          "SDN:P07::DZQMR3O4";
        skos:note              "accepted"@en;
        skos:prefLabel         "carbon_mass_content_of_geological_storage"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0562/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0562";
        dc:date                "2018-07-10 09:28:29.0";
        dc:identifier          "SDN:P07::CFSN0562";
        pav:authoredOn         "2018-07-10 09:28:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0562/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0562/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/lwe_thickness_of_canopy_water_amount> , <http://vocab.nerc.ac.uk/standard_name/lwe_thickness_of_canopy_water_amount/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/LWET/> , <http://vocab.nerc.ac.uk/collection/P04/current/G418/> , <http://vocab.nerc.ac.uk/collection/P64/current/G418/>;
        skos:definition        "The abbreviation \"lwe\" means liquid water equivalent. \"Amount\" means mass per unit area. The construction lwe_thickness_of_X_amount or _content means the vertical extent of a layer of liquid water having the same mass per unit area. \"Water\" means water in all phases, including frozen i.e. ice and snow. The canopy water is the water on the canopy. \"Canopy\" means the vegetative covering over a surface. The canopy is often considered to be the outer surfaces of the vegetation. Plant height and the distribution, orientation and shape of plant leaves within a canopy influence the atmospheric environment and many plant processes within the canopy. Reference: AMS Glossary http://glossary.ametsoc.org/wiki/Canopy."@en;
        skos:notation          "SDN:P07::CFSN0562";
        skos:note              "accepted"@en;
        skos:prefLabel         "lwe_thickness_of_canopy_water_amount"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/POVWZ994/>
