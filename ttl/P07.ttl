        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Am\" means the element \"americium\" and \"244mAm\" is the metastable state of the isotope \"americium-244\" with a half-life of 1.81e-02 days."@en;
        skos:notation          "SDN:P07::Y1KIMNPY";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_244mAm_in_air"@en;
