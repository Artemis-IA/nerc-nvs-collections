        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Nb\" means the element \"niobium\" and \"94Nb\" is the isotope \"niobium-94\" with a half-life of 7.29e+06 days."@en;
        skos:notation          "SDN:P07::UWZBT8RK";
