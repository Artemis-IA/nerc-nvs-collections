        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_83mKr_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_83mKr_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Kr\" means the element \"krypton\" and \"83mKr\" is the metastable state of the isotope \"krypton-83\" with a half-life of 7.71e-02 days."@en;
        skos:notation          "SDN:P07::IACLM1AW";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_83mKr_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/6PV171LU/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::6PV171LU";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::6PV171LU";
