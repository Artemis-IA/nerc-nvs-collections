<http://vocab.nerc.ac.uk/collection/P07/current/K3QWPGJ4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::K3QWPGJ4";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::K3QWPGJ4";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/K3QWPGJ4/1/>;
