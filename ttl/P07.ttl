        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sr\" means the element \"strontium\" and \"89Sr\" is the isotope \"strontium-89\" with a half-life of 5.21e+01 days."@en;
        skos:notation          "SDN:P07::QC69S3NH";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_89Sr_in_air"@en;
