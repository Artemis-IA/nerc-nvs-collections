        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_frozen_carbon_dioxide_amount/> , <http://mmisw.org/ont/cf/parameter/surface_frozen_carbon_dioxide_amount>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Amount\" means mass per unit area. The surface called \"surface\" means the lower boundary of the atmosphere. The chemical formula for carbon dioxide is CO2. Frozen carbon dioxide is found on the surface of Mars."@en;
        skos:notation          "SDN:P07::BBAH2113";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_frozen_carbon_dioxide_amount"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N272/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N272";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N272";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N272/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_hydrogen_chloride_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_hydrogen_chloride_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G150/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for hydrogen chloride is HCl."@en;
        skos:notation          "SDN:P07::CF12N272";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_hydrogen_chloride_in_air"@en;
