<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0093/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0093";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0093";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0093/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/toa_outgoing_shortwave_flux_assuming_clear_sky> , <http://vocab.nerc.ac.uk/standard_name/toa_outgoing_shortwave_flux_assuming_clear_sky/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G214/> , <http://vocab.nerc.ac.uk/collection/P04/current/G214/> , <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/> , <http://vocab.nerc.ac.uk/collection/P04/current/G210/>;
        skos:definition        "A phrase assuming_condition indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. 'shortwave' means shortwave radiation. 'toa' means top of atmosphere. The TOA outgoing shortwave flux is the reflected and scattered solar radiative flux i.e. the 'upwelling' TOA shortwave flux, sometimes called the 'outgoing shortwave radiation' or 'OSR'. In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0093";
        skos:note              "accepted"@en;
        skos:prefLabel         "toa_outgoing_shortwave_flux_assuming_clear_sky"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N287/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N287";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N287";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N287/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_methyl_chloride_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_methyl_chloride_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G134/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for methyl chloride is CH3Cl. The IUPAC name for methyl chloride is chloromethane."@en;
        skos:notation          "SDN:P07::CF12N287";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_methyl_chloride_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/I8P5MQ0F/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::I8P5MQ0F";
        dc:date                "2017-03-27 15:08:34.0";
        dc:identifier          "SDN:P07::I8P5MQ0F";
        pav:authoredOn         "2017-03-27 15:08:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/I8P5MQ0F/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_surface_wave_from_direction_at_variance_spectral_density_maximum/> , <http://mmisw.org/ont/cf/parameter/sea_surface_wave_from_direction_at_variance_spectral_density_maximum>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/GWDR/>;
        skos:definition        "The quantity with standard name sea_surface_wave_from_direction_at_variance_spectral_density_maximum is the direction from which the most energetic waves are coming. The spectral peak is the most energetic wave in the total wave spectrum. The phrase \"from_direction\" is used in the construction X_from_direction and indicates the direction from which the velocity vector of X is coming. The direction is a bearing in the usual geographical sense, measured positive clockwise from due north. The wave directional spectrum can be written as a five dimensional function S(t,x,y,f,theta) where t is time, x and y are horizontal coordinates (such as longitude and latitude), f is frequency and theta is direction. S has the standard name sea_surface_wave_directional_variance_spectral_density. S can be integrated over direction to give S1= integral(S dtheta) and this quantity has the standard name sea_surface_wave_variance_spectral_density."@en;
        skos:notation          "SDN:P07::I8P5MQ0F";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_wave_from_direction_at_variance_spectral_density_maximum"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UAAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/U4VRC5YM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::U4VRC5YM";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::U4VRC5YM";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/U4VRC5YM/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_237Pu/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_237Pu>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Pu\" means the element \"plutonium\" and \"237Pu\" is the isotope \"plutonium-237\" with a half-life of 4.56e+01 days."@en;
        skos:notation          "SDN:P07::U4VRC5YM";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_237Pu"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV10N13/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV10N13";
        dc:date                "2008-10-21 10:00:00.0";
        dc:identifier          "SDN:P07::CFV10N13";
        pav:authoredOn         "2008-10-21 10:00:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N13/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/heat_flux_into_sea_water_due_to_newtonian_relaxation> , <http://vocab.nerc.ac.uk/standard_name/heat_flux_into_sea_water_due_to_newtonian_relaxation/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G935/> , <http://vocab.nerc.ac.uk/collection/P02/current/HFLX/> , <http://vocab.nerc.ac.uk/collection/P04/current/G935/>;
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase.  The heat_flux_into_sea_water_due_to_newtonian_relaxation is  the heat flux resulting from the Newtonian relaxation of the sea surface temperature. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFV10N13";
        skos:note              "accepted"@en;
        skos:prefLabel         "heat_flux_into_sea_water_due_to_newtonian_relaxation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/WWSC37PD/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::WWSC37PD";
        dc:date                "2018-11-12 16:47:31.0";
        dc:identifier          "SDN:P07::WWSC37PD";
        pav:authoredOn         "2018-11-12 16:47:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/WWSC37PD/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/WWSC37PD/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/platform_surge_aft/> , <http://mmisw.org/ont/cf/parameter/platform_surge_aft>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Surge is a displacement along an axis that is perpendicular to the local vertical axis and is coplanar with the nominal forward motion direction of the platform. Surge is relative to the \"at rest\" position of the platform with respect to the axis of displacement. The \"at rest\" position of the platform may change over time. \"Aft\" indicates that positive values of surge represent the platform moving backward as viewed by an observer on top of the platform facing forward. The standard name platform_surge_fore should be used for data having the opposite sign convention. The standard name platform_surge should be chosen only if the sign convention of the data is unknown. A \"platform\" is a structure or vehicle that serves as a base for mounting sensors. Platforms include, but are not limited to, satellites, aeroplanes, ships, buoys, instruments, ground stations, and masts."@en;
        skos:notation          "SDN:P07::WWSC37PD";
        skos:note              "accepted"@en;
        skos:prefLabel         "platform_surge_aft"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0820/>
        rdf:type               skos:Concept;
