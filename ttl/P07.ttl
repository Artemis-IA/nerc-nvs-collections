        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Po\" means the element \"polonium\" and \"210Po\" is the isotope \"polonium-210\" with a half-life of 1.38e+02 days."@en;
        skos:notation          "SDN:P07::KKOZPKWO";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_210Po"@en;
