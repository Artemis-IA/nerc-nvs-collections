        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G136/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for hydrogen cyanide is HCN."@en;
        skos:notation          "SDN:P07::CF12N273";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_hydrogen_cyanide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0491/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0491";
        dc:date                "2018-02-12 16:53:19.0";
        dc:identifier          "SDN:P07::CFSN0491";
        pav:authoredOn         "2018-02-12 16:53:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0491/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0491/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/northward_ocean_salt_transport_due_to_gyre> , <http://vocab.nerc.ac.uk/standard_name/northward_ocean_salt_transport_due_to_gyre/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G996/> , <http://vocab.nerc.ac.uk/collection/P64/current/G996/> , <http://vocab.nerc.ac.uk/collection/P02/current/VDFC/>;
        skos:definition        "\"Northward\" indicates a vector component which is positive when directed northward (negative southward). \"Salt transport\" means the mass of salt being transported. Northward transport by the ocean gyre is geometrically defined as being the part due to the vertical integral of the product of deviations of velocity and tracer from their zonal means. The velocity does not include the parameterized eddy velocity. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase."@en;
        skos:notation          "SDN:P07::CFSN0491";
        skos:note              "accepted"@en;
        skos:prefLabel         "northward_ocean_salt_transport_due_to_gyre"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KGPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N89/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N89";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N89";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N89/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_oxygenated_hydrocarbons/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_oxygenated_hydrocarbons>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.   \"Oxygenated\" means containing oxygen. \"Hydrocarbon\" means a compound containing hydrogen and carbon."@en;
        skos:notation          "SDN:P07::CF12N89";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_oxygenated_hydrocarbons"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0722/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0722";
        dc:date                "2024-05-20 20:39:49.0";
        dc:identifier          "SDN:P07::CFSN0722";
        pav:authoredOn         "2024-05-20 20:39:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0722/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0722/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/dew_point_depression> , <http://vocab.nerc.ac.uk/standard_name/dew_point_depression/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G236/> , <http://vocab.nerc.ac.uk/collection/P04/current/G236/>;
        skos:definition        "Dew point depression is also called dew point deficit. It is the amount by which the air temperature exceeds its dew point temperature. Dew point temperature is the temperature at which a parcel of air reaches saturation upon being cooled at constant pressure and specific humidity. It is strongly recommended that a variable with this standard name should have the attribute units_metadata=\"temperature: difference\", meaning that it refers to temperature differences and implying that the origin of the temperature scale is irrelevant, because it is essential to know whether a temperature is on-scale or a difference in order to convert the units correctly (cf. https://cfconventions.org/cf-conventions/cf-conventions.html#temperature-units)."@en;
        skos:notation          "SDN:P07::CFSN0722";
        skos:note              "accepted"@en;
        skos:prefLabel         "dew_point_depression"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UPKA/> , <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/I1VAIV72/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::I1VAIV72";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::I1VAIV72";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/I1VAIV72/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_236mNp/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_236mNp>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Np\" means the element \"neptunium\" and \"236mNp\" is the metastable state of the isotope \"neptunium-236\" with a half-life of 4.72e+10 days."@en;
        skos:notation          "SDN:P07::I1VAIV72";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_236mNp"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N40/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N40";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N40";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N40/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_ethane/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_ethane>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G140/> , <http://vocab.nerc.ac.uk/collection/P02/current/AALK/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for ethane is C2H6. Ethane is a member of the group of hydrocarbons known as alkanes.  There are standard names for the alkane group as well as for some of the individual species."@en;
        skos:notation          "SDN:P07::CF12N40";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_ethane"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1R1EPJXY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1R1EPJXY";
        dc:date                "2015-07-08 15:41:36.0";
        dc:identifier          "SDN:P07::1R1EPJXY";
        pav:authoredOn         "2015-07-08 15:41:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1R1EPJXY/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/distance_from_tropical_cyclone_center_to_leading_edge_of_displaced_convection/> , <http://mmisw.org/ont/cf/parameter/distance_from_tropical_cyclone_center_to_leading_edge_of_displaced_convection>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The great circle distance measured from the tropical cyclone center to the leading edge of displaced convection, which is defined as the closest point that exceeds a threshold brightness temperature at top of atmosphere limit. The threshold applied should be recorded in a coordinate variable having the standard name of toa_brightness_temperature. A coordinate variable with standard name of radiation_wavelength, sensor_band_central_radiation_wavelength, or radiation_frequency may be specified to indicate that the brightness temperature applies at specific wavelengths or frequencies."@en;
        skos:notation          "SDN:P07::1R1EPJXY";
        skos:note              "accepted"@en;
        skos:prefLabel         "distance_from_tropical_cyclone_center_to_leading_edge_of_displaced_convection"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N331/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N331";
        dc:date                "2009-07-06 15:41:29.0";
