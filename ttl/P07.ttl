<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0688/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0688";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0688";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0688/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/downward_heat_flux_at_ground_level_in_snow/> , <http://mmisw.org/ont/cf/parameter/downward_heat_flux_at_ground_level_in_snow>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "ground_level means the land surface (beneath the snow and surface water, if any). 'Downward' indicates a vector component which is positive when directed downward (negative upward). In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0688";
        skos:note              "accepted"@en;
        skos:prefLabel         "downward_heat_flux_at_ground_level_in_snow"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> , <http://vocab.nerc.ac.uk/collection/P04/current/G204/> , <http://vocab.nerc.ac.uk/collection/P64/current/G204/> .

<http://vocab.nerc.ac.uk/collection/P07/current/VB9QKVUA/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::VB9QKVUA";
        dc:date                "2018-02-12 16:53:18.0";
