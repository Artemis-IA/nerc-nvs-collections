<http://vocab.nerc.ac.uk/collection/P07/current/ZU8I1MQR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZU8I1MQR";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::ZU8I1MQR";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ZU8I1MQR/1/>;
