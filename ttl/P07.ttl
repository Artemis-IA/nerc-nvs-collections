        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Ge\" means the element \"germanium\" and \"77Ge\" is the isotope \"germanium-77\" with a half-life of 4.72e-01 days."@en;
        skos:notation          "SDN:P07::4FH5X1PP";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_77Ge"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/QR1UX2GN/>
        rdf:type               skos:Concept;
