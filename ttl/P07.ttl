        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_211Bi/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_211Bi>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Bi\" means the element \"bismuth\" and \"211Bi\" is the isotope \"bismuth-211\" with a half-life of 1.49e-03 days."@en;
        skos:notation          "SDN:P07::N4AII95X";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_211Bi"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

