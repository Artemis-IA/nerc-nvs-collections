        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/lwe_convective_precipitation_rate> , <http://vocab.nerc.ac.uk/standard_name/lwe_convective_precipitation_rate/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G287/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G284/> , <http://vocab.nerc.ac.uk/collection/P64/current/G284/> , <http://vocab.nerc.ac.uk/collection/P64/current/G287/>;
        skos:definition        "Convective precipitation is that produced by the convection schemes in an atmosphere model. \"Precipitation\" in the earth's atmosphere means precipitation of water in all phases. The abbreviation \"lwe\" means liquid water equivalent. \"Precipitation rate\" means the depth or thickness of the layer formed by precipitation per unit time."@en;
        skos:notation          "SDN:P07::CFSN0555";
        skos:note              "accepted"@en;
        skos:prefLabel         "lwe_convective_precipitation_rate"@en;
