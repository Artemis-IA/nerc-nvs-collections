        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. 'tendency_of_X' means derivative of X with respect to time. 'X_area' means the horizontal area occupied by X within the grid cell."@en;
        skos:notation          "SDN:P07::CFSN0191";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_per_unit_area_due_to_advection"@en;
