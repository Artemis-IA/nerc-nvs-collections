        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N10/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_fraction_of_atomic_bromine_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_fraction_of_atomic_bromine_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/H321/>;
        skos:definition        "Mole fraction is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y.  The chemical symbol of atomic bromine is Br."@en;
        skos:notation          "SDN:P07::CFV8N10";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_atomic_bromine_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N151/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N151";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N151";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N151/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N151/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_hydroperoxyl_radical/> , <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_hydroperoxyl_radical>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G153/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for the hydroperoxyl radical is HO2. In chemistry, a \"radical\" is a highly reactive, and therefore short lived, species."@en;
        skos:notation          "SDN:P07::CF12N151";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_hydroperoxyl_radical"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/4H9HEFGN/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::4H9HEFGN";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::4H9HEFGN";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/4H9HEFGN/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
