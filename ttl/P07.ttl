        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Fr\" means the element \"francium\" and \"223Fr\" is the isotope \"francium-223\" with a half-life of 1.53e-02 days."@en;
        skos:notation          "SDN:P07::CD12V8PY";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_223Fr"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/HMZSV9F1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::HMZSV9F1";
        dc:date                "2023-02-06 17:17:13.0";
        dc:identifier          "SDN:P07::HMZSV9F1";
        pav:authoredOn         "2023-02-06 17:17:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/HMZSV9F1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/moles_of_nitrous_oxide_per_unit_mass_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/moles_of_nitrous_oxide_per_unit_mass_in_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The construction \"moles_of_X_per_unit_mass_in_Y\" is also called \"molality\" of X in Y, where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for nitrous oxide is N2O. The chemical formula for nitrous oxide is N2O. The equivalent term in the NERC P01 Parameter Usage Vocabulary may be found at http://vocab.nerc.ac.uk/collection/P01/current/DN2OZZ01/."@en;
        skos:notation          "SDN:P07::HMZSV9F1";
        skos:note              "accepted"@en;
        skos:prefLabel         "moles_of_nitrous_oxide_per_unit_mass_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLKG/> .

<http://vocab.nerc.ac.uk/collection/P07/current/0ZBVYBT4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::0ZBVYBT4";
        dc:date                "2018-02-12 16:53:18.0";
