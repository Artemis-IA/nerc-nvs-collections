        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"In\" means the element \"indium\" and \"113mIn\" is the metastable state of the isotope \"indium-113\" with a half-life of 6.92e-02 days."@en;
        skos:notation          "SDN:P07::FPNGM6MF";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_113mIn_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0098/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0098";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::CFSN0098";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0098/2/>;
