<http://vocab.nerc.ac.uk/collection/P07/current/4RELXICV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::4RELXICV";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::4RELXICV";
