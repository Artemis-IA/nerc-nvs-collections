        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Na\" means the element \"sodium\" and \"24Na\" is the isotope \"sodium-24\" with a half-life of 6.27e-01 days."@en;
        skos:notation          "SDN:P07::OARURFMQ";
