        dc:identifier          "SDN:P07::CFSN0319";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0319/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/square_of_eastward_wind> , <http://vocab.nerc.ac.uk/standard_name/square_of_eastward_wind/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/EWSB/>;
        skos:definition        "'square_of_X' means X*X. 'Eastward' indicates a vector component which is positive when directed eastward (negative westward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)"@en;
        skos:notation          "SDN:P07::CFSN0319";
        skos:note              "accepted"@en;
        skos:prefLabel         "square_of_eastward_wind"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P64/current/G250/> , <http://vocab.nerc.ac.uk/collection/P04/current/G982/> , <http://vocab.nerc.ac.uk/collection/P04/current/G250/> , <http://vocab.nerc.ac.uk/collection/P64/current/G982/> , <http://vocab.nerc.ac.uk/collection/P06/current/SQM2/> , <http://vocab.nerc.ac.uk/collection/P64/current/G245/> , <http://vocab.nerc.ac.uk/collection/P64/current/G256/> , <http://vocab.nerc.ac.uk/collection/P04/current/G245/> , <http://vocab.nerc.ac.uk/collection/P64/current/G248/> , <http://vocab.nerc.ac.uk/collection/P04/current/G256/> , <http://vocab.nerc.ac.uk/collection/P64/current/G252/> , <http://vocab.nerc.ac.uk/collection/P04/current/G252/> , <http://vocab.nerc.ac.uk/collection/P04/current/G248/> .

<http://vocab.nerc.ac.uk/collection/P07/current/IWH4JHDZ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::IWH4JHDZ";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::IWH4JHDZ";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/IWH4JHDZ/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_94mNb/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_94mNb>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Nb\" means the element \"niobium\" and \"94mNb\" is the metastable state of the isotope \"niobium-94\" with a half-life of 4.34e-03 days."@en;
        skos:notation          "SDN:P07::IWH4JHDZ";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_94mNb"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/XA00ZM9D/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::XA00ZM9D";
        dc:date                "2018-05-15 09:59:16.0";
        dc:identifier          "SDN:P07::XA00ZM9D";
        pav:authoredOn         "2018-05-15 09:59:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/XA00ZM9D/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_hail_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_hail_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mass fraction is used in the construction \"mass_fraction_of_X_in_Y\", where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). Hail is precipitation in the form of balls or irregular lumps of ice, often restricted by a size convention to diameters of 5 mm or more. Reference: American Meteorological Society Glossary http://glossary.ametsoc.org/wiki/Hail. For diameters of less than 5 mm standard names for \"graupel\" should be used. Standard names for \"graupel_and_hail\" should be used to describe data produced by models that do not distinguish between hail and graupel."@en;
        skos:notation          "SDN:P07::XA00ZM9D";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_hail_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

