        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0673/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/downwelling_photon_flux_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/downwelling_photon_flux_in_sea_water/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G947/> , <http://vocab.nerc.ac.uk/collection/P02/current/VSRW/> , <http://vocab.nerc.ac.uk/collection/P04/current/G947/>;
        skos:definition        "Downwelling radiation is radiation from above. It does not mean \"net downward\". The sign convention is that \"upwelling\" is positive upwards and \"downwelling\" is positive downwards. A photon flux is specified in terms of numbers of photons expressed in moles. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFSN0673";
        skos:note              "accepted"@en;
        skos:prefLabel         "downwelling_photon_flux_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/M2MS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N77/>
        rdf:type               skos:Concept;
