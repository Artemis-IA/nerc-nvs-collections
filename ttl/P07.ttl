<http://vocab.nerc.ac.uk/collection/P07/current/PL2XA37D/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::PL2XA37D";
        dc:date                "2017-02-21 16:01:59.0";
        dc:identifier          "SDN:P07::PL2XA37D";
        pav:authoredOn         "2017-02-21 16:01:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/PL2XA37D/1/>;
