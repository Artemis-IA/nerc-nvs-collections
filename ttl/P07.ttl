        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cd\" means the element \"cadmium\" and \"111mCd\" is the metastable state of the isotope \"cadmium-111\" with a half-life of 3.39e-02 days."@en;
        skos:notation          "SDN:P07::Z8C3JGXG";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_111mCd_in_air"@en;
