<http://vocab.nerc.ac.uk/collection/P07/current/HR5LDNVI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::HR5LDNVI";
        dc:date                "2025-01-20 16:07:13.0";
        dc:identifier          "SDN:P07::HR5LDNVI";
        pav:authoredOn         "2025-01-20 16:07:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/HR5LDNVI/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/HR5LDNVI/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/reference_mole_fraction_of_ozone_in_air/> , <http://mmisw.org/ont/cf/parameter/reference_mole_fraction_of_ozone_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "This ozone field acts as a reference ozone field in a diagnostic call to the model's radiation scheme. \"Mole fraction\" is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y. The chemical formula for ozone is O3. The IUPAC name for ozone is trioxygen."@en;
        skos:notation          "SDN:P07::HR5LDNVI";
        skos:note              "accepted"@en;
        skos:prefLabel         "reference_mole_fraction_of_ozone_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MPMX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/SHL2LO1H/>
