        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Pr\" means the element \"praseodymium\" and \"144mPr\" is the metastable state of the isotope \"praseodymium-144\" with a half-life of 4.98e-03 days."@en;
        skos:notation          "SDN:P07::FWUOG935";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_144mPr"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/DLG3CCDY/>
        rdf:type               skos:Concept;
