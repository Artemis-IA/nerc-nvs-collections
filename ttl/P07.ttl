        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/duration_of_sunshine> , <http://vocab.nerc.ac.uk/standard_name/duration_of_sunshine/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OMET/> , <http://vocab.nerc.ac.uk/collection/P64/current/G217/> , <http://vocab.nerc.ac.uk/collection/P04/current/G217/>;
        skos:definition        "The WMO definition of sunshine is that the surface incident radiative flux from the solar beam (i.e. excluding diffuse skylight) exceeds 120 W m-2. 'Duration' is the length of time for which a condition holds."@en;
        skos:notation          "SDN:P07::CFSN0643";
        skos:note              "accepted"@en;
        skos:prefLabel         "duration_of_sunshine"@en;
