        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ce\" means the element \"cerium\" and \"146Ce\" is the isotope \"cerium-146\" with a half-life of 9.86e-03 days."@en;
        skos:notation          "SDN:P07::PQU95E0P";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_146Ce_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1I8JWDXM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1I8JWDXM";
        dc:date                "2021-09-20 14:41:46.0";
        dc:identifier          "SDN:P07::1I8JWDXM";
        pav:authoredOn         "2021-09-20 14:41:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1I8JWDXM/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_ice_floe_diameter/> , <http://mmisw.org/ont/cf/parameter/sea_ice_floe_diameter>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs. An ice floe is a flat expanse of sea ice, generally taken to be less than 10 km across. ice_floe_diameter corresponds to the diameter of a circle with the same area as the ice floe."@en;
        skos:notation          "SDN:P07::1I8JWDXM";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_ice_floe_diameter"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N160/>
        rdf:type               skos:Concept;
