        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_hcfc141b_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_hcfc141b_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G148/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for HCFC141b is CH3CCl2F. The IUPAC name for HCFC141b is 1,1-dichloro-1-fluoroethane."@en;
        skos:notation          "SDN:P07::CF12N465";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_hcfc141b_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1M87330L/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1M87330L";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::1M87330L";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1M87330L/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_137Xe_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_137Xe_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Xe\" means the element \"xenon\" and \"137Xe\" is the isotope \"xenon-137\" with a half-life of 2.71e-03 days."@en;
        skos:notation          "SDN:P07::1M87330L";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_137Xe_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/03TIMQNC/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::03TIMQNC";
        dc:date                "2016-05-17 15:31:00.0";
        dc:identifier          "SDN:P07::03TIMQNC";
        pav:authoredOn         "2016-05-17 15:31:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/03TIMQNC/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/pressure_at_effective_cloud_top_defined_by_infrared_radiation/> , <http://mmisw.org/ont/cf/parameter/pressure_at_effective_cloud_top_defined_by_infrared_radiation>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The \"effective cloud top defined by infrared radiation\" is (approximately) the geometric height above the surface that is one optical depth at infrared wavelengths (in the region of 11 micrometers) below the cloud top that would be detected by visible and lidar techniques. Reference: Minnis, P. et al 2011 CERES Edition-2 Cloud Property Retrievals Using TRMM VIRS and Terra and Aqua MODIS Data x2014; Part I: Algorithms IEEE Transactions on Geoscience and Remote Sensing, 49(11), 4374-4400. doi: http://dx.doi.org/10.1109/TGRS.2011.2144601."@en;
        skos:notation          "SDN:P07::03TIMQNC";
        skos:note              "accepted"@en;
        skos:prefLabel         "pressure_at_effective_cloud_top_defined_by_infrared_radiation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/0PVCZPS1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::0PVCZPS1";
        dc:date                "2013-06-27 14:07:54.0";
        dc:identifier          "SDN:P07::0PVCZPS1";
        pav:authoredOn         "2013-06-27 14:07:54.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/0PVCZPS1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/toa_outgoing_radiance_per_unit_wavelength/> , <http://mmisw.org/ont/cf/parameter/toa_outgoing_radiance_per_unit_wavelength>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/VSRA/>;
        skos:definition        "\"toa\" means top of atmosphere. The TOA outgoing radiance is the upwelling radiance, i.e., toward outer space.  Radiance is the radiative flux in a particular direction, per unit of solid angle. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::0PVCZPS1";
        skos:note              "accepted"@en;
        skos:prefLabel         "toa_outgoing_radiance_per_unit_wavelength"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/WM2S/> .

<http://vocab.nerc.ac.uk/collection/P07/current/V2ANACEJ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::V2ANACEJ";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::V2ANACEJ";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/V2ANACEJ/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_224Ra/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_224Ra>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Ra\" means the element \"radium\" and \"224Ra\" is the isotope \"radium-224\" with a half-life of 3.65e+00 days."@en;
        skos:notation          "SDN:P07::V2ANACEJ";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_224Ra"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N178/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N178";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N178";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N178/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N178/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_toluene/> , <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_toluene>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OHAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G140/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for toluene is C6H5CH3. Toluene has the same structure as benzene, except that one of the hydrogen atoms is replaced by a methyl group. The IUPAC name for toluene is methylbenzene."@en;
        skos:notation          "SDN:P07::CF12N178";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_toluene"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ZSJD1SUA/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZSJD1SUA";
        dc:date                "2018-05-15 09:59:16.0";
        dc:identifier          "SDN:P07::ZSJD1SUA";
        pav:authoredOn         "2018-05-15 09:59:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ZSJD1SUA/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/precipitation_flux_containing_single_2H/> , <http://mmisw.org/ont/cf/parameter/precipitation_flux_containing_single_2H>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. \"Precipitation\" in the earth's atmosphere means precipitation of water in all phases. The chemical formula for water is H2O. \"H\" means the element \"hydrogen\" and \"2H\" is the stable isotope \"hydrogen-2\", usually called \"deuterium\". The construction \"X_containing_single_Y\" means the standard name refers to only that part of X composed of molecules containing a single atom of isotope Y."@en;
        skos:notation          "SDN:P07::ZSJD1SUA";
        skos:note              "accepted"@en;
        skos:prefLabel         "precipitation_flux_containing_single_2H"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0445/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0445";
        dc:date                "2018-10-15 12:56:49.0";
        dc:identifier          "SDN:P07::CFSN0445";
        pav:authoredOn         "2018-10-15 12:56:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0445/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0445/3/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0445/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0445/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/B39/current/gndspeed/> , <http://mmisw.org/ont/cf/parameter/platform_speed_wrt_ground> , <http://vocab.nerc.ac.uk/standard_name/platform_speed_wrt_ground/>;
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/APDA/> , <http://vocab.nerc.ac.uk/collection/P64/current/H156/> , <http://vocab.nerc.ac.uk/collection/P04/current/H156/>;
        skos:definition        "Speed is the magnitude of velocity. The abbreviation \"wrt\" means with respect to. The platform speed with respect to ground is relative to the solid Earth beneath it, i.e. the sea floor for a ship. It is often called the \"ground speed\" of the platform. A \"platform\" is a structure or vehicle that serves as a base for mounting sensors. Platforms include, but are not limited to, satellites, aeroplanes, ships, buoys, instruments, ground stations, and masts."@en;
        skos:notation          "SDN:P07::CFSN0445";
        skos:note              "accepted"@en;
        skos:prefLabel         "platform_speed_wrt_ground"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N735/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N735";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N735";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N735/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_moles_of_ozone/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_moles_of_ozone>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OZON/> , <http://vocab.nerc.ac.uk/collection/P04/current/G164/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for ozone is O3."@en;
        skos:notation          "SDN:P07::CF12N735";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_moles_of_ozone"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N19/>
        rdf:type               skos:Concept;
