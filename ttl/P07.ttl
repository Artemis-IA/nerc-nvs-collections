<http://vocab.nerc.ac.uk/collection/P07/current/CF12N654/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N654";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N654";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N654/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_nitrous_oxide_due_to_emission> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_nitrous_oxide_due_to_emission/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://rdfdata.eionet.europa.eu/airquality/components/9> , <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P04/current/G161/> , <http://vocab.nerc.ac.uk/collection/P04/current/G162/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The specification of a physical process by the phrase due_to_process means that the quantity named is a  single term in a sum of terms which together compose the general quantity  named by omitting the phrase.  \"tendency_of_X\" means derivative of X with respect to time.  \"Emission\" means emission from a primary source located anywhere within the atmosphere, including at the lower boundary (i.e. earth's surface). \"Emission\" is a process entirely distinct from \"re-emission\" which is used in some standard names. The chemical formula for nitrous oxide is N2O."@en;
        skos:notation          "SDN:P07::CF12N654";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_nitrous_oxide_due_to_emission"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> , <http://www.eionet.europa.eu/gemet/concept/2663> .

<http://vocab.nerc.ac.uk/collection/P07/current/Z65YIO2Q/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::Z65YIO2Q";
        dc:date                "2016-11-15 16:43:21.0";
        dc:identifier          "SDN:P07::Z65YIO2Q";
        pav:authoredOn         "2016-11-15 16:43:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/Z65YIO2Q/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/iron_growth_limitation_of_diatoms/> , <http://mmisw.org/ont/cf/parameter/iron_growth_limitation_of_diatoms>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Diatoms are phytoplankton with an external skeleton made of silica. Phytoplankton are algae that grow where there is sufficient light to support photosynthesis. \"Iron growth limitation\" means the ratio of the growth rate of a species population in the environment (where there is a finite availability of iron) to the theoretical growth rate if there were no such limit on iron availability."@en;
        skos:notation          "SDN:P07::Z65YIO2Q";
        skos:note              "accepted"@en;
        skos:prefLabel         "iron_growth_limitation_of_diatoms"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1IXM3VKH/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1IXM3VKH";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::1IXM3VKH";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1IXM3VKH/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
