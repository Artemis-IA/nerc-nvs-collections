        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Shear strength is the amount of force applied to a normal plane required to bring a frozen soil to failure along a tangential plane. Shear strength depends on the angle of friction and cohesion of the soil."@en;
        skos:notation          "SDN:P07::1SLC8V4I";
        skos:note              "accepted"@en;
        skos:prefLabel         "shear_strength_of_frozen_soil"@en;
