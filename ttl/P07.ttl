        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/ACO2/> , <http://vocab.nerc.ac.uk/collection/P04/current/G132/> , <http://vocab.nerc.ac.uk/collection/A05/current/EV_CO2/>;
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged. The chemical formula for carbon dioxide is CO2."@en;
        skos:notation          "SDN:P07::CFSN0243";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_partial_pressure_of_carbon_dioxide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

