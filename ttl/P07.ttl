        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N22/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_nitric_acid_due_to_wet_deposition/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_nitric_acid_due_to_wet_deposition>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. \"Wet deposition\" means deposition by precipitation."@en;
        skos:notation          "SDN:P07::CFV7N22";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_nitric_acid_due_to_wet_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> , <http://vocab.nerc.ac.uk/collection/P04/current/G157/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0385/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0385";
