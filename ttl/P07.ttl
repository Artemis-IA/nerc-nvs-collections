        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"U\" means the element \"uranium\" and \"230U\" is the isotope \"uranium-230\" with a half-life of 2.08e+01 days."@en;
        skos:notation          "SDN:P07::GT7CMEQ2";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_230U_in_air"@en;
