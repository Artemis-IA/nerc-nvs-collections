        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::03FMQBY3";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::03FMQBY3";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/03FMQBY3/1/>;
