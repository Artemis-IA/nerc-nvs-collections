        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_gaseous_divalent_mercury/> , <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_gaseous_divalent_mercury>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. \"Divalent mercury\" means all compounds in which the mercury has two binding sites to other ion(s) in a salt or to other atom(s) in a molecule."@en;
        skos:notation          "SDN:P07::CF12N141";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_gaseous_divalent_mercury"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/EPRNJ853/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::EPRNJ853";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::EPRNJ853";
