        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G999/> , <http://vocab.nerc.ac.uk/collection/P04/current/G503/> , <http://vocab.nerc.ac.uk/collection/P64/current/G503/> , <http://vocab.nerc.ac.uk/collection/P04/current/G999/> , <http://vocab.nerc.ac.uk/collection/P25/current/ICETHICK/> , <http://vocab.nerc.ac.uk/collection/P04/current/G529/> , <http://vocab.nerc.ac.uk/collection/P04/current/G633/> , <http://vocab.nerc.ac.uk/collection/P02/current/CRYS/> , <http://vocab.nerc.ac.uk/collection/P64/current/G529/>;
        skos:definition        "\"Floating ice\" means any ice that is floating on water, e.g. on a sea or lake surface.  \"Thickness\" means the vertical extent of the ice."@en;
