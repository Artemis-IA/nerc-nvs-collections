        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Th\" means the element \"thorium\" and \"230Th\" is the isotope \"thorium-230\" with a half-life of 2.92e+07 days."@en;
        skos:notation          "SDN:P07::QR1UX2GN";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_230Th"@en;
