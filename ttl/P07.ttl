        owl:sameAs             <http://mmisw.org/ont/cf/parameter/model_level_number_at_convective_cloud_top> , <http://vocab.nerc.ac.uk/standard_name/model_level_number_at_convective_cloud_top/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AHGT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G264/> , <http://vocab.nerc.ac.uk/collection/P64/current/G264/>;
        skos:definition        "cloud_top refers to the top of the highest cloud. Model level number should be understood as equivalent to layer number. Convective cloud is that produced by the convection schemes in an atmosphere model."@en;
