<http://vocab.nerc.ac.uk/collection/P07/current/CF12N671/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N671";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N671";
