        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Br\" means the element \"bromine\" and \"82Br\" is the isotope \"bromine-82\" with a half-life of 1.47e+00 days."@en;
        skos:notation          "SDN:P07::POVWZ994";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_82Br"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

