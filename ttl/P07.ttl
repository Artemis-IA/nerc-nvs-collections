        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"U\" means the element \"uranium\" and \"233U\" is the isotope \"uranium-233\" with a half-life of 5.90e+07 days."@en;
        skos:notation          "SDN:P07::7W9ONFK7";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_233U_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0254/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0254";
        dc:date                "2021-01-18 16:23:44.0";
        dc:identifier          "SDN:P07::CFSN0254";
        pav:authoredOn         "2021-01-18 16:23:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0254/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0254/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_snow_melt_flux> , <http://vocab.nerc.ac.uk/standard_name/surface_snow_melt_flux/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G523/> , <http://vocab.nerc.ac.uk/collection/P64/current/G523/> , <http://vocab.nerc.ac.uk/collection/P04/current/G646/>;
        skos:definition        "Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants. The surface called \"surface\" means the lower boundary of the atmosphere. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFSN0254";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_snow_melt_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N410/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N410";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N410";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N410/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N410/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_peroxyacetyl_nitrate_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_peroxyacetyl_nitrate_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/>;
        skos:definition        "\"Mass fraction\" is used in the construction \"mass_fraction_of_X_in_Y\", where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for peroxyacetyl nitrate, sometimes referred to as PAN, is CH3COO2NO2. The IUPAC name for peroxyacetyl nitrate is nitroethaneperoxoate."@en;
        skos:notation          "SDN:P07::CF12N410";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_peroxyacetyl_nitrate_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/VXJU0JEL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::VXJU0JEL";
        dc:date                "2026-06-08 13:55:32.0";
        dc:identifier          "SDN:P07::VXJU0JEL";
        pav:authoredOn         "2026-06-08 13:55:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/VXJU0JEL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_content_of_organic_mercury_in_sea_floor_sediment_mixed_layer/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. \"Organic mercury\" describes a family of chemical species in which mercury atoms are covalently bonded to carbon-containing groups, forming organomercury compounds. The surface called \"sea floor\" means the lower boundary of the ocean. \"Sea floor sediment\" is sediment deposited at the sea bed. The sea floor sediment mixed layer describes the uppermost layer (approximately 5-10 cm) of sediments, where sediments are likely to be resuspended."@en;
        skos:notation          "SDN:P07::VXJU0JEL";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_content_of_organic_mercury_in_sea_floor_sediment_mixed_layer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM2/> .

