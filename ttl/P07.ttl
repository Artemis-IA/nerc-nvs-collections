        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ra\" means the element \"radium\" and \"225Ra\" is the isotope \"radium-225\" with a half-life of 1.48e+01 days."@en;
        skos:notation          "SDN:P07::6PV171LU";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_225Ra_in_air"@en;
