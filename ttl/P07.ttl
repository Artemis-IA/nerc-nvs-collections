        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_halon1211_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_halon1211_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G147/>;
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for Halon1211 is CBrClF2. The IUPAC name for Halon1211 is bromo-chloro-difluoromethane."@en;
        skos:notation          "SDN:P07::CF12N262";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_halon1211_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/PGFUZ9AW/>
