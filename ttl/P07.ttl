<http://vocab.nerc.ac.uk/collection/P07/current/CF14N34/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N34";
        dc:date                "2018-12-17 17:17:12.0";
        dc:identifier          "SDN:P07::CF14N34";
        pav:authoredOn         "2018-12-17 17:17:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF14N34/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF14N34/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_miscellaneous_phytoplankton_expressed_as_carbon_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_miscellaneous_phytoplankton_expressed_as_carbon_in_sea_water>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CNTX/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. \"Miscellaneous phytoplankton\" are all those phytoplankton that are not diatoms, diazotrophs, calcareous phytoplankton, picophytoplankton or other separately named components of the phytoplankton population. Phytoplankton are algae that grow where there is sufficient light to support photosynthesis."@en;
        skos:notation          "SDN:P07::CF14N34";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_miscellaneous_phytoplankton_expressed_as_carbon_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

