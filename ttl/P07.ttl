        skos:prefLabel         "atmosphere_net_rate_of_absorption_of_longwave_energy"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV10N46/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV10N46";
        dc:date                "2008-10-21 10:00:00.0";
        dc:identifier          "SDN:P07::CFV10N46";
