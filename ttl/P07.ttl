        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P04/current/H017/> , <http://vocab.nerc.ac.uk/collection/P04/current/G520/> , <http://vocab.nerc.ac.uk/collection/P64/current/H017/> , <http://mmisw.org/ont/cf/parameter/sea_ice_freeboard> , <http://vocab.nerc.ac.uk/collection/P64/current/G520/> , <http://vocab.nerc.ac.uk/standard_name/sea_ice_freeboard/>;
        owl:versionInfo        "2";
