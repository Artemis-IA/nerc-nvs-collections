<http://vocab.nerc.ac.uk/collection/P07/current/QU91NLO7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::QU91NLO7";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::QU91NLO7";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/QU91NLO7/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
