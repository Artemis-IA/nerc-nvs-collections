        owl:sameAs             <http://mmisw.org/ont/cf/parameter/sea_water_pressure_at_sea_water_surface> , <http://vocab.nerc.ac.uk/standard_name/sea_water_pressure_at_sea_water_surface/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G958/> , <http://vocab.nerc.ac.uk/collection/P04/current/G958/>;
        skos:definition        "The phrase \"sea water surface\" means the upper boundary of the liquid portion of an ocean or sea, including the boundary to floating ice if present. \"Sea water pressure\" is the pressure that exists in the medium of sea water. It includes the pressure due to overlying sea water, sea ice, air and any other medium that may be present."@en;
        skos:notation          "SDN:P07::CF12N584";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_water_pressure_at_sea_water_surface"@en;
