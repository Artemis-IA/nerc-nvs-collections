        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Se\" means the element \"selenium\" and \"79Se\" is the isotope \"selenium-79\" with a half-life of 2.37e+07 days."@en;
        skos:notation          "SDN:P07::Z4JJUOOO";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_79Se_in_air"@en;
