        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Te\" means the element \"tellurium\" and \"134Te\" is the isotope \"tellurium-134\" with a half-life of 2.92e-02 days."@en;
        skos:notation          "SDN:P07::QX5D34UU";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_134Te_in_air"@en;
