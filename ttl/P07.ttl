<http://vocab.nerc.ac.uk/collection/P07/current/1U1P3ED5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1U1P3ED5";
        dc:date                "2020-03-09 15:56:07.0";
        dc:identifier          "SDN:P07::1U1P3ED5";
        pav:authoredOn         "2020-03-09 15:56:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1U1P3ED5/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/location_test_quality_flag/> , <http://mmisw.org/ont/cf/parameter/location_test_quality_flag>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A quality flag that reports the result of the Location test, which checks that a location is within reasonable bounds. The linkage between the data variable and this variable is achieved using the ancillary_variables attribute. There are standard names for other specific quality tests which take the form of X_quality_flag. Quality information that does not match any of the specific quantities should be given the more general standard name of quality_flag."@en;
        skos:notation          "SDN:P07::1U1P3ED5";
        skos:note              "accepted"@en;
        skos:prefLabel         "location_test_quality_flag"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0071/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0071";
        dc:date                "2007-05-15 11:55:00.0";
