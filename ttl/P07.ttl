        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The radius of a tropical cyclone eye is defined to be the great circle distance measured from the cyclone center to the eye wall."@en;
        skos:notation          "SDN:P07::1FKFI8Q2";
        skos:note              "accepted"@en;
        skos:prefLabel         "radius_of_tropical_cyclone_eye"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/BJ3ONH9W/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::BJ3ONH9W";
        dc:date                "2023-04-24 17:39:19.0";
        dc:identifier          "SDN:P07::BJ3ONH9W";
        pav:authoredOn         "2023-04-24 17:39:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/BJ3ONH9W/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/keetch_byram_drought_index/> , <http://mmisw.org/ont/cf/parameter/keetch_byram_drought_index>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The Keetch Byram Drought Index (KBDI) is a numerical drought index ranging from 0 to 800 that estimates the cumulative moisture deficiency in soil. It is a cumulative index. It is a function of maximum temperature and precipitation over the previous 24 hours."@en;
        skos:notation          "SDN:P07::BJ3ONH9W";
        skos:note              "accepted"@en;
        skos:prefLabel         "keetch_byram_drought_index"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

