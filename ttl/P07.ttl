        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Nd\" means the element \"neodymium\" and \"151Nd\" is the isotope \"neodymium-151\" with a half-life of 8.61e-03 days."@en;
        skos:notation          "SDN:P07::1WRX8EPL";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_151Nd"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N707/>
        rdf:type               skos:Concept;
