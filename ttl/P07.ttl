        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Tb\" means the element \"terbium\" and \"160Tb\" is the isotope \"terbium-160\" with a half-life of 7.23e+01 days."@en;
        skos:notation          "SDN:P07::NZS8XC26";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_160Tb_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

