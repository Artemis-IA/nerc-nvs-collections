<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N31/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV7N31";
        dc:date                "2007-11-21 17:19:40.0";
        dc:identifier          "SDN:P07::CFV7N31";
