        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_nitrogen_monoxide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N83/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N83";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N83";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N83/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_nitrogen_monoxide> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_nitrogen_monoxide/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P04/current/G161/> , <http://vocab.nerc.ac.uk/collection/P04/current/G158/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for nitrogen monoxide is NO."@en;
        skos:notation          "SDN:P07::CF12N83";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_nitrogen_monoxide"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/VGXTAJQ9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::VGXTAJQ9";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::VGXTAJQ9";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/VGXTAJQ9/1/>;
