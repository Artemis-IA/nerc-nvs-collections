        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Nb\" means the element \"niobium\" and \"98Nb\" is the isotope \"niobium-98\" with a half-life of 3.53e-02 days."@en;
        skos:notation          "SDN:P07::FK88QDQ8";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_98Nb"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/DWPJP8AY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::DWPJP8AY";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::DWPJP8AY";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/DWPJP8AY/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_216At/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_216At>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"At\" means the element \"astatine\" and \"216At\" is the isotope \"astatine-216\" with a half-life of 3.47e-09 days."@en;
        skos:notation          "SDN:P07::DWPJP8AY";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_216At"@en;
