        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pb\" means the element \"lead\" and \"207mPb\" is the metastable state of the isotope \"lead-207\" with a half-life of 9.26e-06 days."@en;
        skos:notation          "SDN:P07::4RELXICV";
