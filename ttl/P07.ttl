        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/2UWOLA6D/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_251Cf_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_251Cf_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cf\" means the element \"californium\" and \"251Cf\" is the isotope \"californium-251\" with a half-life of 2.92e+05 days."@en;
        skos:notation          "SDN:P07::2UWOLA6D";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_251Cf_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

