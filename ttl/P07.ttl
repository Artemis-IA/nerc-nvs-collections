        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G154/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for the hydroxyl radical is OH. In chemistry, a \"radical\" is a highly reactive, and therefore short lived, species."@en;
        skos:notation          "SDN:P07::CF12N152";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_hydroxyl_radical"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/6TGE85LS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::6TGE85LS";
