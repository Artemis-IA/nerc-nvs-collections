<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0007/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0007";
        dc:date                "2011-03-23 08:11:19.0";
        dc:identifier          "SDN:P07::CFSN0007";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/BBAD2159/>;
