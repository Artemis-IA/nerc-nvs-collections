        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/height_above_mean_sea_level/> , <http://mmisw.org/ont/cf/parameter/height_above_mean_sea_level>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Height_above_X\" means the vertical distance above the named surface X. \"Mean sea level\" means the time mean of sea surface elevation at a given location over an arbitrary period sufficient to eliminate the tidal signals."@en;
        skos:notation          "SDN:P07::8BFOBHU2";
        skos:note              "accepted"@en;
        skos:prefLabel         "height_above_mean_sea_level"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

