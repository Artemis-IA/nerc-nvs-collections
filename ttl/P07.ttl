        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pa\" means the element \"protactinium\" and \"231Pa\" is the isotope \"protactinium-231\" with a half-life of 1.19e+07 days."@en;
        skos:notation          "SDN:P07::PZOEAFL1";
