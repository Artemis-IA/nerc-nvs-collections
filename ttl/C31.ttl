<http://vocab.nerc.ac.uk/collection/C31/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the international exchange of meteorological and metocean data between national meteorological organisations";
        dc:alternative          "WMO VOS category";
        dc:creator              "World Meteorological Organisation";
        dc:date                 "2005-12-31 12:00:00.0";
        dc:description          "WMO ship type codes used to classify voluntary observing ships. Source: [WMO No.47 - International List of Selected, Supplementary and Auxiliary Ships](http://www.wmo.int/pages/prog/www/ois/pub47/pub47-home.htm).";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "World Meteorological Organisation voluntary observing ship category";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "World Meteorological Organisation";
