        dc:publisher            "Natural Environment Research Council";
        dc:title                "SeaDataNet measurand qualifier flags";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "SeaDataNet";
        owl:versionInfo         "8";
        skos:altLabel           "SeaDataNet flags";
        skos:altLabel           "drapeaux SeaDataNet"@fr ;
        skos:member             <http://vocab.nerc.ac.uk/collection/L20/current/9/> , <http://vocab.nerc.ac.uk/collection/L20/current/0/> , <http://vocab.nerc.ac.uk/collection/L20/current/6/> , <http://vocab.nerc.ac.uk/collection/L20/current/7/> , <http://vocab.nerc.ac.uk/collection/L20/current/B/> , <http://vocab.nerc.ac.uk/collection/L20/current/8/> , <http://vocab.nerc.ac.uk/collection/L20/current/1/> , <http://vocab.nerc.ac.uk/collection/L20/current/3/> , <http://vocab.nerc.ac.uk/collection/L20/current/5/> , <http://vocab.nerc.ac.uk/collection/L20/current/Q/> , <http://vocab.nerc.ac.uk/collection/L20/current/2/> , <http://vocab.nerc.ac.uk/collection/L20/current/4/> , <http://vocab.nerc.ac.uk/collection/L20/current/A/>;
        skos:prefLabel          "SeaDataNet measurand qualifier flags" ;
