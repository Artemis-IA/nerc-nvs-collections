<http://vocab.nerc.ac.uk/collection/C88/current/BODCSR01/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C88::BODCSR01";
        dc:date                "2011-12-12 09:37:36.0";
        dc:identifier          "SDN:C88::BODCSR01";
