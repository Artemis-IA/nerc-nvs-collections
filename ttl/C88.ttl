        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "anonymous";
        skos:definition        "Anybody not registered in the BODC database. As BODC needs to provide originators with information on who has accessed their data, no data can be delivered to anonymous users.  However, anonymous users can access metadata."@en;
        skos:definition        "Toute personne non enregistrée dans la base de données du BODC. Le BODC devant fournir aux producteurs d'origine des informations sur qui a accédé à leurs données, aucune donnée ne peut être livrée aux utilisateurs anonymes. Cependant, les utilisateurs anonymes peuvent accéder aux métadonnées."@fr ;
        skos:notation          "SDN:C88::BODCSR01";
        skos:note              "accepted"@en;
        skos:prefLabel         "Anonymous"@en ;
        skos:prefLabel         "Anonyme"@fr .

