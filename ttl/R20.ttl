        skos:notation          "SDN:R20::C";
        skos:note              "accepted"@en;
        skos:prefLabel         "Grounded (external bathymetry database check), but free-drift period not affected"@en .

<http://vocab.nerc.ac.uk/collection/R20/current/Y/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R20::Y";
        dc:date                "2021-02-08 16:25:46.0";
        dc:identifier          "SDN:R20::Y";
        pav:authoredOn         "2021-02-08 16:25:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R20/current/Y/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R20/current/Y/1/> , <http://vocab.nerc.ac.uk/collection/R20/current/Y/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Y";
        skos:definition        "Yes, the float touched the ground and the programmed free-drift period was affected. If it is uncertain what mission phase the grounding took place, use 'Y'."@en;
        skos:notation          "SDN:R20::Y";
        skos:note              "accepted"@en;
        skos:prefLabel         "Grounded, and free-drift period affected"@en .

<http://vocab.nerc.ac.uk/collection/R20/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the Argo data system, published and maintained by the Argo Data Management Team (ADMT) and hosted on the NERC Vocabulary Server.";
