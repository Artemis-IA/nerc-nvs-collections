<http://vocab.nerc.ac.uk/collection/R20/current/P/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R20::P";
        dc:date                "2021-02-08 16:07:23.0";
        dc:identifier          "SDN:R20::P";
        pav:authoredOn         "2021-02-08 16:07:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R20/current/P/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "P";
        skos:definition        "Yes, the float touched the ground during a part of the mission that did not affect the free-drift period."@en;
        skos:notation          "SDN:R20::P";
        skos:note              "accepted"@en;
        skos:prefLabel         "Grounded, but free-drift period not affected"@en .

<http://vocab.nerc.ac.uk/collection/R20/current/C/>
        rdf:type               skos:Concept;
