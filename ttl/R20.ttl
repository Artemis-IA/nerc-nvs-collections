<http://vocab.nerc.ac.uk/collection/R20/current/S/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R20::S";
        dc:date                "2021-02-08 16:23:27.0";
        dc:identifier          "SDN:R20::S";
        pav:authoredOn         "2021-02-08 16:23:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R20/current/S/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R20/current/S/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "S";
        skos:definition        "Float is known to be drifting at a shallower depth than originally programmed"@en;
        skos:notation          "SDN:R20::S";
        skos:note              "accepted"@en;
        skos:prefLabel         "Drifting at shallower depth than programmed"@en .

<http://vocab.nerc.ac.uk/collection/R20/current/N/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R20::N";
        dc:date                "2021-02-08 16:22:18.0";
        dc:identifier          "SDN:R20::N";
        pav:authoredOn         "2021-02-08 16:22:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R20/current/N/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R20/current/N/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "N";
        skos:definition        "No, the float did not touch the ground"@en;
        skos:notation          "SDN:R20::N";
        skos:note              "accepted"@en;
        skos:prefLabel         "Not grounded"@en .

<http://vocab.nerc.ac.uk/collection/R20/current/B/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R20::B";
        dc:date                "2021-02-08 16:18:37.0";
        dc:identifier          "SDN:R20::B";
        pav:authoredOn         "2021-02-08 16:18:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R20/current/B/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R20/current/B/2/> , <http://vocab.nerc.ac.uk/collection/R20/current/B/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "B";
        skos:definition        "Yes, the float touched the ground as determined by an external bathymetry database and the programmed free-drift period was affected. If it is uncertain what mission phase the grounding took place, use 'B'."@en;
        skos:notation          "SDN:R20::B";
        skos:note              "accepted"@en;
        skos:prefLabel         "Grounded (external bathymetry database check), and free-drift period affected"@en .

