        skos:altLabel          "Marine litter";
        skos:altLabel          "Déchets marins"@fr ;
        skos:definition        "Properties and quantities of marine litter do not cause harm to the coastal and marine environment"@en;
        skos:definition        "Les propriétés et quantités de déchets marins ne causent pas de dommages à l'environnement côtier et marin."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C10_1/> , <http://vocab.nerc.ac.uk/collection/C46/current/C10_2/>;
