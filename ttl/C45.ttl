        skos:altLabel          "Contaminants";
        skos:altLabel          "Contaminants"@fr ;
        skos:definition        "Concentrations of contaminants are at levels not giving rise to pollution effects"@en;
        skos:definition        "Les concentrations de contaminants sont à des niveaux ne donnant pas lieu à des effets de pollution."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C8_2/> , <http://vocab.nerc.ac.uk/collection/C46/current/C8_1/>;
