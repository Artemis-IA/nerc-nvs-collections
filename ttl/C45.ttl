        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Contaminants in seafood";
        skos:altLabel          "Contaminants dans les produits de la mer"@fr ;
        skos:definition        "Contaminants in fish and other seafood for human consumption do not exceed levels established by Community legislation or other relevant standards"@en;
        skos:definition        "Les contaminants dans les poissons et autres produits de la mer destinés à la consommation humaine ne dépassent pas les niveaux établis par la législation communautaire ou d'autres normes pertinentes."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C9_1/>;
        skos:notation          "SDN:C45::D9";
        skos:note              "accepted"@en;
        skos:prefLabel         "Contaminants in seafood do not exceed established levels"@en ;
        skos:prefLabel         "Les contaminants dans les produits de la mer ne dépassent pas les niveaux établis"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D6";
        dc:date                "2017-02-24 16:44:41.0";
        dc:identifier          "SDN:C45::D6";
        pav:authoredOn         "2017-02-24 16:44:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D6/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C45/current/D6/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Sea-floor integrity";
        skos:altLabel          "Intégrité des fonds marins"@fr ;
        skos:definition        "Sea-floor integrity is at a level that ensures that the structure and functions of the ecosystems are safeguarded and benthic ecosystems, in particular, are not adversely affected"@en;
        skos:definition        "L'intégrité des fonds marins est à un niveau qui assure que la structure et les fonctions des écosystèmes sont préservées et que les écosystèmes benthiques, en particulier, ne sont pas affectés défavorablement."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C6_1/> , <http://vocab.nerc.ac.uk/collection/C46/current/C6_2/>;
        skos:notation          "SDN:C45::D6";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sea-floor integrity supports ecosystem"@en ;
        skos:prefLabel         "L'intégrité des fonds marins soutient l'écosystème"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D10/>
        rdf:type               skos:Concept;
