<http://vocab.nerc.ac.uk/collection/C45/current/D5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D5";
        dc:date                "2017-02-24 16:44:25.0";
        dc:identifier          "SDN:C45::D5";
        pav:authoredOn         "2017-02-24 16:44:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D5/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C45/current/D5/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Eutrophication";
        skos:altLabel          "Eutrophisation"@fr ;
        skos:definition        "Human-induced eutrophication is minimised, especially adverse effects thereof, such as losses in biodiversity, ecosystem degradation, harmful algal blooms and oxygen deficiency in bottom water"@en;
        skos:definition        "L'eutrophisation d'origine humaine est minimisée, en particulier ses effets néfastes, tels que les pertes de biodiversité, la dégradation des écosystèmes, les efflorescences algales nuisibles et le déficit en oxygène de l'eau de fond."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C5_3/> , <http://vocab.nerc.ac.uk/collection/C46/current/C5_1/> , <http://vocab.nerc.ac.uk/collection/C46/current/C5_2/>;
        skos:notation          "SDN:C45::D5";
        skos:note              "accepted"@en;
        skos:prefLabel         "Eutrophication is minimised"@en ;
        skos:prefLabel         "L'eutrophisation est minimisée"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D1";
        dc:date                "2017-02-24 16:43:15.0";
        dc:identifier          "SDN:C45::D1";
        pav:authoredOn         "2017-02-24 16:43:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D1/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C45/current/D1/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Biodiversity";
        skos:altLabel          "Biodiversité"@fr ;
        skos:definition        "Biological diversity is maintained. The quality and occurrence of habitats and the distribution and abundance of species are in line with prevailing physiographic, geographic and climate conditions"@en;
        skos:definition        "La biodiversité est maintenue. La qualité et l'occurrence des habitats ainsi que la répartition et l'abondance des espèces sont conformes aux conditions physiographiques, géographiques et climatiques régnantes."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C1_6/> , <http://vocab.nerc.ac.uk/collection/C46/current/C1_2/> , <http://vocab.nerc.ac.uk/collection/C46/current/C1_5/> , <http://vocab.nerc.ac.uk/collection/C46/current/C1_4/> , <http://vocab.nerc.ac.uk/collection/C46/current/C1_7/> , <http://vocab.nerc.ac.uk/collection/C46/current/C1_3/> , <http://vocab.nerc.ac.uk/collection/C46/current/C1_1/>;
        skos:notation          "SDN:C45::D1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Biological diversity maintained"@en ;
        skos:prefLabel         "Biodiversité maintenue"@fr .

