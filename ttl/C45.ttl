        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Hydrographical conditions";
        skos:altLabel          "Conditions hydrographiques"@fr ;
        skos:definition        "Permanent alteration of hydrographical conditions does not adversely affect marine ecosystems"@en;
        skos:definition        "L'altération permanente des conditions hydrographiques n'affecte pas défavorablement les écosystèmes marins."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C7_1/> , <http://vocab.nerc.ac.uk/collection/C46/current/C7_2/>;
        skos:notation          "SDN:C45::D7";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hydrographical conditions are not altered"@en ;
        skos:prefLabel         "Les conditions hydrographiques ne sont pas altérées"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D3";
        dc:date                "2017-02-24 16:43:39.0";
        dc:identifier          "SDN:C45::D3";
        pav:authoredOn         "2017-02-24 16:43:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D3/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C45/current/D3/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Commercial fish and shellfish";
        skos:altLabel          "Poissons et crustacés commerciaux"@fr ;
        skos:definition        "Populations of all commercially exploited fish and shellfish are within safe biological limits, exhibiting a population age and size distribution that is indicative of a healthy stock"@en;
        skos:definition        "Les populations de tous les poissons et crustacés exploités commercialement sont dans les limites biologiques de sécurité, présentant une distribution des âges et des tailles de population indicative d'un stock sain."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C3_3/> , <http://vocab.nerc.ac.uk/collection/C46/current/C3_2/> , <http://vocab.nerc.ac.uk/collection/C46/current/C3_1/>;
        skos:notation          "SDN:C45::D3";
        skos:note              "accepted"@en;
        skos:prefLabel         "Commercial fish and shellfish populations are healthy"@en ;
        skos:prefLabel         "Les populations de poissons et crustacés commerciaux sont saines"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D4";
        dc:date                "2017-02-24 16:42:37.0";
        dc:identifier          "SDN:C45::D4";
        pav:authoredOn         "2017-02-24 16:42:37.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D4/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C45/current/D4/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Food webs";
        skos:altLabel          "Réseaux trophiques"@fr ;
        skos:definition        "All elements of the marine food webs, to the extent that they are known, occur at normal abundance and diversity and levels capable of ensuring the long-term abundance of the species and the retention of their full reproductive capacity"@en;
        skos:definition        "Tous les éléments des réseaux trophiques marins, dans la mesure où ils sont connus, se produisent à une abondance et une diversité normales et à des niveaux capables d'assurer l'abondance à long terme des espèces et le maintien de leur capacité de reproduction totale."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C4_3/> , <http://vocab.nerc.ac.uk/collection/C46/current/C4_2/> , <http://vocab.nerc.ac.uk/collection/C46/current/C4_1/>;
        skos:notation          "SDN:C45::D4";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marine food webs are at normal abundance and diversity"@en ;
        skos:prefLabel         "Les réseaux trophiques marins sont à une abondance et une diversité normales"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D9";
        dc:date                "2017-02-24 16:45:33.0";
        dc:identifier          "SDN:C45::D9";
        pav:authoredOn         "2017-02-24 16:45:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D9/2/>;
