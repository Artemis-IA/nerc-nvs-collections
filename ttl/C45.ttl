        dc:date                "2017-02-24 16:46:12.0";
        dc:identifier          "SDN:C45::D11";
        pav:authoredOn         "2017-02-24 16:46:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D11/3/>;
