        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Energy including underwater noise";
        skos:altLabel          "Énergie, y compris le bruit sous-marin"@fr ;
        skos:definition        "Introduction of energy, including underwater noise, is at levels that do not adversely affect the marine environment"@en;
        skos:definition        "L'introduction d'énergie, y compris le bruit sous-marin, est à des niveaux qui n'affectent pas défavorablement l'environnement marin."@fr ;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/C46/current/C11_1/> , <http://vocab.nerc.ac.uk/collection/C46/current/C11_2/>;
        skos:notation          "SDN:C45::D11";
        skos:note              "accepted"@en;
        skos:prefLabel         "Introduction of energy does not adversely affect the marine environment"@en ;
        skos:prefLabel         "L'introduction d'énergie n'affecte pas défavorablement l'environnement marin"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D7";
        dc:date                "2017-02-24 16:44:57.0";
        dc:identifier          "SDN:C45::D7";
        pav:authoredOn         "2017-02-24 16:44:57.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C45/current/D7/2/>;
