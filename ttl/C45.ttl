        skos:note              "accepted"@en;
        skos:prefLabel         "Properties and quantities of marine litter do not cause harm"@en ;
        skos:prefLabel         "Les propriétés et quantités de déchets marins ne causent pas de dommages"@fr .

<http://vocab.nerc.ac.uk/collection/C45/current/D8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C45::D8";
