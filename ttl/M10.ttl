        dc:creator              "MEDIN Standards Group";
        dc:date                 "2025-01-07 02:00:00.0";
        dc:description          "Terms used to describe techniques used to assess the socio-economic value of an ecosystem.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "MEDIN ecosystem valuation methods";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "MEDIN Standards Group";
