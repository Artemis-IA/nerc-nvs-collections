<http://vocab.nerc.ac.uk/collection/M10/current/14/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::14";
        dc:date                "2025-01-06 09:56:19.0";
        dc:identifier          "SDN:M10::14";
        pav:authoredOn         "2025-01-06 09:56:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/14/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/M10/current/14/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Uses observations on how much people spend to avoid adverse effects, including environmental effects to infer how much they value or are willing to pay for the improvements those expenditures yield. A revealed preference method."@en;
        skos:definition        "Utilise les observations sur ce que les gens dépensent pour éviter les effets indésirables, y compris les effets environnementaux, afin d'inférer combien ils valorisent ou sont prêts à payer pour les améliorations que ces dépenses apportent. Une méthode de préférence révélée."@fr ;
        skos:notation          "SDN:M10::14";
        skos:note              "accepted"@en;
        skos:prefLabel         "Averting-behaviour method"@en ;
        skos:prefLabel         "méthode du comportement d'évitement"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/24/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::24";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::24";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/24/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/5/>;
        skos:definition        "HEA seeks to determine the restoration projects that would provide ecosystem or other related services (including capital investments such as boat docks) sufficient to compensate for a loss from a natural-resource injury (e.g., a hazardous waste release or spill)."@en;
        skos:definition        "La HEA cherche à déterminer les projets de restauration qui fourniraient des services écosystémiques ou autres services associés (y compris les investissements en capital tels que les pontons) suffisants pour compenser une perte d'une lésion de ressource naturelle (par ex. un rejet ou un déversement de déchets dangereux)."@fr ;
        skos:notation          "SDN:M10::24";
        skos:note              "accepted"@en;
        skos:prefLabel         "Habitat equivalency analysis"@en ;
        skos:prefLabel         "analyse d'équivalence d'habitat"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/25/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::25";
        dc:date                "2025-01-06 09:56:19.0";
        dc:identifier          "SDN:M10::25";
        pav:authoredOn         "2025-01-06 09:56:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/25/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/M10/current/25/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/6/>;
        skos:definition        "Crosses ecosystem benefit indicators, economic methods (CORMAS software, http://cormas.cirad.fr/ComMod/) and decision science valuation methods. The companion modelling approach is a collective learning process that takes place in the interaction between the stakeholders and the models they build together. The implementation of such processes requires to take into account multiple skills and multiple point of view. modelling is used to clarify and formalise the values and to simulate the evolution of the ecosystem studied."@en;
        skos:definition        "Combine des indicateurs de bénéfices écosystémiques, des méthodes économiques (logiciel CORMAS, http://cormas.cirad.fr/ComMod/) et des méthodes d'évaluation en science de la décision. L'approche de modélisation companion est un processus d'apprentissage collectif qui a lieu dans l'interaction entre les parties prenantes et les modèles qu'ils construisent ensemble. La mise en œuvre de tels processus nécessite de prendre en compte de multiples compétences et points de vue. La modélisation est utilisée pour clarifier et formaliser les valeurs et simuler l'évolution de l'écosystème étudié."@fr ;
        skos:notation          "SDN:M10::25";
        skos:note              "accepted"@en;
        skos:prefLabel         "Companion modelling for common pool resources"@en ;
        skos:prefLabel         "modélisation companion pour les ressources communes"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/22/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::22";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::22";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/22/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/4/>;
        skos:definition        "Measures the total energy, direct and indirect, required to produce a good or service.  A measure to identify the resources or resource-equivalents needed to produce a product or service, using a systems or life-cycle ('cradle to grave') approach."@en;
        skos:definition        "Mesure l'énergie totale, directe et indirecte, requise pour produire un bien ou un service. Une mesure pour identifier les ressources ou les équivalents-ressources nécessaires pour produire un produit ou un service, utilisant une approche systémique ou de cycle de vie (« du berceau à la tombe »)."@fr ;
        skos:notation          "SDN:M10::22";
        skos:note              "accepted"@en;
        skos:prefLabel         "Embodied energy analysis"@en ;
        skos:prefLabel         "analyse d'énergie incorporée"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/21/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::21";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::21";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/21/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/4/>;
        skos:definition        "Develops a spatially-differentiated index of conservation value across a landscape based on an assessment of rarity, persistence, threat, and other landscape attributes, reflecting the contribution of these attributes to sustained ecosystem diversity and integrity. These values can be used to prioritize land for acquisition, conservation, or other purposes, given relevant biophysical goals."@en;
        skos:definition        "Développe un indice spatialement différencié de valeur de conservation à travers un paysage basé sur une évaluation de la rareté, de la persistance, de la menace et d'autres attributs du paysage, reflétant la contribution de ces attributs à la diversité et à l'intégrité soutenues de l'écosystème. Ces valeurs peuvent être utilisées pour prioriser les terres pour l'acquisition, la conservation ou d'autres buts, compte tenu des objectifs biophysiques pertinents."@fr ;
        skos:notation          "SDN:M10::21";
        skos:note              "accepted"@en;
        skos:prefLabel         "Conservation value method"@en ;
        skos:prefLabel         "méthode de valeur de conservation"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/23/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::23";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::23";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/23/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/4/>;
        skos:definition        "Measures the area of an ecosystem (e.g., the amount of land and/or water) required to support a certain level and type of consumption by an individual or population. A measure to identify the resources or resource-equivalents needed to produce a product or service, using a systems or life-cycle ('cradle to grave') approach."@en;
        skos:definition        "Mesure la superficie d'un écosystème (par ex. la quantité de terre et/ou d'eau) nécessaire pour soutenir un certain niveau et type de consommation par un individu ou une population. Une mesure pour identifier les ressources ou les équivalents-ressources nécessaires pour produire un produit ou un service, utilisant une approche systémique ou de cycle de vie (« du berceau à la tombe »)."@fr ;
        skos:notation          "SDN:M10::23";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ecological footprint analysis"@en ;
        skos:prefLabel         "analyse de l'empreinte écologique"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/10/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::10";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::10";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/10/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/1/>;
        skos:definition        "Used to elicit information about values and preferences from small groups of relevant members of the public engaging in group discussion led by a facilitator."@en;
        skos:definition        "Utilisé pour recueillir des informations sur les valeurs et les préférences de petits groupes de membres concernés du public engagés dans une discussion de groupe animée par un facilitateur."@fr ;
        skos:notation          "SDN:M10::10";
        skos:note              "accepted"@en;
        skos:prefLabel         "Focus groups"@en ;
        skos:prefLabel         "groupes de discussion"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::9";
        dc:date                "2025-01-06 09:56:19.0";
        dc:identifier          "SDN:M10::9";
        pav:authoredOn         "2025-01-06 09:56:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/9/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/M10/current/9/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/1/>;
        skos:definition        "Based on unstructured individual interviews with small samples of informants and responses are analysed qualitatively."@en;
        skos:definition        "Basé sur des entretiens individuels non structurés avec de petits échantillons d'informateurs et les réponses sont analysées qualitativement."@fr ;
        skos:notation          "SDN:M10::9";
        skos:note              "accepted"@en;
        skos:prefLabel         "Narrative methods"@en ;
        skos:prefLabel         "méthodes narratives"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::8";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::8";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/8/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/1/>;
        skos:definition        "Assessments can be conveyed in perceptual surveys or conjoint surveys (e.g., requiring choices among alternatives that combine multiple attributes). Results are based on quantitative analyses of responses from large representative samples."@en;
        skos:definition        "Les évaluations peuvent être transmises par des enquêtes perceptuelles ou des enquêtes conjointes (par ex. exigeant des choix entre des alternatives combinant plusieurs attributs). Les résultats sont basés sur des analyses quantitatives des réponses de grands échantillons représentatifs."@fr ;
        skos:notation          "SDN:M10::8";
        skos:note              "accepted"@en;
        skos:prefLabel         "Surveys of attitudes, preferences, and intentions"@en ;
        skos:prefLabel         "enquêtes sur les attitudes, préférences et intentions"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/16/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::16";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::16";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/16/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/2/>;
        skos:definition        "Directly elicits values through surveys by asking people about their hypothetical behaviour towards a given ecosystem service.  A stated preference method."@en;
        skos:definition        "Élicite directement les valeurs par des enquêtes en demandant aux gens leur comportement hypothétique envers un service écosystémique donné. Une méthode de préférence déclarée."@fr ;
        skos:notation          "SDN:M10::16";
        skos:note              "accepted"@en;
        skos:prefLabel         "Contingent behaviour"@en ;
        skos:prefLabel         "comportement contingent"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/12/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::12";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::12";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/12/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/2/>;
        skos:definition        "Use information about how much people implicitly or explicitly pay to visit locations with specific environmental attributes including specific levels of ecosystem services, to infer how much they value changes in those attributes. A revealed preference method."@en;
        skos:definition        "Utilise des informations sur ce que les gens paient implicitement ou explicitement pour visiter des lieux avec des attributs environnementaux spécifiques incluant des niveaux spécifiques de services écosystémiques, afin d'inférer combien ils valorisent les changements de ces attributs. Une méthode de préférence révélée."@fr ;
        skos:notation          "SDN:M10::12";
        skos:note              "accepted"@en;
        skos:prefLabel         "Travel cost method"@en ;
        skos:prefLabel         "méthode du coût de déplacement"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/18/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::18";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::18";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/18/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/2/>;
        skos:definition        "Estimates the economic values of ecosystem services using existing estimates from studies completed for another location or issue. The critical part of benefit transfer consists in adapting the value derived from existing studies to some other context."@en;
        skos:definition        "Estime les valeurs économiques des services écosystémiques en utilisant des estimations existantes d'études réalisées pour un autre lieu ou sujet. La partie critique du transfert de bénéfices consiste à adapter la valeur dérivée des études existantes à un autre contexte."@fr ;
        skos:notation          "SDN:M10::18";
        skos:note              "accepted"@en;
        skos:prefLabel         "Benefit transfer"@en ;
        skos:prefLabel         "transfert de bénéfices"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/15/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::15";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::15";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/15/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/2/>;
        skos:definition        "Directly elicits values through surveys by asking people about their willingness to pay for a given ecosystem service.  A stated preference method."@en;
        skos:definition        "Élicite directement les valeurs par des enquêtes en demandant aux gens leur disposition à payer pour un service écosystémique donné. Une méthode de préférence déclarée."@fr ;
        skos:notation          "SDN:M10::15";
        skos:note              "accepted"@en;
        skos:prefLabel         "Contingent valuation"@en ;
        skos:prefLabel         "évaluation contingente"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/11/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::11";
        dc:date                "2025-01-06 09:56:19.0";
        dc:identifier          "SDN:M10::11";
        pav:authoredOn         "2025-01-06 09:56:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/11/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/M10/current/11/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/2/>;
        skos:definition        "Elicit values information through observations of behavioural responses by individuals interacting with either actual or computer-simulated environments."@en;
        skos:definition        "Élicite des informations sur les valeurs par des observations de réponses comportementales d'individus interagissant avec des environnements réels ou simulés par ordinateur."@fr ;
        skos:notation          "SDN:M10::11";
        skos:note              "accepted"@en;
        skos:prefLabel         "Behavioral observation methods"@en ;
        skos:prefLabel         "méthodes d'observation comportementale"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/17/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::17";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::17";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/17/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/2/>;
        skos:definition        "Successively presents a number of choice sets to respondents and asks them to choose their preferred scenario. Each choice set consists of two or three scenarios related to the good under valuation. This good is defined by its key attributes (or characteristics) and the levels that these attributes take, where one attribute is price.  A stated preference method."@en;
        skos:definition        "Présente successivement un certain nombre de jeux de choix aux répondants et leur demande de choisir leur scénario préféré. Chaque jeu de choix consiste en deux ou trois scénarios liés au bien évalué. Ce bien est défini par ses attributs clés (ou caractéristiques) et les niveaux que prennent ces attributs, où un attribut est le prix. Une méthode de préférence déclarée."@fr ;
        skos:notation          "SDN:M10::17";
        skos:note              "accepted"@en;
        skos:prefLabel         "Choice experiment"@en ;
        skos:prefLabel         "expérience de choix"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/13/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::13";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::13";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/13/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/2/>;
        skos:definition        "Uses information about how much people pay for houses or other directly-purchased items with specific environmental attributes (e.g., visibility, proximity to amenities or disamenities) to infer how much they value changes in those attributes. A revealed preference method."@en;
        skos:definition        "Utilise des informations sur ce que les gens paient pour des maisons ou d'autres biens achetés directement avec des attributs environnementaux spécifiques (par ex. la vue, la proximité d'équipements ou de nuisances) afin d'inférer combien ils valorisent les changements de ces attributs. Une méthode de préférence révélée."@fr ;
        skos:notation          "SDN:M10::13";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hedonic pricing"@en ;
        skos:prefLabel         "prix hédoniques"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/20/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::20";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::20";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/20/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/3/>;
        skos:definition        "Citizen valuation juries are given extensive information and, after a lengthy discussion, are usually asked to agree on a common value or make a group decision. Citizen juries can develop a ranking of alternative options for achieving a given goal. Their estimates would reflect community-based values rather than economic values."@en;
        skos:definition        "Les jurys d'évaluation citoyenne reçoivent des informations étendues et, après une longue discussion, sont généralement invités à s'accorder sur une valeur commune ou à prendre une décision de groupe. Les jurys citoyens peuvent développer un classement d'options alternatives pour atteindre un objectif donné. Leurs estimations refléteraient des valeurs communautaires plutôt que des valeurs économiques."@fr ;
        skos:notation          "SDN:M10::20";
        skos:note              "accepted"@en;
        skos:prefLabel         "Citizen valuation juries"@en ;
        skos:prefLabel         "jurys d'évaluation citoyenne"@fr .

<http://vocab.nerc.ac.uk/collection/M10/current/19/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M10::19";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M10::19";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M10/current/19/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/M09/current/3/>;
        skos:definition        "Provide information about how members of the voting population value a particular governmental action involving the environment, given a particular means of financing the associated expenditure. Individuals may also consider what the community as a whole stands to gain or lose if the proposal is adopted."@en;
        skos:definition        "Fournissent des informations sur comment les membres de la population votante valorisent une action gouvernementale particulière impliquant l'environnement, compte tenu d'un moyen particulier de financer la dépense associée. Les individus peuvent aussi considérer ce que la communauté dans son ensemble a à gagner ou à perdre si la proposition est adoptée."@fr ;
        skos:notation          "SDN:M10::19";
        skos:note              "accepted"@en;
        skos:prefLabel         "Referenda or initiatives"@en ;
        skos:prefLabel         "référendums ou initiatives"@fr .

