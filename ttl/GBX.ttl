        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        \"''The data were supplied by the British Oceanographic Data Centre as part of the function of the National Tidal &  Sea Level  Facility, hosted  by  the Proudman Oceanographic Laboratory (now part of the National  Oceanography  Centre) and funded by the Department for Environment, Food & Rural Affairs and the Natural Environment Research Council''\",\n        \"The recipient shall\"\n    ],\n    \"ol\": {\"li\": [\n        \"Inform BODC of the outputs to which the data have contributed e.g. references to publications or reports.\",\n        \"Offer to BODC, if requested and without charge, a copy of any value added data set or product derived from the data.\",\n        \"Inform BODC of any inaccuracies or errors detected in the data.\"\n    ]}\n}}"@en;
        skos:notation          "SDN:GBX::GN000105";
        skos:note              "accepted"@en;
        skos:prefLabel         "Product order form - NTSLF data attribution informnation"@en;
