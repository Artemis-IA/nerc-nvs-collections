<http://vocab.nerc.ac.uk/collection/GBX/current/HE000008/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::HE000008";
        dc:date                "2008-01-04 10:41:27.0";
        dc:identifier          "SDN:GBX::HE000008";
        pav:authoredOn         "2008-01-04 10:41:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/HE000008/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        \"Restrict your search to series with measurements made within a specified range of depths/heights.\",\n        \"First select your reference point, then enter a minimum and/or a maximum depth/height value. Real numbers within the allowed range are accepted. The minimum should be less than the maximum.\",\n        \"Not all series have a measurement depth/height value assigned. Should you wish to add series with measurement depth/height set absent to your selection then click the include unknown box.\",\n        {\n            \"strong\": \"update button\",\n            \"content\": [\n                \"Once you are happy with your selection use the\",\n                \"to submit your search criteria.\"\n            ]\n        },\n        \"The default will match any series irrespective of its instrument depth/height.\",\n        \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n    ],\n    \"ul\": {\"li\": [\n        \"If you insert a minimum and maximum value then all series containing measurements at depths/heights between your minimum and maximum values are returned.\",\n        \"If you insert a minimum value only then all series containing measurements at depths/heights equal to or more than your specified value are returned.\",\n        \"If you insert a maximum value only then all series containing measurements at depths/heights less than or equal to your specified value are returned.\"\n    ]}\n}}"@en;
        skos:notation          "SDN:GBX::HE000008";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - instrument depth"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

