<http://vocab.nerc.ac.uk/collection/GBX/current/ST000252/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::ST000252";
        dc:date                "2017-01-09 14:17:10.0";
        dc:identifier          "SDN:GBX::ST000252";
        pav:authoredOn         "2017-01-09 14:17:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/ST000252/5/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GBX/current/ST000252/3/> , <http://vocab.nerc.ac.uk/collection/GBX/current/ST000252/2/> , <http://vocab.nerc.ac.uk/collection/GBX/current/ST000252/4/> , <http://vocab.nerc.ac.uk/collection/GBX/current/ST000252/1/>;
        pav:version            "5";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "5";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        \"A comma-separated ASCII (CSV) and a Keyhole Markup Language (KML) file of your search results are available to download should you wish to retain a copy. Note: The KML file allows the display of your results in geospatial applications, such as Google Earth.\",\n        \"Please select series of interest and your data file format prior to submitting your request. To assist your decision, a brief summary of the available formats is provided below\",\n        {\n            \"a\": {\n                \"href\": \"/resources/delivery_formats/\",\n                \"content\": \"code and format definitions\"\n            },\n            \"strong\": \"Please note\",\n            \"content\": [\n                \"Detailed information about the formats is available via the\",\n                \"section of our web site.\",\n                \": if you follow this link your selected items in the results table will be lost.\"\n            ]\n        }\n    ],\n    \"ul\": {\"li\": [\n        \"ASCII - a BODC output format which contains several rows of metadata followed by the data cycles (data variables and their quality control flags) listed one per line.\",\n        \"QXF - the BODC subset of netCDF. QXF is 'a format for datacycles'. Consequently, it does not include the metadata. Each QXF file contains a header (a series of global attributes) and a series of QXF channels. These channels generally consist of a data variable plus quality control flag channel, although the flag channel will not be encountered in some circumstances.\"\n    ]},\n    \"h2\": [\n        \"Download metadata\",\n        \"Request data\"\n    ]\n}}"@en;
        skos:notation          "SDN:GBX::ST000252";
        skos:note              "accepted"@en;
        skos:prefLabel         "plain text - download csv file"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX1/> .

<http://vocab.nerc.ac.uk/collection/GBX/current/HE000006/>
