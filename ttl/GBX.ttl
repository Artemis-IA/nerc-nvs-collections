        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\"p\": [\n    \"This refers to the total number of layers within a simulation, for example the numberof depth levels. Restrict your search to simulations containing specific number oflayers. Click to select the number of layers. Use Control + click or Shift + clickas appropriate to select additional simulations with different numbers of layers. Youmay also use Control + click to deselect.\",\n    \"Once you have completed your selection use the Update button to submit your search criteria.\",\n    \"The default is to match any data irrespective of whether it is affiliated to simulations containing specific numbers of layers.\",\n    \"You may revisit this section and amend your criteria at any time.\"\n]}}"@en;
        skos:notation          "SDN:GBX::H5000006";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - Simulation layers tagged"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX5/> .

