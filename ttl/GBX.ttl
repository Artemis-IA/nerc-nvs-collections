<http://vocab.nerc.ac.uk/collection/GBX/current/HE000003/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::HE000003";
        dc:date                "2015-07-22 10:29:55.0";
        dc:identifier          "SDN:GBX::HE000003";
        pav:authoredOn         "2015-07-22 10:29:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/HE000003/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GBX/current/HE000003/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        \"Restrict your search to series collected in a specified range of water depth (the distance between sea surface and sea bed - not to be confused with the depth at which measurements were made). Enter a minimum and/or a maximum value. The minimum should be less than the maximum and only real numbers within the allowed range are accepted. Do not enter negative values.\",\n        {\n            \"strong\": \"include unknown\",\n            \"content\": [\n                \"Not all series have a water depth value assigned. Should you wish to add series with water depth set absent to your selection then click the\",\n                \"box.\"\n            ]\n        },\n        {\n            \"strong\": [\n                \"completed your selection\",\n                \"update button\"\n            ],\n            \"content\": [\n                \"Once you have\",\n                \"use the\",\n                \"to submit your search criteria.\"\n            ]\n        },\n        \"The default is to match any series irrespective of its water depth.\",\n        \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n    ],\n    \"ul\": {\"li\": [\n        \"If you insert a minimum and maximum value then all series with a water depth between your minimum and maximum values are returned.\",\n        \"If you insert a minimum value only then all series with a water depth equal to or more than your specified value are returned.\",\n        \"If you insert a maximum value only then all series with a water depth less than or equal to your specified value are returned.\"\n    ]}\n}}"@en;
        skos:notation          "SDN:GBX::HE000003";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - water depth"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

