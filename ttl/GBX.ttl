<http://vocab.nerc.ac.uk/collection/GBX/current/HE000007/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::HE000007";
        dc:date                "2008-01-03 15:01:41.0";
        dc:identifier          "SDN:GBX::HE000007";
        pav:authoredOn         "2008-01-03 15:01:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/HE000007/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\"p\": [\n    \"To select series which cover a time span greater than a specified duration, for example longer than one month or two years, please enter a number in the duration box and use the pull-down menu to select its units. Your entry must be less than the maximum duration.\",\n    {\n        \"strong\": \"include unknown\",\n        \"content\": [\n            \"Not all series have the duration value assigned. Should you wish to add series with duration unknown to your selection then click the\",\n            \"box.\"\n        ]\n    },\n    {\n        \"strong\": [\n            \"happy with your selection\",\n            \"update button\"\n        ],\n        \"content\": [\n            \"Once you are\",\n            \"use the\",\n            \"to submit your search criteria.\"\n        ]\n    },\n    \"The default will match any series irrespective of its duration.\",\n    \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n]}}"@en;
        skos:notation          "SDN:GBX::HE000007";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - duration"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

