<http://vocab.nerc.ac.uk/collection/GBX/current/HE000000/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::HE000000";
        dc:date                "2015-07-22 10:29:55.0";
        dc:identifier          "SDN:GBX::HE000000";
        pav:authoredOn         "2015-07-22 10:29:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/HE000000/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GBX/current/HE000000/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\"p\": [\n    \"Restrict your search to series containing particular types of parameter.\",\n    {\n        \"strong\": \"narrow button\",\n        \"content\": [\n            \"Click to select a single entry from a list.  Use Control+click or Shift+click to select additional entries as appropriate. You may also use Control+click to deselect.  Once you have chosen from a list press the appropriate\",\n            \". This will restrict the choices available in the other lists.\"\n        ]\n    },\n    {\n        \"strong\": \"include unknown\",\n        \"content\": [\n            \"Not all series have their parameters assigned. Should you wish to add series where the parameters are unknown to your selection then click the\",\n            \"box.\"\n        ]\n    },\n    {\n        \"strong\": [\n            \"completed your selection\",\n            \"update button\"\n        ],\n        \"content\": [\n            \"Once you have\",\n            \"use the\",\n            \"to submit your search criteria.\"\n        ]\n    },\n    \"The default is to match any series irrespective of its parameter discipline, category or group.\",\n    \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n]}}"@en;
        skos:notation          "SDN:GBX::HE000000";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - parameters"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

