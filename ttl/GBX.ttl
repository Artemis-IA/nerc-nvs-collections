        skos:definition        "{\"node\": {\"p\": [\n    \"The GEOTRACES Intermediate Data Product (IDP) has been developed for the community. To improve understanding and services we would like to keep track of who is using the product and for what purpose. Please specify\",\n    {\n        \"strong\": \"usage to which the data product will be put\",\n        \"ol\": {\"li\": [\n            \"Compare with my data\",\n            \"Create compilation with other data for the same element/isotope\",\n            \"Do cross correlations among differnet elements/isotopes\",\n            \"Modelling\",\n            \"Use of data for biological studies\",\n            \"Use of data for paleoproxy research\",\n            \"Other? Please specify\"\n        ]},\n        \"content\": [\n            \"the\",\n            \"by copying and pasting one or more of the following options in to the \\\"Reason\\\" box below.\"\n        ]\n    },\n    {\n        \"strong\": \"any source of funding\",\n        \"content\": \"that you may have for the intended research or usage of the data product in the \\\"Funding\\\" box below.\"\n    }\n]}}"@en;
