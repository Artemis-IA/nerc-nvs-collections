<http://vocab.nerc.ac.uk/collection/GBX/current/HE000001/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::HE000001";
        dc:date                "2015-07-22 10:29:55.0";
        dc:identifier          "SDN:GBX::HE000001";
        pav:authoredOn         "2015-07-22 10:29:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/HE000001/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GBX/current/HE000001/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\"p\": [\n    \"Use the interactive map to define your geographic area of interest. Alternatively, type the coordinates of the required area in the form below the map. The area displayed as yellow defines the geographic limits for your current criteria. Your selection must be within this area. Help information for the interactive map is provided via its toolbar.\",\n    {\n        \"strong\": [\n            \"happy with your selection\",\n            \"update button\"\n        ],\n        \"content\": [\n            \"Once you are\",\n            \"use the\",\n            \"to submit your search criteria.\"\n        ]\n    },\n    \"The default is to match any series irrespective of its geographic area.\",\n    \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n]}}"@en;
        skos:notation          "SDN:GBX::HE000001";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - geographic area"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

