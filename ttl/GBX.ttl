<http://vocab.nerc.ac.uk/collection/GBX/current/ST000341/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::ST000341";
        dc:date                "2009-10-06 16:27:52.0";
        dc:identifier          "SDN:GBX::ST000341";
        pav:authoredOn         "2009-10-06 16:27:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/ST000341/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        \"A comma-separated ASCII (CSV) and a Keyhole Markup Language (KML) file of your search results are available to download should you wish to retain a copy. Note: The KML file allows the display of your results in geospatial applications, such as Google Earth.\",\n        \"Please select series of interest and your data file format prior to adding data to the basket. To assist your decision, a brief summary of the available formats is provided below\",\n        {\n            \"a\": {\n                \"href\": \"/data/codes_and_formats/\",\n                \"content\": \"code and format definitions\"\n            },\n            \"strong\": \"Please note\",\n            \"content\": [\n                \"Detailed information about the formats is available via the\",\n                \"section of our web site.\",\n                \": if you follow this link your selected items in the results table will be lost.\"\n            ]\n        }\n    ],\n    \"ul\": {\"li\": [\n        \"ASCII - a BODC output format which contains several rows of metadata followed by the data cycles (data variables and their quality control flags) listed one per line.\",\n        \"QXF - the BODC subset of netCDF. QXF is 'a format for datacycles'. Consequently, it does not include the metadata. Each QXF file contains a header (a series of global attributes) and a series of QXF channels. These channels generally consist of a data variable plus quality control flag channel, although the flag channel will not be encountered in some circumstances.\",\n        \"ODV - the SeaDataNet Ocean Data View (ODV) data format - an ASCII format that follows that of a spreadsheet containing metadata, primary variable and data columns. ODV is a software package for the interactive exploration, analysis and visualisation of oceanographic and other geo-referenced profile or sequence data.\"\n    ]},\n    \"h2\": [\n        \"Download metadata\",\n        \"Add data to your basket\"\n    ]\n}}"@en;
        skos:notation          "SDN:GBX::ST000341";
        skos:note              "accepted"@en;
        skos:prefLabel         "view page metadata and data formats"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX1/> .

