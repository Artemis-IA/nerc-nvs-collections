<http://vocab.nerc.ac.uk/collection/GBX/current/HE000002/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::HE000002";
        dc:date                "2015-07-22 10:29:55.0";
        dc:identifier          "SDN:GBX::HE000002";
        pav:authoredOn         "2015-07-22 10:29:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/HE000002/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GBX/current/HE000002/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        \"Refine your search to select series deployed between specified dates.\",\n        \"Use the \\\"pull-down\\\" menus (yyyy mm dd) to select specific dates. Your selection must be within the allowed range.\",\n        \"If you are interested in a particular time of the year, you can use the recurring date option to locate deployments at that time in several years. To select all series which were deployed during the months of, for example, January and February in the years 2001 to 2006, enter the ranges required in the start and end date fields and check the recurring date box. This will only return series deployed during January or February in the year 2001, 2002 ....2006.\",\n        {\n            \"strong\": [\n                \"happy with your selection\",\n                \"update button\"\n            ],\n            \"content\": [\n                \"Once you are\",\n                \"use the\",\n                \"to submit your search criteria.\"\n            ]\n        },\n        \"The default will match any series irrespective of its start/end date.\",\n        \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n    ],\n    \"ul\": {\"li\": [\n        \"If you select a start date and an end date then all series deployed between your start and end dates are returned.\",\n        \"If you only select a start date then all series deployed after your start date are returned.\",\n        \"If you only select an end date then all series deployed before your end date are returned.\"\n    ]}\n}}"@en;
        skos:notation          "SDN:GBX::HE000002";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - deployment date"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

