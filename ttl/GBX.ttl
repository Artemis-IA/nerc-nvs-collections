        skos:definition        "{\"node\": {\"p\": [\n    \"Restrict your search to series for particular types of instrument.\",\n    \"Click to select a single entry from the list.  Use Control+click or Shift+click to select additional entries as appropriate. You may also use Control+click to deselect.\",\n    {\n        \"b\": \"completed your selection\",\n        \"strong\": \"update button\",\n        \"content\": [\n            \"Once you have\",\n            \"use the\",\n            \"to submit your search criteria.\"\n        ]\n    },\n    \"The default is to match any series irrespective of the instrument.\",\n    \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n]}}"@en;
        skos:notation          "SDN:GBX::HE000005";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - instrument help"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

