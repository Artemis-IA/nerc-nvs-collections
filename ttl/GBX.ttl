<http://vocab.nerc.ac.uk/collection/GBX/current/T4000001/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::T4000001";
        dc:date                "2010-03-23 14:50:17.0";
        dc:identifier          "SDN:GBX::T4000001";
        pav:authoredOn         "2010-03-23 14:50:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/T4000001/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        \"In most cases, data are available in three data file formats. To assist your decision, a brief summary of the available formats is provided below\",\n        \"Please select your preferred data file format from the available options below and use the 'Submit' button to proceed.\"\n    ],\n    \"ul\": {\"li\": [\n        \"ASCII - a BODC output format that contains several rows of metadata followed by the data cycles (data variables and their quality control flags) listed one per line.\",\n        \"ODV - the SeaDataNet Ocean Data View (ODV) data format - an ASCII format that follows that of a spreadsheet containing metadata, primary variable and data columns. ODV is a software package for the interactive exploration, analysis and visualisation of oceanographic and other geo-referenced profile or sequence data.\",\n        \"QXF - the BODC subset of netCDF. QXF is 'a format for datacycles'. Consequently, it does not include the metadata. Each QXF file contains a header (a series of global attributes) and a series of QXF channels. These channels generally consist of a data variable plus quality control flag channel, although the flag channel will not be encountered in some circumstances.\"\n    ]}\n}}"@en;
        skos:notation          "SDN:GBX::T4000001";
        skos:note              "accepted"@en;
        skos:prefLabel         "File format page - info text"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX4/> .

