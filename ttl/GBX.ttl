        skos:definition        "{\"node\": {\"p\": [\n    \"Restrict your search to series which were collected by particular countries and/or organisations.\",\n    {\n        \"strong\": \"narrow button\",\n        \"content\": [\n            \"Click to select a single entry from a list.  Use Control+click or Shift+click to select additional entries as appropriate. You may also use Control+click to deselect.  Once you have chosen from a list press the appropriate\",\n            \". This will restrict the choices available in the other list.\"\n        ]\n    },\n    {\n        \"strong\": [\n            \"completed your selection\",\n            \"update button\"\n        ],\n        \"content\": [\n            \"Once you have\",\n            \"use the\",\n            \"to submit to your search criteria.\"\n        ]\n    },\n    \"The default is to match any series irrespective of who has collected the data.\",\n    \"You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link.\"\n]}}"@en;
        skos:notation          "SDN:GBX::HE000004";
        skos:note              "accepted"@en;
        skos:prefLabel         "help text - originator help"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX2/> .

