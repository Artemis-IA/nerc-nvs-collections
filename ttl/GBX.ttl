<http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GBX::T5000001";
        dc:date                "2017-01-09 14:17:12.0";
        dc:identifier          "SDN:GBX::T5000001";
        pav:authoredOn         "2017-01-09 14:17:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/5/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/3/> , <http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/4/> , <http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/1/> , <http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/2/>;
        pav:version            "5";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "5";
        skos:altLabel          "";
        skos:definition        "{\"node\": {\n    \"p\": [\n        {\n            \"a\": {\n                \"href\": \"/resources/delivery_formats/cfnetcdf_format/\",\n                \"content\": \"CF compliant\"\n            },\n            \"content\": [\n                \"This index provides access to all numerical model datasets held by BODC. Model data originating from a variety of projects and organisations are stored in our systems and are available for online retrieval. All model data are stored as\",\n                \"netCDF format files.\"\n            ]\n        },\n        \"An interactive search function is provided below to enable you to interrogate BODC's numerical model data holdings before choosing which, if any, data to select for download. Once you have chosen your search criteria, click the Search button. The data files held by BODC that match the criteria will be displayed in a table.\",\n        {\n            \"img\": {\n                \"src\": \"/images/icons/plot.gif\",\n                \"alt\": \"View parameter\",\n                \"title\": \"View parameter\",\n                \"class\": \"icon\"\n            },\n            \"content\": [\n                \"The data within the selected files can be visualised before final selection. Click the visualisation icon\",\n                \"beside the parameter that you wish to view in the results table.\"\n            ]\n        },\n        \"A demonstration (with audio) of search and visualisation (best viewed with screen resolutions of 1024 x 768 or greater) is available for you to watch.\",\n        {\n            \"img\": {\n                \"src\": \"/images/icons/help_icon.gif\",\n                \"width\": 16,\n                \"alt\": \"Help\",\n                \"class\": \"helpImage\",\n                \"height\": 16\n            },\n            \"content\": [\n                \"A detailed explanation for each search category is also provided. This information may be viewed via the\",\n                \"button.\"\n            ]\n        }\n    ],\n    \"h1\": \"Numerical model data\",\n    \"h2\": \"Search categories\"\n}}"@en;
        skos:notation          "SDN:GBX::T5000001";
        skos:note              "accepted"@en;
        skos:prefLabel         "Index page - opening paragraphs - tagged"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/GXM/current/GBX5/> .

