        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "platykurtic";
        skos:definition        "Flat-peaked sediment grain-size distribution with a negative Folk and Ward or Krumbein sediment grain-size kurtosis coefficient"@en;
        skos:notation          "SDN:GS6::platykur";
        skos:note              "accepted"@en;
        skos:prefLabel         "platykurtic"@en .

