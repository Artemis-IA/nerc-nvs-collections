<http://vocab.nerc.ac.uk/collection/GS6/current/leptokur/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS6::leptokur";
        dc:date                "2010-10-14 10:12:15.0";
        dc:identifier          "SDN:GS6::leptokur";
        pav:authoredOn         "2010-10-14 10:12:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS6/current/leptokur/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "leptokurtic";
        skos:definition        "Sharp-peaked sediment grain-size distribution with a positive Folk and Ward or Krumbein sediment grain-size kurtosis coefficient"@en;
        skos:notation          "SDN:GS6::leptokur";
        skos:note              "accepted"@en;
        skos:prefLabel         "leptokurtic"@en .

<http://vocab.nerc.ac.uk/collection/GS6/current/mesokur/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS6::mesokur";
        dc:date                "2010-10-14 10:12:15.0";
        dc:identifier          "SDN:GS6::mesokur";
        pav:authoredOn         "2010-10-14 10:12:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS6/current/mesokur/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "mesokurtic";
        skos:definition        "Normal-peaked sediment grain-size distribution with a zero Folk and Ward or Krumbein sediment grain-size kurtosis coefficient"@en;
        skos:notation          "SDN:GS6::mesokur";
        skos:note              "accepted"@en;
        skos:prefLabel         "mesokurtic"@en .

<http://vocab.nerc.ac.uk/collection/GS6/current/platykur/>
        rdf:type               skos:Concept;
