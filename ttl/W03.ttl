        skos:narrower          <http://vocab.nerc.ac.uk/collection/W03/current/W030016/> , <http://vocab.nerc.ac.uk/collection/W03/current/W030017/> , <http://vocab.nerc.ac.uk/collection/W03/current/W030015/>;
        skos:notation          "SDN:W03::W030003";
        skos:note              "accepted"@en;
        skos:prefLabel         "Calibration"@en ;
        skos:prefLabel         "étalonnage"@fr .

