<http://vocab.nerc.ac.uk/collection/L05/current/CSEM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::CSEM";
        dc:date                "2016-03-10 06:45:48.0";
        dc:identifier          "SDN:L05::CSEM";
        pav:authoredOn         "2016-03-10 06:45:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/CSEM/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/CSEM/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "CSEM";
        skos:altLabel          "CSEM (électromagnétisme à source contrôlée)"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT05/>;
        skos:definition        "Systems that measure sub-surface resistivity structure through the measurement of the electromegnetic fields resulting from stimulation by a towed source.  Includes systems incorporating both transmitter and receiver and systems where the transmitter and receiver are separate."@en;
        skos:definition        "Systèmes qui mesurent la structure de résistivité du sous-sol par la mesure des champs électromagnétiques résultant de la stimulation par une source tractée. Comprend les systèmes intégrant émetteur et récepteur, ainsi que ceux où l'émetteur et le récepteur sont séparés."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
        skos:notation          "SDN:L05::CSEM";
        skos:note              "accepted"@en;
        skos:prefLabel         "controlled-source electromagnetic systems"@en ;
        skos:prefLabel         "systèmes électromagnétiques à source contrôlée"@fr .

