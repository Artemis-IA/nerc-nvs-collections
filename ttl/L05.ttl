<http://vocab.nerc.ac.uk/collection/L05/current/390/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::390";
        dc:date                "2018-10-24 09:48:30.0";
        dc:identifier          "SDN:L05::390";
        pav:authoredOn         "2018-10-24 09:48:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/390/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT04/> , <http://vocab.nerc.ac.uk/collection/L05/current/132/>;
        skos:definition        "Tethered probes that measure temperature in relation to depth using a temperature and pressure package that is lowered into the water and subsequently retrieved using a winch. The profile of temperature is recorded mechanically by etchings on a glass slide. Depth is calculated as a function of pressure."@en;
        skos:definition        "Sondes amarrées qui mesurent la température en fonction de la profondeur au moyen d'un ensemble température-pression descendu dans l'eau puis remonté par un treuil. Le profil de température est enregistré mécaniquement par gravure sur une lame de verre. La profondeur est calculée en fonction de la pression."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1287/>;
        skos:notation          "SDN:L05::390";
        skos:note              "accepted"@en;
        skos:prefLabel         "Mechanical bathythermographs"@en ;
        skos:prefLabel         "bathythermographes mécaniques"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/402/>
