        skos:definition        "{\"node\": {\n    \"mode\": \"hyperbolic or circular\",\n    \"notes\": \"Navigation and positioning system for the North Sea petroleum industry.\",\n    \"range\": \"400km hyperbolic; 75-100km circular\",\n    \"accuracy\": \"better than 2m below horizon (10m above horizon)\",\n    \"operational\": \"1980s to 1995\",\n    \"frequency\": \"420-450MHz\"\n}}"@en;
