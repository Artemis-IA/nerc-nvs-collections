<http://vocab.nerc.ac.uk/collection/L05/current/LAB01/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::LAB01";
        dc:date                "2008-01-10 16:10:12.0";
        dc:identifier          "SDN:L05::LAB01";
        pav:authoredOn         "2008-01-10 16:10:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/LAB01/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
