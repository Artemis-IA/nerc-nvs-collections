        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/LAB38/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/LAB38/1/>;
        pav:version            "2";
