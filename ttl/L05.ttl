        skos:definition        "Numerical models the make predictions in the hydrosphere assuming that it is a closed system that doesn't interact with the atmosphere."@en;
        skos:definition        "Modèles numériques qui effectuent des prévisions dans l'hydrosphère en la supposant être un système fermé qui n'interagit pas avec l'atmosphère."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
