        skos:definition        "{\"node\": {\n    \"mode\": \"hyperbolic\",\n    \"notes\": \"Global navigation based on transmitters in several European countries, Japan, Canada (until 2002-10) and USA (until 2010-02-08).\",\n    \"range\": \"950kmto 1700km (day): 650km to 1250km (day)\",\n    \"operational\": \"1947 to 2010. Maintained as GPS backup in the EU.\",\n    \"frequency\": \"70-130kHz\"\n}}"@en;
