        skos:prefLabel         "Ocean models"@en ;
        skos:prefLabel         "modèles océaniques"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/392/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::392";
        dc:date                "2020-04-07 10:14:48.0";
        dc:identifier          "SDN:L05::392";
        pav:authoredOn         "2020-04-07 10:14:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/392/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "substrates";
        skos:altLabel          "substrats"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT01/>;
        skos:definition        "Natural or artificial materials deployed in a marine or artificial environment for a given period to act as standardised, passive settlement sampling devices (e.g. settlement plates). They are used to determine the extent of colonisation and/or the diversity of settled organisms."@en;
        skos:definition        "Matériaux naturels ou artificiels déployés dans un environnement marin ou artificiel pendant une durée donnée pour servir de dispositifs d'échantillonnage passif et normalisé du recrutement (par ex. plaques de recrutement). Ils servent à déterminer l'étendue de la colonisation et/ou la diversité des organismes fixés."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1413/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2256/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1414/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1415/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1417/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1416/>;
        skos:notation          "SDN:L05::392";
        skos:note              "accepted"@en;
        skos:prefLabel         "colonisation substrata"@en ;
        skos:prefLabel         "substrats de colonisation"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/396/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::396";
        dc:date                "2023-02-07 08:13:36.0";
        dc:identifier          "SDN:L05::396";
        pav:authoredOn         "2023-02-07 08:13:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/396/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT07/>;
        skos:definition        "Marine seismic sources that send sound pulses into the sub-sea floor sediments. The sound pulses bounce off the sea floor and subsequent buried sediment layers according to differences in their acoustic impedance (hardness) and in turn, their density. Parametric sub-bottom profilers are non-linear systems that transmit two different higher frequencies that interact during sound propagation to generate a resultant lower operating frequency with narrow bandwidth. They typically operate at frequencies greater than 2 kHz and penerate to several hundreds of metres."@en;
        skos:definition        "Sources sismiques marines qui envoient des impulsions sonores dans les sédiments du fond marin. Les impulsions sonores se réfléchissent sur le fond marin et les couches de sédiments enfouis sous-jacents selon les différences de leur impédance acoustique (dureté) et donc de leur densité. Les profileurs paramétriques de sous-fond sont des systèmes non linéaires qui émettent deux fréquences élevées différentes qui interagissent pendant la propagation du son pour générer une fréquence de fonctionnement résultante plus basse à bande passante étroite. Ils fonctionnent typiquement à des fréquences supérieures à 2 kHz et pénètrent sur plusieurs centaines de mètres."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1480/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0859/>;
        skos:notation          "SDN:L05::396";
        skos:note              "accepted"@en;
        skos:prefLabel         "parametric sub-bottom profilers"@en ;
        skos:prefLabel         "profileurs paramétriques de sous-fond"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/SBAG/>
