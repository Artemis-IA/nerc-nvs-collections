<http://vocab.nerc.ac.uk/collection/L05/current/LAB47/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::LAB47";
        dc:date                "2022-04-27 16:58:27.0";
        dc:identifier          "SDN:L05::LAB47";
        pav:authoredOn         "2022-04-27 16:58:27.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/LAB47/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/LAB47/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "TIMS";
        skos:altLabel          "TIMS (spectrométrie de masse à ionisation thermique)"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT03/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/>;
        skos:definition        "Instruments that measure isotopic ratios using thermal ionisation. Purified samples are heated to cause ionisation of atoms. Subsequently, ions are focused into a beam by an electromagnet and then separated into individual beams based on their mass/charge ratio."@en;
        skos:definition        "Instruments qui mesurent les rapports isotopiques par ionisation thermique. Les échantillons purifiés sont chauffés pour provoquer l'ionisation des atomes. Les ions sont ensuite focalisés en un faisceau par un électroaimant puis séparés en faisceaux individuels en fonction de leur rapport masse/charge."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0975/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2160/>;
        skos:notation          "SDN:L05::LAB47";
        skos:note              "accepted"@en;
        skos:prefLabel         "thermal ionisation mass spectrometers"@en ;
        skos:prefLabel         "spectromètres de masse à ionisation thermique"@fr .

