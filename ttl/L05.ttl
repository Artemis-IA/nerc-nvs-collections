        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/400/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT04/> , <http://vocab.nerc.ac.uk/collection/L05/current/156/>;
        skos:definition        "A type of active sonar system that uses sound waves to determine a target's angular position while providing accurate target-strength (TS) estimates related to size and orientation of objects (targets) within the water column or along the seafloor. It uses a transducer that is physically divided into several (typically four) elements or quadrants."@en;
        skos:definition        "Type de système sonar actif qui utilise des ondes sonores pour déterminer la position angulaire d'une cible tout en fournissant des estimations précises de la force de cible (TS) liées à la taille et à l'orientation des objets (cibles) dans la colonne d'eau ou le long du fond marin. Il utilise un transducteur physiquement divisé en plusieurs éléments (typiquement quatre) ou quadrants."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0198/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2038/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2019/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1445/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2036/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2346/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1202/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1442/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2037/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1205/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2035/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0689/>;
        skos:notation          "SDN:L05::400";
        skos:note              "accepted"@en;
        skos:prefLabel         "split-beam echosounder"@en ;
        skos:prefLabel         "échosondeurs à faisceaux scindés"@fr .

