        skos:prefLabel         "fluoromètres de paillasse"@fr ;
        skos:related           <http://vocab.nerc.ac.uk/collection/P25/current/CHLA/> , <http://vocab.nerc.ac.uk/collection/P25/current/PHAEO/> .

