        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT06/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/>;
        skos:definition        "{\"node\": {\n    \"notes\": \"Real Time Kinematic (RTK) satellite navigation technique based on the use of carrier phase measurements of the GPS signals where a single reference station or a network of reference stations provides the real-time corrections.\",\n    \"accuracy\": \"Horizontal Accuracy: Fixed RTK mode: 1-5cm, Float RTK mode: 20cm-1m. Vertical accuracy : twice the horizontal accuracy\",\n    \"operating\": \"Since the mid-1990s\"\n}}"@en;
        skos:definition        "{\"node\": {\n    \"notes\": \"Technique de navigation satellitaire cinématique temps réel (RTK) basée sur l'utilisation des mesures de phase de la porteuse des signaux GPS, où une station de référence unique ou un réseau de stations de référence fournit les corrections en temps réel.\",\n    \"accuracy\": \"Précision horizontale : mode RTK fixe : 1-5 cm, mode RTK flottant : 20 cm-1 m. Précision verticale : deux fois la précision horizontale\",\n    \"operating\": \"Depuis le milieu des années 1990\"\n}}"@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1848/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1524/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0482/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1228/> , <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1615/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0880/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1227/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1822/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1280/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1521/>;
        skos:notation          "SDN:L05::POS25";
        skos:note              "accepted"@en;
