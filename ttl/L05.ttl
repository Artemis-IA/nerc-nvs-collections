        skos:definition        "{\"node\": {\n    \"mode\": \"hyperbolique\",\n    \"notes\": \"Groupes d'émetteurs, chacun avec un maître et trois esclaves\",\n    \"range\": \"450km (jour) à 750km (nuit)\",\n    \"accuracy\": \"50m (jour) à 200m (nuit) dans de bonnes conditions, jusqu'à 2km près de la limite de portée\",\n    \"operating\": \"Seconde Guerre mondiale à 2001-03 (2000-03-31 au Royaume-Uni)\",\n    \"frequency\": \"70 et 130 kHz\"\n}}"@fr ;
