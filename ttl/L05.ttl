<http://vocab.nerc.ac.uk/collection/L05/current/400/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::400";
        dc:date                "2025-12-17 15:23:36.0";
        dc:identifier          "SDN:L05::400";
