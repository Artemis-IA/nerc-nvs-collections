<http://vocab.nerc.ac.uk/collection/L05/current/LAB45/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::LAB45";
        dc:date                "2022-04-27 16:58:27.0";
        dc:identifier          "SDN:L05::LAB45";
