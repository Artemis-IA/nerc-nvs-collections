<http://vocab.nerc.ac.uk/collection/L05/current/WDRG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::WDRG";
        dc:date                "2017-09-06 11:48:32.0";
        dc:identifier          "SDN:L05::WDRG";
        pav:authoredOn         "2017-09-06 11:48:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/WDRG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT04/>;
        skos:definition        "Wires, usually several thousand feet in length, maintained horizontally at any desired depth by means of attached weights, buoyed at intervals, towed by a power boat at each end, and used to locate submerged obstructions projecting above the depth at which it is set."@en;
        skos:definition        "Câbles, généralement longs de plusieurs milliers de pieds, maintenus horizontalement à la profondeur souhaitée au moyen de poids fixés, munis de bouées à intervalles réguliers, tractés par un bateau à moteur à chaque extrémité, et utilisés pour localiser les obstacles submergés affleurant au-dessus de la profondeur à laquelle ils sont tendus."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:notation          "SDN:L05::WDRG";
        skos:note              "accepted"@en;
        skos:prefLabel         "Wire drags"@en ;
        skos:prefLabel         "dragues à câbles"@fr .

