<http://vocab.nerc.ac.uk/collection/L05/current/GIAG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::GIAG";
        dc:date                "2010-10-18 13:23:56.0";
        dc:identifier          "SDN:L05::GIAG";
        pav:authoredOn         "2010-10-18 13:23:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/GIAG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT07/> , <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/>;
        skos:definition        "A marine seismic source where a pair of conventional airguns (one, the generator, fires in the conventional manner; the second, known as the injector) fires some milliseconds later to prevent bubble from collapsing. Could be used in true GI mode (volume of injector twice of volume of generator), harmonic mode (same volume of generator and injector) or true airgun (no delay between generator and injector)."@en;
        skos:definition        "Source sismique marine où une paire de canons à air conventionnels (l'un, le générateur, tire de manière conventionnelle ; le second, appelé injecteur, tire quelques millisecondes plus tard pour empêcher l'effondrement de la bulle). Peut être utilisé en mode GI réel (volume de l'injecteur deux fois supérieur au volume du générateur), en mode harmonique (même volume pour le générateur et l'injecteur) ou en mode canon à air réel (aucun délai entre le générateur et l'injecteur)."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
        skos:notation          "SDN:L05::GIAG";
        skos:note              "accepted"@en;
        skos:prefLabel         "GI-gun"@en ;
        skos:prefLabel         "canon à air GI"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/BOMR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::BOMR";
        dc:date                "2024-11-27 13:31:48.0";
        dc:identifier          "SDN:L05::BOMR";
        pav:authoredOn         "2024-11-27 13:31:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/BOMR/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/BOMR/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT07/> , <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/>;
        skos:definition        "A marine seismic energy source in which capacitors are charged to high voltage and then discharged through a transducer in the water. The transducer consists of a flat coil with a spring-loaded aluminium plate. Eddy currents force the plates to separate sharply, producing a low pressure region between the plates into which the water rushes generating a pressure wave by implosion."@en;
        skos:definition        "Source d'énergie sismique marine dans laquelle des condensateurs sont chargés à haute tension puis déchargés à travers un transducteur dans l'eau. Le transducteur se compose d'une bobine plate avec une plaque d'aluminium chargée par ressort. Les courants de Foucault forcent les plaques à se séparer brusquement, produisant une zone de basse pression entre les plaques dans laquelle l'eau afflue, générant une onde de pression par implosion."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0831/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1262/>;
        skos:notation          "SDN:L05::BOMR";
        skos:note              "accepted"@en;
        skos:prefLabel         "boomers"@en ;
        skos:prefLabel         "boomers"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/ARAG/>
