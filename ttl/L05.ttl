<http://vocab.nerc.ac.uk/collection/L05/current/389/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::389";
        dc:date                "2018-10-24 08:19:59.0";
        dc:identifier          "SDN:L05::389";
        pav:authoredOn         "2018-10-24 08:19:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/389/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/132/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT04/>;
        skos:definition        "Disposable, free-falling probes that measure temperature in relation to depth using a thermistor and electronic data acquisition system. Probes are dropped into the water and a temperature signal is transferred to the platform by a wire that breaks when the wire is out. Depth is calculated as a function of time to descend and a known constant rate of descent."@en;
        skos:definition        "Sondes jetables à chute libre qui mesurent la température en fonction de la profondeur au moyen d'une thermistance et d'un système électronique d'acquisition de données. Les sondes sont larguées dans l'eau et un signal de température est transmis à la plateforme par un fil qui se rompt une fois entièrement déroulé. La profondeur est calculée en fonction du temps de descente et d'une vitesse de descente constante connue."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1386/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1388/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0717/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0262/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0718/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1383/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0715/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0435/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1290/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1384/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1389/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1387/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0713/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1385/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0263/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1382/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1291/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0716/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1381/>;
        skos:notation          "SDN:L05::389";
        skos:note              "accepted"@en;
        skos:prefLabel         "Expendable bathythermographs"@en ;
        skos:prefLabel         "bathythermographes jetables"@fr .

