<http://vocab.nerc.ac.uk/collection/L05/current/FLXS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::FLXS";
        dc:date                "2010-10-18 13:23:56.0";
        dc:identifier          "SDN:L05::FLXS";
        pav:authoredOn         "2010-10-18 13:23:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/FLXS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT07/>;
        skos:definition        "An implosive energy source for marine shooting. Two plates are separated by compressed air until they lock into position. The air between them is then pumped out creating a vacuum. On the signal the plates are unlocked and the water pressure forces them together creating a shock wave in the water."@en;
        skos:definition        "Source d'énergie implosive pour les campagnes sismiques marines. Deux plaques sont séparées par de l'air comprimé jusqu'à ce qu'elles se verrouillent en position. L'air entre elles est ensuite pompé, créant un vide. Sur le signal, les plaques sont déverrouillées et la pression de l'eau les force à se rapprocher, créant une onde de choc dans l'eau."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
        skos:notation          "SDN:L05::FLXS";
        skos:note              "accepted"@en;
        skos:prefLabel         "Flexichoc"@en ;
        skos:prefLabel         "Flexichoc"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/MVBR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::MVBR";
