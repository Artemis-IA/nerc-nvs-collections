<http://vocab.nerc.ac.uk/collection/L05/current/POS26/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::POS26";
        dc:date                "2012-11-13 13:38:20.0";
        dc:identifier          "SDN:L05::POS26";
        pav:authoredOn         "2012-11-13 13:38:20.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/POS26/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "USBL";
        skos:altLabel          "USBL (positionnement à ultra-courte base)"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT06/> , <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/>;
        skos:definition        "Systems dedicated to the positioning of subsea vehicles such as ROV and AUV. They are based on acoustic transmitted signals between one or several transponders and one acoustic antenna installed on a surface vessel. The transponders are mounted on the underwater vehicle or are fixed on the seafloor. These underwater acoustic positioning systems are coupled with inertial navigation systems."@en;
        skos:definition        "Systèmes dédiés au positionnement de véhicules sous-marins tels que les ROV et les AUV. Ils sont basés sur des signaux acoustiques émis entre un ou plusieurs transpondeurs et une antenne acoustique installée sur un navire de surface. Les transpondeurs sont montés sur le véhicule sous-marin ou fixés sur le fond marin. Ces systèmes de positionnement acoustique sous-marins sont couplés à des systèmes de navigation inertielle."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/> , <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2091/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2092/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1111/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1790/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1684/>;
        skos:notation          "SDN:L05::POS26";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ultra Short Baseline Positioning Systems"@en ;
        skos:prefLabel         "systèmes de positionnement à ultra-courte base (USBL)"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/POS21/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::POS21";
        dc:date                "2015-12-09 11:25:50.0";
        dc:identifier          "SDN:L05::POS21";
        pav:authoredOn         "2015-12-09 11:25:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/POS21/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/POS21/2/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS21/3/> , <http://vocab.nerc.ac.uk/collection/L05/current/POS21/1/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "Hyperfix";
        skos:altLabel          "Hyperfix"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT06/>;
        skos:definition        "{\"node\": {\n    \"mode\": \"hyperbolic (usual), circular or combined\",\n    \"notes\": \"Racal positioning system similar to Decca HiFix based on temporary or permanent transmitter chains comprising a master plus at least two slaves.\",\n    \"range\": \"250km (night) to 700km (day)\",\n    \"accuracy\": \"up to 0.5-1m\",\n    \"operating\": \"until 2000\",\n    \"frequency\": \"1.6-3.4MHz\"\n}}"@en;
        skos:definition        "{\"node\": {\n    \"mode\": \"hyperbolique (usuel), circulaire ou combiné\",\n    \"notes\": \"Système de positionnement Racal similaire à Decca HiFix, basé sur des chaînes d'émetteurs temporaires ou permanentes composées d'un maître et d'au moins deux esclaves.\",\n    \"range\": \"250km (nuit) à 700km (jour)\",\n    \"accuracy\": \"jusqu'à 0.5-1m\",\n    \"operating\": \"jusqu'en 2000\",\n    \"frequency\": \"1.6-3.4MHz\"\n}}"@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
        skos:notation          "SDN:L05::POS21";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hyperfix receivers"@en ;
        skos:prefLabel         "récepteurs Hyperfix"@fr .

