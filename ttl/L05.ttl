<http://vocab.nerc.ac.uk/collection/L05/current/EMSR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::EMSR";
        dc:date                "2019-12-11 18:23:45.0";
        dc:identifier          "SDN:L05::EMSR";
        pav:authoredOn         "2019-12-11 18:23:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/EMSR/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/EMSR/1/>;
