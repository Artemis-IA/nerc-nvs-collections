        skos:definition        "A marine seismic source generating sweeps of controlled varying frequency (from a few Hz to hundreds of Hz) and duration."@en;
        skos:definition        "Source sismique marine générant des balayages de fréquence et de durée contrôlées et variables (de quelques hertz à des centaines de hertz)."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
