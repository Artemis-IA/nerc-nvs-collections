<http://vocab.nerc.ac.uk/collection/L05/current/394/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::394";
        dc:date                "2023-02-07 08:04:18.0";
        dc:identifier          "SDN:L05::394";
        pav:authoredOn         "2023-02-07 08:04:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/394/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/394/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT07/>;
        skos:definition        "Marine seismic sources that send sound pulses into the sub-sea floor sediments. The sound pulses bounce off the sea floor and subsequent buried sediment layers according to differences in their acoustic impedance (hardness) and in turn, their density. Pingers are linear, single channel, high frequency systems that typically operate at frequencies greater than 2 kHz and penetrate to several tens of metres."@en;
        skos:definition        "Sources sismiques marines qui envoient des impulsions sonores dans les sédiments du fond marin. Les impulsions sonores se réfléchissent sur le fond marin et les couches de sédiments enfouis sous-jacents selon les différences de leur impédance acoustique (dureté) et donc de leur densité. Les pingers sont des systèmes linéaires, monocanal et haute fréquence qui fonctionnent typiquement à des fréquences supérieures à 2 kHz et pénètrent sur plusieurs dizaines de mètres."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1825/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1255/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1530/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1265/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2056/>;
        skos:notation          "SDN:L05::394";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pinger sub-bottom profilers"@en ;
        skos:prefLabel         "profileurs de sous-fond par pinger"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/367/>
