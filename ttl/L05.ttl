        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L05/current/63/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT01/> , <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/>;
        skos:definition        "Nets drifting in the sea or standing on the sea floor in which fish become entangled, usually through their gill covers."@en;
        skos:definition        "Filets dérivant en mer ou posés sur le fond marin dans lesquels les poissons s'engagent, généralement par leurs opercules."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1259/>;
        skos:notation          "SDN:L05::65";
        skos:note              "accepted"@en;
        skos:prefLabel         "gill nets"@en ;
        skos:prefLabel         "filets maillants"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/82/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::82";
        dc:date                "2008-01-10 15:47:47.0";
        dc:identifier          "SDN:L05::82";
        pav:authoredOn         "2008-01-10 15:47:47.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/82/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT02/> , <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/>;
        skos:definition        "A rig that allows water samples to be retained from where they were collected whilst physically separated from their surroundings.  Includes small-scale incubation rigs and mesocosms."@en;
        skos:definition        "Dispositif qui permet de conserver les échantillons d'eau là où ils ont été collectés tout en les séparant physiquement de leur environnement. Comprend les dispositifs d'incubation à petite échelle et les mésocosmes."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
        skos:notation          "SDN:L05::82";
        skos:note              "accepted"@en;
        skos:prefLabel         "in-situ incubators"@en ;
        skos:prefLabel         "incubateurs in situ"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/74/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::74";
        dc:date                "2024-02-01 09:51:33.0";
        dc:identifier          "SDN:L05::74";
        pav:authoredOn         "2024-02-01 09:51:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/74/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT01/> , <http://vocab.nerc.ac.uk/collection/L05/current/63/>;
        skos:definition        "Stationary nets (such as Fyke nets, Pound nets) that are used in shallow waters such as coastlines or estuaries. They are fixed to the bottom by anchors, ballast or stakes, and may be used individually or in groups. They often consist of a labyrinth-like chamber into which fish can easily enter, and from which they cannot easily escape. Target species include salmon, trout and eel."@en;
        skos:definition        "Filets fixes (tels que les nasses à labyrinthes, les nasses) utilisés dans les eaux peu profondes comme les côtes ou les estuaires. Ils sont fixés au fond par des ancres, du lest ou des pieux, et peuvent être utilisés seuls ou en groupes. Ils consistent souvent en une chambre en forme de labyrinthe dans laquelle les poissons peuvent facilement entrer et dont ils ne peuvent pas facilement s'échapper. Les espèces cibles comprennent le saumon, la truite et l'anguille."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/NETT0207/> , <http://vocab.nerc.ac.uk/collection/L22/current/NETT0208/>;
        skos:notation          "SDN:L05::74";
        skos:note              "accepted"@en;
        skos:prefLabel         "trap nets"@en ;
        skos:prefLabel         "nasses"@fr .

