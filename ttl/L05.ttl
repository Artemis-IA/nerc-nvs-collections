        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/LAB45/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/LAB45/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT03/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/>;
        skos:definition        "Instruments that use ion chromatography to separate ions and polar molecules based on their affinity to an ion exchanger resin. Sample solutions pass through a pressurized chromatographic column where ions are absorbed by the resin and subsequently eluted using an ion extraction liquid. The retention time of different species determines the ionic concentrations in the sample."@en;
        skos:definition        "Instruments qui utilisent la chromatographie ionique pour séparer les ions et les molécules polaires en fonction de leur affinité avec une résine échangeuse d'ions. Les solutions échantillons traversent une colonne chromatographique sous pression où les ions sont absorbés par la résine puis sont éluer ultérieurement au moyen d'un liquide d'extraction ionique. Le temps de rétention des différentes espèces détermine les concentrations ioniques dans l'échantillon."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2326/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0659/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2139/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2156/>;
        skos:notation          "SDN:L05::LAB45";
        skos:note              "accepted"@en;
        skos:prefLabel         "ion chromatography analysers"@en ;
        skos:prefLabel         "analyseurs de chromatographie ionique"@fr .

