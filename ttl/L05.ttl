        skos:definition        "Instruments that ionise trace gas molecules by proton transfer from protonated water, H3O. Ions of specific mass-to-charge ratios are then quantified in a quadrupole or time-of-flight mass spectrometer."@en;
        skos:definition        "Instruments qui ionisent les molécules de gaz traces par transfert de proton depuis l'eau protonée, H3O. Les ions de rapports masse/charge spécifiques sont ensuite quantifiés dans un spectromètre de masse quadripôle ou à temps de vol."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0968/>;
        skos:notation          "SDN:L05::LAB46";
        skos:note              "accepted"@en;
        skos:prefLabel         "proton transfer reaction mass spectrometers"@en ;
        skos:prefLabel         "spectromètres de masse par réaction de transfert de proton"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/LAB48/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::LAB48";
        dc:date                "2016-03-10 06:47:31.0";
        dc:identifier          "SDN:L05::LAB48";
        pav:authoredOn         "2016-03-10 06:47:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/LAB48/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "IRMS";
        skos:altLabel          "IRMS (spectromètre de masse de rapport isotopique)"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT03/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L05/current/LAB16/>;
        skos:definition        "Instruments that measure isotopic ratios using an electron ionisation source. Atoms in purified samples are ionised using a beam of electrons under vacuum. Subsequently, ions are focused into a beam by an electromagnet and then separated into individual beams based on their mass/charge ratio."@en;
        skos:definition        "Instruments qui mesurent les rapports isotopiques au moyen d'une source d'ionisation électronique. Les atomes des échantillons purifiés sont ionisés au moyen d'un faisceau d'électrons sous vide. Les ions sont ensuite focalisés en un faisceau par un électroaimant puis séparés en faisceaux individuels en fonction de leur rapport masse/charge."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2215/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1785/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1018/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1759/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2118/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2105/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1019/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2165/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2312/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1020/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1021/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1288/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2142/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1168/>;
        skos:notation          "SDN:L05::LAB48";
        skos:note              "accepted"@en;
        skos:prefLabel         "isotope ratio mass spectrometers"@en ;
        skos:prefLabel         "spectromètres de masse de rapport isotopique"@fr .

