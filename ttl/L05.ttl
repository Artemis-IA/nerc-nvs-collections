<http://vocab.nerc.ac.uk/collection/L05/current/SNWG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::SNWG";
        dc:date                "2010-10-18 13:23:56.0";
        dc:identifier          "SDN:L05::SNWG";
        pav:authoredOn         "2010-10-18 13:23:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/SNWG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT07/>;
        skos:definition        "A marine seismic energy source divided into two chambers, the firing chamber, which contains compressed air, and the other chamber, which is filled with water. When the gun is fired, the compressed air forces the shuttle downward and this expels the water from the lower chamber. The shot of water leaving the gun creates a void behind it and the collapse of water into this void creates an acoustic wave."@en;
        skos:definition        "Source d'énergie sismique marine divisée en deux chambres, la chambre de tir qui contient de l'air comprimé et l'autre chambre qui est remplie d'eau. Lorsque le canon est tiré, l'air comprimé force la navette vers le bas et cela expulse l'eau de la chambre inférieure. Le jet d'eau quittant le canon crée un vide derrière lui et l'effondrement de l'eau dans ce vide crée une onde acoustique."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/>;
        skos:notation          "SDN:L05::SNWG";
        skos:note              "accepted"@en;
        skos:prefLabel         "watergun"@en ;
        skos:prefLabel         "canon à eau"@fr .

