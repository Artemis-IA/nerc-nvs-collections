<http://vocab.nerc.ac.uk/collection/L05/current/LAB50/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::LAB50";
        dc:date                "2020-06-10 09:00:51.0";
        dc:identifier          "SDN:L05::LAB50";
        pav:authoredOn         "2020-06-10 09:00:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/LAB50/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT02/>;
        skos:definition        "Instruments that repeatedly heat and cool samples in a series of steps. They are typically used to amplify segments of DNA via the polymerase chain reaction (PCR). They can also be used to facilitate other temperature-sensitive reactions, including restriction enzyme digestion or rapid diagnostics."@en;
        skos:definition        "Instruments qui chauffent et refroidissent répétitivement des échantillons par paliers successifs. Ils sont typiquement utilisés pour amplifier des segments d'ADN par la réaction de polymérase en chaîne (PCR). Ils peuvent aussi être utilisés pour faciliter d'autres réactions sensibles à la température, notamment la digestion par enzymes de restriction ou le diagnostic rapide."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2178/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1411/>;
        skos:notation          "SDN:L05::LAB50";
        skos:note              "accepted"@en;
        skos:prefLabel         "thermal cyclers"@en ;
        skos:prefLabel         "thermocycleurs"@fr .

