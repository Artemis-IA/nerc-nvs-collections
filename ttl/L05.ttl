        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT03/> , <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/>;
        skos:definition        "Instruments that quantify carbon, nitrogen and sometimes other elements by combusting the sample at very high temperature and assaying the resulting gaseous oxides. Usually used for samples including organic material."@en;
        skos:definition        "Instruments qui quantifient le carbone, l'azote et parfois d'autres éléments en brûlant l'échantillon à très haute température et en dosant les oxydes gazeux résultants. Généralement utilisés pour des échantillons contenant de la matière organique."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/> , <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
