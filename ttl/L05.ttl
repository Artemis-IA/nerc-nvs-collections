        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "CEAS";
        skos:altLabel          "CEAS (spectrométrie d'absorption perfectionnée par cavité)"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT03/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/>;
        skos:definition        "Instruments that illuminate a sample inside an optical cavity, typically using laser light, and measure the concentration or amount of a species in gas phase by absorption spectroscopy. Techniques include cavity ring-down spectroscopy (CRDS) and integrated cavity output spectroscopy (ICOS)."@en;
        skos:definition        "Instruments qui illuminent un échantillon à l'intérieur d'une cavité optique, typiquement au moyen d'une lumière laser, et mesurent la concentration ou la quantité d'une espèce en phase gazeuse par spectroscopie d'absorption. Les techniques comprennent la spectroscopie par décroissance de l'anneau de cavité (CRDS) et la spectroscopie de sortie de cavité intégrée (ICOS)."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0816/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0525/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2348/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0517/>;
        skos:notation          "SDN:L05::LAB38";
        skos:note              "accepted"@en;
        skos:prefLabel         "cavity enhanced absorption spectrometers"@en ;
        skos:prefLabel         "spectromètres d'absorption perfectionnée par cavité"@fr .

