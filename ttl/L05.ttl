        skos:definition        "Devices that measure the water content and/or water potential of soil. Most commonly used for in situ measurements but can be used in the laboratory as well."@en;
        skos:definition        "Dispositifs qui mesurent la teneur en eau et/ou le potentiel hydrique du sol. Le plus souvent utilisés pour des mesures in situ, mais ils peuvent aussi être utilisés au laboratoire."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2341/>;
        skos:notation          "SDN:L05::402";
        skos:note              "accepted"@en;
        skos:prefLabel         "soil moisture sensors"@en ;
