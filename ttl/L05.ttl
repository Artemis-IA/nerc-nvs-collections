        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/C77/current/G24/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT04/>;
        skos:definition        "Instruments with directional acoustic transmitters and receivers fitted to an underwater platform that emit fan-shaped pulses down toward the seafloor across a wide angle perpendicular to the path of the platform through the water. Used for the classification of seafloor substrates and structures according to the intensity of signal return. Higher signal return intensities indicate harder substrates or structures, and vice versa."@en;
        skos:definition        "Instruments avec émetteurs et récepteurs acoustiques directionnels fixés à une plateforme sous-marine qui émettent des impulsions en éventail vers le fond marin sur un large angle perpendiculaire à la trajectoire de la plateforme dans l'eau. Utilisés pour la classification des substrats et structures du fond marin selon l'intensité du signal de retour. Des intensités de signal de retour plus élevées indiquent des substrats ou structures plus durs, et inversement."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/> , <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1423/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2057/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0853/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1264/> , <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0854/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1330/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1645/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0045/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0046/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1878/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2042/>;
        skos:notation          "SDN:L05::152";
        skos:note              "accepted"@en;
        skos:prefLabel         "sidescan sonars"@en ;
        skos:prefLabel         "sonars à balayage latéral"@fr .

