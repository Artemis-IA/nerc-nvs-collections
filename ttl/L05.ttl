        skos:definition        "Devices that provide information on unconsolidated sediment structure through transmission and reception of an energy source with a frequency corresponding to a sampling interval lower than 0.25 msec."@en;
        skos:definition        "Dispositifs qui fournissent des informations sur la structure des sédiments non consolidés par émission et réception d'une source d'énergie dont la fréquence correspond à un intervalle d'échantillonnage inférieur à 0,25 ms."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/> , <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1265/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1106/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1530/> , <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1645/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1825/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0859/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1255/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0831/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1479/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1105/>;
        skos:notation          "SDN:L05::367";
        skos:note              "accepted"@en;
