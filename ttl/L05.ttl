        owl:sameAs             <http://vocab.nerc.ac.uk/collection/C77/current/G26/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/D01/current/D0100002/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/L21/current/ICAT04/>;
        skos:definition        "A network of seismometers or geophones plus an energy source that determine geologic structure by detecting waves refracted by subsurface layers."@en;
        skos:definition        "Réseau de sismomètres ou de géophones associé à une source d'énergie, qui détermine la structure géologique en détectant les ondes réfractées par les couches du sous-sol."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/> , <http://vocab.nerc.ac.uk/scheme/EDMED_DCAT_THEMES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1257/>;
        skos:notation          "SDN:L05::155";
        skos:note              "accepted"@en;
        skos:prefLabel         "seismic refraction systems"@en ;
        skos:prefLabel         "systèmes de sismique-réfraction"@fr .

