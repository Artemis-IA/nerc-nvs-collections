        skos:prefLabel         "single-bubble airgun"@en ;
        skos:prefLabel         "canon à air à bulle unique"@fr .

<http://vocab.nerc.ac.uk/collection/L05/current/FLXT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L05::FLXT";
        dc:date                "2013-02-26 17:11:07.0";
        dc:identifier          "SDN:L05::FLXT";
        pav:authoredOn         "2013-02-26 17:11:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L05/current/FLXT/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L05/current/FLXT/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/L21/current/ICAT07/> , <http://vocab.nerc.ac.uk/collection/L19/current/SDNKG01/> , <http://vocab.nerc.ac.uk/collection/W06/current/CLSS0002/>;
        skos:definition        "A seismic method for marine shooting whereby small charges are propelled through a rubber hose by water under pressure into a steel cage where they are detonated. Holes in the cage allow the water repelled by the explosion to flow out and in thus dissipating some of the energy in the bubble effect."@en;
        skos:definition        "Méthode sismique marine par détonations au cours de laquelle de petites charges sont propulsées à travers un tuyau en caoutchouc par de l'eau sous pression dans une cage d'acier où elles sont détonées. Des trous dans la cage permettent à l'eau repoussée par l'explosion de s'écouler vers l'extérieur puis vers l'intérieur, dissipant ainsi une partie de l'énergie par l'effet de bulle."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/SDNDEV/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/W01/current/003/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0359/>;
        skos:notation          "SDN:L05::FLXT";
        skos:note              "accepted"@en;
        skos:prefLabel         "Flexotir"@en ;
        skos:prefLabel         "Flexotir"@fr .

