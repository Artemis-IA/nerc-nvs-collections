        dc:date                "2007-05-17 14:09:24.0";
        dc:identifier          "SDN:L14::CA";
        pav:authoredOn         "2007-05-17 14:09:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L14/current/CA/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "cancelled";
        skos:definition        "The activity was planned but never became operational."@en;
        skos:notation          "SDN:L14::CA";
        skos:note              "accepted"@en;
        skos:prefLabel         "cancelled"@en .

<http://vocab.nerc.ac.uk/collection/L14/current/ZZ/>
