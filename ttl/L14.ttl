<http://vocab.nerc.ac.uk/collection/L14/current/IR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L14::IR";
        dc:date                "2022-11-24 11:15:59.0";
        dc:identifier          "SDN:L14::IR";
        pav:authoredOn         "2022-11-24 11:15:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L14/current/IR/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/L14/current/IR/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "suspended";
        skos:definition        "The activity is non-operational. The intention is that operations will resume at some stage."@en;
        skos:notation          "SDN:L14::IR";
        skos:note              "accepted"@en;
        skos:prefLabel         "suspended"@en .

<http://vocab.nerc.ac.uk/collection/L14/current/ON/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L14::ON";
        dc:date                "2006-08-18 14:33:02.0";
        dc:identifier          "SDN:L14::ON";
        pav:authoredOn         "2006-08-18 14:33:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L14/current/ON/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "operational";
        skos:definition        "The activity is operational with no date specified for operations to cease."@en;
        skos:notation          "SDN:L14::ON";
        skos:note              "accepted"@en;
        skos:prefLabel         "operational"@en .

<http://vocab.nerc.ac.uk/collection/L14/current/CA/>
        rdf:type               skos:Concept;
