        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "unknown";
        skos:definition        "The status of the activity is not known and not computable by the sender of this data."@en;
        skos:notation          "SDN:L14::ZZ";
        skos:note              "accepted"@en;
        skos:prefLabel         "unknown"@en .

<http://vocab.nerc.ac.uk/collection/L14/current/OR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L14::OR";
        dc:date                "2006-08-18 14:33:02.0";
        dc:identifier          "SDN:L14::OR";
        pav:authoredOn         "2006-08-18 14:33:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L14/current/OR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "operational2suspended";
        skos:definition        "The activity is operational but a date is known when operations will cease.  The intention is that operations will resume after a period of inactivity."@en;
        skos:notation          "SDN:L14::OR";
        skos:note              "accepted"@en;
        skos:prefLabel         "operational becoming suspended"@en .

