<http://vocab.nerc.ac.uk/collection/R11/current/26/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R11::26";
        dc:date                "2024-09-11 11:40:41.0";
        dc:identifier          "SDN:R11::26";
        pav:authoredOn         "2024-09-11 11:40:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R11/current/26/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Test 26";
        skos:altLabel          "Test 26"@fr ;
        skos:definition        "TEMP_CNDC test applied to RBRargo3|2K, test added in July 2022. CTD data (< 2000 dbar) (TEMP_CNDC is used in the long timescale thermal inertia correction for RBR salinity data. This test aims to identify vertical profiles where TEMP_CNDC is of bad quality and thus unsuitable for use in the real-time adjustment of RBR salinity data.) Test 26 binary id = 67 108 864."@en;
        skos:definition        "Test TEMP_CNDC appliqué à RBRargo3|2K, test ajouté en juillet 2022. Données CTD (< 2000 dbar) (TEMP_CNDC est utilisé dans la correction d'inertie thermique à long terme pour les données de salinité RBR. Ce test vise à identifier les profils verticaux où TEMP_CNDC est de mauvaise qualité et donc inadapté à l'ajustement en temps réel des données de salinité RBR.) ID binaire du test 26 = 67 108 864."@fr ;
        skos:notation          "SDN:R11::26";
        skos:note              "accepted"@en;
        skos:prefLabel         "TEMP_CNDC test applied to RBRargo3 2K"@en ;
        skos:prefLabel         "test TEMP_CNDC appliqué à RBRargo3 2K"@fr .

