<http://vocab.nerc.ac.uk/collection/P26/current/407/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P26::407";
        dc:date                "2012-05-30 11:52:13.0";
        dc:identifier          "SDN:P26::407";
        pav:authoredOn         "2012-05-30 11:52:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P26/current/407/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "spatialSensorGeometryModelAdjustmentService";
        skos:altLabel          "spatialSensorGeometryModelAdjustmentService"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/P26/current/400/>;
        skos:definition        "Service that adjusts sensor geometry models to improve the match of the image with other images and/or known ground positions."@en;
        skos:definition        "Service qui ajuste les modèles de géométrie des capteurs pour améliorer la correspondance de l'image avec d'autres images et/ou des positions au sol connues."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ISO_GST/current/>;
        skos:notation          "SDN:P26::407";
        skos:note              "accepted"@en;
        skos:prefLabel         "Sensor geometry model adjustment service (spatialSensorGeometryModelAdjustmentService)"@en ;
        skos:prefLabel         "Sensor geometry model adjustment service (spatialSensorGeometryModelAdjustmentService)"@fr .

<http://vocab.nerc.ac.uk/collection/P26/current/413/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P26::413";
        dc:date                "2012-05-30 11:52:13.0";
        dc:identifier          "SDN:P26::413";
        pav:authoredOn         "2012-05-30 11:52:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P26/current/413/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "spatialFeatureManipulationService";
        skos:altLabel          "spatialFeatureManipulationService"@fr ;
        skos:broader           <http://vocab.nerc.ac.uk/collection/P26/current/400/>;
        skos:definition        "Register one feature to another, an image, or another data set or coordinate set; correcting for relative translation shifts, rotational differences, scale differences, and perspective differences. Verify that all features in the Feature Collection are topologically consistent according to the topology rules of the Feature Collection, and identifies and/or corrects any inconsistencies that are discovered."@en;
        skos:definition        "Enregistrer une entité sur une autre, une image, ou un autre jeu de données ou ensemble de coordonnées ; corriger les décalages de translation relatifs, les différences de rotation, d'échelle et de perspective. Vérifier que toutes les entités de la collection d'entités sont topologiquement cohérentes selon les règles de topologie de la collection d'entités, et identifier et/ou corriger les incohérences découvertes."@fr ;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ISO_GST/current/>;
        skos:notation          "SDN:P26::413";
        skos:note              "accepted"@en;
        skos:prefLabel         "Feature manipulation services (spatialFeatureManipulationService)"@en ;
        skos:prefLabel         "Services de manipulation d'entités (spatialFeatureManipulationService)"@fr .

