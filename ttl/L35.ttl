        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SoMAS";
        skos:definition        "The State University of New York's designated centre for marine sciences (USA) and a leader in marine, atmospheric and sustainability research, education, and public service, working together to better understand how our marine, terrestrial, and atmospheric environments function, are related to one another and how they and their associated living resources may be sustained for future generations."@en;
        skos:notation          "SDN:L35::MAN0371";
        skos:note              "accepted"@en;
        skos:prefLabel         "Stony Brook University School of Marine and Atmospheric Sciences"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B76/current/B7600042/> .

