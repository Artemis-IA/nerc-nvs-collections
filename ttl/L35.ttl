<http://vocab.nerc.ac.uk/collection/L35/current/MAN0333/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L35::MAN0333";
        dc:date                "2025-05-01 09:41:30.0";
        dc:identifier          "SDN:L35::MAN0333";
        pav:authoredOn         "2025-05-01 09:41:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L35/current/MAN0333/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "METAS";
        skos:definition        "METAS AS is based in Norway and was established in 2014. They specialise in subsea technology for asset integrity monitoring in the oil and gas industry, offering solutions that enhance safety and response times throughout the lifecycle of subsea systems. Key offerings include Wide Area Active Monitoring (WAAM) systems that detect and measure hydrocarbon and CO2 leaks, subsea video cameras operating at depths up to 6,500 meters, and environmental monitoring stations with soil samplers and various instruments. They also partner with iSeaMC to integrate ROVs and AUVs for deep-sea operations. METAS AS aims to improve the safety and cost-effectiveness of subsea operations through reliable monitoring systems."@en;
        skos:notation          "SDN:L35::MAN0333";
        skos:note              "accepted"@en;
        skos:prefLabel         "METAS AS"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2155/> .

