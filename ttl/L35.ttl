        owl:versionInfo        "1";
        skos:altLabel          "Helmholtz Centre Hereon";
        skos:definition        "A research and technology centre based in Geesthact, Germany. Scientific spectrum encompasses high-performance materials, processes and environmentally friendly technologies for mobility and new energy systems. Research is conducted on biomaterials for medicine and increasing quality of life. Hereon addresses the challenges of climate change and facilitates sustainable management of coasts and the marine environment. Founded in 1956."@en;
        skos:notation          "SDN:L35::MAN0261";
        skos:note              "accepted"@en;
        skos:prefLabel         "Helmholtz-Zentrum Hereon"@en;
