        owl:versionInfo        "1";
        skos:altLabel          "OI Analytical";
        skos:definition        "A US-based company specialising in the design and manufacture of instrumentation for chemical analysis. OI Analytical was established in 1963 and became a part of Xylem Analytics in 2011."@en;
        skos:notation          "SDN:L35::MAN0390";
        skos:note              "accepted"@en;
