        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SMC";
        skos:definition        "Ship Motion Control (SMC) manufactures motion reference units for the marine and offshore oil and gas industry. The roll, pitch and heave motion reference units are used in dynamic positioning, active heave compensation, helideck monitoring system, and hydrographic applications. SMC also produces software systems for motion monitoring, helideck monitoring system and weather and met-ocean monitoring on-board offshore platforms and vessels. SMC was established in 2003 and is based out of Gzira, Malta."@en;
        skos:notation          "SDN:L35::MAN0203";
        skos:note              "accepted"@en;
        skos:prefLabel         "SMC Ship Motion Control"@en;
