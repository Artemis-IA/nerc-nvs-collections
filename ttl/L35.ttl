        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "TEKRAN";
        skos:definition        "A manufacturer of advanced systems for ambient air, laboratory analysis, and point-source mercury monitoring, with expertise in cold vapor atomic fluorescence detection for measuring ultra-trace levels of mercury. Tekran serves the needs of industry, government and research institutions with applications ranging from pure research to primary manufacturing. Founded in Toronto, Canada in 1989."@en;
        skos:notation          "SDN:L35::MAN0301";
        skos:note              "accepted"@en;
