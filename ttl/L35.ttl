<http://vocab.nerc.ac.uk/collection/L35/current/MAN0074/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L35::MAN0074";
        dc:date                "2020-04-28 14:26:02.0";
        dc:identifier          "SDN:L35::MAN0074";
        pav:authoredOn         "2020-04-28 14:26:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L35/current/MAN0074/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "edgetech";
        skos:definition        "EdgeTech is a manufacturer of underwater technology solutions. Its products include: side scan sonars, sub-bottom profilers, bathymetry systems, AUV and ROV-based sonar systems, combined and customized solutions. In addition to the full line of underwater survey products, EdgeTech provides reliable USBL systems, transponder beacons, deep sea acoustic releases, shallow water and long life acoustic releases, MRUs and customized underwater acoustic command and control systems. The company traces its history back to 1965 when it started out as a division of EG&G Marine Instruments. In 1995, EdgeTech became a private company. In 2012 ORE Offshore, a leading provider of acoustic releases, transponders and USBL systems, adopted the EdgeTech name after over ten years operating as an affiliate organization within the company. The company also has a comprehensive suite of in-house testing facilities including test pools, acoustic test tanks, pressure test chambers and two company research vessels used for testing and sea trials. These facilities allow the companies to fully test and calibrate every system."@en;
        skos:notation          "SDN:L35::MAN0074";
        skos:note              "accepted"@en;
        skos:prefLabel         "EdgeTech Ltd."@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1819/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1423/> .

