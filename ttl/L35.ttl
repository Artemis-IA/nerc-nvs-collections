<http://vocab.nerc.ac.uk/collection/L35/current/MAN0070/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L35::MAN0070";
        dc:date                "2020-04-16 12:23:07.0";
        dc:identifier          "SDN:L35::MAN0070";
        pav:authoredOn         "2020-04-16 12:23:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L35/current/MAN0070/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "IS";
        skos:definition        "A subsea technology company that designs and manufactures a range of high-performance sensor solutions designed for use on underwater vehicles (such as Remotely Operated and Autonomous Vehicles) and can also be used in a number of other underwater applications. Impact Subsea provides sensor solutions to the Oil and Gas, Renewables, Underwater Research and Defence markets. Established in 2015, the company has developed a portfolio of underwater technology encompassing Sonars; Altimeters; Depth Sensors; Attitude and Heading Reference Systems; Flooded Member Detection Systems and bespoke Pressure Housings."@en;
        skos:notation          "SDN:L35::MAN0070";
        skos:note              "accepted"@en;
        skos:prefLabel         "Impact Subsea Ltd."@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1418/> .

<http://vocab.nerc.ac.uk/collection/L35/current/MAN0014/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L35::MAN0014";
        dc:date                "2017-06-14 10:13:21.0";
        dc:identifier          "SDN:L35::MAN0014";
        pav:authoredOn         "2017-06-14 10:13:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L35/current/MAN0014/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "VLPRT";
        skos:definition        "A UK-based company that designs and manufactures instrumentation for the oceanographic, hydrometric and hydrographic markets, with a worldwide customer base that includes the environmental, military, oil and gas, renewable, construction, dredging and civil engineering sectors. It was founded near Dartmouth, in Devon in 1969 by Jim Stevens and originally sold the Braystoke Flow Meter, an impeller-type device which was used in the feasibility study for the Thames Barrier. The popularity of this led to an expansion of the company into other types of flow meters and accessories. Valeport was then purchased in 1982 by Oceonics Group PLC prior to their flotation, which led to an expansion of Valeport's expertise to include CTD measurement. Oceonics sold Valeport in 1985."@en;
        skos:notation          "SDN:L35::MAN0014";
        skos:note              "accepted"@en;
        skos:prefLabel         "Valeport"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1437/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1729/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1359/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2096/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1495/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1883/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1738/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1816/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2099/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1494/> .

