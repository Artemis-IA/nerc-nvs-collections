        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "WISE";
        skos:definition        "A leading provider of meteorological and oceanographic data systems. They specialise in designing, building, and installing Environmental Monitoring Systems (EMS) and Helideck Monitoring Systems (HMS) for offshore and marine applications. Their systems measure parameters like wind, temperature, barometric pressure, sea currents, and waves, ensuring safety and efficiency in demanding environments. Headquartered in Stavanger area, Norway, it was founded in 1991."@en;
        skos:notation          "SDN:L35::MAN0316";
        skos:note              "accepted"@en;
        skos:prefLabel         "WISE Group Automasjon and Data AS"@en;
