        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NHBS";
        skos:definition        "A supplier of wildlife survey equipment and books to naturalists, academics and ecological and conservation professionals, founded in 1985. In 2011 NHBS acquired Alana Ecology, a supplier of ecology, conservation, and survey equipment, and in 2016 purchased EFE and GB Nets, a manufacturer of high-quality entomology and aquatic ecology survey tools. The company also publishes the magazines British Wildlife and Conservation Land Management."@en;
        skos:notation          "SDN:L35::MAN0398";
        skos:note              "accepted"@en;
        skos:prefLabel         "Natural History Book Service"@en;
