<http://vocab.nerc.ac.uk/collection/L35/current/MAN0041/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L35::MAN0041";
        dc:date                "2019-06-12 12:23:32.0";
        dc:identifier          "SDN:L35::MAN0041";
        pav:authoredOn         "2019-06-12 12:23:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L35/current/MAN0041/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "KIPP_ZONEN";
        skos:definition        "A company based in Delft, Netherlands, that develops, assembles and distributes instruments for measuring solar radiation parameters to monitor atmospheric properties for scientific purposes and renewable energy applications. It started out in the same city in 1830 as a pharmacy shop named 'Kipp' after its funder Petrus Jacobu Kipp. The company was re-named 'Kipp & Zonen', meaning 'Kipp and sons', when Kipp's sons took over the business in 1866. The company extended its specialisation to telephones and accessories for railway companies, until the first promotion of the thermopile in 1923; this marked Kipp & Zonen's shift towards solar radiation instruments, which persists to this day."@en;
        skos:notation          "SDN:L35::MAN0041";
        skos:note              "accepted"@en;
        skos:prefLabel         "Kipp and Zonen"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1332/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1333/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1831/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1598/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1502/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2209/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1670/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1672/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1604/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2083/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL2084/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1734/> , <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1873/> .

