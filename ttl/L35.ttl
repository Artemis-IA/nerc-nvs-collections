<http://vocab.nerc.ac.uk/collection/L35/current/MAN0023/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L35::MAN0023";
        dc:date                "2017-07-03 16:30:48.0";
        dc:identifier          "SDN:L35::MAN0023";
        pav:authoredOn         "2017-07-03 16:30:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L35/current/MAN0023/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "IROB";
        skos:definition        "A US-based company that designs and builds robots in the areas of mapping and navigation, human-robot interaction, and physical solutions. The company was founded in 1990 by Massachusetts Institute of Technology roboticists. The company inspired the first Micro Rovers used by NASA, deployed the first ground robots used by U.S. Forces in conflict, brought the first self-navigating FDA-approved remote presence robots to hospitals and introduced the first practical home robot with Roomba."@en;
        skos:notation          "SDN:L35::MAN0023";
        skos:note              "accepted"@en;
        skos:prefLabel         "iRobot"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/B76/current/B7600025/> .

<http://vocab.nerc.ac.uk/collection/L35/current/MAN0391/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L35::MAN0391";
        dc:date                "2026-05-21 16:09:34.0";
        dc:identifier          "SDN:L35::MAN0391";
        pav:authoredOn         "2026-05-21 16:09:34.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L35/current/MAN0391/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MBA";
        skos:definition        "A UK-based marine science charity founded in 1884 and was granted a Royal Charter in 2013. The MBA focuses predominantly on biological and ecological research of coasts and oceans and operates its own research vessels."@en;
        skos:notation          "SDN:L35::MAN0391";
        skos:note              "accepted"@en;
        skos:prefLabel         "Marine Biological Association"@en .

