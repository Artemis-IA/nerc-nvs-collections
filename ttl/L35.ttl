        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "HANWHA";
        skos:definition        "Formerly known as Hanwha Techwin. A global vision solution provider providing optical design, image processing and cybersecurity technologies including IP cameras that support up to 8K resolution, video management systems, video and audio analytics, multi-sensor technologies, and device integration with a host of 3rd party application providers. These surveillance solutions are used globally, across a range of industries including retail, transportation, education, banking, healthcare, hospitality etc."@en;
        skos:notation          "SDN:L35::MAN0264";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hanwha Vision"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/L22/current/TOOL1964/> .

