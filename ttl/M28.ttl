<http://vocab.nerc.ac.uk/collection/M28/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies associated with the Ramsar Classification System for Wetland Type.";
        dc:alternative          "Ramsar upper categories";
        dc:creator              "Ramsar Convention on Wetlands vocabulary governance";
