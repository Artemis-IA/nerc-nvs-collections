        rdf:type                skos:Collection;
        rdfs:comment            "NASA environmental discovery metadata development and portal management group.";
        dc:alternative          "GCMD platforms";
        dc:creator              "Global Change Master Directory";
        dc:date                 "2008-02-05 11:24:56.0";
        dc:description          "This collection is no longer maintained. It is an old version of the GCMD science keywords set up when GCMD keywords did not have stable URIs. Please use the URIs published on https://gcmd.earthdata.nasa.gov/ (definition was: Terms used to describe sensor-bearing platforms from Olsen L.M. et. al (2006) NASA/GCMD Earth Science Keywords Version 5.3.3.).";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Global Change Master Directory platforms";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Global Change Master Directory";
