<http://vocab.nerc.ac.uk/collection/S06/current/S0600314/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S06::S0600314";
        dc:date                "2023-07-31 13:30:31.0";
        dc:identifier          "SDN:S06::S0600314";
        pav:authoredOn         "2023-07-31 13:30:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S06/current/S0600314/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "An index used in the monitoring of imposex, a condition resulting in the development of a penis and vas deferens in female gastropods when exposed to certain pollutants. The index is based on a sequence of six identified stages (number 1 to 6) in the development of imposex in female gastropods plus an initial stage (number 0). The index is the mean of the stages observed in a population (Gibbs 1999)."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P01/current/VDSIXX01/> , <http://vocab.nerc.ac.uk/collection/P01/current/VDSINL01/>;
        skos:notation          "SDN:S06::S0600314";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vas Deferens Sequence Index"@en .

<http://vocab.nerc.ac.uk/collection/S06/current/S0600313/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S06::S0600313";
        dc:date                "2023-07-31 13:30:31.0";
        dc:identifier          "SDN:S06::S0600313";
        pav:authoredOn         "2023-07-31 13:30:31.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S06/current/S0600313/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "An index used in the monitoring of imposex, a condition resulting in the development of a penis and vas deferens in female gastropods when exposed to certain pollutants. The index is calculated as the mean length of female penis divided by mean length of male penis in a population multiplied by 100 (Bryan et al 1986, Gibbs et al 1987, Gibbs 1999)."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P01/current/RPLINL01/>;
        skos:notation          "SDN:S06::S0600313";
        skos:note              "accepted"@en;
        skos:prefLabel         "Relative Penis Length Index"@en .

