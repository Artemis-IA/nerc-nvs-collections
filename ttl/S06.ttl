        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S014/>;
        skos:definition        "Deviation of the 112Cd/110Cd isotopic ratio of a sample relative to the standard solution SRM 3108, a reference material for cadmium (Cd) developed by the US National Institute of Standards and Technology. It is defined as delta(112/110Cd)NIST =([112Cd/110Cd]sample/[112Cd/110Cd]NIST)-1)×1000. One delta unit represents a one part per 1,000 deviation from the NIST standard composition."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P01/current/CD112SEM/> , <http://vocab.nerc.ac.uk/collection/P01/current/CD112SRM/>;
        skos:notation          "SDN:S06::S0600058";
        skos:note              "accepted"@en;
        skos:prefLabel         "Enrichment with respect to 112Cd/110Cd in NIST SRM 3108"@en .

