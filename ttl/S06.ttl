<http://vocab.nerc.ac.uk/collection/S06/current/S0600295/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S06::S0600295";
        dc:date                "2022-10-10 14:39:15.0";
        dc:identifier          "SDN:S06::S0600295";
        pav:authoredOn         "2022-10-10 14:39:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S06/current/S0600295/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The ratio of particulate organic carbon (POC) concentration to thorium-234 activity. Thorium is insoluble in seawater and is scavenged by particles as they form and/or sink through the water column. This causes a radioactive disequilibrium between 238U and 234Th in the upper water column, which is proportional to the numbers of particles exported. The POC/Th-234 ratio is hence used to estimate particle and elemental export fluxes."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P01/current/POCTHP50/> , <http://vocab.nerc.ac.uk/collection/P01/current/POCTHU07/> , <http://vocab.nerc.ac.uk/collection/P01/current/POCTHP07/> , <http://vocab.nerc.ac.uk/collection/P01/current/POCTHU50/>;
        skos:notation          "SDN:S06::S0600295";
        skos:note              "accepted"@en;
        skos:prefLabel         "POC/Th-234 ratio"@en .

