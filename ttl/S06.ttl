<http://vocab.nerc.ac.uk/collection/S06/current/S0600087/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S06::S0600087";
        dc:date                "2018-01-10 15:59:59.0";
        dc:identifier          "SDN:S06::S0600087";
        pav:authoredOn         "2018-01-10 15:59:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S06/current/S0600087/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S06/current/S0600087/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S014/>;
        skos:definition        "Poids des matières organiques et inorganiques (i.e. minérales) d'organismes biologiques dans : une surface, un volume, une matrice environnementale, une fois que toute l'eau en a été retirée. Cela se fait généralement en passant les échantillons à l'étuve à des températures assez basses pour éviter leur combustion (généralement autour de 60 degrés Celsius), puis en laissant ces échantillons dans un contenant fermé contenant un desiccateur."@fr , "The weight of both organic and inorganic (i.e. mineral) matter of biological organisms in a given area, volume or mass of environmental matrix after all the water has been removed. This is typically done by baking samples at a temperature low enough to avoid combustion (typically around 60 degrees Celsius) followed by a period in a sealed container containing a desiccant."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P01/current/MFDWSANM/> , <http://vocab.nerc.ac.uk/collection/P01/current/SDBIOL08/> , <http://vocab.nerc.ac.uk/collection/P01/current/DWPO1100/> , <http://vocab.nerc.ac.uk/collection/P01/current/MSBDGVSA/> , <http://vocab.nerc.ac.uk/collection/P01/current/MSBDGVTX/> , <http://vocab.nerc.ac.uk/collection/P01/current/MSBDGVSE/> , <http://vocab.nerc.ac.uk/collection/P01/current/SDBIOL09/> , <http://vocab.nerc.ac.uk/collection/P01/current/MSBDGVSB/> , <http://vocab.nerc.ac.uk/collection/P01/current/MSBDGVSC/>;
        skos:notation          "SDN:S06::S0600087";
        skos:note              "accepted"@en;
        skos:prefLabel         "Dry weight biomass"@en , "biomasse (poids sec)"@fr .

