        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The heat content that a parcel of water would have if raised adiabatically and without exchange of salt to the sea surface. Proportional to potential enthalpy, conservative temperature is a more accurate measure of the heat content of sea water in comparison to potential temperature as it takes turbulent mixing into account as well as pressure changes. McDougall, Trevor. (2003). Potential Enthalpy: A Conservative Oceanic Variable for Evaluating Heat Content and Heat Fluxes. Journal of Physical Oceanography - J PHYS OCEANOGR. 33. 945-963. 10.1175/1520-0485(2003)033<0945:PEACOV>2.0.CO;2."@en;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/P01/current/COTMCV01/>;
        skos:notation          "SDN:S06::S0600358";
        skos:note              "accepted"@en;
        skos:prefLabel         "Conservative temperature"@en .

