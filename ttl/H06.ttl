<http://vocab.nerc.ac.uk/collection/H06/current/H06AA001/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H06::H06AA001";
        dc:date                "2021-04-26 09:55:49.0";
        dc:identifier          "SDN:H06::H06AA001";
        pav:authoredOn         "2021-04-26 09:55:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H06/current/H06AA001/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H06/current/H06AA001/1/>;
