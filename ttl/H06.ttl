        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Term that qualifies micro-litter particles that allow light to travel through them either almost unaltered (transparent) or with some diffraction (translucent, translucid or semitransparent)."@en;
        skos:notation          "SDN:H06::H06AA001";
        skos:note              "accepted"@en;
        skos:prefLabel         "transparent/translucent"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITROPW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITROPS/> .

<http://vocab.nerc.ac.uk/collection/H06/current/H06AA002/>
        rdf:type               skos:Concept;
