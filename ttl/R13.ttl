<http://vocab.nerc.ac.uk/collection/R13/current/I/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R13::I";
        dc:date                "2024-09-11 11:40:41.0";
        dc:identifier          "SDN:R13::I";
        pav:authoredOn         "2024-09-11 11:40:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R13/current/I/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R13/current/I/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "I";
        skos:definition        "Below 30 degrees south, the Indian/Atlantic oceans boundary is at 20 degrees east, whereas the Indian/Pacific oceans boundary is at 145 degrees east. The Red Sea is part of the Indian ocean area."@en;
        skos:notation          "SDN:R13::I";
        skos:note              "accepted"@en;
        skos:prefLabel         "Indian ocean area"@en .

<http://vocab.nerc.ac.uk/collection/R13/current/A/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R13::A";
        dc:date                "2024-09-11 11:40:41.0";
        dc:identifier          "SDN:R13::A";
        pav:authoredOn         "2024-09-11 11:40:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R13/current/A/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R13/current/A/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "A";
        skos:definition        "Below 30 degrees south, the Atlantic/Pacific oceans boundary is at 70 degrees west, whereas the Atlantic/Indian oceans boundary is at 20 degrees east. The Caribbean Sea, the Mexico Gulf, the Mediterranean Sea, the Black Sea, the Baltic Sea, the Labrador Sea, the Baffin Bay and the Nordic seas (Greenland, Norwegian, Barents and Kara seas) are part of the Atlantic ocean area."@en;
        skos:notation          "SDN:R13::A";
        skos:note              "accepted"@en;
        skos:prefLabel         "Atlantic ocean area"@en .

<http://vocab.nerc.ac.uk/collection/R13/current/P/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R13::P";
        dc:date                "2024-09-11 11:40:41.0";
        dc:identifier          "SDN:R13::P";
        pav:authoredOn         "2024-09-11 11:40:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R13/current/P/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R13/current/P/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "P";
        skos:definition        "Below 30 degrees south, the Pacific/Indian oceans boundary is at 145 degrees east, whereas the Pacific/Atlantic oceans boundary is at 70 degrees west. The South China Sea, the Indonesian seas, the Laptev, Beaufort, East Siberian and Chukchi seas are part of the Pacific ocean area."@en;
        skos:notation          "SDN:R13::P";
        skos:note              "accepted"@en;
        skos:prefLabel         "Pacific ocean area"@en .

