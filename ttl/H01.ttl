<http://vocab.nerc.ac.uk/collection/H01/current/H0100002/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H01::H0100002";
        dc:date                "2023-07-10 14:46:50.0";
        dc:identifier          "SDN:H01::H0100002";
        pav:authoredOn         "2023-07-10 14:46:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H01/current/H0100002/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H01/current/H0100002/3/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100002/2/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100002/1/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:definition        "Irregularly-shaped micro-litter particles with broken off edges that may be rounded or angular."@en;
        skos:notation          "SDN:H01::H0100002";
        skos:note              "accepted"@en;
        skos:prefLabel         "fragments"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPS/> .

<http://vocab.nerc.ac.uk/collection/H01/current/H0100005/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H01::H0100005";
        dc:date                "2023-07-24 16:05:06.0";
        dc:identifier          "SDN:H01::H0100005";
        pav:authoredOn         "2023-07-24 16:05:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H01/current/H0100005/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H01/current/H0100005/1/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100005/3/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100005/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:definition        "Thin planar micro-litter particles of arbitrarily limited maximum thickness, in which the thickness is very small compared to the length and width (adapted from ISO definition for film https://www.iso.org/obp/ui/#iso:std:iso:5148:ed-1:v1:en:term:3.1). In the micro-litter nomenclature, particles of type \"films\" are more flexible than particles of type \"fragments\" with the latter tending to break easily (Isobe et al 2019)."@en;
        skos:notation          "SDN:H01::H0100005";
        skos:note              "accepted"@en;
        skos:prefLabel         "films"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPS/> .

<http://vocab.nerc.ac.uk/collection/H01/current/H0100003/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H01::H0100003";
        dc:date                "2022-06-28 10:20:49.0";
        dc:identifier          "SDN:H01::H0100003";
        pav:authoredOn         "2022-06-28 10:20:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H01/current/H0100003/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H01/current/H0100003/1/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100003/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "Micro-litter particles from industrial origin only. In comparison with granules, pellets are usually flat on one side, rough surface and irregular, round shapes. Normally bigger in size."@en;
        skos:notation          "SDN:H01::H0100003";
        skos:note              "accepted"@en;
        skos:prefLabel         "pellets"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPS/> .

<http://vocab.nerc.ac.uk/collection/H01/current/H0100008/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H01::H0100008";
        dc:date                "2022-06-28 10:20:52.0";
        dc:identifier          "SDN:H01::H0100008";
        pav:authoredOn         "2022-06-28 10:20:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H01/current/H0100008/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H01/current/H0100008/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "2";
        skos:altLabel          "natural fibres/rubber";
        skos:definition        "Term deprecated on 2022/06/28 following review of the H01 categories; see https://github.com/nvs-vocabs/EMODnetChemVocabs/issues/19. Filaments of non-plastic material such as natural fibres or rubber that are present in micro-litter samples."@en;
        skos:notation          "SDN:H01::H0100008";
        skos:note              "deprecated"@en;
        skos:prefLabel         "non-plastic filaments (natural fibres, rubber)"@en .

<http://vocab.nerc.ac.uk/collection/H01/current/H0100006/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H01::H0100006";
        dc:date                "2023-07-04 13:10:13.0";
        dc:identifier          "SDN:H01::H0100006";
        pav:authoredOn         "2023-07-04 13:10:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H01/current/H0100006/5/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H01/current/H0100006/4/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100006/2/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100006/3/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100006/1/>;
        pav:version            "5";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "5";
        skos:altLabel          "";
        skos:definition        "Flexible micro-litter particles in which material cells are all or partly intercommunicating (adapted from ISO definition for foam (https://www.iso.org/obp/ui/#iso:std:iso:tr:20342:-7:ed-1:v1:en)."@en;
        skos:notation          "SDN:H01::H0100006";
        skos:note              "accepted"@en;
        skos:prefLabel         "foams"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPS/> .

<http://vocab.nerc.ac.uk/collection/H01/current/H0100009/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:H01::H0100009";
        dc:date                "2022-07-20 14:41:36.0";
        dc:identifier          "SDN:H01::H0100009";
        pav:authoredOn         "2022-07-20 14:41:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/H01/current/H0100009/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/H01/current/H0100009/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Micro-litter particles with smooth spherical shape. In comparison with pellets, they have a rounder shape and are smaller in size (adapted from [Matiddi et al, 2021](https://accedacris.ulpgc.es/bitstream/10553/114417/1/Report_Monitoring-microlitter-ingestion-in-marine-fish.pdf))."@en;
        skos:notation          "SDN:H01::H0100009";
        skos:note              "accepted"@en;
        skos:prefLabel         "granules"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPW/> , <http://vocab.nerc.ac.uk/collection/P01/current/MLITTYPS/> .

<http://vocab.nerc.ac.uk/collection/H01/current/H0100007/>
        rdf:type               skos:Concept;
