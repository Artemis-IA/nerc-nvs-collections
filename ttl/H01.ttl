<http://vocab.nerc.ac.uk/collection/H01/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "A European project consortium aimed at the creation of data products using chemical data amassed through SeaDataNet. The governance is loosely defined as the scientific expertise within the consortium with no formal processes defined.";
        rdfs:seeAlso            <https://github.com/nvs-vocabs/H01>;
        dc:alternative          "Microlitter_type";
        dc:creator              "EMODnet Chemistry Lot";
        dc:date                 "2023-07-25 03:00:01.0";
        dc:description          "Controlled vocabulary defining the terms that may be used for micro-litter particle types in the EMODnet Chemistry data reporting system. The categories only reflect types based on morphological criteria (e.g. pellets, fragments, etc.) and all reference to the material they were made of was removed from this vocabulary as agreed in https://nvs-vocabs/EMODnetChemVocabs#19.";
        dc:license              <https://creativecommons.org/licenses/by/4.0/>;
        dc:publisher            "Natural Environment Research Council";
        dc:title                "EMODnet micro-litter types";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "EMODnet Chemistry Lot";
        owl:versionInfo         "10";
        skos:altLabel           "Microlitter_type";
        skos:member             <http://vocab.nerc.ac.uk/collection/H01/current/H0100001/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100002/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100005/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100003/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100008/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100006/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100009/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100007/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100010/> , <http://vocab.nerc.ac.uk/collection/H01/current/H0100004/>;
        skos:prefLabel          "EMODnet micro-litter types" .
