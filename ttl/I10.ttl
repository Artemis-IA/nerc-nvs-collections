<http://vocab.nerc.ac.uk/collection/I10/current/5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I10::5";
        dc:date                "2015-08-25 16:44:48.0";
        dc:identifier          "SDN:I10::5";
        pav:authoredOn         "2015-08-25 16:44:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I10/current/5/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Invoke";
        skos:definition        "Service that allows defining both the data inputs and data outputs expected by the spatial service and a workflow or service chain combining multiple services. It also allows defining the external web service interface of the workflow or service chain."@en;
        skos:notation          "SDN:I10::5";
        skos:note              "accepted"@en;
        skos:prefLabel         "Invoke  Spatial Data Service"@en .

<http://vocab.nerc.ac.uk/collection/I10/current/3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I10::3";
        dc:date                "2015-08-25 16:45:47.0";
        dc:identifier          "SDN:I10::3";
        pav:authoredOn         "2015-08-25 16:45:47.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I10/current/3/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/I10/current/3/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Download";
        skos:definition        "Service that enables copies of spatial data sets, or parts of such sets, to be downloaded and, where practicable, accessed directly."@en;
        skos:notation          "SDN:I10::3";
        skos:note              "accepted"@en;
        skos:prefLabel         "Download Service"@en .

<http://vocab.nerc.ac.uk/collection/I10/current/1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I10::1";
        dc:date                "2015-08-25 16:45:07.0";
        dc:identifier          "SDN:I10::1";
        pav:authoredOn         "2015-08-25 16:45:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I10/current/1/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/I10/current/1/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Discovery";
        skos:definition        "Services making it possible to search for spatial data sets and services on the basis of the content of the corresponding metadata and to display the content of the metadata."@en;
        skos:notation          "SDN:I10::1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Discovery Service"@en .

<http://vocab.nerc.ac.uk/collection/I10/current/2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:I10::2";
        dc:date                "2015-08-25 16:45:33.0";
        dc:identifier          "SDN:I10::2";
        pav:authoredOn         "2015-08-25 16:45:33.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/I10/current/2/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/I10/current/2/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "View";
        skos:definition        "Service that makes it possible, as a minimum, to display, navigate, zoom in and out, pan or overlay viewable spatial data sets and to display legend information and any relevant content of metadata."@en;
        skos:notation          "SDN:I10::2";
        skos:note              "accepted"@en;
        skos:prefLabel         "View Service"@en .

<http://vocab.nerc.ac.uk/collection/I10/current/4/>
