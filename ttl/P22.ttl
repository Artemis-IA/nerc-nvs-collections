<http://vocab.nerc.ac.uk/collection/P22/current/2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P22::2";
        dc:date                "2009-07-30 13:25:19.0";
        dc:identifier          "SDN:P22::2";
        pav:authoredOn         "2009-07-30 13:25:19.0";
