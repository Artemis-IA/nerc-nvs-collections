<http://vocab.nerc.ac.uk/collection/S23/current/S23C003/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S23::S23C003";
        dc:date                "2014-03-13 08:21:44.0";
        dc:identifier          "SDN:S23::S23C003";
        pav:authoredOn         "2014-03-13 08:21:44.0";
