<http://vocab.nerc.ac.uk/collection/S23/current/S23C010/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S23::S23C010";
        dc:date                "2018-06-11 11:13:02.0";
        dc:identifier          "SDN:S23::S23C010";
        pav:authoredOn         "2018-06-11 11:13:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S23/current/S23C010/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/S23/current/S23C010/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Portion d'une sphère aqueuse (masse d'eau, eau intersticielle, eau de pluie) qui s'écoule au travers d'un filtre ou l'ensemble de la sphere aqueuse (i.e. eau non filtrée). Cela comprend du liquide ainsi que des particules solides inférieures à la taille du filtre (ou de n'importe quelle taille) qui peuvent ou non contribuer à la valeur du paramètre analysé."@fr , "The portion of an aqueous sphere (water bodies, pore water, rainwater) that passes through a filter or that sphere in its entirety (i.e. unfiltered water). It comprises liquid plus solid particles smaller than a designated size (or all sizes) that may or may not contribute to the magnitude of the analyte assay."@en;
        skos:notation          "SDN:S23::S23C010";
        skos:note              "accepted"@en;
        skos:prefLabel         "phase liquide dissoute"@fr , "dissolved plus reactive particulate"@en;
