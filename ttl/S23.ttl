        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "Term deprecated on 31-oct-2019 and concept moved to a different class in the semantic model. Definition was: The portion of a solid sphere (SPM or sediment) that is composed the hard protective outer cases of a molluscs or crustaceans or the broken remains thereof."@en;
        skos:notation          "SDN:S23::S23C018";
        skos:note              "deprecated"@en;
        skos:prefLabel         "shell and shell fragment"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/S26/current/MAT00143/> .

<http://vocab.nerc.ac.uk/collection/S23/current/S23C009/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S23::S23C009";
        dc:date                "2014-03-13 08:21:44.0";
        dc:identifier          "SDN:S23::S23C009";
        pav:authoredOn         "2014-03-13 08:21:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S23/current/S23C009/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The portion of a solid sphere (SPM or sediment) that is not made up from material that changes the colour of reflected or transmitted light."@en;
        skos:notation          "SDN:S23::S23C009";
        skos:note              "accepted"@en;
        skos:prefLabel         "pigment"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/S26/current/MAT00255/> .

<http://vocab.nerc.ac.uk/collection/S23/current/S23C014/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S23::S23C014";
        dc:date                "2014-03-13 08:21:44.0";
        dc:identifier          "SDN:S23::S23C014";
        pav:authoredOn         "2014-03-13 08:21:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S23/current/S23C014/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The portion of the sphere that is solid but not crystalline."@en;
        skos:notation          "SDN:S23::S23C014";
        skos:note              "accepted"@en;
        skos:prefLabel         "amorphous"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/S26/current/MAT00115/> .

<http://vocab.nerc.ac.uk/collection/S23/current/S23C007/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S23::S23C007";
        dc:date                "2014-03-13 08:21:44.0";
        dc:identifier          "SDN:S23::S23C007";
        pav:authoredOn         "2014-03-13 08:21:44.0";
