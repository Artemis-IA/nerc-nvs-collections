        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The portion of the sphere that is denser than bromoform."@en;
        skos:notation          "SDN:S23::S23C011";
        skos:note              "accepted"@en;
        skos:prefLabel         "heavy fraction"@en;
