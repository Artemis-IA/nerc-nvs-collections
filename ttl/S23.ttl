        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The portion of a solid sphere (SPM or sediment) that is not made up from lower plant material."@en;
        skos:notation          "SDN:S23::S23C007";
        skos:note              "accepted"@en;
        skos:prefLabel         "non-algal particle"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/S26/current/MAT00241/> .

<http://vocab.nerc.ac.uk/collection/S23/current/S23C013/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S23::S23C013";
        dc:date                "2014-03-13 08:21:44.0";
        dc:identifier          "SDN:S23::S23C013";
        pav:authoredOn         "2014-03-13 08:21:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S23/current/S23C013/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The portion of atmosphere that is neither solids nor liquid droplets."@en;
        skos:notation          "SDN:S23::S23C013";
        skos:note              "accepted"@en;
        skos:prefLabel         "gaseous"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/S26/current/MAT00836/> .

<http://vocab.nerc.ac.uk/collection/S23/current/S23C011/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S23::S23C011";
        dc:date                "2014-03-13 08:21:44.0";
        dc:identifier          "SDN:S23::S23C011";
