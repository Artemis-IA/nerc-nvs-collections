        skos:prefLabel         "permafrost_layer"@en .

<http://vocab.nerc.ac.uk/collection/P38/current/soil_layer/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P38::soil_layer";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P38::soil_layer";
        pav:authoredOn         "2015-02-18 11:28:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P38/current/soil_layer/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Layer means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. Quantities defined for a soil layer must have a vertical coordinate variable with boundaries indicating the extent of the layer(s)."@en;
        skos:notation          "SDN:P38::soil_layer";
        skos:note              "accepted"@en;
        skos:prefLabel         "soil_layer"@en .

