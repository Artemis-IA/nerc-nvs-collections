<http://vocab.nerc.ac.uk/collection/P38/current/sea_floor/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P38::sea_floor";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P38::sea_floor";
        pav:authoredOn         "2015-02-18 11:28:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P38/current/sea_floor/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The lower boundary of the ocean."@en;
        skos:definition        "La limite inférieure de l'océan."@fr ;
        skos:notation          "SDN:P38::sea_floor";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_floor"@en ;
        skos:prefLabel         "sea_floor"@fr .

<http://vocab.nerc.ac.uk/collection/P38/current/ocean_layer/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P38::ocean_layer";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P38::ocean_layer";
        pav:authoredOn         "2015-02-18 11:28:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P38/current/ocean_layer/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Layer\"\" means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well."@en;
        skos:definition        "« Layer » signifie toute couche dont les limites supérieure et inférieure ont des valeurs constantes dans une coordonnée verticale donnée. Il doit exister une variable de coordonnée verticale indiquant l'étendue de la ou des couche(s). Si les couches sont des couches de modèle, la coordonnée verticale peut être model_level_number, mais il est recommandé de spécifier aussi une coordonnée physique (dans une variable de coordonnée scalaire ou auxiliaire)."@fr ;
        skos:notation          "SDN:P38::ocean_layer";
        skos:note              "accepted"@en;
        skos:prefLabel         "ocean_layer"@en ;
        skos:prefLabel         "ocean_layer"@fr .

