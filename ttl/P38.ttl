        skos:note              "accepted"@en;
        skos:prefLabel         "convective_cloud_top"@en ;
        skos:prefLabel         "convective_cloud_top"@fr .

<http://vocab.nerc.ac.uk/collection/P38/current/reference_ellipsoid/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P38::reference_ellipsoid";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P38::reference_ellipsoid";
        pav:authoredOn         "2015-02-18 11:28:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P38/current/reference_ellipsoid/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A reference ellipsoid is a regular mathematical figure that approximates the irregular shape of the geoid. A number of reference ellipsoids are defined for use in the field of geodesy."@en;
        skos:definition        "Un ellipsoïde de référence est une figure mathématique régulière qui approxime la forme irrégulière du géoïde. Un certain nombre d'ellipsoïdes de référence sont définis pour usage dans le domaine de la géodésie."@fr ;
        skos:notation          "SDN:P38::reference_ellipsoid";
        skos:note              "accepted"@en;
        skos:prefLabel         "reference_ellipsoid"@en ;
        skos:prefLabel         "reference_ellipsoid"@fr .

