<http://vocab.nerc.ac.uk/collection/N07/current/REQA/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:N07::REQA";
        dc:date                "2026-04-13 12:27:11.0";
        dc:identifier          "SDN:N07::REQA";
        pav:authoredOn         "2026-04-13 12:27:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/N07/current/REQA/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The resource is not directly accessible and may only be obtained by submitting a request to the data centre or through a mediated access process."@en;
        skos:notation          "SDN:N07::REQA";
        skos:note              "accepted"@en;
        skos:prefLabel         "access by request"@en .

