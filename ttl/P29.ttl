ur/> , <http://vocab.nerc.ac.uk/collection/P29/current/ATCC4PFT/> , <http://vocab.nerc.ac.uk/collection/P29/current/CFAT04MP/> , <http://vocab.nerc.ac.uk/collection/P29/current/snow/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfdustaa/> , <http://vocab.nerc.ac.uk/collection/P29/current/CFA4MFSI/> , <http://vocab.nerc.ac.uk/collection/P29/current/ATV9IOLA/> , <http://vocab.nerc.ac.uk/collection/P29/current/CFAT10PF/> , <http://vocab.nerc.ac.uk/collection/P29/current/ATV9IASL/> , <http://vocab.nerc.ac.uk/collection/P29/current/ATPC3PFT/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfrainac/> , <http://vocab.nerc.ac.uk/collection/P29/current/cftreess/> , <http://vocab.nerc.ac.uk/collection/P29/current/land_ice/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfat5fis/> , <http://vocab.nerc.ac.uk/collection/P29/current/ATV9UFZS/> , <http://vocab.nerc.ac.uk/collection/P29/current/ATV9FRFW/> , <http://vocab.nerc.ac.uk/collection/P29/current/c4plfuty/> , <http://vocab.nerc.ac.uk/collection/P29/current/CFATRIV1/> , <http://vocab.nerc.ac.uk/collection/P29/current/CFATLAIS/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfat5ish/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfat5psl/> , <http://vocab.nerc.ac.uk/collection/P29/current/CFAT11SC/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfsnfrla/> , <http://vocab.nerc.ac.uk/collection/P29/current/CFATNLDT/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfherbvg/> , <http://vocab.nerc.ac.uk/collection/P29/current/sea/> , <http://vocab.nerc.ac.uk/collection/P29/current/cloud/> , <http://vocab.nerc.ac.uk/collection/P29/current/sea_ice/> , <http://vocab.nerc.ac.uk/collection/P29/current/ice_free_sea/> , <http://vocab.nerc.ac.uk/collection/P29/current/cfnatgra/>;
