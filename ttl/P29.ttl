<http://vocab.nerc.ac.uk/collection/P29/current/primevtr/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::primevtr";
        dc:date                "2013-07-11 09:54:22.0";
        dc:identifier          "SDN:P29::primevtr";
