<http://vocab.nerc.ac.uk/collection/P29/current/CFATBLDT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::CFATBLDT";
        dc:date                "2025-01-20 16:07:13.0";
        dc:identifier          "SDN:P29::CFATBLDT";
        pav:authoredOn         "2025-01-20 16:07:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/CFATBLDT/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Broadleaf trees are characterized by leaves that are broad, flat and thin with networked veins (reference: https://treeterms.co.uk/broadleaf/). Deciduous trees lose their leaves seasonally, for example, during winter in high latitudes or following seasonal variations in rainfall."@en;
        skos:notation          "SDN:P29::CFATBLDT";
        skos:note              "accepted"@en;
        skos:prefLabel         "broadleaf_deciduous_trees"@en .

