<http://vocab.nerc.ac.uk/collection/P29/current/primdetr/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::primdetr";
        dc:date                "2013-07-11 09:54:22.0";
        dc:identifier          "SDN:P29::primdetr";
        pav:authoredOn         "2013-07-11 09:54:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/primdetr/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A primary forest is a naturally regenerated forest of native species, where there are no clearly visible indications of human activities and the ecological processes are not significantly disturbed. Reference: 'Global Forest Resources Assessment: Terms and Definitions', Forestry Department of Food and Agriculture Organization (FAO) of the United Nations, Rome 2010, www.fao.org/forestry/14241-0d7b74f45b0d2cfef31599cc17e4c28cd.pdf. Deciduous trees lose their leaves seasonally, for example, during winter in high latitudes or following seasonal variations in rainfall."@en;
        skos:notation          "SDN:P29::primdetr";
        skos:note              "accepted"@en;
        skos:prefLabel         "primary_deciduous_trees"@en .

<http://vocab.nerc.ac.uk/collection/P29/current/ATCC3PFT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::ATCC3PFT";
        dc:date                "2018-03-13 13:56:23.0";
        dc:identifier          "SDN:P29::ATCC3PFT";
        pav:authoredOn         "2018-03-13 13:56:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/ATCC3PFT/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The definition of \"crops\" is model dependent, for example, some models may include fruit trees as crops. A \"c3 plant\" is one that utilizes the C3 carbon fixation pathway as the sole mechanism to bind CO2 before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4."@en;
        skos:notation          "SDN:P29::ATCC3PFT";
        skos:note              "accepted"@en;
        skos:prefLabel         "crops_of_c3_plant_functional_types"@en .

<http://vocab.nerc.ac.uk/collection/P29/current/ANGC4PFT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::ANGC4PFT";
        dc:date                "2018-03-13 13:56:23.0";
        dc:identifier          "SDN:P29::ANGC4PFT";
        pav:authoredOn         "2018-03-13 13:56:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/ANGC4PFT/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Natural grasses\" means grasses growing in areas of low productivity, often situated on rough or uneven ground. This can include rocky areas, briars and heathland. A \"c4 plant\" is one that utilizes the C4 carbon fixation pathway in which the CO2 is first bound to a compound containing four carbon atoms before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4."@en;
        skos:notation          "SDN:P29::ANGC4PFT";
        skos:note              "accepted"@en;
        skos:prefLabel         "natural_grasses_of_c4_plant_functional_types"@en .

<http://vocab.nerc.ac.uk/collection/P29/current/CFATNLEV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::CFATNLEV";
        dc:date                "2025-01-20 16:07:13.0";
        dc:identifier          "SDN:P29::CFATNLEV";
        pav:authoredOn         "2025-01-20 16:07:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/CFATNLEV/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Needleleaf trees, often referred to as conifers, have long, thin needle-shaped leaves that are well adapted to retaining water. Evergreen plants retain their leaves through the year and into the following growing season (reference: https://www.britannica.com/plant/evergreen-plant)."@en;
        skos:notation          "SDN:P29::CFATNLEV";
        skos:note              "accepted"@en;
        skos:prefLabel         "needleleaf_evergreen_trees"@en .

<http://vocab.nerc.ac.uk/collection/P29/current/cfat5urb/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::cfat5urb";
        dc:date                "2017-02-21 16:02:00.0";
        dc:identifier          "SDN:P29::cfat5urb";
        pav:authoredOn         "2017-02-21 16:02:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/cfat5urb/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P29/current/cfat5urb/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Urban land is comprised of areas where much of the land is covered by structures. Included in this category are cities, towns and villages. Reference: Anderson, J.R, E. E. Hardy, J. T. Roach and R. E. Witmer (1976), A Land Use And Land Cover Classification System For Use With Remote Sensor Data, Appendix C Land Use Definitions, Geological Survey Professional Paper 964, A revision of the land use classification system as presented in U.S. Geological Survey Circular 671, https://www.usbr.gov/lc/socal/reports/SMappend_C.pdf."@en;
        skos:notation          "SDN:P29::cfat5urb";
        skos:note              "accepted"@en;
        skos:prefLabel         "urban"@en .

