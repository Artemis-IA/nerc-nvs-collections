<http://vocab.nerc.ac.uk/collection/P29/current/CFATNLDT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::CFATNLDT";
        dc:date                "2025-01-20 16:07:13.0";
        dc:identifier          "SDN:P29::CFATNLDT";
        pav:authoredOn         "2025-01-20 16:07:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/CFATNLDT/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Needleleaf trees, often referred to as conifers, have long, thin needle-shaped leaves that are well adapted to retaining water. Deciduous trees lose their leaves seasonally, for example, during winter in high latitudes or following seasonal variations in rainfall."@en;
        skos:notation          "SDN:P29::CFATNLDT";
        skos:note              "accepted"@en;
        skos:prefLabel         "needleleaf_deciduous_trees"@en .

<http://vocab.nerc.ac.uk/collection/P29/current/cfherbvg/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::cfherbvg";
        dc:date                "2018-07-10 09:28:29.0";
        dc:identifier          "SDN:P29::cfherbvg";
        pav:authoredOn         "2018-07-10 09:28:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/cfherbvg/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Herbaceous plants are plants with very flexible stems. Their leaves and stems die down to soil level at the end of every growing season. Herbaceous plants can be annual, biennial or perennial."@en;
        skos:notation          "SDN:P29::cfherbvg";
        skos:note              "accepted"@en;
        skos:prefLabel         "herbaceous_vegetation"@en .

