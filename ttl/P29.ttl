<http://vocab.nerc.ac.uk/collection/P29/current/ANGC3PFT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P29::ANGC3PFT";
        dc:date                "2018-03-13 13:56:23.0";
        dc:identifier          "SDN:P29::ANGC3PFT";
        pav:authoredOn         "2018-03-13 13:56:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P29/current/ANGC3PFT/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Natural grasses\" means grasses growing in areas of low productivity, often situated on rough or uneven ground. This can include rocky areas, briars and heathland. A \"c3 plant\" is one that utilizes the C3 carbon fixation pathway as the sole mechanism to bind CO2 before photosynthesis reactions take place. All trees are C3 type. Grasses and crops can be C3 or C4."@en;
        skos:notation          "SDN:P29::ANGC3PFT";
        skos:note              "accepted"@en;
        skos:prefLabel         "natural_grasses_of_c3_plant_functional_types"@en .

