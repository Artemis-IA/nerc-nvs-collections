<http://vocab.nerc.ac.uk/collection/C40/current/PEAC03/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C40::PEAC03";
        dc:date                "2009-09-29 12:12:36.0";
        dc:identifier          "SDN:C40::PEAC03";
        pav:authoredOn         "2009-09-29 12:12:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C40/current/PEAC03/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The pollution event was observed directly by a reliable source and could be clearly observed by the human eye"@en;
        skos:notation          "SDN:C40::PEAC03";
        skos:note              "accepted"@en;
        skos:prefLabel         "Confirmed"@en .

<http://vocab.nerc.ac.uk/collection/C40/current/PEAC01/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C40::PEAC01";
        dc:date                "2009-09-29 12:12:36.0";
        dc:identifier          "SDN:C40::PEAC01";
        pav:authoredOn         "2009-09-29 12:12:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C40/current/PEAC01/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The pollution event observation was not from an authoratative source and/or the pollution could not be clearly identified"@en;
        skos:notation          "SDN:C40::PEAC01";
        skos:note              "accepted"@en;
        skos:prefLabel         "Doubtful"@en .

<http://vocab.nerc.ac.uk/collection/C40/current/PEAC02/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C40::PEAC02";
        dc:date                "2009-09-29 12:12:36.0";
        dc:identifier          "SDN:C40::PEAC02";
        pav:authoredOn         "2009-09-29 12:12:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C40/current/PEAC02/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "There is a greater than 50% chance that the pollution event is real given the source of the information and the conditions underwhich it was identified"@en;
        skos:notation          "SDN:C40::PEAC02";
        skos:note              "accepted"@en;
        skos:prefLabel         "Probable"@en .

<http://vocab.nerc.ac.uk/collection/C40/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "A group of European countries plus the European Commission who work together to monitor pollution incidents at sea and combat marine pollution incidents.";
