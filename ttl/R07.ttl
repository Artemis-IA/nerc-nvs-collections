        dc:title                "Argo history action codes";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Argo Data Management Team";
        owl:versionInfo         "1";
        skos:altLabel           "HISTORY_ACTION";
        skos:altLabel           "HISTORY_ACTION"@fr ;
        skos:member             <http://vocab.nerc.ac.uk/collection/R07/current/QC/> , <http://vocab.nerc.ac.uk/collection/R07/current/IP/> , <http://vocab.nerc.ac.uk/collection/R07/current/DC/> , <http://vocab.nerc.ac.uk/collection/R07/current/SV/> , <http://vocab.nerc.ac.uk/collection/R07/current/UP/> , <http://vocab.nerc.ac.uk/collection/R07/current/CF/> , <http://vocab.nerc.ac.uk/collection/R07/current/PE/> , <http://vocab.nerc.ac.uk/collection/R07/current/NG/> , <http://vocab.nerc.ac.uk/collection/R07/current/ED/> , <http://vocab.nerc.ac.uk/collection/R07/current/CR/> , <http://vocab.nerc.ac.uk/collection/R07/current/TE/> , <http://vocab.nerc.ac.uk/collection/R07/current/CV/> , <http://vocab.nerc.ac.uk/collection/R07/current/QCF/> , <http://vocab.nerc.ac.uk/collection/R07/current/QCP/>;
