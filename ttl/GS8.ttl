<http://vocab.nerc.ac.uk/collection/GS8/current/ACSR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS8::ACSR";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS8::ACSR";
        pav:authoredOn         "2011-01-28 12:26:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS8/current/ACSR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "ActSeisRefr";
        skos:definition        "The elucidation of geological structure by quantifying the refration of waves from from artificial sources (such as explosions) far away from the measurement site by sub-surface layers."@en;
        skos:notation          "SDN:GS8::ACSR";
        skos:note              "accepted"@en;
        skos:prefLabel         "Active seismic refraction"@en .

<http://vocab.nerc.ac.uk/collection/GS8/current/SRFR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS8::SRFR";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS8::SRFR";
        pav:authoredOn         "2011-01-28 12:26:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS8/current/SRFR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SeisRefr";
        skos:definition        "The elucidation of geological structure by quantifying the refration of waves from a high energy source by sub-surface layers."@en;
        skos:notation          "SDN:GS8::SRFR";
        skos:note              "accepted"@en;
        skos:prefLabel         "Seismic refraction"@en .

<http://vocab.nerc.ac.uk/collection/GS8/current/PASR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS8::PASR";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS8::PASR";
        pav:authoredOn         "2011-01-28 12:26:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS8/current/PASR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PassSeisRefr";
        skos:definition        "The elucidation of geological structure by quantifying the refration of waves from naturally occurring low frequency earth movements (e.g. earthquakes) by sub-surface layers ."@en;
        skos:notation          "SDN:GS8::PASR";
        skos:note              "accepted"@en;
        skos:prefLabel         "Passive seismic refraction"@en .

<http://vocab.nerc.ac.uk/collection/GS8/current/SRFL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS8::SRFL";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS8::SRFL";
        pav:authoredOn         "2011-01-28 12:26:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS8/current/SRFL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SeisRefl";
        skos:definition        "The elucidation of geological structure by quantifying the proportion of waves from a high energy source reflected by sub-surface layers."@en;
        skos:notation          "SDN:GS8::SRFL";
        skos:note              "accepted"@en;
        skos:prefLabel         "Seismic reflection"@en .

<http://vocab.nerc.ac.uk/collection/GS8/current/SSCN/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GS8::SSCN";
        dc:date                "2011-01-28 12:26:26.0";
        dc:identifier          "SDN:GS8::SSCN";
        pav:authoredOn         "2011-01-28 12:26:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GS8/current/SSCN/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SideScan";
        skos:definition        "A technique for mapping the morphology of the seafloor using a sonar swath projected sideways from a towed underwater vehicle."@en;
        skos:notation          "SDN:GS8::SSCN";
        skos:note              "accepted"@en;
        skos:prefLabel         "Side-scan sonar"@en .

