<http://vocab.nerc.ac.uk/collection/R41/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies managed by the Global Ocean Observing System (GOOS) under OceanOPS (https://www.ocean-ops.org) and hosted on the NERC Vocabulary Server (NVS).";
        rdfs:seeAlso            <https://github.com/OneArgo/ArgoVocabs>;
        dc:alternative          "PROGRAM_NAME";
        dc:creator              "GOOS/OceanOPS Vocabulary Governance";
        dc:date                 "2026-05-01 03:00:00.0";
        dc:description          "List of Argo floats managed under the same lead agency. A program is bound to one country, one or several agencies with defined roles, and has contact points with defined roles. The same agency can implement multiple programs. Some cases such as EuroArgo (European Research Infrastructure Consortium) use a multinational agency and \"Europe\" as country. Argo netCDF variable PROGRAM_NAME is populated by R41 prefLabel.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Argo program name";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "GOOS/OceanOPS Vocabulary Governance";
