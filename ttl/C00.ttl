<http://vocab.nerc.ac.uk/collection/C00/current/BUDS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::BUDS";
        dc:date                "2013-04-24 15:16:56.0";
        dc:identifier          "SDN:C00::BUDS";
        pav:authoredOn         "2013-04-24 15:16:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C00/current/BUDS/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C00/current/BUDS/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "BUDS";
        skos:definition        "Bathymetric depth was obtained from shipboard echosounder data processed by BODC using the BUDS underway data system. The acceptable depth value located closest to the series position (providing separation distance is reasonable) is taken."@en;
        skos:notation          "SDN:C00::BUDS";
        skos:note              "accepted"@en;
        skos:prefLabel         "BUDS object"@en .

<http://vocab.nerc.ac.uk/collection/C00/current/SCILOG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::SCILOG";
