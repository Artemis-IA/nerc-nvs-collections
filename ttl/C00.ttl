        dc:publisher            "Natural Environment Research Council";
        dc:title                "BODC Seafloor Depth Data Sources";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "British Oceanographic Data Centre";
        owl:versionInfo         "11";
