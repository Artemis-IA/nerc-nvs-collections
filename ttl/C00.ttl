<http://vocab.nerc.ac.uk/collection/C00/current/BRIDGE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::BRIDGE";
        dc:date                "2013-04-23 10:22:29.0";
        dc:identifier          "SDN:C00::BRIDGE";
        pav:authoredOn         "2013-04-23 10:22:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C00/current/BRIDGE/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Bridge_log";
        skos:altLabel          "Bridge_log (journal de passerelle)"@fr ;
        skos:definition        "Bathymetric depth was obtained from the value logged for the data collection activity by the ship's deck officers. This will be based on the bridge echosounder which may not be the same instrument used by the scientific party."@en;
        skos:definition        "La profondeur bathymétrique a été obtenue de la valeur consignée pour l'activité de collecte de données par les officiers de pont du navire. Elle sera basée sur l'écho-sondeur de la passerelle qui peut ne pas être le même instrument que celui utilisé par le personnel scientifique."@fr ;
        skos:notation          "SDN:C00::BRIDGE";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bridge log sheets"@en ;
        skos:prefLabel         "feuilles de journal de passerelle"@fr .

