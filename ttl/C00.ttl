<http://vocab.nerc.ac.uk/collection/C00/current/CHART/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::CHART";
        dc:date                "2018-05-14 10:21:58.0";
        dc:identifier          "SDN:C00::CHART";
        pav:authoredOn         "2018-05-14 10:21:58.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C00/current/CHART/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C00/current/CHART/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "chart";
        skos:altLabel          "chart (carte)"@fr ;
        skos:definition        "Bathymetric depth was read by eye from a published bathymetric chart of the area (e.g. the UK Admiralty Charts used for navigation), using the series spatial coordinates or station position."@en;
        skos:definition        "La profondeur bathymétrique a été lue à l'œil sur une carte bathymétrique publiée de la zone (par ex. les cartes de l'Amirauté britannique utilisées pour la navigation), en utilisant les coordonnées spatiales de la série ou la position de la station."@fr ;
        skos:notation          "SDN:C00::CHART";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bathymetric chart"@en ;
        skos:prefLabel         "carte bathymétrique"@fr .

