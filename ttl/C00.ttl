<http://vocab.nerc.ac.uk/collection/C00/current/BUDS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::BUDS";
        dc:date                "2013-04-24 15:16:56.0";
        dc:identifier          "SDN:C00::BUDS";
        pav:authoredOn         "2013-04-24 15:16:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C00/current/BUDS/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C00/current/BUDS/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "BUDS";
        skos:altLabel          "BUDS"@fr ;
        skos:definition        "Bathymetric depth was obtained from shipboard echosounder data processed by BODC using the BUDS underway data system. The acceptable depth value located closest to the series position (providing separation distance is reasonable) is taken."@en;
        skos:definition        "La profondeur bathymétrique a été obtenue à partir des données d'écho-sondeur de bord traitées par BODC avec le système de données de route BUDS. La valeur de profondeur acceptable localisée le plus près de la position de la série (à condition que la distance de séparation soit raisonnable) est retenue."@fr ;
        skos:notation          "SDN:C00::BUDS";
        skos:note              "accepted"@en;
        skos:prefLabel         "BUDS object"@en ;
        skos:prefLabel         "objet BUDS"@fr .

<http://vocab.nerc.ac.uk/collection/C00/current/SCILOG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::SCILOG";
        dc:date                "2013-04-23 10:24:43.0";
        dc:identifier          "SDN:C00::SCILOG";
        pav:authoredOn         "2013-04-23 10:24:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C00/current/SCILOG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Science_log";
        skos:altLabel          "Science_log (journal scientifique)"@fr ;
        skos:definition        "Bathymetric depth was obtained from the value logged for the data collection activity by the scientific party. This is generally a spot reading at some stage during the activity taken from the scientific echo sounder."@en;
        skos:definition        "La profondeur bathymétrique a été obtenue de la valeur consignée pour l'activité de collecte de données par le personnel scientifique. Il s'agit généralement d'une lecture ponctuelle à un moment de l'activité prise sur l'écho-sondeur scientifique."@fr ;
        skos:notation          "SDN:C00::SCILOG";
        skos:note              "accepted"@en;
        skos:prefLabel         "Scientific log sheets"@en ;
        skos:prefLabel         "feuilles de journal scientifique"@fr .

<http://vocab.nerc.ac.uk/collection/C00/current/PEVENT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::PEVENT";
        dc:date                "2013-05-07 11:36:41.0";
        dc:identifier          "SDN:C00::PEVENT";
        pav:authoredOn         "2013-05-07 11:36:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C00/current/PEVENT/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Avg_Uway";
        skos:altLabel          "Avg_Uway (moyenne de route)"@fr ;
        skos:definition        "Bathymetric depth was obtained by averaging underway echo-sounder data over the duration of the data collection event. EVENT water depths obtained using PEVENT and subsequently ported to ZESH (e.g. CTD migration) are obtained in this way."@en;
        skos:definition        "La profondeur bathymétrique a été obtenue en moyennant les données d'écho-sondeur de route sur la durée de l'événement de collecte de données. Les profondeurs d'eau EVENT obtenues avec PEVENT puis portées vers ZESH (par ex. migration CTD) sont obtenues de cette façon."@fr ;
        skos:notation          "SDN:C00::PEVENT";
        skos:note              "accepted"@en;
        skos:prefLabel         "Averaged underway bathymetry"@en ;
        skos:prefLabel         "bathymétrie de route moyennée"@fr .

