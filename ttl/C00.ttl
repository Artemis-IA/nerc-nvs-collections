<http://vocab.nerc.ac.uk/collection/C00/current/CTDDATA/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C00::CTDDATA";
        dc:date                "2013-04-23 13:36:39.0";
        dc:identifier          "SDN:C00::CTDDATA";
        pav:authoredOn         "2013-04-23 13:36:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C00/current/CTDDATA/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C00/current/CTDDATA/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "CTD_data";
        skos:altLabel          "CTD_data (données CTD)"@fr ;
        skos:definition        "Bathymetric depth was obtained from the depth below surface recorded by the CTD pressure sensor and the height above the bed obtained from the CTD package altimeter at the time of closest approach of the CTD package to the bed."@en;
        skos:definition        "La profondeur bathymétrique a été obtenue de la profondeur sous la surface enregistrée par le capteur de pression CTD et de la hauteur au-dessus du fond obtenue par l'altimètre du conditionneur CTD au moment de l'approche la plus proche du conditionneur CTD au fond."@fr ;
        skos:notation          "SDN:C00::CTDDATA";
        skos:note              "accepted"@en;
        skos:prefLabel         "CTD data"@en ;
        skos:prefLabel         "données CTD"@fr .

