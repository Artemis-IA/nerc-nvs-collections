<http://vocab.nerc.ac.uk/collection/S05/current/S050147/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S05::S050147";
        dc:date                "2017-04-25 16:24:02.0";
        dc:identifier          "SDN:S05::S050147";
        pav:authoredOn         "2017-04-25 16:24:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S05/current/S050147/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
