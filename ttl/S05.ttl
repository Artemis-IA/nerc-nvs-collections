<http://vocab.nerc.ac.uk/collection/S05/current/S050155/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S05::S050155";
        dc:date                "2017-04-25 16:24:02.0";
        dc:identifier          "SDN:S05::S050155";
        pav:authoredOn         "2017-04-25 16:24:02.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S05/current/S050155/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/S01/current/S0111/>;
        skos:definition        "A partial pressure of CO2 data proccessing method where the data are recalculated to a potential temperature scale using the equation pCO2new = pCO2old * EXP((potential temperature - temperature) * 0.0423)"@en;
        skos:notation          "SDN:S05::S050155";
        skos:note              "accepted"@en;
        skos:prefLabel         "recomputation to potential temperature using pCO2*EXP((Theta - T)*0.0423)"@en .

