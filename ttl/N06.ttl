<http://vocab.nerc.ac.uk/collection/N06/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used for cross-centre information infrastructure in NERC. Current (2011) manifestation is the NERC SIS metadata subgroup";
        dc:alternative          "EDC_resourceTypeGeneral";
        dc:creator              "Natural Environment Research Council";
        dc:date                 "2021-05-26 03:00:06.0";
        dc:description          "Controlled list of terms used by the NERC Environmental Data Centres for submission of DOI metadata records to DataCite. The list is used to populate \nhttp://purl.org/spar/datacite/hasGeneralResourceType from the EDC's GEMINI profiles.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "NERC Environmental Data Centres DataCite General Resource Types";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Natural Environment Research Council";
        owl:versionInfo         "1";
        skos:altLabel           "EDC_resourceTypeGeneral";
