<http://vocab.nerc.ac.uk/collection/GGT/current/TIN44/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:GGT::TIN44";
        dc:date                "2025-10-20 16:30:12.0";
        dc:identifier          "SDN:GGT::TIN44";
        pav:authoredOn         "2025-10-20 16:30:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/GGT/current/TIN44/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/GGT/current/TIN44/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P01/current/GEBCOTID/>;
        skos:definition        "Depth value at this location is based on bathymetric depths from multiple sources, including measured and derived data, and included within a gridded data set where interpolation between sounding points is guided by satellite-derived gravity data"@en;
        skos:definition        "La valeur de profondeur à cet emplacement est basée sur des profondeurs bathymétriques de sources multiples, incluant des données mesurées et dérivées, et incluse dans un jeu de données maillé où l'interpolation entre les points de sonage est guidée par des données de gravité dérivées de satellites"@fr ;
        skos:notation          "SDN:GGT::TIN44";
        skos:note              "accepted"@en;
        skos:prefLabel         "GEBCO_type_identifier_44"@en ;
        skos:prefLabel         "GEBCO_type_identifier_44 (sources multiples)"@fr .

