<http://vocab.nerc.ac.uk/collection/S20/current/S2000027/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S20::S2000027";
        dc:date                "2024-04-23 15:38:09.0";
        dc:identifier          "SDN:S20::S2000027";
        pav:authoredOn         "2024-04-23 15:38:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S20/current/S2000027/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A vertical datum based on the arithmetic mean of hourly heights observed over the National Tidal Datum Epoch. Shorter series are specified in the name; e.g. monthly mean sea level and yearly mean sea level. Adapted from https://tidesandcurrents.noaa.gov/datum_options.html"@en;
        skos:definition        "Un référentiel vertical basé sur la moyenne arithmétique des hauteurs horaires observées sur la période de référence du datum tidal national. Les séries plus courtes sont spécifiées dans le nom ; par ex. niveau moyen de la mer mensuel et annuel. Adapté de https://tidesandcurrents.noaa.gov/datum_options.html"@fr ;
        skos:notation          "SDN:S20::S2000027";
        skos:note              "accepted"@en;
        skos:prefLabel         "Lowest Astronomical Tide datum"@en ;
        skos:prefLabel         "référentiel de la marée astronomique la plus basse"@fr .

<http://vocab.nerc.ac.uk/collection/S20/current/S2000030/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S20::S2000030";
        dc:date                "2024-04-23 15:38:09.0";
        dc:identifier          "SDN:S20::S2000030";
        pav:authoredOn         "2024-04-23 15:38:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S20/current/S2000030/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A vertical datum based on the low water plane specified by UK Admiralty. This approximates to Lowest Astonomical Tide but the two are not exactly the same in some geographical areas."@en;
        skos:definition        "Un référentiel vertical basé sur le plan de basses eaux spécifié par l'Amirauté britannique. Cela approxime la marée astronomique la plus basse mais les deux ne sont pas exactement identiques dans certaines zones géographiques."@fr ;
        skos:notation          "SDN:S20::S2000030";
        skos:note              "accepted"@en;
        skos:prefLabel         "UK Admiralty Chart Datum"@en ;
        skos:prefLabel         "référentiel de carte de l'Amirauté britannique"@fr .

