        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A vertical datum based on the mean sea level at Newlyn in Cornwall averaged between 1915 and 1921 used for the elevation of the zero metres contour on UK Ordnance Survey maps."@en;
        skos:definition        "Un référentiel vertical basé sur le niveau moyen de la mer de Newlyn en Cornouailles moyenné entre 1915 et 1921, utilisé pour l'élévation du contour zéro mètre sur les cartes de l'Ordnance Survey britannique."@fr ;
        skos:notation          "SDN:S20::S2000037";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ordnance Datum Newlyn"@en ;
        skos:prefLabel         "Ordnance Datum Newlyn"@fr .

