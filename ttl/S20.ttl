<http://vocab.nerc.ac.uk/collection/S20/current/S2000028/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S20::S2000028";
        dc:date                "2024-04-23 15:38:09.0";
        dc:identifier          "SDN:S20::S2000028";
        pav:authoredOn         "2024-04-23 15:38:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S20/current/S2000028/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A vertical datum based on the mean sea level of the tide gauge at Malin Head, County Donegal. It was adopted as the national datum in 1970 from readings taken between 1960 and 1969 and all heights on national grid maps are measured above this datum."@en;
        skos:definition        "Un référentiel vertical basé sur le niveau moyen de la mer du marégraphe de Malin Head, comté de Donegal. Il a été adopté comme référentiel national en 1970 à partir de relevés pris entre 1960 et 1969 et toutes les hauteurs des cartes nationales de la grille sont mesurées au-dessus de ce référentiel."@fr ;
        skos:notation          "SDN:S20::S2000028";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ordnance Datum Malin"@en ;
        skos:prefLabel         "Ordnance Datum Malin"@fr .

