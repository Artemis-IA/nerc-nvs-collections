        skos:notation          "SDN:S20::S2000029";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rijkswaterstaat Mean Sea Level"@en ;
        skos:prefLabel         "niveau moyen de la mer Rijkswaterstaat"@fr .

