<http://vocab.nerc.ac.uk/collection/S20/current/S2000008/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:S20::S2000008";
        dc:date                "2018-09-27 16:52:15.0";
        dc:identifier          "SDN:S20::S2000008";
        pav:authoredOn         "2018-09-27 16:52:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/S20/current/S2000008/1/>;
        pav:version            "1";
