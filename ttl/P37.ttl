<http://vocab.nerc.ac.uk/collection/P37/current/standard/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P37::standard";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P37::standard";
        pav:authoredOn         "2015-02-18 11:28:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P37/current/standard/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mixed Gregorian/Julian calendar, as implemented in the Unidata Udunits software, in which dates prior to 15th October 1582 are assumed to use  the Julian calendar. Dates on or after 15th October 1582 are assumed to use the Gregorian calendar."@en;
        skos:notation          "SDN:P37::standard";
        skos:note              "accepted"@en;
        skos:prefLabel         "standard"@en .

<http://vocab.nerc.ac.uk/collection/P37/current/365_day/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P37::365_day";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P37::365_day";
        pav:authoredOn         "2015-02-18 11:28:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P37/current/365_day/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Gregorian calendar without leap years, i.e., all years are 365 days long."@en;
        skos:notation          "SDN:P37::365_day";
        skos:note              "accepted"@en;
        skos:prefLabel         "365_day"@en .

<http://vocab.nerc.ac.uk/collection/P37/current/proleptic_gregorian/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P37::proleptic_gregorian";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P37::proleptic_gregorian";
        pav:authoredOn         "2015-02-18 11:28:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P37/current/proleptic_gregorian/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A Gregorian calendar extended to dates before the 15th of October 1582. That is, a year is a leap year if either: (i) it is divisible by 4 but not by 100; (ii) it is divisible by 400."@en;
        skos:notation          "SDN:P37::proleptic_gregorian";
        skos:note              "accepted"@en;
        skos:prefLabel         "proleptic_gregorian"@en .

<http://vocab.nerc.ac.uk/collection/P37/current/gregorian/>
        rdf:type               skos:Concept;
