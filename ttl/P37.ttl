<http://vocab.nerc.ac.uk/collection/P37/current/all_leap/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P37::all_leap";
        dc:date                "2015-02-18 11:28:48.0";
        dc:identifier          "SDN:P37::all_leap";
