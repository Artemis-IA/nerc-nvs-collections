        skos:altLabel          "RKW_MSL"@fr ;
        skos:definition        "The mean sea level for a period of minimal 2 days converted to a many-year average based on measurements taken at the specified location."@en;
        skos:definition        "Le niveau moyen de la mer pour une période minimale de 2 jours converti en moyenne pluriannuelle basée sur des mesures prises à l'emplacement spécifié."@fr ;
        skos:notation          "SDN:L11::D14";
        skos:note              "accepted"@en;
        skos:prefLabel         "Rijkswaterstaat mean sea level"@en ;
        skos:prefLabel         "Rijkswaterstaat mean sea level"@fr .

