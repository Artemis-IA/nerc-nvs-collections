        skos:altLabel          "NCD_EPSG-1301"@fr ;
        skos:definition        "The elevation of the zero metres contour on Norwegian navigation charts as defined by the Norwegian Mapping Authority, Hydrographic Service. The area of extent includes the waters of Norway, Svalbard and Jan Mayen (offshore). EPSG code 1301."@en;
        skos:definition        "L'altitude de la courbe des zéro mètre sur les cartes marines norvégiennes telle que définie par l'Autorité norvégienne de cartographie, Service hydrographique. La zone d'extension inclut les eaux de la Norvège, du Svalbard et de Jan Mayen (au large). Code EPSG 1301."@fr ;
        skos:notation          "SDN:L11::D34";
        skos:note              "accepted"@en;
        skos:prefLabel         "Norwegian Chart Datum"@en ;
        skos:prefLabel         "Norwegian Chart Datum"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D15/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D15";
        dc:date                "2007-02-16 07:52:39.0";
