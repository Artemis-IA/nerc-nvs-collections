        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "CD";
        skos:altLabel          "CD"@fr ;
        skos:definition        "The elevation of the zero metres contour on an unspecified marine navigation chart. These are generally based on LAT which represents the safest option for navigation."@en;
        skos:definition        "L'altitude de la courbe des zéro mètre sur une carte marine non spécifiée. Celles-ci sont généralement basées sur LAT qui représente l'option la plus sûre pour la navigation."@fr ;
        skos:notation          "SDN:L11::D03";
        skos:note              "accepted"@en;
        skos:prefLabel         "unspecified chart datum"@en ;
        skos:prefLabel         "repère de carte non spécifié"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D32/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D32";
