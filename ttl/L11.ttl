        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Portuguese_CD";
        skos:altLabel          "Portuguese_CD"@fr ;
        skos:definition        "The elevation of the zero metres contour on Portuguese navigation charts for Portuguese coastal waters. It has been set near the theoretical level reached by the lowest astronomical tide (LAT) calculated from tide gauge data."@en;
        skos:definition        "L'altitude de la courbe des zéro mètre sur les cartes marines portugaises pour les eaux côtières portugaises. Elle a été fixée près du niveau théorique atteint par la marée astronomique basse (LAT) calculé à partir des données de marégraphes."@fr ;
        skos:notation          "SDN:L11::D32";
        skos:note              "accepted"@en;
        skos:prefLabel         "Portuguese Chart Datum"@en ;
        skos:prefLabel         "Portuguese Chart Datum"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D14/>
