<http://vocab.nerc.ac.uk/collection/L11/current/D11/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D11";
        dc:date                "2007-02-16 07:52:39.0";
        dc:identifier          "SDN:L11::D11";
        pav:authoredOn         "2007-02-16 07:52:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L11/current/D11/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MSL";
        skos:altLabel          "MSL"@fr ;
        skos:definition        "The average elevation of the sea surface over an unspecified time period of at least a tidal cycle, but generally much longer."@en;
        skos:definition        "L'altitude moyenne de la surface de la mer sur une période de temps non spécifiée d'au moins un cycle de marée, mais généralement beaucoup plus longue."@fr ;
        skos:notation          "SDN:L11::D11";
        skos:note              "accepted"@en;
        skos:prefLabel         "mean sea level"@en ;
        skos:prefLabel         "niveau moyen de la mer"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D28/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D28";
        dc:date                "2007-08-10 10:12:56.0";
        dc:identifier          "SDN:L11::D28";
        pav:authoredOn         "2007-08-10 10:12:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L11/current/D28/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RGF80";
        skos:altLabel          "RGF80"@fr ;
        skos:definition        "The vertical component of a French 3-D CRS computed in 1980 until superseded in 1993 approximating to mean sea level"@en;
        skos:definition        "La composante verticale d'un système de référence français 3D calculé en 1980 jusqu'à son remplacement en 1993, approchant le niveau moyen de la mer"@fr ;
        skos:notation          "SDN:L11::D28";
        skos:note              "accepted"@en;
        skos:prefLabel         "Réseau Géodésique Français 80"@en ;
        skos:prefLabel         "Réseau Géodésique Français 80"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D18/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D18";
        dc:date                "2007-02-16 07:52:39.0";
        dc:identifier          "SDN:L11::D18";
        pav:authoredOn         "2007-02-16 07:52:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L11/current/D18/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MHWN";
        skos:altLabel          "MHWN"@fr ;
        skos:definition        "The average throughout the year (when the average maximium declination of the moon is 23.5 degrees) of two successive high waters during those periods of 24 hours when the range of the tide is at its least."@en;
        skos:definition        "La moyenne sur l'année (lorsque la déclinaison moyenne maximale de la lune est de 23,5 degrés) de deux pleines mers successives pendant les périodes de 24 heures où l'amplitude de la marée est la plus faible."@fr ;
        skos:notation          "SDN:L11::D18";
        skos:note              "accepted"@en;
        skos:prefLabel         "mean high water neaps"@en ;
        skos:prefLabel         "pleine mer moyenne de morte-eau"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D17/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D17";
        dc:date                "2007-02-16 07:52:39.0";
        dc:identifier          "SDN:L11::D17";
        pav:authoredOn         "2007-02-16 07:52:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L11/current/D17/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MLWN";
        skos:altLabel          "MLWN"@fr ;
        skos:definition        "The average throughout the year (when the average maximium declination of the moon is 23.5 degrees) of two successive low waters during those periods of 24 hours when the range of the tide is at its least."@en;
        skos:definition        "La moyenne sur l'année (lorsque la déclinaison moyenne maximale de la lune est de 23,5 degrés) de deux basses mers successives pendant les périodes de 24 heures où l'amplitude de la marée est la plus faible."@fr ;
        skos:notation          "SDN:L11::D17";
        skos:note              "accepted"@en;
        skos:prefLabel         "mean low water neaps"@en ;
        skos:prefLabel         "basse mer moyenne de morte-eau"@fr .

