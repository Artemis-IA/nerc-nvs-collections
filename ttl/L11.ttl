        owl:versionInfo        "1";
        skos:altLabel          "MHW";
        skos:altLabel          "MHW"@fr ;
        skos:definition        "The average of the highest elevation reached during at least two tidal cycles, but generally many more."@en;
        skos:definition        "La moyenne de la plus haute élévation atteinte pendant au moins deux cycles de marée, mais généralement beaucoup plus."@fr ;
        skos:notation          "SDN:L11::D13";
        skos:note              "accepted"@en;
        skos:prefLabel         "mean high water"@en ;
        skos:prefLabel         "pleine mer moyenne"@fr .

