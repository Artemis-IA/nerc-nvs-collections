<http://vocab.nerc.ac.uk/collection/L11/current/D13/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D13";
        dc:date                "2007-02-16 07:52:39.0";
        dc:identifier          "SDN:L11::D13";
