<http://vocab.nerc.ac.uk/collection/L11/current/D08/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D08";
        dc:date                "2007-02-16 07:52:39.0";
        dc:identifier          "SDN:L11::D08";
        pav:authoredOn         "2007-02-16 07:52:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L11/current/D08/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "sea_level";
        skos:altLabel          "sea_level"@fr ;
        skos:definition        "The level of the sea surface at an unspecified time and location of interest.  Usually associated with water depth measurements by shipboard echo sounder.  May be anywhere between LAT and HAT."@en;
        skos:definition        "Le niveau de la surface de la mer à un moment et un lieu non spécifiés d'intérêt. Généralement associé aux mesures de profondeur par écho-sondeur de bord. Peut se situer n'importe où entre LAT et HAT."@fr ;
        skos:notation          "SDN:L11::D08";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea level"@en ;
        skos:prefLabel         "niveau de la mer"@fr .

