        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MHWS";
        skos:altLabel          "MHWS"@fr ;
        skos:definition        "The average throughout the year (when the average maximium declination of the moon is 23.5 degrees) of two successive high waters during those periods of 24 hours when the range of the tide is at its greatest."@en;
        skos:definition        "La moyenne sur l'année (lorsque la déclinaison moyenne maximale de la lune est de 23,5 degrés) de deux pleines mers successives pendant les périodes de 24 heures où l'amplitude de la marée est la plus forte."@fr ;
        skos:notation          "SDN:L11::D16";
        skos:note              "accepted"@en;
        skos:prefLabel         "mean high water springs"@en ;
        skos:prefLabel         "pleine mer moyenne de vive-eau"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D01/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D01";
        dc:date                "2007-02-16 07:52:39.0";
        dc:identifier          "SDN:L11::D01";
        pav:authoredOn         "2007-02-16 07:52:39.0";
