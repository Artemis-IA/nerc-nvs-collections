        skos:definition        "L'altitude de la courbe des zéro mètre sur les cartes marines produites par la Marine grecque."@fr ;
        skos:notation          "SDN:L11::D05";
        skos:note              "accepted"@en;
        skos:prefLabel         "Hellenic Navy Hydrographic Service Chart Datum"@en ;
