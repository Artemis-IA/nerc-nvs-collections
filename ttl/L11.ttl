        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NAP";
        skos:altLabel          "NAP"@fr ;
        skos:definition        "Elevation marked by a brass benchmark in Amsterdam approximating to mean sea level at the Dutch Coast. Sometimes referred to as Normalnull and used as the zero metre contour in much of Western Europe.."@en;
        skos:definition        "Altitude marquée par une borne en laiton à Amsterdam approchant le niveau moyen de la mer sur la côte néerlandaise. Parfois appelée Normalnull et utilisée comme courbe des zéro mètre dans une grande partie de l'Europe occidentale."@fr ;
        skos:notation          "SDN:L11::D19";
        skos:note              "accepted"@en;
        skos:prefLabel         "Normaal Amsterdams Peil"@en ;
        skos:prefLabel         "Normaal Amsterdams Peil"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D34/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D34";
