        owl:versionInfo        "1";
        skos:altLabel          "MOD";
        skos:altLabel          "MOD"@fr ;
        skos:definition        "Mean sea level at Portmoor Pier, Malin Head averaged between 1960 and 1969 used for the elevation of the zero metres contour on Ordnance Survey of Ireland maps since 1970."@en;
        skos:definition        "Niveau moyen de la mer au Portmoor Pier, Malin Head, moyenné entre 1960 et 1969, utilisé pour l'altitude de la courbe des zéro mètre sur les cartes de l'Ordnance Survey of Ireland depuis 1970."@fr ;
        skos:notation          "SDN:L11::D24";
        skos:note              "accepted"@en;
        skos:prefLabel         "Malin Ordnance Datum"@en ;
        skos:prefLabel         "Malin Ordnance Datum"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D12/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D12";
        dc:date                "2007-02-16 07:52:39.0";
        dc:identifier          "SDN:L11::D12";
        pav:authoredOn         "2007-02-16 07:52:39.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/L11/current/D12/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "MLW";
        skos:altLabel          "MLW"@fr ;
        skos:definition        "The average of the lowest elevation reached during at least two tidal cycles, but generally many more."@en;
        skos:definition        "La moyenne de la plus basse élévation atteinte pendant au moins deux cycles de marée, mais généralement beaucoup plus."@fr ;
        skos:notation          "SDN:L11::D12";
        skos:note              "accepted"@en;
        skos:prefLabel         "mean low water"@en ;
        skos:prefLabel         "basse mer moyenne"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D22/>
        rdf:type               skos:Concept;
