        owl:versionInfo        "1";
        skos:altLabel          "local";
        skos:altLabel          "local"@fr ;
        skos:definition        "A local fixed elevation, usually labelled with a benchmark like a bolt, connected to a national datum through levelling."@en;
        skos:definition        "Une altitude fixe locale, généralement marquée par une borne comme un boulon, connectée à un repère national par nivellement."@fr ;
        skos:notation          "SDN:L11::D22";
        skos:note              "accepted"@en;
        skos:prefLabel         "local reference plane"@en ;
        skos:prefLabel         "plan de référence local"@fr .

<http://vocab.nerc.ac.uk/collection/L11/current/D03/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:L11::D03";
        dc:date                "2007-02-16 07:52:39.0";
