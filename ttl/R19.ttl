        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "1";
        skos:altLabel          "1"@fr ;
        skos:definition        "Value is estimated using information not transmitted by the float or by procedures that rely on typical float behaviour"@en;
        skos:definition        "La valeur est estimée à l'aide d'informations non transmises par le flotteur ou de procédures qui reposent sur le comportement typique des flotteurs."@fr ;
        skos:notation          "SDN:R19::1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Estimated value from information not transmitted by the float and/or reliant on typical float behaviour"@en ;
        skos:prefLabel         "valeur estimée à partir d'informations non transmises par le flotteur et/ou reposant sur le comportement typique des flotteurs"@fr .

