<http://vocab.nerc.ac.uk/collection/RTV/current/DST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/DST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/100/>;
        owl:versionInfo        "1";
        skos:altLabel          "DESCENT_START";
        skos:definition        "Time at which the float leaves the surface and begins the descent."@en;
        skos:notation          "SDN:RTV::DST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Descent Start Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/DPST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DPST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DPST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/DPST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/450/>;
        owl:versionInfo        "1";
        skos:altLabel          "DEEP_PARK_START";
        skos:definition        "Time at which the float transitions to a deep park drift mission. This variable is only defined if the float is expected to enter a deep drift phase; it does not apply to cases of accidental drift at deep pressure, caused by bottom hits or buoyancy issues for example."@en;
        skos:notation          "SDN:RTV::DPST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Deep Park Start Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/FST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::FST";
