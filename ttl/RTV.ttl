        skos:notation          "SDN:RTV::TST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Transmission Start Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/DDET/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DDET";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DDET";
        pav:authoredOn         "2021-11-30 12:47:38.0";
