        owl:versionInfo        "1";
        skos:altLabel          "ASCENT_START";
        skos:definition        "Time at which the float begins its return to the surface."@en;
        skos:notation          "SDN:RTV::AST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ascent Start Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/TST/>
