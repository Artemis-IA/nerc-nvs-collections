        skos:prefLabel         "Ascent End Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/DAST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DAST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DAST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/DAST/1/>;
