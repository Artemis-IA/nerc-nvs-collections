<http://vocab.nerc.ac.uk/collection/RTV/current/DST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/DST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/100/>;
        owl:versionInfo        "1";
        skos:altLabel          "DESCENT_START";
        skos:altLabel          "DESCENT_START"@fr ;
        skos:definition        "Time at which the float leaves the surface and begins the descent."@en;
        skos:definition        "Heure à laquelle le flotteur quitte la surface et commence la descente."@fr ;
        skos:notation          "SDN:RTV::DST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Descent Start Time"@en ;
        skos:prefLabel         "heure de début de descente"@fr .

<http://vocab.nerc.ac.uk/collection/RTV/current/DPST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DPST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DPST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/DPST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/450/>;
        owl:versionInfo        "1";
        skos:altLabel          "DEEP_PARK_START";
        skos:altLabel          "DEEP_PARK_START"@fr ;
        skos:definition        "Time at which the float transitions to a deep park drift mission. This variable is only defined if the float is expected to enter a deep drift phase; it does not apply to cases of accidental drift at deep pressure, caused by bottom hits or buoyancy issues for example."@en;
        skos:definition        "Heure à laquelle le flotteur passe à une mission de dérive en stationnement profond. Cette variable n'est définie que si le flotteur doit entrer dans une phase de dérive profonde ; elle ne s'applique pas aux cas de dérive accidentelle à pression profonde, causée par des chocs de fond ou des problèmes de flottabilité par exemple."@fr ;
        skos:notation          "SDN:RTV::DPST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Deep Park Start Time"@en ;
        skos:prefLabel         "heure de début de stationnement profond"@fr .

<http://vocab.nerc.ac.uk/collection/RTV/current/FST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::FST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::FST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/FST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/150/>;
        owl:versionInfo        "1";
        skos:altLabel          "FIRST_STABILIZATION";
        skos:altLabel          "FIRST_STABILIZATION"@fr ;
        skos:definition        "Time at which the float first becomes water-neutral."@en;
        skos:definition        "Heure à laquelle le flotteur devient pour la première fois neutre en eau."@fr ;
        skos:notation          "SDN:RTV::FST";
        skos:note              "accepted"@en;
        skos:prefLabel         "First Stabilization Time"@en ;
        skos:prefLabel         "heure de première stabilisation"@fr .

<http://vocab.nerc.ac.uk/collection/RTV/current/TET/>
        rdf:type               skos:Concept;
