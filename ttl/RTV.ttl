        owl:versionInfo        "1";
        skos:altLabel          "TRANSMISSION_END";
        skos:altLabel          "TRANSMISSION_END"@fr ;
        skos:definition        "Time at which the float stops transmitting."@en;
        skos:definition        "Heure à laquelle le flotteur cesse de transmettre."@fr ;
        skos:notation          "SDN:RTV::TET";
        skos:note              "accepted"@en;
        skos:prefLabel         "Transmission End Time"@en ;
        skos:prefLabel         "heure de fin de transmission"@fr .

<http://vocab.nerc.ac.uk/collection/RTV/current/LMT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::LMT";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::LMT";
