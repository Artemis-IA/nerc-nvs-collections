<http://vocab.nerc.ac.uk/collection/RTV/current/DET/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DET";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DET";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/DET/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/200/>;
        owl:versionInfo        "1";
        skos:altLabel          "DESCENT_END";
        skos:definition        "Time at which the float first approaches within 3% of the eventual drift pressure, whether it is transitioning from the surface or from a deep profile. In case the float overshoots the drift pressure on descent, the Descent End Time (DET) corresponds to the time of the overshoot. This variable is based on pressure only, and can be measured or estimated by fall-rate."@en;
        skos:notation          "SDN:RTV::DET";
        skos:note              "accepted"@en;
        skos:prefLabel         "Descent End Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/PST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::PST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::PST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/PST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/250/>;
        owl:versionInfo        "1";
        skos:altLabel          "PARK_START";
        skos:definition        "Time at which the float transitions to its Park or Drift mission. This variable is estimated either by an onboard descent timer (e.g. SOLO floats) or by pressure measurements (e.g. PROVOR floats)."@en;
        skos:notation          "SDN:RTV::PST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Park Start Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/PET/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::PET";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::PET";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/PET/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/300/>;
        owl:versionInfo        "1";
        skos:altLabel          "PARK_END";
        skos:definition        "Time at which the float exists from its Park or Drift mission. The float may then rise to the surface or sink to profile depth."@en;
        skos:notation          "SDN:RTV::PET";
        skos:note              "accepted"@en;
        skos:prefLabel         "Park End Time"@en .

<http://vocab.nerc.ac.uk/collection/RTV/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the Argo data system, published and maintained by the Argo Data Management Team (ADMT) and hosted on the NERC Vocabulary Server.";
        rdfs:seeAlso            <https://github.com/OneArgo/ArgoVocabs>;
        dc:alternative          "CYCLE_TIMING_VARIABLE";
        dc:creator              "Argo Data Management Team";
        dc:date                 "2021-12-01 02:00:02.0";
        dc:description          "Timing variables representing stages of an Argo float profiling cycle, most of which are associated with a trajectory measurement code ID listed in NVS collection 'R15'. Argo netCDF cycle timing variable named JULD_{cycle_phase_name}_STATUS are constructed with the template {cycle_phase_name} being replaced by RTV altLabel.";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Argo float cycle timing variables";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Argo Data Management Team";
        owl:versionInfo         "1";
        skos:altLabel           "CYCLE_TIMING_VARIABLE";
        skos:member             <http://vocab.nerc.ac.uk/collection/RTV/current/AET/> , <http://vocab.nerc.ac.uk/collection/RTV/current/DAST/> , <http://vocab.nerc.ac.uk/collection/RTV/current/FMT/> , <http://vocab.nerc.ac.uk/collection/RTV/current/AST/> , <http://vocab.nerc.ac.uk/collection/RTV/current/TST/> , <http://vocab.nerc.ac.uk/collection/RTV/current/DDET/> , <http://vocab.nerc.ac.uk/collection/RTV/current/FLT/> , <http://vocab.nerc.ac.uk/collection/RTV/current/LLT/> , <http://vocab.nerc.ac.uk/collection/RTV/current/DST/> , <http://vocab.nerc.ac.uk/collection/RTV/current/DPST/> , <http://vocab.nerc.ac.uk/collection/RTV/current/FST/> , <http://vocab.nerc.ac.uk/collection/RTV/current/TET/> , <http://vocab.nerc.ac.uk/collection/RTV/current/LMT/> , <http://vocab.nerc.ac.uk/collection/RTV/current/DET/> , <http://vocab.nerc.ac.uk/collection/RTV/current/PET/> , <http://vocab.nerc.ac.uk/collection/RTV/current/PST/>;
        skos:prefLabel          "Argo float cycle timing variables" .
