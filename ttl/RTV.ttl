        skos:note              "accepted"@en;
        skos:prefLabel         "Ascent End Time"@en ;
        skos:prefLabel         "heure de fin de montée"@fr .

<http://vocab.nerc.ac.uk/collection/RTV/current/DAST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::DAST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::DAST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/RTV/current/DAST/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/R15/current/550/>;
        owl:versionInfo        "1";
        skos:altLabel          "DEEP_ASCENT_START";
        skos:altLabel          "DEEP_ASCENT_START"@fr ;
        skos:definition        "Time at which the float begins its rise to drift pressure. This variable is typically used for floats that profile on descent."@en;
        skos:definition        "Heure à laquelle le flotteur commence sa remontée vers la pression de dérive. Cette variable est typiquement utilisée pour les flotteurs qui profilent en descente."@fr ;
        skos:notation          "SDN:RTV::DAST";
        skos:note              "accepted"@en;
        skos:prefLabel         "Deep Ascent Start Time"@en ;
        skos:prefLabel         "heure de début de remontée profonde"@fr .

