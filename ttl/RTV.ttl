<http://vocab.nerc.ac.uk/collection/RTV/current/AST/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:RTV::AST";
        dc:date                "2021-11-30 12:47:38.0";
        dc:identifier          "SDN:RTV::AST";
        pav:authoredOn         "2021-11-30 12:47:38.0";
