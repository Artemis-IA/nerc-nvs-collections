        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R18/current/CC00091/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Core Config 91";
        skos:definition        "Maximum number of Ice Descent and Ice Ascent cycles the float will perform when it is unable to perform telemetry. When it has completed the specified number of cycles, the float will continue with the next profiling cycle. Range: [0-24] cycles. If IceDescentCycles is disabled, then the float will try to detect an ice cap if it cannot find the sky. If IceDescentCycles is enabled, the float will not try to detect the ice cap and will operate in accordance with 'Ice Descent and Ice Ascent Cycles' where it tries to drift out from under an ice cap. Template_Values:{unit:[NUMBER]}."@en;
        skos:notation          "SDN:R18::CC00091";
        skos:note              "accepted"@en;
        skos:prefLabel         "CONFIG_IceDetectionMaxCycles_NUMBER"@en .

