        owl:deprecated         "true";
        owl:versionInfo        "4";
        skos:altLabel          "Core Config 92";
        skos:definition        "Never used on the GDAC. First day of the year during which telemetry is attempted during the Surface phase. When the float surfaces on a day that is not specified, it does not attempt telemetry and immediately begins the Park Descent phase for the next profiling cycle. TelemetryDays are specified with a start day and an end day. The start day is the first day of the transmit season for the year. The end day is the last day of the transmit season for the year. A setting of 0 0 disables TelemetryDays, and the float attempts telemetry during each Surface Phase. Template_Values:{unit:[NUMBER]}."@en;
        skos:notation          "SDN:R18::CC00092";
        skos:note              "deprecated"@en;
        skos:prefLabel         "CONFIG_IceDetectionFirstTelemetryDay_NUMBER"@en .

