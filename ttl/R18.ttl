<http://vocab.nerc.ac.uk/collection/R18/current/CC00072/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R18::CC00072";
        dc:date                "2025-12-12 11:41:04.0";
        dc:identifier          "SDN:R18::CC00072";
        pav:authoredOn         "2025-12-12 11:41:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R18/current/CC00072/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R18/current/CC00072/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "Core Config 72";
        skos:definition        "Time out. This is similar to CONFIG_ConnectionTimeOut_minutes but for the first telemetry session of a float in ice detection mode. In ice detection mode, the float reduces the timeout of the first Iridium connection: if the first connection fails the cycle is aborted (ice probably present) but if the first connection succeeds (waters free of ice) the float switches to the nominal timeout (CONFIG_ConnectionTimeOut_minutes) for the following transmissions of the current cycle. Template_Values:{unit:[days, hours, minutes, seconds]}."@en;
        skos:notation          "SDN:R18::CC00072";
        skos:note              "accepted"@en;
        skos:prefLabel         "CONFIG_IceDetectionConnectionTimeOut_minutes"@en .

