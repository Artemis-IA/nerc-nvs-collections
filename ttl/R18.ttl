<http://vocab.nerc.ac.uk/collection/R18/current/CC00111/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R18::CC00111";
        dc:date                "2025-12-12 11:41:08.0";
        dc:identifier          "SDN:R18::CC00111";
