<http://vocab.nerc.ac.uk/collection/R18/current/CC00093/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R18::CC00093";
        dc:date                "2026-03-09 09:11:25.0";
        dc:identifier          "SDN:R18::CC00093";
        pav:authoredOn         "2026-03-09 09:11:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R18/current/CC00093/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R18/current/CC00093/1/> , <http://vocab.nerc.ac.uk/collection/R18/current/CC00093/3/> , <http://vocab.nerc.ac.uk/collection/R18/current/CC00093/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:versionInfo        "4";
        skos:altLabel          "Core Config 93";
        skos:definition        "Never used on the GDAC. Last day of the year during which telemetry is attempted during the Surface phase. When the float surfaces on a day that is not specified, it does not attempt telemetry and immediately begins the Park Descent phase for the next profiling cycle. TelemetryDays are specified with a start day and an end day. The start day is the first day of the transmit season for the year. The end day is the last day of the transmit season for the year. A setting of 0 0 disables TelemetryDays, and the float attempts telemetry during each Surface Phase. Template_Values:{unit:[NUMBER]}."@en;
        skos:notation          "SDN:R18::CC00093";
        skos:note              "deprecated"@en;
        skos:prefLabel         "CONFIG_IceDetectionEndTelemetryDay_NUMBER"@en .

