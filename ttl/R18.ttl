<http://vocab.nerc.ac.uk/collection/R18/current/CC00220/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R18::CC00220";
        dc:date                "2025-12-12 11:41:10.0";
        dc:identifier          "SDN:R18::CC00220";
