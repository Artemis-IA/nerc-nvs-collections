        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "Core Config 188";
        skos:definition        "Activate recovery mode (1 = YES, 0 = NO). If activated, the float remains on the surface indefinitely while transmitting its position and log files, and downloading new mission and sample configuration parameters if available. If recovery mode is then deactivated, the float will begin the Park Descent phase of a new mission. Template_Values:{unit:[LOGICAL]}."@en;
        skos:notation          "SDN:R18::CC00188";
        skos:note              "accepted"@en;
        skos:prefLabel         "CONFIG_RecoveryModeActivate_LOGICAL"@en .

