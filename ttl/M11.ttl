<http://vocab.nerc.ac.uk/collection/M11/current/9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::9";
        dc:date                "2025-01-06 09:56:19.0";
        dc:identifier          "SDN:M11::9";
        pav:authoredOn         "2025-01-06 09:56:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/9/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/M11/current/9/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Ecosystem services that are necessary for the production or maintenance of other ecosystem services. Examples include; soil formation, primary production (e.g. photosynthesis), and nutrient cycling. (MEA, 2003)"@en;
        skos:notation          "SDN:M11::9";
        skos:note              "accepted"@en;
        skos:prefLabel         "Support services"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::7";
        dc:date                "2025-01-06 09:56:19.0";
        dc:identifier          "SDN:M11::7";
        pav:authoredOn         "2025-01-06 09:56:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/7/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/M11/current/7/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Ecosystem services that result in the supply of products from ecosystems, such as food, water, timber, pharmaceuticals and fibres. (MEA, 2003)"@en;
        skos:notation          "SDN:M11::7";
        skos:note              "accepted"@en;
        skos:prefLabel         "Provisioning services"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::8";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M11::8";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/8/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Ecosystem services that provide non-material benefits for people such as recreational, aesthetic, intellectual and spiritual benefits. (MEA, 2003)"@en;
        skos:notation          "SDN:M11::8";
        skos:note              "accepted"@en;
        skos:prefLabel         "Cultural services"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::4";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M11::4";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/4/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A measurable improvement to human well-being, derived from one or more ecosystem service(s).  (Boyd & Banzhaf 2007)."@en;
        skos:notation          "SDN:M11::4";
        skos:note              "accepted"@en;
        skos:prefLabel         "Benefits"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::2";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M11::2";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/2/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Intermediate ecological components that contribute to final services, but are not directly consumed, enjoyed or used.  (Boyd & Banzhaf 2007)."@en;
        skos:notation          "SDN:M11::2";
        skos:note              "accepted"@en;
        skos:prefLabel         "Intermediate services"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::1";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M11::1";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The conditions and processes through which natural ecosystems, and the species that make them up, sustain and fulfil human life. (Daily, G.C. (Ed) 1997)."@en;
        skos:notation          "SDN:M11::1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ecosystem services"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::5";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M11::5";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/5/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The physical, chemical, and biological processes or attributes that contribute to the self-maintenance of an ecosystem. (MEA, 2003)"@en;
        skos:notation          "SDN:M11::5";
        skos:note              "accepted"@en;
        skos:prefLabel         "Ecological processes and functions"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::3";
        dc:date                "2013-11-14 10:15:17.0";
        dc:identifier          "SDN:M11::3";
        pav:authoredOn         "2013-11-14 10:15:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/3/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Components of nature, directly enjoyed, consumed, or used to yield human well-being. (Boyd & Banzhaf 2007)."@en;
        skos:notation          "SDN:M11::3";
        skos:note              "accepted"@en;
        skos:prefLabel         "Final services"@en .

<http://vocab.nerc.ac.uk/collection/M11/current/6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:M11::6";
        dc:date                "2025-01-06 09:56:19.0";
        dc:identifier          "SDN:M11::6";
        pav:authoredOn         "2025-01-06 09:56:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/M11/current/6/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/M11/current/6/2/> , <http://vocab.nerc.ac.uk/collection/M11/current/6/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "Ecosystem services that regulate natural processes occurring within ecosystems. E.g. those that affect climate, floods, disease, wastes, and water quality. (MEA, 2003)"@en;
        skos:notation          "SDN:M11::6";
        skos:note              "accepted"@en;
        skos:prefLabel         "Regulating services"@en .

