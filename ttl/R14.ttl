<http://vocab.nerc.ac.uk/collection/R14/current/T000038/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R14::T000038";
        dc:date                "2025-12-11 11:05:00.0";
        dc:identifier          "SDN:R14::T000038";
        pav:authoredOn         "2025-12-11 11:05:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R14/current/T000038/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/R14/current/T000038/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "38";
        skos:definition        "Surface pressure measurement which is then used to correct pressure on board the float. This is a cumulative offset and no further correction is required. Negative offsets truncated to 0. Autocorrected. Autocorrecting so no adjustment in either RT or DM typically required. NOTE: if the SPO is >40 for the Argo CTD, then the autocorrection is PARTIALLY applied (40 is subtracted, leaving the excess offset uncorrected) and the pressures may need to be adjusted in RT and DM. Template_Values:{unit:[bar, dbar, cbar, mbar, inHg]}."@en;
        skos:notation          "SDN:R14::T000038";
        skos:note              "accepted"@en;
        skos:prefLabel         "PRES_SurfaceOffsetBeforeResetTruncated_dbar"@en .

