        dc:publisher            "Natural Environment Research Council";
        dc:title                "Type of geotechnical investigation carried out at a site";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "MEDIN Standards Group";
        owl:versionInfo         "1";
        skos:altLabel           "Geotech site investigation type";
