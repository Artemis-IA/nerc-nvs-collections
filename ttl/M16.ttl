        skos:altLabel           "type d'investigation de site géotechnique"@fr ;
        skos:member             <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_CPTBORE/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_PISTON/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BEDCPT/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BOX/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_VIBR/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_GRAB/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SAMPBORE/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SPECBORE/> , <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_COMPBORE/>;
        skos:prefLabel          "Type of geotechnical investigation carried out at a site" ;
        skos:prefLabel          "type d'investigation géotechnique réalisée sur un site"@fr .
