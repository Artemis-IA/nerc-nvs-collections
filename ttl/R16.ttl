<http://vocab.nerc.ac.uk/collection/R16/current/>
        rdf:type                skos:Collection;
        rdfs:comment            "Governance for vocabularies used in the Argo data system, published and maintained by the Argo Data Management Team (ADMT) and hosted on the NERC Vocabulary Server.";
        rdfs:seeAlso            <https://github.com/OneArgo/ArgoVocabs>;
        dc:alternative          "VERTICAL_SAMPLING_SCHEME";
        dc:creator              "Argo Data Management Team";
        dc:date                 "2020-05-04 03:00:04.0";
        dc:description          "Profile sampling schemes and sampling methods. Argo netCDF variable VERTICAL_SAMPLING_SCHEME is populated by R16 prefLabel, optionally appended by free text in brackets: e.g. \"Primary sampling: averaged [nominal 2 dbar binned data sampled at 0.5 Hz from a SBE41CP]\".";
        dc:publisher            "Natural Environment Research Council";
        dc:title                "Argo vertical sampling schemes";
        grg:RE_RegisterManager  "British Oceanographic Data Centre";
        grg:RE_RegisterOwner    "Argo Data Management Team";
        owl:versionInfo         "1";
        skos:altLabel           "VERTICAL_SAMPLING_SCHEME";
        skos:member             <http://vocab.nerc.ac.uk/collection/R16/current/NSMIXUP/> , <http://vocab.nerc.ac.uk/collection/R16/current/SECDIS/> , <http://vocab.nerc.ac.uk/collection/R16/current/NSAVGP/> , <http://vocab.nerc.ac.uk/collection/R16/current/NSMIXP/> , <http://vocab.nerc.ac.uk/collection/R16/current/BOAVE/> , <http://vocab.nerc.ac.uk/collection/R16/current/BODIS/> , <http://vocab.nerc.ac.uk/collection/R16/current/NSAVGUP/> , <http://vocab.nerc.ac.uk/collection/R16/current/NSDISUP/> , <http://vocab.nerc.ac.uk/collection/R16/current/SECAVG/> , <http://vocab.nerc.ac.uk/collection/R16/current/NSDISP/> , <http://vocab.nerc.ac.uk/collection/R16/current/PRAVG/> , <http://vocab.nerc.ac.uk/collection/R16/current/PRDIS/> , <http://vocab.nerc.ac.uk/collection/R16/current/SECMIX/> , <http://vocab.nerc.ac.uk/collection/R16/current/BOMIX/> , <http://vocab.nerc.ac.uk/collection/R16/current/PRMIX/>;
        skos:prefLabel          "Argo vertical sampling schemes" .
