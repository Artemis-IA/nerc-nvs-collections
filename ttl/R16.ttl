<http://vocab.nerc.ac.uk/collection/R16/current/NSMIXUP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R16::NSMIXUP";
        dc:date                "2020-05-03 20:29:08.0";
        dc:identifier          "SDN:R16::NSMIXUP";
        pav:authoredOn         "2020-05-03 20:29:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R16/current/NSMIXUP/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NSMIXUP";
        skos:definition        "Near-surface sampling scheme for which the 'mixed' sampling method was used, and measurements obtained from an unpumped CTD stream. The near-surface sampling profile has N_PROF>1. It is composed of measurements focusing on the top 5 dbar of the water column, which may extend deeper so as to overlap with the primary sampling profile for the purpose of cross-calibration. These measurements are taken at pressure levels different from the primary sampling profile, or obtained by a sampling method different from that of the primary sampling profile. The 'mixed' sampling method refers to profiles composed of data points obtained by both the 'averaged' and 'discrete' sampling methods. Primary sampling profiles measuring above 5 dbar should not be labelled with this sampling scheme."@en;
        skos:notation          "SDN:R16::NSMIXUP";
        skos:note              "accepted"@en;
        skos:prefLabel         "Near-surface sampling: mixed, unpumped"@en .

<http://vocab.nerc.ac.uk/collection/R16/current/SECDIS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R16::SECDIS";
        dc:date                "2020-05-03 20:29:08.0";
        dc:identifier          "SDN:R16::SECDIS";
        pav:authoredOn         "2020-05-03 20:29:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R16/current/SECDIS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "SECDIS";
        skos:definition        "Secondary sampling scheme for which the 'discrete' sampling method was used. The secondary sampling profile has N_PROF>1, and is composed of measurements that are taken at pressure levels different from the primary sampling profile, or obtained by a sampling method different from that of the primary sampling profile. The 'discrete' sampling method refers to profiles where each data point was obtained from a single measurement (polling) from a sensor. Measurements can be taken by the Primary CTD or by auxiliary sensors."@en;
        skos:notation          "SDN:R16::SECDIS";
        skos:note              "accepted"@en;
        skos:prefLabel         "Secondary sampling: discrete"@en .

<http://vocab.nerc.ac.uk/collection/R16/current/NSAVGP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:R16::NSAVGP";
        dc:date                "2020-05-03 20:29:08.0";
        dc:identifier          "SDN:R16::NSAVGP";
        pav:authoredOn         "2020-05-03 20:29:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/R16/current/NSAVGP/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "NSAVGP";
        skos:definition        "Near-surface sampling scheme for which the 'averaged' sampling method was used, and measurements obtained from a pumped CTD stream. The near-surface sampling profile has N_PROF>1. It is composed of measurements focusing on the top 5 dbar of the water column, which may extend deeper so as to overlap with the primary sampling profile for the purpose of cross-calibration. These measurements are taken at pressure levels different from the primary sampling profile, or obtained by a sampling method different from that of the primary sampling profile. The 'averaged' sampling method refers to profiles where each data point was obtained from binned averages of multiple data measurements (pollings) from a sensor. Primary sampling profiles measuring above 5 dbar should not be labelled with this sampling scheme."@en;
        skos:notation          "SDN:R16::NSAVGP";
        skos:note              "accepted"@en;
        skos:prefLabel         "Near-surface sampling: averaged, pumped"@en .

