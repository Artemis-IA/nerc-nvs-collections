<http://vocab.nerc.ac.uk/collection/C22/current/6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::6";
        dc:date                "2012-04-17 15:58:36.0";
        dc:identifier          "SDN:C22::6";
        pav:authoredOn         "2012-04-17 15:58:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/6/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/6/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "part_full";
        skos:definition        "The bottle seals were observed to be incorrectly seated and the bottle was only part full of water on recovery."@en;
        skos:notation          "SDN:C22::6";
        skos:note              "accepted"@en;
        skos:prefLabel         "Partial sample loss"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::1";
        dc:date                "2012-04-17 15:58:36.0";
        dc:identifier          "SDN:C22::1";
        pav:authoredOn         "2012-04-17 15:58:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/1/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/1/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "burst";
        skos:definition        "The filter in an in-situ sampling pump physically ruptured during sample resulting in an unquantifiable loss of sampled material."@en;
        skos:notation          "SDN:C22::1";
        skos:note              "accepted"@en;
        skos:prefLabel         "Filter burst"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::5";
        dc:date                "2012-04-17 15:58:36.0";
        dc:identifier          "SDN:C22::5";
        pav:authoredOn         "2012-04-17 15:58:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/5/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/5/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "leak";
        skos:definition        "Water was reported to be escaping from the bottle as the rosette was being recovered."@en;
        skos:notation          "SDN:C22::5";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bottle leak"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::3";
        dc:date                "2012-09-11 12:02:55.0";
        dc:identifier          "SDN:C22::3";
        pav:authoredOn         "2012-09-11 12:02:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/3/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/3/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "misfire";
        skos:definition        "The feedback indicator on the deck unit reported that the bottle closure command had failed. General Oceanics deck units used on NERC vessels in the 80s and 90s were renowned for reporting misfires when the bottle had been closed. This flag is also suitable for when a trigger command is mistakenly sent to a bottle that has previously been fired."@en;
        skos:notation          "SDN:C22::3";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bottle misfire"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::7";
        dc:date                "2012-08-22 09:19:49.0";
        dc:identifier          "SDN:C22::7";
        pav:authoredOn         "2012-08-22 09:19:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/7/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/7/2/> , <http://vocab.nerc.ac.uk/collection/C22/current/7/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "3";
        skos:altLabel          "no_sample";
        skos:definition        "Either the bottle was found to contain no sample on recovery or there was no bottle fitted to the rosette position fired (but SBE35 record may exist)."@en;
        skos:notation          "SDN:C22::7";
        skos:note              "accepted"@en;
        skos:prefLabel         "No sample"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/0/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::0";
        dc:date                "2012-04-17 15:58:36.0";
        dc:identifier          "SDN:C22::0";
        pav:authoredOn         "2012-04-17 15:58:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/0/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/0/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "OK";
        skos:definition        "The sampling event occurred without any incident being reported to BODC."@en;
        skos:notation          "SDN:C22::0";
        skos:note              "accepted"@en;
        skos:prefLabel         "No problem reported"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::4";
        dc:date                "2012-04-17 15:59:48.0";
        dc:identifier          "SDN:C22::4";
        pav:authoredOn         "2012-04-17 15:59:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/4/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/4/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "firing_order_error";
        skos:definition        "During the sampling deployment the bottle was fired in an order other than incrementing rosette position. Indicative of the potential for errors in the assignment of bottle firing depth, especially with General Oceanics rosettes."@en;
        skos:notation          "SDN:C22::4";
        skos:note              "accepted"@en;
        skos:prefLabel         "Bottles fired in incorrect order"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::2";
        dc:date                "2012-04-17 15:58:36.0";
        dc:identifier          "SDN:C22::2";
        pav:authoredOn         "2012-04-17 15:58:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/2/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/2/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "2";
        skos:altLabel          "leakage_contamination";
        skos:definition        "Analytical evidence (e.g. surface water salinity measured on a sample collected at depth) indicates that the water sample has been contaminated by water from depths other than the depths of sampling."@en;
        skos:notation          "SDN:C22::2";
        skos:note              "accepted"@en;
        skos:prefLabel         "Leakage contamination"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::8";
        dc:date                "2012-08-22 09:20:23.0";
        dc:identifier          "SDN:C22::8";
        pav:authoredOn         "2012-08-22 09:20:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/8/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/C22/current/8/1/> , <http://vocab.nerc.ac.uk/collection/C22/current/8/3/> , <http://vocab.nerc.ac.uk/collection/C22/current/8/2/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "4";
        skos:altLabel          "suspect_depth";
        skos:definition        "There is reason to doubt the accuracy of the sampling depth associated with the sample."@en;
        skos:notation          "SDN:C22::8";
        skos:note              "accepted"@en;
        skos:prefLabel         "Questionable depth"@en .

<http://vocab.nerc.ac.uk/collection/C22/current/9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C22::9";
        dc:date                "2012-08-08 14:50:04.0";
        dc:identifier          "SDN:C22::9";
        pav:authoredOn         "2012-08-08 14:50:04.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C22/current/9/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "vent_open";
        skos:definition        "The bottle air vent had not been closed prior to deployment giving rise to a risk of sample contamination through leakage."@en;
        skos:notation          "SDN:C22::9";
        skos:note              "accepted"@en;
        skos:prefLabel         "Vent left open"@en .

