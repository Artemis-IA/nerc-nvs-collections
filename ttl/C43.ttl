<http://vocab.nerc.ac.uk/collection/C43/current/UNK/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C43::UNK";
        dc:date                "2010-01-26 12:37:44.0";
        dc:identifier          "SDN:C43::UNK";
        pav:authoredOn         "2010-01-26 12:37:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C43/current/UNK/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "unknown";
        skos:definition        "The correct value is not known to, or not computable by, the sender of this data. However, the correct value probably exists."@en;
        skos:notation          "SDN:C43::UNK";
        skos:note              "accepted"@en;
        skos:prefLabel         "unknown"@en .

<http://vocab.nerc.ac.uk/collection/C43/current/SML/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C43::SML";
        dc:date                "2010-01-26 12:39:28.0";
        dc:identifier          "SDN:C43::SML";
        pav:authoredOn         "2010-01-26 12:39:28.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C43/current/SML/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "small";
        skos:definition        "A spill with a quantity of less than a litre such as deck runoff."@en;
        skos:notation          "SDN:C43::SML";
        skos:note              "accepted"@en;
        skos:prefLabel         "small"@en .

<http://vocab.nerc.ac.uk/collection/C43/current/XXL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C43::XXL";
        dc:date                "2010-01-26 12:44:15.0";
        dc:identifier          "SDN:C43::XXL";
        pav:authoredOn         "2010-01-26 12:44:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C43/current/XXL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "very large";
        skos:definition        "A spill with a quantity in excess of a thousand metric tonnes such as the cargo of an oil tanker."@en;
        skos:notation          "SDN:C43::XXL";
        skos:note              "accepted"@en;
        skos:prefLabel         "very large"@en .

<http://vocab.nerc.ac.uk/collection/C43/current/LRG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C43::LRG";
        dc:date                "2010-01-26 12:43:20.0";
        dc:identifier          "SDN:C43::LRG";
        pav:authoredOn         "2010-01-26 12:43:20.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C43/current/LRG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "large";
        skos:definition        "A spill with a quantity of between one and a thousand metric tonnes such as the contents of a ship fuel tank."@en;
        skos:notation          "SDN:C43::LRG";
        skos:note              "accepted"@en;
        skos:prefLabel         "large"@en .

<http://vocab.nerc.ac.uk/collection/C43/current/MED/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C43::MED";
        dc:date                "2010-01-26 12:40:58.0";
        dc:identifier          "SDN:C43::MED";
