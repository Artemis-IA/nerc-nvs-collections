        skos:narrower          <http://vocab.nerc.ac.uk/collection/A03/current/Transportation/> , <http://vocab.nerc.ac.uk/collection/A03/current/Infrastructure/> , <http://vocab.nerc.ac.uk/collection/A03/current/Facilities/>;
