<http://vocab.nerc.ac.uk/collection/A03/current/ComprehensivePlans/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A03::ComprehensivePlans";
        dc:date                "2011-08-19 11:46:42.0";
        dc:identifier          "SDN:A03::ComprehensivePlans";
        pav:authoredOn         "2011-08-19 11:46:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/A03/current/ComprehensivePlans/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A03/current/Planning/>;
        skos:definition        "\"Comprehensive plan\" means a generalized, coordinated land use map and policy statement of the governing body of a local government that interrelates all functional and natural systems and activities relating to the use of lands, including, but not limited to, sewer and water systems, transportation systems, educational facilities, recreational facilities and natural resources and air and water quality management programs. \"Comprehensive\" means all-inclusive, both in terms of the geographic area covered and functional and natural activities and systems occurring in the area covered by the plan. \"General nature\" means a summary of policies and proposals in broad categories and does not necessarily indicate the specific locations of any area, activity or use.\" \"Land\" includes water, both surface and subsurface, and the air."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A02/current/LandUse/> , <http://vocab.nerc.ac.uk/collection/A02/current/Permits/> , <http://vocab.nerc.ac.uk/collection/A02/current/Zoning/>;
        skos:notation          "SDN:A03::ComprehensivePlans";
        skos:note              "accepted"@en;
        skos:prefLabel         "Comprehensive Plan"@en .

<http://vocab.nerc.ac.uk/collection/A03/current/LittoralCellManagementPlans/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:A03::LittoralCellManagementPlans";
        dc:date                "2011-08-19 11:46:42.0";
        dc:identifier          "SDN:A03::LittoralCellManagementPlans";
