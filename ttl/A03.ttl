        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A03/current/PublicTrustResources/>;
        skos:definition        "A beach is a gently sloping area of loose material (e.g., sand, gravel, and cobbles) that extend landward from the low-water line to a point where there is a definite change in the material type or landform, or to the line of vegetation. The Oregon Beach bill recognizes public recreational rights or easements to dry sandy beaches all the way to the statuatory vegetation line."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/ICANCOERO/current/> , <http://vocab.nerc.ac.uk/scheme/OCACETHES/current/>;
        skos:narrower          <http://vocab.nerc.ac.uk/collection/A02/current/FineGrained/> , <http://vocab.nerc.ac.uk/collection/A02/current/MixedSandGravel/> , <http://vocab.nerc.ac.uk/collection/A02/current/MediumCoarse/> , <http://vocab.nerc.ac.uk/collection/A02/current/Gravel/>;
        skos:notation          "SDN:A03::Beach";
        skos:note              "accepted"@en;
        skos:prefLabel         "Beach"@en .

