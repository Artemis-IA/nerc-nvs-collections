        skos:definition        "La personne responsable d'un sous-ensemble spécifié des données collectées pendant un projet et qui détient la PI pour ce sous-ensemble de données."@fr ;
        skos:notation          "SDN:C87::DP";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project dataset principal investigator"@en ;
        skos:prefLabel         "chercheur principal du jeu de données du projet"@fr .

