<http://vocab.nerc.ac.uk/collection/C87/current/DP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::DP";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::DP";
