        skos:definition        "Persons serving on a project scientific steering committee,"@en;
        skos:notation          "SDN:C87::SM";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project scientific steering committee member"@en .

<http://vocab.nerc.ac.uk/collection/C87/current/CI/>
        rdf:type               skos:Concept;
