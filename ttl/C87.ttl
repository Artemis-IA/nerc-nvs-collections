        skos:definition        "La personne présidant le comité de pilotage scientifique du projet."@fr ;
        skos:notation          "SDN:C87::SC";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project scientific steering committee chair"@en ;
        skos:prefLabel         "président du comité de pilotage scientifique du projet"@fr .

