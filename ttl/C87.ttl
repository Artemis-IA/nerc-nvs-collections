        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Persons serving on a project scientific steering committee,"@en;
        skos:definition        "Personnes siégeant au comité de pilotage scientifique d'un projet,"@fr ;
        skos:notation          "SDN:C87::SM";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project scientific steering committee member"@en ;
        skos:prefLabel         "membre du comité de pilotage scientifique du projet"@fr .

<http://vocab.nerc.ac.uk/collection/C87/current/CI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::CI";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::CI";
        pav:authoredOn         "2011-12-12 09:37:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C87/current/CI/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Project Co-I";
        skos:altLabel          "Project Co-I"@fr ;
        skos:definition        "The persons responsible for the planning, direction and management of a sub-component of a project.  Termed a work package leader in EU projects."@en;
        skos:definition        "Les personnes responsables de la planification, de la direction et de la gestion d'une sous-composante d'un projet. Appelé responsable de lot de travail dans les projets UE."@fr ;
        skos:notation          "SDN:C87::CI";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project co-investigator"@en ;
        skos:prefLabel         "co-chercheur de projet"@fr .

<http://vocab.nerc.ac.uk/collection/C87/current/PA/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::PA";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::PA";
        pav:authoredOn         "2011-12-12 09:37:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C87/current/PA/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Project secretariat members providing administrative support to the project without management responsibility."@en;
        skos:definition        "Membres du secrétariat de projet fournissant un support administratif au projet sans responsabilité de gestion."@fr ;
        skos:notation          "SDN:C87::PA";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project administrator"@en ;
        skos:prefLabel         "administrateur de projet"@fr .

<http://vocab.nerc.ac.uk/collection/C87/current/PI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::PI";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::PI";
        pav:authoredOn         "2011-12-12 09:37:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C87/current/PI/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "Project PI";
        skos:altLabel          "Project PI"@fr ;
        skos:definition        "The person or persons responsible for the overall planning, direction and management of the project.  This role is termed the project co-ordinator in EU projects."@en;
        skos:definition        "La ou les personnes responsables de la planification, de la direction et de la gestion globales du projet. Ce rôle est appelé coordinateur de projet dans les projets UE."@fr ;
        skos:notation          "SDN:C87::PI";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project principal investigator"@en ;
        skos:prefLabel         "chercheur principal du projet"@fr .

<http://vocab.nerc.ac.uk/collection/C87/current/MP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::MP";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::MP";
        pav:authoredOn         "2011-12-12 09:37:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C87/current/MP/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Person with particular responsibility for accuracy and completeness of metadata, data quality and the short-term data access and security and assuring the long-term stewardship of the data collected during the project, but has no IPR interest in those data."@en;
        skos:definition        "Personne ayant une responsabilité particulière quant à l'exactitude et à la complétude des métadonnées, à la qualité des données et à l'accès et la sécurité des données à court terme et assurant la gestion à long terme des données collectées pendant le projet, mais n'ayant aucun intérêt en PI sur ces données."@fr ;
        skos:notation          "SDN:C87::MP";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project data manager"@en ;
        skos:prefLabel         "gestionnaire de données du projet"@fr .

<http://vocab.nerc.ac.uk/collection/C87/current/RA/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::RA";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::RA";
        pav:authoredOn         "2011-12-12 09:37:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C87/current/RA/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A person who is responsible for preparation, operation and/or maintenance of shipboard, laboratory or deployed scientific instrumentation, but has no IPR interest in the data returned by that instrumentation."@en;
        skos:definition        "Une personne responsable de la préparation, de l'exploitation et/ou de la maintenance d'instrumentation scientifique embarquée, de laboratoire ou déployée, mais n'ayant aucun intérêt en PI sur les données produites par cette instrumentation."@fr ;
        skos:notation          "SDN:C87::RA";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project technician"@en ;
        skos:prefLabel         "technicien de projet"@fr .

<http://vocab.nerc.ac.uk/collection/C87/current/SC/>
        rdf:type               skos:Concept;
