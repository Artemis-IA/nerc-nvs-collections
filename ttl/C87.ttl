        skos:prefLabel         "Project collaborator"@en .

<http://vocab.nerc.ac.uk/collection/C87/current/PD/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::PD";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::PD";
        pav:authoredOn         "2011-12-12 09:37:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C87/current/PD/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "RA";
        skos:definition        "Persons employed as researchers on a project, usually the line management responsibility of the principal investigator or a co-investigator."@en;
        skos:notation          "SDN:C87::PD";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project research assistant"@en .

<http://vocab.nerc.ac.uk/collection/C87/current/PG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:C87::PG";
        dc:date                "2011-12-12 09:37:26.0";
        dc:identifier          "SDN:C87::PG";
        pav:authoredOn         "2011-12-12 09:37:26.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/C87/current/PG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:versionInfo        "1";
        skos:altLabel          "PGRA";
        skos:definition        "Persons researching as part of a project as part of their work towards an academic degree.  This will usually be a PhD student, but could also be a masters student or even an undergraduate contributing through their degree work."@en;
        skos:notation          "SDN:C87::PG";
        skos:note              "accepted"@en;
        skos:prefLabel         "Project research student"@en .

