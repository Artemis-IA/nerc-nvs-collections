<http://vocab.nerc.ac.uk/collection/P30/current/indo_pacific_ocean/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P30::indo_pacific_ocean";
        dc:date                "2018-12-17 17:17:12.0";
        dc:identifier          "SDN:P30::indo_pacific_ocean";
        pav:authoredOn         "2018-12-17 17:17:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P30/current/indo_pacific_ocean/2/>;
